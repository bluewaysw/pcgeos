SpellClassStructures	ends

idata	segment
	userDictIsDirty	word	FALSE
public	userDictIsDirty

	spellSem	hptr	(?)
public	spellSem

	thesaurusSem	hptr	(?)
public	thesaurusSem

	hyphenSem	hptr	(?)
