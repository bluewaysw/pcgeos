SvgExportWritePathEnd(SvgExportContext *context,
                       Boolean fillPath,
                       Boolean strokePath,
                       RegionFillRule fillRule,
                       const TransMatrix *tm)
{
    SvgWriterStyle style;
    SvgWriterMatrix matrix;

    if (context == (void*)0)
    {
        return FALSE;
