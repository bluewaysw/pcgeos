    SvgExportNormalizeStyle(context, strokePath, fillPath, fillPath,
                             fillRule, &style);
    SvgExportNormalizeMatrix(tm, &matrix);
    return SvgWriterEmitPathEnd(&context->writer, &style,
                             &matrix) ? TRUE : FALSE;
}

WWFixedAsDWord _pascal
SvgExportPackWWFixed(const WWFixed *value)
{
    dword packed;

    if (value == (void*)0)
    {
        return 0;
    }
    packed = ((dword)(word)value->WWF_int << 16) |
             (dword)value->WWF_frac;
    return (WWFixedAsDWord)packed;
}

void _pascal
SvgExportPointFromInt(const Point *sourcePoint,
                       PointWWFixed *targetPoint)
{
    targetPoint->PF_x.WWF_int = sourcePoint->P_x;
    targetPoint->PF_y.WWF_int = sourcePoint->P_y;
    targetPoint->PF_x.WWF_frac = 0;
    targetPoint->PF_y.WWF_frac = 0;
}

void _pascal
SvgExportCopyPointWWFixed(PointWWFixed *destination,
                           const PointWWFixed *source)
{
    destination->PF_x.WWF_int = source->PF_x.WWF_int;
    destination->PF_x.WWF_frac = source->PF_x.WWF_frac;
    destination->PF_y.WWF_int = source->PF_y.WWF_int;
    destination->PF_y.WWF_frac = source->PF_y.WWF_frac;
}
static Boolean
SvgExportPathPointsEqual(const PointWWFixed *a, const PointWWFixed *b)
{
    if ((a == NULL) || (b == NULL))
        return FALSE;
    if ((a->PF_x.WWF_int != b->PF_x.WWF_int) ||
        (a->PF_x.WWF_frac != b->PF_x.WWF_frac))
    {
        return FALSE;
    }
    if ((a->PF_y.WWF_int != b->PF_y.WWF_int) ||
        (a->PF_y.WWF_frac != b->PF_y.WWF_frac))
    {
        return FALSE;
    }
    return TRUE;
}

Boolean _pascal
SvgExportPathBuilderMoveTo(SvgExportContext *context,
                                    SvgExportPathBuilder *builder,
                                    const PointWWFixed *point)
{
    if ((context == (void*)0) || (builder == (void*)0) ||
        (point == (void*)0))
    {
        return FALSE;
    }
    if ((builder->hasData == FALSE) &&
        !SvgExportWritePathBegin(context))
    {
        return FALSE;
    }
    if (!SvgExportWritePathMove(context, point))
    {
        return FALSE;
    }
    builder->subpathOpen = TRUE;
    builder->hasData = TRUE;
    SvgExportCopyPointWWFixed(&builder->lastPoint, point);
    SvgExportCopyPointWWFixed(&builder->subpathStart, point);
    return TRUE;
}

static Boolean
SvgExportPathBuilderEnsureSubpath(SvgExportContext *context,
                                           SvgExportPathBuilder *builder,
                                           const PointWWFixed *point)
{
    if (builder->subpathOpen == FALSE)
    {
        return SvgExportPathBuilderMoveTo(context, builder, point);
    }
    if (!SvgExportPathPointsEqual(&builder->lastPoint, point))
    {
        return SvgExportPathBuilderMoveTo(context, builder, point);
    }
    return TRUE;
}

Boolean _pascal
SvgExportPathBuilderLineTo(SvgExportContext *context,
                                    SvgExportPathBuilder *builder,
                                    const PointWWFixed *startPoint,
                                    const PointWWFixed *endPoint)
{
    if (!SvgExportPathBuilderEnsureSubpath(context, builder,
                                            startPoint))
    {
        return FALSE;
    }
    if (!SvgExportWritePathLine(context, endPoint))
    {
        return FALSE;
    }
    builder->hasData = TRUE;
    SvgExportCopyPointWWFixed(&builder->lastPoint, endPoint);
    return TRUE;
}

Boolean _pascal
SvgExportPathBuilderCurveTo(SvgExportContext *context,
                                     SvgExportPathBuilder *builder,
                                     const PointWWFixed *startPoint,
                                     const PointWWFixed *cp1,
                                     const PointWWFixed *cp2,
                                     const PointWWFixed *endPoint)
{
    if (!SvgExportPathBuilderEnsureSubpath(context, builder,
                                            startPoint))
    {
        return FALSE;
    }
    if (!SvgExportWritePathCubic(context, cp1, cp2, endPoint))
    {
        return FALSE;
    }
    builder->hasData = TRUE;
    SvgExportCopyPointWWFixed(&builder->lastPoint, endPoint);
    return TRUE;
}

Boolean _pascal
SvgExportPathBuilderClose(SvgExportContext *context,
                                   SvgExportPathBuilder *builder)
{
    if ((context == (void*)0) || (builder == (void*)0) ||
        (builder->subpathOpen == FALSE))
    {
        return TRUE;
    }
    if (!SvgExportWritePathClose(context))
    {
        return FALSE;
    }
    builder->subpathOpen = FALSE;
    builder->hasData = TRUE;
    SvgExportCopyPointWWFixed(&builder->lastPoint,
                               &builder->subpathStart);
    return TRUE;
}
