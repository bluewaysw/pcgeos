/***********************************************************************
 *
 * PROJECT:       SvgLib SVG Exporter
 * FILE:          svgdecode.goc
 *
 * DESCRIPTION:   Validates and decodes GString elements
 *
 ***********************************************************************/
@include <stdapp.goh>

#include "svgExport.h"

SvgExportOpcodeClass _pascal SvgExportClassifyOpcode(word elementType)
{
    switch (elementType)
    {
        case GR_DRAW_LINE:
        case GR_DRAW_LINE_TO:
        case GR_DRAW_REL_LINE_TO:
        case GR_DRAW_HLINE:
        case GR_DRAW_HLINE_TO:
        case GR_DRAW_VLINE:
        case GR_DRAW_VLINE_TO:
        case GR_DRAW_POLYLINE:
        case GR_DRAW_ARC:
        case GR_DRAW_RECT:
        case GR_DRAW_RECT_TO:
        case GR_DRAW_ROUND_RECT:
        case GR_DRAW_ROUND_RECT_TO:
        case GR_DRAW_CURVE:
        case GR_DRAW_CURVE_TO:
        case GR_DRAW_REL_CURVE_TO:
        case GR_DRAW_ELLIPSE:
        case GR_DRAW_POLYGON:
        case GR_DRAW_PATH:
        case GR_FILL_RECT:
        case GR_FILL_RECT_TO:
        case GR_FILL_ROUND_RECT:
        case GR_FILL_ROUND_RECT_TO:
        case GR_FILL_ARC:
        case GR_FILL_POLYGON:
        case GR_FILL_ELLIPSE:
        case GR_FILL_PATH:
            return SVG_OPCODE_SUPPORTED_RENDERING;

        case GR_APPLY_ROTATION:
        case GR_APPLY_SCALE:
        case GR_APPLY_TRANSLATION:
        case GR_APPLY_TRANSFORM:
        case GR_APPLY_TRANSLATION_DWORD:
        case GR_SET_TRANSFORM:
        case GR_SET_NULL_TRANSFORM:
        case GR_SET_DEFAULT_TRANSFORM:
        case GR_INIT_DEFAULT_TRANSFORM:
        case GR_SAVE_TRANSFORM:
        case GR_RESTORE_TRANSFORM:
        case GR_SAVE_STATE:
        case GR_RESTORE_STATE:
        case GR_SET_MIX_MODE:
        case GR_MOVE_TO:
        case GR_REL_MOVE_TO:
        case GR_SET_LINE_COLOR:
        case GR_SET_LINE_COLOR_MAP:
        case GR_SET_LINE_MASK:
        case GR_SET_LINE_WIDTH:
        case GR_SET_LINE_JOIN:
        case GR_SET_LINE_END:
        case GR_SET_LINE_ATTR:
        case GR_SET_MITER_LIMIT:
        case GR_SET_LINE_STYLE:
        case GR_SET_LINE_COLOR_INDEX:
        case GR_SET_CUSTOM_LINE_STYLE:
        case GR_SET_AREA_COLOR:
        case GR_SET_AREA_COLOR_MAP:
        case GR_SET_AREA_MASK:
        case GR_SET_AREA_ATTR:
        case GR_SET_AREA_COLOR_INDEX:
        case GR_SET_AREA_PATTERN:
        case GR_SET_TEXT_COLOR:
        case GR_SET_TEXT_MASK:
        case GR_SET_TEXT_COLOR_MAP:
        case GR_SET_TEXT_STYLE:
        case GR_SET_TEXT_MODE:
        case GR_SET_TEXT_SPACE_PAD:
        case GR_SET_TEXT_ATTR:
        case GR_SET_FONT:
        case GR_SET_TEXT_COLOR_INDEX:
        case GR_SET_CUSTOM_TEXT_MASK:
        case GR_SET_TRACK_KERN:
        case GR_SET_FONT_WEIGHT:
        case GR_SET_FONT_WIDTH:
        case GR_SET_SUPERSCRIPT_ATTR:
        case GR_SET_SUBSCRIPT_ATTR:
        case GR_SET_TEXT_PATTERN:
        case GR_MOVE_TO_WWFIXED:
        case GR_ATTR_8F:
        case GR_BEGIN_PATH:
        case GR_END_PATH:
        case GR_CLOSE_SUB_PATH:
            return SVG_OPCODE_SUPPORTED_STATE;

        case GR_END_GSTRING:
        case GR_COMMENT:
        case GR_NULL_OP:
        case GR_SET_GSTRING_BOUNDS:
        case GR_LABEL:
            return SVG_OPCODE_IGNORABLE_METADATA;

        default:
            return SVG_OPCODE_UNSUPPORTED_RENDERING;
    }
}

word _pascal
SvgExportValidateElement(const byte *elementData,
                          word elementType,
                          word elementSize)
{
    word minimumSize;
    word count;
    word expectedSize;

    if ((elementData == (void*)0) ||
        (elementSize < SVG_EXPORT_OPCODE_SIZE) ||
        (elementData[0] != (byte)elementType))
    {
        return TE_EXPORT_ERROR;
    }

    minimumSize = SVG_EXPORT_OPCODE_SIZE;
    switch (elementType)
    {
        case GR_COMMENT:
            if (elementSize < SVG_EXPORT_COMMENT_HEADER_SIZE)
            {
                return TE_EXPORT_ERROR;
            }
            count = SvgExportReadWord(elementData, SVG_EXPORT_OPCODE_SIZE);
            if (count > (SVG_EXPORT_ELEMENT_BUFFER_SIZE -
                         SVG_EXPORT_COMMENT_HEADER_SIZE))
            {
                return TE_EXPORT_ERROR;
            }
            expectedSize = SVG_EXPORT_COMMENT_HEADER_SIZE + count;
            return (elementSize == expectedSize) ?
                   TE_NO_ERROR : TE_EXPORT_ERROR;

        case GR_DRAW_POLYLINE:
        case GR_DRAW_POLYGON:
        case GR_DRAW_SPLINE:
        case GR_DRAW_SPLINE_TO:
            if (elementSize < SVG_EXPORT_POLY_HEADER_SIZE)
            {
                return TE_EXPORT_ERROR;
            }
            count = SvgExportReadWord(elementData, SVG_EXPORT_OPCODE_SIZE);
            if (count > ((SVG_EXPORT_ELEMENT_BUFFER_SIZE -
                          SVG_EXPORT_POLY_HEADER_SIZE) /
                         SVG_EXPORT_POINT_SIZE))
            {
                return TE_EXPORT_ERROR;
            }
            expectedSize = SVG_EXPORT_POLY_HEADER_SIZE +
                           (count * SVG_EXPORT_POINT_SIZE);
            return (elementSize == expectedSize) ?
                   TE_NO_ERROR : TE_EXPORT_ERROR;

        case GR_FILL_POLYGON:
            if (elementSize < SVG_EXPORT_FILL_POLYGON_HEADER_SIZE)
            {
                return TE_EXPORT_ERROR;
            }
            count = SvgExportReadWord(elementData, SVG_EXPORT_OPCODE_SIZE);
            if (count > ((SVG_EXPORT_ELEMENT_BUFFER_SIZE -
                          SVG_EXPORT_FILL_POLYGON_HEADER_SIZE) /
                         SVG_EXPORT_POINT_SIZE))
            {
                return TE_EXPORT_ERROR;
            }
            expectedSize = SVG_EXPORT_FILL_POLYGON_HEADER_SIZE +
                           (count * SVG_EXPORT_POINT_SIZE);
            if (elementSize != expectedSize)
            {
                return TE_EXPORT_ERROR;
            }
            if ((elementData[SVG_EXPORT_POLY_HEADER_SIZE] != ODD_EVEN) &&
                (elementData[SVG_EXPORT_POLY_HEADER_SIZE] != WINDING))
            {
                return TE_EXPORT_ERROR;
            }
            return TE_NO_ERROR;

        case GR_BRUSH_POLYLINE:
            if (elementSize < (SVG_EXPORT_POLY_HEADER_SIZE + 2))
            {
                return TE_EXPORT_ERROR;
            }
            count = SvgExportReadWord(elementData, SVG_EXPORT_OPCODE_SIZE);
            if (count > ((SVG_EXPORT_ELEMENT_BUFFER_SIZE -
                          SVG_EXPORT_POLY_HEADER_SIZE - 2) /
                         SVG_EXPORT_POINT_SIZE))
            {
                return TE_EXPORT_ERROR;
            }
            expectedSize = SVG_EXPORT_POLY_HEADER_SIZE + 2 +
                           (count * SVG_EXPORT_POINT_SIZE);
            return (elementSize == expectedSize) ?
                   TE_NO_ERROR : TE_EXPORT_ERROR;

        case GR_SET_CUSTOM_LINE_STYLE:
            if (elementSize < SVG_EXPORT_CUSTOM_LINE_STYLE_HEADER_SIZE)
            {
                return TE_EXPORT_ERROR;
            }
            count = SvgExportReadWord(
                elementData,
                SVG_EXPORT_OPCODE_SIZE + SVG_EXPORT_WORD_SIZE);
            if (count > MAX_DASH_ARRAY_PAIRS)
            {
                return TE_EXPORT_ERROR;
            }
            expectedSize = SVG_EXPORT_CUSTOM_LINE_STYLE_HEADER_SIZE +
                           (count * SVG_EXPORT_WORD_SIZE);
            return (elementSize == expectedSize) ?
                   TE_NO_ERROR : TE_EXPORT_ERROR;

        case GR_DRAW_LINE:
        case GR_DRAW_RECT:
        case GR_FILL_RECT:
        case GR_DRAW_ELLIPSE:
        case GR_FILL_ELLIPSE:
            minimumSize = 9;
            break;

        case GR_DRAW_LINE_TO:
        case GR_DRAW_RECT_TO:
        case GR_FILL_RECT_TO:
        case GR_MOVE_TO:
            minimumSize = 5;
            break;

        case GR_DRAW_REL_LINE_TO:
        case GR_REL_MOVE_TO:
        case GR_MOVE_TO_WWFIXED:
            minimumSize = 9;
            break;

        case GR_DRAW_HLINE:
        case GR_DRAW_VLINE:
            minimumSize = 7;
            break;

        case GR_DRAW_HLINE_TO:
        case GR_DRAW_VLINE_TO:
            minimumSize = 3;
            break;

        case GR_DRAW_ROUND_RECT:
        case GR_FILL_ROUND_RECT:
            minimumSize = 11;
            break;

        case GR_DRAW_ROUND_RECT_TO:
        case GR_FILL_ROUND_RECT_TO:
            minimumSize = 7;
            break;

        case GR_DRAW_ARC:
        case GR_FILL_ARC:
            minimumSize = 15;
            if ((elementSize >= minimumSize) &&
                (SvgExportReadWord(elementData,
                                    SVG_EXPORT_OPCODE_SIZE) > ACT_PIE))
            {
                return TE_EXPORT_ERROR;
            }
            if ((elementType == GR_FILL_ARC) &&
                (elementSize >= minimumSize) &&
                (SvgExportReadWord(elementData,
                                    SVG_EXPORT_OPCODE_SIZE) == ACT_OPEN))
            {
                return TE_EXPORT_ERROR;
            }
            break;

        case GR_DRAW_CURVE:
            minimumSize = 17;
            break;

        case GR_DRAW_CURVE_TO:
        case GR_DRAW_REL_CURVE_TO:
            minimumSize = 13;
            break;

        case GR_FILL_PATH:
            minimumSize = 2;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] != ODD_EVEN) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] != WINDING))
            {
                return TE_EXPORT_ERROR;
            }
            break;

        case GR_APPLY_ROTATION:
            minimumSize = 5;
            break;

        case GR_APPLY_SCALE:
        case GR_APPLY_TRANSLATION:
        case GR_APPLY_TRANSLATION_DWORD:
            minimumSize = 9;
            break;

        case GR_APPLY_TRANSFORM:
        case GR_SET_TRANSFORM:
            minimumSize = SVG_EXPORT_OPCODE_SIZE + sizeof(TransMatrix);
            break;

        case GR_SET_MIX_MODE:
            minimumSize = 2;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] != MM_COPY))
            {
                return TE_EXPORT_NOT_SUPPORTED;
            }
            break;

        case GR_SET_LINE_COLOR:
        case GR_SET_AREA_COLOR:
        case GR_SET_TEXT_COLOR:
            minimumSize = 4;
            break;

        case GR_SET_LINE_MASK:
        case GR_SET_AREA_MASK:
            minimumSize = 2;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] != SDM_100))
            {
                return TE_EXPORT_NOT_SUPPORTED;
            }
            break;

        case GR_SET_LINE_COLOR_MAP:
        case GR_SET_AREA_COLOR_MAP:
            minimumSize = 2;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] != CMT_DITHER))
            {
                return TE_EXPORT_NOT_SUPPORTED;
            }
            break;

        case GR_SET_LINE_WIDTH:
        case GR_SET_MITER_LIMIT:
            minimumSize = 5;
            break;

        case GR_SET_LINE_STYLE:
            minimumSize = 3;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] > LS_CUSTOM))
            {
                return TE_EXPORT_ERROR;
            }
            break;

        case GR_SET_LINE_ATTR:
            minimumSize = SVG_EXPORT_OPCODE_SIZE + sizeof(LineAttr);
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE + 4] != SDM_100))
            {
                return TE_EXPORT_NOT_SUPPORTED;
            }
            if ((elementSize >= minimumSize) &&
                ((elementData[SVG_EXPORT_OPCODE_SIZE + 6] > LE_SQUARECAP) ||
                 (elementData[SVG_EXPORT_OPCODE_SIZE + 7] > LJ_BEVELED) ||
                 (elementData[SVG_EXPORT_OPCODE_SIZE + 8] > LS_CUSTOM)))
            {
                return TE_EXPORT_ERROR;
            }
            break;

        case GR_SET_AREA_ATTR:
            minimumSize = SVG_EXPORT_OPCODE_SIZE + sizeof(AreaAttr);
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE + 4] != SDM_100))
            {
                return TE_EXPORT_NOT_SUPPORTED;
            }
            break;

        case GR_SET_AREA_PATTERN:
            minimumSize = SVG_EXPORT_OPCODE_SIZE + sizeof(GraphicPattern);
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] != PT_SOLID))
            {
                return TE_EXPORT_NOT_SUPPORTED;
            }
            break;

        case GR_SET_TEXT_ATTR:
            minimumSize = SVG_EXPORT_OPCODE_SIZE + sizeof(TextAttr);
            break;

        case GR_SET_GSTRING_BOUNDS:
            minimumSize = 9;
            break;

        case GR_LABEL:
        case GR_SET_TEXT_STYLE:
        case GR_SET_TEXT_MODE:
        case GR_SET_TEXT_SPACE_PAD:
        case GR_SET_TRACK_KERN:
        case GR_SET_SUPERSCRIPT_ATTR:
        case GR_SET_SUBSCRIPT_ATTR:
        case GR_SET_TEXT_PATTERN:
            minimumSize = 3;
            break;

        case GR_SET_FONT:
            minimumSize = 5;
            break;

        case GR_BEGIN_PATH:
            minimumSize = 5;
            break;

        case GR_SET_LINE_JOIN:
            minimumSize = 2;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] > LJ_BEVELED))
            {
                return TE_EXPORT_ERROR;
            }
            break;

        case GR_SET_LINE_END:
            minimumSize = 2;
            if ((elementSize >= minimumSize) &&
                (elementData[SVG_EXPORT_OPCODE_SIZE] > LE_SQUARECAP))
            {
                return TE_EXPORT_ERROR;
            }
            break;

        case GR_SET_LINE_COLOR_INDEX:
        case GR_SET_AREA_COLOR_INDEX:
        case GR_SET_TEXT_MASK:
        case GR_SET_TEXT_COLOR_MAP:
        case GR_SET_TEXT_COLOR_INDEX:
        case GR_SET_FONT_WEIGHT:
        case GR_SET_FONT_WIDTH:
        case GR_ATTR_8F:
            minimumSize = 2;
            break;

        case GR_SET_CUSTOM_TEXT_MASK:
            minimumSize = 9;
            break;

        default:
            break;
    }

    return (elementSize >= minimumSize) ? TE_NO_ERROR : TE_EXPORT_ERROR;
}

word _pascal
SvgExportReadElement(SvgExportContext *context,
                      GStateHandle playbackGState,
                      GStateHandle sourceGState,
                      word expectedType)
{
    GStringElement readType;
    byte *elementData;
    word elementSize;
    word copiedSize;

    if ((context == (void*)0) ||
        (context->bufferHeapH == NullHandle) ||
        (context->elementDataP != (void*)0))
    {
        return TE_EXPORT_ERROR;
    }

    readType = GrGetGStringElement(playbackGState, sourceGState, 0,
                                   (void*)0, &elementSize);
    if ((readType == SVG_EXPORT_INVALID_OPCODE) ||
        (readType != (GStringElement)expectedType) ||
        (elementSize < SVG_EXPORT_OPCODE_SIZE) ||
        (elementSize > SVG_EXPORT_ELEMENT_BUFFER_SIZE))
    {
        return TE_EXPORT_ERROR;
    }
    if (!SvgExportEnsureScratch(context, elementSize))
    {
        return TE_OUT_OF_MEMORY;
    }

    if (MemLock(context->bufferHeapH) == (void *)0)
    {
        return TE_OUT_OF_MEMORY;
    }
    elementData = LMemDerefHandles(context->bufferHeapH,
                                   context->scratchChunkH);
    if (elementData == (void*)0)
    {
        MemUnlock(context->bufferHeapH);
        return TE_OUT_OF_MEMORY;
    }
    copiedSize = 0;
    readType = GrGetGStringElement(playbackGState, sourceGState,
                                   elementSize, elementData,
                                   &copiedSize);
    if ((readType != (GStringElement)expectedType) ||
        (copiedSize != elementSize))
    {
        MemUnlock(context->bufferHeapH);
        return TE_EXPORT_ERROR;
    }

    context->elementDataP = elementData;
    context->elementSize = elementSize;
    return TE_NO_ERROR;
}

void _pascal
SvgExportReleaseElement(SvgExportContext *context)
{
    if ((context != (void*)0) &&
        (context->elementDataP != (void*)0))
    {
        context->elementDataP = (void*)0;
        context->elementSize = 0;
        MemUnlock(context->bufferHeapH);
    }
}

static void
SvgExportAddRelativePoint(const PointWWFixed *basePoint,
                           const PointWWFixed *deltaPoint,
                           PointWWFixed *targetPoint)
{
    SvgExportSetWWFixedComponent(
        &targetPoint->PF_x,
        (WWFixedAsDWord)(
            (dword)SvgExportPackWWFixed(&basePoint->PF_x) +
            (dword)SvgExportPackWWFixed(&deltaPoint->PF_x)));
    SvgExportSetWWFixedComponent(
        &targetPoint->PF_y,
        (WWFixedAsDWord)(
            (dword)SvgExportPackWWFixed(&basePoint->PF_y) +
            (dword)SvgExportPackWWFixed(&deltaPoint->PF_y)));
}

word _pascal
SvgExportDecodeGeometry(word elementType,
                         const PointWWFixed *currentPosition,
                         const byte *elementData,
                         word elementSize,
                         SvgExportGeometryType *geometryType,
                         PointWWFixed *startPoint,
                         PointWWFixed *control1,
                         PointWWFixed *control2,
                         PointWWFixed *endPoint)
{
    Point intPoint;
    PointWWFixed tempPoint;
    WWFixedAsDWord componentValue;
    word offset;
    word wordValue;
    word error;

    if ((currentPosition == (void*)0) ||
        (geometryType == (void*)0) ||
        (startPoint == (void*)0) || (control1 == (void*)0) ||
        (control2 == (void*)0) || (endPoint == (void*)0))
    {
        return TE_EXPORT_ERROR;
    }

    *geometryType = SVG_GEOMETRY_NONE;
    error = SvgExportValidateElement(elementData, elementType,
                                      elementSize);
    if (error != TE_NO_ERROR)
    {
        return error;
    }
    offset = sizeof(GStringElement);

    switch (elementType)
    {
        case GR_MOVE_TO:
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            SvgExportPointFromInt(&intPoint, endPoint);
            *geometryType = SVG_GEOMETRY_MOVE;
            break;

        case GR_MOVE_TO_WWFIXED:
        case GR_REL_MOVE_TO:
            SvgExportReadWWFixed(elementData, offset,
                                  &tempPoint.PF_x);
            offset += sizeof(WWFixed);
            SvgExportReadWWFixed(elementData, offset,
                                  &tempPoint.PF_y);
            if (elementType == GR_MOVE_TO_WWFIXED)
            {
                SvgExportCopyPointWWFixed(endPoint, &tempPoint);
            }
            else
            {
                SvgExportAddRelativePoint(currentPosition, &tempPoint,
                                           endPoint);
            }
            *geometryType = SVG_GEOMETRY_MOVE;
            break;

        case GR_DRAW_LINE:
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            SvgExportPointFromInt(&intPoint, startPoint);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            SvgExportPointFromInt(&intPoint, endPoint);
            *geometryType = SVG_GEOMETRY_LINE;
            break;

        case GR_DRAW_LINE_TO:
            SvgExportCopyPointWWFixed(startPoint, currentPosition);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            SvgExportPointFromInt(&intPoint, endPoint);
            *geometryType = SVG_GEOMETRY_LINE;
            break;

        case GR_DRAW_REL_LINE_TO:
            SvgExportCopyPointWWFixed(startPoint, currentPosition);
            SvgExportReadWWFixed(elementData, offset,
                                  &tempPoint.PF_x);
            offset += sizeof(WWFixed);
            SvgExportReadWWFixed(elementData, offset,
                                  &tempPoint.PF_y);
            SvgExportAddRelativePoint(currentPosition, &tempPoint,
                                       endPoint);
            *geometryType = SVG_GEOMETRY_LINE;
            break;

        case GR_DRAW_HLINE:
        case GR_DRAW_VLINE:
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            wordValue = SvgExportReadWord(elementData, offset);
            SvgExportPointFromInt(&intPoint, startPoint);
            componentValue =
                (WWFixedAsDWord)((sdword)(sword)wordValue * 65536L);
            tempPoint = *startPoint;
            if (elementType == GR_DRAW_HLINE)
            {
                SvgExportSetWWFixedComponent(&tempPoint.PF_x,
                                              componentValue);
            }
            else
            {
                SvgExportSetWWFixedComponent(&tempPoint.PF_y,
                                              componentValue);
            }
            SvgExportCopyPointWWFixed(endPoint, &tempPoint);
            *geometryType = SVG_GEOMETRY_LINE;
            break;

        case GR_DRAW_HLINE_TO:
        case GR_DRAW_VLINE_TO:
            SvgExportCopyPointWWFixed(startPoint, currentPosition);
            wordValue = SvgExportReadWord(elementData, offset);
            componentValue =
                (WWFixedAsDWord)((sdword)(sword)wordValue * 65536L);
            tempPoint = *currentPosition;
            if (elementType == GR_DRAW_HLINE_TO)
            {
                SvgExportSetWWFixedComponent(&tempPoint.PF_x,
                                              componentValue);
            }
            else
            {
                SvgExportSetWWFixedComponent(&tempPoint.PF_y,
                                              componentValue);
            }
            SvgExportCopyPointWWFixed(endPoint, &tempPoint);
            *geometryType = SVG_GEOMETRY_LINE;
            break;

        case GR_DRAW_CURVE:
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            SvgExportPointFromInt(&intPoint, startPoint);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            SvgExportPointFromInt(&intPoint, control1);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            SvgExportPointFromInt(&intPoint, control2);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            SvgExportPointFromInt(&intPoint, endPoint);
            *geometryType = SVG_GEOMETRY_CURVE;
            break;

        case GR_DRAW_CURVE_TO:
            SvgExportCopyPointWWFixed(startPoint, currentPosition);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            SvgExportPointFromInt(&intPoint, control1);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            SvgExportPointFromInt(&intPoint, control2);
            intPoint.P_x = SvgExportReadSword(elementData, offset);
            offset += sizeof(sword);
            intPoint.P_y = SvgExportReadSword(elementData, offset);
            SvgExportPointFromInt(&intPoint, endPoint);
            *geometryType = SVG_GEOMETRY_CURVE;
            break;

        case GR_DRAW_REL_CURVE_TO:
            SvgExportCopyPointWWFixed(startPoint, currentPosition);
            tempPoint.PF_x.WWF_int =
                SvgExportReadSword(elementData, offset);
            tempPoint.PF_x.WWF_frac = 0;
            offset += sizeof(sword);
            tempPoint.PF_y.WWF_int =
                SvgExportReadSword(elementData, offset);
            tempPoint.PF_y.WWF_frac = 0;
            offset += sizeof(sword);
            SvgExportAddRelativePoint(currentPosition, &tempPoint,
                                       control1);
            tempPoint.PF_x.WWF_int =
                SvgExportReadSword(elementData, offset);
            tempPoint.PF_x.WWF_frac = 0;
            offset += sizeof(sword);
            tempPoint.PF_y.WWF_int =
                SvgExportReadSword(elementData, offset);
            tempPoint.PF_y.WWF_frac = 0;
            offset += sizeof(sword);
            SvgExportAddRelativePoint(currentPosition, &tempPoint,
                                       control2);
            tempPoint.PF_x.WWF_int =
                SvgExportReadSword(elementData, offset);
            tempPoint.PF_x.WWF_frac = 0;
            offset += sizeof(sword);
            tempPoint.PF_y.WWF_int =
                SvgExportReadSword(elementData, offset);
            tempPoint.PF_y.WWF_frac = 0;
            SvgExportAddRelativePoint(currentPosition, &tempPoint,
                                       endPoint);
            *geometryType = SVG_GEOMETRY_CURVE;
            break;

        case GR_CLOSE_SUB_PATH:
            *geometryType = SVG_GEOMETRY_CLOSE;
            break;

        default:
            break;
    }
    return TE_NO_ERROR;
}
void* _pascal SvgExportAs(const void *raw, word expectedOpcode)
{
    const GStringElement *opcodeP;

    if (raw == NULL)
    {
        return (void*)0;
    }

    opcodeP = (const GStringElement*)raw;
    if (*opcodeP != (GStringElement)expectedOpcode)
    {
        return (void*)0;
    }

    return (void*)raw;
}

Boolean _pascal SvgExportIsLineOpcode(word elementType)
{
    switch (elementType)
    {
        case GR_DRAW_LINE:
        case GR_DRAW_LINE_TO:
        case GR_DRAW_REL_LINE_TO:
        case GR_DRAW_HLINE:
        case GR_DRAW_VLINE:
        case GR_DRAW_HLINE_TO:
        case GR_DRAW_VLINE_TO:
            return TRUE;
        default:
            return FALSE;
    }
}

