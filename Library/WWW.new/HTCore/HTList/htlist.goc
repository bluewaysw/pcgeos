@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htutils.goh>
@include <chunkarr.h>
#include <Ansi/string.h>		/* memcpy(), memcmp() */
#include <ec.h>
#include <WWW/htmem.h>

@include "htfatals.goh"

/* ---------------------------------------------------------------------
 * 		PRIVATE DATA
 * --------------------------------------------------------------------*/

/* 
 * We create a chunkarray in a block if it less than 6K. We append to a 
 * list if its block size is less than 8K.
 */
#define DESIRED_HTLIST_PER_BLOCK         10
#define DESIRED_HTLISTNEW_BLOCK_SIZE     6000
#define DESIRED_HTLISTAPPEND_BLOCK_SIZE  8000

/*
 * Information about a block for creating chunkarrays.
 */
typedef struct {
    MemHandle HTB_mh;
    word HTB_id;               /* for APIs ending with ...WID, 0 for no ID */
    word HTB_numOfArrays;      /* number of chunkarrays in this block */
} HTListBlock;

/*
 * HTList header information. Lists in the same block can not grow
 * bigger than DESIRED_HTLISTAPPEND_BLOCK_SIZE.
 */
typedef struct {
    ChunkArrayHeader  HTLH_carray;  /* Original header info */
    /* Extra information follows here */
    HTListHandle HTLH_next; /* NULL if last HTList */
} HTListHeader;

/*
 * Library won't compile unless there is a dgroup, this dummy does 
 * the job! :)
 */
byte htListDummy;

@start HTListData, data;

/*
 * List of memory blocks for creating chunkarrays.
 */
@chunk HTListHandle htlistMemoryBlocks = NULL;

@end   HTListData;


/* ---------------------------------------------------------------------
 * 		PRIVATE FUNCTIONS
 * --------------------------------------------------------------------*/

static HTListHandle _pascal HTListNewLow (word id);
static word _pascal HTListID (MemHandle mh);


#if ERROR_CHECK
/***********************************************************************
 *		ECCheckHTListBlocks
 ***********************************************************************
 *
 * SYNOPSIS:	Check the consistency of htlistMemoryBlocks, which must
 *              not be locked.
 * CALLED BY:	
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
ECCheckHTListBlocks (void)
{
    HTListHandle *lptr;
    HTListBlock *bptr;
    word count, i, size;
    MemHandle mh = OptrToHandle(@htlistMemoryBlocks);
	
    MemPLock(mh);

    lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    count = ChunkArrayGetCount(*lptr);

    for (i=0; i<count; i++) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(*lptr, i, &size);
	ECCheckMemHandle(bptr->HTB_mh);
	if (bptr->HTB_id && (bptr->HTB_id >= HTMID_END)) {
	    EC_ERROR(INVALID_ID_FOR_HTLIST);        
	}
    }

    MemUnlockV(mh);
}	/* End of ECCheckHTListBlocks.	*/
#endif


/***********************************************************************
 *		HTListNewLow
 ***********************************************************************
 *
 * SYNOPSIS:	Create a two types of HTList for an id.
 * CALLED BY:	HTListNew, HTListNewWID
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/10/97   	Initial Revision
 *	
 ***********************************************************************/
static HTListHandle _pascal
HTListNewLow (word id)
{
    HTListHandle *lptr, list = NullOptr;
    HTListBlock *bptr;
    ChunkHandle chunk;
    word count, i, size;
    MemHandle mh = OptrToHandle(@htlistMemoryBlocks);
	
#if ERROR_CHECK
    if (id >= HTMID_END)
	EC_ERROR(INVALID_ID_FOR_HTLIST);        
#endif

    MemPLock(mh);

    lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    if (!(*lptr)) {
	/* 
	 * Create a list for maintaining memory blocks.
	 * lptr invalidated!
	 */
	chunk = ChunkArrayCreate(mh, 0, 0, 0);
	lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);
	*lptr = ConstructOptr(mh, chunk); /* save it */
    }

    /*
     * Search the list of blocks to create a chunkarray.
     */
    count = ChunkArrayGetCount(*lptr);

    for (i=0; i<count; i++) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(*lptr, i, &size);

	if ((bptr->HTB_id == id) &&
	    (bptr->HTB_numOfArrays < DESIRED_HTLIST_PER_BLOCK) &&
	    (MemGetInfo(bptr->HTB_mh, MGIT_SIZE) < 
	     DESIRED_HTLISTNEW_BLOCK_SIZE)) {

	    MemThreadGrab(bptr->HTB_mh);
	    chunk = ChunkArrayCreate(bptr->HTB_mh, 0, 
				     sizeof(HTListHeader), 0);
	    MemThreadRelease(bptr->HTB_mh);

	    if (chunk) {
		/* 
		 * Update the HTListBlock.
		 */
		bptr->HTB_numOfArrays += 1;
		list = ConstructOptr(bptr->HTB_mh, chunk);
	    }
	    break;
	}
    }

    /* 
     * If we did not find a block that fits, create one.
     */
    if (!list) {
	MemHandle nmh = MemAllocLMem(LMEM_TYPE_GENERAL, 0);
	if (nmh) {
	    /*
	     * We need to make the Library own the block as it is
	     * shared by all other Library clients.
	     */
	    HandleModifyOwner(nmh, GeodeGetCodeProcessHandle());
	    MemModifyFlags(nmh, HF_SHARABLE, 0);

	    MemThreadGrab(nmh);
	    chunk = ChunkArrayCreate(nmh, 0, sizeof(HTListHeader), 0);
	    
	    /* Update the list of memory blocks */
	    bptr = ChunkArrayAppend(*lptr, sizeof(HTListBlock));
	    bptr->HTB_mh = nmh;
	    bptr->HTB_id = id;
	    bptr->HTB_numOfArrays = 1;

	    list = ConstructOptr(nmh, chunk);

EC(         ECCheckChunkArray(list);                                  )

	    MemThreadRelease(nmh);
	}
    }

    MemUnlockV(mh);

EC( ECCheckHTListBlocks();                                             )	

    return list;
}	/* End of HTListNewLow.	*/


/***********************************************************************
 *		HTListID
 ***********************************************************************
 *
 * SYNOPSIS:	Get the ID of a HTList block handle.
 * CALLED BY:	HTListAppend
 * RETURN:	id or 0 for no ID.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/10/97   	Initial Revision
 *	
 ***********************************************************************/
static word _pascal
HTListID (MemHandle han)
{
    HTListHandle *lptr;
    HTListBlock *bptr;
    word ret = 0;
    word count, i, size;
    MemHandle mh = OptrToHandle(@htlistMemoryBlocks);
	
    MemPLock(mh);

    lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    count = ChunkArrayGetCount(*lptr);

    for (i=0; i<count; i++) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(*lptr, i, &size);
	if (bptr->HTB_mh == han) {
	    ret = bptr->HTB_id;
	    break;
	}
    }

    MemUnlockV(mh);
    return ret;
}	/* End of HTListID.	*/



/* ---------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * --------------------------------------------------------------------*/



/***********************************************************************
 *		ECCHECKHTLIST
 ***********************************************************************
 *
 * SYNOPSIS:	Check that a HTList is valid.
 * CALLED BY:	Client.
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 1/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
ECCHECKHTLIST (HTListHandle list)
{
#if ERROR_CHECK
    MemHandle mh = OptrToHandle(list);

    if (!list) return;

    MemThreadGrab(mh);
    ECLMemExists(list);
    MemThreadRelease(mh);

#endif
}	/* End of ECCHECKHTLIST.	*/




/***********************************************************************
 *		HTLISTNEW
 ***********************************************************************
 * SYNOPSIS:	Create a new list.
 * CALLED BY:	Client
 * PASS:	Nothing
 * RETURN:	HTListHandle	
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/24/96   	Initial Revision
 *
 ***********************************************************************/
HTListHandle _far _pascal
HTLISTNEW (void)
{	
    return HTListNewLow(0);  /* No id */
}	/* End of HTLISTNEW.	*/


/***********************************************************************
 *		HTLISTNEWWID
 ***********************************************************************
 *
 * SYNOPSIS:	Create a new list given an ID. 
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/10/97   	Initial Revision
 *	
 ***********************************************************************/
HTListHandle _far _pascal
HTLISTNEWWID (word id)
{
#if ERROR_CHECK
    if ((id == HTMID_BASE) || (id >= HTMID_END))
	EC_ERROR(INVALID_ID_FOR_HTLIST);
#endif
    return HTListNewLow(id);
}	/* End of HTLISTNEWWID.	*/




/***********************************************************************
 *		HTLISTDELETEALLITEMS
 ***********************************************************************
 *
 * SYNOPSIS:	Delete all items from a HTList. Does not delete the 
 *              list itself. To delete the HTList, use HTListDelete.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/23/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTDELETEALLITEMS (HTListHandle list)
{
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;
    HTListHandle next;

    if (list == NULL) return;
    
    MemThreadGrab(mh);
EC( ECCheckChunkArray(list);                                            )

    /* All the items */
    header = (HTListHeader *) LMemDeref(list);
    next = header->HTLH_next;
    header->HTLH_next = 0;  /* Delete it later */
    ChunkArrayDeleteRange(list, 0, header->HTLH_carray.CAH_count);

    MemThreadRelease(mh);

    if (next) HTListDelete(next);  /* Delete the rest */
}	/* End of HTLISTDELETEALLITEMS.	*/



/***********************************************************************
 *		HTLISTDELETERANGE
 ***********************************************************************
 *
 * SYNOPSIS:	Delete a range of items. Pass (x)index as the first item
 *              to delete and (y)count as the number of items to delete.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/23/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTDELETERANGE (HTListHandle list, word x, word y) {

#define min(a,b) ((a)>(b) ? (b):(a))

    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;
    HTListHandle next;
    word x1, y1;   /* Current range to delete */
    word x2, y2;   /* Range to delete for header->HTLH_next */
    word count;

    if (list == NULL) return;
    
    MemThreadGrab(mh);
EC( ECCheckChunkArray(list);                                            )

    header = (HTListHeader *) LMemDeref(list);
    count = header->HTLH_carray.CAH_count;

EC( if ((count<(x+y)) && !(header->HTLH_next))                          )
EC(     EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

/* 
 *    x1 = (count>x) ? x:0;
 *    y1 = (count>x) ? min(count-x,y):0;
 *    x2 = (x>count) ? (x-count):0;
 *    y2 = y-y1;
 */
    if (count > x) {
	x1 = x; 
	y1 = min(count-x, y);
	x2 = 0;
    } else {
	x1 = 0;
	y1 = 0;
	x2 = x-count;
    }
    y2 = y-y1;

    if (y1) ChunkArrayDeleteRange(list, x1, y1);
    next = header->HTLH_next;

    MemThreadRelease(mh);

    if (next && y2) HTListDeleteRange(next, x2, y2);
}	/* End of HTLISTDELETERANGE.	*/




/***********************************************************************
 *		HTLISTDELETE
 ***********************************************************************
 * SYNOPSIS:	Delete a HTList. All the items in the list will be 
 *              deleted as well.
 * CALLED BY:	Client.
 * PASS:	list = list to delete.
 * RETURN:	Nothing
 * SIDE EFFECTS:Do nothing if the passed in list is NULL.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/24/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTDELETE (HTListHandle list)
{
    HTListHandle blockList;
    HTListBlock *bptr;
    word count, i, size;
    MemHandle mh, fmh = OptrToHandle(list);
    HTListHeader *header;
    HTListHandle next;

    /* 
     * First, free the chunkarray itself.
     */
    if (list == NULL) return;
    
    MemThreadGrab(fmh);
EC( ECCheckChunkArray(list);                                            )

    header = (HTListHeader *) LMemDeref(list);
    next = header->HTLH_next;

    ChunkArrayDeleteRange(list, 0, header->HTLH_carray.CAH_count);
    LMemFree(list);

    MemThreadRelease(fmh);

    /* 
     * Second, we may need to free the block as well.
     */
    mh = OptrToHandle(@htlistMemoryBlocks);
    MemPLock(mh);

    blockList = *(HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    count = ChunkArrayGetCount(blockList);

    for (i=0; i<count; i++) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(blockList, i, &size);
	if (bptr->HTB_mh == fmh) {
	    bptr->HTB_numOfArrays -= 1;
	    if (!bptr->HTB_numOfArrays) {
		MemFree(fmh);
		ChunkArrayDelete(blockList, bptr);
	    }
	    break;
	}
    }
    
    MemUnlockV(mh);

EC( ECCheckHTListBlocks();                                             )	

    if (next) HTListDelete(next);
}	/* End of HTLISTDELETE.	*/



/***********************************************************************
 *		HTLISTDELETEALLWID
 ***********************************************************************
 *
 * SYNOPSIS:	Delete all the HTLists allocated using HTListNewWID.
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/10/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTLISTDELETEALLWID (word id)
{
    HTListHandle blockList;
    HTListBlock *bptr;
    word count, i, size;
    MemHandle mh = OptrToHandle(@htlistMemoryBlocks);

#if ERROR_CHECK
    if ((id == HTMID_BASE) || (id >= HTMID_END))
	EC_ERROR(INVALID_ID_FOR_HTLIST);        
#endif

    MemPLock(mh);

    blockList = *(HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    count = ChunkArrayGetCount(blockList);
    i = 0;
    while (i<count) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(blockList, i, &size);
	if (bptr->HTB_id == id) {
	    MemFree(bptr->HTB_mh);
	    ChunkArrayDelete(blockList, bptr);
	    count--;
	} else {
	    i++;
	}
    }
    
    MemUnlockV(mh);

EC( ECCheckHTListBlocks();                                             )	
}	/* End of HTLISTDELETEALLWID.	*/




/***********************************************************************
 *		HTLISTAPPEND
 ***********************************************************************
 * SYNOPSIS:	Append an item to the end of a HTList.
 * CALLED BY:	Client.	
 * PASS:	list = list to append.
 *		item = data to append.
 *		size = size of item.
 * RETURN:	word, the index of the appended item, 0th-based.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/24/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTLISTAPPEND (HTListHandle list, const void *item, word size)
{
    void *element;	
    word index = 0;
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;
    HTListHandle nlist;

    /* Append to the last HTList in list */
    MemThreadGrab(mh);
EC( ECCheckChunkArray(list);                                            )

    header = (HTListHeader *) LMemDeref(list);
    index = header->HTLH_carray.CAH_count;
    while (header->HTLH_next) {
	list = header->HTLH_next;
	MemThreadRelease(mh);
	mh = OptrToHandle(list);
	MemThreadGrab(mh);
	header = (HTListHeader *) LMemDeref(list);
	index += header->HTLH_carray.CAH_count;
    }

    if (MemGetInfo(mh, MGIT_SIZE) < DESIRED_HTLISTAPPEND_BLOCK_SIZE) {
	element = ChunkArrayAppend(list, size);
	memcpy(element, item, size);
	MemThreadRelease(mh);
    } else {
	/* Create a new HTList to extend the current list */
	word id;
	MemThreadRelease(mh);
	id = HTListID(mh); /* Can't lock mh calling this API */
	nlist = (id==0) ? HTListNew():HTListNewWID(id); 
	MemThreadGrab(mh);
	header = (HTListHeader *) LMemDeref(list);
	header->HTLH_next = nlist;
	MemThreadRelease(mh);

	/* Append new item to nlist */
	mh = OptrToHandle(nlist);
	MemThreadGrab(mh);
	element = ChunkArrayAppend(nlist, size);
	memcpy(element, item, size);
	MemThreadRelease(mh);
    }
    return index;
}	/* End of HTLISTAPPEND.	*/



/***********************************************************************
 *		HTLISTREPLACEITEM
 ***********************************************************************
 *
 * SYNOPSIS:	Replace an item in the list. The item passed in must be
 *              the same size of being replaced if size > 0. If you 
 *              give size = 0, the size does not matter.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:	First, get the element to replace. Then insert item 
 *              before this element, making sure the sizes are right.
 *              Finally remove the element to replace.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 9/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTREPLACEITEM (HTListHandle list, word index, const void *item, 
		   word size)
{
    void *element, *newElement;
    word elementSize;	
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;

    do {
	MemThreadGrab(mh);
EC(     ECCheckChunkArray(list);                                        )

	header = (HTListHeader *) LMemDeref(list);
	if (index < header->HTLH_carray.CAH_count) {
	    break;
	} else {
	    list = header->HTLH_next;
	    index -= header->HTLH_carray.CAH_count;
	    MemThreadRelease(mh);
	}
	mh = OptrToHandle(list);
    } while (list);

EC( if (!list)                                                          )
EC(	EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    element = ChunkArrayElementToPtr(list, index, &elementSize);

EC( if (size && (elementSize != size))                                  )
EC( 	EC_WARNING(HTLIST_REPLACE_ITEM_NOT_THE_SAME_SIZE);              )

    newElement = ChunkArrayInsertAt(list, element, size);
    memcpy(newElement, item, size);

    /* Remove old item */
    ChunkArrayDeleteRange(list, index+1, 1);

    MemThreadRelease(mh);

}	/* End of HTLISTREPLACEITEM.	*/





/***********************************************************************
 *		HTLISTFINDITEM
 ***********************************************************************
 * SYNOPSIS:	Find the first index of an item.
 * CALLED BY:	Client.
 * RETURN:	-1 if not found, else valid index.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/31/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTLISTFINDITEM (HTListHandle list, const void *item, word size)
{
    void *element;
    word count, len, offset=0;
    int i, found = -1;
    HTListHeader *header;
    MemHandle mh = OptrToHandle(list);

    while (list) {
	MemThreadGrab(mh);
EC(     ECCheckChunkArray(list);                                           )

	header = (HTListHeader *) LMemDeref(list);
	count = header->HTLH_carray.CAH_count;
	for (i=0; i<count; i++) {
	    element = ChunkArrayElementToPtr(list, i, &len);
	    if (!memcmp(item, element, len) && len == size) {
		found = i;
		MemThreadRelease(mh);
		break;
	    }
	}
	if (found == -1) {
	    /* Not found, search next list */
	    list = header->HTLH_next;
	    offset += count;
	    MemThreadRelease(mh);
	    mh = OptrToHandle(list);
	} else {
	    break;
	}
    }

    return ((found != -1) ? (found+offset) : -1);
}	/* End of HTLISTFINDITEM.	*/




/***********************************************************************
 *		HTLISTGETITEM
 ***********************************************************************
 * SYNOPSIS:	Fetch an item given its index in a list.
 * CALLED BY:	Client.
 * PASS:	list.
 *              index = index of element to get.
 *		item = buffer for copying the element to return.
 *		size = size of item. If the element gotten exceeds size of
 *                     item, then only the first "size" bytes of element
 *                     are copied.
 * RETURN:	Nothing
 * SIDE EFFECTS:Index must be valid, otherwise FatalError.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/25/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTGETITEM (HTListHandle list, word index, void *item, word size)
{
    void *element;
    word elementSize;
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;

    while (list) {
	MemThreadGrab(mh);
EC(     ECCheckChunkArray(list);                                        )
        
        header = (HTListHeader *) LMemDeref(list);
	if (index < header->HTLH_carray.CAH_count) {
	    /* Found in this list */
	    element = ChunkArrayElementToPtr(list, index, &elementSize);

EC(         if (elementSize > size)                                     )
EC( 	    EC_WARNING(HTLIST_ELEMENT_SIZE_EXCEEDS_PASSED_IN_SIZE);     )

            item = memcpy(item, element, size);
	    MemThreadRelease(mh);
	    break;
	} else {
	    list = header->HTLH_next;
	    index -= header->HTLH_carray.CAH_count;
	    MemThreadRelease(mh);
	    mh = OptrToHandle(list);
	}
    }

EC( if (!list)                                                          )
EC(	EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

}	/* End of HTLISTGETITEM.	*/


/***********************************************************************
 *		HTLISTLOCKITEM
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
void * _far _pascal
HTLISTLOCKITEM (HTListHandle list, word index, MemHandle *mh)
{
    void _far *element = NULL;
    word elementSize;
    HTListHeader *header;

    *mh = OptrToHandle(list);

    while (list) {
	MemThreadGrab(*mh);
EC(     ECCheckChunkArray(list);                                        )
        
        header = (HTListHeader *) LMemDeref(list);
	if (index < header->HTLH_carray.CAH_count) {
	    /* Found in this list */
	    element = ChunkArrayElementToPtr(list, index, &elementSize);
	    break;
	} else {
	    list = header->HTLH_next;
	    index -= header->HTLH_carray.CAH_count;
	    MemThreadRelease(*mh);
	    *mh = OptrToHandle(list);
	}
    }

EC( if (!list)                                                          )
EC(	EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    return element;
}	/* End of HTLISTLOCKITEM.	*/



/***********************************************************************
 *		HTLISTGETITEMSIZE
 ***********************************************************************
 *
 * SYNOPSIS:	Get the size of an item.
 * CALLED BY:	Client.
 * RETURN:	word, size in bytes.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTLISTGETITEMSIZE (HTListHandle list, word index)
{
    word size = 0;
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;

    while (list) {
	MemThreadGrab(mh);
EC(     ECCheckChunkArray(list);                                        )
        
        header = (HTListHeader *) LMemDeref(list);
	if (index < header->HTLH_carray.CAH_count) {
	    /* Found in this list */
	    ChunkArrayElementToPtr(list, index, &size);
	    MemThreadRelease(mh);
	    break;
	} else {
	    list = header->HTLH_next;
	    index -= header->HTLH_carray.CAH_count;
	    MemThreadRelease(mh);
	    mh = OptrToHandle(list);
	}
    }

EC( if (!list)                                                          )
EC(	EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    return size;
}	/* End of HTLISTGETITEMSIZE.	*/




/***********************************************************************
 *		HTLISTGETCOUNT
 ***********************************************************************
 * SYNOPSIS:	Get the number of items in a list.
 * CALLED BY:	Client.
 * PASS:        list.
 * RETURN:	number of items.
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/26/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTLISTGETCOUNT (HTListHandle list)
{
    word count = 0;
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;

    if (list == NULL) return 0;

    while (list) {
	MemThreadGrab(mh);
EC(     ECCheckChunkArray(list);                                        )
    
        header = (HTListHeader *) LMemDeref(list);
        count += header->HTLH_carray.CAH_count;

	list = header->HTLH_next;
	MemThreadRelease(mh);
	mh = OptrToHandle(list);
    }

    return count;
}	/* End of HTLISTGETCOUNT.	*/




/***********************************************************************
 *		HTListRemoveItem
 ***********************************************************************
 * SYNOPSIS:	Remove an item from a list.
 * CALLED BY:	Client	
 * PASS:        list.
 *              index = index of element to remove.
 *		item = buffer for copying the element to return. Null
 *                     if you do not want a copy back.
 *		size = size of item. If the element gotten exceeds size of
 *                     item, then only the first "size" bytes of element
 *                     are copied.
 * RETURN:	Nothing
 * SIDE EFFECTS:Beware that the list length is reduced by 1. If you want to 
 *              remove all items for inspection, do:
 *
 *                count = HTListGetCount(list);
 *                for (i=0; i<count; i++) {
 *                  HTLISTREMOVEITEM(list, 0, item, size); ...index = 0...
 *                   ...do something with item...
 *                }
 *
 *              Index must be valid, otherwise FatalError.
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/29/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTREMOVEITEM (HTListHandle list, word index, void *item, word size)
{
    void *element;
    word elementSize;
    MemHandle mh = OptrToHandle(list);
    HTListHeader *header;

    while (list) {
	MemThreadGrab(mh);
EC(     ECCheckChunkArray(list);                                        )

        header = (HTListHeader *) LMemDeref(list);
	if (index < header->HTLH_carray.CAH_count) {
	    /* Found in this list */
	    element = ChunkArrayElementToPtr(list, index, &elementSize);

EC(         if (elementSize > size)                                     )
EC(             EC_WARNING(HTLIST_ELEMENT_SIZE_EXCEEDS_PASSED_IN_SIZE); )

            if (item) item = memcpy(item, element, size);
	    ChunkArrayDelete(list, element);
	    MemThreadRelease(mh);
	    break;
	} else {
	    list = header->HTLH_next;
	    index -= header->HTLH_carray.CAH_count;
	    MemThreadRelease(mh);
	    mh = OptrToHandle(list);
	}
    }

EC( if (!list)                                                          )
EC(     EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

}	/* End of HTLISTREMOVEITEM.	*/



/***********************************************************************
 *		HTLISTUSEDSPACEWID
 ***********************************************************************
 *
 * SYNOPSIS:	The amount of space used by an id. If id is 0, we get the
 *              memory used in non-id allocation.
 * CALLED BY:	Client
 * RETURN:	dword of total bytes.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
dword _far _pascal
HTLISTUSEDSPACEWID (word id)
{
    HTListHandle *lptr;
    HTListBlock *bptr;
    word count, i, size;
    MemHandle mh = OptrToHandle(@htlistMemoryBlocks);
    dword ret = 0;
	
#if ERROR_CHECK
    if (id >= HTMID_END)
	EC_ERROR(INVALID_ID_FOR_HTLIST);        
#endif

    MemPLock(mh);

    lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    if (!(*lptr)) {
	/* No blocks have been created */
	MemUnlockV(mh);
	return 0;
    }

    /*
     * Search the list of blocks to compute memory usage.
     */
    count = ChunkArrayGetCount(*lptr);
    for (i=0; i<count; i++) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(*lptr, i, &size);
	if (bptr->HTB_id == id) {
	    ret += MemGetInfo(bptr->HTB_mh, MGIT_SIZE);
	}
    }

    MemUnlockV(mh);

    return ret;
}	/* End of HTLISTUSEDSPACEWID.	*/
