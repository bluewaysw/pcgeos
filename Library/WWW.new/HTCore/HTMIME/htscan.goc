@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htscan.goh>
@include <WWW/HTCore/htutils.goh>
@include <Ansi/string.h>
@include <sem.h>

@include "htfatals.goh"

/*
 * Reserved words table.
 */
typedef struct {
    char* HTRW_name;                            /* the reserved word itself */
    HTScanToken HTRW_kind;                       /* the token it represents */
} HTReservedWord;


#define HTMIME_RESERVED_WORDS      17           /* Number of reserved words */
static HTReservedWord reservedWords[] = {
    /* 
     * **MUST** be organized in strcmp order.
     * These are case-insensitive. Don't forget to keep 
     * HTMIME_RESERVED_WORDS up-to-date.
     */
    {"BASIC",                             HTST_BASIC_SCHEME},
    {"CACHE-CONTROL",                     HTST_CACHE_CONTROL},
    {"CONTENT-ENCODING",                  HTST_CONTENT_ENCODING},
    {"CONTENT-LENGTH",                    HTST_CONTENT_LENGTH},
    {"CONTENT-RANGE",                     HTST_CONTENT_RANGE},
    {"CONTENT-TYPE",                      HTST_CONTENT_TYPE},
    {"DATE",                              HTST_DATE},
    {"DOMAIN",                            HTST_DOMAIN},
    {"EXPIRES",                           HTST_EXPIRES},
    {"LAST-MODIFIED",                     HTST_LAST_MODIFIED},
    {"LOCATION",                          HTST_LOCATION},
    {"PATH",                              HTST_PATH},
    {"PRAGMA",                            HTST_PRAGMA},
    {"SECURE",                            HTST_SECURE},
    {"SET-COOKIE",                        HTST_SET_COOKIE},
    {"WWW-AUTHENTICATE",                  HTST_WWW_AUTHENTICATE},
    {"X-IMAGE-SCALE",                     HTST_XIMAGE_SCALE},
    {0,0}
};


/***********************************************************************
		Private Functions
***********************************************************************/


/***********************************************************************
 *		IsDelimiter
 ***********************************************************************
 * SYNOPSIS:	Check to see if a char is a delimiter that separate 
 *              two reserved words.
 * CALLED BY:	HTScanGobbleSym
 * RETURN:	TRUE if yes, else FALSE.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Will be implemented as a macro for speed.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/ 2/96   	Initial Revision
 *
 ***********************************************************************/
static Boolean _pascal
IsDelimiter (char chr)
{
    if (ISWHITE(chr) || (chr == ':') || (chr == ';') || (chr == '"') || 
	(chr == '=') || (chr == ','))
	return TRUE;
    else 
	return FALSE;
}	/* End of IsDelimiter.	*/



/***********************************************************************
 *		HTScanSearchReservedWord
 ***********************************************************************
 * SYNOPSIS:	Search the reserved word table for a match. 
 * CALLED BY:   HTScanGobbleSym
 * RETURN:	HTScanToken. If not found in the table, return 
 *              HTST_UNKNOWN
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Uses a binary search.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/ 2/96   	Initial Revision
 *
 ***********************************************************************/
HTScanToken _pascal
HTScanSearchReservedWord (char *wordBuffer)
{
    int result, i, lower = 0;
    int upper = HTMIME_RESERVED_WORDS - 1;

    while (upper >= lower) {
	i = (lower + upper) / 2;

	/* Case insensitive compare */
	result = strcasecmp(wordBuffer, reservedWords[i].HTRW_name);

	if (result < 0)
	    upper = i - 1;

	else if (result > 0)
	    lower = i + 1;

	else
	    return reservedWords[i].HTRW_kind;
    }

    return HTST_UNKNOWN;
}	/* End of HTScanSearchReservedWord.	*/



/***********************************************************************
		Public Functions
***********************************************************************/



/***********************************************************************
 *		HTScanNew
 ***********************************************************************
 *
 * SYNOPSIS:	Create a new HTScanner.
 * CALLED BY:	MIME parser.
 * RETURN:	HTScannerHandle, NULL if cannot allocate.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/16/96   	Initial Revision
 *
 ***********************************************************************/
HTScannerHandle _far _pascal
HTScanNew (HTRequestHandle request)
{
    HTScannerHandle scanner;
    HTScanner *sptr;

EC( ECCheckRequest(request);                                            )

    /* Allocate and lock, thread safe */
    scanner = MemAlloc(sizeof(HTScanner), HF_SHARABLE | HF_SWAPABLE,
		       HAF_ZERO_INIT | HAF_LOCK);

    if (scanner) {
	sptr = (HTScanner *) MemDeref(scanner);

	sptr->HTS_request = request;
	sptr->HTS_state = HTSS_EOL_BEGIN;

	MemUnlock(scanner);
    }
    
    return scanner;
}	/* End of HTScanNew.	*/




/***********************************************************************
 *		HTScanPutBlock
 ***********************************************************************
 *
 * SYNOPSIS:	Put a chunk of data to scanner.
 * CALLED BY:	HTMimePutBlock
 * RETURN:	HT_OK (we could return HT_OUOT_OF_MEMORY if not enough
 *              buffer space, but that won't happen as we parse one
 *              line at a time and no unfolded one-line header is going
 *              to be longer than HTSCAN_BUFFER_SIZE).
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 7/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTScanPutBlock (HTScanner *sptr, const char *data, word len)
{
    if (HTSCAN_BUFFER_SIZE-sptr->HTS_length > len) {
	strncat(sptr->HTS_buffer, data, len);
	sptr->HTS_length += len;
	return HT_OK;
    }
#if ERROR_CHECK
    else 
	EC_ERROR(BUFFER_IS_NOT_BIG_ENOUGH);
#endif
    return HT_OUT_OF_MEMORY;
}	/* End of HTScanPutBlock.	*/





/***********************************************************************
 *		HTScanPutChar
 ***********************************************************************
 *
 * SYNOPSIS:	Put a character to scanner.
 * CALLED BY:	HTMimePutBlock
 * RETURN:	HT_OK or HT_OUT_OF_MEMORY.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 7/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTScanPutChar (HTScanner *sptr, char chr)
{
    if (sptr->HTS_length < HTSCAN_BUFFER_SIZE) {
	sptr->HTS_buffer[sptr->HTS_length++] = chr;
	sptr->HTS_buffer[sptr->HTS_length] = '\0';
	return HT_OK;
    }
#if ERROR_CHECK
    else 
	EC_ERROR(BUFFER_IS_NOT_BIG_ENOUGH);
#endif

    return HT_OUT_OF_MEMORY;
}	/* End of HTScanPutChar.	*/




/***********************************************************************
 *		HTScanGetChar
 ***********************************************************************
 *
 * SYNOPSIS:	Get a character.
 * CALLED BY:	HTScanGobbleSym
 * RETURN:	char, '\0' if no more data.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 8/96   	Initial Revision
 *
 ***********************************************************************/
char _far _pascal
HTScanGetChar (HTScanner *sptr)
{
    /* Check for ungotten chars first */
    if (sptr->HTS_numOfUngotten)
	return sptr->HTS_ungottenChar[--(sptr->HTS_numOfUngotten)];

    if (sptr->HTS_length) {
	sptr->HTS_length -= 1;
	return sptr->HTS_buffer[sptr->HTS_index++];
    }

    return '\0';
}	/* End of HTScanGetChar.	*/





/***********************************************************************
 *		HTScanGobbleSym
 ***********************************************************************
 *
 * SYNOPSIS:	Swallow a token.
 * CALLED BY:	HTParseHeader
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Build a reserved word and return its token value in
 *              sptr->HTS_thisSym.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/16/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTScanGobbleSym (HTScanner *sptr)
{
    word i;
    char chr;

    sptr->HTS_thisSym = HTST_UNKNOWN;   /* default */

    chr = HTScanGetChar(sptr);

    if (chr == '\0') {
	sptr->HTS_thisSym = HTST_XXX_EOL;
	return;   /* Done! */
    }

    while (1) {
	if (ISALPHA(chr)) {
	    /* 
	     * Build up a word.
	     */
	    sptr->HTS_thisWord[0] = '\0';
	    i = 0;
	    do {
		if (i < HTSCAN_MAX_WORD_LENGTH-1) {
		    sptr->HTS_thisWord[i++] = chr;
		    sptr->HTS_thisWord[i] = '\0'; 

		}

#if ERROR_CHECK
		else 
EC( EC_WARNING(SCANNED_IDENTIFIER_LONGER_THAN_MAX_RESERVED_WORD_LENGTH);   )
#endif

		chr = HTScanGetChar(sptr);
	    } while (chr != '\0' && !IsDelimiter(chr));

	    /*
	     * We have read one char ahead, need to rewind.
	     */
	    if (chr != '\0' && !ISWHITE(chr))
		HTScanUngetChar(sptr, chr);

	    /* 
	     * What token does the word represent?
	     */
	    sptr->HTS_thisSym = 
		HTScanSearchReservedWord(sptr->HTS_thisWord);
	    return;

	} else if (ISDIGIT(chr)) {
	    /* 
	     * Only recognizes positive integers. Build up a word of digits.
	     */
	    sptr->HTS_thisWord[0] = '\0';
	    i = 0;
	    do {
		if (i< HTSCAN_MAX_WORD_LENGTH-1) {
		    sptr->HTS_thisWord[i++] = chr;
		    sptr->HTS_thisWord[i] = '\0'; /* Null-terminated */

		} else {
EC( EC_WARNING(SCANNED_IDENTIFIER_LONGER_THAN_MAX_RESERVED_WORD_LENGTH);  )
		}

		chr = HTScanGetChar(sptr);
	    } while (chr != '\0' && ISDIGIT(chr));

	    /* 
	     * We have read one char ahead, need to rewind.
	     */
	    if (chr != '\0' && !ISWHITE(chr)) 
		HTScanUngetChar(sptr, chr);

	    UtilAsciiToHex32(sptr->HTS_thisWord, 
			     (sdword *)&(sptr->HTS_thisNum));
	    sptr->HTS_thisSym = HTST_NUMBER;
	    return;
	    
	} else if (chr == ':') {
	    sptr->HTS_thisSym = HTST_COLON;
	    return;

	} else if (chr == '=') {
	    sptr->HTS_thisSym = HTST_EQUAL;
	    return;
	    
	} else if (chr == '"') {
	    /* 
	     * Quoted string, so gobble till the closing quote.
	     */
	    sptr->HTS_thisWord[0] = '\0';
	    chr = HTScanGetChar(sptr);
	    i = 0;
	    do {
		if (i < HTSCAN_MAX_WORD_LENGTH-1) {
		    sptr->HTS_thisWord[i++] = chr;
		    sptr->HTS_thisWord[i] = '\0'; 

		}

#if ERROR_CHECK
		else 
EC( EC_WARNING(SCANNED_IDENTIFIER_LONGER_THAN_MAX_RESERVED_WORD_LENGTH);   )
#endif

		chr = HTScanGetChar(sptr);
	    } while (chr != '\0' && chr != '"');
	    
	    sptr->HTS_thisSym = HTST_QUOTED_STRING;
	    return;

	} else if (chr == ',') {
	    sptr->HTS_thisSym = HTST_COMMA;
	    return;

	} else {
	    /* 
	     * Ignore other char codes since we must be tolerant.
	     */
#if ERROR_CHECK
	    if (!ISWHITE(chr))
		EC_WARNING(SCANNER_IGNORE_A_CHARACTER);
#endif
	    chr = HTScanGetChar(sptr);
	    if (chr == '\0') return;
	}
    }
}	/* End of HTScanGobbleSym.	*/



