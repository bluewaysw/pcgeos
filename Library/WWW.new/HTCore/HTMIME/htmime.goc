/* --------------------------------------------------------------------------
 * 		PRIVATE DATA
 * --------------------------------------------------------------------------*/

#define PUTBLOCK(target, data, len)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, len)

/*
 * HTTP/1.1 assumes content-type as application/octet-stream if one is not
 * provided.
 */
#define DEFAULT_CONTENT_TYPE  HT_CONTENT_TYPE_APPLICATION_OCTET_STREAM


/* Delimiters for HTScanCookie and IsCookieDelimiter*/
typedef enum {
    CD_WHITE         = 0x1,   /* ISWHITE macro */
    CD_EQUAL         = 0x2,
    CD_SEMICOLON     = 0x4
} CookieDelimiter;


/***********************************************************************
		Private Functions
***********************************************************************/



/***********************************************************************
 *		HTParseAuthenticate
 ***********************************************************************
 *
 * SYNOPSIS:	Parse WWW-Authenticate header.
 * CALLED BY:	HTParseHeader
 * RETURN:	TRUE if successfully parsed, FALSE if bad authentication.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    auth-scheme 1*SP realm *( "," auth-param )
 *              realm = "realm" "=" realm-value
 *              realm-value = quoted-string
 * 
 *              e.g., basic realm="Public Access"
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/ 9/96   	Initial Revision
 *
 ***********************************************************************/
static Boolean _pascal
HTParseAuthenticate (HTScanner *sptr, HTRequest *req)
{
    HTMemHandle value = NULL;

    /* The next token must be a valid authentication scheme */

    HTScanGobbleSym(sptr);

    switch (sptr->HTS_thisSym) {

    case HTST_BASIC_SCHEME:
	req->HTR_aa.HTA_wwwScheme = HTAA_BASIC;
	break;

    default:
	/* Other schemes and invalid schemes */
EC(     EC_WARNING(NOT_IMPLEMENTED);                                      )
	return FALSE;
    }

    /* 
     * Scheme specific params. For Basic, there in only one 
     * realm value.
     */
    HTScanGobbleSym(sptr);

    /* Realm keyword for Basic */
    if (sptr->HTS_thisSym == HTST_UNKNOWN) {
	HTScanGobbleSym(sptr);
	if (sptr->HTS_thisSym != HTST_EQUAL) 
	    return FALSE;
	    
	/* Realm name */
	HTScanGobbleSym(sptr);
	if (sptr->HTS_thisSym == HTST_UNKNOWN ||
	    sptr->HTS_thisSym == HTST_QUOTED_STRING) {
	    /*
	     * It seems I don't need to save the realmname. 
	     * I can just use protection template. See htaabrow.goc
	     */
	    /* value = HTStrAllocCopy(sptr->HTS_thisWord); */
	    /* req->HTR_aa.HTA_realmname = value; */
	}

	return TRUE;
    }

    return FALSE;
}	/* End of HTParseAuthenticate.	*/


/***********************************************************************
 *		IsCookieDelimiter
 ***********************************************************************
 *
 * SYNOPSIS:	Check to see if a char is a cookie delimiter.
 * CALLED BY:	HTScanCookie
 * RETURN:	TRUE or FALSE.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/31/97   	Initial Revision
 *	
 ***********************************************************************/
static Boolean _pascal
IsCookieDelimiter (char c, CookieDelimiter delim)
{
    if ((delim & CD_WHITE) && ISWHITE(c)) {
	return TRUE;
    }
    if ((delim & CD_EQUAL) && (c == '=')) {
	return TRUE;
    }
    if ((delim & CD_SEMICOLON) && (c == ';')) {
	return TRUE;
    }
    if (!c) {
	return TRUE;
    }
    return FALSE;
}	/* End of IsCookieDelimiter.	*/




/***********************************************************************
 *		HTScanCookie
 ***********************************************************************
 *
 * SYNOPSIS:	Scan a cookie header field.
 * CALLED BY:	HTParseCookie
 * RETURN:	HTScanToken
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/31/97   	Initial Revision
 *	
 ***********************************************************************/
static HTScanToken _pascal
HTScanCookie (char **pp, char **thisWord, CookieDelimiter delim)
{
    char *p = *pp;
    HTScanToken thisSym = HTST_XXX_EOL;

    while (1) {
	if (*p && !ISWHITE(*p) && !IsCookieDelimiter(*p, delim)) {
	    /* 
	     * Build up a word.
	     */
	    *thisWord = p;
	    while (!IsCookieDelimiter(*p++, delim));
	    p--;  /* Read one char ahead */

	    if (*p) {
		/* More to scan in the next call */
		*p++ = 0;
	    }
	    thisSym = HTScanSearchReservedWord(*thisWord);
	    break;
	} else if (!*p) {
	    break;
	} else {
	    /* Ignore leading white spaces */
	    p++;
	}
    }
    *pp = p;
    return thisSym;
}	/* End of HTScanCookie.	*/



/***********************************************************************
 *		HTParseCookie
 ***********************************************************************
 *
 * SYNOPSIS:	Parse Set-Cookies headers.
 * CALLED BY:	HTParseHeader
 * RETURN:	Nothing
 *	
 * STRATEGY:	Parsed according to Netscape cookies specified in 
 *              http://home.netscape.com/newsref/std/cookie_spec.htm
 *
 *              We don't implement the standard RFC2109 (HTTP State 
 *              Management Scheme).
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/29/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
HTParseCookie (HTScanner *sptr, HTRequest *rptr)
{
    HTScanToken sym;
    char *p = sptr->HTS_buffer+sptr->HTS_index;
    char *name = 0, *value = 0, *expires = 0, *path = 0, *domain = 0;
    char *thisWord = 0;
    Boolean secure = FALSE;

    /* NAME = VALUE come first and are the ONLY required header */
    sym = HTScanCookie(&p, &thisWord, CD_EQUAL);
    if (sym == HTST_XXX_EOL) {
	return;
    }
    name = thisWord;

    sym = HTScanCookie(&p, &thisWord, CD_SEMICOLON);
    if (sym == HTST_XXX_EOL) {
	return;
    }
    value = thisWord;

    /* The rest of the headers are optional */
    do {
	sym = HTScanCookie(&p, &thisWord, CD_EQUAL);
	switch (sym) {
	case HTST_EXPIRES:
	    sym = HTScanCookie(&p, &thisWord, CD_SEMICOLON);
	    expires = thisWord;
	    break;
	case HTST_DOMAIN:
	    sym = HTScanCookie(&p, &thisWord, CD_SEMICOLON);
	    domain = thisWord;
	    break;
	case HTST_PATH:
	    sym = HTScanCookie(&p, &thisWord, CD_SEMICOLON);
	    path = thisWord;
	    break;
	case HTST_SECURE:
	    secure = TRUE;
	    break;
	default:
	    /* Be tolerant, ignore */
	    break;
	}
    } while (sym != HTST_XXX_EOL);

    HTAnchorSetCookie(rptr->HTR_anchor, name, value, expires, path, 
		      domain, secure);
}	/* End of HTParseCookie.	*/





/***********************************************************************
 *		HTParseHeader
 ***********************************************************************
 *
 * SYNOPSIS:	Parse MIME headers.
 * CALLED BY:	HTMimePutBlock
 * RETURN:	HT_NOT_CACHEABLE, HT_OK.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Store all headers about a data object in its anchor,
 *              or other header info holders:
 *                  - Access Authentication.
 *
 *              This is a tolerant MIME parser as the headers can be
 *              full of syntax errors and we synchronize at the end of
 *              line.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 7/96   	Initial Revision
 *
 ***********************************************************************/
static int _far _pascal
HTParseHeader (HTScanner *sptr)
{
    int ret = HT_OK;
    HTRequest *rptr;

    rptr = (HTRequest *) MemThreadGrab(sptr->HTS_request);

    sptr->HTS_index = 0;   /* index into buffer */
    
    HTScanGobbleSym(sptr);

    do {
	switch (sptr->HTS_thisSym) {

	case HTST_CACHE_CONTROL:
	    /* 
	     * HTTP/1.0 and below must not implement cache control and
	     * cache only implement Pragma: no-cache. Cache control is
	     * only for HTTP/1.1.
	     */
	    {
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		if (strcasestr(p, "no-cache")) {
		    /* Do not cache */
		    ret = HT_NOT_CACHEABLE;
		}
	    }
	    sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk the rest of line */
	    break;

	case HTST_CONTENT_ENCODING:
	    sptr->HTS_thisSym = HTST_XXX_EOL;     /* Junk line */
	    break;
	    
	case HTST_CONTENT_LENGTH:
	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_COLON)
		sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk line */
	    
	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_NUMBER)
		sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk line */
	    
	    HTAnchorSetContentLength(rptr->HTR_anchor,
				     sptr->HTS_thisNum);

	    sptr->HTS_thisSym = HTST_XXX_EOL;      /* Done! */
	    break;
	    
	case HTST_CONTENT_RANGE:
	    sptr->HTS_thisSym = HTST_XXX_EOL;     /* Junk line */
	    break;

	case HTST_CONTENT_TYPE:
	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_COLON)
		sptr->HTS_thisSym = HTST_XXX_EOL;   /* Junk line */

	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_UNKNOWN)  /* The content type */
		sptr->HTS_thisSym = HTST_XXX_EOL;

	    HTAnchorSetContentType(rptr->HTR_anchor,
				   HTStringFor(sptr->HTS_thisWord));

	    /* 
	     * For now, done with this line. We may want to 
	     * parse other content-type information later... 
	     */
	    sptr->HTS_thisSym = HTST_XXX_EOL;
	    break;

	case HTST_DATE:
	    /*
	     * The date of the data object.
	     */
	    {
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		HTAnchorSetDate(rptr->HTR_anchor, p);
	    }

	    sptr->HTS_thisSym = HTST_XXX_EOL;     /* Junk line */
	    break;

	case HTST_EXPIRES:
	    /* 
	     * The remaining data in sptr->HTS_HTS_buffer as the date
	     * and time.
	     */
	    {
		TimerDateAndTime dateTime;
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		if (HTParseTime(p, &dateTime)) {
		    /* Make sure time is valid */
		    HTAnchorSetExpires(rptr->HTR_anchor, p);
		}
	    }
			   
	    sptr->HTS_thisSym = HTST_XXX_EOL;     /* Junk line */
	    break;

	case HTST_LAST_MODIFIED:
	    /* 
	     * The remaining data in sptr->HTS_HTS_buffer as the date
	     * and time.
	     */
	    {
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		HTAnchorSetLastModified(rptr->HTR_anchor, p);
	    }
			   
	    sptr->HTS_thisSym = HTST_XXX_EOL;     /* Junk line */
	    break;

	case HTST_LOCATION:
	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_COLON)
		sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk line */

	    /*
	     * Change the request URL to this location to reservice the
	     * request again.
	     */
	    {
		char *p1, *p2, *relatedName;
		HTMemHandle newUrl;

		p2 = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p2)) p2++;

		p1 = (char *)MemLock(rptr->HTR_uriString);
		newUrl = HTParseURI(p2, p1, HTURI_PARSE_ALL);

		p2 = (char *) HTMemLock(newUrl);
		MemReAlloc(rptr->HTR_uriString, strlen(p2)+1,
			   HAF_ZERO_INIT);  /* Already locked */

		p1 = (char *) MemDeref(rptr->HTR_uriString);
		strcpy(p1, p2);
		MemUnlock(rptr->HTR_uriString);
		HTMemUnlockAndFree(newUrl);

		/* Indicate that we have been redirected */
		rptr->HTR_uriRedirected = TRUE;

		/* 
		 * If the original request method was POST, change it
		 * to GET as it is unsafe to post data again to a new
		 * URL. And should also remove POST headers in 
		 * rptr->HTR_extraHeaders, which is Content-Type.
		 */
		if (rptr->HTR_method == HTM_POST) {
		    rptr->HTR_method = HTM_GET;
		    if (rptr->HTR_data) {
			HTMemFree(rptr->HTR_data);
			rptr->HTR_data = 0;
		    }
		}
	    }
	    sptr->HTS_thisSym = HTST_XXX_EOL;
	    break;

	case HTST_PRAGMA:
	    {
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		if (strcasestr(p, "no-cache")) {
		    /* Do not cache */
		    ret = HT_NOT_CACHEABLE;
		}
	    }
	    sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk the rest of line */
	    break;

	case HTST_WWW_AUTHENTICATE:
	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_COLON) 
		sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk line */

	    /* 
	     * Save the WWW-Authenticate scheme and its parameters since
	     * client may reissue the request after it has been 
	     * challenged by the server (when client receives status
	     * HT_UNAUTHORIZED).
	     */
	    if (HTParseAuthenticate(sptr, rptr)) {
		/*
		 * If we are able to compose a valid authentication,
		 * we don't need to kill the request and return it to
		 * client. We can revive the request and reservice it.
		 * But where and how do I revive the request????
		 */
		/* @@@ */
	    }
	    
	    sptr->HTS_thisSym = HTST_XXX_EOL;  /* Done with line */
	    break;

	case HTST_SET_COOKIE:
	    HTScanGobbleSym(sptr);
	    if (sptr->HTS_thisSym != HTST_COLON)
		sptr->HTS_thisSym = HTST_XXX_EOL; /* Junk line */
	    /*
	     * Save set-cookies headers.
	     */
	    {
		HTParseCookie(sptr, rptr);
		sptr->HTS_thisSym = HTST_XXX_EOL;  /* Done with line */
	    }
	    break;

	case HTST_XIMAGE_SCALE:
	    /*
	     * The scale of a resized image by Ericsson's Argos server.
	     */
	    {
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		HTAnchorSetXImageScale(rptr->HTR_anchor, p);
	    }

	    sptr->HTS_thisSym = HTST_XXX_EOL;     /* Junk line */
	    break;
	    
	default: 
	    /* 
	     * Store extra headers we don't recognize in case
	     * client wants it.
	     */
	    {
		char *p = sptr->HTS_buffer+sptr->HTS_index;
		while (ISWHITE(*p)) p++;
		HTAnchorAddHeader(rptr->HTR_anchor, sptr->HTS_thisWord, p);
	    }

	    sptr->HTS_thisSym = HTST_XXX_EOL;  /* Junk line */
	    break;
	}
    } while (sptr->HTS_thisSym != HTST_XXX_EOL);

    /* Reset buffer length as we synch at newline */
    sptr->HTS_numOfUngotten = 0;
    sptr->HTS_length = 0;
    sptr->HTS_buffer[0] = '\0';

    MemThreadRelease(sptr->HTS_request);
    return ret;
}	/* End of HTParseHeader.	*/





/***********************************************************************
 *		HTMimePutBlock
 ***********************************************************************
 *
 * SYNOPSIS:	Header is terminated by CRCR, LFLF, CRLFLF, CRLFCR, 
 *              CRLFCRLF.
 *              Folding is either of CF LWS, LF LWS, CRLF LWS.
 * CALLED BY:	MSG_HT_STREAM_PUT_BLOCK.
 * RETURN:	int, from pushing data to target.
 *              leftover, number of bytes left after we have become
 *              transparent (i.e., finished parsing headers)
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:    Ported from W3C HTMIME.c HTMIME_put_block. Optimized by
 *              kkee. We parse at every newline to avoid running out
 *              of buffer space.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 7/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTMimePutBlock (HTScanner *sptr, const char *b, word l, int *leftover)
{
    const char * start = b;
    const char * end = start;
    *leftover = -1;

    while (!sptr->HTS_transparent && l-- > 0) {
	if (sptr->HTS_state == HTSS_EOL_FCR) {
	    if (*b == CR) {				    /* End of header */
		int status;
		HTScanPutBlock(sptr, start, end-start);
		status = HTParseHeader(sptr);
		sptr->HTS_transparent = TRUE;
		*leftover = l;
		return status;                               /* Done! */
	    } else if (*b == LF)			   	     /* CRLF */
		sptr->HTS_state = HTSS_EOL_FLF;
	    else if (ISWHITE(*b)) {			   /* Folding: CR SP */
		sptr->HTS_state = HTSS_EOL_BEGIN;
		HTScanPutBlock(sptr, start, end-start);
		HTScanPutChar(sptr, ' ');
		start=b, end=b+1;
	    } else {						 /* New line */
		sptr->HTS_state = HTSS_EOL_BEGIN;
		HTScanPutBlock(sptr, start, end-start);
		HTParseHeader(sptr);
		start=b, end=b+1;
	    }
	} else if (sptr->HTS_state == HTSS_EOL_FLF) {
	    if (*b == CR)				/* LF CR or CR LF CR */
		sptr->HTS_state = HTSS_EOL_SCR;
	    else if (*b == LF) {			    /* End of header */
		int status;
		HTScanPutBlock(sptr, start, end-start);
		status = HTParseHeader(sptr);
		sptr->HTS_transparent = TRUE;
		*leftover = l;
		return status;                               /* Done! */
	    } else if (ISWHITE(*b)) {	       /* Folding: LF SP or CR LF SP */
		sptr->HTS_state = HTSS_EOL_BEGIN;
		HTScanPutBlock(sptr, start, end-start);
		HTScanPutChar(sptr, ' ');
		start=b, end=b+1;
	    } else {						/* New line */
		sptr->HTS_state = HTSS_EOL_BEGIN;
		HTScanPutBlock(sptr, start, end-start);
		HTParseHeader(sptr);
		start=b, end=b+1;
	    }
	} else if (sptr->HTS_state == HTSS_EOL_SCR) {
	    if (*b==CR || *b==LF) {			    /* End of header */
		int status;
		HTScanPutBlock(sptr, start, end-start);
		status = HTParseHeader(sptr);
		sptr->HTS_transparent = TRUE;
		*leftover = l;
		return status;                               /* Done! */
	    } else if (ISWHITE(*b)) {	 /* Folding: LF CR SP or CR LF CR SP */
		sptr->HTS_state = HTSS_EOL_BEGIN;
		HTScanPutBlock(sptr, start, end-start);
		HTScanPutChar(sptr, ' ');
		start=b, end=b+1;
	    } else {						/* New line */
		/* We have CRLFCR follow by non-WHITE */
		int status;
		HTScanPutBlock(sptr, start, end-start);
		status = HTParseHeader(sptr);
		sptr->HTS_transparent = TRUE;
		*leftover = (l+1);
		return status;                               /* Done! */
	    }
	} else if (*b == CR) {
	    sptr->HTS_state = HTSS_EOL_FCR;
	} else if (*b == LF) {
	    sptr->HTS_state = HTSS_EOL_FLF;		       /* Line found */
	} else
	    end++;
	b++;
    }

    /* Don't forget whatever leftover data not yet parsed */
    if (end-start > 0) {
	HTScanPutBlock(sptr, start, end-start);
    }
    return HT_OK;
}	/* End of HTMimePutBlock.	*/


/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTMIMEClass;

/***********************************************************************
		Message Handlers for HTMIMEClass
***********************************************************************/

/***********************************************************************
 *		TeeResolver
 ***********************************************************************
 *
 * SYNOPSIS:	MIME Tee stream resolver for pushing data to MIME and
 *              HTCacheWriter. Target1 is contentType stream and Target2 
 *              is cache stream.
 * CALLED BY:	HTTeeClass
 * RETURN:	
 *	
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/11/97   	Initial Revision
 *	
 ***********************************************************************/
static int _far _pascal
TeeResolver (int clientRet, int cacheRet, int *myRet)
{
    if (cacheRet != HT_OK && clientRet == HT_OK) {
	/* Tell Tee stream to abort cache and return HT_OK */
	*myRet = HT_OK;
	return HT_TEE_ABORT_TARGET2;
    } else {
	*myRet = clientRet;
    }

    return HT_OK;
}	/* End of TeeResolver.	*/




/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTMIMEClass
 ***********************************************************************
 * SYNOPSIS:	    Parse MIME messages.
 * PARAMETERS:	    int (const byte *data, word len)
 *                  - return HT_OUT_OF_MEMORY if not enough memory.
 *                  - return HT_LOADED if bytesRead is >= content-length.
 *                  - return value from target stream. If all is ok,
 *                    its HT_OK.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        State-based implementation, which means we must 
 *                  remember where we are in the parsing process as
 *                  input data comes in discrete blocks. This FSM MIME
 *                  parser is tolerant as the data can be full of 
 *                  syntax errors. The parser ignores field names it
 *                  does not understand, and resynchronizes on line
 *                  beginnings.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMIMEClass, MSG_HT_STREAM_PUT_BLOCK
{
    HTRequest *rptr;
    int leftover;
    int ret = HT_OK;

    if (!data || !len) return HT_OK;

    /* 
     * Always the first thing to check.
     */
    if (@self->HTSI_transparent) {

	/*
	 * We must keep track of amount of data once we've become
	 * transparent for content-length.
	 */
	ret = PUTBLOCK(@self->HTSI_target, data, len);

	if (len > 0) {
	    dword contentLength;

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
	    contentLength = HTAnchorContentLength(rptr->HTR_anchor);
	    rptr->HTR_bytesRead += len;
	    if (contentLength && rptr->HTR_bytesRead >= contentLength)
		ret = HT_LOADED;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    MemThreadRelease(@self->HTSI_request);
	}

	return ret;
    }

    /* Not transparent, so must process data */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (!@self->HTMI_scanner) {
	/* 
	 * Create a scanner if we don't have one.
	 */
	@self->HTMI_scannerHandle = HTScanNew(@self->HTSI_request);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	if (@self->HTMI_scannerHandle)
	    /* 
	     * Unlock when we become transparent or when we abort.
	     */
	    @self->HTMI_scanner = (HTScanner *)
		MemLock(@self->HTMI_scannerHandle);
	else 
	    return HT_OUT_OF_MEMORY;

    }

    /* Continue parsing */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    ret = HTMimePutBlock(@self->HTMI_scanner, (char *)data, len, 
			 &leftover);

    if (ret == HT_NOT_CACHEABLE) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    /* 
     *  I comment out this code as we have to save a cache copy of the 
     *  file to fully implement save option. What should be done is that
     *  this copy should be SESSION not INTERSESSION cache file.
     *
     *  @call @self->HTSI_target::MSG_HT_STREAM_ABORT(HT_NOT_CACHEABLE);
     *  @self->HTSI_target = 0;
     */
        ret = HT_OK;
    }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (@self->HTMI_scanner->HTS_transparent) {
	HTStringHandle contentType;
	Boolean redirected;
	/* 
	 * Put the rest down the stream without touching the data but 
	 * make sure that we get the correct content length of data.
	 */
	ret = HTNetReportProgress(@self->HTSI_request, 
				  HT_HEADER_DONE);
	if (ret != HT_OK) return ret;

	rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
	/* Done parsing headers for this data object */
	HTAnchorSetHeaderDone(rptr->HTR_anchor);
	contentType = HTAnchorContentType(rptr->HTR_anchor);
	redirected = rptr->HTR_uriRedirected;
        MemThreadRelease(@self->HTSI_request);

	if (!redirected) {
	    /*
             *                   |-> HTCache
	     * HTMIME -> HTTee ->
             *                   |-> (from content-type)
	     */
	    HTStreamHandle s = NullOptr;
	    if (!contentType) {
		s = HTPolicyStreamStack(DEFAULT_CONTENT_TYPE,
					NULL,
					NullOptr,
					@self->HTSI_request,
					FALSE);
	    } else {
		s = HTPolicyStreamStack(contentType,
					NULL,
					NullOptr,
					@self->HTSI_request,
					FALSE);
	    }
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    if (s && @self->HTSI_target) {
		/* Make sure we pass vptr for resolverCbf */
		static HTTeeResolver resolverCbf = &TeeResolver;
		HTStreamHandle ss = HTTeeCreate(@self->HTSI_request,
						s, @self->HTSI_target,
						resolverCbf, 0);
@ifdef PRODUCT_RESPONDER
	        pself = ObjDeref(oself,0);
@endif
		@self->HTSI_target = ss;
	    } else {
		@self->HTSI_target = s;
	    }
	}
	    
	if (!@self->HTSI_target) return HT_NO_CONTENT;

	if (leftover) {
	    dword contentLength;

	    ret = PUTBLOCK(@self->HTSI_target, data+len-leftover, leftover);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
	    contentLength = HTAnchorContentLength(rptr->HTR_anchor);
	    rptr->HTR_bytesRead += leftover;
	    if (contentLength && rptr->HTR_bytesRead >= contentLength)
		ret = HT_LOADED;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    MemThreadRelease(@self->HTSI_request);
	}

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    @self->HTSI_transparent = TRUE;
    }

    return ret;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/




/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTMIMEClass
 ***********************************************************************
 * SYNOPSIS:	    Delete scanner and abort self.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Wait for parser thread to terminate, push leftover
 *                  data to target (if any) and then we can free the
 *                  scanner without losing data.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/21/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMIMEClass, MSG_HT_STREAM_ABORT
{
    if (@self->HTMI_scannerHandle)
	HTScanDelete(@self->HTMI_scannerHandle);

    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
 *		HTMIMECREATE
 ***********************************************************************
 *
 * SYNOPSIS:	Create a MIME parser. The passed in cache stream will 
 *              receive entity data (MIME data minus all the headers). In 
 *              addition, MIME will create a target based on the content
 *              type of the data.
 * CALLED BY:	Client
 * RETURN:	HTStreamHandle
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	11/17/97   	Initial Revision
 *	
 ***********************************************************************/
HTStreamHandle _far _pascal
HTMIMECREATE (HTRequestHandle request, HTStreamHandle cache)
{
    HTStreamHandle stream;

EC( ECCheckOD(cache);                                                   )
EC( ECCheckRequest(request);                                            )

    PUSHDS;
    SET_DS_LIB_DGROUP;
    stream = HTObjInstantiateForThread(0, &HTMIMEClass);
    POPDS;

    if (!stream) {
	/* Log error */
    } else {
	/* Initialize the stream instance data */
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);
	@call stream::MSG_HT_STREAM_SET_TARGET(cache);
    }
    
    return stream;
}	/* End of HTMIMECREATE.	*/




