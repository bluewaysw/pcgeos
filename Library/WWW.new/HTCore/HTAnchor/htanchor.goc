HTANCHORSETMEMCACHE (HTAnchorHandle parent, HTMemHandle memCache)
{
    HTParentAnchor *anchor;

    if (!parent) return;

EC( ECCheckHTAnchor(parent);                                           )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    anchor->HTPA_memCache = memCache;
    HTMemUnlock(parent);

