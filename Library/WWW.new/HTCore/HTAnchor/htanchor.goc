/***********************************************************************
 *		HTANCHORSETHEADERDONE
 ***********************************************************************
 *
 * SYNOPSIS:	Set done parsing header.
 * CALLED BY:	HTMIME
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/14/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORSETHEADERDONE (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;

    if (!parent) return;

EC( ECCheckHTAnchor(parent);                                           )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    anchor->HTPA_headerDone = TRUE;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORSETHEADERDONE.	*/



/***********************************************************************
 *		HTANCHORHEADERDONE
 ***********************************************************************
 *
 * SYNOPSIS:	Check done parsing header.
 * CALLED BY:   HTMIME
 * RETURN:	TRUE if header done, else FALSE.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/14/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean _far _pascal
HTANCHORHEADERDONE (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;
    Boolean ret;

    if (!parent) return FALSE;

EC( ECCheckHTAnchor(parent);                                           )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    ret = anchor->HTPA_headerDone;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
    return ret;
}	/* End of HTANCHORHEADERDONE.	*/
