#include <Ansi/stdlib.h>             /* atoi */
#include <sem.h>

extern SemaphoreHandle anchorSem;    /* In htanchor.goc */


/***********************************************************************
 *		HTANCHORCONTENTTYPE
 ***********************************************************************
 *
 * SYNOPSIS:	Get the media type (Content-Type). The passed in anchor
 *              must be a parent anchor (cannot be a child anchor).
 * CALLED BY:	Client.
 * RETURN:	HTStringHandle, in MIME content-type format or NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
HTStringHandle _far _pascal
HTANCHORCONTENTTYPE (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;
    HTStringHandle ret;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    ret = anchor->HTPA_content_type;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
    return ret;
}	/* End of HTANCHORCONTENTTYPE.	*/





/***********************************************************************
 *		HTANCHORSETCONTENTTYPE
 ***********************************************************************
 *
 * SYNOPSIS:	Set the content-type of an anchor object.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 4/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTANCHORSETCONTENTTYPE (HTAnchorHandle parent, HTStringHandle contentType)
{
    HTParentAnchor *anchor;


EC( ECCheckHTAnchor(parent);                                             )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    anchor->HTPA_content_type = contentType;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORSETCONTENTTYPE.	*/





/***********************************************************************
 *		HTANCHORCONTENTLENGTH
 ***********************************************************************
 *
 * SYNOPSIS:	Get the content-length of a parent anchor object.
 * CALLED BY:	Client.
 * RETURN:	dword, or 0 for no length.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 4/96   	Initial Revision
 *
 ***********************************************************************/
dword _far _pascal
HTANCHORCONTENTLENGTH (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;
    dword ret;

    if (!parent) return 0;

EC( ECCheckHTAnchor(parent);                                           )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    ret = anchor->HTPA_content_length;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
    return ret;
}	/* End of HTANCHORCONTENTLENGTH.	*/




/***********************************************************************
 *		HTANCHORSETCONTENTLENGTH
 ***********************************************************************
 *
 * SYNOPSIS:	Set the content-length of an anchor data object.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 5/96   	Initial Revision
 *
 ***********************************************************************/
