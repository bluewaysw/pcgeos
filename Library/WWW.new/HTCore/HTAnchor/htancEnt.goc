/***********************************************************************
 *		HTANCHORSETXIMAGESCALE
 ***********************************************************************
 *
 * SYNOPSIS:	Set the ximage scale of an anchor object.
 * CALLED BY:	HTTP
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/25/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORSETXIMAGESCALE (HTAnchorHandle parent, const char *str)
{
    HTParentAnchor *anchor;
    char *p;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    if (!str || !(*str)) return;
    anchor = (HTParentAnchor *) HTMemLock(parent);

    p = strchr(str, ':');
    if (p) {
	*p++ = '\0';
	anchor->HTPA_xImageXScale = atoi(str);
    }
    if (p && *p) {
	anchor->HTPA_xImageYScale = atoi(p);
    }

    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORSETXIMAGESCALE.	*/



/***********************************************************************
 *		HTANCHORXIMAGESCALE
 ***********************************************************************
 *
 * SYNOPSIS:	Get the ximage scale of an anchor object.
 * CALLED BY:	Client
 * RETURN:	HTMemHandle or NULL. The scale x/y is given as string 
 *              "x:y". For example, 1:4 means that the image has been
 *              scaled down 4 times.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/25/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORXIMAGESCALE (HTAnchorHandle parent, word *x, word *y)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    *x = anchor->HTPA_xImageXScale;
    *y = anchor->HTPA_xImageYScale;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORXIMAGESCALE.	*/



/***********************************************************************
 *		HTANCHORSETDOCUMENT
 ***********************************************************************
 *
 * SYNOPSIS:	Bind a document to a anchor. Depending the HTTP method of 
 *              request which this anchor is bound to, the document will
 *              interpreted accordingly. Document will be deleted after 
 *              it has been sent to the server.
 *              If POST:
 *                 . List items appear in pairs. First item is name and 
 *                   second is value.
 *                 . Hence, the number of items must be even.
 *              If any other method:
 *                 . I have not decided how to process them.
 *
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORSETDOCUMENT (HTAnchorHandle parent, HTDocument document)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )
EC( ECCheckHTList(document);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (anchor->HTPA_document) HTListDelete(anchor->HTPA_document);
    anchor->HTPA_document = document;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORSETDOCUMENT.	*/



/***********************************************************************
 *		HTANCHORADDHEADER
 ***********************************************************************
 *
 * SYNOPSIS:	Add extra header the anchor does not recognized. Headers 
 *              recognized by HTAnchor must be obtained via its API,
 *              such as HTAnchorDate, HTAnchorContentType, etc.
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/21/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORADDHEADER (HTAnchorHandle parent, const char *name, 
		   const char *value)
{
    HTParentAnchor *anchor;
    HTMemHandle ext;
    HTStringHandle str, str1;
    int count, i=0;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (!anchor->HTPA_extraHeaders) {
	anchor->HTPA_extraHeaders = HTListNewWID(HTMID_HTANCHOR);
    }

    str = HTStringForCase(name);   /* Case insensitive */

    /* Make sure str is not already in list */
    count = HTListGetCount(anchor->HTPA_extraHeaders);
    /* Must be even, see HTRequestAddHeader */
EC( if (count%2 != 0) EC_ERROR(1);                                  )

    while (count) {
	HTListGetItem(anchor->HTPA_extraHeaders, i, (void*)&str1,
		      sizeof(HTStringHandle));
	if (str == str1) {
	    /* Replace them */
	    HTListRemoveItem(anchor->HTPA_extraHeaders, i, NULL,
			     sizeof(HTStringHandle));
	    HTListRemoveItem(anchor->HTPA_extraHeaders, i, (void*)&ext,
			     sizeof(HTMemHandle));
	    HTMemFree(ext);
	    break;
	}
	i += 2;
	count -= 2;
    }
    
    HTListAppend(anchor->HTPA_extraHeaders, (void*)&str, 
		 sizeof(HTStringHandle));
    ext = HTStrAllocCopyWID(HTMID_HTANCHOR, value);
    HTListAppend(anchor->HTPA_extraHeaders, (void*)&ext, 
		 sizeof(HTMemHandle));
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORADDHEADER.	*/




/***********************************************************************
 *		HTANCHORGETHEADER
 ***********************************************************************
 *
 * SYNOPSIS:	Get a header the anchor does not recognized. Headers 
 *              recognized by HTAnchor must be obtained via its API,
 *              such as HTAnchorDate, HTAnchorContentType, etc.
 * CALLED BY:	Client
 * RETURN:	HTMemHandle, client must free.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/21/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTANCHORGETHEADER (HTAnchorHandle parent, const char *name)
{
    HTParentAnchor *anchor;
    HTMemHandle ret = 0;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (anchor->HTPA_extraHeaders) {
	HTStringHandle str, str1;
	int i, count = HTListGetCount(anchor->HTPA_extraHeaders);

	str = HTStringForCase(name);
	for (i=0; i<count; i++) {
	    if (i%2 == 0) {
		HTListGetItem(anchor->HTPA_extraHeaders, i, (void*)&str1,
			      sizeof(HTStringHandle));
		if (str == str1) {
		    /* Found! */
		    HTListGetItem(anchor->HTPA_extraHeaders, i+1,
				  (void*)&ret, sizeof(HTMemHandle));
		    ret = HTStrHTMemAllocCopyWID(HTMID_HTANCHOR, ret);
		    break;
		}
	    }
	}
    }
    HTMemUnlock(parent);
    ThreadVSem(anchorSem);
    POPDS;
    return ret;
}	/* End of HTANCHORGETHEADER.	*/
