HTANCHORSETCONTENTLENGTH (HTAnchorHandle parent, dword contentLength)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    anchor->HTPA_content_length = contentLength;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORSETCONTENTLENGTH.	*/



/***********************************************************************
 *		HTANCHORDATE
 ***********************************************************************
 *
 * SYNOPSIS:	Get the date of anchor object. This is the Date: of 
 *              HTTP/MIME header.
 * CALLED BY:	Client
 * RETURN:	HTMemHandle or NULL if no date.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/21/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTANCHORDATE (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;
    HTMemHandle ret = 0;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (anchor->HTPA_date)
	ret = HTStrHTMemAllocCopyWID(HTMID_HTANCHOR, anchor->HTPA_date);
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
    return ret;
}	/* End of HTANCHORDATE.	*/



/***********************************************************************
 *		HTANCHORSETDATE
 ***********************************************************************
 *
 * SYNOPSIS:	Set the HTTP/MIME date of an anchor object.
 * CALLED BY:	CLient
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/21/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORSETDATE  (HTAnchorHandle parent, const char *str)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (anchor->HTPA_date) 
	/* Resetting date? */
	HTMemFree(anchor->HTPA_date);
    if (strlen(str))
	anchor->HTPA_date = HTStrAllocCopyWID(HTMID_HTANCHOR, str);
    else
	anchor->HTPA_date = 0;
    HTMemUnlock(parent);

    ThreadVSem(anchorSem);
    POPDS;
}	/* End of HTANCHORSETDATE.	*/




