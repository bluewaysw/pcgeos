void _far _pascal
HTANCHORSETEXPIRES (HTAnchorHandle parent, const char *str)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ThreadPSem(anchorSem);

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (anchor->HTPA_expires) 
