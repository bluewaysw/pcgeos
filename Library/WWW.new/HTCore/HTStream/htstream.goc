 * PARAMETERS:	    byte (void) 
 *                  return TRUE if stream is transparent, else FALSE.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/ 9/96   	Initial Revision
 *
 ***********************************************************************/
