/***********************************************************************
 *		HTUTILCHANGECLASS
 ***********************************************************************
 * SYNOPSIS:	Change the class of an object in preparation for removing
 *              a reference to a geode that may cause the object's current
 *              class to go away.
 * CALLED BY:	Client.
 * PASS:        obj = object to change.
 *              class = ancester class to change to
 * RETURN:	Nothing
 * SIDE EFFECTS:object may shrink as data for the subclass are deleted.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/11/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTUTILCHANGECLASS (optr obj, ClassStruct _far *class)
{
    word masterOffset, newSize, oldSize;
    MetaBase *mptr;

EC( ObjLockObjBlock(OptrToHandle(obj));                                 )
EC( if (!ObjIsObjectInClass(obj, class))                                )
EC(    EC_ERROR(CANNOT_CHANGE_TO_NON_ANCESTOR_CLASS);                   )
EC( MemUnlock(OptrToHandle(obj));                                       )

    newSize = class->Class_instanceSize;
    masterOffset = class->Class_masterOffset;
    
    ObjLockObjBlock(OptrToHandle(obj));

    mptr = (MetaBase *) LMemDeref(obj);
    oldSize = mptr->MB_class->Class_instanceSize;

    if (masterOffset)
	ObjResizeMaster(obj, masterOffset, newSize);
    else 
	LMemDeleteAt(obj, newSize, oldSize-newSize);

    mptr = (MetaBase *) LMemDeref(obj);
    mptr->MB_class = class;

    MemUnlock(OptrToHandle(obj));
}	/* End of HTUTILCHANGECLASS.	*/


/* --------------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTUTILCHANGECLASSTOHTSTREAMCLASS
 ***********************************************************************
 *
 * SYNOPSIS:	Change the class of a stream object to HTStreamClass in 
 *              preparation for the geode of the original class reference
 *              to go away, which could leave us with no valid to execute.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTUTILCHANGECLASSTOHTSTREAMCLASS (optr obj)
{
    PUSHDS;
    SET_DS_LIB_DGROUP;
    HTUtilChangeClass(obj, &HTStreamClass);
    POPDS;
}	/* End of HTUTILCHANGECLASSTOHTSTREAMCLASS.	*/



