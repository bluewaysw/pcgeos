/***********************************************************************
		HTStreamClass
***********************************************************************/



/***********************************************************************
 *		MSG_HT_STREAM_SET_REQUEST for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Set request to be serviced by a stream.
 * PARAMETERS:	    void (HTRequestHandle request)
 * SIDE EFFECTS:    Nothing
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/15/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_REQUEST
{

EC( ECCheckRequest(request);                                            )

    @self->HTSI_request = request;
}	/* End of MSG_HT_STREAM_SET_REQUEST.	*/



/***********************************************************************
 *		MSG_HT_STREAM_GET_REQUEST for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Get the request being serviced by a stream.
 * PARAMETERS:      HTRequestHandle (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_GET_REQUEST
{
    return @self->HTSI_request;
}	/* End of MSG_HT_STREAM_GET_REQUEST.	*/




/***********************************************************************
 *		MSG_HT_STREAM_SET_TARGET for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Set the target for pushing data.
 * PARAMETERS:	    void (optr target)
 * SIDE EFFECTS:    None
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_TARGET
{

EC( ECCheckOD(target);                                                  )

    @self->HTSI_target = target;
}	/* End of MSG_HT_STREAM_SET_TARGET.	*/



/***********************************************************************
 *		MSG_HT_STREAM_GET_TARGET for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Get the target for pushing data.
 * PARAMETERS:	    optr (void)
 * SIDE EFFECTS:    None
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_GET_TARGET
{
    return (@self->HTSI_target);
}	/* End of MSG_HT_STREAM_GET_TARGET.	*/



