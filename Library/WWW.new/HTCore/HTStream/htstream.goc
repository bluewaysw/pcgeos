{
    return @self->HTSI_transparent;
}	/* End of MSG_HT_STREAM_IS_TRANSPARENT.	*/




/***********************************************************************
 *		MSG_HT_STREAM_SET_DYNAMICALLY_LOADED for HTStreamClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Indicate to the stream it has been loaded 
 *                  dyncamically.
 * PARAMETERS:	    void (Geodehandle libraryHandle)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_DYNAMICALLY_LOADED
{

EC ( ECCheckLibraryHandle(libraryHandle);                               )

    @self->HTSI_libraryHandle = libraryHandle;

}	/* End of MSG_HT_STREAM_SET_DYNAMICALLY_LOADED.	*/




/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Flush any buffered data down the target stream.
 *                  The default is to just return HT_OK by assuming that
 *                  the stream object is not buffering data.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_FLUSH
{
    if (@self->HTSI_target) 
	return @call @self->HTSI_target::MSG_HT_STREAM_FLUSH();

    return HT_OK;
}	/* End of MSG_HT_STREAM_FLUSH.	*/



/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Abort the current stream and the target stream 
 * 		    object.
 * PARAMETERS:	    int (int status)
 * SIDE EFFECTS:    Nothing.
 *
 * STRATEGY:	    Abort the target, and then free oself. For this to 
 *                  work, a stream object must not be the target of 
 *                  multiple stream objects. If it is, it must be able 
 *                  to handle multiple abort messages. Must use @call 
 *                  as we must abort the stream pipes before returning. 
 *                  The client depends on it as the request may be 
 *                  changed/deleted.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_ABORT
{

    int ret = HT_OK;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (@self->HTSI_target != NullOptr) {
	ret = @call @self->HTSI_target::MSG_HT_STREAM_ABORT(status);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	@self->HTSI_target = NullOptr;
    }

    /*
     * Now we are safe to unload the Library of this stream.
     */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (@self->HTSI_libraryHandle)
	@send,forceQueue oself::
	    MSG_HT_STREAM_UNLOAD_LIBRARY(@self->HTSI_libraryHandle);

    /*
     * Since the object class may go away before we get a chance
     * to execute the following forcequeued message, we need to 
     * change it's class pointer to its base class.
     */
    HTUtilChangeClass(oself, &HTStreamClass);

    /* Finally free the object */
    ObjIncInUseCount(OptrToHandle(oself));
    @send, forceQueue oself::MSG_META_FINAL_OBJ_FREE();
    return ret;
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
 *		MSG_HT_STREAM_UNLOAD_LIBRARY for HTStreamClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Unload the Library associated with this stream.
 * PARAMETERS:	    void (GeodeHandle libraryHandle) 
 *                      - must pass libraryHandle, can't use 
 *                         invalidated by MSG_HT_STREAM_ABORT when it
 *                         calls HTUtilChangeClass.
 * SIDE EFFECTS:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_UNLOAD_LIBRARY
{
    GeodeFreeLibrary(libraryHandle);
}	/* End of MSG_HT_STREAM_UNLOAD_LIBRARY.	*/



/***********************************************************************
		HTProtocolClass
***********************************************************************/

/* No default methods for HTProtocolClass */



/***********************************************************************
 *		HTSTREAMGROWINPUTSTREAMSTACK
 ***********************************************************************
 * SYNOPSIS:	Append a stream to the head of the input stream stack 
 *              of a request (an input stream stack is used to pump
 *              data from the client to the server). Head is the first
 *              stream object facing the client (or furthest away from
 *              the server).
 *              
 * CALLED BY:	Client.
 * RETURN:	HT_OK if added, else HT_NO.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:    Grow the input stream stack just like appending to 
 *              a single linked list; the head of the list is maintained
 *              by HTRequest.HTR_inputStream.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/17/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTSTREAMGROWINPUTSTREAMSTACK (HTRequestHandle request, 
			      HTStreamHandle stream)
{
    HTRequest *rptr;
    
EC( ECCheckRequest(request);                                            )
EC( ECCheckOD(stream);                                                  )

    rptr = (HTRequest *) MemThreadGrab(request);

    if (rptr->HTR_inputStream)
	@call stream::MSG_HT_STREAM_SET_TARGET(rptr->HTR_inputStream);
    rptr->HTR_inputStream = stream; /* Point to the head of the 
				       input stream */

    MemThreadRelease(request);

    return HT_OK;
}	/* End of HTSTREAMGROWINPUTSTREAMSTACK.	*/




/***********************************************************************
 *		ECCHECKSTREAM
 ***********************************************************************
 * SYNOPSIS:	Check for a valid stream object. Object needs not be 
 *              locked.
 * CALLED BY:	Client.
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/21/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
ECCHECKSTREAM (HTStreamHandle stream)
{
#if ERROR_CHECK
    MemHandle mh = OptrToHandle(stream);
    ObjLockObjBlock(mh);
    ECCheckObject(stream);  /* Does not lock the object. */
    MemUnlock(mh);
#endif
}	/* End of ECCHECKSTREAM.	*/

