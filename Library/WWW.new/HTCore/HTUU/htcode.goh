@ifndef __WWW_HTCODE_GOH__
@define __WWW_HTCODE_GOH__

@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htreq.goh>

@class HTBase64DecodeClass, HTStreamClass;

/*
 * We buffer data and decode in multiple of 4 bytes. For speed,
 * we buffer up to 76*6 bytes.
 */
@instance HTMemHandle HTBDI_buffer;
@instance byte *HTBDI_bufferPtr;
@instance int  HTBDI_length;

/*
 * Buffer for base64 decoding. If buffer data is 76*6, then 
 * decoded buffer is 57*6.
 */
@instance HTMemHandle HTBDI_bufPlain;
@instance byte *HTBDI_bufPlainPtr;

@endc

@class HTQPDecodeClass, HTStreamClass;

/*
 * Buffer for quoted-printable decoding. We buffer byte being 
 * decoded.
 */
@instance byte HTQPDI_buffer;

/*
 * Decoder parser state.
 */
@instance word HTQPDI_state;

@endc

@endif /* __WWW_HTCODE_GOH__ */
