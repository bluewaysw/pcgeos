@include <WWW/HTCore/htqp.goh>
@include <WWW/HTCore/htutils.goh>
#include <Ansi/string.h>
#include <Ansi/stdio.h>                /* sprintf */


static char qpEncodeTable[] = "0123456789ABCDEF";

#define QPDECODE_BEGIN  0
#define SAW_EQUAL       1
#define SAW_FIRST_HEX   2


/***********************************************************************
 *		HTQPENCODE
 ***********************************************************************
 *
 * SYNOPSIS:	Same as HTQPENCODEPTR, but take two HTMemHandles.
 * CALLED BY:	Client
 * RETURN:	Same as HTQPENCODEPTR.
