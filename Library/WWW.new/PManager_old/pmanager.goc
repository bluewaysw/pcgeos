/***********************************************************************
 *		MSG_PM_ENTER_CAPTION_MODE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Switch the PManager's receiving object.  Let 
 *                  caption be the receiving object temporarily.
 * PARAMETERS:	    (ClassStruct *table, char align, optr caption)
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_ENTER_CAPTION_MODE
{
  int count;
  /*
   *  Back up the current receiving object.  Later on we'll switch it back.
   */
  @self->PM_recvObjBackup = @self->PM_recvObj;
  /*
   *  Traverse up the ui tree and find the table object which the 
   *  caption should belong to.
   */
  while(1) {
    if (@call @self->PM_recvObj::MSG_META_IS_OBJECT_IN_CLASS(table)) {
      /*
       *  Add the caption object before or after the table object, 
       *  depending on the align attribute.
       */
      @call @self->PM_recvObj::MSG_GEN_TABLE_SET_CAPTION(caption);
      @self->PM_recvObj = @call @self->PM_recvObj::MSG_GEN_FIND_PARENT();
      count = @call @self->PM_recvObj::MSG_GEN_COUNT_CHILDREN();
      if (align == 0)
	@call @self->PM_recvObj::MSG_GEN_ADD_CHILD(caption, count-1);
      else
	@call @self->PM_recvObj::MSG_GEN_ADD_CHILD(caption, CCO_LAST);

      break;
    }
    else
      @self->PM_recvObj = @call @self->PM_recvObj::MSG_GEN_FIND_PARENT();

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    EC_ERROR_IF(@self->PM_recvObj == NULL, PM_ASSUMPTION_FAILS);
  }

  /*
   *  Now make the caption object be the receiving object.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->PM_recvObj = caption;
  return;
}	/* End of MSG_PM_ENTER_CAPTION_MODE.	*/


/***********************************************************************
 *		MSG_PM_EXIT_CAPTION_MODE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Switch back to whatever the receiving object was
 *                  before entering the caption mode.
 * PARAMETERS:	    void.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_EXIT_CAPTION_MODE
{
  @self->PM_recvObj = @self->PM_recvObjBackup;
  @self->PM_recvObjBackup = NULL;

  return;
}	/* End of MSG_PM_EXIT_CAPTION_MODE.	*/


/***********************************************************************
 *		DoesItHaveLinkInVisibleRegion
 ***********************************************************************
 *
 * SYNOPSIS:	Check to see if the object has a hyperlink in the given
 *              region or not.
 * CALLED BY:	
 * RETURN:	Boolean, TRUE or FALSE.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean
DoesItHaveLinkInVisibleRegion (optr object, RectDWord rect, int direction)
{
  ClassStruct *currClass = @call object::MSG_META_GET_CLASS();

  if (currClass == htmlClass.HC_text)
      return @call object::MSG_GEN_TEXT_FIND_LINK_IN_RECT(rect, direction);
  else if (currClass == htmlClass.HC_image)
      return @call object::MSG_GEN_IMAGE_FIND_LINK_IN_RECT(rect);
  return FALSE;
}	/* End of DoesItHaveLinkInVisibleRegion.	*/


/***********************************************************************
 *		IsThereLinkInOtherHorizColumn
 ***********************************************************************
 *
 * SYNOPSIS:	Given a visible rect region and search direction, find
 *              if there is any further object that is in the visible
 *              region as well.  Search starts from the given object.
 * CALLED BY:	
 * RETURN:	The returned boolean tells the caller that it returns
 *              an object in *parent that in the visible region.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/23/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean
IsThereLinkInOtherHorizColumn
(optr *parent, optr pmanager, int direction, RectDWord rect)
{
  int cnt, limit, cont = TRUE;
  optr grandMa, tmp = *parent;
  Rectangle retval;

  while(1) {
    if (tmp == pmanager) {
	*parent = NULL;
	break;
    }
    grandMa = @call tmp::MSG_GEN_FIND_PARENT();
    limit = @call grandMa::MSG_GEN_COUNT_CHILDREN();
    cnt = @call grandMa::MSG_GEN_FIND_CHILD(tmp);
    /*
     *  This inner loop checks the children in the grandma
     */
    while(1) {
	if (direction == SEARCH_FORWARD) {
	    if (cnt+1 == limit)
		break;  /* no more siblings in this level, break */
	    tmp = @call grandMa::MSG_GEN_FIND_CHILD_AT_POSITION(++cnt);
	    if (!@call tmp::MSG_GEN_GET_USABLE()) {
		EC_WARNING(PM_ENCOUNTER_OBJECT_NOT_USABLE_YET);
		continue;
	    }
	    @call tmp::MSG_VIS_GET_BOUNDS(&retval);
	    if (retval.R_bottom > rect.RD_top &&
		retval.R_top < rect.RD_bottom) {
		/*
		 *  It has a portion within the visible region.
		 */
		tmp = GetLeftMostLeaf(tmp);
		if (DoesItHaveLinkInVisibleRegion(tmp, rect, direction)
		    == TRUE) {
		    *parent = tmp;  /* found */
		    cont = FALSE;
		    break;
		}
		else {
		    grandMa = @call tmp::MSG_GEN_FIND_PARENT();
		    limit = @call grandMa::MSG_GEN_COUNT_CHILDREN();
		    cnt = @call grandMa::MSG_GEN_FIND_CHILD(tmp);
		}
	    }
	}
	else {
	    if (cnt-1 < 0)
		break;  /* no more siblings in this level, break */
	    tmp = @call grandMa::MSG_GEN_FIND_CHILD_AT_POSITION(--cnt);
	    @call tmp::MSG_VIS_GET_BOUNDS(&retval);
	    if (retval.R_top < rect.RD_bottom &&
		retval.R_bottom > rect.RD_top) {
		/*
		 *  It has a portion within the visible region.
		 */
		tmp = GetRightMostLeaf(tmp);
		if (DoesItHaveLinkInVisibleRegion(tmp, rect, direction)
		    == TRUE) {
		    *parent = tmp;  /* found */
		    cont = FALSE;
		    break;
		}
		else {
		    grandMa = @call tmp::MSG_GEN_FIND_PARENT();
		    limit = @call grandMa::MSG_GEN_COUNT_CHILDREN();
		    cnt = @call grandMa::MSG_GEN_FIND_CHILD(tmp);
		}
	    }
	}
    }
    if (cont == FALSE)
	break;
    tmp = grandMa;  /* go up one level */
  }

  return cont;
}	/* End of IsThereLinkInOtherHorizColumn.	*/


/***********************************************************************
 *		FindAndDrawFocalBound
 ***********************************************************************
 *
 * SYNOPSIS:	Given an object, find its hyperlink in the given rect
 *              region.  Return the drawing rectangle(A,B,C,D) of the 
 *              hyperlink.  It it's a text object that has link crossing
 *              mulitple lines, the *box contains the rectangle (a,b,c,d)
 *              of the inner box:
 *                                      (A,B)
 *                                        +---------+
 *                          (a,b)         |         |
 *                            +-----------+         |
 *                            |                     |
 *                            |                     |
 *                            |        +------------+ (c, d)
 *                            |        |         
 *                            +--------+
 *                                   (C, D)
 * 
 * CALLED BY:	direction - SEARCH_FORWARD or SEARCH_BACKWARD
 *              object - the current object in which we want to find the
 *                       next/previous focusable link.
 *              objRect - object's vis bound.
 *              rect - View's visible bound.
 *              box - passed buffer for returning bounds ((a,b) (c,d))
 *                    that covers the link crossing multiple lines.
 *              gstate - for drawing the dotted outline
 *
 * RETURN:	Return the actual drawing region around the link.
 *	        * The passed objRect may be updated! *
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/18/97   	Initial Revision
 *	
 ***********************************************************************/
RectDWord
FindAndDrawFocalBound (int direction, optr object, Rectangle *objRect, 
		       RectDWord *rect, Rectangle *box)
{
  RectDWord ret;
  EventHandle msg;
  ClassStruct *currClass = @call object::MSG_META_GET_CLASS();

  ret.RD_right = ret.RD_left = 0;
  box->R_right = box->R_left = box->R_top = box->R_bottom = 0;

  if (currClass == htmlClass.HC_text)
      @call object::MSG_GEN_TEXT_DRAW_FOCUS(direction, objRect, 
					    rect, &ret, box);
  else if (objRect->R_top >= rect->RD_top && 
	   objRect->R_left >= rect->RD_left &&
	   objRect->R_right <= rect->RD_right &&
	   objRect->R_bottom <= rect->RD_bottom) {
      /*
       *  Image object.
       */
      if (currClass == htmlClass.HC_image) {
	  @call object::MSG_GEN_IMAGE_DRAW_FOCUS(objRect, &ret);
      }
      /*
       *  form items.
       */
      else if (currClass == htmlClass.HC_formText) {
	  ret.RD_left  = objRect->R_left - 2;
	  ret.RD_right = objRect->R_right + 1;
	  ret.RD_top   = objRect->R_top - 2;
	  ret.RD_bottom= objRect->R_bottom + 2;
	  @call object::MSG_GEN_FORM_TEXT_SET_FOCUS(&ret);
      }
      else if (currClass == htmlClass.HC_input) {
	  ret.RD_left  = objRect->R_left - 1;
	  ret.RD_right = objRect->R_right + 1;
	  ret.RD_top   = objRect->R_top - 1;
	  ret.RD_bottom= objRect->R_bottom;
	  @call object::MSG_GEN_INPUT_DRAW_FOCUS(&ret);
      }
      else if (currClass == htmlClass.HC_trigger) {
	  ret.RD_left  = objRect->R_left;
	  ret.RD_right = objRect->R_right - 1;
	  ret.RD_top   = objRect->R_top;
	  ret.RD_bottom= objRect->R_bottom - 1;
      }
      else if (currClass == htmlClass.HC_textarea) {
	  ret.RD_left  = objRect->R_left - 2;
	  ret.RD_right = objRect->R_right + 1;
	  ret.RD_top   = objRect->R_top - 2;
	  ret.RD_bottom= objRect->R_bottom + 2;
	  @call object::MSG_TEXT_AREA_SET_FOCUS(&ret);
      }
      else if (currClass == htmlClass.HC_multiline) {
	  ret.RD_left  = objRect->R_left - 2;
	  ret.RD_right = objRect->R_right + 1;
	  ret.RD_top   = objRect->R_top - 2;
	  ret.RD_bottom= objRect->R_bottom + 2;
	  @call object::MSG_HTGMLS_SET_FOCUS(&ret);
      }
      else {
	/*
	 *  HTGenOuterSelectClass
	 */
	  ret.RD_left  = objRect->R_left;
	  ret.RD_right = objRect->R_right + 2;
	  ret.RD_top   = objRect->R_top;
	  ret.RD_bottom= objRect->R_bottom - 1;
      }
      /*
       *  Don't show target HREF for form objects.  Clear the title bar.
       */
      if (currClass != htmlClass.HC_image && currClass != htmlClass.HC_text) {
	  msg = @record PresentationManagerClass::MSG_PM_DISPLAY_HREF_TARGET
	      (-1, NULL);
	  @send object::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
      }
  }

  return ret;
}	/* End of FindAndDrawFocalBound.	*/

/***********************************************************************
 *		UndrawFocalBound
 ***********************************************************************
 *
 * SYNOPSIS:	Erase the outline drawing of the current hyperlink of 
 *              the given object.
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/19/97   	Initial Revision
 *	
 ***********************************************************************/
void
UndrawFocalBound(optr object, optr newLink)
{
  ClassStruct *currClass = @call object::MSG_META_GET_CLASS();

  if (currClass == htmlClass.HC_text)
      @call object::MSG_GEN_TEXT_UNDRAW_FOCUS(newLink);
  else if (currClass == htmlClass.HC_image)
      @call object::MSG_GEN_IMAGE_UNDRAW_FOCUS();
  else if (currClass == htmlClass.HC_formText)
      @call object::MSG_GEN_FORM_TEXT_CLEAR_FOCUS();
  else if (currClass == htmlClass.HC_input)
      @call object::MSG_GEN_INPUT_UNDRAW_FOCUS();
  else if (currClass == htmlClass.HC_textarea)
      @send object::MSG_TEXT_AREA_CLEAR_FOCUS();
  else if (currClass == htmlClass.HC_multiline)
      @send object::MSG_HTGMLS_CLEAR_FOCUS();

  return;
}	/* End of UndrawFocalBound.	*/

/***********************************************************************
 *		DrawMultiLineBox
 ***********************************************************************
 *
 * SYNOPSIS:	Draw navigation focus across multiple text lines.
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
void
DrawMultiLineBox (GStateHandle gstate, 
		  RectDWord *drawBound, Rectangle *drawbox)
{
    GrDrawLine(gstate, drawBound->RD_left, drawBound->RD_top, 
	       drawbox->R_right, drawBound->RD_top);
    GrDrawLine(gstate, drawbox->R_right, drawBound->RD_top,
	       drawbox->R_right, drawbox->R_bottom);
    GrDrawLine(gstate, drawbox->R_right, drawbox->R_bottom,
	       drawBound->RD_right, drawbox->R_bottom);
    GrDrawLine(gstate, drawBound->RD_right, drawbox->R_bottom,
	       drawBound->RD_right, drawBound->RD_bottom);
    GrDrawLine(gstate, drawBound->RD_right, drawBound->RD_bottom,
	       drawbox->R_left, drawBound->RD_bottom);
    GrDrawLine(gstate, drawbox->R_left, drawBound->RD_bottom,
	       drawbox->R_left, drawbox->R_top);
    GrDrawLine(gstate, drawbox->R_left, drawbox->R_top,
	       drawBound->RD_left, drawbox->R_top);
    GrDrawLine(gstate, drawBound->RD_left, drawbox->R_top,
	       drawBound->RD_left, drawBound->RD_top);

}	/* End of DrawMultiLineBox.	*/


/***********************************************************************
 *		MSG_PM_GRAB_NEW_FOCUS for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Let an object grab the navigation focus.
 * PARAMETERS:	    	(optr focus, Rectangle bound, Rectangle box)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_GRAB_NEW_FOCUS
{
  WindowHandle win;
  GStateHandle gstate;
  int index, limit;
  optr object;
    
  if (focus != @self->PM_focalObj) {

      if((limit = HTListGetCount(@self->PM_anchorList))==0)
	  return;

      for (index = 0; index < limit; index++) {
	  HTListGetItem(@self->PM_anchorList, index, &object, sizeof(optr));
	  if (object == focus) {
	      @self->PM_focalObjIndex = index;
	      break;
	  }
      }
      if (index == limit) {
	  EC_WARNING(1);
	  /* the focus object is not in the anchorList */
	  return;
      }

      win = @call focus::MSG_VIS_QUERY_WINDOW();
      gstate = GrCreateState(win);
      GrSetLineMaskCustom(gstate, (const unsigned char (*)[8])customMask);
      GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
      if (@self->PM_focalObj) {
	/*
	 *  Erase the old navigation focus.
	 */
	  GrSetMixMode(gstate, MM_COPY);
	  UndrawFocalBound(@self->PM_focalObj, focus);
	  if (@self->PM_drawbox.R_right != @self->PM_drawbox.R_left)
	    DrawMultiLineBox(gstate,&@self->PM_drawBound, &@self->PM_drawbox);
	  else
	    GrDrawRect(gstate, @self->PM_drawBound.RD_left, 
		       @self->PM_drawBound.RD_top, 
		       @self->PM_drawBound.RD_right, 
		       @self->PM_drawBound.RD_bottom);
      }
      @self->PM_focalObj = focus;
      @self->PM_drawBound.RD_right = bound.R_right;
      @self->PM_drawBound.RD_left = bound.R_left;
      @self->PM_drawBound.RD_top = bound.R_top;
      @self->PM_drawBound.RD_bottom= bound.R_bottom;
      @self->PM_drawbox = box;
      /*
       *  Draw new navigation focus.
       */
      GrSetMixMode(gstate, MM_XOR);
      if (@self->PM_drawbox.R_right != @self->PM_drawbox.R_left)
	  DrawMultiLineBox(gstate,&@self->PM_drawBound, &@self->PM_drawbox);
      else
	  GrDrawRect(gstate, @self->PM_drawBound.RD_left, 
		     @self->PM_drawBound.RD_top, 
		     @self->PM_drawBound.RD_right, 
		     @self->PM_drawBound.RD_bottom);
      GrDestroyState(gstate);
      @send focus::MSG_META_GRAB_FOCUS_EXCL();
  }

  return;
}	/* End of MSG_PM_GRAB_NEW_FOCUS.	*/


/***********************************************************************
 *		MSG_PM_UPDATE_FOCUS for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Update the new focus.  It happens when the default
 *                  image icons has the navigation focus and the icon
 *                  expands to full image.
 * PARAMETERS:	    (RectDWord bound)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	7/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_UPDATE_FOCUS
{
    WindowHandle win;
    GStateHandle gstate;
    win = @call self::MSG_VIS_QUERY_WINDOW();
    gstate = GrCreateState(win);
    GrSetLineMaskCustom(gstate, (const unsigned char (*)[8])customMask);
    GrSetMixMode(gstate, MM_COPY);

    if (@self->PM_drawBound.RD_left != @self->PM_drawBound.RD_right) {
      GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
      GrDrawRect(gstate, @self->PM_drawBound.RD_left, 
		 @self->PM_drawBound.RD_top, 
		 @self->PM_drawBound.RD_right, 
		 @self->PM_drawBound.RD_bottom);

    }
    @self->PM_drawBound = bound;
    GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
    GrDrawRect(gstate, bound.RD_left, bound.RD_top, bound.RD_right, 
	       bound.RD_bottom);
    GrDestroyState(gstate);
    return;
}	/* End of MSG_PM_CLEAR_FOCUS.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/20/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* The rest of the memory, htlist, objects are allocated using WID APIs */
    if (@self->PM_linkUnderMouse) {
	MemFree(@self->PM_linkUnderMouse);
    }
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



@if 0  /* In the first Penelope release, we don't support Search */

/***********************************************************************
 *		SearchInText
 ***********************************************************************
 *
 * SYNOPSIS:	Search the key word in the passed text object.
 * CALLED BY:	(optr text, optr pmanager, MemHandle searchInfo)
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/16/96   	Initial Revision
 *
 ***********************************************************************/
optr
SearchInText (optr text, optr genContent, MemHandle searchInfo)
{
  VisTextRange range;
  VisTextConvertOffsetParams params;
  static optr previousObj;
  int direction;
  SearchReplaceStruct *srs;

  /*
   *  Find the current search direction.
   */
  srs = (SearchReplaceStruct *)MemLock(searchInfo);
  if (srs->params & SO_BACKWARD_SEARCH)
    direction = SEARCH_BACKWARD;
  else
    direction = SEARCH_FORWARD;
  MemUnlock(searchInfo);
  /*
   *  Search the word in the cuurent text object.
   */
  searchFound = TRUE;
  @call text::MSG_SEARCH(searchInfo);
  @call text::MSG_VIS_TEXT_GET_SELECTION_RANGE(&range);
  /*
   *  If not found, tell the caller to continue the search for the 
   *  next text object.  If found, scroll the view to see the word.
   */
  if (text == previousObj && direction == SEARCH_FORWARD 
      && searchRange.VTR_start >= range.VTR_start
      && searchRange.VTR_end >= range.VTR_end)
    return CONTINUE;
  else if (text == previousObj && direction == SEARCH_BACKWARD 
      && searchRange.VTR_start <= range.VTR_start
      && searchRange.VTR_end <= range.VTR_end)
    return CONTINUE;
  if (searchFound == TRUE && range.VTR_start != range.VTR_end) {
    params.VTCOP_offset = range.VTR_start;
    @call text::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE(&params);
    @call genContent::MSG_HTML_CONTENT_VIEW_OBJECT
       (params.VTCOP_xPos, params.VTCOP_yPos);
    searchRange.VTR_start = range.VTR_start;
    searchRange.VTR_end   = range.VTR_end;
    previousObj = text;
    return STOP;
  }
  return CONTINUE;
}	/* End of SearchInText.	*/
@endif


/***********************************************************************
 *		GetNextSiblingOrParentsSibling
 ***********************************************************************
 *
 * SYNOPSIS:	Given the current object, find the next sibling object
 *              in the ui tree.
 * CALLED BY:	
 * RETURN:	optr - next sibling text object.  NULL if no more.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *              At any time, searchObj must be a leaf.  It can not be 
 *              a node in the middle of tree!
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/16/96   	Initial Revision
 *
 ***********************************************************************/
optr
GetNextSiblingOrParentsSibling (optr currentObj, int direction, int how)
{
  optr parent;
  int index;
  ClassStruct *currClass;
  /*
   *  Get the child index of the current searchObj.
   */
  parent = @call currentObj::MSG_GEN_FIND_PARENT();
  index  = @call parent::MSG_GEN_FIND_CHILD(currentObj);
  /*
   *  Find the leaf of the next subtree.
   */
  while (1) {
    if (direction == SEARCH_FORWARD)
      currentObj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(++index);
    else
      currentObj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(--index);

    if (!currentObj) {
      /*
       *  No more siblings.  Thus go one level up the tree.
       */
      currentObj = parent;
      if (@call currentObj::MSG_META_IS_OBJECT_IN_CLASS
      (&PresentationManagerClass)) {
	return NULL;
      }
      parent = @call currentObj::MSG_GEN_FIND_PARENT();
      index  = @call parent::MSG_GEN_FIND_CHILD(currentObj);
    }
    else if (!@call currentObj::MSG_GEN_GET_USABLE()) {
      /*
       *  If the parent is not showing up on the screen yet, forget about
       *  scanning through its children.
       */
      EC_WARNING(PM_ENCOUNTER_OBJECT_NOT_USABLE_YET);
      continue;
    }
    else {
      /*
       *  Got the next subtree.
       */
      if (direction == SEARCH_FORWARD) {
	/*
	 *  Find the left-most leaf.
	 */
	currentObj = GetLeftMostLeaf(currentObj);
      }
      else {
	/*
	 *  Find the right-most leaf
	 */
	currentObj = GetRightMostLeaf(currentObj);
      }
      /*
       *  If searchObj is a text object.  Return it to caller.
       *  If searchObj is a graphic object and graphic is also what the
       *  caller is interested in, return to caller.
       */
      currClass = @call currentObj::MSG_META_GET_CLASS();
      if (currClass == htmlClass.HC_text) {
	if (direction == SEARCH_FORWARD)
	  @call currentObj::MSG_VIS_TEXT_SELECT_START();
	else
	  @call currentObj::MSG_VIS_TEXT_SELECT_END();
	break;
      }
      else if (how == TEXT_AND_IMAGE &&	
	       (currClass == htmlClass.HC_image || 
		currClass == htmlClass.HC_formText ||
		currClass == htmlClass.HC_trigger))
	break;
      else if (how == TEXT_AND_IMAGE && 
	       (currClass == htmlClass.HC_option || 
		currClass == htmlClass.HC_otherOption || 
		currClass == htmlClass.HC_textareaText ||
		currClass == (ClassStruct *)&GenItemClass)) {
	currentObj = @call currentObj::MSG_GEN_FIND_PARENT();
	EC_WARNING_IF(!@call currentObj::
		      MSG_META_IS_OBJECT_IN_CLASS(&GenItemGroupClass) &&
		      !@call currentObj::
		      MSG_META_IS_OBJECT_IN_CLASS(&GenInteractionClass), 
		      PM_ASSUMPTION_FAILS);
	if (@call currentObj::MSG_META_IS_OBJECT_IN_CLASS(htmlClass.HC_select))
	      /* GenSelectOuterClass */
	      currentObj = @call currentObj::MSG_GEN_FIND_PARENT();
	  break;
      }
      else {
	/*
	 *  Loop to find the next sibling of currentObj.
	 */
	parent = @call currentObj::MSG_GEN_FIND_PARENT();
	index  = @call parent::MSG_GEN_FIND_CHILD(currentObj);
      }
    }
  }
  return currentObj;
}	/* End of GetNextSiblingOrParentsSibling.	*/


@if 0  /* in the first Penelope release, we don't support search */

/***********************************************************************
 *		DepthFirstSearch
 ***********************************************************************
 *
 * SYNOPSIS:    Do a depth first search.
 * CALLED BY:	
 * RETURN:	optr - the optr of the leaf chlid, NULL if no more.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/16/96   	Initial Revision
 *
 ***********************************************************************/
optr
DepthFirstSearch (optr leaf, optr genContent, MemHandle searchInfo)
{
  MemHandle dup;
  optr temp;
  SearchReplaceStruct *src;
  int direction;

  src = (SearchReplaceStruct *)MemLock(searchInfo);
  if (src->params & SO_BACKWARD_SEARCH)
    direction = SEARCH_BACKWARD;
  else
    direction = SEARCH_FORWARD;
  MemUnlock(searchInfo);

  while (1) {  /* loops as long as there is an object for searching */
    if (@call leaf::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass)) {
      dup = DuplicateSearchInfo(searchInfo);
      if (SearchInText(leaf, genContent, searchInfo) == STOP) {
	MemFree(dup);
	return leaf;  /* found it, return the object */
      }
      searchInfo = dup;
    }
    temp = GetNextSiblingOrParentsSibling(leaf, direction, TEXT_ONLY);
    if (!temp)
      break;  /* no more text object for searching. */
    leaf = temp;
  }
  MemFree(searchInfo);
  return NULL;
}	/* End of DepthFirstSearch.	*/


/***********************************************************************
 *		DuplicateSearchInfo
 ***********************************************************************
 *
 * SYNOPSIS:	Duplicate the searchInfo.
 * CALLED BY:	
 * RETURN:	MemHandle of the duplicate.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/17/96   	Initial Revision
 *
 ***********************************************************************/
MemHandle 
DuplicateSearchInfo (MemHandle searchInfo)
{
  SearchReplaceStruct *srs, *copy;
  MemHandle copyHan;

  srs = (SearchReplaceStruct *)MemLock(searchInfo);
  copyHan = MemAlloc(sizeof(SearchReplaceStruct) + srs->searchSize, 
		     HF_SHARABLE | HF_SWAPABLE,
		     HAF_NO_ERR);
  copy = (SearchReplaceStruct *)MemLock(copyHan);
  *copy = *srs;
  strcpy((char *)copy+sizeof(SearchReplaceStruct), 
	 (char *)srs+sizeof(SearchReplaceStruct));
  MemUnlock(copyHan);
  MemUnlock(searchInfo);

  return copyHan;
}	/* End of DuplicateSearchInfo.	*/
@endif
