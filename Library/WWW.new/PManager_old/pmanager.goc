/***********************************************************************
 *		MSG_PM_INITIALIZE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Delete the ui tree.
 * PARAMETERS:	    none.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_INITIALIZE
{
  VisInstance  * vself;

  /*
   *  The reason to set focalObj -1 is because when MSG_GEN_DESTROY is
   *  called, MSG_SPEC_NAVIGATE_TO_NEXT(PREVIOUS)_FIELD will not look 
   *  for next focusable object.
   */
  /* Manage the geometry directly */
  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_MANAGED;

  @self->PM_focalObjIndex = -1;
  @self->PM_recvObj = oself;
  @self->PM_hrefs = HTListNewWID(0);      /* Store the HREFs on the page */
  @self->PM_anchorList = HTListNewWID(0); /* Store the HREFs on the page */
  @self->PM_anchorName = HTListNewWID(0); /* Store the NAMEs on the page */
  @self->PM_nameElement= HTListNewWID(0); /* Store needed info about NAMEs */
}	/* End of MSG_PM_INITIALIZE.	*/



