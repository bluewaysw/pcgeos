/***********************************************************************
 *		CreateChunkToSaveData
 ***********************************************************************
 * SYNOPSIS:	Allocate and return a chunk in the owner resource.
 * CALLED BY:	
 * RETURN:	HTMemHandle
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/14/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle 
CreateChunkToSaveData (char *ptr)
{
  HTMemHandle handle;
  char *dest;
  /*
   *  Allocate a memory chunk.
   */
  handle = HTMemAllocWID(0, sizeof(char) * (strlen(ptr)+1));
EC(ECCheckHTMemHandle(handle);)
  /*
   *  Copy the title string over.
   */
  dest = (char *)HTMemLock(handle);
  strcpy(dest, ptr);
  HTMemUnlock(handle);
  return handle;
}	/* End of CreateChunkToSaveData.	*/


/***********************************************************************
 *		MSG_PM_SAVE_TITLE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Store the title of the document.  The title is the
 *		    text between <TITLE> and </TITLE>
 * PARAMETERS:	    (char *ptr)
 *			ptr - points the text.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/13/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_TITLE
{
  HTMemHandle htmh;
  /*
   *  If there is a title already, free it.  Actually, it's weird if it
   *  already exists, unless the HTML source file has two <TITLE>'s.
   */
  if (@self->PM_title)
	HTMemFree(@self->PM_title);
  /*
   *  Create a chunk in @self->PM_title to store the data.
   */
  htmh = CreateChunkToSaveData(ptr);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->PM_title = htmh;

  return;
}	/* End of MSG_PM_SAVE_TITLE.	*/


/***********************************************************************
 *		MSG_PM_SAVE_BASE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Store the base URL, which will be used to complete
 *		    any partial URLs on the html document.
 * PARAMETERS:	    (char *ptr)
 *			ptr - points the text.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/14/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_BASE
{
  HTMemHandle htmh;
  /*
   *  If there is a base already, free it.  Actually, it's weird if it
   *  already exists, unless the HTML source file has two <BASE HREF=>'s.
   */
  if (@self->PM_base)
	HTMemFree(@self->PM_base);
  /*
   *  Create a chunk to store the base data in PM_base.
   */
  htmh = CreateChunkToSaveData(ptr);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->PM_base = htmh; 

  return;
}	/* End of MSG_PM_SAVE_BASE.	*/


/***********************************************************************
 *		MSG_PM_SAVE_HREF for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the HREF value and return a HREF token of it.
 * PARAMETERS:	    (char *href)
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_HREF
{
  int len, index;

  len = strlen(href);
  /*
   *  Has the HREF existed before?  If not, store it.
   */
  index = HTListFindItem(@self->PM_hrefs, href, len);
  if (index == -1)
    index = HTListAppend(@self->PM_hrefs, href, len);

  return index;
}	/* End of MSG_PM_SAVE_HREF.	*/


/***********************************************************************
 *		MSG_PM_SAVE_ANCHOR_NAME for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the NAME attribute value of an <A> element.
 * PARAMETERS:	    (char *name)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_ANCHOR_NAME
{
  NameElement elm;
  int len, check1, check2;

  if (name[0] == '#')
      name++;  /* skip the # sign */
  len = strlen(name);

  check1 = HTListAppend(@self->PM_anchorName, name, len);
  elm.NE_object = object;
  elm.NE_offset = offset;
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  check2 = HTListAppend(@self->PM_nameElement, &elm, sizeof(NameElement));
  /*
   *  PM_anchorName and PM_nameElement have one-to-one relationship.  
   *  That is, the first element in PM_anchorName is related to the
   *  first elment in PM_nameElement, and so on....
   */
  EC_WARNING_IF(check1 != check2, PM_ASSUMPTION_FAILS);

  return;
}	/* End of MSG_PM_SAVE_ANCHOR_NAME.	*/


/***********************************************************************
 *		MSG_PM_REFER_HYPERLINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the hrefToken, jump to the destination, which
 *                  could be
 *                  1) a named place on the same page, or
 *                  2) a different URL.
 * PARAMETERS:	    (int hrefToken)
 * SIDE EFFECTS:    
 *
 * STRATEGY:  If the refered place is 
 *            1) a named location on the same page, scroll the view to
 *               that place.
 *            2) a URL, make a request to load the page.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_HYPERLINK
{
  int len, nameToken;
  char *buffer;
  MemHandle mem;
  NameElement elm;
  SizeAsDWord sz;
  /*
   *  Find out the href string size, so we know how much space to 
   *  allocate to get the href string.
   */
  len = HTListGetItemSize(@self->PM_hrefs, hrefToken);
  mem = MemAlloc((len+1) * sizeof(char),
		    HF_DYNAMIC, HAF_STANDARD);
  buffer = MemLock(mem);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  HTListGetItem(@self->PM_hrefs, hrefToken, buffer, len);
  buffer[len] = NULL;
  if (buffer[0] == '#') {
    /* 
     *  It's a reference to the same page.
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    nameToken = HTListFindItem(@self->PM_anchorName, buffer+1, len-1);
    if (nameToken != -1) {
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTListGetItem(@self->PM_nameElement, nameToken,
		  &elm,sizeof(NameElement));
    sz = @call self::MSG_VIS_GET_SIZE();
    @call self::MSG_PM_SHOW_ANCHOR(elm, DWORD_HEIGHT(sz));
    }
    EC_WARNING_IF(nameToken == -1, PM_ANCHOR_NAME_NOT_FOUND);
    MemFree(mem);
  }
  else {
    /*
     *  It's a referece to another page.  Thus make a request to the 
     *  socket library to fetch a new page.
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    if (@self->PM_linkUnderMouse)
      MemFree(@self->PM_linkUnderMouse);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @self->PM_linkUnderMouse = mem;
    MemUnlock(mem);
  }
  return;
}	/* End of MSG_PM_REFER_HYPERLINK.	*/


/***********************************************************************
 *	MSG_PM_SET_ANCHOR for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the targeted anchor object that will be 
 *                  brought into the view.
 * PARAMETERS:	    (optr obj, int offset)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SET_ANCHOR
{
    @self->PM_anchorObj = obj;
    @self->PM_anchorOffset = offset;
    return;
}	/* End of MSG_PM_SET_ANCHOR.	*/


/***********************************************************************
 *		MSG_PM_RECORD_ANCHOR_OBJECT for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Record a focusable object into a list.
 * PARAMETERS:	    (optr object);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_RECORD_ANCHOR_OBJECT
{
    word cnt;
    optr lastObj;
    cnt = HTListGetCount(@self->PM_anchorList);
    if (cnt > 0) {
	HTListGetItem(@self->PM_anchorList, cnt-1, &lastObj, sizeof(optr));
	if (lastObj == object)
	    return;
    }
    HTListAppend(@self->PM_anchorList, &object, sizeof(optr));
    return;
}	/* End of MSG_PM_RECORD_ANCHOR_OBJECT.	*/

/***********************************************************************
 *		MSG_VIS_SET_SIZE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Intercept this routine to check if there is any
 *                  destination anchor we'd like to bring up into the
 *                  view.  Note, at this momement GenView should be
 *                  be set bigger before the PManager and content set
 *                  bigger.
 * PARAMETERS:	    (int width, int height);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/17/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_VIS_SET_SIZE
{
  Rectangle objrect;
  @callsuper();
  /*
   *  There is an anchorObj waiting to be brought into the view.  This object
   *  is the targeted anchor pointer of <A HREF=url#name> that user had
   *  clicked on the previous page.
   */
  if (@self->PM_anchorObj) {
    @call @self->PM_anchorObj::MSG_VIS_GET_BOUNDS(&objrect);
    if ((@call @self->PM_anchorObj::MSG_VIS_GET_ATTRS() & VA_REALIZED) &&
	height > objrect.R_top) {
      NameElement elm;
      elm.NE_object = @self->PM_anchorObj;
      elm.NE_offset = @self->PM_anchorOffset;
      if (@call self::MSG_PM_SHOW_ANCHOR(elm, height) == TRUE)
	  @self->PM_anchorObj = @self->PM_anchorOffset = NULL;
    }
  }
  return;
}	/* End of MSG_VIS_SET_SIZE.	*/


/***********************************************************************
 *		MSG_PM_SHOW_ANCHOR for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Bring the anchor object into the view.  If the 
 *                  document is not long enough(i.e. the destination 
 *                  anchor is outside the document), it will do nothing.
 * PARAMETERS:	    (NameElement elm, int contentHeight)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SHOW_ANCHOR
{
  Rectangle rect;
  VisTextConvertOffsetParams params;
  word pos;
  optr parent, next;

  if (elm.NE_offset == -1) {
      /*
       *  Bring up the BOTTOM of this object on the screen.  However, 
       *  if we can find the next object, then bring the top edge of
       *  the next object into view.
       */
      parent = @call elm.NE_object::MSG_GEN_FIND_PARENT();
      pos = @call parent::MSG_GEN_FIND_CHILD(elm.NE_object);
      next = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(pos+1);
      if (next) {
	  @call next::MSG_VIS_GET_BOUNDS(&rect);
	  if (rect.R_top > contentHeight)
	      return FALSE;
	  @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	      (rect.R_left, rect.R_top);
      }
      else {
	  @call elm.NE_object::MSG_VIS_GET_BOUNDS(&rect);
	  if (rect.R_bottom > contentHeight)
	      return FALSE;
	  @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	      (rect.R_left, rect.R_bottom);
      }
  }
  else if (elm.NE_offset == 0) {
      /* Bring up the TOP of this object on the screen. */
      @call elm.NE_object::MSG_VIS_GET_BOUNDS(&rect);
      if (rect.R_top > contentHeight)
	  return FALSE;
      @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	  (rect.R_left, rect.R_top);
  }
  else {
      /* elm.NE_object MUST be a text object. */
      if (elm.NE_object &&
	  @call elm.NE_object::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass)){
	  if (!(@call elm.NE_object::MSG_VIS_GET_OPT_FLAGS() & 
	      VOF_GEOMETRY_INVALID)) {
	    params.VTCOP_offset = elm.NE_offset;
	    @call elm.NE_object::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE
		(&params);
	    if (params.VTCOP_yPos + Y_SCREEN_SIZE > contentHeight)
		return FALSE;
	    @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
		(params.VTCOP_xPos, params.VTCOP_yPos);
	}
      }
  }
  return TRUE;
}	/* End of MSG_PM_SHOW_ANCHOR.	*/



/***********************************************************************
 *	MSG_PM_REFER_AREAMAP_LINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the URL of the clicked <AREA>
 * PARAMETERS:	    (HTMemHandle src)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/18/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_AREAMAP_LINK
{
  /*
   *  User has chosen a hot spot in an client-side image map.  
   *  Thus, we pass the the HREF url in the clicked <AREA>.
   */
  @self->PM_x = -1;
  @self->PM_y = -1;
  @self->PM_src = src;
}	/* End of MSG_PM_REFER_AREAMAP_LINK.	*/


/***********************************************************************
 *		MSG_PM_REFER_ISMAP_LINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the URL of the <A> and the mouse coordinates
 * PARAMETERS:	    (int rel_x, int rel_y, int hrefToken)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/28/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_ISMAP_LINK
{
  int len;
  HTMemHandle mem;
  char *buffer;
  /*
   *  User has chosen a server-side ismap.  Thus, we pass the 
   *  URL of the anchor <A> and the mouse's relative coordinates.
   */
  @self->PM_x = rel_x;
  @self->PM_y = rel_y;
  len = HTListGetItemSize(@self->PM_hrefs, hrefToken);
  buffer = HTMemAllocAndLockWID(0, &mem, (len+1) * sizeof(char));
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  HTListGetItem(@self->PM_hrefs, hrefToken, buffer, len);
  buffer[len] = NULL;
  HTMemUnlock(mem);
  @self->PM_src = mem;

}	/* End of MSG_PM_REFER_ISMAP_LINK.	*/



