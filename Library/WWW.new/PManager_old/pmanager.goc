 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_DRAW_TREE
{
  word i, count = @call self::MSG_GEN_COUNT_CHILDREN();
  optr child;
  GStateHandle gstate;
  WindowHandle win;
  VisInstance  * vself;

  vself = ObjDerefVis(oself);
  vself->VI_optFlags = NULL;

  win = @call self::MSG_VIS_QUERY_WINDOW();
  gstate = GrCreateState(win);

  for(i = 0; i < count; i++) {
      child = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(i);
      @send child::MSG_VIS_DRAW(DF_EXPOSED, gstate);
  }
  GrDestroyState(gstate);
  return;
}	/* End of MSG_PM_DRAW_TREE.	*/
@endif


/***********************************************************************
 *		GetLeftMostLeaf  GetRightMostLeaf
 ***********************************************************************
 *
 * SYNOPSIS:	Give a object, find its first leaf(left bottom-most)
 *              object.
 * CALLED BY:	
 * RETURN:	first left leaf object
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/20/97   	Initial Revision
 *	
 ***********************************************************************/
optr
GetLeftMostLeaf (optr parent)
{
  optr child;
  /*
   *  Get the left-most(topest) leaf.
   */
  child = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(0);
  while(child) {
      parent = child;
      child = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(0);
  }
  return parent;
}	/* End of GetLeftMostLeaf.	*/

optr
GetRightMostLeaf (optr parent)
{
  int cnt;
  optr child;
  /*
   *  Get the right-most(bottomest) leaf.
   */
  cnt = @call parent::MSG_GEN_COUNT_CHILDREN();
  child = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(cnt-1);
  while(child) {
      parent = child;
      cnt = @call child::MSG_GEN_COUNT_CHILDREN();
      child = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(cnt-1);
  }
  return parent;
}	/* End of GetRightMostLeaf.	*/

@if 0  /* In this Penelope first release we don't support search */

/***********************************************************************
 *		MSG_SEARCH for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Search a word in the UI tree.
 * PARAMETERS:	    (MemHandle searchInfo)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/12/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_SEARCH
{
  optr parent, genContent, temp;
  SearchReplaceStruct *srs;
  MemHandle dup;
  int direction;

  genContent = @call self::MSG_GEN_FIND_PARENT();
  /*
   *  Check to see if it's START FROM TOP.
   */
  srs = (SearchReplaceStruct *)MemLock(searchInfo);
  if (srs->params & SO_START_FROM_TOP) {
    searchObj = NULL;
    searchRange.VTR_start = searchRange.VTR_end = 0;
  }
  if (srs->params & SO_BACKWARD_SEARCH)
    direction = SEARCH_BACKWARD;
  else
    direction = SEARCH_FORWARD;
  MemUnlock(searchInfo);

  if (searchObj) {
    /*
     *  If there exists an object for us to search, do it now.
     */
    dup = DuplicateSearchInfo(searchInfo);
    if (SearchInText(searchObj, genContent, searchInfo) == STOP) {
      /* Found it!  Thus, return */
      MemFree(dup);
      temp = searchObj;
    }
    else {
      /*
       *  Not found, search the next sibing object.
       */
      searchInfo = dup;
      temp = GetNextSiblingOrParentsSibling(searchObj,direction,TEXT_ONLY);
      if (temp)
	temp = DepthFirstSearch(temp, genContent, searchInfo);
    }
  }
  else {
    /*
     *  Search from the top of the page.
     */
    parent = NULL;
    /*
     *  Get the first most-left leaf.
     */
    parent = GetLeftMostLeaf(oself);

    if (!parent)
      /*
       *  PManager doesn't have any children.
       */
      return;
    else if (@call parent::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass))
      @call parent::MSG_VIS_TEXT_SELECT_START();
    temp = DepthFirstSearch(parent, genContent, searchInfo);
  }

  if (temp) {
    /*
     *  matching string is found.
     */
    searchObj = temp;
    @send self::MSG_PM_SEARCH_FOUND(direction);
  }
  else if (!searchObj)
    /*
     *  string is not found anywhere in the ui tree.
     */
    @send self::MSG_PM_SEARCH_NOT_FOUND();
  else
    /*
     *  string has been found before but no more is found.
     */
    @send self::MSG_PM_SEARCH_NO_MORE_FOUND(direction);

  return;
}	/* End of MSG_SEARCH.	*/
@endif


