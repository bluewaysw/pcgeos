/***********************************************************************
 *		MSG_VIS_DRAW for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw background when printing
 * PARAMETERS:	    void (DrawFlags drawFlags, GStateHandle gstate);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	joon    	9/18/97   	Initial Revision
 *	
 ***********************************************************************/

typedef struct {
    byte WCI_red;
    byte WCI_flags;
    byte WCI_green;
    byte WCI_blue;
} WinColorInfo;

@if 0
@method PresentationManagerClass, MSG_VIS_DRAW
{
    WindowHandle window;
    WinColorInfo colorInfo;
    Rectangle rect;

    /*
     * If we're printing, draw the background using the window's
     * background color.
     */
    if (drawFlags & DF_PRINT) {
	if ((window = @call oself::MSG_VIS_QUERY_WINDOW()) != NULL) {
	    WinGetInfo(window, WIT_COLOR, &colorInfo);

	    /*
	     * But only for normal windows whose washcolor is not white.
	     */
	    if ((colorInfo.WCI_flags == 0) && 
		(colorInfo.WCI_red != C_WHITE)) {
		GrSetAreaColor(gstate, CF_INDEX, colorInfo.WCI_red, 0, 0);
		@call oself::MSG_VIS_GET_BOUNDS(&rect);
		GrFillRect(gstate, rect.R_left, rect.R_top,
			   rect.R_right, rect.R_bottom);
		GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	    }
	}
    }

    @callsuper();

}	/* End of MSG_VIS_DRAW.	*/
@endif


