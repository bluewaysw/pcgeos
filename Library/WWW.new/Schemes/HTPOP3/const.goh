@ifndef __HTPOP3_CONST_GOH__
@define __HTPOP3_CONST_GOH__

@include <WWW/HTCore/htstream.goh>

#define PUTBLOCK(target, data, len)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, len)

/* 
 * HTPOP3 FSM states. 
 */
typedef enum {
    /* Protocol states */
    HTPOP3_BEGIN,               
    HTPOP3_CONNECT,
    HTPOP3_GET_RESPONSE,
    HTPOP3_PUSH_RESP,

    HTPOP3_MAKE_REQUEST,
    HTPOP3_USER,
    HTPOP3_PASS,
    HTPOP3_LIST,
    HTPOP3_RETR,
    HTPOP3_QUIT,

    HTPOP3_INVALID_STATE
} HTPOP3State;


/*
 * Parser states.
 */
#define PARSE_BEGIN          0
#define SKIP_LINE            1
#define PARSE_DATA_LIST      2
#define PARSE_DATA_RETR      3
#define SAW_FIRST_LF         4
#define SAW_DOT              5
#define LAST_LINE            6

@endif
