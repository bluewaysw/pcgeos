@ifndef __HTPOP3_FATALS_GOH__
@define __HTPOP3_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    HTPOP3_REQUEST_NOT_SET,
    HTPOP3_STATE_NOT_HANDLED
} FatalErrors;
#endif /* ERROR_CHECK */

/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    HTPOP3_DUMMY_WARNING
} Warnings;
#endif

#if ERROR_CHECK
extern FatalErrors htpop3FatalErrors;
extern Warnings    htpop3Warnings;
#endif

@endif /* __HTIMAP_FATALS_GOH__ */
