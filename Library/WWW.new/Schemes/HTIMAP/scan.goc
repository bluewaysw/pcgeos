@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htutils.goh>
@include "htfatals.goh"
@include "scan.goh"
@include "const.goh"

#include <Ansi/string.h>

extern char CRLF[];     /* In htimap.goc */

#define HTIMAP_RESP_RESERVED_WORDS      32
/*
 * Reserved words table
 */
IMAPKey respReservedWords[] = {
    /*
     * *MUST* be strcmp order and case insensitive. 
     * Remember to keep HTIMAP_RESERVED_WORDS up-to-date.
     */
    {"BAD",              IMT_BAD},
    {"BODY",             IMT_BODY},
    {"BODYSTRUCTURE",    IMT_BODYSTRUCTURE},
    {"BYE",              IMT_BYE},
    {"CAPABILITY",       IMT_CAPABILITY},
    {"ENVELOPE",         IMT_ENVELOPE},
    {"EXISTS",           IMT_EXISTS},
    {"EXPUNGE",          IMT_EXPUNGE},
    {"FETCH",            IMT_FETCH},
    {"FLAGS",            IMT_FLAGS},
    {"IMAP4",            IMT_IMAP4},
    {"IMAP4Rev1",        IMT_IMAP4REV1},
    {"INTERNALDATE",     IMT_INTERNALDATE},
    {"LIST",             IMT_LIST},
    {"LSUB",             IMT_LSUB},
    {"MESSAGE",          IMT_MESSAGE},
    {"MAILBOX",          IMT_MAILBOX},
    {"NIL",              IMT_NIL},
    {"NO",               IMT_NO},
    {"OK",               IMT_OK},
    {"RECENT",           IMT_RECENT},
    {"RFC822",           IMT_RFC822},
    {"RFC822.HEADER",    IMT_RFC822_HEADER},
    {"RFC822.SIZE",      IMT_RFC822_SIZE},
    {"RFC822.TEXT",      IMT_RFC822_TEXT},
    {"SEARCH",           IMT_SEARCH},
    {"SEEN",             IMT_SEEN},
    {"STATUS",           IMT_STATUS},
    {"TEXT",             IMT_TEXT},
    {"UID",              IMT_UID},
    {"UIDVALIDITY",      IMT_UIDVALIDITY},
    {"UNSEEN",           IMT_UNSEEN},
    {0,0}
};


/***********************************************************************
		Private Functions
***********************************************************************/

static int _pascal ScanGetByte (IMAPScanner *s, byte *b);
static void _pascal ScanUngetByte (IMAPScanner *s);
static Boolean _pascal IsDelimiter (byte b);
static int _pascal ScanGetData (IMAPScanner *s);


/***********************************************************************
		Public Functions
***********************************************************************/

/***********************************************************************
 *		IMAPBinSearch
 ***********************************************************************
 *
 * SYNOPSIS:	Binary search a strcmp order list of words.
 * CALLED BY:	IMAPParseCommand, GobbleSym
 * RETURN:	Valid kind if found, else -1.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/24/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
IMAPBinSearch (char *wordBuffer, IMAPKey tab[], int n)
{
    int result, i, lower=0;
    int upper = n - 1;

    while (upper >= lower) {
	i = (lower + upper) / 2;

	/* Case insensitive compare */
	result = strcasecmp(wordBuffer, tab[i].name);

	if (result < 0)
	    upper = i - 1;

	else if (result > 0)
	    lower = i + 1;

	else
	    return tab[i].kind;
    }

    return -1;
}	/* End of IMAPBinSearch.	*/


/***********************************************************************
 *		GobbleSym
 ***********************************************************************
 *
 * SYNOPSIS:	Gobble a symbol into scanner.
 * CALLED BY:	Parser.
 * RETURN:	HT_OK or return code from HTSocketRecv.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
GobbleSym (IMAPScanner *s)
{
    byte b;
    int ret;

    /* Allow one ungotten sym only */
    if (s->ungottenSym) {
	s->ungottenSym = FALSE;
	return HT_OK;
    }

    if ((ret=ScanGetByte(s, &b))!= HT_OK) return ret;
    while (1) {
	if (ISALPHA(b)) {
	    int i = 0;
	    s->thisWord[0] = 0;
	    do {
		if (i < MAX_IMAP_WORD_LENGTH-1) {
		    s->thisWord[i++] = b;
		    s->thisWord[i] = 0;
		}
                #if ERROR_CHECK
		else EC_ERROR(HTIMAP_BUFFER_IS_NOT_BIG_ENOUGH);
                #endif
	    } while (((ret=ScanGetByte(s, &b))==HT_OK) &&
		     !IsDelimiter(b));
	    if (ret != HT_OK) return ret;
	    /* We have read one byte ahead, rewind */
	    ScanUngetByte(s);
	    /* What token does the word represent? */
	    s->thisSym = IMAPBinSearch(s->thisWord, respReservedWords,
				       HTIMAP_RESP_RESERVED_WORDS);
	    if (s->thisSym == IMT_INVALID && s->thisWord[0] == 'a') {
		int j;
		for (j=1; j<i; j++) {
		    if (!ISDIGIT(s->thisWord[j]))
			return HT_OK;
		}
		UtilAsciiToHex32(s->thisWord+1, (sdword *)&(s->thisNum));
		s->thisSym = IMT_TAG;
	    }
	    return HT_OK;
	} else if (ISDIGIT(b)) {
	    int i = 0;
	    s->thisWord[0] = 0;
	    do {
		if (i < MAX_IMAP_WORD_LENGTH-1) {
		    s->thisWord[i++] = b;
		    s->thisWord[i] = 0;
		}
                #if ERROR_CHECK
		else EC_ERROR(HTIMAP_BUFFER_IS_NOT_BIG_ENOUGH);
                #endif
	    } while (((ret=ScanGetByte(s, &b))==HT_OK) && ISDIGIT(b));
	    if (ret != HT_OK) return ret;
	    /* We have read one byte ahead, rewind */
	    ScanUngetByte(s);
	    UtilAsciiToHex32(s->thisWord, (sdword *)&(s->thisNum));
	    s->thisSym = IMT_NUM;
	    return HT_OK;
	} else if (b=='[') {
	    s->thisSym = IMT_LBRACKET;
	    return HT_OK;
	} else if (b==']') {
	    s->thisSym = IMT_RBRACKET;
	    return HT_OK;
	} else if (b=='(') {
	    s->thisSym = IMT_LPAREN;
	    return HT_OK;
	} else if (b==')') {
	    s->thisSym = IMT_RPAREN;
	    return HT_OK;
	} else if (b=='{') {
	    s->thisSym = IMT_LBRACE;
	    return HT_OK;
	} else if (b=='}') {
	    s->thisSym = IMT_RBRACE;
	    return HT_OK;
	} else if (b=='*') {
	    s->thisSym = IMT_ASTERIK;
	    return HT_OK;
	} else if (b=='+') {
	    s->thisSym = IMT_PLUS;
	    return HT_OK;
	} else if (b=='\"') {
	    s->thisSym = IMT_DQUOTE;
	    return HT_OK;
	} else if (b=='\\') {
	    s->thisSym = IMT_BSLASH;
	    return HT_OK;
	} else if (b==CR) {
	    s->thisSym = IMT_CR;
	    return HT_OK;
	} else if (b==LF) {
	    s->thisSym = IMT_LF;
	    return HT_OK;
	} else {
	    /* Ignore whitespace */
EC(         if (!ISWHITE(b)) EC_WARNING(HTIMAP_SCANNER_IGNORE_BYTE);   )
            ret = ScanGetByte(s, &b);
            if (ret != HT_OK) return ret;
	}
    }
}	/* End of GobbleSym.	*/



/***********************************************************************
 *		GobbleTill
 ***********************************************************************
 *
 * SYNOPSIS:	Gobble until we reach a certain byte, inclusively.
 * CALLED BY:	Parser.
 * RETURN:	HT_OK or return code HTSocketRecv.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
GobbleTill (IMAPScanner *s, byte b)
{
    int ret = HT_OK;

    while (1) {
	if (s->sock->HTS_length && s->index < s->sock->HTS_length) {
	    byte *c;
	    for (c = s->sock->HTS_buffer+s->index; 
		 s->index < s->sock->HTS_length; (s->index)++, c++) {
		if (*c==b) {
		    (s->index)++;    /* Ignore the byte as well */
		    return HT_OK;    /* Found! */
		}
	    }
	}
	if ((ret = ScanGetData(s)) != HT_OK) return ret;
    }
}	/* End of GobbleTill.	*/


/***********************************************************************
 *		GobbleTillWhite
 ***********************************************************************
 *
 * SYNOPSIS:	Gobble until we reach a ISWHITE inclusively.
 * CALLED BY:   Parser.
 * RETURN:	HT_OK or return code from HTSocket.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/18/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
GobbleTillWhite (IMAPScanner *s)
{
    int ret = HT_OK;

    while (1) {
	if (s->sock->HTS_length && s->index < s->sock->HTS_length) {
	    byte *c;
	    for (c = s->sock->HTS_buffer+s->index; 
		 s->index < s->sock->HTS_length; (s->index)++, c++) {
		if (ISWHITE(*c)) {
		    (s->index)++;    /* Ignore the byte as well */
		    return HT_OK;    /* Found! */
		}
	    }
	}
	if ((ret = ScanGetData(s)) != HT_OK) return ret;
    }
}	/* End of GobbleTillWhite.	*/



/***********************************************************************
 *		UnGobbleSym
 ***********************************************************************
 *
 * SYNOPSIS:	Keep the current sym for the next GobbleSym. This routine
 *              only work with GobbleSym and DOES NOT work with GobbleTill 
 *              and GobbleQString and GobbleNString. This routine's
 *              and subsequent GobbleSym behavior are UNDEFINED if the 
 *              you UnGobbleSym without first GobbleSym.
 * CALLED BY:	Parser
 * RETURN:	HT_OK
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
void _pascal
UnGobbleSym (IMAPScanner *s)
{
    s->ungottenSym = TRUE;
}	/* End of UnGobbleSym.	*/



/***********************************************************************
 *		GobbleQString
 ***********************************************************************
 *
 * SYNOPSIS:	Eat a quoted string as per RFC2060. The starting double
 *              quote " has already been eaten.
 *              mode = SAVE_STRING
 *                 To save the complete string to str. If the string is
 *                 empty (we immediately see "), then str = 0.
 *              mode = PUSH_STRING 
 *                 To push the string to p->strTarget. Target must
 *                 already be set. If the string is empty (we immediately
 *                 see "), then we won't push to target.
 *              mode = SKIP_STRING 
 *                 To skip the string.
 *              length = return length of string. Pass NULL if you do not
 *                 want the length.
 * CALLED BY:	Parser.
 * RETURN:	HT_OK or return code from HTSocketRecv.
 *	
 * STRATEGY:    Pay attention to quoted_specials \ and ".
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
GobbleQString (IMAPScanner *s, int mode, HTMemHandle *str, HTStreamHandle
	       target, dword *length)
{
#define QUOTED_NORMAL   1
#define QUOTED_SPECIAL  2

    int ret = HT_OK;
    int state = QUOTED_NORMAL;
    *str = 0;

    if (length) *length = 0;
    while (1) {
	if (s->sock->HTS_length && s->index < s->sock->HTS_length) {
	    int len;
	    byte *end;
	    byte *start = s->sock->HTS_buffer + s->index;
	    for (end = s->sock->HTS_buffer + s->index;
		 s->index < s->sock->HTS_length; (s->index)++, end++) {
		if (state == QUOTED_SPECIAL) {
		    if (*end != '\\' && *end != '\"') {
			/* 
			 * Tolerate buggy servers that wrongly implememt
			 * quoted_specials; e.g., NTMail.
			 */
EC(                     EC_WARNING(HTIMAP_INVALID_QUOTED_SPECIAL);      )
                        /* Salvage the '\' preceding this byte */
                        if (length) (*length)++;
                        if (mode == SAVE_STRING) {
			    *str = (*str ? 
				    HTStrnAllocCat(*str, (char*)"\\", 1):
				    HTStrnAllocCopy((char*)"\\", 1));
			} else if (mode == PUSH_STRING) {
			    ret = PUTBLOCK(target, (void*)"\\", 1);
			    if (ret != HT_OK) return ret;
			} /* else SKIP_STRING */
                    }
		    start = end;
                    state = QUOTED_NORMAL;
		} else if (*end == '\\') {
		    /* Skip this byte */
		    len = end-start;
		    if (length) *length += len;
		    if (len > 0 && mode == SAVE_STRING) {
			*str = (*str ? 
				HTStrnAllocCat(*str, (char*)start, len):
				HTStrnAllocCopy((char*)start, len));
		    } else if (len > 0 && mode == PUSH_STRING) {
			ret = PUTBLOCK(target, start, len);
			if (ret != HT_OK) return ret;
		    } /* else SKIP_STRING */
		    state = QUOTED_SPECIAL;
		} else if (*end == '\"') {
		    /* Done! */
		    /* Skip this byte */
		    len = end-start;
		    if (length) *length += len;
		    if (len > 0 && mode == SAVE_STRING) {
			*str = (*str ?
				HTStrnAllocCat(*str, (char*)start, len):
				HTStrnAllocCopy((char*)start, len));
		    } else if (len > 0 && mode == PUSH_STRING) {
			ret = PUTBLOCK(target, start, len);
			if (ret != HT_OK) return ret;
		    } /* else SKIP_STRING */
		    /* Don't forget to skip the byte */
		    (s->index)++;
		    return HT_OK;
		}
	    }
	    /* Process all data and then get more */
	    len = end-start;
	    if (length) *length += len;
	    if (len > 0 && mode == SAVE_STRING) {
		*str = (*str ? 
			HTStrnAllocCat(*str, (char*)start, len):
			HTStrnAllocCopy((char*)start, len));
	    } else if (len > 0 && mode == PUSH_STRING) {
		ret = PUTBLOCK(target, start, len);
		if (ret != HT_OK) return ret;
	    } /* else SKIP_STRING */
	}
	if ((ret=ScanGetData(s)) != HT_OK) return ret;
    }
}	/* End of GobbleQString.	*/



/***********************************************************************
 *		GobbleNString
 ***********************************************************************
 *
 * SYNOPSIS:	Gobble a literal string as per RFC2060.
 *              mode = SAVE_STRING
 *                 To save the complete string to p->strhtmh. Caller 
 *                 must consume p->strhtmh and set it back to 0.
 *              mode = PUSH_STRING 
 *                 To push the string to p->strTarget. Target must
 *                 already be set.
 *              mode = SKIP_STRING 
 *                 To skip the string.
 * CALLED BY:	Parser.
 * RETURN:	HT_OK or return code from HTSocketRecv.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
GobbleNString (IMAPScanner *s, dword nbytes, int mode, HTMemHandle *str, 
	       HTStreamHandle target)
{
    int ret = HT_OK;
    *str = 0;
    
    while (1) {
	if (s->sock->HTS_length && s->index < s->sock->HTS_length) {
	    byte *start = s->sock->HTS_buffer + s->index;
	    word leftover = s->sock->HTS_length - s->index;
	    dword fit = (nbytes < (dword)leftover) ?  
			 nbytes : (dword)leftover;
	    /* 
	     * Note that s->sock->HTS_length is a word value, so fit
	     * is safe to be casted into a word value later on. 
	     */
	    if (fit > 0 && mode == SAVE_STRING) {
		*str = (*str ?
			HTStrnAllocCat(*str, (char*)start, (word)fit):
			HTStrnAllocCopy((char*)start, (word)fit));
	    } else if (fit > 0 && mode == PUSH_STRING) {
		ret = PUTBLOCK(target, start, (word)fit);
		if (ret != HT_OK) return ret;
	    } /* else SKIP_STRING */
	    s->index += (word)fit;
	    nbytes -= fit;
	    if (!nbytes) return HT_OK;  /* Done! */
	}
	/* Get more data */
	if ((ret=ScanGetData(s)) != HT_OK) return ret;
    }
}	/* End of GobbleNString.	*/



/***********************************************************************
		Private Functions
***********************************************************************/

/***********************************************************************
 *		ScanGetByte
 ***********************************************************************
 *
 * SYNOPSIS:	Get one byte at a time. This will either return a byte
 *              or fail.
 * CALLED BY:	GobbleSym
 * RETURN:	HT_OK or return code from HTSocketState if failed to get
 *              data. We won't return if socket timeout (unless of course
 *              we were interrupted via socket's HTSocketStop).
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 3/97   	Initial Revision
 *	
 ***********************************************************************/
static int _pascal
ScanGetByte (IMAPScanner *s, byte *b)
{
    int ret;
    if (!s->sock->HTS_length ||
	s->index >= s->sock->HTS_length)
	if ((ret = ScanGetData(s)) != HT_OK) return ret;

    *b = s->sock->HTS_buffer[(s->index)++];
    return HT_OK;
}	/* End of ScanGetByte.	*/



/***********************************************************************
 *		ScanUngetByte
 ***********************************************************************
 *
 * SYNOPSIS:	Unget the recently consumed byte.
 * CALLED BY:	GobbleSym
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
ScanUngetByte (IMAPScanner *s)
{
EC( if (!s->index || !s->sock->HTS_length)                              )
EC(   EC_ERROR(HTIMAP_NO_BYTE_TO_UNGET);                                )
    (s->index)--;
}	/* End of ScanUngetByte.	*/



/***********************************************************************
 *		IsDelimiter
 ***********************************************************************
 *
 * SYNOPSIS:	Whether a byte is an IMAP delimiter.
 * CALLED BY:	GobbleSym
 * RETURN:	TRUE or FALSE.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
static Boolean _pascal
IsDelimiter (byte b)
{
    if (ISWHITE(b) || (b == '[') || (b == ']') || (b == '(') || 
	(b == ')') || (b == '{') || (b == '}') || (b == '\"') ||
	(b == '\\'))
	return TRUE;
    else 
	return FALSE;
}	/* End of IsDelimiter.	*/


/***********************************************************************
 *		ScanGetData
 ***********************************************************************
 *
 * SYNOPSIS:	Receive more data from socket.
 * CALLED BY:	ScanGetByte, GobbleTill, GobbleQString, GobbleNString.
 * RETURN:	HT_OK or return code from HTSocketRecv.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
static int _pascal
ScanGetData (IMAPScanner *s)
{
    while (!HTSocketRecv(s->socket, 10) && (s->sock->HTS_state==HT_OK));
    s->index = 0;
    return s->sock->HTS_state;
}	/* End of ScanGetData.	*/
