@ifndef _HTIMAP_CONST_H_
@define _HTIMAP_CONST_H_

@include <WWW/HTCore/htstream.goh>

#define PUTBLOCK(target, data, len)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, len)


/*
 * IMAP4 server versions.
 */
typedef enum {
    IMAP4_UNKNOWN_SERVER,
    IMAP4_SERVER,                  /* RFC1730 server */
    IMAP4REV1_SERVER               /* RFC2060 server */
} IMAPServerVersion;


/* 
 * HTIMAP states. 
 */
typedef enum {
    /* Protocol states */
    HTIMAP_BEGIN,               
    HTIMAP_CONNECT,
    HTIMAP_GET_RESPONSE,
    HTIMAP_PUSH_RESP,
    HTIMAP_MAKE_REQUEST,
    HTIMAP_DONE,
    HTIMAP_NOTHING,

    HTIMAP_CAPABILITY,
    HTIMAP_LOGIN,
    HTIMAP_SELECT,
    HTIMAP_SEARCH,
    HTIMAP_FETCH,
    HTIMAP_FETCH_LIST,
    HTIMAP_DELETE,
    HTIMAP_EXPUNGE,
    HTIMAP_LOGOUT,

    HTIMAP_BODY_REQUEST,
    HTIMAP_PBODY_REQUEST,
    HTIMAP_PBODY_REQUEST2,
    HTIMAP_ATTACH_REQUEST,
    HTIMAP_PATTACH_REQUEST,

    HTIMAP_INVALID_STATE
} HTIMAPState;

@endif /* _HTIMAP_CONST_H_ */
