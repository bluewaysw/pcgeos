@ifndef __HTIMAP_FATALS_GOH__
@define __HTIMAP_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    HTIMAP_REQUEST_NOT_SUPPORTED,
    HTIMAP_BAD_REQUEST_URL,        /* imap://server/... URL is bad */
    HTIMAP_NO_BYTE_TO_UNGET,       /* ScanUngetByte failed */
    HTIMAP_SCANNER_NOT_EMPTY,
    HTIMAP_BUFFER_IS_NOT_BIG_ENOUGH,
    HTIMAP_BASIC_BODY_CANNOT_CONTAIN_BODY,
    HTIMAP_BODY_PART_NUMBER_EXPECTED,
    HTIMAP_LBRACKET_EXPECTED,
    HTIMAP_FLD_PARAM_EXPECTED,
    HTIMAP_ENCODING_EXPECTED,
    HTIMAP_ALREADY_HAS_BODY_PART_NUMBER,
    HTIMAP_ALREADY_HAS_BODY_SIZE,
    HTIMAP_ALREADY_HAS_DATE,
    HTIMAP_ALREADY_HAS_CHARSET,
    HTIMAP_ALREADY_HAS_SUBJECT,
    HTIMAP_ALREADY_HAS_SENDERNAME,
    HTIMAP_ALREADY_HAS_SENDEREMAIL,
    HTIMAP_ALREADY_HAS_NAME,
    HTIMAP_NOT_YET_IMPLEMENTED,
    HTIMAP_STATE_NOT_HANDLED,
    HTIMAP_STRING_CONSUMED,         /* p->strhtmh == 0 */
    HTIMAP_TAG_MISMATCH,            /* Command tag error, my fault */
    HTIMAP_REQUEST_NOT_SET,
    HTIMAP_LINEFEED_EXPECTED,
    HTIMAP_LIST_MUST_HAVE_BODY,     /* List req must return at least 1 body */
    HTIMAP_ALREADY_HAS_CONTENT_TYPE,/* A body already has content type */
    HTIMAP_NUMBER_EXPECTED,
    HTIMAP_CONTENT_TYPE_EXPECTED,
    HTIMAP_NOT_A_VALID_TOKEN_BYTE,
    HTIMAP_INVALID_PARAMETER,
    HTIMAP_INVALID_ENVELOPE,        /* bad envelope */
    HTIMAP_INVALID_ADDRESS,         /* bad address */
    HTIMAP_INVALID_BODY,            /* bad body */
    HTIMAP_INVALID_BODY_TYPE_MPART, /* bad body_type_mpart */
    HTIMAP_BODY_FLD_OCTETS_EXPECTED,/* bad body_fld_octets */
    HTIMAP_INVALID_STRING,          /* not string */
    HTIMAP_INVALID_STRING_MODE,     /* not SAVE_STRING, PUSH_STRING, SKIP_STRING */
    HTIMAP_INVALID_MSG_ATT,         /* bad msg_att */
    HTIMAP_INVALID_RFC822_SIZE,     /* bad RFC822.SIZE */
    HTIMAP_INVALID_FLAGS,           /* bad FLAGS */
    HTIMAP_INVALID_SEARCH,          /* bad search response */
    HTIMAP_INVALID_FLD_PARAM,       /* bad body_fld_param */
    HTIMAP_INVALID_BODY_FIELDS,     /* bad body_fields */
    HTIMAP_INVALID_RESPONSE_DONE,   /* bad response_done */
    HTIMAP_INVALID_RESPONSE_DATA,   /* bad response_data */
    HTIMAP_INVALID_RESPONSE,        /* bad response */
    HTIMAP_MEMORY_LEAK              /* leak p->strhtmh, not consumed after
				       ParseString or ParseNString */
} FatalErrors;
#endif /* ERROR_CHECK */

/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    HTIMAP_RESPONSE_IGNORED,
    HTIMAP_INVALID_QUOTED_SPECIAL,  /* not " or \ */ /* It was in FatalErrors */
    HTIMAP_ADD_BODY_NOT_ALLOWED,
    HTIMAP_SCANNER_IGNORE_BYTE,
    HTIMAP_POSSIBLE_MEMORY_LEAK    /* If request is successful, then there
				    * is definitely a memory leak. If request
                                    * failed, then no memory leak.
				    */
} Warnings;
#endif

#if ERROR_CHECK
extern FatalErrors htimapFatalErrors;
extern Warnings    htimapWarnings;
#endif

@endif /* __HTIMAP_FATALS_GOH__ */
