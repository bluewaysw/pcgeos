@ifndef __HT_FATALS_GOH__
@define __HT_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    HTFTP_REQUEST_NOT_SET,
    HTFTP_STATE_NOT_HANDLED
} FatalErrors;
#endif /* ERROR_CHECK */


/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    THIS_IS_A_DUMMY_ZZZ_WARNING
} Warnings;

#endif


#if ERROR_CHECK
extern FatalErrors htFtpFatalErrors;
extern Warnings    htFtpWarnings;
#endif 

@endif



