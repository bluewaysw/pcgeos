@ifndef __HT_FATALS_GOH
@define __HT_FATALS_GOH

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    HTTP_DATA_NOT_FLUSHED,
    HTTP_0_9_RESPONSE_USING_GUESS_STREAM_NOT_IMPLEMENTED,
    HTTP_0_9_SUPPORTS_GET_METHOD_ONLY,
    HTTP_1_0_NOT_IMPLEMENTED,
    HTTP_METHOD_NOT_IMPLEMENTED,
    HTTP_READ_CONDITION_NOT_HANDLED,
    HTTP_REQUEST_NOT_SET,
    HTTP_STATE_NOT_HANDLED,
    HTTP_VERSION_NOT_IMPLEMENTED,
    INVALID_BLOCK_IN_MSG_HT_STREAM_PUT_BLOCK,
    INVALID_REQUEST,
    PROGRAM_ERROR_UNDEFINED_HTTP_HEADER_PARSER_STATE,
    TARGET_HAS_BEEN_BUILT
} FatalErrors;
#endif /* ERROR_CHECK */

/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    HTTP_STATUS_LINE_HAS_NO_REASON_PHRASE,
    HTTP_STATUS_LINE_HAS_NO_STATUS_CODE,	
    STATE_NOT_HANDLED
} Warnings;
#endif

#if ERROR_CHECK
extern FatalErrors httpFatalErrors;
extern Warnings    httpWarnings;
#endif

@endif /* __HT_FATALS_GOH */
