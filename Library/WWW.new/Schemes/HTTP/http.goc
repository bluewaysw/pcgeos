#ifndef HTTP_PORT
#define HTTP_PORT 80                 /* Default */
#endif

/* HTTP parser state */
#define EOL_BEGIN           0
#define EOL_FCR             1

#define PUTBLOCK(target, data, len)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, len)


/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTTPClass;


/* --------------------------------------------------------------------------
 * 		PRIVATE FUNCTIONS
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTTPVersionEnum
 ***********************************************************************
 *
 * SYNOPSIS:	Translate HTTP version string to HTTPVersion.
 * CALLED BY:	MSG_HTTP_STREAM_PIPE
 * RETURN:	HTTPVersion, as defined in CInclude/WWW/HTCore/htreq.goh.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	2/19/97   	Initial Revision
 *	
 ***********************************************************************/
static HTTPVersion _pascal
HTTPVersionEnum (const char *str)
{
    if (!str || !(*str))
	return HTTPV_0_9;
    else if (!strcasecmp(str, "HTTP/1.0"))
	return HTTPV_1_0;
    else if (!strcasecmp(str, "HTTP/1.1"))
	return HTTPV_1_1;
    else
	return HTTPV_INVALID;
}	/* End of HTTPVersionEnum.	*/




/***********************************************************************
 *		HTTPGetAddress
 ***********************************************************************
 * SYNOPSIS:	Get the address of a HTTP request for connecting to 
 *              the network.
 *
 * CALLED BY:	MSG_HT_PROTOCOL_LOAD.
 * RETURN:	HTSocketAddress.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:    If a request uses a proxy, the proxy name is given higher
 *              priority. Otherwise use the hostname provided in the URI. 
 *
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 6/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
HTTPGetAddress (HTRequestHandle request, HTSocketAddress *htAddress)
{
    HTMemHandle htmh;
    HTRequest *rptr;
    word port;
    char *cptr;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    /* IP address */
    if (rptr->HTR_proxy) 
	strcpy(htAddress->HTSA_ipAddress,
	       (char *)rptr->HTR_proxyName);
    else {
	cptr = (char *) MemLock(rptr->HTR_uriString);
	htmh = HTParseURI(cptr, NULL, HTURI_PARSE_HOST);
	MemUnlock(rptr->HTR_uriString);

	/* Check that htmh is allocated! */

	cptr = (char *) HTMemLock(htmh);
	strcpy(htAddress->HTSA_ipAddress, cptr);
	HTMemUnlockAndFree(htmh);
    }

    /* Port number */
    if (rptr->HTR_proxy) 
	htAddress->HTSA_port = rptr->HTR_proxyPortNumber;
    
    else {
	cptr = (char *) MemLock(rptr->HTR_uriString);
	htmh = HTParseURI(cptr, NULL, HTURI_PARSE_PORT);
	MemUnlock(rptr->HTR_uriString);

	/* Check that htmh is allocated! */

	cptr = (char *) HTMemLock(htmh);
	port = atoi(cptr);
	HTMemUnlockAndFree(htmh);

	if (port)
	    htAddress->HTSA_port = port;
	else 
	    htAddress->HTSA_port = HTTP_PORT;
    }

    /* AccessPoint */
    htAddress->HTSA_accessPoint = rptr->HTR_accessPoint;
    
    MemThreadRelease(request);
}	/* End of HTTPGetAddress.	*/



/***********************************************************************
 *		HTTPPushRequest
 ***********************************************************************
 * SYNOPSIS:	Push request data down an input stream stack of a request.
 * CALLED BY:	MSG_HT_PROTOCOL_LOAD
 * RETURN:	HT_OK if ok, else anything else. Note that because we do 
 *              a callback to client, the callback can return any value 
 *              it wishes to the Library.
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:    If there is a client callback, we call it. Otherwise we 
 *              finish off the request headers by putting CRLF and then
 *              simply flush the input stream (MSG_HT_STREAM_FLUSH).
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/17/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTTPPushRequest (HTRequestHandle request)
{
    HTRequest *rptr;
    int status = HT_OK;
    char crlf[] = {CR, LF, '\0'};
    
EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

EC( ECCheckStream(rptr->HTR_inputStream);                               )

    /*
     * If we are NOT dealing with HTTP/0.9 request and there is a post 
     * callback, then use it. The user will provide the CRLF that terminates 
     * a request header. There is no extra headers to provide if we are 
     * communicating with HTTP/0.9.
     */
    if ((rptr->HTR_type == HTTPT_REQUEST) && 
	(rptr->HTR_version != HTTPV_0_9) &&
	(rptr->HTR_postCallback)) {
	status = ProcCallFixedOrMovable_pascal(request, rptr->HTR_inputStream,
                                              rptr->HTR_postCallback);
    }	
    /*
     * In both cases (callback or no callback), we must flush all 
     * buffered data down the stream pipe.
     */
    if (status == HT_OK)
	status = @call rptr->HTR_inputStream::MSG_HT_STREAM_FLUSH();

    MemThreadRelease(request);
    return status;
}	/* End of HTTPPushRequest.	*/




/***********************************************************************
 *		HTTPUseClientHeaderParser
 ***********************************************************************
 * SYNOPSIS:	Use client header parser if one is registered.
 * CALLED BY:	MSG_HT_PROTOCOL_LOAD
 * RETURN:	HTStreamHandle if client header parser is used, else NULL.
 * SIDE EFFECTS:Grows the request output stream stack.
 *	
 * STRATEGY:    If a client header parser is sucessfully created, the 
 *              output stream becomes:
 *              HTSocket --> HTTP (nondestructive) --> ClientHeaderParser
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/10/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTTPUseClientHeaderParser (HTRequestHandle request)
{
    HTRequest *rptr;
    HTStreamHandle stream = NullOptr;
    
EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);
    if (rptr->HTR_responseParserClass) 
	stream = HTObjInstantiateForThread(0, rptr->HTR_responseParserClass);
    MemThreadRelease(request);

    if (stream) 
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);

    return stream;
}	/* End of HTTPUseClientHeaderParser.	*/



/***********************************************************************
 *		HTTPNextState
 ***********************************************************************
 *
 * SYNOPSIS:	Determine the next state based on the response status
 *              code.
 * CALLED BY:	MSG_HT_STREAM_PUT_BLOCK
 * RETURN:	HTTPState, the next state.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Ported from W3C HTTP.c HTTPNextState. Modified by kkee.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/10/96   	Initial Revision
 *
 ***********************************************************************/
static HTTPState _pascal
HTTPNextState (HTRequestHandle request, word statusCode, char *reason)
{
    HTTPState ret;

    switch (statusCode) {

      case 0:					    /* HTTP 0.9 response */
      case 200:                                     /* OK */
	ret = HTTP_GOT_DATA;
	break;

      case 201:                                     /* Created */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_CREATED,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_GOT_DATA;
	break;

      case 202:                                     /* Accepted */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_ACCEPTED,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_GOT_DATA;
	break;

      case 203:                  /* Non-Authoritative Infomation */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_PARTIAL,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_GOT_DATA;
	break;

      case 204:			                  /* No Content */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_NO_CONTENT,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_NO_DATA;
	break;

      case 206:			                 /* Partial Content */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_PARTIAL,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_GOT_DATA;
	break;

      case 301:		    	   	       /* Moved Permanently */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_MOVED,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_PERM_REDIRECT;
	break;

      case 302:			       /* Found and Moved Temporarily */
	HTRequestAddError(request, HTERRS_INFO, FALSE, HTERR_FOUND,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_TEMP_REDIRECT;
	break;
	
      case 303:				   /* Method */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_NOT_IMPLEMENTED,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 304:					     /* Not Modified */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_NOT_MODIFIED,
			   reason,  strlen(reason),
			   "HTTPNextState");
	ret = HTTP_NOT_MODIFIED;
	break;
	
      case 400:					      /* Bad Request */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_BAD_REQUEST,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 401:                                     /* Unauthorized */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_UNAUTHORIZED,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_AA;
	break;
	
      case 402:					 /* Payment required */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_PAYMENT_REQUIRED,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;
	
      case 403:						/* Forbidden */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_FORBIDDEN,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;
	
      case 404:						/* Not Found */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_NOT_FOUND,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;
	
      case 405:				      /* Method Not Allowed */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_NOT_ALLOWED,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 406:					  /* Not Acceptable */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_NONE_ACCEPTABLE,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 407:			    /* Proxy Authentication Required */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_PROXY,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_PROXY_AUTH;
	break;

      case 408:				  /* Request Timeout */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_TIMEOUT,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 500:                            /* Internal Server Error */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_INTERNAL,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;
	
      case 501:                             /* Not Implemented */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_NOT_IMPLEMENTED,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 502:                             /* Bad Gateway */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_BAD_GATE,
		   reason,  strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;

      case 503:                               /* Service Unavailable */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_DOWN,
		   reason,  strlen(reason), "HTTPNextState");

	/* If Retry-After header is found then return HT_RETRY else HT_ERROR */
	/* if (request->retry_after)
	    ret = HTTP_RETRY;
	else */
	    ret = HTTP_ERROR;
	break;

      case 504:
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_GATE_TIMEOUT,
		   reason,  strlen(reason), "HTTPNextState");
        ret = HTTP_ERROR;
	break;

      default:						       /* bad number */
	HTRequestAddError(request, HTERRS_FATAL, FALSE, HTERR_BAD_REPLY,
		   reason, strlen(reason), "HTTPNextState");
	ret = HTTP_ERROR;
	break;
    }

    return ret;
}	/* End of HTTPNextState.	*/


/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_META_INITIALIZE for HTTPClass
 ***********************************************************************
 * SYNOPSIS:	    Initialize protocol instance data.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    Nothing
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPClass, MSG_META_INITIALIZE
{
    /* Initialize HTTP state machine to initial state */
    @self->HTTPI_currentState = HTTP_BEGIN;
    @self->HTTPI_nextState = HTTP_INVALID_STATE;

    @callsuper();
}	/* End of MSG_META_INITIALIZE.	*/




/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTTPClass
 ***********************************************************************
 * SYNOPSIS:	    Trigger an abort sequence to abort both input and
 *                  output stream pipes bound to this protocol.
 * PARAMETERS:	    void (int status)
 * SIDE EFFECTS:
 *
 * STRATEGY:        If we have asynch receive going on, stop it now.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPClass, MSG_HT_STREAM_ABORT
{
    HTRequest *rptr;

    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);

    /* Abort input stream */
    if (rptr->HTR_inputStream) 
	@call rptr->HTR_inputStream::MSG_HT_STREAM_ABORT(status);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    MemThreadRelease(@self->HTSI_request);

    if (@self->HTTPI_data) {
	HTMemFree(@self->HTTPI_data);
	@self->HTTPI_data = 0;
    }

    /* Abort output stream and self */
    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTTPClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Flush buffered data in @self->HTTPI_data and delete
 *                  the flushed data.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/29/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTTPClass, MSG_HT_STREAM_FLUSH
{
    int ret = HT_OK;

    if (@self->HTTPI_data) {
	byte *b = (byte *) HTMemLock(@self->HTTPI_data);
	ret = PUTBLOCK(@self->HTSI_target, b, @self->HTTPI_len);
	HTMemUnlockAndFree(@self->HTTPI_data);
	@self->HTTPI_data = 0;
    }

    if (ret != HT_OK) return ret;
    return @callsuper();
}	/* End of MSG_HT_STREAM_FLUSH.	*/





/***********************************************************************
 *		MSG_HTTP_STREAM_PIPE for HTTPClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Create a output stream pipe based on the response 
 *                  HTTP response.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPClass, MSG_HTTP_STREAM_PIPE
{
    HTRequest *rptr;
    char *cptr;
@ifdef PRODUCT_RESPONDER
    HTStreamHandle temp ;
@endif

    /* 
     * Always the first thing to check.
     */
    if (@self->HTSI_transparent) {

EC(	ECCheckOD(@self->HTSI_target);                                 )

	return PUTBLOCK(@self->HTSI_target, 
			(byte *) @self->HTTPI_buffer,
			@self->HTTPI_bufferLength);
    }
    
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
EC( ECCheckRequest(@self->HTSI_request);                               )

    /* 
     * We need to parse out HTTP status-line. We are interested in 
     * the status code:
     *       HTTP-Version SP Status-Code SP Reason-Phrase CRLF
     */
    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if ((cptr = strcasestr((char *)@self->HTTPI_buffer, "http/")) 
	!= NULL) {

	char *ver = cptr;
    	while (!ISWHITE(*cptr)) cptr++;      /* HTTP-Version */
	*cptr = '\0';                        /* Null-terminate it */
	cptr++;
	rptr->HTR_responseVersion = HTTPVersionEnum(ver);
	while (ISWHITE(*cptr)) cptr++;       /* Skip SP */
    
	if (ISDIGIT(*cptr)) {                /* Status-Code */
	    rptr->HTR_responseStatusCode = atoi(cptr);
	}

	while (ISWHITE(*cptr)) cptr++;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	@self->HTTPI_reason = cptr-@self->HTTPI_buffer;
	if (cptr && (cptr = strchr(cptr, LF)) != NULL)
	    *cptr = '\0';
	else if (cptr && (cptr = strchr(cptr, CR)) != NULL)
	    *cptr = '\0';

	/* 
	 * We have a HTTP/1.0 and above response here.
	 * If client does not provide a parser, 
	 * create a MIME parser and bind it as part of the 
	 * request output stream. The output stream setup is as
	 * follows: HTSocket --> HTTP --> HTMIME
	 */
	if ((@self->HTSI_target = 
	     HTTPUseClientHeaderParser(@self->HTSI_request)) == NULL) {
	    
	    HTStreamHandle s = NullOptr;

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    /*
	     * See if we can cache this data object. Note that 
	     * we only cache HTTP/1.0 & higher reponses.  If CacheWriter
	     * stream is created, we have output stream as:
	     *
             *                                     |-> HTCache
	     * HTSock -> HTTP -> HTMIME -> HTTee ->
             *                                     |-> (from content-type)
	     */
            if (HTCacheIsEnabled() && HTSessionUseCache(rptr->HTR_client)) {
		if (rptr->HTR_responseStatusCode == 200 &&
		    rptr->HTR_persistentCache && 
		    rptr->HTR_method == HTM_GET) {
		    /* Valid across sessions */
		    s = HTCacheWriterCreate(0, NullOptr,
					    @self->HTSI_request,
					    HTCACHE_INTERSESSION);
		} else {
		    /* Valid for current session only */
		    s = HTCacheWriterCreate(0, NullOptr,
					    @self->HTSI_request,
					    HTCACHE_SESSION);
		}
	    }
	    @self->HTSI_target = HTMIMECreate(@self->HTSI_request, s);
	}

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	if (!@self->HTSI_target) {
	    MemThreadRelease(@self->HTSI_request);
	    return HT_NO_CONTENT;
	}

    } else {
	/*
	 * No HTTP headers, so its HTTP/0.9 response here. Try using
	 * file extension (suffix), if not, use a guess stream.
	 */
	cptr = (char *) MemLock(rptr->HTR_uriString);
	cptr = strrchr(cptr, '.');
	if (cptr) cptr++;

	if (cptr) { /* Use suffix to create a stream */
	    /* can't lock request when calling this routine */
	    MemThreadRelease(@self->HTSI_request);
@ifdef PRODUCT_RESPONDER
	    pself = ObjDeref(oself,0);
	    temp = HTSuffixCreate(cptr, @self->HTSI_request);
	    pself = ObjDeref(oself,0);
	    @self->HTSI_target = temp ;
@else
	@self->HTSI_target = HTSuffixCreate(cptr, @self->HTSI_request);
@endif
	    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
	}

	MemUnlock(rptr->HTR_uriString);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif

	/*
	 * If client does not provide a parser, 
	 * we need a guess stream. The output stream stack is as
	 * follows: HTSocket --> HTTP --> HTGuess.
	 */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	if (!@self->HTSI_target) {
	    /* Can't lock request when calling these routines */
	    MemThreadRelease(@self->HTSI_request);
	    if ((@self->HTSI_target = 
		 HTTPUseClientHeaderParser(@self->HTSI_request)) == NULL)
		@self->HTSI_target = 
		    HTPolicyStreamStack(HT_WWW_GUESS,
					NULL,
					@self->HTSI_target,
					@self->HTSI_request,
					FALSE);
	    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
	}

    }
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    @self->HTSI_transparent = TRUE;

    /*
     * Passing pointer here, make sure HTTPNextState don't change
     * the resource of this object.
     */
    @self->HTTPI_nextState = 
	HTTPNextState(@self->HTSI_request,
		      rptr->HTR_responseStatusCode, 
		      @self->HTTPI_buffer+@self->HTTPI_reason);
    
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    MemThreadRelease(@self->HTSI_request);

    return HT_OK;
}	/* End of MSG_HTTP_STREAM_PIPE.	*/





/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTTPClass
 ***********************************************************************
 * SYNOPSIS:	    Searches for HTTP header line and use that info
 *                  to determine the output stream stack. Note that we 
 *                  modified the input data as we don't know what HTTP
 *                  version we are dealing with.
 *
 * PARAMETERS:	    int (const byte *data, word len)
 *                  - return HT_OUT_OF_MEMORY if we are of memory to 
 *                    proceed.
 *                  - return value from target stream. If all is well,
 *                    its HT_OK.
 *                  - return HT_HEADER_DONE if we have parsed out
 *                    HTTP status-line header.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Parses the http header for HTTP status-line, general 
 *                  headers, and response headers.
 *
 *                  If it is a HTTP/0.9 response, there are no headers. 
 *                  (1) If there is a filename in the URL, use the file
 *                      extension to determine the entity.
 *                  (2) If no file extension, then use a guess stream.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPClass, MSG_HT_STREAM_PUT_BLOCK
{
    int l = (int) len, status = HT_OK;

    if (!data || !len) return HT_OK;

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (@self->HTSI_transparent) 
	return PUTBLOCK(@self->HTSI_target, data, len);

    while (!@self->HTSI_transparent && l-- > 0) {

	*(@self->HTTPI_buffer+@self->HTTPI_bufferLength++) = *data;
	if (@self->HTTPI_parseState == EOL_FCR) {
	    if (*data == LF) {	/* Line found */
		if ((status = @call oself::MSG_HTTP_STREAM_PIPE())
		    == HT_OK) {
		    status = HT_HEADER_DONE;
		}
		
	    } else {
		@self->HTTPI_parseState = EOL_BEGIN;
	    }

	} else if (*data == CR) {

	    @self->HTTPI_parseState = EOL_FCR;

	} else if (*data == LF) {
	    if ((status = @call oself::MSG_HTTP_STREAM_PIPE())
		== HT_OK) {
		status = HT_HEADER_DONE;
	    }

	} else {
	    if (@self->HTTPI_bufferLength >= HTTP_MAX_STATUS_LENGTH) {
		if ((status = @call oself::MSG_HTTP_STREAM_PIPE())
		    == HT_OK) {
		    status = HT_HEADER_DONE;
		}
	    }
	}
	data++;
    }


    /* 
     * Buffer the leftover data while MSG_HT_PROTOCOL_LOAD tries
     * to decide the next action in state HTTP_CHECK_RESPONSE.
     * If necessary, buffered data is flushed using MSG_HT_STREAM_FLUSH.
     */
    if (l > 0) {
	byte *b;

EC(     if (@self->HTTPI_data) EC_ERROR(HTTP_DATA_NOT_FLUSHED);          )
        if (@self->HTTPI_data) HTMemFree(@self->HTTPI_data);

	@self->HTTPI_len = l;
	@self->HTTPI_data = HTMemAlloc(l+1);
	if (!@self->HTTPI_data) return HT_OUT_OF_MEMORY;
	b = (byte *) HTMemLock(@self->HTTPI_data);
	memcpy(b, data, l);
	HTMemUnlock(@self->HTTPI_data);
    }
    return status;

}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/




/***********************************************************************
 *		MSG_HT_PROTOCOL_LOAD for HTTPClass
 ***********************************************************************
 * SYNOPSIS:	    Load data object. This is a state-based implementation
 *		    of the HTTP protocol. 
 * PARAMETERS:	    int (HTNetThread *net)
 *                  - return HT_OK if all is well and want to be 
 *                    rescheduled.
 *                  - return HT_ASYNCH_LOAD if HTTP is going into asynch
 *                    mode and does not need to be scheduled until
 *                    status is updated using HTNetThreadUpdateStatus.
 *                  - return HT_OUT_OF_MEMORY if we failed allocate 
 *                    stream objects.
 *                  - return HT_CANNOT_CONNECT if failed to connect to 
 *                    server.
 *                  - return HT_CANNOT_RESOLVE_HOST_NAME if hostName or
 *                    proxy name is bad.
 *                  - return HT_LINK_FAILED if some hardware or configuration
 *                    prevents use of socket.
 *                  - return HT_KILL_AND_RESUBMIT_INTERNALLY if the request
 *                    were to be resubmitted internally.
 *                  - return HT_ERROR if an unrecoverable has occurred.
 * SIDE EFFECTS:    
 * STRATEGY:	    Implement the HTTP protocol in a state-based fashion. 
 *                  This means that this handler exits after a stable state 
 *		    is reached, and then reenter later to resume execution
 *   		    from the previous state.
 *
 *                  If we return anything other than HT_OK, the protocol
 *                  will be terminated. So we must intercept all problems
 *                  that arise from pushing data to the socket or reading
 *                  data from the socket and perform the appropriate 
 *                  actions to recover.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPClass, MSG_HT_PROTOCOL_LOAD
{
#define MYRETURN(code) {if (code!=HT_OK && code!=HT_LOADED)\
			    {net->HTNT_persistent=FALSE;\
				 return code;}\
                        else return code;}
    int ret;
    HTRequest *rptr;

EC( if (@self->HTSI_request == NULL) EC_ERROR(HTTP_REQUEST_NOT_SET);    )

    /* 
     * Now jump into the machine. We know the state from the previous run.
     * This is one big switch loop.
     */
    while (1) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	switch (@self->HTTPI_currentState) {

	case HTTP_BEGIN:
	    {
		HTStreamHandle stream;

		/* Create and initialize a HTStreamSocket */
                stream = HTStreamSocketCreate(@self->HTSI_request);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif	
                @self->HTPI_streamSocket = stream;
		if (!@self->HTPI_streamSocket) {
		    MYRETURN(HT_OUT_OF_MEMORY);
		}

		if (net->HTNT_persistent) {
		    @self->HTTPI_currentState = HTTP_PERSISTENT_BEGIN;
		} else {
		    @self->HTTPI_currentState = HTTP_NONPERSISTENT_BEGIN;
		} 
	    }
	    break;

	case HTTP_PERSISTENT_BEGIN:
	    {
		/* Make sure the socket is still connected */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		@call @self->HTPI_streamSocket::
		    MSG_HTSOCKET_INITIALIZE(net->HTNT_socket);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		if (HTSocketIsConnected(net->HTNT_socket) == HT_OK) {
		    @self->HTTPI_currentState = HTTP_NEED_REQUEST;
		} else {
		    /* Must close socket before reconnect */
		    HTSocketClose(net->HTNT_socket);
		    HTNetSetPersistent(net, FALSE);
		    @self->HTTPI_currentState = HTTP_NEED_CONNECTION;
		}
	    }
	    break;

	case HTTP_NONPERSISTENT_BEGIN:
	    {
		/* SSL stuff */
#ifdef SSL_ENABLE
		Boolean secure;
		rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
		secure = (strncmp(MemLock(rptr->HTR_uriString), "https:", 6) == 0);
		MemUnlock(rptr->HTR_uriString);
		MemThreadRelease(@self->HTSI_request);
#endif
		/* Create and initialize a HTStreamSocket */
#ifdef SSL_ENABLE
		net->HTNT_socket = HTSocketCreate(net, secure);
#else
		net->HTNT_socket = HTSocketCreate(net);
#endif
		if (!net->HTNT_socket) {
		    MYRETURN(HT_OUT_OF_MEMORY);
		}

		/* Initialize the stream socket to handle a HTSocket */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		@call @self->HTPI_streamSocket::
		    MSG_HTSOCKET_INITIALIZE(net->HTNT_socket);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
                @self->HTTPI_currentState = HTTP_NEED_CONNECTION;
	    }

	    break;

	case HTTP_NEED_CONNECTION:
	    /* 
	     * Nonblocking resolve & connect now and check socket state 
	     * later. 
	     */
	    {
		HTSocketAddress address;

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		HTTPGetAddress(@self->HTSI_request, &address);

		/* Inform client what we are going to do next. */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		if (HTSocketResolveAndConnect(net->HTNT_socket, 
					      &address) == HT_OK) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		    @self->HTTPI_currentState = HTTP_NEED_REQUEST;

		} else {
		    /* 
		     * If we failed to connect, retry? Let's make it
		     * simple here...
		     */
		    MYRETURN(HTSocketState(net->HTNT_socket));
		}
	    }

	    break;

	case HTTP_NEED_REQUEST:
	    {
		Boolean reqEndHeader, entityEndHeader;
		HTStreamHandle stream;

		/* 
		 * Decide on who is suppose to end the headers. Headers
		 * are ended using a line with only CRLF. Only one of
		 * the following booleans is TRUE.
		 */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);

		reqEndHeader = (!rptr->HTR_postCallback && !rptr->HTR_data);
		entityEndHeader = (!rptr->HTR_postCallback && rptr->HTR_data);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		MemThreadRelease(@self->HTSI_request);

		/* 
		 * HTSocket is the FIRST stream object in both input and 
		 * output stream stacks; it is used for reading by input 
		 * stream stack and for writing by output stream stack.
		 */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		HTStreamGrowInputStreamStack(@self->HTSI_request,
					     @self->HTPI_streamSocket);

		/*
		 * Create HTTP general headers generator, HTTP request
		 * headers generator, and HTTP entity headers and bind it to 
		 * the input stream stack.
		 *
		 * HTSocket <-- HTTPGen (general headers)  
		 *   <-- HTTPReq (request headers) 
		 *   <-- HTMIMERq (entity headers)
		 */

		/*
		 * stream = HTTPGenNew(@self->HTSI_request, genEndHeader);
		 * if (!stream) MYRETURN(HT_OUT_OF_MEMORY);
		 * HTStreamGrowInputStreamStack(@self->HTSI_request, stream);
		 */
		
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		stream = HTTPReqNew(net, reqEndHeader);
		if (!stream) {
		    MYRETURN(HT_OUT_OF_MEMORY);
		}
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		HTStreamGrowInputStreamStack(@self->HTSI_request, stream);
	    
		if (entityEndHeader) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		    stream = HTMIMERqNew(@self->HTSI_request, entityEndHeader);
		    if (!stream) {
			MYRETURN(HT_OUT_OF_MEMORY);
		    }
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		    HTStreamGrowInputStreamStack(@self->HTSI_request, stream);
		}

		/*
		 * Push request data to network using the input stream stack.
		 */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
                if ((ret = HTTPPushRequest(@self->HTSI_request)) != HT_OK) {
		    MYRETURN(ret);
		}
	    
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	        @self->HTTPI_currentState = HTTP_CHECK_RESPONSE;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	        @self->HTTPI_parseState = EOL_BEGIN;

		/* Inform client what we are going to do next. */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	        ret = HTNetReportProgress(@self->HTSI_request, 
					  HT_WAITING_FOR_REPLY);
	        if (ret != HT_OK) {
		    MYRETURN(ret);
		}
	    }
	    break;

	case HTTP_CHECK_RESPONSE:
	    /* 
	     * Push data from network using the output stream stack until
	     * we have enough info to decide what to do next (i.e., the 
	     * next state). Check response buffers data which, if needed,
	     * must be flushed before we continue to push data from socket.
	     * htSocket -> HTTP.
	     */
	    if (!HTSocketRecv(net->HTNT_socket, 60)) {
		ret = HTSocketState(net->HTNT_socket);
		if (ret != HT_OK) {
		    MYRETURN(ret);
		}
		break;
	    }

	    /*
	     * Inspect response header and then set next state. Also buffers
	     * data here!
	     */
	    ret = HTSocketPush(oself, net->HTNT_socket);
	    /* Done parsing HTTP status line ? */
	    if (ret == HT_HEADER_DONE) {
@ifdef PRODUCT_RESPONDER
                pself = ObjDeref(oself,0);
@endif
	        @self->HTTPI_currentState = @self->HTTPI_nextState;
            } else if (ret != HT_OK) {
		MYRETURN(ret);
	    }
	    break;

	case HTTP_GOT_DATA:
	    /*
	     * Push data to target until there is no more data, or
	     * some error occurs. Don't forget to flush buffered data.
	     */
            /* 
	     * We want to make sure that HT_LOADING_DATA is
	     * called before flushing buffered data that would
	     * end up creating client streams (like image/gif
	     * converter). And if we flush data before calling
	     * HT_LOADING_DATA, the UI tree would be created and 
	     * later deleted when we call HT_LOADING_DATA, thus
	     * no UI to display data!
	     */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
            ret = HTNetReportProgress(@self->HTSI_request, 
				      HT_LOADING_DATA);
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    ret = @call oself::MSG_HT_STREAM_FLUSH();
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }
		
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    @self->HTTPI_currentState = HTTP_STREAM_ALL_DATA;
	    @self->HTTPI_streamDataRet = HT_OK;

	    break;

	case HTTP_PERM_REDIRECT:
	case HTTP_TEMP_REDIRECT:
	    /*
	     * Client should reissue the request where the 
	     * submitted URL has been replaced with a new one.
	     * The new URL is in MIME headers, so we need to 
	     * flush buffered data to MIME to change that URL.
	     */
	    ret = @call oself::MSG_HT_STREAM_FLUSH();
	    if (ret != HT_OK) {
		Boolean redirected;
		rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
		redirected = rptr->HTR_uriRedirected;
		MemThreadRelease(@self->HTSI_request);
		if (redirected) {
		    MYRETURN(HT_DOCUMENT_MOVED);
		} else {
		    MYRETURN(ret);
		}
	    }
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    @self->HTTPI_currentState = HTTP_STREAM_ALL_DATA;
	    @self->HTTPI_streamDataRet = HT_DOCUMENT_MOVED;
	    break;

	case HTTP_AA:
	    /*
	     * Needs authorization from client.
	     * First delete old authorization for this URL,
	     * and then ask for a new one.
	     */
	    /* Actually, should I assume basic auth? */
	    HTAASetBasicUserIDPassword(@self->HTSI_request, NULL, NULL);
            ret = HTNetReportProgress(@self->HTSI_request, 
				      HT_NEEDS_AA);
	    
	    if (ret == HT_OK) {
		/* Try authenticating again */
		MYRETURN(HT_KILL_AND_RESUBMIT_INTERNALLY);
	    }

	    /* 
	     * UNAUTHORIZED, but client needs whatever data is 
	     * provided by the server (e.g., to show to the user).
	     */
            /* 
	     * We want to make sure that HT_LOADING_DATA is
	     * called before flushing buffered data that would
	     * end up creating client streams (like image/gif
	     * converter). And if we flush data before calling
	     * HT_LOADING_DATA, the UI tree would be created and 
	     * later deleted when we call HT_LOADING_DATA, thus
	     * no UI to display data!
	     */
            ret = HTNetReportProgress(@self->HTSI_request, 
				      HT_LOADING_DATA);
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    ret = @call oself::MSG_HT_STREAM_FLUSH();
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    @self->HTTPI_currentState = HTTP_STREAM_ALL_DATA;
	    @self->HTTPI_streamDataRet = HT_UNAUTHORIZED;

	    break;

	case HTTP_PROXY_AUTH:
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
            /* 
	     * We want to make sure that HT_LOADING_DATA is
	     * called before flushing buffered data that would
	     * end up creating client streams (like image/gif
	     * converter). And if we flush data before calling
	     * HT_LOADING_DATA, the UI tree would be created and 
	     * later deleted when we call HT_LOADING_DATA, thus
	     * no UI to display data!
	     */
            ret = HTNetReportProgress(@self->HTSI_request, 
				      HT_LOADING_DATA);
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

	    /* Load whatever error data is there for display */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    ret = @call oself::MSG_HT_STREAM_FLUSH();
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    @self->HTTPI_currentState = HTTP_STREAM_ALL_DATA;
	    @self->HTTPI_streamDataRet = HT_PROXY_UNAUTHORIZED;
	    break;
	    
	case HTTP_NOT_MODIFIED:
	    /* Use unmodified cached copy, do not force reload */
	    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
	    rptr->HTR_reloadMode = HTRELOAD_ANY_VERSION;
	    HTAnchorSetHeaderDone(rptr->HTR_anchor);
	    MemThreadRelease(@self->HTSI_request);
	    MYRETURN(HT_KILL_AND_RESUBMIT_INTERNALLY);

	case HTTP_ERROR: 
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
            /* 
	     * We want to make sure that HT_LOADING_DATA is
	     * called before flushing buffered data that would
	     * end up creating client streams (like image/gif
	     * converter). And if we flush data before calling
	     * HT_LOADING_DATA, the UI tree would be created and 
	     * later deleted when we call HT_LOADING_DATA, thus
	     * no UI to display data!
	     */
            ret = HTNetReportProgress(@self->HTSI_request, 
				      HT_LOADING_DATA);
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

	    /* Load whatever error data is there for display */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    ret = @call oself::MSG_HT_STREAM_FLUSH();
	    if (ret != HT_OK) {
		MYRETURN(ret);
	    }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	    @self->HTTPI_currentState = HTTP_STREAM_ERROR_DATA;
	    @self->HTTPI_streamDataRet = HT_LOADED;
	    break;

	case HTTP_STREAM_ALL_DATA:
	    /*
	     * The return code must be provided in @self->HTTPI_streamDataRet.
	     * If it is HT_OK, then return code from streaming data is used.
	     */
	    if (HTSocketRecv(net->HTNT_socket, 60)) {
		ret = HTSocketPush(oself, net->HTNT_socket);
	    } else {
		ret = HTSocketState(net->HTNT_socket);
	    }

	    if (ret != HT_OK) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
		if (@self->HTTPI_streamDataRet == HT_OK) {
		    MYRETURN(ret);
		} else if (@self->HTTPI_streamDataRet ==
			   HT_DOCUMENT_MOVED) {
		    Boolean redirected;
		    rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
		    redirected = rptr->HTR_uriRedirected;
		    MemThreadRelease(@self->HTSI_request);
		    if (redirected) {
			MYRETURN(HT_DOCUMENT_MOVED);
		    } else {
			MYRETURN(ret);
		    }
		} else {
		    MYRETURN(@self->HTTPI_streamDataRet);
		}
	    }
	    break;

	case HTTP_STREAM_ERROR_DATA:
	    /* 
	     * If there is an entity-body, then the body data is streamed
	     * to target, else generate error data from HTTP status line.
	     */
	    if (!HTSocketRecv(net->HTNT_socket, 60)) {
		int state;
		state = HTSocketState(net->HTNT_socket);
		if (state == HT_LOADED) {
		    /* If no entity body, generate an error message */
		    HTRequest *rptr = MemThreadGrab(@self->HTSI_request);
		    Boolean noBody = (rptr->HTR_bytesRead == 0 ? TRUE : FALSE);
		    MemThreadRelease(@self->HTSI_request);

		    if (noBody) {
			char crlf2[] = {CR, LF, CR, LF, '\0'};
			char str[128];
			PUTBLOCK(oself, (byte*)crlf2, 4);  /* end headers */
			strcpy(str, "<HTML>");
			@self->HTTPI_buffer[@self->HTTPI_reason-1]=' ';
			strncat(str, @self->HTTPI_buffer, 100);
			strcat(str, "</HTML>");
			PUTBLOCK(oself, (byte*)str, strlen(str));
		    }
		    MYRETURN(HT_LOADED);
		} else {
		    /* Come back later or done */
		    MYRETURN(state);
		}
	    }

	    ret = HTSocketPush(oself, net->HTNT_socket);
	    if (ret != HT_OK) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
                MYRETURN(@self->HTTPI_streamDataRet);
	    }
	    MYRETURN(HT_OK);

	case HTTP_NO_DATA:
	    MYRETURN(HT_NO);
	    break;

	default:

EC(         EC_ERROR(HTTP_STATE_NOT_HANDLED);                           )

	    MYRETURN(HT_ERROR);
	}
    }
}	/* End of MSG_HT_PROTOCOL_LOAD.	*/



