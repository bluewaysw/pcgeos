/***********************************************************************
 *		MSG_GEN_IMAGE_MARK_INPUT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Mark the object <INPUT type=image>
 * PARAMETERS:	    (optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/30/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_MARK_INPUT
{
  word br;

  @self->HTGI_input = TRUE;
  @self->HTGI_content = content;
  @self->HTGI_name = nameOptr;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGI_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGI_noBr = br;
  /*
   *  No focus on it initially.
   */
  @self->HTGI_focalAnchor = -1;
  return;
}	/* End of MSG_GEN_IMAGE_MARK_INPUT.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_SUBMIT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Submitting name/value pair.  It's <INPUT type=image>.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/30/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_SUBMIT
{
  HTMemHandle temp1, temp2;
  char temp[5];

  if (@self->HTGI_input == TRUE && @self->HTGI_name) {
    /*
     *  Append the "name.x"
     */
    temp1 = HTStrHTMemAllocCopyWID(0, @self->HTGI_name);
    temp1 = HTStrAllocCatWID(0, temp1, ".x");
    HTListAppend(query, &temp1, sizeof(HTMemHandle));
    /*
     *  Append the x value
     */
    EC_ERROR_IF(@self->HTGI_input_x > 99999, 1);
    VisTextFormatNumber(temp, @self->HTGI_input_x, VTNT_NUMBER);
    temp2 = HTStrAllocCopyWID(0, temp);
    HTListAppend(query, &temp2, sizeof(HTMemHandle));
    /*
     *  Append the "name.y"
     */
    temp1 = HTStrHTMemAllocCopyWID(0, @self->HTGI_name);
    temp1 = HTStrAllocCatWID(0, temp1, ".y");
    HTListAppend(query, &temp1, sizeof(HTMemHandle));
    /*
     *  Append the y value
     */
    EC_ERROR_IF(@self->HTGI_input_y > 99999, 1);
    VisTextFormatNumber(temp, @self->HTGI_input_y, VTNT_NUMBER);
    temp2 = HTStrAllocCopyWID(0, temp);
    HTListAppend(query, &temp2, sizeof(HTMemHandle));

    /*
     *  Clear the field.
     */
    @self->HTGI_input_x = 0;
    @self->HTGI_input_y = 0;
  }
  return;
}	/* End of MSG_GEN_IMAGE_SUBMIT.	*/


