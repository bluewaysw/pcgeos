/***********************************************************************
 *		MSG_GEN_IMAGE_UPDATE_FOCAL_BOUND for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    The image position might have moved due to the
 *                  expansion from the icon to full image.  Thus,
 *                  we need to update its focal bounds if it has the
 *                  navigation focus.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	7/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_UPDATE_FOCAL_BOUND
{
  VisInstance *vself;

  if (@self->HTGI_focalAnchor != -1 && 
      (@self->HTGI_hrefToken != -1 || @self->HTGI_input == TRUE)) {
    vself = ObjDerefVis(oself);
    @self->HTGI_focalBound.RD_left = vself->VI_bounds.R_left - 1;
    @self->HTGI_focalBound.RD_top = vself->VI_bounds.R_top - 2;
    /*
     *  Image has a link and is currently having the navigation focus.
     *  So we need to update the bounds of the navigation focus.
     */
    if (@self->HTGI_width && @self->HTGI_height) {
	/*
	 *  Image were sucessfully downloaded.
	 */
	@self->HTGI_focalBound.RD_right =
	    @self->HTGI_focalBound.RD_left + @self->HTGI_width + 2;
	@self->HTGI_focalBound.RD_bottom =
	    @self->HTGI_focalBound.RD_top + @self->HTGI_height + MARGIN;
    }
    else {
	/*
	 *  Image weren't successfully downloaded.  Keep the icon size.
	 */
	@self->HTGI_focalBound.RD_right = vself->VI_bounds.R_right + 1;
	@self->HTGI_focalBound.RD_bottom = vself->VI_bounds.R_bottom + 1;
    }
    @call currentDoc->HTUI_pmanager::MSG_PM_UPDATE_FOCUS(@self->HTGI_focalBound);
  }
  else {
    /*
     *  Image has either no link or have no navigation focus.  In either
     *  case, when the image expands, it should be unable to get the
     *  navigation focus bound.
     */
    @self->HTGI_focalBound.RD_left = @self->HTGI_focalBound.RD_right = 
    @self->HTGI_focalBound.RD_top = @self->HTGI_focalBound.RD_bottom = NULL;
    if (@self->HTGI_focalAnchor != -1)
	@call currentDoc->HTUI_pmanager::MSG_PM_UPDATE_FOCUS(@self->HTGI_focalBound);
  }
  return;
}	/* End of MSG_GEN_IMAGE_UPDATE_FOCAL_BOUND.	*/


/***********************************************************************
 *		MSG_META_DETACH for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    when destroy the image, clean its bitmap.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	2/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_DESTROY
{
    if (@self->HTGI_bitmapFile && @self->HTGI_bitmapBlock)
	HugeArrayDestroy(@self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    if (@self->HTGI_src)
	HTMemFree(@self->HTGI_src);
    
    if (@self->HTGI_name)
	HTMemFree(@self->HTGI_name);

    if (@self->HTGI_alt)
	HTMemFree(@self->HTGI_alt);

    if (@self->HTGI_usemap)
	HTMemFree(@self->HTGI_usemap);

    @callsuper();
}	/* End of MSG_META_DETACH.	*/

@start BmpData;
@ifndef	BROTHER_KERNEL
@include "Art/ImageIconBitmap.goh"
@endif
@end BmpData;


/***********************************************************************
 *		MSG_VIS_DRAW for HTGenImageClass
 ***********************************************************************
 * SYNOPSIS:	    Draw the image object.
 * PARAMETERS:	    void (DrawFlags drawFlags, 
 *			  GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_VIS_DRAW
{
  Rectangle bounds;
  Bitmap *bmp;
  char *alt;

  GrSaveState(gstate);

  @call self::MSG_VIS_GET_BOUNDS(&bounds);

  /*
   * if the image been loaded, draw the real image
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if(@self->HTGI_load) {
      if(@self->HTGI_bitmapFile && @self->HTGI_bitmapBlock) {
	  GrDrawHugeBitmap(gstate, bounds.R_left, bounds.R_top,
		       @self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);
      }
      else {
	  /*
	   * draw the small icon and alt text
	   */
@ifndef	BROTHER_KERNEL
	  MemLock(OptrToHandle(@ImageIcon));
	  bmp = LMemDeref(@ImageIcon);
	  GrDrawBitmap(gstate, bounds.R_left, bounds.R_top-1, bmp, 0);
	  MemUnlock(OptrToHandle(@ImageIcon));
@endif
	  
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	  if(@self->HTGI_alt) {
	      alt = HTMemLock(@self->HTGI_alt);
	      GrDrawText(gstate, bounds.R_left + 30, bounds.R_top + 13,
		     alt, strlen(alt));
	      HTMemUnlock(@self->HTGI_alt);
	  }
      }
  } else {
      /*
       * else just draw a small icon
       */
@ifndef	BROTHER_KERNEL
      MemLock(OptrToHandle(@ImageIcon));
      bmp = LMemDeref(@ImageIcon);
      GrDrawBitmap(gstate, bounds.R_left, bounds.R_top-1, bmp, 0);
      MemUnlock(OptrToHandle(@ImageIcon));
@endif
  }

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
  if (@self->HTGI_focalAnchor != -1) {
      /*
       *  Draw the focus outline if it currently has the navigation focus
       */
      GrSetLineMaskCustom(gstate, (const unsigned char (*)[8])customMask);
      GrDrawRect(gstate, @self->HTGI_focalBound.RD_left, 
		 @self->HTGI_focalBound.RD_top,
		 @self->HTGI_focalBound.RD_right, 
		 @self->HTGI_focalBound.RD_bottom);
      GrSetLineMaskSys(gstate, SDM_100);
  }
  /*
   *  Draw thick border that is distinct from the focus box.
   *  If the image has a link and the BORDER attribute, BORDER attribute
   *  will be ignored.  When such an image receives focus, it will have
   *  both link border the focus box.
   */
  if ((@self->HTGI_border == TRUE && @self->HTGI_load) ||
      @self->HTGI_hrefToken != -1) {
      /*
       *  Draw a border.
       */
      GrSetLineWidth(gstate, MakeWWFixed(2));
      GrDrawRect(gstate,  bounds.R_left + 1, bounds.R_top, 
		 bounds.R_right, bounds.R_bottom);
  }
  GrRestoreState(gstate);

  return;
}	/* End of MSG_VIS_DRAW.	*/



@method HTGenImageClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;

  if (@self->HTGI_load==FALSE || (!@self->HTGI_width && !@self->HTGI_height))
      size = MAKE_SIZE_DWORD(IMAGE_DEFAULT_SIZE, IMAGE_DEFAULT_SIZE);
  else if (@self->HTGI_width && @self->HTGI_height)
      size = MAKE_SIZE_DWORD(@self->HTGI_width,@self->HTGI_height);
  else if (@self->HTGI_width)
      size = MAKE_SIZE_DWORD(@self->HTGI_width,@self->HTGI_width);
  else /* if (@self->HTGI_height) */
      size = MAKE_SIZE_DWORD(@self->HTGI_height, @self->HTGI_height);

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  VisInstance * vself;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGI_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGI_xPos;
  }
  else {
    lineWidth = @call @self->HTGI_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGI_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTGI_xPos;
    else if (@self->HTGI_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGI_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGI_xPos);
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
      (@self->HTGI_content, @self->HTGI_pageRow, oself);
  @callsuper();

  if (@self->HTGI_focalAnchor != -1)
      @call self::MSG_GEN_IMAGE_UPDATE_FOCAL_BOUND();
  vself = ObjDerefVis(oself);
  vself->VI_attrs |= VA_DRAWABLE;

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  VisInstance * vself;
  SizeAsDWord size;
  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;
  vself->VI_attrs &= ~VA_DRAWABLE;
  /*
   *  Get an estimated position of the object
   */
  pos = UpdateItsPotentialPosition(oself, @self->HTGI_content, &row, &size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGI_xPos = pos;
  @self->HTGI_pageRow = row;
  @self->HTGI_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


