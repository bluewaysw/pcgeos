/***********************************************************************
 *		UIGen_CREATE_IMAGE_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an image object to render an image file.
 * PARAMETERS:	    (MemHandle block, SGML *entity, Boolean load)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 8/96   	Initial Revision
 *
 ***********************************************************************/
optr UIGen_CREATE_IMAGE_Int
		(MemHandle block, SGMLEntity *entity, Boolean load)
{
  optr content;
  optr dummy;

  content = currentDoc->HTUI_pmContent;
  /* 
   *  Deal away the current target object.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass ||
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass ||
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormClass) {
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
		(currentDoc->HTUI_target.obj);
    content = currentDoc->HTUI_target.obj;
  }
  else if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenSelectClass ||
	   currentDoc->HTUI_target.class == (ClassStruct *)&HTGenOuterSelectClass||
	   currentDoc->HTUI_target.class == (ClassStruct *)&HTGenOptionClass) {
    EC_ERROR(1);
    return UI_GEN_ERROR;
  }
  else if (currentDoc->HTUI_target.obj) {
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ \
	(currentDoc->HTUI_target.obj);
    content = UIGen_GET_CONTENT_Int();
  }
  /*
   *  Now create an image object and store it in target.obj.  Next, 
   *  process the passed attribute list.
   */
  dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenImageClass);

  @call dummy::MSG_GEN_IMAGE_PROCESS_ATTRIBUTE(block, entity, load, content);

  @call dummy::MSG_META_SET_OBJ_BLOCK_OUTPUT(currentDoc->HTUI_pmanager);
  /*
   *  Set hyperlink on it if the current content has <A>...</A>
   */
  if (currentDoc->HTUI_hrefToken != -1) {
    @call dummy::MSG_GEN_IMAGE_SET_HYPERLINK(currentDoc->HTUI_hrefToken);
  }

  /*
   *  Done with the image object
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
  @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));

  if (currentDoc->HTUI_target.obj == currentDoc->HTUI_pmanager) {
	currentDoc->HTUI_target.obj = NULL;
	currentDoc->HTUI_target.class = NULL;
  }
  /*
   *  Add the object to the list of focusable objects.
   */
  if (currentDoc->HTUI_hrefToken != -1 || load == FALSE)
      @send currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);

  return dummy;
}	/* End of UIGen_CREATE_IMAGE_Int.	*/



/***********************************************************************
 *		UIGen_CREATE_SINGLE_IMAGE_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    create a single image object
 * PARAMETERS:	    nothing
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/28/97   	Initial Revision
 *
 ***********************************************************************/
optr UIGen_CREATE_SINGLE_IMAGE_Int()
{
  optr dummy;

  dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenImageClass);

  @call dummy::MSG_GEN_IMAGE_STORE_CONTENT(currentDoc->HTUI_pmContent);
  @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);

  return dummy;
}	/* End of UIGen_CREATE_SINGLE_IMAGE_Int.	*/



/***********************************************************************
 *		MSG_GEN_IMAGE_SET_BOUNDS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word width, word height
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/28/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_SET_BOUNDS
{
  dword memSize, memNeeded;
  word right, bottom;
  /*
   *  If the actual image size is smaller than the specified size in the
   *  html source, the actual image size should be stretched to the 
   *  specified size.
   */
  @self->HTGI_width = width;
  @self->HTGI_height= height;

  @call self::MSG_VIS_SET_SIZE(width, height);

  memNeeded = width * height / 8;
  if (memNeeded > 119) {
    memNeeded -= 119;
    UIDocAddMemory(memNeeded);
  }
  memSize = UIDocMemoryNeeded(currentDoc->HTUI_myHandle, &right, &bottom);
  if (memSize>MEMORY_THRESHOLD || bottom>=MAX_COORD || right>=MAX_COORD) {
      EC_WARNING(1);
      return UI_GEN_ERROR;
  }
#if 0
  /*
   *  If the attribute already says the definite width and height, 
   *  force the size.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (!@self->HTGI_width)
      @self->HTGI_width = width;
  if (!@self->HTGI_height)
      @self->HTGI_height= height;
  /*
   *  Should be removed!!!!
   */
  @call self::MSG_VIS_SET_SIZE(@self->HTGI_width, @self->HTGI_height);
#endif
  return UI_GEN_NO_ERROR;
}	/* End of MSG_GEN_IMAGE_SET_BOUNDS.	*/



