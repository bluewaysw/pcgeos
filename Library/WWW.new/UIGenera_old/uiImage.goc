/***********************************************************************
 *		MSG_META_START_SELECT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	Pass the mouse coordinates to the server.    
 * PARAMETERS:	void (MouseReturnParams *retVal,
 *		      sword xPosition, sword yPosition,
 *		      word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_META_START_SELECT
{
  Rectangle bound;
  int rel_x, rel_y, count, i;
  char *name, *name2;
  MapItem *mapItem;
  HTMemHandle map;
  EventHandle msg;

  @callsuper();
  if (!(GET_BUTTON_INFO(inputState) & BI_PRESS))
    return;
  /*
   *  Find the mouse position relative to the (left, top) of the image.
   */
  @call self::MSG_VIS_GET_BOUNDS(&bound);
  rel_x = xPosition - bound.R_left;
  rel_y = yPosition - bound.R_top;
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGI_usemap) {
      /*
       *  If there is a usemap, find the right map item from the usemap 
       *  list and find get the area item in that map item.
       */
      if ((count = HTListGetCount(currentDoc->HTUI_areaMaps)) > 0) {
	name2=(char*)HTMemLock(@self->HTGI_usemap);
        for (i = 0; i < count; i++) {
	  HTListGetItem(currentDoc->HTUI_areaMaps, i, &map, sizeof(HTMemHandle));
	  mapItem = (MapItem *)HTMemLock(map);
	  name=(char*)HTMemLock(mapItem->MI_mapName);
	  if (strcmp(name, name2+1) == 0) {
	    /*
	     *  Found the right <MAP> item.  See which <AREA> item that
	     *  the mouse event falls into.
	     */
	    FigureDestinationForMouseEvent
		(mapItem->MI_areas, rel_x, rel_y, currentDoc->HTUI_pmanager, oself);
	    HTMemUnlock(mapItem->MI_mapName);
	    HTMemUnlock(map);
	    break;
	  }
	  else {
	    HTMemUnlock(mapItem->MI_mapName);
	    HTMemUnlock(map);
	  }
	}
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	HTMemUnlock(@self->HTGI_usemap);
      }
  }
  else if (@self->HTGI_ismap == TRUE && @self->HTGI_hrefToken > -1) {
    /*  There is a href Token on this image */
    currentDoc->HTUI_pmanager = @call self::MSG_META_GET_OBJ_BLOCK_OUTPUT();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @call currentDoc->HTUI_pmanager::MSG_PM_REFER_ISMAP_LINK(rel_x,rel_y,@self->HTGI_hrefToken);
  }
  else if (@self->HTGI_hrefToken != -1) {
    /*  There is a href Token on this image */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @call currentDoc->HTUI_pmanager::MSG_PM_REFER_HYPERLINK(@self->HTGI_hrefToken);
  }
  else if (@self->HTGI_input == TRUE) {
    @self->HTGI_input_x = rel_x;
    @self->HTGI_input_y = rel_y;
    msg = @record HTGenFormClass::MSG_GEN_FORM_SUBMIT(0);
    @send self::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
  }
  else if (@self->HTGI_load == FALSE) {
    Rectangle box;
    bound.R_left -= 1;
    bound.R_top -= 2;
    bound.R_right += 1;
    bound.R_bottom += 1;
    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    @send currentDoc->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
      (oself, bound, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
  }
  else if (@self->HTGI_hrefToken == -1) {
    /*  There is no href Token on this image */
    currentDoc->HTUI_pmanager = @call self::MSG_META_GET_OBJ_BLOCK_OUTPUT();
    @call currentDoc->HTUI_pmanager::MSG_PM_CLEAR_HREF_LINK();
  }
  retVal->flags = MRF_PROCESSED;
  return;
}	/* End of MSG_META_START_SELECT.	*/



/***********************************************************************
 *		MSG_META_PTR for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_META_PTR
{
  Rectangle bound;
  Boolean found = FALSE;
  char *name, *name2;
  MapItem *mapItem;
  HTMemHandle map;
  int rel_x, rel_y, i, count;


  @callsuper();

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGI_usemap) {
    /*
     *  If there is a usemap, find the right map item from the usemap 
     *  list and find get the area item in that map item.
     */
    if ((count = HTListGetCount(currentDoc->HTUI_areaMaps)) > 0) {
      @call self::MSG_VIS_GET_BOUNDS(&bound);
      rel_x = xPosition - bound.R_left;
      rel_y = yPosition - bound.R_top;
      /*
       *  Get an element and lock down its block.
       */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      name2 = (char*)HTMemLock(@self->HTGI_usemap);
      for (i = 0; i < count; i++) {
	HTListGetItem(currentDoc->HTUI_areaMaps, i, &map, sizeof(HTMemHandle));
	mapItem = (MapItem *)HTMemLock(map);
	name=(char *)HTMemLock(mapItem->MI_mapName);
	if (strcmp(name, name2+1) == 0) {
	  /*
	   *  Found the right <MAP> item.  See which <AREA> item that
	   *  the mouse event falls into.
	   */
	  found = FigureDestinationForMouseEvent
	    (mapItem->MI_areas, rel_x, rel_y, NULL, oself);
	  HTMemUnlock(mapItem->MI_mapName);
	  HTMemUnlock(map);
	  break;
	}
	else {
	  HTMemUnlock(mapItem->MI_mapName);
	  HTMemUnlock(map);
	}
      }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      HTMemUnlock(@self->HTGI_usemap);
    }
  }
  else if (@self->HTGI_hrefToken != -1 || @self->HTGI_input == TRUE) {
    found = TRUE;
  }

  if (found == TRUE) {
    /*  There is a href Token on this image */
    retVal->ptrImage = @BoxCursor;
    /* this event processed */
    retVal->flags = MRF_PROCESSED | MRF_SET_POINTER_IMAGE;
  }
  else
    retVal->flags = MRF_PROCESSED | MRF_CLEAR_POINTER_IMAGE;
  return;
}	/* End of MSG_META_PTR.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenImageClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    if (@self->HTGI_bitmapFile && @self->HTGI_bitmapBlock)
	HugeArrayDestroy(@self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);

    /* 
     * These would be destroyed when we delete the blocks using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGI_src)
     *   HTMemFree(@self->HTGI_src);
     * 
     * if (@self->HTGI_name)
     *   HTMemFree(@self->HTGI_name);
     * 
     * if (@self->HTGI_alt)
     *   HTMemFree(@self->HTGI_alt);
     * 
     * if (@self->HTGI_usemap)
     *   HTMemFree(@self->HTGI_usemap);
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/


/***********************************************************************
 *		MSG_META_KBD_CHAR for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Allow Input image submit data.
 * PARAMETERS:	    (word character, word flags, word state)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_META_KBD_CHAR
{
    EventHandle msg;

    if (@self->HTGI_input == TRUE && @self->HTGI_load == TRUE &&
	( ( (word)( CS_CONTROL << 8 ) | VC_ENTER ) == character ) && 
	( CF_FIRST_PRESS & flags )) {
	@self->HTGI_input_x = 0;
	@self->HTGI_input_y = 0;
	msg = @record HTGenFormClass::MSG_GEN_FORM_SUBMIT(0);
	@send self::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
    }
    @callsuper();
    return;
}	/* End of MSG_META_KBD_CHAR.	*/




/***********************************************************************
 *	UIGen_START_MAP_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a MAP memory block to sotre AREA coordinates.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 8/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_MAP_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value, *cptr;
  HTMemHandle mapItem, nameChunk;
  MapItem *item;
  int index;

  /*
   *  Get the NAME attribute
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      /*
       *  Create a list if not exists.
       */
      if (!currentDoc->HTUI_areaMaps)
	return UI_GEN_ERROR;
      /*
       *  Allocate a MapItem
       */
      mapItem = HTMemAllocWID(0, sizeof(MapItem));
      nameChunk = HTMemAllocWID(0, sizeof(char) * (strlen(value)+1));
      /*
       *  Store the map name in MapItem.
       */
      item = (MapItem *)HTMemLock(mapItem);
      item->MI_mapName = nameChunk;
      cptr = (char *)HTMemLock(item->MI_mapName);
      strcpy(cptr, value);
      HTMemUnlock(item->MI_mapName);
      /*
       *  Allocate a memory block for the storage of the AREAs information.
       */
      item->MI_areas = HTListNewWID(0);
      HTMemUnlock(mapItem);
      /*
       *  Set the current mapItem in the UIGenerator, thus the later
       *  <AREA> elements are attached to this current MAP info.
       */
      currentDoc->HTUI_currentMap = mapItem;
      /*
       *  Append this map info in the list.
       */
      HTListAppend(currentDoc->HTUI_areaMaps, (void *)&mapItem, sizeof(HTMemHandle));
    }
  }

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_MAP_Int.	*/



/***********************************************************************
 *		UIGen_END_MAP_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    End the <MAP> business.
 * PARAMETERS:	    none.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/14/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_MAP_Int()
{
  /* 
   *  Done with the current Map.
   */
  currentDoc->HTUI_currentMap = NULL;
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_MAP_Int.	*/



/***********************************************************************
 *		UIGen_CREATE_AREA_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Specifies the shape of a "hot spot" in a client-
 *		    side image map.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/13/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_AREA_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value;
  int index;
  HTMemHandle areaItem, tmpChunk;
  AreaItem *aItem;
  MapItem *mItem;

  if (!currentDoc->HTUI_areaMaps || !currentDoc->HTUI_currentMap)
    return UI_GEN_ERROR;		/*  <AREA> appears outside of <MAP>! */

  /*
   *  Allocate an AREA item to store the information
   */
  areaItem = HTMemAllocWID(0, sizeof(AreaItem));
  aItem = (AreaItem *)HTMemLock(areaItem);
  aItem->AI_shape = AREA_RECT;  /* default shape */
  aItem->AI_coords = NULL;
  /*
   *  Get the NAME attribute
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_HREF:
    case HTML_ATTR_COORDS:
      tmpChunk = HTStrAllocCopyWID(0, value);
      if (entity[index].SGMLE_token == HTML_ATTR_HREF)	/* href */
	aItem->AI_href = tmpChunk;
      else
	aItem->AI_coords = tmpChunk;
      break;
    case HTML_ATTR_ALT:
      break;
    case HTML_ATTR_SHAPE:
      if (strcasecmp("rect", value) == 0 || 
	  strcasecmp("rectangle", value) == 0)
	aItem->AI_shape = AREA_RECT;
      else if (strcasecmp("circ", value) == 0 ||
	       strcasecmp("circle", value) == 0)
	aItem->AI_shape = AREA_CIRC;
      else if (strcasecmp("poly", value) == 0 ||
	       strcasecmp("polygon", value) == 0)
	aItem->AI_shape = AREA_POLY;
      else
	aItem->AI_shape = AREA_DEFAULT;
      break;
    }
  }

  mItem = (MapItem *)HTMemLock(currentDoc->HTUI_currentMap);

  HTListAppend(mItem->MI_areas,	(void *)&areaItem, sizeof(HTMemHandle));
  HTMemUnlock(currentDoc->HTUI_currentMap);
  HTMemUnlock(areaItem);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_AREA_Int.	*/






/***********************************************************************
 *		FigureDestinationForMouseEvent
 ***********************************************************************
 *
 * SYNOPSIS:	Given the mouse coordinate and a list of <AREA>s, 
 *		check which <AREA> the mouse event falls into and 
 *		loads the specified URL.
 * CALLED BY:	void (HTListHandle areas;, rel_x, rel_y, optr image)
 * RETURN:	none.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/15/96   	Initial Revision
 *
 ***********************************************************************/
Boolean FigureDestinationForMouseEvent
(HTListHandle areaHandle, int x, int y, optr pmanager, optr image)
{
  int count, i, num;
  long c_x, c_y, cr;
  char *coord;
  AreaItem *areaItem;
  HTMemHandle area;
  GStateHandle gstate;
  Point *list;
  Rectangle rect;
  Boolean found = FALSE;
  WindowHandle win;

#if 0
  /* start testing */
  Rectangle test;
  /* end testing */
#endif 0

  if ((count = HTListGetCount(areaHandle)) > 0) {
    for (i = 0; i < count; i++) {
      HTListGetItem(areaHandle, i, &area, sizeof(HTMemHandle));
      areaItem = (AreaItem *)HTMemLock(area);
      if (!areaItem->AI_coords && !areaItem->AI_href) {
	HTMemUnlock(area);
	break;
      }
      else if (!areaItem->AI_coords && areaItem->AI_href) {
	if (areaItem->AI_shape == AREA_DEFAULT && pmanager) {
	  @call pmanager::MSG_PM_REFER_AREAMAP_LINK(areaItem->AI_href);
	  found = TRUE;
	}
	HTMemUnlock(area);
	break;
      }
      coord = (char*)HTMemLock(areaItem->AI_coords);
      /*
       *  Now check if the mouse event falls into the area.
       */
      if (areaItem->AI_shape == AREA_RECT) {
	ConvertRectSize(coord, &rect);
#if 0
	/* start testing */
	@call image::MSG_VIS_GET_BOUNDS(&test);
	win = @call image::MSG_VIS_QUERY_WINDOW();
	gstate = GrCreateState(win);
	GrDrawRect(gstate, test.R_left+rect.R_left, test.R_top+rect.R_top,
		   test.R_left+rect.R_right, test.R_top+rect.R_bottom);
	GrDestroyState(gstate);
	/* end testing */
#endif
	if (rect.R_left < x && rect.R_right > x && 
	    rect.R_top < y && rect.R_bottom > y) {
	  if (pmanager)
	    @call pmanager::MSG_PM_REFER_AREAMAP_LINK(areaItem->AI_href);
	  found = TRUE;
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
        }
      }
      else if (areaItem->AI_shape == AREA_CIRC) {
	ConvertCircleSize(coord, &c_x, &c_y, &cr);
#if 0
	/* start testing */
	@call image::MSG_VIS_GET_BOUNDS(&test);
	win = @call image::MSG_VIS_QUERY_WINDOW();
	gstate = GrCreateState(win);
	GrDrawEllipse(gstate, test.R_left+c_x-cr, test.R_top+c_y-cr, 
		      test.R_left+c_x+cr, test.R_top+c_y+cr);
	GrDestroyState(gstate);
	/* end testing */
#endif
	c_x = (c_x > x) ? (c_x - x) : (x - c_x);
	c_y = (c_y > y) ? (c_y - y) : (y - c_y);
	if ((c_x*c_x + c_y*c_y) < cr*cr) {
	  if (pmanager)
	    @call pmanager::MSG_PM_REFER_AREAMAP_LINK(areaItem->AI_href);
	  found = TRUE;
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
        }
      }
      else if (areaItem->AI_shape == AREA_POLY) {
	win = @call image::MSG_VIS_QUERY_WINDOW();
	gstate = GrCreateState(win);
	@call image::MSG_VIS_GET_BOUNDS(&rect);
	if((list = ConvertPolygonSize(coord, &num, &rect)) == NULL) {
	  GrDestroyState(gstate);
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
	}
#if 0
	/* start testing */
	GrDrawPolyline(gstate, list, num);
	/* end testing */
#endif
	if (GrTestPointInPolygon
	    (gstate,ODD_EVEN,list,num,x+rect.R_left,y+rect.R_top)) {
	  if (pmanager)
	    @call pmanager::MSG_PM_REFER_AREAMAP_LINK(areaItem->AI_href);
	  found = TRUE;
	  free(list);
	  GrDestroyState(gstate);
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
	}
	else {
	  free(list);
	  GrDestroyState(gstate);
	}
      }
      HTMemUnlock(areaItem->AI_coords);
      HTMemUnlock(area);
    }

  }
  return found;
}	/* End of FigureDestinationForMouseEvent.	*/


/***********************************************************************
 *		ConvertRectSize
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/16/96   	Initial Revision
 *
 ***********************************************************************/
int nextInteger(char *cptr)
{
  int i;

  for (i = 0; cptr[i] != NULL && cptr[i] != ',' &&
	cptr[i] >= '0' && cptr[i] <= '9'; i++)
	;

  for (; cptr[i] == ' ' || cptr[i] == ','; i++)  /* skip white space */
      ;

  return i;
}


/***********************************************************************
 *		ConvertRectSize
 ***********************************************************************
 *
 * SYNOPSIS:	Read a char array, and return Rectangle.
 * CALLED BY:	void (char *coord, Rectangle *rect)
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/17/96   	Initial Revision
 *
 ***********************************************************************/
void ConvertRectSize (char *coord, Rectangle *rect)
{
  int	len, i;

  rect->R_left = rect->R_top = rect->R_right = rect->R_bottom = 0;

  for (i = 0; coord[i] == ' '; coord++)  /* skip white space */
      ;
  rect->R_left = atoi(coord);
  if ((len = nextInteger(coord)) == 0)
	return;
  coord += len;
  for (i = 0; coord[i] == ' '; coord++)  /* skip white space */
      ;
  rect->R_top = atoi(coord);
  if ((len = nextInteger(coord)) == 0)
	return;
  coord += len;
  for (i = 0; coord[i] == ' '; coord++)  /* skip white space */
      ;
  rect->R_right = atoi(coord);
  if ((len = nextInteger(coord)) == 0)
	return;
  coord += len;
  for (i = 0; coord[i] == ' '; coord++)  /* skip white space */
      ;
  rect->R_bottom = atoi(coord);

  return;
}	/* End of ConvertRectSize.	*/



/***********************************************************************
 *		ConvertPolygonSize
 ***********************************************************************
 *
 * SYNOPSIS:	Read a char array, create and return a array of Points.
 * CALLED BY:	
 * RETURN:	Points *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/16/96   	Initial Revision
 *
 ***********************************************************************/
Point *
ConvertPolygonSize(char *coord, int *cnt, Rectangle *rect)
{
  int len, i;
  char *cptr = coord;
  Point *point;

  for(*cnt = 1, cptr = coord; *cptr != NULL; cptr++) {
    if (*cptr == ',' || *cptr == ' ')
	(*cnt)++;
  }
  if (*cnt % 2)		/* not a pair */
    return NULL;

  *cnt = *cnt / 2;
  point = malloc(sizeof(Point) * (*cnt));

  for (i = 0; coord[i] == ' '; coord++)  /* skip white space */
      ;

  for (i = 0; i < *cnt; i++) {
    point[i].P_x = atoi(coord) + rect->R_left;
    len = nextInteger(coord);
    EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
    coord += len;
    point[i].P_y = atoi(coord) + rect->R_top;
    len = nextInteger(coord);
    EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
    coord += len;
  }
  return point;
}	/* End of ConvertPolygonSize.	*/



/***********************************************************************
 *		ConvertCircleSize
 ***********************************************************************
 *
 * SYNOPSIS:	Read a char array, and get the (x, y) and r values.
 * CALLED BY:	void (char *coord, int *cx, int *cy, int *r);
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/17/96   	Initial Revision
 *
 ***********************************************************************/
void 
ConvertCircleSize (char *coord, long *cx, long *cy, long *cr)
{
  int len;

  *cx = atoi(coord);
  len = nextInteger(coord);
  EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
  coord += len;
  *cy = atoi(coord);
  len = nextInteger(coord);
  EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
  coord += len;
  *cr = atoi(coord);

  return;
}	/* End of ConvertCircleSize.	*/

