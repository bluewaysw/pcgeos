@ifndef _UIFACT_GOH_
@define _UIFACT_GOH_

@include <stdapp.goh>
@include <WWW/HTCore/htlist.goh>
#include <WWW/htmem.h>


typedef struct {
	optr obj;
	ClassStruct *class;
} ObjInfo;


/* -----------------------------------------------------------------------
 * 		UI doc is bound to an anchor object as anchor object
 *              contains the persistent URL that refers to the UI doc.
 * ----------------------------------------------------------------------*/
typedef struct {
    HTMemHandle   HTUI_myHandle;
    ThreadHandle  HTUI_threadID;
    optr          HTUI_genView;           /* Top level view, belongs to client,
					     cannot be destroyed */
    optr          HTUI_genContent;        /* genContent & its children are new
					     for each new document and destroyed
					     using HTObjDestroyAllWID */
    optr          HTUI_pmanager;
    optr          HTUI_pmContent;         /* pmananger content model */
    HTMemHandle   HTUI_currentMap;        /* The current map if nonzero */
    HTListHandle  HTUI_areaMaps;
    HTListHandle  HTUI_objList;           /* Objects that would receive 
					     MSG_GEN_PREPARE_FOR_DESTROY before the
					     object blocks are freed */
    /*
     *  HTUI_hrefToken keep track of the href token of the current
     *  <A>....</A> content. -1 means currently there is no <A>...</A> content.
     */
    int           HTUI_hrefToken; 
    /*
     * HTUI_target points to the current object that is
     * being created and modified before being sent to
     * the presentation manager for rendering.
     */
    ObjInfo	  HTUI_target;
    /*
     *  UIG_jumpToAnchor stores the NAME of a <A> that user just
     *  clicked.  When the new page is loaded, the specified anchor
     *  point will be brought into the view.
     */
    HTMemHandle	  HTUI_jumpToAnchor;
} HTUIDoc;

optr _pascal UICreateObj (HTUIDoc *doc, ClassStruct *objClass);

void _pascal UIDocAddMemory (word len);

@endif /* _UIFACT_GOH_ */



