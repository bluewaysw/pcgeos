/***********************************************************************
 *		UIGotoNextFocusableField
 ***********************************************************************
 *
 * SYNOPSIS:	Move to the next focusable field in the UIDoc.
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/19/97   	Initial Revision
 *	
 ***********************************************************************/
void _pascal
UIGotoNextFocusableField (HTMemHandle uiDoc)
{
    HTUIDoc *doc;
EC( ECCheckUIDoc(uiDoc);                                                )
    doc = (HTUIDoc *) HTMemLock(uiDoc);
    @send, forceQueue, checkDuplicate doc->HTUI_pmanager::
	MSG_PM_SEARCH_NEXT_FOCUSABLE_OBJECT();
    HTMemUnlock(uiDoc);
}	/* End of UIGotoNextFocusableField.	*/



