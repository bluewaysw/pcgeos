/***********************************************************************
 *		UIDocMemoryNeeded
 ***********************************************************************
 *
 * SYNOPSIS:	Tally the amount of memory used so far.
 * CALLED BY:	Client
 * RETURN:	dword, document width, and document height.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/20/97   	Initial Revision
 *	
 ***********************************************************************/
dword _pascal
UIDocMemoryNeeded (HTMemHandle uiDoc, word *width, word *height)
{
    dword ret;
    HTUIDoc *doc;
EC( ECCheckUIDoc(uiDoc);                                               )
    doc = (HTUIDoc *) HTMemLock(uiDoc);
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ret = uiMemoryAllocated;
    POPDS;
    @call doc->HTUI_pmContent::MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS
	(width, height);
    HTMemUnlock(uiDoc);
    return ret;
}	/* End of UIDocMemoryNeeded.	*/



/***********************************************************************
 *		UIDocAddMemory
 ***********************************************************************
 *
 * SYNOPSIS:	Add needed UI memory for a document.
 * CALLED BY:	Internal to UIGenerator
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/21/97   	Initial Revision
 *	
 ***********************************************************************/
void _pascal
UIDocAddMemory (word len)
{
    /* No need to push and pop DS as called from UIGenerator */
    uiMemoryAllocated += len;
}	/* End of UIDocAddMemory.	*/
