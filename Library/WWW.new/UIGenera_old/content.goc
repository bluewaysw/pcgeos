/***********************************************************************
 *MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the current object, find the current row
 *                  number and its x position in the row.
 * PARAMETERS:	    (optr obj, SizeAsDWord size, int *row, 
 *                   optr *prevObj, word *br);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE
{
  if (@self->HTGHC_currentObj != obj) {
    /*
     *  If this is a new object encountered for the first time(i.e.
     *  the previous object has settled), we update instance data
     *  to calculate the x position of the new object.
     */
    @self->HTGHC_accumulatedPrevWidth += @self->HTGHC_widthCurrentObj+MARGIN;
    if (!@self->HTGHC_maxHeightInRow)
      @self->HTGHC_maxHeightInRow = DWORD_HEIGHT(size);
    else if (@self->HTGHC_heightCurrentObj > @self->HTGHC_maxHeightInRow) {
      @self->HTGHC_maxHeightInRow = @self->HTGHC_heightCurrentObj;
    }
    *prevObj = @self->HTGHC_currentObj;
    @self->HTGHC_currentObj = obj;
  }
  else
    *prevObj = NULL;
  @self->HTGHC_widthCurrentObj = DWORD_WIDTH(size);
  @self->HTGHC_heightCurrentObj= DWORD_HEIGHT(size);
  /*
   *  The new object is in the row number = array index + 1.
   *  The height element(array index + 1) doesn't exist in the height 
   *  array yet because we don't know its height until we will have
   *  encountered all the objects in the new row.
   */
  *row = @self->HTGHC_rowIndex + 1;
  *br = @self->HTGHC_noBr;
  return @self->HTGHC_accumulatedPrevWidth;
}	/* End of MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the variables and array that keep track of 
 *                  row information(specifically the row heights).
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER
{
  @self->HTGHC_rowIndex = -1;
  @self->HTGHC_currentObj = NULL;
  @self->HTGHC_maxHeightInRow = @self->HTGHC_heightCurrentObj = 
  @self->HTGHC_widthCurrentObj = 0;
  @self->HTGHC_sumOfHeights = MARGIN;    /* top margin */
  @self->HTGHC_accumulatedPrevWidth = 0; 
  @self->HTGHC_maxRowWidth = MARGIN;
  /*
   *  heightArray stores the heights of each row.
   */
  if (@self->HTGHC_heightArray)
      HTListDeleteAllItems(@self->HTGHC_heightArray);
  else
      @self->HTGHC_heightArray = HTListNewWID(0);
  /*
   *  rowArray stores the line with of each row.
   */
  if (@self->HTGHC_rowArray)
      HTListDeleteAllItems(@self->HTGHC_rowArray);
  else
      @self->HTGHC_rowArray = HTListNewWID(0);

  return;
}	/* End of MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the row number, return its absolute y- 
 *                  document coordinate.
 * PARAMETERS:	    (int row);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT
{
  int height = 0;

  EC_ERROR_IF(row > @self->HTGHC_rowIndex, 1);
  HTListGetItem(@self->HTGHC_heightArray, row, &height, sizeof(int));
  return height;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the row number, return its absolute y- 
 *                  document coordinate.
 * PARAMETERS:	    (int row);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH
{
  int width = 0;

  EC_ERROR_IF(row > @self->HTGHC_rowIndex, 1);
  HTListGetItem(@self->HTGHC_rowArray, row, &width, sizeof(int));
  return width;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_START_NEW_ROW for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    IF currentObj is not NULL, the current row is filled
 *                  up with objects.  So, append the current row height
 *                  to the HTGHC_heightArray.  Initialize all the 
 *                  instance variables for the next new row.
 *                  IF the passed currentObj is NULL, that means we
 *                  finish adding objects to the current row.  Thus, 
 *                  we need to update the last row information.
 * PARAMETERS:	    int (SizeAsDWord size, int *row, optr currentObj);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_START_NEW_ROW
{
  word chunk, width;
  optr parent, child, view;
  int rowNum, count;
  GStateHandle gstate;
  RectDWord rect;
  Rectangle objrect;
  /*
   *  Add the current row height(= height of the highest object in the 
   *  row) to the accmulator (sumOfHeights).
   */
  /* Also add the bottom margin */
  @self->HTGHC_sumOfHeights += (@self->HTGHC_maxHeightInRow + MARGIN);
  /*
   *  Append the height of the finished row in the heightArray.
   */
  chunk = HTListAppend
    (@self->HTGHC_heightArray, &(@self->HTGHC_sumOfHeights), sizeof(int));
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  EC_ERROR_IF(@self->HTGHC_rowIndex+1 != chunk, 1);
  @self->HTGHC_rowIndex = chunk;
  /*
   *  The future new object is in the row number = array index + 1.
   *  The height element(array index + 1) doesn't exist in the height 
   *  array yet because we don't know its height until we will have
   *  encountered all the objects in the new row.
   */
  *row = @self->HTGHC_rowIndex + 1;
  /*
   *  Update the maximum row width.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  /*
   *  If the previous row is widest, update the max row width.
   */
  if (@self->HTGHC_accumulatedPrevWidth > @self->HTGHC_maxRowWidth)
    @self->HTGHC_maxRowWidth = @self->HTGHC_accumulatedPrevWidth;
  /*
   *  If the currentObj == NULL, that means we're finishing up the last
   *  row.  
   */
  if (!currentObj) {
      if ((width = (@self->HTGHC_widthCurrentObj + 
	  @self->HTGHC_accumulatedPrevWidth)) > 
	  @self->HTGHC_maxRowWidth)
	@self->HTGHC_maxRowWidth = width;
      @self->HTGHC_accumulatedPrevWidth = 0;
  }
  else {
    width = @self->HTGHC_accumulatedPrevWidth;
    /*
     *  The object doesn't fit in the prevoius row, so it starts
     *  at a new row with a right margin.
     */
    @self->HTGHC_accumulatedPrevWidth = MARGIN; /* right margin */
  }

  /*
   *  Store the current row width in the rowArray.
   */
  chunk = HTListAppend(@self->HTGHC_rowArray, &width, sizeof(int));
  EC_ERROR_IF(chunk != @self->HTGHC_rowIndex, 1);

  /*
   *  Initialize maxHeightInRow to the the height of the first object 
   *  in the new row.
   */
  @self->HTGHC_maxHeightInRow = @self->HTGHC_heightCurrentObj = 
      DWORD_HEIGHT(size);
  @self->HTGHC_widthCurrentObj = DWORD_WIDTH(size);
  @self->HTGHC_currentObj = currentObj;    /* set new current object */
  /*
   *  Return if it's a table/form/caption object.  We'll do drawing when the 
   *  complete table object is set usable.
   */
  if (@call oself::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass) ||
      @call oself::MSG_META_IS_OBJECT_IN_CLASS(&HTGenFormClass) ||
      @call oself::MSG_META_IS_OBJECT_IN_CLASS(&HTGenCaptionClass))
      return @self->HTGHC_accumulatedPrevWidth;

  parent = @call self::MSG_GEN_HTML_CONTENT_GET_PM_IF_GLOBAL();
  if (!parent)
      parent = oself;

  /***********************************************************************
   *  THE FOLLOWING CODE IS EXECUTED ONLY FOR THE GLOBAL CONTENT OBJECT  *
   ***********************************************************************/
  gstate = @call parent::MSG_VIS_VUP_CREATE_GSTATE();
  view = @call parent::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&GenViewClass);
  @call view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&rect);

  for (count = @call parent::MSG_GEN_COUNT_CHILDREN() - 1; count>=0; count--){
      child = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(count);
      rowNum = @call child::MSG_UI_GET_ROW_POSITION();
      if (rowNum > @self->HTGHC_rowIndex || rowNum == -1)
	  continue;
      else if (rowNum == @self->HTGHC_rowIndex) {
	  @call child::MSG_VIS_POSITION_BRANCH(0,0);
	  @call child::MSG_VIS_GET_BOUNDS(&objrect);
	  if (objrect.R_top<rect.RD_bottom && objrect.R_bottom>rect.RD_top &&
	      objrect.R_left < rect.RD_right && objrect.R_right > rect.RD_left)
	      @call child::MSG_VIS_DRAW(DF_EXPOSED, gstate);
      }
      else
	  break;
  }
  GrDestroyState(gstate);
  /*
   *  Extend the size of content if needed.
   */
  @call @self->HTGHC_pmObj::MSG_VIS_GET_BOUNDS(&objrect);
  if (@self->HTGHC_sumOfHeights > objrect.R_bottom + Y_SCREEN_SIZE) {
      optr parent;
      SizeAsDWord sz;
      int width;
      EC_ERROR_IF(objrect.R_top > 0, 1);
      parent = @call @self->HTGHC_pmObj::MSG_GEN_FIND_PARENT();
      width = (@self->HTGHC_maxRowWidth > X_SCREEN_SIZE) ?
	  @self->HTGHC_maxRowWidth : X_SCREEN_SIZE;
      sz = MAKE_SIZE_DWORD(width, @self->HTGHC_sumOfHeights);
      @call parent::MSG_HTML_CONTENT_SET_VIEW_DOC_BOUNDS(sz);
      @call parent::MSG_VIS_SET_SIZE(width,@self->HTGHC_sumOfHeights);
      @call @self->HTGHC_pmObj::MSG_VIS_SET_SIZE
	  (width, @self->HTGHC_sumOfHeights);
  }
  return @self->HTGHC_accumulatedPrevWidth;
}	/* End of MSG_GEN_HTML_CONTENT_START_NEW_ROW.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_DIMENSION for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Sum up all the row heights in document.
 * PARAMETERS:	    (word width, word height);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_DIMENSION
{
  int currWidth;

  currWidth = MARGIN + 
      @self->HTGHC_accumulatedPrevWidth + @self->HTGHC_widthCurrentObj;

  *width = (@self->HTGHC_maxRowWidth > currWidth) ?
      @self->HTGHC_maxRowWidth : (@self->HTGHC_maxRowWidth = currWidth);

  /*
   *  HTGHC_sumOfHeights accumulates the row heights up to n-1 rows.
   *  HTGHC_maxHeightInRow keeps the row height of the n_th row.
   */
  *height = @self->HTGHC_sumOfHeights + @self->HTGHC_maxHeightInRow;
  return;
}	/* End of MSG_GEN_HTML_CONTENT_GET_DIMENSION.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Update the max height of the object in a row.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT
{
  /*
   *  HTGHC_heightCurrentObj is the height of the last object in the row.
   *  If it's greater the the max. height seen previously, update the max.
   */
  if (@self->HTGHC_heightCurrentObj > @self->HTGHC_maxHeightInRow)
       @self->HTGHC_maxHeightInRow = @self->HTGHC_heightCurrentObj;
  return;
}	/* End of MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT.	*/


