/***********************************************************************
 *		UpdateHeightArray
 ***********************************************************************
 *
 * SYNOPSIS:	An object in a row expands the row height, so we need to
 *              add the difference of the old and height to the 
 *              following rows.  Note: all heights are in absolute 
 *              document coordinate.
 * CALLED BY:	
 * RETURN:	the sum of the heights of rows in the document.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
word
UpdateHeightArray 
(word diff, word heightPrevRow, HTListHandle heightArray, int row, 
 word totalCnt, optr parent, optr firstObj, int firstIndex)
{
    optr obj;
    word objRow;
    /*
     *  If the new row height is bigger, expand it.  If smaller, 
     *  we don't do shrinking row height, at least for now....
     */
    diff = heightPrevRow - diff;
    /*
     *  Update the row height for the row.
     */
    HTListReplaceItem(heightArray, row, 
		      &heightPrevRow, sizeof(int));
    /*
     *  Update the rest of row heights: simply add the difference.
     */
    for (objRow = row+1; objRow < totalCnt; objRow++) {
	HTListGetItem(heightArray, objRow,
		      &heightPrevRow, sizeof(int));
	heightPrevRow += diff;
	HTListReplaceItem(heightArray,
			  objRow, &heightPrevRow, sizeof(int));
    }
    /*
     *  Re-positioning starting from the firstObj, i.e. the first obj
     *  of the row in which the passed obj changes its size.
     */
    for (obj = firstObj; obj; ){
	@call obj::MSG_VIS_POSITION_BRANCH(0,0);
	obj = @call parent::MSG_VIS_FIND_CHILD_AT_POSITION(++firstIndex);
    }
    return heightPrevRow;
}	/* End of UpdateHeightArray.	*/

/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_RECALC_POSITIONS for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Re-position objects to the right of and below the
 *                  passed startObj that just changed its size.
 * PARAMETERS:	    (optr startObj, optr parent)
 *                  startObj - the object whose size just changed.
 *                  parent   - can be oself, or can be PManager.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/ 3/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_RECALC_POSITIONS
{
  int startPos, startRow, row, i, firstIndex, objRow, tmp;
  optr obj, firstObj;
  SizeAsDWord pSize, objSize;
  word pWidth, heightPrevRow, heightCurrRow, accWidthCurrRow = MARGIN,
       totalCnt = HTListGetCount(@self->HTGHC_heightArray), diff;
  /*
   *  Scan to the first object in the row.
   *  While scanning backward in this row, find max height of objects seen
   *  so far in the backward direction, also accumulate the widths.
   */
  startPos = @call parent::MSG_GEN_FIND_CHILD(startObj);
  startRow = @call startObj::MSG_UI_GET_ROW_POSITION();
  obj = startObj;
  for (i = startPos - 1, heightCurrRow = 0; i >= 0; i--) {
    firstObj = obj;
    obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(i);
    row = @call obj::MSG_UI_GET_ROW_POSITION();
    if (row != startRow)
	break;  /*  Break if we reach an object in the previous row. */
    EC_ERROR_IF(row > startRow, 1);
    /*
     *  Got one object still in the current row in the backward direction.
     *  Now update the max height and accumulate the width.
     */
    objSize = @call obj::MSG_VIS_GET_SIZE();
    if (heightCurrRow < DWORD_HEIGHT(objSize))
      heightCurrRow = DWORD_HEIGHT(objSize);
    accWidthCurrRow += (DWORD_WIDTH(objSize) + MARGIN);
  }
  firstIndex = i+1; /* the child index of the first object in the startRow */
  if (i == -1) {
    firstObj = obj;
    /*
     *  startObj is already the first object in the row.  In fact,
     *  the row is the first row of the document.
     */
    heightPrevRow = MARGIN;
  }
  else
    /*
     *  startObj is in a row other than the first row.  Thus, let's get the
     *  absolute height of the previous row.  Later, we'll calculate the
     *  new absolute height this current row where the startObj changes its
     *  size.
     */
    HTListGetItem(@self->HTGHC_heightArray, startRow-1,
		  &heightPrevRow, sizeof(int));

  pSize = @call parent::MSG_VIS_GET_SIZE();
  pWidth = DWORD_WIDTH(pSize);
  objSize = @call startObj::MSG_VIS_GET_SIZE();
  if (pWidth < DWORD_WIDTH(objSize))
      /* 
       * The startObj will expand its parent size anyway, so the pWidth
       * should be updated to the size of objSize.
       */
      pWidth = DWORD_WIDTH(objSize);

  /*
   *  startPos - the child index of the passed object whose size 
   *             just changed.
   *  startRow - the row in which the passed object changed its size, 0-based.
   *  heightCurrRow - height of tallest object to the left of 
   *                  startObj in the same row.
   *  accWidthCurrRow - the sum of widths of all objects to the left of
   *                 startObj in the same row.
   *  heightPrevRow - the Y document position of the previous row.
   */
  for (i = startPos, obj = startObj, row = startRow;
       obj;
       i++, obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(i)) {

    objSize = @call obj::MSG_VIS_GET_SIZE();
@if 1
    if ((objRow = @call obj::MSG_UI_GET_ROW_POSITION()) > row) {
      /*
       *  Update the row width.
       */
      HTListReplaceItem(@self->HTGHC_rowArray, row, 
			&accWidthCurrRow, sizeof(int));
      /*
       *  Update the rest of row heights.
       */
      heightPrevRow += heightCurrRow + MARGIN;
      HTListGetItem(@self->HTGHC_heightArray, row,
		    &diff, sizeof(int));
      if (diff < heightPrevRow) {
	  heightPrevRow = UpdateHeightArray
	      (diff, heightPrevRow, @self->HTGHC_heightArray, row, totalCnt, 
	       parent, firstObj, firstIndex);
      }
      else {
	/*
	 *  The new size of obj doesn't make the line where the
	 *  obj resides bigger.  Thus we simply reposition the obj
	 *  within that line.
	@call obj::MSG_VIS_POSITION_BRANCH(0,0);
	 */
	/*
	 *  Get the hiehgt of the whole document.
	 */
	HTListGetItem(@self->HTGHC_heightArray, totalCnt-1,
			&heightPrevRow, sizeof(int));
      }
EC(   for (objRow = 0, i=0; objRow < totalCnt; objRow++) {
        HTListGetItem(@self->HTGHC_heightArray, objRow, 
		      &heightCurrRow, sizeof(int));
	EC_ERROR_IF(i >= heightCurrRow, 1);
	i = heightCurrRow;
      } )
      if (accWidthCurrRow > @self->HTGHC_maxRowWidth) 
	@self->HTGHC_maxRowWidth = accWidthCurrRow; /* +MARGIN; */
      return MAKE_SIZE_DWORD(@self->HTGHC_maxRowWidth, heightPrevRow);
    }
@endif
    if (accWidthCurrRow <= MARGIN || 
	accWidthCurrRow + DWORD_WIDTH(objSize) <= pWidth) {
	/*
	 *  object can fit in the current line.  Row is 0-based.
	 */
	@call obj::MSG_UI_SET_NEW_POSITION(accWidthCurrRow, row);
	accWidthCurrRow += DWORD_WIDTH(objSize) + MARGIN;
	if (heightCurrRow < DWORD_HEIGHT(objSize))
	  heightCurrRow = DWORD_HEIGHT(objSize);
    }
    else {
      /*
       *  Can't fit in the current line.  Thus, let's wrap up all the 
       *  information of the current line before reseting variables for
       *  the next line.
       */
      heightPrevRow += heightCurrRow + MARGIN;
      if (row < totalCnt) {
	  HTListReplaceItem(@self->HTGHC_heightArray,
			    row, &heightPrevRow, sizeof(int));
	  HTListReplaceItem(@self->HTGHC_rowArray,
			    row, &accWidthCurrRow, sizeof(int));
      }
      else {
	  @self->HTGHC_rowIndex++;
	  totalCnt++;
	  tmp = HTListAppend(@self->HTGHC_heightArray,
		       &heightPrevRow, sizeof(int));
	  EC_ERROR_IF(tmp != @self->HTGHC_rowIndex, 1);
	  tmp = HTListAppend(@self->HTGHC_rowArray,
		       &accWidthCurrRow, sizeof(int));
	  EC_ERROR_IF(tmp != @self->HTGHC_rowIndex, 1);
      }
      row++;
      @call obj::MSG_UI_SET_NEW_POSITION(MARGIN, row);
      if (accWidthCurrRow > @self->HTGHC_maxRowWidth)
	@self->HTGHC_maxRowWidth = accWidthCurrRow; /* + MARGIN; */
      accWidthCurrRow = DWORD_WIDTH(objSize) + MARGIN + MARGIN;
      heightCurrRow = DWORD_HEIGHT(objSize);
    }
  }
  /*
   *  We've run out of children object of the parent.  Let's update the
   *  information of the last row.
   */
  heightPrevRow += heightCurrRow + MARGIN;
  if (row < totalCnt) {
    HTListGetItem(@self->HTGHC_heightArray, row,
		  &diff, sizeof(int));
    if (diff < heightPrevRow) {
	heightPrevRow = UpdateHeightArray
	    (diff, heightPrevRow, @self->HTGHC_heightArray, row, 
	     totalCnt, parent, firstObj, firstIndex);
    }
    HTListReplaceItem(@self->HTGHC_rowArray,
		      row, &accWidthCurrRow, sizeof(int));
  }
  else {
    @self->HTGHC_rowIndex++;
    i = HTListAppend(@self->HTGHC_heightArray,
		     &heightPrevRow, sizeof(int));
    EC_ERROR_IF(i != @self->HTGHC_rowIndex, 1);
    i = HTListAppend(@self->HTGHC_rowArray,
		 &accWidthCurrRow, sizeof(int));
    EC_ERROR_IF(i != @self->HTGHC_rowIndex, 1);
  }
  if (accWidthCurrRow > @self->HTGHC_maxRowWidth) 
      @self->HTGHC_maxRowWidth = accWidthCurrRow; /* +MARGIN; */

EC( obj = @call parent::MSG_VIS_FIND_CHILD_AT_POSITION(firstIndex); )
EC( EC_ERROR_IF(obj != firstObj, 1); )

@if 1
  /*
   *  Start positioning the objects.
   */
  for (obj = firstObj; obj; ){
    @call obj::MSG_VIS_POSITION_BRANCH(0,0);
    obj = @call parent::MSG_VIS_FIND_CHILD_AT_POSITION(++firstIndex);
  }
@endif
EC(   for (objRow = 0, i=0; objRow < totalCnt; objRow++) {
        HTListGetItem(@self->HTGHC_heightArray, objRow, 
		      &heightCurrRow, sizeof(int));
	EC_ERROR_IF(i >= heightCurrRow, 1);
	i = heightCurrRow;
      } )
  return MAKE_SIZE_DWORD(@self->HTGHC_maxRowWidth, heightPrevRow);
}	/* End of MSG_GEN_HTML_CONTENT_RECALC_POSITIONS.	*/


/***********************************************************************
 *MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Return the accumulated row heights.
 * PARAMETERS:	    (word *width, word *height);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS
{
    *width = @self->HTGHC_maxRowWidth;
    *height = @self->HTGHC_sumOfHeights;
    return;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS.	*/



/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_DESTROY
{
  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  HTListDelete(@self->HTGHC_heightArray);
  HTListDelete(@self->HTGHC_rowArray);
  HTListDelete(@self->HTGHC_fontStack);

  return;
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These would be destroyed when we delete the blocks using
     * HTListDeleteAllWID.
     *
     * HTListDelete(@self->HTGHC_heightArray);
     * HTListDelete(@self->HTGHC_rowArray);
     * HTListDelete(@self->HTGHC_fontStack);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/
