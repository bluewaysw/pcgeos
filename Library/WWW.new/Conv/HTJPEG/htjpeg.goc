@include <stdapp.goh>
@include <WWW/htjpeg.goh>
@include <WWW/htconv.goh>

/*
 * The real Jpeg converter function entry.
 */
extern word JPEGTOBITMAP(word dataHandle);

/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTJPEGClass;

/***********************************************************************
		Message Handlers
***********************************************************************/

@method HTJPEGClass, MSG_HT_STREAM_SET_TARGET
{
    @callsuper();

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    ThreadCreate(PRIORITY_HIGH, 	@self->struct_handle,
				&JPEGTOBITMAP, 1024*2, 
				GeodeGetProcessHandle());
}







