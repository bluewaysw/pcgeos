#define ETOP            parser->HTMLP_elementTop
#define ETOPITEM        ESTACK[ETOP-1]
#define MSTACK          parser->HTMLP_minusStack
#define MTOP            parser->HTMLP_minusTop
#define TAG             parser->HTMLP_tag
#define BLOCK           parser->HTMLP_block
#define CHUNK           parser->HTMLP_chunk
#define TARGET          parser->HTMLP_target
#define FORM            parser->HTMLP_form
#define FORMGROUP       parser->HTMLP_formGroup

#define CURRENTCONTENT  TAG[ETOPITEM.HTMLS_elementToken].HTMLT_content
#define CURRENTINDEX    ETOPITEM.HTMLS_index
#define CURRENTCOUNT    ETOPITEM.HTMLS_count

