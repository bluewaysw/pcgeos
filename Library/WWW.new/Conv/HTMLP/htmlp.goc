#define _MTOP           @self->HTMLI_parser->HTMLP_minusTop
#define _BLOCK          @self->HTMLI_parser->HTMLP_block
#define _CHUNK          @self->HTMLI_parser->HTMLP_chunk
#define _TAG            @self->HTMLI_parser->HTMLP_tag
