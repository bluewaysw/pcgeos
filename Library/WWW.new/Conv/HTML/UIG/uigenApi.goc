ErrorCode _pascal UIGen_START_META(MemHandle block, SGMLEntity *entity) 
{
    word index, time, i;
    char *value, *url, *ptr;
    Boolean refresh = FALSE;
    HTMemHandle urlHtmh = 0;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    for(index = 0; entity[index].SGMLE_token; index++) {
	if (!entity[index].SGMLE_value)
	    continue;
	value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
	switch(entity[index].SGMLE_token) {
	case HTML_ATTR_CONTENT:
	    /*
	     * parse the "content" attribute
	     * 1. content = 2
	     * 2. content = 2; url = xxx.xxx.xxx
	     */
	    /* filter out space */
	    while(ISWHITE(*value)) value++;

	    /* get the time value */
	    ptr = value;
	    while(isdigit(*value)) value ++;
	    if(*value) {
		*value = 0; 
		value ++;
	    }
	    time = atoi(ptr);
	    if(time > 18 * 60) time = 18 * 60;

	    /* get the url if available */
	    if((url = strcasestr(value, "url")) != NULL) {
		if((url = strchr(url, '=')) != NULL) {
		    url ++;
		    while(ISWHITE(*url)) url++;
		    for(i=0; i<strlen(url); i++)
			if(ISWHITE(*(url+i)))
			    *(url+i) = 0;
		    ptr = HTMemAllocAndLock(&urlHtmh, strlen(url) + 1);
		    strcpy(ptr, url);
		    HTMemUnlock(urlHtmh);
		}
	    }
	    
	    break;
	case HTML_ATTR_HTTP_EQUIV:
	    if(!strcasecmp("refresh", value))
		refresh = TRUE;
	    break;
	case HTML_ATTR_URL:
	    url = HTMemAllocAndLock(&urlHtmh, strlen(value) + 1);
	    strcpy(url, value);
	    HTMemUnlock(urlHtmh);
	    break;
	}
    }

    if(refresh && uiMgr.UIM_currentDoc) {
	uiMgr.UIM_currentDoc->HTUI_refreshTime = time;
	uiMgr.UIM_currentDoc->HTUI_newURL = urlHtmh;
    }
	
    POPDS;

    return 0;
}

