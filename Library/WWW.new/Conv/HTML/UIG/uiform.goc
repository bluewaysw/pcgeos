/***********************************************************************
 *		MSG_VIS_TEXT_MARK_INVALID for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Because the ui tree is custom manager.  The geometry
 *                  update message is not sent down the ui tree, so
 *                  the ui object have VI_optFlags = GEOMETRY_INVALID.
 *                  Then user input textarea become editable when
 *                  it changes the height.  Here I intercept this
 *                  routine to manually update its geometry.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_MARK_INVALID
{
  VisCompInstance *vself;
  
  vself = ObjDerefVis(oself);
  if (!(vself->VI_attrs & VA_REALIZED)) {
    /*
     *  Avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
     */
    @call self::MSG_VIS_OPEN(0);
  }

    return;
}	/* End of MSG_VIS_MARK_INVALID.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Refresh the drawing bound of navigation focus if
 *                  needed.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/16/97   	Initial Revision
 *	sean		11/14/97	Added font change to fix #72465.
 *	
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_DRAW
{
@ifdef PRODUCT_RESPONDER
  Rectangle bound;
@endif

  /* Let's change the font to be a printable one.   Fixes  */
  /* #72465.  Sean 11/14/97. 				   */
@ifdef	TRUNK
  if (drawFlags & DF_PRINT) {
    NPTextConvertFontID(oself, FID_PENELOPE, FID_DTC_URW_SANS);
  }
@endif

  @callsuper();

@ifdef	TRUNK
  if (drawFlags & DF_PRINT) {
    NPTextConvertFontID(oself, FID_DTC_URW_SANS, FID_PENELOPE);
  }
@endif

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGFT_focalBound.RD_right != @self->HTGFT_focalBound.RD_left) {
      RedrawFocus (gstate, &@self->HTGFT_focalBound);
  }

@ifdef PRODUCT_RESPONDER
  GrSaveState(gstate);
  GrSetLineMaskSys( gstate, SDM_50);
  GrSetMixMode(gstate, MM_COPY);
  GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
  @call self::MSG_VIS_GET_BOUNDS(&bound);
  GrDrawRect(gstate, bound.R_left - 1, bound.R_top - 1, 
	     bound.R_right + 1, bound.R_bottom + 1);
  GrRestoreState(gstate);
@endif

  return;
}	/* End of MSG_VIS_DRAW.	*/



/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Tell the Geometry Manager to sent 
 *                  MSG_VIS_POSITION_BRANCH instead of calling a routine.
 * PARAMETERS:	    SizeAsDWord (RecalcSizeArgs width, 
 *				 RecalcSizeArgs height)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_RECALC_SIZE
{
  VisCompInstance * vself;
  SizeAsDWord size;

  size = @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  size = MAKE_SIZE_DWORD(DWORD_WIDTH(size), DWORD_HEIGHT(size)+4);

  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set its new X and Y position.
 * PARAMETERS:	    (int xOrigin, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  VisInstance *vself;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGFT_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGFT_xPos;
  }
  else {
    lineWidth = @call @self->HTGFT_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGFT_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (@self->HTGFT_align == J_RIGHT) {
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGFT_xPos);
    }
    else {
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGFT_xPos);
    }
  }

  yOrigin = DWORD_Y(xy) + 
    GetItsPotentialHeight(@self->HTGFT_content, @self->HTGFT_pageRow, oself)
	- 1;

  if (uiMgr.UIM_currentDoc->PM_focalObj == oself)
      @call self::MSG_META_RELEASE_FOCUS_EXCL(); /* bug fix #74789 */
  @callsuper();
  vself = ObjDerefVis(oself);
  vself->VI_attrs |= VA_DRAWABLE;

  if (@self->HTGFT_focalBound.RD_left != 0 &&
      @self->HTGFT_focalBound.RD_right != 0 &&
      @self->HTGFT_focalBound.RD_top != @self->HTGFT_focalBound.RD_bottom){
    /*
     *  The object currently has a focus.  Update its new position.
     */
    Rectangle rect;

    @call self::MSG_VIS_GET_BOUNDS(&rect);
    rect.R_left = rect.R_left - 2;
    rect.R_top = rect.R_top - 2;
    @self->HTGFT_focalBound.RD_left = rect.R_left;
    @self->HTGFT_focalBound.RD_right = rect.R_right;
    @self->HTGFT_focalBound.RD_top = rect.R_top;
    @self->HTGFT_focalBound.RD_bottom = rect.R_bottom;
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_UPDATE_FOCUS
	(@self->HTGFT_focalBound);
  }
  if (uiMgr.UIM_currentDoc->PM_focalObj == oself)
      @call self::MSG_META_GRAB_FOCUS_EXCL(); /* bug fix #74789 */

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


