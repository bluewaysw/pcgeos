/***********************************************************************
 *	MSG_GEN_FORM_TRIGGER_INITIALIZE for HTGenFormTriggerClass
 ***********************************************************************
 * SYNOPSIS:	    Store the NAME attribute for the triggers under the
 *		    FORM.
 * PARAMETERS:	    (int formId, int nameId, FormElementype type, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_GEN_FORM_TRIGGER_INITIALIZE
{
  word br;
  @self->HTGFT_type = type;
  @self->HTGFT_content = container;
  @self->HTGFT_formId = formId;
  @self->HTGFT_nameId = nameId;

  /*
   *  Get the current alignment info.
   */
  @self->HTGFT_align=@call container::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGFT_noBr = br;
  @self->HTGFT_pageRow = -1;
  /*
   *  Make the object to be able to grab focus exclusive.
   */
  @call self::MSG_GEN_SET_ATTRS(GA_TARGETABLE,0);

  return;
}	/* End of MSG_GEN_FORM_TRIGGER_INITIALIZE.	*/


