int uiCurrentFormId;



/***********************************************************************
 *		UIGen_START_FORM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	Create a ui object representing a fill-out form.
 *		Information about the form fields are expected to 
 *		be known as more incoming HTML elements are processed.
 *		    
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *	Supported Attr:	ACTION, METHOD
 *
 * INPUT, SELECT and TEXTAREA are only allowed within FORM elements.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *      MZHU    12/97           Second Revision - removed HTGenFormClass,
 *                                created a form list.
 *
 ***********************************************************************/
ErrorCode UIGen_START_FORM_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value, *cptr;
  int	index = 0;
  HTMemHandle htmh;
  word br;
  HTMLForm form;
  MemHandle mh;

  /*
   * Firstly, if no form list in currentDoc, create one.
   */
  if(!uiMgr.UIM_currentDoc->HTUI_formList) {
	uiMgr.UIM_currentDoc->HTUI_formList 
	    = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);
  }
  
  /*
   * Clear action field.
   */
  form.HTF_action = 0;

  /*
   * Secondly, append a new item to the list.
   */
  
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch (entity[index].SGMLE_token) {
    case HTML_ATTR_ACTION:
      /* allocate a chunk to store the ACTION URL */
      htmh = HTMemAllocWID(uiMgr.UIM_currentDoc->HTUI_memID, sizeof(char) * (strlen(value)+1));
      form.HTF_action = htmh;
      cptr = (char *)HTMemLock(form.HTF_action);
      strcpy(cptr,value);
      HTMemUnlock(form.HTF_action);
      break;
    case HTML_ATTR_METHOD:
      if (strcasecmp(value, "post") == 0)
	form.HTF_method = HTM_POST;	
      else
	form.HTF_method = HTM_GET;	
      break;
    }
  }

  if(!form.HTF_action) {
      form.HTF_action = UIDocCurrentURL();
  }

  form.HTF_itemList = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);
  form.HTF_nameList = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

  uiCurrentFormId = HTListAppend(uiMgr.UIM_currentDoc->HTUI_formList, &form, sizeof(HTMLForm));

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_FORM_Int.	*/


/***********************************************************************
 *		UIGen_END_FORM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the presentation manager that the form object
 *		    is ready to be displayed.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *      MZHU    12/97           Second Revision - removed HTGenFormClass,
 *
 ***********************************************************************/
ErrorCode UIGen_END_FORM_Int()
{
EC(  EC_ERROR_IF(uiCurrentFormId < 0, UIG_UI_TREE_OPERATION_FAILS);          )
    /*
     * Here need to check if there is a form tag not finished, and finsh it.
     * 
     */
/*    FinishCurrentObjectInForm(&(uiMgr.UIM_currentDoc->HTUI_target)); */
    uiCurrentFormId = -1;
    
    return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_FORM_Int.	*/


/***********************************************************************
 *		HTML_FORM_RESET
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	11/24/97   	Initial Revision
 *      MZHU            12/97           Second Revision - 
 *                                         removed HTGenFormClass, HTGenHidden,
 *	
 ***********************************************************************/
void _far _pascal HTML_FORM_RESET(int formId)
{
    word i, count;
    HTMLForm form;
    HTMLFormItem *item;
    MemHandle mh2;
    char *str;

EC(  EC_ERROR_IF(formId < 0, UIG_UI_TREE_OPERATION_FAILS);             )

    if(formId > -1 && uiMgr.UIM_currentDoc 
       && uiMgr.UIM_currentDoc->HTUI_formList) {
	count = HTListGetCount(uiMgr.UIM_currentDoc->HTUI_formList);
	if(count && formId < count) {
	    HTListGetItem(uiMgr.UIM_currentDoc->HTUI_formList, 
			formId, &form, sizeof(HTMLForm));
	    count = HTListGetCount(form.HTF_itemList);
	    for(i=0; i<count; i++) {
		item = HTListLockItem(form.HTF_itemList, i, &mh2);
		switch(item->HTFI_type) {
		case FE_TEXT:
		case FE_PASSWORD:
		    if(item->HTFI_value) {
			str = HTMemLock(item->HTFI_value);
			@call item->HTFI_object::
			    MSG_VIS_TEXT_REPLACE_ALL_PTR(str, 0);
			HTMemUnlock(item->HTFI_value);
		    } else
			@call item->HTFI_object::
			    MSG_VIS_TEXT_REPLACE_ALL_PTR("", 0);
			
		    break;
		case FE_CHECKBOX:
		case FE_RADIO:
		    if(item->HTFI_checked)
			@call item->HTFI_object::
			    MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0,0);
		    else
			@call item->HTFI_object::
			    MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(0);
		    break;
		case FE_SUBMIT:
		case FE_RESET:
		case FE_HIDDEN:
		    /* do nothing */
		    break;
		case FE_TEXTAREA:
		case FE_SELECTION:
		    @call item->HTFI_object::MSG_HTML_FORM_RESET();
		    break;
		}
		HTListUnlock(mh2);
	    }
	}
    }
    return;
}	/* End of HTML_FORM_RESET.	*/



/***********************************************************************
 *		HTML_FORM_SUBMIT for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Tell the items under the form to generate the
 *                  name=value pairs for the form submission.  The
 *                  information will be stored in a HTList like:
 *                     index 0  - URL of server specified in ACTION
 *                           1  - Either FORM_GET or FORM_POST
 *                           2  - Name of item  1
 *                           3  - Value of item 1
 *                           4  - Name of item  2
 *                           5  - Value of item 2
 *                           .....
 * PARAMETERS:	    optr button
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/19/96   	Initial Revision
 *      mzhu    11/14/97        Second Revision - removed HTGenFormClass, 
 *                                 HTGenHidden.
 *
 ***********************************************************************/
void _far _pascal HTML_FORM_SUBMIT(int formId, optr object)
{
    HTMemHandle temp, valueHandle, *nameHandle;
    word i, count, len;
    HTMLForm form;
    HTMLFormItem *item;
    MemHandle mh2, mh3;
    char *name, *ptr;

EC(  EC_ERROR_IF(formId < 0, UIG_UI_TREE_OPERATION_FAILS);             )

    if(formId < 0 || !uiMgr.UIM_currentDoc ||
       !uiMgr.UIM_currentDoc->HTUI_formList) 
	return;
  
    count = HTListGetCount(uiMgr.UIM_currentDoc->HTUI_formList);
    if(!count || formId >= count) 
	return;

    HTListGetItem(uiMgr.UIM_currentDoc->HTUI_formList, 
			formId, &form, sizeof(HTMLForm));
    count = HTListGetCount(form.HTF_itemList);

    if(!count || !form.HTF_nameList) {
	return;
    }

    /*
     * Here we simply don't want to accumulate the user's actions.
     * So, make sure this be cleaned when switch pages.
     */
    if(uiMgr.UIM_formQuery) return; 

    /*
     *  Assemble a query string to be sent to the server specified in 
     *  ACTION attribute.
     */
    uiMgr.UIM_formQuery = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);
    /*
     *  Append the Action URL.  If there is no HTGF_action, use the base 
     *  URL of the document.
     */
    if (form.HTF_action) {
	temp = HTStrHTMemAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, 
				      form.HTF_action);
    }
    else {
	if(!uiMgr.UIM_currentDoc->HTUI_baseURL)
	    temp = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, "");
	else
	    temp = HTStrHTMemAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, uiMgr.UIM_currentDoc->HTUI_baseURL);
    }
    HTListAppend(uiMgr.UIM_formQuery, &temp, sizeof(HTMemHandle));
    /*
     *  Append the Method type.
     */
    HTListAppend(uiMgr.UIM_formQuery, &(form.HTF_method), sizeof(HTMethod));
    /*
     *  Assemble the pairs of "name=value" for each objects in the form.
     */

    for(i=0; i<count; i++) {
	valueHandle = 0;
	item = HTListLockItem(form.HTF_itemList, i, &mh2);

	if(item->HTFI_type == FE_SELECTION)
	    /*
	     * too bad, we must seperate selection from others.
	     */
	    @call item->HTFI_object::MSG_HTML_SELECT_SUBMIT(uiMgr.UIM_formQuery);

	else if( item->HTFI_type == FE_IMAGE && item->HTFI_object == object)

	    @call item->HTFI_object::MSG_HTML_IMAGE_SUBMIT(uiMgr.UIM_formQuery);

	else if(item->HTFI_nameId > -1) {

	    switch(item->HTFI_type) {
	    case FE_TEXT:
	    case FE_PASSWORD:
		len = @call item->HTFI_object::MSG_VIS_TEXT_GET_TEXT_SIZE();
		if(len) {
		    ptr = HTMemAllocAndLockWID
			(uiMgr.UIM_currentDoc->HTUI_memID, &valueHandle, len + 1);
		    
		    @call item->HTFI_object::
			MSG_VIS_TEXT_GET_ALL_PTR(ptr);

		    HTMemUnlock(valueHandle);
		}

		break;
	    case FE_CHECKBOX:
	    case FE_RADIO:
		if((@call item->HTFI_object::
			MSG_GEN_ITEM_GROUP_GET_SELECTION()) != GIGS_NONE) {
		    if(item->HTFI_value) 
			valueHandle = HTStrHTMemAllocCopyWID
			    (uiMgr.UIM_currentDoc->HTUI_memID, 
			     item->HTFI_value);
		    else 
			valueHandle = HTStrAllocCopyWID
			    (uiMgr.UIM_currentDoc->HTUI_memID, "on");
		}
		break;

	    case FE_HIDDEN:
		if(item->HTFI_value) 
		    valueHandle = HTStrHTMemAllocCopyWID
			(uiMgr.UIM_currentDoc->HTUI_memID, 
			 item->HTFI_value);
		break;

	    case FE_SUBMIT:
		if(item->HTFI_object == object){
		    if(item->HTFI_value) 
			valueHandle = HTStrHTMemAllocCopyWID
			    (uiMgr.UIM_currentDoc->HTUI_memID, 
			     item->HTFI_value);
		}
		break;
	    case FE_RESET:
		/* nothing */
		break;
	    case FE_TEXTAREA:
		valueHandle = @call item->HTFI_object::MSG_TEXT_AREA_GET_TEXT_HANDLE();
		break;
	    }

	    if(valueHandle) {
		/*
		 * name first 
		 */
		nameHandle = HTListLockItem(form.HTF_nameList, item->HTFI_nameId, &mh3);
		temp = HTStrHTMemAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID,
					   *nameHandle);
		HTListAppend(uiMgr.UIM_formQuery, &temp, sizeof(HTMemHandle));

		/*
		 * value follows
		 */
		HTListAppend(uiMgr.UIM_formQuery, &valueHandle, sizeof(HTMemHandle));

		HTListUnlock(mh3);
	    }
	}
	HTListUnlock(mh2);
    }

    /*
     * Inform the client to submit this form.
     */
@ifdef PRODUCT_NIKE
    @send, forceQueue (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)(UI_APPLY_ON_FORM, 0);
@else
    @send (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)(UI_APPLY_ON_FORM, 0);
@endif
    return;
}



/***********************************************************************
 *	MSG_GEN_FORM_SET_EXCLUSIVE_SELECTION for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    (HTMemeHandle name, optr selectedObj)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *      mzhu    11/20/97        changed to function
 *
 ***********************************************************************/
void _far _pascal HTML_FORM_SET_EXCLUSIVE_SELECTION(int formId,
					       int nameId,
					       optr selectedObj)
{
    optr next;
    word i, count;
    HTMLForm *form;
    HTMLFormItem *item;
    MemHandle mh1, mh2;

EC(  EC_ERROR_IF(formId < 0, UIG_UI_TREE_OPERATION_FAILS);             )

    if(formId < 0 || !uiMgr.UIM_currentDoc || !uiMgr.UIM_currentDoc->HTUI_formList) 
	return;
  
    count = HTListGetCount(uiMgr.UIM_currentDoc->HTUI_formList);
    if(!count || formId >= count) 
	return;

    form = HTListLockItem(uiMgr.UIM_currentDoc->HTUI_formList, 
			  formId, &mh1);
    count = HTListGetCount(form->HTF_itemList);
    if(!count) {
	HTListUnlock(mh1);
	return;
    }

    for(i=0; i<count; i++) {
	item = HTListLockItem(form->HTF_itemList, i, &mh2);
	if(item->HTFI_type == FE_RADIO && 
	   item->HTFI_nameId == nameId && item->HTFI_object != selectedObj)
	    @send, forceQueue item->HTFI_object::
		MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(FALSE);
	HTListUnlock(mh2);
    }
    HTListUnlock(mh1);
    return;
}




