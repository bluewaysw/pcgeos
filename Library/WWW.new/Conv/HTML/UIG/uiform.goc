 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_TEXT_SHOW_SELECTION
{
  return;
}	/* End of MSG_VIS_TEXT_SHOW_SELECTION.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row number and X position.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  VisInstance *vself;
  /*
   *  Ask the text object's content object to figure out the size and
   *  position of the text object.
   */
  pos = UpdateItsPotentialPosition(oself,@self->HTGFT_content,&row,&size);

  /*
   *  Store the returned x position in the returned row number.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGFT_xPos = pos; 
  @self->HTGFT_pageRow = row;
  @self->HTGFT_guessSize = size;

  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_DRAWABLE;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/16/97   	Initial Revision
 *	sean		7/31/97		Fix bug 68878
 *	
 ***********************************************************************/
@method HTGenFormTextClass, MSG_SPEC_BUILD_BRANCH
{
  VisCompInstance * vself;

  @callsuper();

  if (@self->HTGFT_guessSize)
      @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGFT_guessSize),
				   DWORD_HEIGHT(@self->HTGFT_guessSize));

  /*
   *  If the text object is in a form/table, the bit is set again when
   *  the vis part is built.  Thus, we clear it here again.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;
  /*
   *  One purpose to call geometry_valid message here is to let the
   *  small text object to create chunk array for its VTI_lines field.
   */

  /* Removed VOF_IMAGE_INVALID from flags we clear here.  This was  */
  /* causing a bug where the initial text was not showing correctly. */
  /* Sean 7/31/97.  Fixes 68878. */
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID);
  @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/


/***********************************************************************
 *		MSG_META_START_SELECT for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormTextClass, MSG_META_START_SELECT
{
  Rectangle box, rect;
  SemaphoreHandle sem = uiMgr.UIM_access;

  PUSHDS;
  SET_DS_LIB_DGROUP;

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;
  if(!uiMgr.UIM_currentDoc ||
    (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
      retVal->flags = MRF_PROCESSED;
      ThreadVSem(sem);
      POPDS;
      return;
  }
  @call self::MSG_VIS_GET_BOUNDS(&rect);
  rect.R_left = rect.R_left - 2;
  rect.R_top = rect.R_top - 2;
  @self->HTGFT_focalBound.RD_left   = rect.R_left;
  @self->HTGFT_focalBound.RD_right  = rect.R_right;
  @self->HTGFT_focalBound.RD_top    = rect.R_top;
  @self->HTGFT_focalBound.RD_bottom = rect.R_bottom;
  box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
  @send (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
      (oself, rect, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);

  ThreadVSem(sem);

  POPDS;
  @callsuper();
  return;
}	/* End of MSG_META_START_SELECT.	*/


