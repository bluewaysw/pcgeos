/***********************************************************************
 *		MSG_GEN_INPUT_STORE_DATA for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the identity of the INPUT object.  Some of
 *                  data will be submitted to a remote server.
 * PARAMETERS:	    (int formId, int nameId, 
 *                   FormElementType type, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 8/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_STORE_DATA
{
  word br;
  @self->HTGI_content = content;
  @self->HTGI_formId = formId;
  @self->HTGI_nameId = nameId;

  @self->HTGI_pageRow = -1;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGI_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGI_noBr = br;

  if (type == FE_CHECKBOX)
    @self->GIGI_behaviorType = GIGBT_NON_EXCLUSIVE;

  return;
}	/* End of MSG_GEN_INPUT_STORE_DATA.	*/


/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Free the allocated instance data.
 * PARAMETERS:	    (VisUpdateMode updateMode, CompChildFlags flags)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_DESTROY
{
  @callsuper();

  return;
}	/* End of MSG_GEN_DESTROY.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These are allocated using HTMemAllocWID and deleted using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGI_name)
     * HTMemFree(@self->HTGI_name);
     * if (@self->HTGI_value)
     * HTMemFree(@self->HTGI_value);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_INPUT_DRAW_FOCUS for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw the bound to show that it has the navigation
 *                  focus.
 * PARAMETERS:	    (GStateHandle gstate, 
 *                   RectDWord *ret);
 *                   ret - thre returned drawing bounds
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_DRAW_FOCUS
{
  @self->HTGI_focalBound = *ret;

  return;
}	/* End of MSG_GEN_INPUT_DRAW_FOCUS.	*/


/***********************************************************************
 *		MSG_GEN_INPUT_UNDRAW_FOCUS for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Erase the drawing bound.  The object is no longer
 *                  have the navigation focus.
 * PARAMETERS:	    (GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_UNDRAW_FOCUS
{
  @self->HTGI_focalBound.RD_right = @self->HTGI_focalBound.RD_left = 0;
  return;
}	/* End of MSG_GEN_INPUT_UNDRAW_FOCUS.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenInputClass
 ***********************************************************************
 * SYNOPSIS:	We intercept MSG_VIS_DRAW so that we can redraw the
 *              focus if necessary.    
 * PARAMETERS:	drawFlags, GState    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	grisco	11/25/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_VIS_DRAW
{
  /*
   * Superclass does the drawing.
   */

  @callsuper();

  /*
   * If we have the focus, make sure to redraw that, too.
   */

  if (@self->HTGI_focalBound.RD_right != @self->HTGI_focalBound.RD_left) {
      RedrawFocus (gstate, &@self->HTGI_focalBound);
  }

}	/* End of MSG_VIS_DRAW.	*/



/***********************************************************************
 *	MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Make sure only one GenItemGroup of the same name
 *                  get selected.
 * PARAMETERS:	    (word identifier, Boolean indeterminate);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION
{
    @callsuper();

    /*
     * Need to check if this is execlusive or non-.
     * Not done!!!
     */
    if(@self->GIGI_behaviorType != GIGBT_NON_EXCLUSIVE)
	HTML_FORM_SET_EXCLUSIVE_SELECTION
	    (@self->HTGI_formId, @self->HTGI_nameId,oself);

    return;
}	/* End of MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION.	*/


/***********************************************************************
 *		MSG_META_FUP_KBD_CHAR for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Change the default behavior so that the arrow keys
 *                  become TAB or shift-TAB for keyboard navigation.
 * PARAMETERS:	    		(word character = cx,
 *				word flags = dx,
 *				word state = bp)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_META_FUP_KBD_CHAR
{
    if(!(((flags >> 8) & SS_LCTRL) 
       || ((flags >> 8) & SS_RCTRL)) ) {

	switch(character) {

	case (VC_ISCTRL << 8) | VC_TAB:

	    if( (flags & CF_FIRST_PRESS) && !(flags & CF_RELEASE)) {
		if((flags >> 8 & SS_LSHIFT) || (flags >> 8 & SS_RSHIFT))
		    @send self::MSG_GEN_NAVIGATE_TO_PREVIOUS_FIELD();
		else
		    @send self::MSG_GEN_NAVIGATE_TO_NEXT_FIELD();
		
		return TRUE;
	    } 

	    break;

	case (VC_ISCTRL << 8) | VC_ENTER:

	    if( (flags & CF_FIRST_PRESS) && !(flags & CF_RELEASE)) 
		if(!(@call self::MSG_GEN_ITEM_GROUP_GET_NUM_SELECTIONS()))
		    @send self::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0,0);
	        else if(@self->GIGI_behaviorType == GIGBT_NON_EXCLUSIVE)
		    @send self::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(0);

	    return TRUE;

	case (VC_ISCTRL << 8) | VC_LEFT:
	case (VC_ISCTRL << 8) | VC_RIGHT:
	case (VC_ISCTRL << 8) | VC_DOWN:
	case (VC_ISCTRL << 8) | VC_UP:
	case (VC_ISCTRL << 8) | VC_NEXT:
	case (VC_ISCTRL << 8) | VC_PREVIOUS:
	    /* 
	     * We want the content to take care these keys 
	     */
	    {
		EventHandle event;
		event = @record GenContentClass::MSG_META_FUP_KBD_CHAR(character, flags, state);
		@send self::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(event);
	    
		return TRUE;
	    }

	default:
	    break;
	}
    }

    return @callsuper();

}	/* End of MSG_META_FUP_KBD_CHAR.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_SPEC_BUILD_BRANCH
{
  @callsuper();
  if (@self->HTGI_guessSize) {
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGI_guessSize),
				 DWORD_HEIGHT(@self->HTGI_guessSize));

    @send @genChildren::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGI_guessSize),
					 DWORD_HEIGHT(@self->HTGI_guessSize));
  }
  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row position and X coordinate in that row.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:        THIS IS AN EXCEPTION!
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  VisInstance * vself;
  pos = UpdateItsPotentialPosition(oself, @self->HTGI_content, &row, &size);

  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;
  vself->VI_attrs &= ~VA_DRAWABLE;
  /*
   *  Get an estimate position of the object
   */
  @self->HTGI_xPos = pos; 
  @self->HTGI_pageRow = row;
  @self->HTGI_guessSize = size;

/*  @call self::MSG_VIS_SET_ATTRS(0, VA_DRAWABLE, VUM_DELAYED_VIA_APP_QUEUE);*/
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;

  size = @callsuper();
  if (size == NULL)
      size = MAKE_SIZE_DWORD(26, 26);
      /* 32 and 26 are the size of the checkbox in Penelope SPUI */

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/


@method HTGenInputClass, MSG_VIS_MARK_INVALID
{
