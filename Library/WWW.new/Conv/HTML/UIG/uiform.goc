     */
    @call self::MSG_VIS_OPEN(0);

    return;
}



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Manually position its position.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  VisInstance * vself;

  if (@self->HTGI_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGI_xPos;
  }
  else {
    lineWidth = @call @self->HTGI_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGI_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (@self->HTGI_align == J_RIGHT) {
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGI_xPos);
    }
    else {
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGI_xPos);
    }
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
	(@self->HTGI_content, @self->HTGI_pageRow, oself);

  @callsuper();
/*  @call self::MSG_VIS_SET_ATTRS(VA_DRAWABLE, 0, VUM_DELAYED_VIA_APP_QUEUE);*/

  vself = ObjDerefVis(oself);
  vself->VI_attrs |= VA_DRAWABLE;

  if (@self->HTGI_focalBound.RD_left != 0 &&
      @self->HTGI_focalBound.RD_right != 0 &&
      @self->HTGI_focalBound.RD_top != @self->HTGI_focalBound.RD_bottom) {
      /*
       *  The object currently has a focus.  Update its new position.
       */
      Rectangle rect;
      
      @call self::MSG_VIS_GET_BOUNDS(&rect);
      @self->HTGI_focalBound.RD_left   = rect.R_left-1;
      @self->HTGI_focalBound.RD_right  = rect.R_right+1;
      @self->HTGI_focalBound.RD_top    = rect.R_top-1;
      @self->HTGI_focalBound.RD_bottom = rect.R_bottom;
      @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_UPDATE_FOCUS
	  (@self->HTGI_focalBound);
  }

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


