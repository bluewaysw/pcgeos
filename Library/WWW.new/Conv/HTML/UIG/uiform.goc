/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These would be destroyed when we delete the blocks using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGFT_name)
     * HTMemFree(@self->HTGFT_name);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



/***********************************************************************
 *	if SHORT_LONG_TOUCH
 *		MSG_META_UIG_SHORT_TOUCH_NOTIFY for HTGenFormTriggerClass
 *	else
 *		MSG_META_START_SELECT for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Assemble a query URL of the form:
 *                  action?name=value&name=value&name=value
 *                  ("action" here is the URL specified by the ACTION 
 *                  attribute to the FORM tag, or the current document
 *                  URL if no ACTION attribute was specified.)
 * PARAMETERS:	    
 *	MSG_META_UIG_SHORT_TOUCH_NOTIFY:
 *		void ()
 *	MSG_META_START_SELECT:
 *		void (MouseReturnParams *retVal,
 *		      sword xPosition, sword yPosition,
 *		      word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/18/96   	Initial Revision
 *
 ***********************************************************************/
@if @SHORT_LONG_TOUCH
@method HTGenFormTriggerClass, MSG_META_UIG_SHORT_TOUCH_NOTIFY
{
  SemaphoreHandle sem = uiMgr.UIM_access;

  PUSHDS;
  SET_DS_LIB_DGROUP;

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT) {
      POPDS;
      return;
  }
  if(!uiMgr.UIM_currentDoc ||
    (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
    ThreadVSem(sem);
    POPDS;
    return;
  }

  if (@self->HTGFT_type == TRIGGER_SUBMIT) {
      if (@self->HTGFT_formId > -1) 
	HTML_FORM_SUBMIT(@self->HTGFT_formId, oself);
  } else if(@self->HTGFT_type == TRIGGER_RESET) {
      if (@self->HTGFT_formId > -1) 
	  HTML_FORM_RESET(@self->HTGFT_formId);
  }

  ThreadVSem(sem);
  POPDS;

  return;
}

@method HTGenFormTriggerClass, MSG_META_UIG_LONG_TOUCH_NOTIFY
{
    return;
}
@endif /* SHORT_LONG_TOUCH */


/***********************************************************************
 *		MSG_META_START_SELECT for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Grab the focus, but don't activate hyperlink.
 * PARAMETERS:	    void ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	allen   	11/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_META_START_SELECT
{
  Rectangle rect, box;
  SemaphoreHandle sem = uiMgr.UIM_access;

  @callsuper();

@ifdef PRODUCT_NIKE
  PUSHDS;
  SET_DS_LIB_DGROUP;
@endif

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT) {
@ifdef PRODUCT_NIKE
      POPDS ;
@endif
      return;
  }

  if(!uiMgr.UIM_currentDoc ||
    (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
      ThreadVSem(sem);
      POPDS ;
      return;
  }

  @call self::MSG_VIS_GET_BOUNDS(&rect);
  rect.R_bottom -= 1;
  rect.R_right -= 1;
  box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
  @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
      (oself, rect, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);

@if !@SHORT_LONG_TOUCH
  if (@self->HTGFT_type == TRIGGER_SUBMIT) {
      if (@self->HTGFT_formId > -1) 
	HTML_FORM_SUBMIT(@self->HTGFT_formId, oself);
  } else if(@self->HTGFT_type == TRIGGER_RESET) {
      if (@self->HTGFT_formId > -1) 
	  HTML_FORM_RESET(@self->HTGFT_formId);
  }
@endif /* SHORT_LONG_TOUCH */

  ThreadVSem(sem);
@ifdef PRODUCT_NIKE
  POPDS ;
@endif

}	/* End of MSG_META_START_SELECT.	*/


/***********************************************************************
 *		MSG_META_KBD_CHAR for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	4/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_META_KBD_CHAR
{
    Boolean action = FALSE;

    if(((word)( CS_CONTROL << 8 ) | VC_ENTER ) == character )
	character = VC_BLANK;

    if (VC_BLANK == character) 	action = TRUE;

    @callsuper();

    if(action) {
	if (CF_FIRST_PRESS & flags && @self->HTGFT_formId > -1) {
	    if (@self->HTGFT_type == TRIGGER_SUBMIT)
		HTML_FORM_SUBMIT(@self->HTGFT_formId, oself);
	    else if(@self->HTGFT_type == TRIGGER_RESET)
		HTML_FORM_RESET(@self->HTGFT_formId);
	}
    }

}	/* End of MSG_META_KBD_CHAR.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row number and X position.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  /*
   *  Get an estimate position of the object
   */
  pos = UpdateItsPotentialPosition(oself, @self->HTGFT_content, &row, &size);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGFT_xPos = pos;
  @self->HTGFT_pageRow = row;
  @self->HTGFT_guessSize = size;

  @call self::MSG_VIS_SET_ATTRS(0, VA_DRAWABLE, VUM_DELAYED_VIA_APP_QUEUE);
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/



/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Tell the Geometry Manager to sent 
 *                  MSG_VIS_POSITION_BRANCH instead of calling a routine.
 * PARAMETERS:	    SizeAsDWord (RecalcSizeArgs width, 
 *				RecalcSizeArgs height)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_VIS_RECALC_SIZE
{
  VisCompInstance * vself;
  SizeAsDWord size;

  size = @callsuper();
  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set its new X and Y positions.
 * PARAMETERS:	    (int xOrigin, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGFT_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGFT_xPos;
  }
  else {
    lineWidth = @call @self->HTGFT_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGFT_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (@self->HTGFT_align == J_RIGHT) {
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGFT_xPos);
    }
    else {
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGFT_xPos);
    }
  }

  yOrigin = DWORD_Y(xy) + 
	GetItsPotentialHeight(@self->HTGFT_content,
			      @self->HTGFT_pageRow,
			      oself);
  @callsuper();
  @call self::MSG_VIS_SET_ATTRS(VA_DRAWABLE, 0, VUM_DELAYED_VIA_APP_QUEUE);
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


@method HTGenFormTriggerClass, MSG_VIS_MARK_INVALID
{
  VisCompInstance *vself;
  
  vself = ObjDerefVis(oself);
  if (!(vself->VI_attrs & VA_REALIZED))
    /*
     *  Avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
     */
    @call self::MSG_VIS_OPEN(0);

    return;
}

@ifdef PRODUCT_RESPONDER

/***********************************************************************
 *		MSG_VIS_DRAW for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	4/18/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_VIS_DRAW
{
  Rectangle bound;

  @callsuper();
  @call self::MSG_VIS_GET_BOUNDS(&bound);
  GrSaveState(gstate);
  GrSetLineMaskSys( gstate, SDM_50);
  GrSetMixMode(gstate, MM_COPY);
  GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
  GrDrawRect(gstate, bound.R_left, bound.R_top, 
	     bound.R_right, bound.R_bottom);
  GrRestoreState(gstate);
  return;
}
@endif

