#pragma Code("HTGENTABLE");
#endif
#ifdef __BORLANDC__
#pragma codeseg HTGENTABLE
#endif


/***********************************************************************
 *		MSG_VIS_OPEN for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the VA_MANAGER bit, so the MSG_VIS_RECALC_SIZE
 *                  and MSG_VIS_POSITION_BRANCH will not be sent to
 *                  its children.  I'll do it manually at the right time
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_OPEN
{
  VisCompInstance *vself;

  @callsuper();
  /*
   *  Manage the geometry messagings ourselves.
   */
  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_MANAGED;
  /*
   *  Clear the invalid bits to avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
   */
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH |
			  VOF_IMAGE_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH);

  return;
}	/* End of MSG_VIS_OPEN.	*/


/***********************************************************************
 *	MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find the virtual cell position for the new cell obj.
 *                  (Note, the cell position here is not not the
 *                   absolute screen position, but the cell's
 *                   (row number, column number) position in the table.)
 * PARAMETERS:	    (int *row, int *col, int rowSpan, int colSpan, int width)
 *                  width - the WIDTH attribute of <TH> or <TD>
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    Re-write the previous routine, now use the bitmap.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/29/97   	Initial Revision
 *	
 ***********************************************************************/
dword GetBit(dword cell, int bit)
{
    EC_ERROR_IF(bit > 32 || bit < 0, 1);
    return cell & ShiftBitArray[bit];
}
void SetBits(dword *cell, int bit, int colSpan)
{
    /*
     *  bit - position in dword, 0-based.
     *  colSpan - 1-based.
     */
    word i;
    EC_ERROR_IF(bit < 0 || colSpan <= 0, 1);
    for (i = 0; i < colSpan && (bit+i) < BITS_N_DWORD; i++) {
	*cell |= ShiftBitArray[bit+i];
    }
    return;
}

@method HTGenTableClass, MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION
{
  word index_col, bit_pos, dword_span, dword_pos, i;
  int j;
  tableArray *bitmap;
  ColElement *colArray;

  index_col = @self->HTGT_colNo / BITS_N_DWORD;

  bitmap = (tableArray *)HTMemLock(@self->HTGT_bitmap);
  while (GetBit((*bitmap)[index_col][@self->HTGT_rowNo - 1],
		(@self->HTGT_colNo-1) - 
		(((@self->HTGT_colNo-1) / BITS_N_DWORD)*BITS_N_DWORD))) {
      /*
       *  The cell is occupied, keep search for the next column.
       */
      @self->HTGT_colNo++;
      index_col = @self->HTGT_colNo / BITS_N_DWORD;
      /*
       *  If this cell spans over the array limit, realloc the array.
       */
      if (@self->HTGT_colNo > @self->HTGT_columnSize) {
	/*
	 *  Realloc the array.
	 */
	EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
	j = @self->HTGT_columnSize;
	@self->HTGT_columnSize += (COLUMN_SIZE + @self->HTGT_colNo - j);
	LMemReAllocHandles(HandleOf(oself),
			   @self->HTGT_colWidth, 
			   sizeof(ColElement) * @self->HTGT_columnSize);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
        colArray=(ColElement*)LMemDerefHandles(HandleOf(oself), 
					       @self->HTGT_colWidth);
	for (; j < @self->HTGT_columnSize; j++) {
	    colArray[j].CE_colWidth = 0;
	    colArray[j].CE_spanWidth = 0;
	    colArray[j].CE_colSpan = 0;
	}
      }
      index_col = @self->HTGT_colNo / BITS_N_DWORD;
  }
  /*
   *  Now the suggested (self->HTGT_rowNo, @self->HTGT_colNo) cell
   *  position is available for the assignment.
   */
  *row = @self->HTGT_rowNo;
  *col = @self->HTGT_colNo;
  EC_ERROR_IF(*col > @self->HTGT_columnSize, 1);
  EC_ERROR_IF(*row > @self->HTGT_rowSize, 1);
  /*
   *  Mark the new cell space occupied.
   */
  index_col = (@self->HTGT_colNo-1) / BITS_N_DWORD;
  bit_pos = (@self->HTGT_colNo-1) - 
      (((@self->HTGT_colNo-1) / BITS_N_DWORD)*BITS_N_DWORD);
  dword_span = (colSpan+((int)bit_pos)-1) / ((int)BITS_N_DWORD);

  if (!dword_span) {
    /*  Colspan doesn't cross the dword cell */
    for (; rowSpan > 0; ) {
      SetBits(&((*bitmap)[index_col][@self->HTGT_rowNo-1+rowSpan-1]),
	      bit_pos, colSpan);
      rowSpan--;
    }
  }
  else {
    /*  Colspan  crosses the dword cell */
    dword_pos = (bit_pos + colSpan) - (dword_span * BITS_N_DWORD);
    /* dword_pos 0-based index in the last column cell */
    for (; rowSpan > 0; ) {
      for(i = index_col, j = bit_pos; i < dword_span; i++, j = 1) {
	  SetBits(&((*bitmap)[i][@self->HTGT_rowNo-1+rowSpan-1]),
		  j, BITS_N_DWORD );
      }
      SetBits(&((*bitmap)[i][@self->HTGT_rowNo-1+rowSpan-1]),
	      0, dword_pos);
      rowSpan--;
    }
  }
  /*
   *  Increment the HTGT_colNo for the future cell, if in the same row.
   *  If the future cell is not in the same row, HTGT_colNo will be reset
   *  to 1 by MSG_GEN_TABLE_INCREMENT_ROW_COUNT.
   */
  @self->HTGT_colNo += colSpan;
  /*
   *  If this cell spans over the array limit, realloc the array.
   */
  if (@self->HTGT_colNo > @self->HTGT_columnSize) {
      /*
       *  Realloc the array.
       */
      EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
      j = @self->HTGT_columnSize;
      @self->HTGT_columnSize += (COLUMN_SIZE + @self->HTGT_colNo - j);
      LMemReAllocHandles(HandleOf(oself),
			 @self->HTGT_colWidth, 
			 sizeof(ColElement) * @self->HTGT_columnSize);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      colArray=(ColElement*)LMemDerefHandles(HandleOf(oself), 
					     @self->HTGT_colWidth);
      for (; j < @self->HTGT_columnSize; j++) {
	  colArray[j].CE_colWidth = 0;
	  colArray[j].CE_spanWidth = 0;
	  colArray[j].CE_colSpan = 0;
      }
  }

  HTMemUnlock(@self->HTGT_bitmap);
  if (!width)
      return;
  if (width > 16384)
      width = 16384;  /* MAX_COORD */
  /*
   *  Now we know the cell's position.  Record the cell's WIDTH attribute
   *  in the table object.
   */
  colArray=(ColElement*)LMemDerefHandles(HandleOf(oself),@self->HTGT_colWidth);

  if (width < 0) {
      word tmpWidth;
      if (@self->HTGT_width > 0)
	  tmpWidth = @self->HTGT_width;
      else	
	  tmpWidth = @call pself->HTGT_content::
	      MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE();
      EC_ERROR_IF(tmpWidth <= 0, 1);
      i = ((-(float)width)/100.00) * tmpWidth;
      for (j = 0, dword_pos = 0; dword_pos < (*col-1); dword_pos++)
	  j += colArray[dword_pos].CE_colWidth;
      if (j >= i)
	  /*
	   *  Sorry kid, the previous column is bigger than the parent.
	   *  Thus, 100% for this column is meaningless.
	   */
	  return;
      width = i;
  }

  if (width > 0) {
      int sum, dis, numNoAttr;
      for (sum = 0, numNoAttr = 0, i = *col-1; i < *col-1+colSpan; i++) {
	  if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos))
	      numNoAttr++;
	  sum += colArray[i].CE_colWidth;
      }
      if (width > sum) {
	  if (numNoAttr > 0) {
	      dis = (width - sum) / numNoAttr;
	      for (i = *col-1; i < *col-1+colSpan; i++) {
		  if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos))
		      colArray[i].CE_colWidth += dis;
	      }
	  }
	  else if (colSpan == 1)
	      colArray[*col-1].CE_colWidth = width;
	  if (colSpan == 1)
	      /*
	       *  We set the bit only when we set the CE_coWidth
	       */
	      SetBits(&(@self->HTGT_widthAttr[index_col]), bit_pos, colSpan);
      }
  }
  EC_ERROR_IF(colArray[*col-1].CE_colWidth < 0, 1);

  return;
}	/* End of MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION.	*/



/***********************************************************************
 *	MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Keep track the maxinum size of the biggest table
 *		    cell.
 * PARAMETERS:	    (int row, int height, int rowSpan);
 *		    row - row number of the table cell.
 *		    height - height of the table cell.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT
{
  RowElement *array;

  EC_ERROR_IF(row > @self->HTGT_rowNo, UIG_ERROR_IN_TABLE);
  array=(RowElement *)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);

  if (rowSpan == 1) {
    if (height > array[row - 1].RE_rowHeight)
	array[row - 1].RE_rowHeight = height;
  }
  else {
      EC_WARNING_IF(array[row - 1].RE_rowSpan > 1 &&
		  array[row - 1].RE_rowSpan != rowSpan, 1);
      if (array[row - 1].RE_rowSpan <= rowSpan) {
	  array[row - 1].RE_rowSpan = rowSpan;
	  if (array[row - 1].RE_spanHeight < height)
	      array[row - 1].RE_spanHeight = height;
      }
  }
  /*
   *  If rowSpan > 1, we don't need to bother to distribute the height
   *  among the span rows, because we'll do that later when the table
   *  is set usable.
   */
  return;
}	/* End of MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT. */


/***********************************************************************
 *	MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Given the row and column number, calculate the
 *		    position of that cell, in pixels, relative to (0,0).
 *
 * PARAMETERS:	     (int row, int col, int *xPixel, int *yPixel)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION
{
  int i, j, temp = 0, temp2;
  RowElement *array;
  ColElement *colArray;

  *xPixel = *yPixel = 0;

  /*
   *  Add up row heights and the cellspace.
   */
  array = (RowElement *)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  for (i=0; i < (row-1) && i < @self->HTGT_rowSize; i++) {
      if (array[i].RE_spanHeight > 0 && (i + array[i].RE_rowSpan) < row) {
	  temp = array[i].RE_spanHeight;
	  for (j = i, temp2 = 0; j < i+array[i].RE_rowSpan; j++)
	      temp2 += array[j].RE_rowHeight;
	  if (temp > temp2) {
	      *yPixel += temp;
	      i += (array[i].RE_rowSpan-1);
	  }
	  else {
	      *yPixel += array[i].RE_rowHeight;
	  }
      }
      else
	*yPixel += array[i].RE_rowHeight;
  }

  /*
   *  Add up column widths and the cellspace.
   */
  colArray =(ColElement *)LMemDerefHandles(HandleOf(oself), 
					   @self->HTGT_colWidth);
  for (i=0; i < (col-1) && i < @self->HTGT_columnSize; i++) {
      if (colArray[i].CE_colWidth == 0 && colArray[i].CE_spanWidth > 0 &&
	  (i + colArray[i].CE_colSpan) < col) {
	  temp = (colArray[i].CE_spanWidth + @self->HTGT_cellspacing);
	  for (j = i; j < i+colArray[i].CE_colSpan; j++)
	      temp2 += colArray[i].CE_colWidth;
	  if (temp > temp2) {
	      *xPixel += temp;
	      i += (colArray[i].CE_colSpan-1);
	  }
      }
      else
	*xPixel += (colArray[i].CE_colWidth + @self->HTGT_cellspacing);
  }
  *xPixel += @self->HTGT_cellspacing;

  return;
}	/* End of MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_INCREMENT_ROW_COUNT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Increment the row count whenever <TR> is seen
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Increment the row count.
 *		Reset the column count to 1.
 *		This (row count, column count) will be the table
 *		 position of the next table cell object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 5/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_INCREMENT_ROW_COUNT
{
  int i, pWidth;
  RowElement *array;
  ColElement *colArray;
  word sum, numNoWidthAttr, index_col;
  int dis_w, tmp;
  /*
   *  Reset the position count for the next new table cell.
   */
  @self->HTGT_rowNo++;
  if (@self->HTGT_rowNo > @self->HTGT_rowSize) {
    /*
     *  Realloc the array.
     */
    EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
    i = @self->HTGT_rowSize;
    @self->HTGT_rowSize += (ROW_SIZE + @self->HTGT_rowNo - i);
    LMemReAllocHandles(HandleOf(oself), 
		       @self->HTGT_rowHeight, 
		       sizeof(RowElement) * @self->HTGT_rowSize);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    array=(RowElement*)LMemDerefHandles(HandleOf(oself),@self->HTGT_rowHeight);
    for (; i < @self->HTGT_rowSize; i++) {
	array[i].RE_rowHeight = 0;
	array[i].RE_rowSpan = 0;
	array[i].RE_spanHeight = 0;
    }
  }
  /*
   *  Update the total number of columns in the table.
   */
  if ((@self->HTGT_colNo-1) > @self->HTGT_numCols)
      @self->HTGT_numCols = @self->HTGT_colNo - 1;

  if (@self->HTGT_distrWidth == FALSE && 
      @self->HTGT_rowNo >= 2 && (@call self::MSG_GEN_COUNT_CHILDREN())>1) {
@if 1
    if (!@self->HTGT_width)
	pWidth = @call @self->HTGT_content::
	    MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE();
    else
	pWidth = @self->HTGT_width;
    EC_ERROR_IF(pWidth == 0, 1);
@endif
      /*
       *  In the case the table has WIDTH, and the first row has only one 
       *  cell colspan cross all columns, then I distriube table width
       *  across all columns.  (This fixes www.oracle.com page.)
       */
      colArray = (ColElement *)LMemDerefHandles(HandleOf(oself), 
						@self->HTGT_colWidth);
      tmp = (@self->HTGT_colNo-1 > @self->HTGT_numCols) ?
	  @self->HTGT_colNo-1 : @self->HTGT_numCols;
      for (sum = 0, i = 0; i < tmp; i++)
	  sum += colArray[i].CE_colWidth;
      if (sum < pWidth) {
	for (i = 0, numNoWidthAttr = 0; i < tmp; i++) {
	  index_col = i / BITS_N_DWORD;
	  if (!GetBit(@self->HTGT_widthAttr[index_col], 
		     i-((i/BITS_N_DWORD)*BITS_N_DWORD)))
	      numNoWidthAttr++;
        }
	if (numNoWidthAttr) {
	  dis_w = (pWidth - sum) / numNoWidthAttr;
	  EC_ERROR_IF(dis_w < 0, 1);
	  for (i=0; i < tmp; i++) {
	    index_col = i / BITS_N_DWORD;
	    if (!GetBit(@self->HTGT_widthAttr[index_col], 
	      i-((i/BITS_N_DWORD)*BITS_N_DWORD))) {
	      colArray[i].CE_colWidth += dis_w;
	    }
	  }
        }
      }
      @self->HTGT_distrWidth = TRUE;
  }  
  @self->HTGT_colNo = 1;	/* reset to 1 */
}	/* End of MSG_GEN_TABLE_INCREMENT_ROW_COUNT.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_GET_ROWSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	   Given the starting row number and ROWSPAN, calculate
 *		   the height of the row
 * PARAMETERS:	   (int rowNo, int rowSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:       This can may update the rowHeight array if the passed
 *                 cell have rowspan > 1.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_ROWSPAN_SIZE
{
  int height, i, j, temp;
  RowElement *array;
  int temp2;

  EC_ERROR_IF(rowNo < 1, UIG_ERROR_IN_TABLE);
  array=(RowElement*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);

  /*
   *  The cell is not being spanned by cells above it, so accumulate 
   *  the max heights of rows the passed cell spans.
   */
  for (height = 0, i = rowNo-1; i < rowNo+rowSpan-1 && 
       i < @self->HTGT_rowNo ; i++) { 
      if (array[i].RE_spanHeight > 0 && 
	  (i + array[i].RE_rowSpan) < (rowNo+rowSpan)) {
	  EC_ERROR_IF(array[i].RE_rowSpan < 2, 1);
	  temp = array[i].RE_spanHeight;
	  /*
	   *  accumulate the max heights of the rows that is spanned.
	   */
	  for (j = i, temp2 = 0; j < i+array[i].RE_rowSpan && 
	       j < @self->HTGT_rowNo; j++)
	      temp2 += array[j].RE_rowHeight;
	  
	  if (temp > temp2) {
	      /*
	       *  The spanning cell is taller.  Use the spanHeight,
	       *  and EXTEND the height of the last row spanned.
	       */
	      height += temp;
	      array[j-1].RE_rowHeight += (temp - temp2);
	      i += (array[i].RE_rowSpan-1);
	  }
	  else {
	      /*
	       *  The spanning cell is shorter.  So, let's just accumulate
	       *  the max height of the spaned rows one by one in FOR loop.
	       */
	      height += array[i].RE_rowHeight;
	  }
      }
      else
	  height += array[i].RE_rowHeight;
  }
  EC_ERROR_IF(height < 0, 1);
  return height;
}	/* End of MSG_GEN_TABLE_GET_ROWSPAN_SIZE.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_GET_COLSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	   Given the starting col number and COLSPAN, calculate
 *		   the width of the column
 * PARAMETERS:	   (int colNo, int colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:       This can may update the rowHeight array if the passed
 *                 cell have rowspan > 1.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_COLSPAN_SIZE
{
  int width, i, j, temp;
  ColElement *array;
  int temp2;

  EC_ERROR_IF(colNo < 1, UIG_ERROR_IN_TABLE);
  array=(ColElement*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);

  /*
   *  The cell is not being spanned by cells above it, so accumulate 
   *  the max widths of rows the passed cell spans.
   */
  for (width = 0, i = colNo-1; i < colNo+colSpan-1 ; i++) { 
      if (array[i].CE_spanWidth > 0 && 
	  (i + array[i].CE_colSpan) < (colNo+colSpan)) {
	  EC_ERROR_IF(array[i].CE_colSpan < 2, 1);
	  temp = array[i].CE_spanWidth;
	  /*
	   *  accumulate the max widths of the rows that is spanned.
	   */
	  for (j = i, temp2 = 0; j < i+array[i].CE_colSpan && 
	       j < @self->HTGT_columnSize; j++)
	      temp2 += array[j].CE_colWidth;
	  
	  if (temp > temp2) {
	      EC_WARNING(1);
	      /*
	       *  The spanning cell is wider.  Use the spanHeight,
	       *  and EXTEND the width of the last row spanned.
	       */
	      width += temp;
	      array[j-1].CE_colWidth += (temp - temp2);
	      i += (array[i].CE_colSpan-1);
	  }
	  else {
	      /*
	       *  The spanning cell is narrower.  So, let's just accumulate
	       *  the max width of the spaned rows one by one in FOR loop.
	       */
	      width += array[i].CE_colWidth;
	  }
      }
      else
	  width += array[i].CE_colWidth;
  }
  EC_ERROR_IF(width < 0, 1);
  return width;
}	/* End of MSG_GEN_TABLE_GET_COLSPAN_SIZE.	*/


/***********************************************************************
 *	MSG_GEN_TABLE_GET_SUGGEST_COLSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	  Given the starting column number and COLSPAN, 
 *		  accumlate the widths of the columns that the cell spans.
 * PARAMETERS:	  int (int colNo, int colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_SUGGESTED_COLSPAN_SIZE
{
  int width, index_col, empty, temp = 0, colPos = colNo;
  ColElement *colArray;

  EC_ERROR_IF(colNo < 1, UIG_ERROR_IN_TABLE);

  index_col = colNo / BITS_N_DWORD;
  colArray = (ColElement *)LMemDerefHandles(HandleOf(oself), 
					    @self->HTGT_colWidth);

  if (colSpan > 1 && colArray[colNo-1].CE_colWidth <= 2 &&
      (!(@self->GI_states & GS_USABLE)) && 
      !GetBit(@self->HTGT_widthAttr[index_col], 
	      colNo-((colNo/BITS_N_DWORD)*BITS_N_DWORD))) {
      /* 
       *  This case happens when the first table cell have colspan > 1
       *  right away.  It's pity that we don't have any info about 
       *  previous cells...  sigh...
       *  NOTE:  Table may not have WIDTH value either.
       */
      if (@self->HTGT_numCols)
	  return ((@self->HTGT_width / @self->HTGT_numCols)*colSpan);
      else
	  return (@self->HTGT_width / HEURISTIC);  /* heuristic number */
  }

  if (colSpan > 1 && colArray[colNo-1].CE_spanWidth > 0  &&
      colArray[colNo-1].CE_colSpan == colSpan) {
      temp = colArray[colNo-1].CE_spanWidth;
  }

  for(width=empty= 0, --colNo; colSpan > 0 && colNo < @self->HTGT_columnSize;
      colSpan--, colNo++) {
	EC_ERROR_IF(colArray[colNo].CE_colWidth < 0, 1);
	if (colArray[colNo].CE_colWidth == 0)
	    /* colspan to a column that the previous rows don't have */
	    empty++;
	/* accumulate spaned column widths */
	width += colArray[colNo].CE_colWidth; 
  }
  if (temp > width)
      width = temp;
  else if (empty > 0 && colArray[colPos-1].CE_colSpan == 0) {
      width=0;
  }
  if (width < 0) {
      width = 16384;  /* MAX_COORD */
      EC_WARNING(1);
  }
  if (width <= 1) {
      int tmp = @self->HTGT_width;
      /*
       *  Unfortunately, we're in the first row and don't have any
       *  previous row to give info. .... let's guess size...
       */
      if (colPos <= 1)
	  return tmp / HEURISTIC;  /* heuristic number */
      else
	  return (tmp / colNo);
  }
  EC_ERROR_IF(width < 0, 1);
  return width;
}	/* End of MSG_GEN_TABLE_GET_SUGGESTED_COLSPAN_SIZE.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_SHOW_BORDER for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Does the table have BORDER attribute?
 * PARAMETERS:	    Boolean ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SHOW_BORDER
{
  return @self->HTGT_showBorder;
}	/* End of MSG_GEN_TABLE_SHOW_BORDER.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the width of the column at colPos.  This width
 *		    is the calculated value from the Geometry Manager
 *		    after all its children sizes have been resized.
 *                  Return the maximun width seen so far for this column
 *                  Or the width adjusted for the colSpan.
 * PARAMETERS:	    int (int colPos, int width, word colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
{
  int i, sumWidth, disWidth, sumOfSpanColumns;
  ColElement *colArray;
  int noWidthAttr, sum, /*disWidth,*/ diff;
  optr ch, cell;

  EC_ERROR_IF(colPos < 1, UIG_ERROR_IN_TABLE);
  EC_ERROR_IF(width < 0, UIG_ERROR_IN_TABLE);

  colArray = (ColElement *)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);

  if (colSpan == 1) {
    if (colArray[colPos-1].CE_colWidth < width)
      colArray[colPos-1].CE_colWidth = width;
@if 1
    else if (width < colArray[colPos-1].CE_colWidth) {

      word index_col = (colPos-1) / BITS_N_DWORD;
      word bit_pos = (colPos-1) - (((colPos-1) / BITS_N_DWORD)*BITS_N_DWORD);

      if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos)) {
	/*
	 *  The cell doesn't have WIDTH attribute.
	 *  This cell is an empty cell.  colArray[colPos-1].CE_colWidth
	 *  may be the width distributed from the <TABLE WIDTH> or maybe
	 *  from the max cell width of the previous row.  In case one, we
	 *  can ignore the distributed widht.  In case two, we need to keep
	 *  the colArray[colPos-1].CE_colWidth.  So let's find out by
	 *  scaning all cells in the same column to find the max cell width.
	 */
	optr cell;
	word wdth, height, rs, cs;
	int row, col, index, max, cnt = @call self::MSG_GEN_COUNT_CHILDREN();
	for (index=0, max=0; index < cnt; index++) {
	  cell = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(index);
	  @call cell::MSG_GEN_TCELL_GET_CELL_INFO(&row, &col, &rs, &cs);
	  @call cell::MSG_GEN_HTML_CONTENT_GET_DIMENSION(&wdth, &height);
	  if (cs < 2 && col == colPos) {
	      if (wdth > max)
		  max = wdth;
	  }
	  else if (col+cs-1 == colPos) {
	      int temp2;
	      /*
	       *  a cell that has colspan stops at colPos, so we don't want
	       *  to reduce the size of the colPos column.
	       */
	      sumOfSpanColumns = @call self::MSG_GEN_TABLE_GET_COLSPAN_SIZE
		  (col, cs-1);
	      if (sumOfSpanColumns+width > wdth)
		  /*
		   *  Skip this because the cell needs the last column to
		   *  make up the full spanning width.  Thus, we dont'
		   *  want to take the colPos column into account of
		   *  reducing width.
		   */
		  continue;
	      temp2 = wdth - sumOfSpanColumns;
	      if (temp2 > max)
		  max = temp2;
	  }
        }
	if (max < colArray[colPos-1].CE_colWidth) {
	  /*
	   *  Ok, now we know colArray[colPos-1].CE_colWidth came from
	   *  the distributed width from <TD WIDTH COLSPAN>, let's
	   *  distribute colArray[colPos-1].CE_colWidth to the following
	   *  columns.
	   */
	  EC_ERROR_IF(@self->HTGT_numCols == 0, 1);
	  noWidthAttr = 0; sum = 0; disWidth; diff = 0;
	  for (index=colPos; index < @self->HTGT_numCols; index++) {
	      sum += colArray[index].CE_colWidth;
	      index_col = index / BITS_N_DWORD;
	      bit_pos = index - ((index / BITS_N_DWORD)*BITS_N_DWORD);
	      if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos))
		  noWidthAttr++;
	  }
	  if (noWidthAttr) {
	    if (colArray[colPos-1].CE_spanWidth > 0 &&
		colArray[colPos-1].CE_colSpan > 1) {
		diff = colArray[colPos-1].CE_spanWidth - sum - max;
		if (diff < 0)
		    diff = 0;
	    }
	    disWidth = (colArray[colPos-1].CE_colWidth+diff) / noWidthAttr;
	    for (index=colPos; noWidthAttr && index < @self->HTGT_numCols;
		 index++) {
	      index_col = index / BITS_N_DWORD;
	      bit_pos = index - ((index / BITS_N_DWORD)*BITS_N_DWORD);
	      if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos)) {
		  colArray[index].CE_colWidth += disWidth;
		  noWidthAttr--;
	      }
	    }
	  }
	  /*
	   *  Now it's safe to assign 1 to the empty cell in this column.
	   */
	  colArray[colPos-1].CE_colWidth = max;
	  /*
	   *  Don't let the last columns get too much.
	   */
	  if (@self->HTGT_numCols && colPos+colSpan == @self->HTGT_numCols)
	      @send self::MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
		  (@self->HTGT_numCols, 1, 1);
	}
	if (max > width) {
	    /*
	     *  if width < max, let's find out if the cell contains only
	     *  Image/HR objects.  If so, we want another 
	     *  MSG_GEN_TABLE_INCREMENT_ROW_COUNT to distribute width again.
	     */
	    index = @call oself::MSG_GEN_COUNT_CHILDREN();
	    cell=@call oself::MSG_GEN_FIND_CHILD_AT_POSITION(index-1);
	    index = @call cell::MSG_GEN_COUNT_CHILDREN();
	    for (i = 0; i < index; i++) {
		ch = @call cell::MSG_GEN_FIND_CHILD_AT_POSITION(i);
		if(!@call ch::MSG_META_IS_OBJECT_IN_CLASS(&GenGlyphClass))
		    break;
	    }
	    if (i && i == index)
		@self->HTGT_distrWidth = FALSE;
	}
      }
    }
@endif
    EC_ERROR_IF(colArray[colPos-1].CE_colWidth < 0, 1);
  } /* ----------------------- End of colspan == 1 -------------------- */ 
  else {
    /* ----------------------- Start of colSpan > 1 ------------------- */
    /*
     *  Distribute the width if the cell is wider than the columns
     *  spanned.
     */
    for (i=colPos-1, sumWidth=0; 
	 i < (colPos-1+colSpan) && i < @self->HTGT_colNo;
	 i++)
	sumWidth += colArray[i].CE_colWidth;
    if (sumWidth && sumWidth < width) {
	/*
	 *  Oh oh...  We need to distribute the width to make spanned
	 *  columns wider.
	 */
	disWidth = (width - sumWidth) / colSpan;
    }
    else {
	if (colArray[colPos-1].CE_colSpan > 1 && 
	    colArray[colPos-1].CE_colSpan < colSpan) {
	    /*
	     *  Previous row had rowspan different from the passed one.
	     *  Let's make sure the previous rowspan are distributed.
	     */
	    int dis, cnt, index_col, bit_pos;
	    /*  
	     *  calculate the distributed width among cells that have no 
	     *  WIDTH attribute, starting from colPos position.
	     */
	    for (i = colPos, cnt=0; 
		 i < colPos+colArray[colPos-1].CE_colSpan -1 &&
		 i < @self->HTGT_columnSize; i++) {
		index_col = i / BITS_N_DWORD;
		bit_pos = i - ((i / BITS_N_DWORD)*BITS_N_DWORD);
		if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos)) {
		    cnt++;
		}
	    }
	    if (cnt) {
		/*
		 *  Distribute the span width, starting from colPos.
		 */
		dis = colArray[colPos-1].CE_spanWidth / cnt;
		for (i = colPos; 
		     i < colPos+colArray[colPos-1].CE_colSpan -1 &&
		     i < @self->HTGT_columnSize; i++) {
		    index_col = i / BITS_N_DWORD;
		    bit_pos = i - ((i / BITS_N_DWORD)*BITS_N_DWORD);
		    if (!GetBit(@self->HTGT_widthAttr[index_col], bit_pos))
			colArray[i].CE_colWidth += dis;
		}
	    }
	    EC_ERROR_IF(colSpan < 2, 1);
	    colArray[colPos-1].CE_colSpan = colSpan;
	    colArray[colPos-1].CE_spanWidth = width;
        }
	else if (colArray[colPos-1].CE_colSpan < colSpan) {
	    colArray[colPos-1].CE_colSpan = colSpan;
	    colArray[colPos-1].CE_spanWidth = width;
	}
	else if (colArray[colPos-1].CE_colSpan == colSpan &&
		 colArray[colPos-1].CE_spanWidth < width) {
	    colArray[colPos-1].CE_spanWidth = width;
	}
	return;
    }
    if (disWidth) {
      /*
       *  There is enough disWidth to distribute to all spanning columns.
       */
      for (i=colPos-1;
	   i < (colPos - 1 + colSpan) && i < @self->HTGT_colNo;
	   i++) {
	  EC_ERROR_IF(colArray[i].CE_colWidth < 0, 1);
	  EC_ERROR_IF(disWidth < 0, 1);
	  colArray[i].CE_colWidth += disWidth;
      }
    }
    else {
      /*
       *  Not enough distribute pixels to distribute to all spanning 
       *  columns.  So distribute one pixel to each spanning column until
       *  it's running out of distributed width.
       */
      disWidth = width - sumWidth;   /* edwinu disWidth == 2*MARGIN */
      EC_ERROR_IF(disWidth >= colSpan || disWidth <= 0, 1);
      for (i=colPos-1; disWidth && 
	   i < (colPos - 1 + colSpan) && i < @self->HTGT_colNo;
	   i++) {
	  EC_ERROR_IF(colArray[i].CE_colWidth < 0, 1);
	  EC_ERROR_IF(disWidth < 0, 1);
	  colArray[i].CE_colWidth += 1;
	  disWidth--;
      }
      EC_ERROR_IF(i == @self->HTGT_colNo && disWidth, 1);
    }
    if (colArray[colPos-1].CE_colSpan == colSpan &&
	colArray[colPos-1].CE_spanWidth > width)
	;
    else {
	colArray[colPos-1].CE_colSpan = colSpan;
	colArray[colPos-1].CE_spanWidth = width;
    }
  }
  return;
}	/* End of MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_RECALC_POSITIONS for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Re-position table cells because the passed cell
 *                  changed the size.
 * PARAMETERS:	    (optr cell, SizeAsDWord newSize, 
 *                   word rowSpan, word colSpan)
 *                  cell - the table cell whose size changed
 *                  newSize - new size of the passed table cell.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_RECALC_POSITIONS
{
  int row, col;
  RowElement *rowArray;
  ColElement *colArray;
  word i, sum, rowSpan, colSpan;
  SizeAsDWord actualSize;
  int r, c, newHeight, newWidth, index, cnt;
  word rs, cs;
  SizeAsDWord size;

  @call cell::MSG_GEN_TCELL_GET_CELL_INFO(&row, &col, &rowSpan, &colSpan);

  /*
   *  (row, col) of the table cell whose size changes.
   */
  colArray = (ColElement *)LMemDerefHandles(HandleOf(oself),
					    @self->HTGT_colWidth);
  rowArray=(RowElement*)LMemDerefHandles(HandleOf(oself),@self->HTGT_rowHeight);

  if (colArray[col-1].CE_colWidth < DWORD_WIDTH(newSize) && colSpan == 1) {
      EC_ERROR_IF(DWORD_WIDTH(newSize) < 0, 1);
      colArray[col-1].CE_colWidth = DWORD_WIDTH(newSize);
  }
  else if (colArray[col-1].CE_colWidth < DWORD_WIDTH(newSize) && colSpan > 1) {
    for (i = col-1, sum=0; i < (col-1+colSpan) && i<@self->HTGT_columnSize; i++)
	sum += colArray[i].CE_colWidth;
    if(sum < DWORD_WIDTH(newSize)) {
	    colArray[i-1].CE_colWidth += (DWORD_WIDTH(newSize) - sum);
    }
    /*
     *  if (sum > DWORD_WIDTH(newSize)), there is no need to update the array.
     */
  }

  if (rowArray[row-1].RE_rowHeight < DWORD_HEIGHT(newSize) && rowSpan == 1)
      rowArray[row-1].RE_rowHeight = DWORD_HEIGHT(newSize);
  else if (rowArray[row-1].RE_rowHeight &&
	   rowArray[row-1].RE_rowHeight<DWORD_HEIGHT(newSize) && rowSpan > 1) {
    for (i = row-1, sum=0; i < (row-1+rowSpan) && i<@self->HTGT_rowSize; i++)
	sum += rowArray[i].RE_rowHeight;
    if (sum < DWORD_HEIGHT(newSize)) {
	if (i > 1 && rowArray[i-1].RE_rowHeight <= 1) {
	    /*
	     *  This is to prevent the case when the row heightArray[i-1]
	     *  is empty and not worthy to expand it.
	     */
	    EC_WARNING(1);
	    rowArray[i-2].RE_rowHeight += (DWORD_HEIGHT(newSize) - sum);
	}
	else
	    rowArray[i-1].RE_rowHeight += (DWORD_HEIGHT(newSize) - sum);
    }
  }
  /*
   *  Rsize all cells in the current row or column.
   */
  cnt = @call self::MSG_GEN_COUNT_CHILDREN();
  for (index = 0 ;index < cnt; index++) {
      cell = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(index);
      EC_ERROR_IF(cell == 0, 1);
      @call cell::MSG_GEN_TCELL_GET_CELL_INFO(&r, &c, &rs, &cs);
      if (r == row || r == (row+rowSpan-1) || row < (r+rs) ||
	  c == col || c == (col+colSpan-1) || col < (c+cs)) {
	  newHeight = @call self::MSG_GEN_TABLE_GET_ROWSPAN_SIZE(r, rs);
	  newWidth = @call self::MSG_GEN_TABLE_GET_COLSPAN_SIZE(c, cs);
	  actualSize = @call cell::MSG_VIS_GET_SIZE();
	  if (newHeight > DWORD_HEIGHT(actualSize)) {
	      @call cell::MSG_VIS_SET_SIZE(DWORD_WIDTH(actualSize), newHeight);
	      actualSize = MAKE_SIZE_DWORD(DWORD_WIDTH(actualSize), newHeight);
	  }
	  if ( newWidth > DWORD_WIDTH(actualSize))
	      @call cell::MSG_VIS_SET_SIZE(newWidth, DWORD_HEIGHT(actualSize));
      }
  }

  size = @call self::MSG_VIS_RECALC_SIZE(RSA_CHOOSE_OWN_SIZE,
						     RSA_CHOOSE_OWN_SIZE);
  @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(size),
			       DWORD_HEIGHT(size));

  return;
}	/* End of MSG_GEN_TABLE_RECALC_POSITIONS.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_SHRINK_ROW for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    The cell has becomes wider and shorter, thus may
 *                  possibly cause the table row to shrink.
 *                  Return how much it had shrank in height.
 * PARAMETERS:	    (optr cell, SizeAsDWord newSize)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	11/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SHRINK_ROW
{
  int row, col, tmpRow, tmpCol, maxHeight, index;
  word i, dummy, width, height, rowSpan, colSpan, tmpRowSpan;
  optr tmpObj, firstObj;
  RowElement *rowArray;
  SizeAsDWord tmpSize;
  VisInstance *vself;

  @call cell::MSG_GEN_TCELL_GET_CELL_INFO(&row, &col, &rowSpan, &colSpan);
  /*
   * Find the first object in the same table row as the passed cell.
   */
  tmpObj = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(0);
  for (i = 1; tmpObj; i++) {
      @call tmpObj::MSG_GEN_TCELL_GET_CELL_INFO
	  (&tmpRow, &tmpCol, &tmpRowSpan, &dummy);
      if (tmpRow == row)
	  /*  Found it! */
	  break;
      tmpObj = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(i);
  }
  EC_ERROR_IF(tmpObj == NULL, 1);
  index = i;
  firstObj = tmpObj;
  /*
   *  Scan all table cells in the same row for the tallest object.
   */
  for (maxHeight = 0; tmpObj; i++) {
      if (tmpObj != cell) {
        @call tmpObj::MSG_GEN_HTML_CONTENT_GET_DIMENSION(&width, &height);
	if (height > maxHeight && tmpRowSpan == 1)
	  maxHeight = height;
      }
      tmpObj = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(i);
      @call tmpObj::MSG_GEN_TCELL_GET_CELL_INFO
	  (&tmpRow, &tmpCol, &tmpRowSpan, &dummy);
      if (tmpRow > row)
	  /* reached the last object in the row. */
	  break;
  }
  if (maxHeight < DWORD_HEIGHT(newSize) && rowSpan == 1)
      maxHeight = DWORD_HEIGHT(newSize);
  /*
   *  Go back to the first object in the row to set-size.
   */
  EC_ERROR_IF(@call self::MSG_GEN_FIND_CHILD_AT_POSITION(index-1) != 
	     firstObj,1);
  vself = ObjDerefVis(oself);
  for (tmpObj = firstObj; tmpObj; index++) {
      @call tmpObj::MSG_GEN_TCELL_GET_CELL_INFO
	  (&tmpRow, &tmpCol, &tmpRowSpan, &dummy);
      if (tmpRow > row)
	  /*  reached the last cell in the row */
	  break;
      tmpSize = @call tmpObj::MSG_VIS_GET_SIZE();
      if (tmpRowSpan == 1 && DWORD_HEIGHT(tmpSize) != maxHeight)
        @call tmpObj::MSG_VIS_SET_SIZE(DWORD_WIDTH(tmpSize), maxHeight);
      if (@call tmpObj::MSG_VIS_GET_POSITION() != NULL)
	  /* Fixed the position of the expanded text object when vis-opening
	     a cached page. */
	  @call tmpObj::MSG_VIS_POSITION_BRANCH(0,0);
      tmpObj = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(index);
  }
  /*
   *  Update the row height in the array.
   */
  rowArray=(RowElement*)LMemDerefHandles(HandleOf(oself),@self->HTGT_rowHeight);
  width = rowArray[row-1].RE_rowHeight - maxHeight;
  /*
   *  Here I borrowed the variable 'width' to store the difference.
   *  It doesn't really mean width of anything.
   */
  if (width > 0) {
      rowArray[row-1].RE_rowHeight = maxHeight;
      if(DWORD_HEIGHT(@self->HTGT_guessSize) > width)
	  @self->HTGT_guessSize = 
	      MAKE_SIZE_DWORD(DWORD_WIDTH(@self->HTGT_guessSize),
			      DWORD_HEIGHT(@self->HTGT_guessSize)-width);
  }
  return width;
}	/* End of MSG_GEN_TABLE_SHRINK_ROW.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_EXPAND_ROW_HEIGHTS for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    (word row, word span, word hgt)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_EXPAND_ROW_HEIGHT
{
  RowElement *array;
  word i, sum;

  array =(RowElement*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);

  for (i = row-1, sum=0; i < (row-1+span) && i < @self->HTGT_rowNo; i++)
    sum += array[i].RE_rowHeight;

  EC_ERROR_IF(sum > hgt, 1);

  array[i-1].RE_rowHeight += (hgt - sum);
  return;
}	/* End of MSG_GEN_TABLE_EXPAND_ROW_HEIGHTS.	*/


/***********************************************************************
 *		MSG_VIS_SET_SIZE for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Update HTGT_guessSize.  Needed when "Go Back" and
 *                  re-construct the page.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	11/30/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_SET_SIZE
{
    @self->HTGT_guessSize = MAKE_SIZE_DWORD(width, height);
    @callsuper();
    return;
}	/* End of MSG_VIS_SET_SIZE.	*/


#ifdef __HIGHC__
#pragma Code("HTGENTCELL");
#endif
#ifdef __BORLANDC__
#pragma codeseg HTGENTCELL
#endif


/***********************************************************************
 *		MSG_GEN_TCELL_PROCESS_ATTRIBUTE for HTGenTCellClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the TR element
 * PARAMETERS:	    int (MemHandle block, SGMLEntity *entity, int type, 
 *                       int *rowSpan, *colSpan, int width)
 *		    if type is non-zero, it's <TH>, else it's <TD> cell.
 *		    return colspan number
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		Supported Attr:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_GEN_TCELL_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j, valign = 1, span;
  Boolean percent = FALSE;
  Justification just = J_LEFT;

  @self->HTGTC_rowSpan = @self->HTGTC_colSpan = 1;
  *width = 0;

  if (type) {
    @self->HTGTC_cellType = CELL_HEADER;
    just = J_CENTER;
}
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_ALIGN:                                  /* ALIGN */
      if (strcasecmp(value, "left") == 0)
	just = J_LEFT;
      else if (strcasecmp(value, "center") == 0)
	just = J_CENTER;
      else if (strcasecmp(value, "right") == 0)
	just = J_RIGHT;
      break;
    case HTML_ATTR_VALIGN:                                 /* VALIGN */
      if (strcasecmp(value, "top") == 0)
	valign = 0;
      else if (strcasecmp(value, "middle") == 0)
	valign = 1;
      else if (strcasecmp(value, "bottom") == 0)
	valign = 2;
      break;
    case HTML_ATTR_ROWSPAN:                                /* ROWSPAN */
      span = atoi(value);
      if (span > 0 && span < BITMAP_X * BITS_N_DWORD)
	  @self->HTGTC_rowSpan = span;
      break;
    case HTML_ATTR_COLSPAN:                                /* COLSPAN */
      span = atoi(value);
      if (span > 0 && span < BITMAP_X * BITS_N_DWORD)
	  @self->HTGTC_colSpan = span;
      break;
    case HTML_ATTR_WIDTH:                                  /* WIDTH */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE)
	  *width = @self->HTGTC_width = atoi(value);
      else {
	  *width = -atoi(value);
	  if (*width < -100)
	      *width = -100;
      }
      /* negative value means % */
      break;
    }
  }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (just == J_RIGHT || just == J_CENTER)
      @send self::MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION(just);      

  switch (valign) {
    case 0:		/* top align */
/*      @send self::MSG_META_ADD_VAR_DATA
	(HINT_TOP_JUSTIFY_CHILDREN,0,NULL); */
      break;
    case 1:		/* center align */
/*      @send self::MSG_META_ADD_VAR_DATA
	(HINT_CENTER_CHILDREN_VERTICALLY, 0, NULL); */
      break;
    case 2:		/* bottom align */
/*      @send self::MSG_META_ADD_VAR_DATA
	(HINT_BOTTOM_JUSTIFY_CHILDREN, 0, NULL); */
      break;
  }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  /*
   *  Initialize the height array.
   */
  @send self::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();

  *rowSpan = @self->HTGTC_rowSpan;
  *colSpan = @self->HTGTC_colSpan;

  return;
}


/***********************************************************************
 *		MSG_VIS_OPEN for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the VA_MANAGER bit, so the MSG_VIS_RECALC_SIZE
 *                  and MSG_VIS_POSITION_BRANCH will not be sent to
 *                  its children.  I'll do it manually at the right time
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTCellClass, MSG_VIS_OPEN
{
  VisCompInstance *vself;

  @callsuper();

  /*
   *  Manage the geometry messagings ourselves.
   */
  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_MANAGED;
  /*
   *  Clear the invalid bits to avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
   */
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH |
			  VOF_IMAGE_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH);
  return;
}	/* End of MSG_VIS_OPEN.	*/



/***********************************************************************
 *		MSG_GEN_TCELL_SET_CELL_POSITION for HTGenTCellClass
 ***********************************************************************
