/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenTableClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These would be destroyed when we delete the blocks using
     * HTObjDestroyAllWID.
     *
     * LMemFreeHandles(HandleOf(oself), @self->HTGT_rowHeight);
     * LMemFreeHandles(HandleOf(oself), @self->HTGT_colWidth);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * UICreateObj.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



@if 1
/***********************************************************************
 *		MSG_VIS_MARK_INVALID for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Forget about this routine.  It will slow down system
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/28/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_MARK_INVALID
{
  VisCompInstance *vself;
  
  vself = ObjDerefVis(oself);
  if (!(vself->VI_attrs & VA_REALIZED))
      @call self::MSG_VIS_OPEN(0);
  return;
}	/* End of MSG_VIS_MARK_INVALID.	*/
@endif


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/31/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGT_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
  }
  else {
    lineWidth = @call @self->HTGT_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGT_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
    else if (@self->HTGT_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGT_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGT_xPos);
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
      (@self->HTGT_content, @self->HTGT_pageRow, oself);

  @call self::MSG_VIS_SET_POSITION(xOrigin, yOrigin);

  /*
   *  Because all TCell objects have VA_MANAGED bit cleared, we have to
   *  manually broadcast this message.
   */
  @send @genChildren::MSG_VIS_POSITION_BRANCH(0,0);

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenTableClass
 ***********************************************************************
