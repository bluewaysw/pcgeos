/***********************************************************************
 * MSG_GEN_TCELL_SET_MAX_ROW_WIDTH_NEW_HEIGHT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    (int row, int width, int height);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	11/20/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTCellClass, MSG_GEN_TCELL_SET_MAX_ROW_WIDTH_N_NEW_HEIGHT
{
  int diff, i, cnt;
  word tmp;
  
  HTListGetItem(@self->HTGHC_rowArray, row, &tmp, sizeof(int));
  if (tmp < width) {
    /*
     *  Update the new width.
     */
    HTListReplaceItem(@self->HTGHC_rowArray, row, &width, sizeof(int));
    if (@self->HTGHC_maxRowWidth < width)
	@self->HTGHC_maxRowWidth = width;
    /*
     *  Update the new height.
     */
    if (row == 0)
	tmp = MARGIN;
    else
	HTListGetItem(@self->HTGHC_heightArray, row-1, &tmp, sizeof(word));
    
    height += (tmp+MARGIN);
    HTListGetItem(@self->HTGHC_heightArray, row, &tmp, sizeof(word));
    diff = height - tmp;

    /* Changed compare from 0 to MARGIN: can have MARGIN height with nothing
     * in it.  jb 6/8/98
     */
    EC_ERROR_IF(diff > MARGIN, 1);
    if (diff < 0) {
	cnt = HTListGetCount(@self->HTGHC_heightArray);
	for (i = row; i < cnt; i++) {
	    HTListGetItem(@self->HTGHC_heightArray, i, &tmp, sizeof(word));
	    tmp += diff;
	    EC_ERROR_IF(tmp < 0, 1);
	    HTListReplaceItem(@self->HTGHC_heightArray, i, &tmp, sizeof(word));
	}
	EC_ERROR_IF(cnt != HTListGetCount(@self->HTGHC_rowArray), 1);
	if (i == cnt) {
	    @self->HTGHC_sumOfHeights = tmp;
	    /*
	     *  Tell the cell that during its MSG_VIS_SPEC_BUILD_BRANCH
	     *  need to shrink the row.
	     */
	    @self->HTGTC_resize = TRUE;
	}
    }
  }
  return;
}	/* End of MSG_GEN_TCELL_SET_MAX_ROW_WIDTH_N_NEW_HEIGHT.	*/


/***********************************************************************
 *		MSG_GEN_TCELL_SET_ROW_RESIZE for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:        Shrink a table cell height by moving up the rows in
 *                  the table cell.
 * PARAMETERS:	    (optr child, int diff)
 *                  child -- the table child that shrank in height.
 *                  diff  -- how much the table had shrank.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	11/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTCellClass, MSG_GEN_TCELL_SET_ROW_RESIZE
{
  int i, row, totalCnt;
  word oldHeight;
  SizeAsDWord size;

  @self->HTGTC_resize = TRUE;
  EC_ERROR_IF(!@call child::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTableClass), 1);

  row = @call child::MSG_UI_GET_ROW_POSITION();
  totalCnt = HTListGetCount(@self->HTGHC_heightArray);

  EC_ERROR_IF(diff < 0, 1);

  for (i = row; i < totalCnt; i++) {
    HTListGetItem(@self->HTGHC_heightArray, i, &oldHeight, sizeof(word));
    oldHeight -= diff;
    EC_ERROR_IF(oldHeight < 0, 1);
    HTListReplaceItem(@self->HTGHC_heightArray,i,&oldHeight,sizeof(word));
  }
  EC_ERROR_IF(i != totalCnt, 1);
  @self->HTGHC_sumOfHeights = oldHeight;

  return;
}	/* End of MSG_GEN_TCELL_SET_ROW_RESIZE.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/31/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  VisCompInstance * vself;
  SizeAsDWord size;

  if (@self->HTGT_numCols && @self->HTGT_distrWidth == FALSE)
      /*
       *  If the last cell in the table doesn't end at the last column,
       *  we need to send a the following message with a minimum width
       *  for the last column, so that the last column has a chance to
       *  reduce to its minimum width.
       */
      @call self::MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH(@self->HTGT_numCols,1,1);

  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  pos = UpdateItsPotentialPosition(oself, @self->HTGT_content, &row, &size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_xPos = pos;
  @self->HTGT_pageRow = row;
  @self->HTGT_guessSize = size;
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_RECALC_SIZE
{
  int i, j, temp;
  RowElement *array;
  ColElement *colArray;
  /*
   *  All the children under the table cell have calculate its size.
   *  Thus, HTGT_rowHeight and HTGT_colWidth contain the updated 
   *  infomation, which we can use to shrink the table cell tight to 
   *  contain all the children objects.
   */
  array =(RowElement*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  for (i=0, height=0; i <= @self->HTGT_rowNo && i<@self->HTGT_rowSize; i++){
      if (array[i].RE_rowSpan > 1 && array[i].RE_spanHeight > 0) {
	  for (j=i, temp=0; j < i+array[i].RE_rowSpan; j++)
	      temp += array[j].RE_rowHeight;
	  if (temp < array[i].RE_spanHeight) {
	      height += array[i].RE_spanHeight;
	      i += (array[i].RE_rowSpan - 1);
	  }
	  else
	      height += array[i].RE_rowHeight;
      }
      else
	  height += array[i].RE_rowHeight;
  }
  colArray = (ColElement *)LMemDerefHandles(HandleOf(oself),
					    @self->HTGT_colWidth);
  for (i=0, width = 0; (i < (@self->HTGT_colNo-1) || i < @self->HTGT_numCols) 
       && i < @self->HTGT_columnSize; i++) {
      if (colArray[i].CE_colSpan > 1 && colArray[i].CE_spanWidth > 0) {
	  for (j=i, temp=0; j < i+colArray[i].CE_colSpan; j++)
	      temp += colArray[j].CE_colWidth;
	  if (temp < colArray[i].CE_spanWidth) {
	      width += colArray[i].CE_spanWidth;
	      i += (colArray[i].CE_colSpan - 1);
	  }
	  else
	      width += colArray[i].CE_colWidth;
      }
      else
	width += colArray[i].CE_colWidth;
  }

  return MAKE_SIZE_DWORD(width + @self->HTGT_cellspacing,
			 height+ @self->HTGT_cellspacing);
}	/* End of MSG_VIS_RECALC_SIZE.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_SPEC_BUILD_BRANCH
{
  /* 
   *  While children are building branch, they may shrink the rows!
   */
  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGT_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGT_guessSize),
				 DWORD_HEIGHT(@self->HTGT_guessSize));
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if(@self->HTGT_bitmap) {
      HTMemFree(@self->HTGT_bitmap);
      @self->HTGT_bitmap = NULL;
  }

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



