  LMemFreeHandles(HandleOf(oself), @self->HTGT_colWidth);

  @callsuper();

  return;
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Disable the 3-D border when printing.
 * PARAMETERS:	    (DrawFlags drawFlags, GStateHandle gstate = bp)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 7/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_DRAW
{
  @callsuper();
  if (@self->HTGT_showBorder == TRUE) {
      VisCompInstance * vself;
      vself = ObjDerefVis(oself);
      /*
       *  Draw the bound.
       */
      GrSaveState(gstate);
      GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
      GrDrawLine(gstate, vself->VI_bounds.R_left, vself->VI_bounds.R_bottom,
		 vself->VI_bounds.R_right, vself->VI_bounds.R_bottom);
      GrDrawLine(gstate, vself->VI_bounds.R_right, vself->VI_bounds.R_top,
		 vself->VI_bounds.R_right, vself->VI_bounds.R_bottom);
      GrRestoreState(gstate);
  }
  return;
}	/* End of MSG_VIS_DRAW.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_SHOULD_EXPAND for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Does the table have WIDTH attribute or is it in
 *                  a table cell?  If so, the table should expand to
 *                  its full width.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	11/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SHOULD_EXPAND
{
  if (@self->HTGT_width) {
      ColElement *colArray;
      word sum, i;

      colArray = (ColElement *)LMemDerefHandles(HandleOf(oself), 
						@self->HTGT_colWidth);
      for (sum = 0, i = 0; i < @self->HTGT_colNo-1; i++)
	  sum += colArray[i].CE_colWidth;
      if (sum <= @self->HTGT_width-20) {
	/* 20 may not big enough to do the effort of expanding */
	  @self->HTGT_distrWidth = FALSE;
	  return TRUE;
      }
  } else if (@call @genParent::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
      optr grandma = @call @genParent::MSG_GEN_FIND_PARENT();
      if (@call grandma::MSG_GEN_COUNT_CHILDREN() > 1) {
	  /*
	   *  If child count == 1, that means this nested table is
	   *  the first child of the parent table cell.  In that
	   *  case, we want to make sure that there was a previous
	   *  chlid so that the parent cell have some value for the
	   *  column width.  Otherwise, the nested table would expand
	   *  the parent table cell for no good reason.
	   */
	  return TRUE;
      }
  }

  
  return FALSE;
}	/* End of MSG_GEN_TABLE_SHOULD_EXPAND.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Calculate its row number and X position.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_UI_CALC_SIZE_POSITION
{
  VisCompInstance * vself;
  word width, height;
  int nextRow;

  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  /*
   *  Finish the last row info.
   */
  @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  /*
   *  Get the sum of heights in this cell's height array.
   *  Get the width of the widest row in this cell.
   */
  @call self::MSG_GEN_HTML_CONTENT_GET_DIMENSION(&width, &height);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  /*
   *  Update the table's height and width.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  @call @genParent::MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT
      (	@self->HTGTC_rowPos, height, @self->HTGTC_rowSpan);
  @call @genParent::MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
      (@self->HTGTC_colPos, width, @self->HTGTC_colSpan);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  @self->HTGTC_guessSize = MAKE_SIZE_DWORD(width, height);

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTCellClass, MSG_SPEC_BUILD_BRANCH
{
  int newHeight, newWidth, diff;
  optr parent = NULL, grandma;
  /*
   *  Let system build the branch first.
   */
  @callsuper();

  /*
   *  The cell had shrunk before due to its some text object expand in
   *  width and shrank in height.
   */
  if (@self->HTGTC_resize == TRUE && @self->HTGTC_rowSpan == 1) {
    parent = @call self::MSG_GEN_FIND_PARENT();
    diff = @call parent::MSG_GEN_TABLE_SHRINK_ROW
	(oself, MAKE_SIZE_DWORD(@self->HTGHC_maxRowWidth,
				@self->HTGHC_sumOfHeights));
  }

  /*
   *  Figure out the dimension based on the its rowHeight array.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  newHeight = @call @genParent::MSG_GEN_TABLE_GET_ROWSPAN_SIZE
      (@self->HTGTC_rowPos, @self->HTGTC_rowSpan);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  newWidth = @call @genParent::MSG_GEN_TABLE_GET_COLSPAN_SIZE
      (@self->HTGTC_colPos, @self->HTGTC_colSpan);

  @call self::MSG_VIS_SET_SIZE(newWidth, newHeight);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGHC_maxRowWidth = newWidth;

  /*
   *  Set the size of the cell according to 
   */
  @self->HTGTC_guessSize = MAKE_SIZE_DWORD(newWidth, newHeight);

  if (parent && diff) {
    grandma = @call parent::MSG_GEN_FIND_PARENT();
    if (@call grandma::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass))
	@call grandma::MSG_GEN_TCELL_SET_ROW_RESIZE(parent, diff);
    else if (@call grandma::MSG_META_IS_OBJECT_IN_CLASS
	     (&PresentationManagerClass))
	@call (uiMgr.UIM_currentDoc)->HTUI_pmContent::
	    MSG_GEN_HTML_CONTENT_SET_ROW_RESIZE(parent, diff);
  }

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenTCellClass
 ***********************************************************************
 * SYNOPSIS:	Intercept this message and ask its parent, which is
 *		a table object, for its position(in pixels).  Also,
 *		set its vis bound if this cell spans rows or columns.
 * PARAMETERS:	    void (int xOrigin, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord position;

  /*
   *  Get the parent's absolute position in pixels.
   */
  position = @call @genParent::MSG_VIS_GET_POSITION();

  /*
   *  Ask the parent the (left, top) position, relatvie to the table's 
   *  origin, given row number and column number.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @call @genParent::MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION
      (@self->HTGTC_rowPos, @self->HTGTC_colPos, &xOrigin, &yOrigin);

  /*
   *  Calculate the cell's (left, top) absolute position, in pixels.
   */
  xOrigin += DWORD_X(position);
  yOrigin += DWORD_Y(position);

  @call self::MSG_VIS_SET_POSITION(xOrigin, yOrigin);

  /*
   *  Because all TCell objects have VA_MANAGED bit cleared, we have to
   *  manually broadcast this message.
   */
  @send @genChildren::MSG_VIS_POSITION_BRANCH(0,0);

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTCellClass, MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE
{
  word width;

  if (@self->HTGTC_width)
      width = @self->HTGTC_width;
  else
      width = @call @genParent::MSG_GEN_TABLE_GET_SUGGESTED_COLSPAN_SIZE
	  (@self->HTGTC_colPos, @self->HTGTC_colSpan);
  if (width <= 0) 
      /* 
       *  Table and table cell don't have WIDTH value!  Thus, let it
       *  have all the screen width.
       */
      width = (X_SCREEN_SIZE - MARGIN - MARGIN) / 2;

  return width;
}	/* End of MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Disable the 3-D border when printing.
 * PARAMETERS:	    (DrawFlags drawFlags, GStateHandle gstate = bp)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 7/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_VIS_DRAW
{
  @callsuper();
  if (@call @genParent::MSG_GEN_TABLE_SHOW_BORDER() == TRUE) {
      VisCompInstance * vself;
      vself = ObjDerefVis(oself);
      /*
       *  Draw the bound.
       */
      GrSaveState(gstate);
      GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
      GrDrawRect(gstate, vself->VI_bounds.R_left, vself->VI_bounds.R_top,
		 vself->VI_bounds.R_right, vself->VI_bounds.R_bottom);
      GrRestoreState(gstate);
  }
  return;
}	/* End of MSG_VIS_DRAW.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenTCellClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * If we delete something here, make sure to add to list in 
     * UICreateObj.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/




/***********************************************************************
 *		  InitializeTableCellCommon
 ***********************************************************************
 * SYNOPSIS:	Create a HTGenTCellClass object.
 * CALLED BY:	Common function called by <TH> and <TD> msg handlers.
 * RETURN:	optr table - HTGenTable object.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 4/96   	Initial Revision
 *
 ***********************************************************************/
optr 
InitializeTableCellCommon (HTUIDoc *doc, ObjInfo *target)
{
  optr table;
@ifdef TRUNK
  Rectangle rect;
@endif
  /*
   *  Insert whatever object in target to the ui tree, and trace back
   *  up the tree to find the first table ui object.
   */
  @call doc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ(target->obj);

  if (target->class != (ClassStruct *)&HTGenTableClass) {
    while (1) {
	@call doc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(target->obj),&(target->class));
	/*
	 * Now target->obj has PManager's recvObj.
	 */
	EC_ERROR_IF(target->class == NULL || target->obj == NULL ||
	    target->class == (ClassStruct *)&HTGenTextClass,
	    UIG_INVALID_OPERATION_ON_UI_TREE);
	if (target->class == (ClassStruct *)&HTGenTableClass)
		break;
    }
  }
  /*
   * Now we know PManager's recvObj must be a HTGenTable object.
   */
  EC_ERROR_IF(target->class != (ClassStruct *)&HTGenTableClass,
	UIG_UI_TREE_OPERATION_FAILS);

  /*
   * Now create a table cell object.
   */
  table = target->obj;
  target->obj = UICreateObj(&HTGenTCellClass);
  target->class = (ClassStruct *)&HTGenTCellClass;

  /*
   * Add HINTs
   */
  if ((@call table::MSG_GEN_TABLE_SHOW_BORDER()) == TRUE) {
    @send target->obj::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
@ifdef TRUNK
@ifndef	BROTHER_KERNEL
    rect.R_left = -7;
    rect.R_top = -7;
    rect.R_right = -1;
    rect.R_bottom= -7;
    @send target->obj::MSG_META_ADD_VAR_DATA
       (HINT_CUSTOM_EXTRA_MARGINS, sizeof(Rectangle), &rect);
@endif
@endif
  }
  TrMode = FALSE;

  return table;
}	/* End of   InitializeTableCellCommon.	*/


