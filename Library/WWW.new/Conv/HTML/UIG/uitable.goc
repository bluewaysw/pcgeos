   *  Ask the table ui object for the cell position for this new
   *  table cell object.  Table object will use the suggested
   *  column count and take into account any nearby cells that span 
   *  over rows or columns to calculate the actual cell position.
   */
  @call table::MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION
      (&row, &col, rowSpan, colSpan, width);

  /*
   * Set its cell position.
   */
  @call (uiMgr.UIM_currentDoc)->HTUI_target.obj::MSG_GEN_TCELL_SET_CELL_POSITION(row, col);

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		MSG_GEN_TABLE_PROCESS_ATTRIBUTE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the TABLE element
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *	Supported Attr:
 *		BORDER
 *		CELLPADDING = n
 *		CELLSPACING = n
 *		WIDTH = n | n%
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j, i;
  ColElement  *colArray;
  RowElement  *array;
  float per;
  Boolean percent;
  ChunkHandle chunk;
  Justification just;
  word br;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   *  Table doesn't care about <NOBR> because it always starts at a new line.
   */
  just = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);

  for(index = 0; entity[index].SGMLE_token; index++) {
    /*
     *  Border can have no value.  It's a special case.
     */
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_token == HTML_ATTR_BORDER) {
	@self->HTGT_showBorder = TRUE;
	@send self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
      }
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_BORDER:                       /* BORDER */
      if (*value != '0') {
	@self->HTGT_showBorder = TRUE;
	@send self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
      }
      break;
    case HTML_ATTR_WIDTH:                        /* WIDTH */
      /*
       *  Checking for % sign.
       */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE) {
	@self->HTGT_width = atoi(value);         /* No percent sign */
	if (@self->HTGT_width > 1000)
	    @self->HTGT_width = 1000;
      }
      else {
	  if ((per = atoi(value)) >= 100) {
	    per = 100;
	    break;
	  }  
	@self->HTGT_width = (per / 100.00) * 
	DWORD_WIDTH(@call content::MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE());
      }
      break;
    case HTML_ATTR_CELLPADDING:                  /* CELLPADDING */
/*      @self->HTGT_cellpadding = atoi(value); */
      break;
    case HTML_ATTR_CELLSPACING:                  /* CELLSPACING */
/*      @self->HTGT_cellspacing = atoi(value); */
      break;
    case HTML_ATTR_ALIGN:
      /*
       *  Overwrite the default alignment of the content.
       */
      if (strcasecmp(value, "center") == 0)
	  just = J_CENTER;
      else if (strcasecmp(value, "right") == 0)
	  just = J_RIGHT;
      else
	  just = J_LEFT;
      break;
    }
  }
  @self->HTGT_align = just;

  /*
   *  No 3-D look.
  @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_FLAT,0,NULL);
   */
  /*
   *  Initialize the row and column array.
   */
  chunk = LMemAlloc(HandleOf(oself), sizeof(RowElement)*ROW_SIZE);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_rowHeight = chunk;
  array=(RowElement*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  @self->HTGT_rowSize = ROW_SIZE;
  for (i=0; i < ROW_SIZE; i++) {
      array[i].RE_rowHeight = 0;
      array[i].RE_rowSpan = 0;
      array[i].RE_spanHeight = 0;
  }

  chunk = LMemAlloc(HandleOf(oself), sizeof(ColElement)*COLUMN_SIZE);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_colWidth = chunk;
  colArray = (ColElement*)LMemDerefHandles(HandleOf(oself), 
					   @self->HTGT_colWidth);
  @self->HTGT_columnSize = COLUMN_SIZE;
  for (i=0; i < COLUMN_SIZE; i++) {
      colArray[i].CE_colWidth = 0;
      colArray[i].CE_spanWidth = 0;
      colArray[i].CE_colSpan = 0;
  }

  @self->HTGT_content = content;
  /*
   *  Initially not in any row.
   */
  @self->HTGT_pageRow = -1;

  @self->HTGT_bitmap =
      HTMemAllocWID((uiMgr.UIM_currentDoc)->HTUI_memID, 
		    sizeof(dword)*BITMAP_X*BITMAP_Y*BITS_N_DWORD);

  @self->HTGT_colNo = 1;	/* reset to 1 */

  return;
}	/* End of MSG_GEN_TABLE_PROCESS_ATTRIBUTE.	*/

