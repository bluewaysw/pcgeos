/***********************************************************************
 *		UIGen_START_CAPTION_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a ui representing the caption for a table.
 *	
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_CAPTION_Int
		(MemHandle block, SGMLEntity *entity)
{
  int index;
  char *value, align = 0;
  optr caption, content;

  /*
   *  Process its attribute list.
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (entity[index].SGMLE_token == HTML_ATTR_ALIGN) {
      if (entity[index].SGMLE_value) {
	value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
	if (strcasecmp(value, "top") == 0)
	    align = 0;
	else if (strcasecmp(value, "bottom") == 0)
	    align = 1;
      }
    }
  }
  /*
   *  Finished whatever object is there.
   */
  @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
      ((uiMgr.UIM_currentDoc)->HTUI_target.obj);
  /*
   *  Create a caption object and switch PM's PM_receiving object.
   */
  caption = UICreateObj(&HTGenCaptionClass);

  content = UIGen_GET_CONTENT_Int();
  /*
   *  If content is table cell, it's not the right object I want to put
   *  caption under.  In this case, I'm looking for the content object of
   *  table.
   */
  if (0) {
  if (@call content::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
    content = @call content::MSG_GEN_FIND_PARENT();
    while(!@call content::MSG_META_IS_OBJECT_IN_CLASS
	  (&PresentationManagerClass)){
	if (@call content::MSG_META_IS_OBJECT_IN_CLASS
	    (&HTGenHtmlContentClass)) {
	    /* 
	     * add the new text format to the content object.
	     */
	    break;
	}
	content = @call content::MSG_GEN_FIND_PARENT();
    }
}
    if (@call content::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass))
	content = (uiMgr.UIM_currentDoc)->HTUI_pmContent;
  }

  /*
   *  Tell the PM to save the current receiving object, and back 
   *  up the ui tree to the same level as the table, and add the
   *  caption object before or after(depending align) the table 
   *  object.
   */
  @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_ENTER_CAPTION_MODE
      (&HTGenTableClass, align, caption);
  @call caption::MSG_GEN_CAPTION_SAVE_UIG_STATE
      ((uiMgr.UIM_currentDoc)->HTUI_target.obj, (uiMgr.UIM_currentDoc)->HTUI_target.class, content, align);
  /*
   *  Initialize the height array in the caption.
   */
  @send caption::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();

  (uiMgr.UIM_currentDoc)->HTUI_target.obj = caption;
  (uiMgr.UIM_currentDoc)->HTUI_target.class = &HTGenCaptionClass;

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		UIGen_END_CAPTION_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/ 7/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_CAPTION_Int()
{
  optr dummy;
  ClassStruct *class;

  if (!(uiMgr.UIM_currentDoc)->HTUI_target.obj)
    return UI_GEN_ERROR;
  /*
   *  Finish whatever current object.
   */
  @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	((uiMgr.UIM_currentDoc)->HTUI_target.obj);
  /*
   *  Traverse up the ui tree to the caption level.
   */
  if ((uiMgr.UIM_currentDoc)->HTUI_target.class != (ClassStruct *)&HTGenCaptionClass) {
    while (1) {
      @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
		(&((uiMgr.UIM_currentDoc)->HTUI_target.obj),&((uiMgr.UIM_currentDoc)->HTUI_target.class));
      EC_ERROR_IF((uiMgr.UIM_currentDoc)->HTUI_target.obj == NULL ||
		(uiMgr.UIM_currentDoc)->HTUI_target.class==(ClassStruct*)&HTGenTextClass,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if ((uiMgr.UIM_currentDoc)->HTUI_target.class == (ClassStruct *)&HTGenCaptionClass){
        break;
      }
    }
  }

  EC_ERROR_IF((uiMgr.UIM_currentDoc)->HTUI_target.class!=(ClassStruct*)&HTGenCaptionClass,
	      UIG_INVALID_OPERATION_ON_UI_TREE);
  /*
   *  And make the caption subtree usable.
   */
  @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_NOT_DONE(&dummy, &class);

  /*
   *  Tell the PM to restore the receiving object to what it was 
   *  before the caption object was created.
   */
  @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_EXIT_CAPTION_MODE();
  @call (uiMgr.UIM_currentDoc)->HTUI_target.obj::MSG_GEN_CAPTION_RESTORE_UIG_STATE
	(&dummy,&class);

  (uiMgr.UIM_currentDoc)->HTUI_target.obj   = dummy;
  (uiMgr.UIM_currentDoc)->HTUI_target.class = class;

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_CAPTION_Int.	*/


/***********************************************************************
 *		MSG_GEN_CAPTION_SAVE_UIG_STATE for HTGenCaptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Save the UIGenerator's target object before entering
 *                  <CAPTION> mode.  It will be restored back after
 *                  exiting <CAPTION> mode.
 * PARAMETERS:	    (optr obj, ClassStruct *class)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/14/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenCaptionClass, MSG_GEN_CAPTION_SAVE_UIG_STATE
{
  word br;

  @self->HTGC_targetObj = obj;
  @self->HTGC_targetClass = class;
  @self->HTGC_content = content;
  @self->HTGC_valign = align;
  @self->HTGC_pageRow = -1;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGC_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  /*
   *  caption doesn't care about <NOBR> because it always starts at a new line.
   */

  return;
}	/* End of MSG_GEN_CAPTION_SAVE_UIG_STATE.	*/


/***********************************************************************
 *		MSG_GEN_CAPTION_RESTORE_UIG_STATE for HTGenCaptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Restore UIGenerator's target object after exiting
 *                  <CAPTION> mode.
 * PARAMETERS:	    void.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/14/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenCaptionClass, MSG_GEN_CAPTION_RESTORE_UIG_STATE
{
  *obj = @self->HTGC_targetObj;
  *class = @self->HTGC_targetClass;
  return;
}	/* End of MSG_GEN_CAPTION_RESTORE_UIG_STATE.	*/


/***********************************************************************
 *		MSG_GEN_CAPTION_GET_ALIGN for HTGenCaptionClass
 ***********************************************************************
