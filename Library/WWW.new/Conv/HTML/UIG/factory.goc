/***********************************************************************
 *		UIGetFocusImage
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	10/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
optr _far _pascal
UIGetFocusImage ()
{
    optr ret = 0, target;
    word index;
    HTListHandle list;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(uiMgr.UIM_currentDoc) 
	ret = uiMgr.UIM_currentDoc->PM_focalImage;

    /* 
     * remove this image from the image list, so later Load All will not
     *  load it again.
     */
    if(ret) {
	target = @call ret::MSG_GEN_IMAGE_GET_TARGET();
	list = uiMgr.UIM_currentDoc->HTUI_imageList;
	index = HTListFindItem(list, &target, sizeof(optr));
	if(index != -1) HTListRemoveItem(list, index, &ret, sizeof(optr));
    }

    POPDS;
    return ret;
}	/* End of UIGetFocusImage.	*/


optr _far _pascal
UIGetNextImage ()
{
    HTListHandle list;
    word count;
    optr image;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    list = uiMgr.UIM_currentDoc->HTUI_imageList;
    count  = HTListGetCount(list);

    if(!list || !count) 
	image = 0;
    else 
	HTListRemoveItem(list, 0, &image, sizeof(optr));

    POPDS;
    return image;
}	/* End of UIGetFocusImage.	*/


Boolean _far _pascal
UIUnloadImage()
{
    HTListHandle list;
    word count;
    Boolean ret = FALSE;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(uiMgr.UIM_currentDoc) {
	list = uiMgr.UIM_currentDoc->HTUI_imageList;
	if(list && HTListGetCount(list))
	    ret = TRUE;
    }

    POPDS;
    return ret;
}


HTMemHandle _far _pascal 
UIGetFocusLink()
{
    HTMemHandle ret = 0;
    word len;
    char *url;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(uiMgr.UIM_currentDoc && 
       uiMgr.UIM_currentDoc->PM_focalLink != -1 && 
       uiMgr.UIM_currentDoc->PM_hrefs) {
	len = HTListGetItemSize((uiMgr.UIM_currentDoc)->PM_hrefs, 
				(uiMgr.UIM_currentDoc)->PM_focalLink);
	url = HTMemAllocAndLock(&ret, len + 1);
	HTListGetItem((uiMgr.UIM_currentDoc)->PM_hrefs, 
		      (uiMgr.UIM_currentDoc)->PM_focalLink,
		      url, len);
	*(url + len) = 0;
	HTMemUnlock(ret);
    }

    POPDS;

    return ret;
}


int _far _pascal 
UIGetRefreshTimeAndURL(HTMemHandle *newURL)
{
    word ret = -1;
    char *url, *ptr;
    HTMemHandle mh;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(uiMgr.UIM_currentDoc && uiMgr.UIM_currentDoc->HTUI_newURL) {
	ret = uiMgr.UIM_currentDoc->HTUI_refreshTime;
	/*
	 * 25/11/97. We don't want the same document refresh twice 
	 * (use Back, Forward, or from Histroy),
	 * so we clean these fields at the first time.
	 */
	*newURL = uiMgr.UIM_currentDoc->HTUI_newURL;
	uiMgr.UIM_currentDoc->HTUI_newURL = 0;

	/*
	 * Probably we can tolerate missing time.
	 */
	if(ret == -1) ret = 0;
    } /* else 
       *
       * And also, we don't want to refresh to the same doc.
       *
       * *newURL = UIDocCurrentURL();
       *
    } */

    if(uiMgr.UIM_currentDoc)
	uiMgr.UIM_currentDoc->HTUI_refreshTime = -1;

    POPDS;

    return ret;
}


HTMemHandle _far _pascal 
UIDocGetFormQuery()
{
    HTMemHandle ret = 0;
    word len;
    char *url;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(ThreadPTimedSem(uiMgr.UIM_access, 1) != SE_TIMEOUT) {
	if(uiMgr.UIM_currentDoc) {
	    ret = uiMgr.UIM_formQuery; 
	    uiMgr.UIM_formQuery = 0;
	}
	ThreadVSem(uiMgr.UIM_access);
    }

    POPDS;

    return ret;
}


VMFileHandle _far _pascal
UIDocCurrentVMFileHandle()
{
    VMFileHandle ret;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(uiMgr.UIM_currentDoc && uiMgr.UIM_currentDoc->HTUI_anchor) 
	ret = uiMgr.UIM_currentDoc->HTUI_vmFileHandle;
    else
	ret = 0;

    POPDS;
    return ret;
}	/* End of UICurrentBaseURL.	*/

