/***********************************************************************
 *		UIDocCopySelected
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/19/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
UIDocCopySelected ()
{
    PUSHDS;
    SET_DS_LIB_DGROUP;

    if(uiMgr.UIM_currentDoc && uiMgr.UIM_currentDoc->HTUI_pmanager) 
	@send (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_COPY_SELECTED_OBJECTS();

    POPDS;
}	/* End of UIDocCopySelected.	*/


/***********************************************************************
 *		UIDocMemoryNeeded
 ***********************************************************************
 *
 * SYNOPSIS:	Tally the amount of memory used so far.
 * CALLED BY:	Client
 * RETURN:	dword, document width, and document height.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/20/97   	Initial Revision
 *	
 ***********************************************************************/
dword _far _pascal
UIDocMemoryNeeded (word *width, word *height)
{
    dword ret;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    ret = uiMgr.UIM_memoryAllocated;
    @call (uiMgr.UIM_currentDoc)->HTUI_pmContent::MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS
	(width, height);

    POPDS;
    return ret;
}	/* End of UIDocMemoryNeeded.	*/



/***********************************************************************
 *		UIDocAddMemory
 ***********************************************************************
 *
 * SYNOPSIS:	Add needed UI memory for a document.
 * CALLED BY:	Internal to UIGenerator
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/21/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
UIDocAddMemory (dword len)
{
    PUSHDS;
    SET_DS_LIB_DGROUP;
    /* No need to push and pop DS as called from UIGenerator */
    uiMgr.UIM_memoryAllocated += len;
    POPDS;
}	/* End of UIDocAddMemory.	*/


void cleanFormQuery()
{
    word i, count;
    HTMemHandle temp = 0;

    if(uiMgr.UIM_formQuery) {
	count = HTListGetCount(uiMgr.UIM_formQuery);
	for(i=0; i<count; i ++) {
	    HTListGetItem(uiMgr.UIM_formQuery, i, &temp, sizeof(HTMemHandle));
	    if (i!=1 && temp) HTMemFree(temp);
	    temp = 0;
	}
	HTListDelete(uiMgr.UIM_formQuery);
    }

    uiMgr.UIM_formQuery = 0;
}
