@include <WWW/htconv.goh>
@include <WWW/HTCore/htreq.goh>

/***********************************************************************
 *		SETTARGETBITMAP
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	GifToBitmap
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	2/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
SETTARGETBITMAP (optr htobject, VMFileHandle vmFile, VMBlockHandle bitmap,
		 HTRequestHandle request)
{
    @send htobject::MSG_HTC_SET_TARGET_BITMAP(vmFile, bitmap, request);
}	/* End of SETTARGETBITMAP.	*/

/***********************************************************************
 *		SETTARGETSIZE
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	2/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
SETTARGETSIZE (optr htobject, word width, word height)
{
    @send htobject::MSG_HTC_SET_TARGET_SIZE(width, height);
}	/* End of SETTARGETSIZE.	*/

/***********************************************************************
 *		CALLRESIZE
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	2/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
CALLRESIZE (optr htobject)
{
    @send htobject::MSG_HTC_CALL_RESIZE();
}	/* End of CALLRESIZE.	*/


