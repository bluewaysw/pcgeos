PROJECT:        Geos WWW Library
MODULE:         htmem
FILE:           htmem.goc

AUTHOR:         Mingzhe Zhu, Jan  7, 1997

ROUTINES:
	Name                    Description
	----                    -----------

REVISION HISTORY:
	Name    Date            Description
	----    ----            -----------
	mzhu    1/ 7/97         Initial version.

DESCRIPTION:

	This is a thread-safe and deadlock-free memory manager.
	It simulates flat memory model. There is no need for memory
	deferencing once a HTMemHandle is lock.

	$Id: htmem.goc,v 1.14.2.7 97/10/06 12:48:43 kkee Exp $

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/
@include <stdapp.goh>
#include <sysstats.h>                 /* If don't include, end up calling 
					 asm SysGetInfo */
#include <sem.h>
#include <heap.h>
#include <WWW/htmem.h> 
#include <Ansi/string.h>              /* memcpy */
#include "htfatals.h"

#ifdef __HIGHC__
#pragma Code ("HTMEMCODE");
#endif
#ifdef __BORLANDC__
#pragma codeseg HTMEMCODE
#endif

/* 
 * Memory low limits. These limits are checked in HTMemoryLimit and
 * enforced by all HTMemory APIs.
 */
#define HTMEMORY_HEAP_LOW_LIMIT        20000         /* in bytes */
#define HTMEMORY_SWAP_LOW_LIMIT        50000         /* in bytes */


/* Macros to access library dgroup */
#ifdef __HIGHC__

#ifndef PUSHDS
#define PUSHDS	_inline(0x1e)	/* push	ds */
#endif

#ifndef POPDS
#define POPDS	_inline(0x1f)	/* pop	ds */
#endif

#endif

#ifdef __BORLANDC__

#ifndef PUSHDS
#define PUSHDS  asm{push ds}
#endif

#ifndef POPDS
#define POPDS   asm{pop  ds}
#endif

#endif

#ifndef SET_DS_LIB_DGROUP
#define SET_DS_LIB_DGROUP GeodeLoadDGroup (GeodeGetCodeProcessHandle())
                                /* destroys ds! */
#endif

#define DESIRED_HTMEM_BLOCK_SIZE  0x1000  /* 4K bytes */

#if ERROR_CHECK
FatalErrors htmemFatalErrors;
Warnings    htmemWarnings;
#endif

/* the data struct for the list */
typedef struct {
    MemHandle          HTMS_memHandle;	/* LMem block handle */
    word               HTMS_id;         /* for APIs ending with ...WID */
    SemaphoreHandle    HTMS_sem;
    word	       HTMS_count;      /* number of HTMemories in this block */
} HTMemStruct;

/* use chunk array to implement the list */
static ChunkHandle ListChunkHandle = NullHandle;
static MemHandle   ListMemHandle = NullHandle;

/* some data for debug purpose */
#if ERROR_CHECK
static word ecPeakNum = 0;	/* the max number of blocks we allocated */
#endif

/* tally amount of memory allocated using HTMem */
static dword htMemAllocated = 0;

static word _pascal HTMemID (HTMemHandle htmh);
static void * _pascal
    HTMemAllocAndLockLow (word id, HTMemHandle *htmh, word size);
static void _pascal HTMemFreeLow (HTMemHandle htmh, Boolean unlock);
static HTMemHandle _pascal
    HTMemReallocLow (word id, HTMemHandle htmh, word size);


/***********************************************************************
 *		HTMemID
 ***********************************************************************
 *
 * SYNOPSIS:	Find the ID of a HTMemory.
 * CALLED BY:	EC code.
 * RETURN:	word.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
static word _pascal
HTMemID (HTMemHandle htmh)
{
    HTMemStruct *mb;
    int i, count;
    word sz;
    MemHandle mh = OptrToHandle(htmh);
    word ret = 0;

    PUSHDS;
    SET_DS_LIB_DGROUP;
    ECCheckMemHandle(ListMemHandle);

    MemPLock(ListMemHandle);
    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);
    
    for(i=0; i<count; i++) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);
	if (mb->HTMS_memHandle == mh) {
	    /* Found the block */
	    ret = mb->HTMS_id;
	    break;
	}
    }

    MemUnlockV(ListMemHandle);

    POPDS;

    return ret;
}	/* End of HTMemID.	*/



/***********************************************************************
 *		HTMemAllocAndLockLow
 ***********************************************************************
 *
 * SYNOPSIS:	Internal routine for allocating and locking. 
 * CALLED BY:	HTMemAllocAndLock, HTMemAlloc, HTMemAllocWID
 * RETURN:	
 *	
 * STRATEGY:	We assign an ID to each allocated block. Blocks with
 *              different IDs are not shared when allocation a HTMemory.
 *	
 *	check the blocks in the list to find one unlocked and size less
 *	   than our limit,
 *	if did not find, create a new block to use,
 *	allocate a new chunk in the block,
 *	every chunk has a one byte header to count the lock number for 
 *	   this chunk.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
static void * _pascal
HTMemAllocAndLockLow (word id, HTMemHandle *htmh, word size)
{
    HTMemStruct *mb;
    word sz, count;
    int i;
    word flag_and_lock;
    ChunkHandle retChunk;
    MemHandle retMem = NullHandle;
    SemaphoreHandle sem;
    byte *head;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    ECCheckMemHandle(ListMemHandle);

    /* exclusive access to the list */
    MemPLock(ListMemHandle);

    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);
    
    /* find a unlocked block. */
    for(i=count-1; i>=0; i--) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);

	/* blocks with different IDs are not shared */
	if (mb->HTMS_id != id) continue;

	/* to prevent other users to access the data when alloc...*/
	sem = mb->HTMS_sem;
	ThreadPSem(sem);

	flag_and_lock = 
		MemGetInfo(mb->HTMS_memHandle, MGIT_FLAGS_AND_LOCK_COUNT);

	if(!MGI_LOCK_COUNT(flag_and_lock)) {/* this block is unlocked.!! */

	    /* check if its size is too large  */
	    sz = MemGetInfo(mb->HTMS_memHandle, MGIT_SIZE);
	    if(sz < DESIRED_HTMEM_BLOCK_SIZE) {
		retMem = mb->HTMS_memHandle;
		break;
	    }
	}
	ThreadVSem(sem);
    }
	
    if(!retMem) {       /* didn't find a unlocked block */
	retMem = MemAllocLMem(LMEM_TYPE_GENERAL, sizeof(LMemBlockHeader));
	HandleModifyOwner(retMem, GeodeGetCodeProcessHandle());
    	MemModifyFlags(retMem, HF_SHARABLE, 0);

	/* add this block to the list */
	mb = ChunkArrayAppendHandles(ListMemHandle,
					ListChunkHandle, 0);
	mb->HTMS_memHandle = retMem;
	mb->HTMS_id = id;
	mb->HTMS_sem = ThreadAllocSem(1);
	HandleModifyOwner(mb->HTMS_sem, GeodeGetCodeProcessHandle());
	mb->HTMS_count = 0;
	sem = mb->HTMS_sem;
	ThreadPSem(sem);

EC(	ecPeakNum ++;							)
    }

    mb->HTMS_count ++;

    MemLock(retMem);
    /* allocate the chunk, which has a one byte header to count the lock num */
    retChunk = LMemAlloc(retMem, size + sizeof(byte));

    /* after alloc, others can access this block */
    ThreadVSem(sem);

    /* create the return optr */
    *htmh = ConstructOptr(retMem, retChunk);

    /* initalize the new chunk with all 0 */
    head = LMemDeref(*htmh);
    for(i=0; i<size+sizeof(byte); i++) *(head + i) = 0;
    (*head) = 1;

    head += 1;

    /* Tally allocated memory */
    htMemAllocated += size;

    /* don't need the list anymore */
    MemUnlockV(ListMemHandle);

    POPDS;

    return (void*)head;
}	/* End of HTMemAllocAndLockLow.	*/


/***********************************************************************
 *		HTMemReallocLow
 ***********************************************************************
 *
 * SYNOPSIS:	Internal routine to reallocate a HTMemHandle. id is used
 *              destroy all HTMemories with the same ID.
 * CALLED BY:	HTMemRealloc, HTMemReallocWID
 * RETURN:	
 *	
 * STRATEGY:	Since all allocated HTMemories belong to some block
 *              which maybe locked, we have to free htmh and 
 *              allocate a new HTMemory if resize to larger.
 *              Otherwise resize it to smaller as it won't affect
 *              other HTMemories in the same block.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
static HTMemHandle _pascal
HTMemReallocLow (word id, HTMemHandle htmh, word size)
{
    HTMemHandle ret = htmh;
    byte *c, *p;
    word sz;

    c = (byte *) HTMemLock(htmh);
    sz = LMemGetChunkSize(htmh);
    sz--;           /* The first byte keeps count of locks */

EC( if (*(c-1) > 0x01) EC_ERROR(CANNOT_REALLOC_LOCKED_HTMEMORY);       )

    if (size < sz) {
	/* Make it smaller */
	LMemReAlloc(htmh, size+1); /* Needs an extra byte for lock count */
	HTMemUnlock(htmh);

    } else if (size > sz) {
	/* 
	 * Allocate a new HTMemory, copy data over, 
	 * and delete old HTMemory. 
	 */
	p = (byte *) HTMemAllocAndLockLow(id, &ret, size);
	memcpy(p, c, sz);
	HTMemUnlock(ret);
	HTMemUnlockAndFree(htmh);

    } else {
	/* Same size, do nothing */
	HTMemUnlock(htmh);
    }

    PUSHDS;
    SET_DS_LIB_DGROUP;
    /* Tally allocated memory by HTMem */
    htMemAllocated = htMemAllocated + size - sz;
    if ((sdword)htMemAllocated < 0) htMemAllocated = 0;
    POPDS;

    return ret;
}	/* End of HTMemReallocLow.	*/




/***********************************************************************
 *              ECCHECKHTMEMHANDLE
 ***********************************************************************
 *
 * SYNOPSIS:    Check HTMemory.
 * CALLED BY:   internal
 * RETURN:      
 * SIDE EFFECTS:
 *      
 * STRATEGY:	Dies if htmh is not a HTMemory.
 *      
 * REVISION HISTORY:
 *      Name    Date            Description
 *      ----    ----            -----------
 *      kkee    9/17/96         Initial Revision
 *
 ***********************************************************************/
void _far _pascal
ECCHECKHTMEMHANDLE (HTMemHandle htmh)
{
#if ERROR_CHECK
    MemHandle block; 
    word count, i, sz;
    HTMemStruct *mb;

    PUSHDS;
    SET_DS_LIB_DGROUP;
    
    MemPLock(ListMemHandle);
    block = OptrToHandle(htmh);

    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);
    if(count > ecPeakNum) ecPeakNum = count;			
    
    /* find the block entry in the list */    
    for(i=0; i<count; i++) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);

	if(mb->HTMS_memHandle == block) {
	    MemUnlockV(ListMemHandle);
	    POPDS;
	    return;
	}
    }
    MemUnlockV(ListMemHandle);

    EC_ERROR(INVALID_HTMEMORY);
    
    POPDS;
#endif
}       /* End of ECCHECKHTMEMHANDLE.   */




/***********************************************************************
 *              HTMemLibraryEntry
 ***********************************************************************
 *
 * SYNOPSIS:    Initialize a list to hold blocks that will be allocated.
 * CALLED BY:   Kernel
 * RETURN:      0, required by Kernel to indicate all is well.
 * SIDE EFFECTS:
 *      
 * STRATEGY:
 *      
 * REVISION HISTORY:
 *      Name    Date            Description
 *      ----    ----            -----------
 *      mzhu    1/ 7/97         Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTMEMLIBRARYENTRY (LibraryCallType ty, GeodeHandle client)
{
    if(ty == LCT_ATTACH) {
	ListMemHandle = MemAllocLMem(LMEM_TYPE_GENERAL,
					sizeof(LMemBlockHeader));
	HandleModifyOwner(ListMemHandle, GeodeGetCodeProcessHandle());
    	MemModifyFlags(ListMemHandle, HF_SHARABLE, 0);

	MemLock(ListMemHandle);
	ListChunkHandle = ChunkArrayCreate(ListMemHandle, 
				sizeof(HTMemStruct), 
				sizeof(ChunkArrayHeader),
				0);
	MemUnlock(ListMemHandle);

    } else if (ty == LCT_DETACH) {
	MemFree(ListMemHandle);
	ListMemHandle = NullHandle;

    }

    return 0;
}       /* End of HTMemLibraryEntry.    */



/***********************************************************************
 *		HTMEMALLOCANDLOCK
 ***********************************************************************
 *
 * SYNOPSIS:	Allocate a HTMemory and lock it.
 * CALLED BY:	Global
 * RETURN:	far pointer to HTMemory (valid htmh) OR
 *              or NULL (htmh is also NULL) for out of memory.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/14/97   	Initial Revision
 *
 ***********************************************************************/
void * _far _pascal
HTMEMALLOCANDLOCK (HTMemHandle *htmh, word size)
{
    return HTMemAllocAndLockLow(0, htmh, size);
}	/* End of HTMEMALLOCANDLOCK.	*/


/***********************************************************************
 *		HTMEMALLOCANDLOCKWID
 ***********************************************************************
 *
 * SYNOPSIS:	Same as HTMemAllocAndLock, but with ID. The ID is used
 *              to destroy HTMemories using HTMemFreeAllWID. 
 * CALLED BY:	Client
 * RETURN:	far pointer to HTMemory (valid htmh) OR
 *              NULL (htmh is also NULL) for out of memory.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
void * _far _pascal
HTMEMALLOCANDLOCKWID (word id, HTMemHandle *htmh, word size)
{
#if ERROR_CHECK
    if ((id == HTMID_BASE) || (id >= HTMID_END))
	EC_ERROR(INVALID_ID_FOR_HTMEMORY);        
#endif
    return HTMemAllocAndLockLow(id, htmh, size);
}	/* End of HTMEMALLOCANDLOCKWID.	*/




/***********************************************************************
 *              HTMEMALLOC
 ***********************************************************************
 *
 * SYNOPSIS:    Allocate a HTMemory.
 * CALLED BY:   Global
 * RETURN:      HTMemHandle or NULL if failed to allocated.
 * SIDE EFFECTS:
 *      
 * STRATEGY:	
 *      
 * REVISION HISTORY:
 *      Name    Date            Description
 *      ----    ----            -----------
 *      mzhu    1/ 8/97         Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTMEMALLOC (word size)
{
    HTMemHandle htmh;
    byte *head;

    HTMemAllocAndLockLow(0, &htmh, size);

    if (htmh) {
	head = LMemDeref(htmh);
	(*head) = 0;
	MemUnlock(OptrToHandle(htmh));
    }

    return htmh;
}       /* End of HTMEMALLOC.   */


/***********************************************************************
 *		HTMEMALLOCWID
 ***********************************************************************
 *
 * SYNOPSIS:    Same as HTMemAlloc, , but with ID. The ID is used
 *              to destroy HTMemories using HTMemFreeAllWID. 
 * CALLED BY:   Global
 * RETURN:      HTMemHandle or NULL if failed to allocated.
 * SIDE EFFECTS:
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTMEMALLOCWID (word id, word size)
{
    HTMemHandle htmh;
    byte *head;

#if ERROR_CHECK
    if ((id == HTMID_BASE) || (id >= HTMID_END))
	EC_ERROR(INVALID_ID_FOR_HTMEMORY);        
#endif

    HTMemAllocAndLockLow(id, &htmh, size);

    if (htmh) {
	head = LMemDeref(htmh);
	(*head) = 0;
	MemUnlock(OptrToHandle(htmh));
    }

    return htmh;
}	/* End of HTMEMALLOCWID.	*/



/***********************************************************************
 *		HTMEMREALLOC
 ***********************************************************************
 *
 * SYNOPSIS:	Resize a HTMemory. The passed in HTMemory must NOT be 
 *              locked. The return HTMemHandle may not be the same as 
 *              the passed in HTMemHandle. 
 * CALLED BY:	Global
 * RETURN:	HTMemHandle, which may not be the same as the passed in 
 *              HTMemHandle, or return NULL if failed to 
 *              reallocate.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	2/18/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTMEMREALLOC (HTMemHandle htmh, word size)
{
    word id = HTMemID(htmh);

#if ERROR_CHECK
    if (id) EC_WARNING(HTMEMORY_USING_OLD_ID);
#endif

    return HTMemReallocLow(id, htmh, size);
}	/* End of HTMEMREALLOC.	*/



/***********************************************************************
 *		HTMEMREALLOCWID
 ***********************************************************************
 *
 * SYNOPSIS:	Same as HTMemRealloc, but with ID. The ID used to destroy
 *              all HTMemories allocated using HTMemDeleteWID. 
 * CALLED BY:	Client
 * RETURN:	HTMemHandle, which may not be the same as the passed in 
 *              HTMemHandle, or return NULL if failed to 
 *              reallocate.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTMEMREALLOCWID (word id, HTMemHandle htmh, word size)
{

#if ERROR_CHECK
    if ((id == HTMID_BASE) || (id >= HTMID_END))
	EC_ERROR(INVALID_ID_FOR_HTMEMORY);        

    if (HTMemID(htmh) != id) {
	EC_ERROR(INVALID_ID_FOR_HTMEMORY);
    }
#endif

    return HTMemReallocLow(id, htmh, size);
}	/* End of HTMEMREALLOCWID.	*/




/***********************************************************************
 *              HTMEMFREE
 ***********************************************************************
 *
 * SYNOPSIS:    Free a chunk by the HTMemHandle
 * CALLED BY:   Global
 * RETURN:      nothing
 * SIDE EFFECTS:
 *	if this chunk's lock number is not equal to 0, nothing happens.
 *	it means that if the chunk being locked, couldn't be free.
 *      
 * STRATEGY:
 *      
 * REVISION HISTORY:
 *      Name    Date            Description
 *      ----    ----            -----------
 *      mzhu    1/ 8/97         Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTMEMFREE (HTMemHandle htmh)
{

EC( ECCheckHTMemHandle(htmh);                                           )

    HTMemFreeLow(htmh, FALSE);
}       /* End of HTMEMFREE.    */


/***********************************************************************
 *		HTMEMFREEALLWID
 ***********************************************************************
 *
 * SYNOPSIS:	Free all HTMemories given the allocation ID. Must not 
 *              pass 0.
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTMEMFREEALLWID (word id)
{
    HTMemStruct *mb;
    int i, count;
    word sz;
    optr blockList;

#if ERROR_CHECK
    if ((id == HTMID_BASE) || (id >= HTMID_END))
	EC_ERROR(INVALID_ID_FOR_HTMEMORY);        
#endif

    PUSHDS;
    SET_DS_LIB_DGROUP;
    ECCheckMemHandle(ListMemHandle);
    MemPLock(ListMemHandle);

    blockList = ConstructOptr(ListMemHandle, ListChunkHandle);
    count = ChunkArrayGetCount(blockList);
    i = 0;
    while (i<count) {
	mb = ChunkArrayElementToPtr(blockList, i, &sz);
	if (mb->HTMS_id == id) {
	    /* Free the block */
	    MemFree(mb->HTMS_memHandle);
	    /* And the semaphore */
	    ThreadFreeSem(mb->HTMS_sem);
	    ChunkArrayDelete(blockList, mb);	    
	    count--;
	} else {
	    i++;
	}
    }

    /* For now, tally those memory allocated during UI building
       using WID APIs */
    htMemAllocated = 0;

    MemUnlockV(ListMemHandle);

    POPDS;
}	/* End of HTMEMFREEALLWID.	*/




/***********************************************************************
 *		HTMEMUNLOCKANDFREE
 ***********************************************************************
 *
 * SYNOPSIS:	unlock and free a chunk
 * CALLED BY:	Global
 * RETURN:	nothing
 * SIDE EFFECTS:
 *	if the chunk being locked more than once, just unlock once,
 *	do not free it.
 *	the chunk must be locked at least once before calling this
 * 	function.
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/14/97   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTMEMUNLOCKANDFREE (HTMemHandle htmh)
{

EC( ECCheckHTMemHandle(htmh);                                           )

    HTMemFreeLow(htmh, TRUE);
}	/* End of HTMEMUNLOCKANDFREE.	*/



/***********************************************************************
 *		HTMemFreeLow
 ***********************************************************************
 *
 * SYNOPSIS:	Free a HTMemory.
 * CALLED BY:	internal
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/15/97   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
HTMemFreeLow (HTMemHandle htmh, Boolean unlock)
{
    MemHandle block; 
    SemaphoreHandle sem;
    word i, count, sz;
    HTMemStruct *mb;
    byte *head;

EC ( ECCheckHTMemHandle(htmh);                                          )

    PUSHDS;
    SET_DS_LIB_DGROUP;

    MemPLock(ListMemHandle);
    block = OptrToHandle(htmh);

    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);

    /* find the block entry in the list */    
    for(i=0; i<count; i++) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);

	if(mb->HTMS_memHandle == block) {
	    sem = mb->HTMS_sem;
	    break;
	}
    }

    /* we need to check if its lock number is equal to 0 */
    if(unlock) {		
	/* suppose it's locked, so we just need to derefenece. */
	head = LMemDeref(htmh);
	(*head) --;
    } else {
    	ThreadPSem(sem);
     	MemLock(block);
    	ThreadVSem(sem);
	head = LMemDeref(htmh);
    }

    if( *head ) { /* this chunk is still being locked */

	EC_ERROR(CANNOT_FREE_LOCKED_HTMEMORY);	      

	MemUnlock(block);
    	MemUnlockV(ListMemHandle);
	POPDS;
	return;
    }

    /* nobody is using this chunk, so we can free it */    
    mb->HTMS_count --;
    /* check if there are more chunks in the same block*/
    if(!mb->HTMS_count) {	/* if this is the last chunk in this block,
				   then free the whole block. */
	MemFree(block);

	/* and free the semaphore too.*/
	ThreadFreeSem(mb->HTMS_sem);

	/* remove the entry in the list */
	ChunkArrayDeleteHandle(ListChunkHandle, mb);
    	MemUnlockV(ListMemHandle);

	POPDS;
        return;
    }

    /* Tally allocated memory by HTMem */
    {
	word size = LMemGetChunkSize(htmh);
	size--;           /* The first byte keeps count of locks */
	htMemAllocated -= size;
	if ((sdword)htMemAllocated < 0) htMemAllocated = 0;
    }

    /* now we can free this chunk. */
    LMemFree(htmh);
    MemUnlock(block);
    
    MemUnlockV(ListMemHandle);
    
    POPDS;

    return;
}	/* End of HTMemFreeLow.	*/




/***********************************************************************
 *              HTMEMLOCK
 ***********************************************************************
 *
 * SYNOPSIS:    Lock a HTMemHandle
 * CALLED BY:   Global
 * RETURN:      far pointer of HTMemory.
 * SIDE EFFECTS:
 *      
 * STRATEGY:
 *      
 * REVISION HISTORY:
 *      Name    Date            Description
 *      ----    ----            -----------
 *      mzhu    1/ 8/97         Initial Revision
 *
 ***********************************************************************/
void * _far _pascal
HTMEMLOCK (HTMemHandle htmh)
{
    MemHandle block;
    byte *ret;
    word i, count, sz;
    HTMemStruct *mb;
    SemaphoreHandle sem;

EC ( ECCheckHTMemHandle(htmh);                                          )

    PUSHDS;
    SET_DS_LIB_DGROUP;
    
    MemPLock(ListMemHandle);
    block = OptrToHandle(htmh);

    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);
    
    /* find the block entry in the list */    
    for(i=0; i<count; i++) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);

	if(mb->HTMS_memHandle == block) {
	    sem = mb->HTMS_sem;
	    break;
	}
    }
    
    /* when this block is being allocated chunks, wait. otherwise go on.*/
    ThreadPSem(sem);
    MemLock(block);
    ret = LMemDeref(htmh);
    /* increase its lock count */
    (*ret) ++;
    ThreadVSem(sem);

    MemUnlockV(ListMemHandle);
    POPDS;
	
    return (void*)(ret+1);
}       /* End of HTMEMLOCK.    */




/***********************************************************************
 *              HTMEMUNLOCK
 ***********************************************************************
 *
 * SYNOPSIS:    Unlock a HTMemory.
 * CALLED BY:   Global
 * RETURN:      nothing
 * SIDE EFFECTS:
 * STRATEGY:
 *      
 * REVISION HISTORY:
 *      Name    Date            Description
 *      ----    ----            -----------
 *      mzhu    1/ 8/97         Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTMEMUNLOCK (HTMemHandle htmh)
{
    MemHandle block;
    word i, count, sz;
    SemaphoreHandle sem;
    HTMemStruct *mb;
    byte *head;

EC ( ECCheckHTMemHandle(htmh);                                          )

    PUSHDS;
    SET_DS_LIB_DGROUP;

    MemPLock(ListMemHandle);
    block = OptrToHandle(htmh);

    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);
    
    /* find the block entry in the list */    
    for(i=0; i<count; i++) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);

	if(mb->HTMS_memHandle == block) {
	    sem = mb->HTMS_sem;
	    break;
	}
    }
    
    /* when this block is allocating chunks, wait. otherwise go on.*/
    ThreadPSem(sem);
    head = LMemDeref(htmh);
EC( if(!*head) EC_ERROR(CANNOT_UNLOCK_NONLOCKED_HTMEMORY);		  )
    (*head) --;
    MemUnlock(block);
    ThreadVSem(sem);

    MemUnlockV(ListMemHandle);
    POPDS;
	
    return;
}


/***********************************************************************
 *		HTMEMDEREF
 ***********************************************************************
 *
 * SYNOPSIS:	Dereference an already locked HTMemory.
 * CALLED BY:	Client
 * RETURN:	void *.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/26/97   	Initial Revision
 *	
 ***********************************************************************/
void * _far _pascal
HTMEMDEREF (HTMemHandle htmh)
{
    byte *ret;
EC ( ECCheckHTMemHandle(htmh);                                          )
    ret = (byte *)LMemDeref(htmh);
    return (void*)(ret+1);   /* First byte is lock count */
}	/* End of HTMEMDEREF.	*/



/***********************************************************************
 *		HTMEMORYLIMIT
 ***********************************************************************
 *
 * SYNOPSIS:	Enforce memory usage limit. Memory usage is prevented
 *              from dropping below HTMEMORY_HEAP_LOW_LIMIT and 
 *              HTMEMORY_SWAP_LOW_LIMIT. All HTMemory APIs are already
 *              checking memory limit, so you need not call this API
 *              if using HTMemory APIs. However, you *MUST* call this 
 *              API if you are allocating memory using Geos memory APIs.
 *              If it returns FALSE, you must *NOT* proceed to allocate
 *              memory.
 * PASS:        size of memory to allocate.
 * CALLED BY:	HTMemoryAlloc
 * RETURN:	TRUE if memory check passes, else FALSE.
 *	
 * STRATEGY:	current heap space - size >= HTMEMORY_HEAP_LOW_LIMIT
 *                       AND
 *              current swap space - size >= HTMEMORY_SWAP_LOW_LIMIT
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/13/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean _far _pascal
HTMEMORYLIMIT (word size)
{
/* 
 * Make sure these two constants are consistent with the ones in 
 * Internal/heapInt.def.
 */

#define HT_SGIT_SWAP_FREE_SIZE 0x801a
#define HT_SGIT_HEAP_FREE_SIZE 0x801c

#if ERROR_CHECK
    dword heap, swap;
    heap = SysGetInfo(HT_SGIT_HEAP_FREE_SIZE);
    swap = SysGetInfo(HT_SGIT_SWAP_FREE_SIZE);

/*
 *    if (heap+size>HTMEMORY_HEAP_LOW_LIMIT && 
 *	swap+size>HTMEMORY_SWAP_LOW_LIMIT)
 *	return TRUE;
 */
    
    if (swap+size>HTMEMORY_SWAP_LOW_LIMIT) return TRUE;

#else
/*
 *   if ((SysGetInfo(HT_SGIT_HEAP_FREE_SIZE)+size>HTMEMORY_HEAP_LOW_LIMIT) &&
 *	(SysGetInfo(HT_SGIT_SWAP_FREE_SIZE)+size>HTMEMORY_SWAP_LOW_LIMIT))
 *	return TRUE;
 */
    if (SysGetInfo(HT_SGIT_SWAP_FREE_SIZE)+size>HTMEMORY_SWAP_LOW_LIMIT)
 	return TRUE;
#endif

    EC_WARNING(HTMEMORY_EXCEEDING_LIMIT);
    return FALSE;
}	/* End of HTMEMORYLIMIT.	*/



/***********************************************************************
 *		HTMEMORYALLOCATED
 ***********************************************************************
 *
 * SYNOPSIS:	Get the amount of memory allocated by HTMem.
 * CALLED BY:	Client
 * RETURN:	dword
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
dword _far _pascal
HTMEMORYALLOCATED (void)
{
    dword ret;
    PUSHDS;
    SET_DS_LIB_DGROUP;
    ret = htMemAllocated;
    POPDS;
    return ret;
}	/* End of HTMEMORYALLOCATED.	*/



/***********************************************************************
 *		HTMEMUSEDSPACEWID
 ***********************************************************************
 *
 * SYNOPSIS:	The amount of memory used for an id. If id is 0, we get
 *              memory used for non-ID allocation.
 * CALLED BY:	Client
 * RETURN:	dword
 *	
 * STRATEGY:	Find all the blocks allocated for id and sum up their
 *              sizes.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
dword _far _pascal
HTMEMUSEDSPACEWID (word id)
{
    HTMemStruct *mb;
    word sz, count;
    int i;
    dword ret = 0;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    ECCheckMemHandle(ListMemHandle);

    /* exclusive access to the list */
    MemPLock(ListMemHandle);

    count = ChunkArrayGetCountHandles(ListMemHandle, ListChunkHandle);
    for(i=0; i<count; i++) {
	mb = ChunkArrayElementToPtrHandles(ListMemHandle,
					ListChunkHandle, i, &sz);
	if (mb->HTMS_id == id) {
	    ret += MemGetInfo(mb->HTMS_memHandle, MGIT_SIZE);
	}
    }
	
    MemUnlockV(ListMemHandle);

    POPDS;

    return ret;
}	/* End of HTMEMUSEDSPACEWID.	*/
