@include <stdapp.goh>


/*---------------------------------------------------------------------------
  DataResource
 ---------------------------------------------------------------------------*/

@start DataResource, data;

@chunk char IconUntitledName[] = "Unnamed_Moniker";
@localize  { "Icon name to use if the name is empty - USUALLY NOT TRANSLATED" 1-32 };

/* --------- Strings to write VisMonikers to file --------
 * 	     A fixed size makes the string not localizable
 *	     As line ending CRLF (0D+0A) is used, as the original
 *	     Icon editor by Steve does.
 *
 *	     All of these chunks MUST be in the same resource
 *
 * -------------------------------------------------------*/

/*
 * --------- Part 1: GOC code strings and common strings --------
 */


/*
 * GOC VisMoniker related strings
 */
@chunk char MonikerHeaderGOC[64] = "@visMoniker %s = { /* %u bytes */\x0A\x0D";
@chunk char MonikerVMTypeGOC[96] = "\tsize = %s;\
\x0A\x0D\tstyle = %s;\
\x0A\x0D\tcolor = %s;\
\x0A\x0D\taspectRatio = %s;\x0A\x0D";
@chunk char MonikerCachedSizeGOC[32] = "\tcachedSize = %u, %u;\x0A\x0D";
@chunk char MonikerStartGStringGOC[32] = "\tgstring {\x0A\x0D\t\t";
@chunk char MonikerEndGStringGOC[64] = "\x0A\x0D\t\tGSEndString()\x0A\x0D\t}\x0A\x0D}\x0A\x0D\x0A\x0D";

/*
 * GOC GString related strings
 */
@chunk char GStringStartLineGOC[64] = "@chunk byte %s[] = { /* %u bytes */\x0A\x0D\t\t";
@chunk char GStringHeaderGOC[32] = "%s (%u),\x0A\x0D";
@chunk char GStringHeaderGOC2[64] = "GSSetAreaColorIndex(C_BLACK),\x0A\x0D\t\t%s (%u),\x0A\x0D";
@chunk char GStringEndGStringGOC[32] = "\x0A\x0D\t\tGSEndString()\x0A\x0D\t};\x0A\x0D\x0A\x0D";


/*
 * GOC Bitmap related strings
 */
@chunk char BitmapStartLineGOC[64] = "@chunk byte %s[] = { /* %u bytes */\x0A\x0D";
@chunk char BitmapHeaderGOC[64] = "@chunk byte %s = { /* %u bytes */\x0A\x0D";
@chunk char WSBitmapHeaderGOC[32] = "\t\tBitmap (%u, %u, %s, (%s) ),";
@chunk char WSCmplxBitmapHeaderGOC[64] = "\x0A\x0D\t\t0, 0, %u,  %u, 0, 0, %u, %u, 20, 0, 72, 0, 72, 0,";
@chunk char BitmapEndLineGOC[32] = "\x0A\x0D};\x0A\x0D\x0A\x0D";

@chunk char WSTypeFlagPaletteGOC[16] = " | BMT_PALETTE";
@chunk char WSTypeFlagMaskGOC[16] = " | BMT_MASK";
@chunk char WSTypeFlagComplexGOC[16] = " | BMT_COMPLEX";
	//chunk char WSTypeFlagHugeGOC[16] = " | BMT_HUGE";


/*
 * Common strings
 */
@chunk char WSColorMono[16] = "BMF_MONO";
@chunk char WSColor4Bit[16] = "BMF_4BIT";
@chunk char WSColor8Bit[16] = "BMF_8BIT";
@chunk char WSColor24Bit[16] = "BMF_24BIT";
	//chunk char WSColorCMYK[16] = "BMF_4CMYK";
	//chunk char WSColorCMY[16] = "BMF_3CMY";

@chunk char WSCompactUncompacted[24] = "BMC_UNCOMPACTED";
@chunk char WSCompactPackbits[16] = "BMC_PACKBITS";

@chunk char WSPaletteCountComment[48] = "\t\t\t\t\t\t/* number of palette entries */";
@chunk char WSPaletteEndComment[32] = "\t/* end of palette */";

@chunk char WSStyleText[16] = "text";
@chunk char WSStyleAbbrevText[16] = "abbrevText";
@chunk char WSStyleIcon[16] = "icon";
@chunk char WSStyleTool[16] = "tool";

@chunk char WSDispSizeTiny[16] = "tiny";
@chunk char WSDispSizeStandard[16] = "standard";
@chunk char WSDispSizeLarge[16] = "large";
@chunk char WSDispSizeHuge[16] = "huge";

@chunk char WSDispClassGray1[16] = "gray1";
@chunk char WSDispClassColor4[16] = "color4";
@chunk char WSDispClassColor8[16] = "color8";
@chunk char WSDispClassColorRGB[16] = "colorRGB";

@chunk char WSAspectNormal[16] = "normal";
@chunk char WSAspectSquished[16] = "squished";
@chunk char WSAspectVerySqished[16] = "verySquished";

@chunk char WSInvalidValue[16] = "<INVALID>";	/* useful for debugging */

@chunk char WSDrawCmdDrawBitmap[24] = "GSDrawBitmapAtCP";
@chunk char WSDrawCmdFillBitmap[24] = "GSFillBitmapAtCP";


/* --------- Part 2: Assembler code strings (*.ui file) -------- */

/*
 * GOC VisMoniker related strings
 */
@chunk char MonikerHeaderASM[64] = "visMoniker %s = { /* %u bytes */\x0A\x0D";
@chunk char MonikerVMTypeASM[96] = "\tsize = %s;\x0A\x0D\
\tstyle = %s;\x0A\x0D\tcolor = %s;\x0A\x0D\taspectRatio = %s;\x0A\x0D";
@chunk char MonikerCachedSizeASM[32] = "\tcachedSize = %u, %u;\x0A\x0D";
@chunk char MonikerStartGStringASM[32] = "\tgstring {\x0A\x0D\t\t";

/*
 * ASM GString related strings
 */
@chunk char GStringStartLineASM[64] = "chunk %s = data { /* %u bytes */\x0A\x0D\t\t";
@chunk char GStringHeaderASM[64] = "GSBeginString\x0A\x0D\t\t%s %u\x0A\x0D";
@chunk char GStringHeaderASM2[96] = "GSBeginString\x0A\x0D\t\tGSSetAreaColor C_BLACK\x0A\x0D\t\t%s %u\x0A\x0D";
@chunk char GStringEndGStringASM[32] = "\x0A\x0D\t\tGSEndString\x0A\x0D\t}\x0A\x0D\x0A\x0D";

/*
 * ASM Bitmap related strings
 */
@chunk char BitmapStartLineASM[64] = "chunk %s = data { /* %u bytes */\x0A\x0D";
@chunk char WSBitmapHeaderASM[32] = "\t\tBitmap <%u, %u, %s, %s >";
@chunk char WSCmplxBitmapHeaderASM[64] = "\t\tCBitmap <<%u ,%u, %s,%s>, 0, %u, 0, %u, 20, 72, 72>";
@chunk char BitmapEndLineASM[32] = "\x0A\x0D}\x0A\x0D\x0A\x0D";

@chunk char WSTypeFlagPaletteASM[24] = " or mask BMT_PALETTE";
@chunk char WSTypeFlagMaskASM[24] = " or mask BMT_MASK";
@chunk char WSTypeFlagComplexASM[24] = " or mask BMT_COMPLEX";
	//chunk char WSTypeFlagHugeASM[24] = " or mask BMT_HUGE";

@chunk char MonikerEndGStringASM[32] = "\x0A\x0D\t\tGSEndString\x0A\x0D\t}\x0A\x0D}\x0A\x0D\x0A\x0D";


/* --------- Part 3: PointerDef code strings (*.goc and *.ui file) -------- */

@chunk char PointerDefHeaderGOC[64] = "@chunk PointerDef%u %s = {\x0A\x0D\t%u, %u, %u, %u,\x0A\x0D\t{";
@chunk char PointerDefMiddleGOC[32] = "\x0A\x0D\t},\x0A\x0D\t{";
@chunk char PointerDefEndGOC[16] = "\x0A\x0D\t}\x0A\x0D};\x0A\x0D\x0A\x0D";

@chunk char PointerDefHeaderASM[64] = "chunk %s = data {\x0A\x0D    PointerDef < %u, %u, %u, %u >";
@chunk char PointerDefMiddleASM[16] = "\x0A\x0D";
@chunk char PointerDefEndASM[16] = "\x0A\x0D}\x0A\x0D\x0A\x0D";


/* --------- End of Strings to write VisMonikers and others to file -------- */


@end   DataResource;

/*---------------------  ---------------------
 *	Purpose:
 *	Parameters:
 *	Return:
 ---------------------------------------------------------------------------*/

