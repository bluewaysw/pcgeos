@end StyleResource;


/**************************************************************************
 *              Entity names
 * 11/2022: Adding some more recent entity names to the table
 * https://www.key-shortcut.com/html-entities/alle-entitaeten/
 * https://www.w3.org/wiki/Common_HTML_entities_used_for_typography
 * https://www.code-knacker.de/ansi.htm
 *
 * Note: Table must be lexically sorted by entity names
 *
 **************************************************************************/

@start EntityResource, data;

@chunk HTMLEntityTable xlateTable[] =
{
@ifdef DO_DBCS
  /* Canonical Unicode values come first for reverse lookup. */
  {"",      305, C_LATIN_SMALL_LETTER_DOTLESS_I},
  {"",      338, C_LATIN_CAPITAL_LETTER_O_E},
  {"",      339, C_LATIN_SMALL_LETTER_O_E},
  {"",      376, C_LATIN_CAPITAL_LETTER_Y_DIAERESIS},
  {"",      402, C_LATIN_SMALL_LETTER_SCRIPT_F},
  {"",      710, C_MODIFIER_LETTER_CIRCUMFLEX},
  {"",      711, C_MODIFIER_LETTER_HACEK},
  {"",      728, C_SPACING_BREVE},
  {"",      729, C_SPACING_DOT_ABOVE},
  {"",      730, C_SPACING_RING_ABOVE},
  {"",      731, C_SPACING_OGONEK},
  {"",      732, C_SPACING_TILDE},
  {"",      733, C_SPACING_DOUBLE_ACUTE},
  {"",      916, C_GREEK_CAPITAL_LETTER_DELTA},
  {"",      937, C_GREEK_CAPITAL_LETTER_OMEGA},
  {"",      960, C_GREEK_SMALL_LETTER_PI},
  {"",     8194, C_EN_SPACE},
  {"",     8195, C_EM_SPACE},
  {"",     8201, C_THIN_SPACE},
  {"",     8209, C_NON_BREAKING_HYPHEN},
  {"",     8211, C_EN_DASH},
  {"",     8212, C_EM_DASH},
  {"",     8216, C_SINGLE_TURNED_COMMA_QUOTATION_MARK},
  {"",     8217, C_SINGLE_COMMA_QUOTATION_MARK},
  {"",     8218, C_LOW_SINGLE_COMMA_QUOTATION_MARK},
  {"",     8220, C_DOUBLE_TURNED_COMMA_QUOTATION_MARK},
  {"",     8221, C_DOUBLE_COMMA_QUOTATION_MARK},
  {"",     8222, C_LOW_DOUBLE_COMMA_QUOTATION_MARK},
  {"",     8224, C_DAGGER},
  {"",     8225, C_DOUBLE_DAGGER},
  {"",     8226, C_KATAKANA_MIDDLE_DOT},
  {"",     8230, C_HORIZONTAL_ELLIPSIS},
  {"",     8240, C_PER_MILLE_SIGN},
  {"",     8249, C_LEFT_POINTING_SINGLE_GUILLEMET},
  {"",     8250, C_RIGHT_POINTING_SINGLE_GUILLEMET},
  {"",     8260, C_FRACTION_SLASH},
  {"",     8364, C_EURO_SIGN},
  {"",     8482, C_TRADEMARK},
  {"",     8706, C_PARTIAL_DIFFERENTIAL},
  {"",     8719, C_N_ARY_PRODUCT},
  {"",     8721, C_N_ARY_SUMMATION},
  {"",     8730, C_SQUARE_ROOT},
  {"",     8734, C_INFINITY},
  {"",     8747, C_INTEGRAL},
  {"",     8776, C_ALMOST_EQUAL_TO},
  {"",     8800, C_NOT_EQUAL_TO},
  {"",     8804, C_LESS_THAN_OR_EQUAL_TO},
  {"",     8805, C_GREATER_THAN_OR_EQUAL_TO},
  {"",     9670, C_BLACK_DIAMOND},

  /* Legacy Windows-1252 byte-number aliases. */
  {"",      130, C_LOW_SINGLE_COMMA_QUOTATION_MARK},
  {"",      131, C_LATIN_SMALL_LETTER_SCRIPT_F},
  {"",      132, C_LOW_DOUBLE_COMMA_QUOTATION_MARK},
  {"",      133, C_HORIZONTAL_ELLIPSIS},   /* ellipsis */
  {"",      134, C_DAGGER},   /* dagger */
  {"",      135, C_DOUBLE_DAGGER},   /* double dagger */
  {"",      136, C_MODIFIER_LETTER_CIRCUMFLEX},
  {"",      137, C_PER_MILLE_SIGN},   /* "per mille" symbol */
  {"",      138, C_LATIN_CAPITAL_LETTER_S_HACEK },   /* S-hacek */
  {"",      139, C_LEFT_POINTING_SINGLE_GUILLEMET},
  {"",      140, C_LATIN_CAPITAL_LETTER_O_E},   /* OE ligature */
  {"",      145, C_SINGLE_TURNED_COMMA_QUOTATION_MARK},   /* single opening quote, high */
  {"",      146, C_SINGLE_COMMA_QUOTATION_MARK},   /* single closing quote, high */
  {"",      147, C_DOUBLE_TURNED_COMMA_QUOTATION_MARK},   /* double opening quote, high */
  {"",      148, C_DOUBLE_COMMA_QUOTATION_MARK},   /* double closing quote */
  {"",      149, C_KATAKANA_MIDDLE_DOT},   /* C_BULLET don't exist in DBCS encodings, use alternative */
  {"",      150, C_EN_DASH},   /* En dash */
  {"",      151, C_EM_DASH},   /* Em dash */
  {"",      152, C_SPACING_TILDE},
  {"",      153, C_TRADEMARK},   /* trademark symbol */
  {"",      154, C_LATIN_SMALL_LETTER_S_HACEK },   /* s-hacek */
  {"",      155, C_RIGHT_POINTING_SINGLE_GUILLEMET},
  {"",      156, C_LATIN_SMALL_LETTER_O_E},   /* oe ligature */
  {"",      159, C_LATIN_CAPITAL_LETTER_Y_DIAERESIS},   /* Y-umlaut (?) */
  {"AElig", 198, C_LATIN_CAPITAL_LETTER_A_E},
  {"Aacute",193, C_LATIN_CAPITAL_LETTER_A_ACUTE},
  {"Acirc", 194, C_LATIN_CAPITAL_LETTER_A_CIRCUMFLEX},
