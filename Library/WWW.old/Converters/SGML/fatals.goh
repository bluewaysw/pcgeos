@ifndef __FATALS_GOH__
@define __FATALS_GOH__

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    CANNOT_BIND_SGML_PARSER_TO_MORE_THAN_ONE_DTD,
    DTD_INFO_MUST_BE_IN_SAME_RESOURCE,
    EXPECTED_START_ELEMENT_MISSING,
    SGML_CANNOT_PARSE_WITHOUT_A_DTD,
    SGML_TARGET_MUST_BE_DECENDANT_OF_HTSTRUCTUREDCLASS,
    TEXT_BUFFER_IS_EMPTY,
    UNGET_CHAR_BUFFER_IS_FULL
} FatalErrors;
#endif /* ERROR_CHECK */


/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    EXCEED_MAX_ELEMENT_NESTING_LEVEL,
    IDENTIFIER_LONGER_THAN_MAX_SGML_NAME_LENGTH,
    ILLEGAL_OR_NOT_REQUIRED_END_ELEMENT,
    ILLEGAL_OR_NOT_REQUIRED_START_ELEMENT,
    PARSER_IGNORE_A_TOKEN,
    SCANNER_IGNORE_A_CHARACTER,
    ATTRIBUTE_ARRAY_TOO_SMALL,
    UNKNOWN_ATTRIBUTE_NAME,
    UNKNOWN_END_ELEMENT,
    UNKNOWN_START_ELEMENT
} Warnings;
#endif 

#if ERROR_CHECK
extern FatalErrors sgmlFatalErrors;
extern Warnings    sgmlWarnings;
#endif 

@endif
