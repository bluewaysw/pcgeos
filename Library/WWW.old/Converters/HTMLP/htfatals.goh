@ifndef __HT_FATALS_GOH__
@define __HT_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    EXCEED_NESTING_LEVEL,
    HTML_CONTAINMENT_TABLE_OUT_OF_ORDER,
    INVALID_INDEX,
    INVALID_GRAMMAR_TABLE,
    INVALID_HTML_ELEMENT_TOKEN,
    NO_CONTENT_MODEL,
    START_AND_END_TAGS_MISMATCH
} FatalErrors;
#endif /* ERROR_CHECK */


/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    CASE_NOT_HANDLED,
    TAG_NOT_ALLOWED_IN_CURRENT_CONTENT,
    TAG_NOT_SUPPORTED
} Warnings;

#endif


#if ERROR_CHECK
extern FatalErrors htmlpFatalErrors;
extern Warnings    htmlpWarnings;
#endif 

@endif
