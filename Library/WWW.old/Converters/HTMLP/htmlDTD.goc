/*
 * HTML Character Entities. Must be in stcmp order. This table must
 * be match exactly will ALL the translation tables used by
 * HTMLClass::MSG_HT_STRUCTURED_PUT_ENTITY. In you add entity here,
 * don't forget to update the number elements at the bottom of this
 * page, htmlDTD. Currently, there are 100 entries. This table was
 * taken from W3C HTMLPDTD.c. These get mapped to GeosEntities.
 */
/*
 * HTML DTD resource
 */
@start HTMLDTDResource, data;

