@end   HTMLDTDResource;

/*
 * HTML DTD structure. All DTD info must be in one resource for obvious
 * performance reasons.
 */
SGMLDTD htmlDTD = {
    @htmlTags,
    HTMLT_XXX_NULL - 1,
    @ISO_Latin1_Entities,
    @GeosEntities,
    100,          /* The number of elements in @ISO_Latin1_Entities 
		     and @GeosEntities */
    @ISO_Latin1_Characters,
    @GeosCharacters,
    61            /* The number of elements in @ISO_Latin1_Characters
		     and @GeosCharacters */
	
};
