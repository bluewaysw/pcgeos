@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/htconv.goh>
@include <WWW/htgnf.goh>

/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTGNFClass;


/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTGNFClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Convert and display data.
 * PARAMETERS:	    void (byte *data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	2/14/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGNFClass, MSG_HT_STREAM_PUT_BLOCK
{
    if (!data || !len) return HT_OK;

    /* Convert data to GString and send to target */
    return HT_OK;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/
