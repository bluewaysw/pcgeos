/***********************************************************************
 *		MSG_UI_GENERATOR_ADD_BR for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Add a line break
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		If the current target.obj is a text object, add C_CR.
 *		if not, add a ui seperator.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_ADD_BR
{
  optr content;
  StyleType groupType;
  int counter, level;
  char displayType, tab[1] = { C_TAB };

  /*  AddSpaceSeparator(&(pself->UIG_target), 1, FALSE); */
  AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);

  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (groupType != (StyleType)-1) {
    if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass)
	/*
	 *  The problem with the text library is that the left margin
	 *  doesn't work if there is a tab to the left of the left margin.
	 */
	while (level >= -1) {
	  @call pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);
	  level--;
	}
    /*
     *  If there is other object, HERE we should indent the object.
     */
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_ADD_BR.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_START_ANCHOR for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Mark the beginning of an anchor.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 2/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_START_ANCHOR
{
  optr content;
  /*
   *  Tell a HTML content object, which will be parent of a
   *  text object, to begin the anchor mode.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_ANCHOR);
  /*
   *  Process the attribute list.
   */
  @call self::MSG_UI_GENERATOR_PROCESS_A_ATTRIBUTE(block, entity);
  @call content::MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN(pself->UIG_hrefToken);
  /*
   *  If the current target.obj is a text, do the italic now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
    if (pself->UIG_hrefToken != -1) {
      @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
	                           (ELEMENT_START, TS_UNDERLINE);
      @call pself->UIG_target.obj::MSG_GEN_TEXT_RECORD_HREF
                                   (ELEMENT_START, pself->UIG_hrefToken);
    }
  }

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_ANCHOR.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_PROCESS_A_ATTRIBUTE for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Process the <A> attribute list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:  Supported Attr: HREF, NAME
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_PROCESS_A_ATTRIBUTE
{
  char *value;
  int	index, cnt, offset;
  VisTextRange pos;
  optr  obj;
  ClassStruct *class;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_HREF:    /* HREF */
      EC_WARNING_IF(pself->UIG_hrefToken != -1, UIG_NESTED_ANCHORS);
      /*
       *  This <A> is a link to some destination.
       *  Store a HREF token.
       */
      pself->UIG_hrefToken =
	@call pself->UIG_pmObj::MSG_PM_SAVE_HREF(value);
      break;
    case HTML_ATTR_NAME:
      /*
       *  This <A> is a destination for some link(s).
       */
      if (!pself->UIG_target.obj) {
	/*
	 *  The current receiving object in ui-tree is PManager itself.
	 */
	cnt = @call pself->UIG_pmObj::MSG_GEN_COUNT_CHILDREN();
	if (cnt == 0)  {            /* No objects in the ui-tree yet. */
	  obj = pself->UIG_pmObj;
	  offset = 0;
	}
	else {
	  obj=@call pself->UIG_pmObj::MSG_GEN_FIND_CHILD_AT_POSITION(cnt-1);
	  offset = -1;
	}
	/*  Doesn't matter what class it is because the end of this
	 *  obect is the beginning of the <A NAME> position.
	 */
	class = NULL;
      }
      else if (pself->UIG_target.class == (ClassStruct *)&HTGenTCellClass ||
	  pself->UIG_target.class == (ClassStruct *)&HTGenTableClass ||
	  pself->UIG_target.class == (ClassStruct *)&HTGenFormClass ||
	  pself->UIG_target.class == (ClassStruct *)&HTGenCaptionClass) {
	cnt = @call pself->UIG_target.obj::MSG_GEN_COUNT_CHILDREN();
	if (cnt == 0)  {/* No objects in the ui-tree yet. */
	  obj = pself->UIG_target.obj;
	  offset = 0;
	}
	else {
	  obj=@call pself->UIG_target.obj::MSG_GEN_FIND_CHILD_AT_POSITION
	    (cnt-1);
	  offset = -1;
	}
	class = NULL;  /* Doesn't matter what class it is */
      }
      else {
	/*
	 *  Well, the <A NAME> is in the current object.
	 */
	obj = pself->UIG_target.obj;
	offset = -1;  /* guessing to be at the end. */
	class = pself->UIG_target.class;
      }
      if (class == (ClassStruct *)&HTGenTextClass) {
	/* This <A NAME> refers to the a place in this text obj */
	@call obj::MSG_VIS_TEXT_GET_SELECTION_RANGE(&pos);
	@call pself->UIG_pmObj::MSG_PM_SAVE_ANCHOR_NAME
	  (value, obj, pos.VTR_start);
      }
      else {
	/* This <A NAME> refers to the immediate object after obj
	 * If offset = 0, display at the top of obj.
	 * If offset =-1, display at the end of obj.
	 */
	EC_WARNING_IF(offset != 0 || offset != -1, UIG_WRONG_ASSUMPTION);
	@call pself->UIG_pmObj::MSG_PM_SAVE_ANCHOR_NAME
	  (value, obj, offset);
      }
      break;
    }
  }

  return;
}	/* End of MSG_UI_GENERATOR_PROCESS_A_ATTRIBUTE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_END_HTML for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Finish up whatever objects that have not not append
 *                  to the ui tree or have not been set usable.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/15/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_END_HTML
{
  ClassStruct *class;
  optr dummy;

  /*
   * Add whatever object in UIG_target to the leaf of the ui-tree, then
   * travel up to the top of the tree and mark object usable along the
   * way.
   */
  if (pself->UIG_target.obj) {
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
       (pself->UIG_target.obj);
    while (1) {
      @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE(&dummy, &class);
      if (class == NULL || dummy == NULL) {
	pself->UIG_target.class = NULL;
	pself->UIG_target.obj = NULL;
	break;
      }
      else if (class == (ClassStruct *)&HTGenSelectClass)
	@call dummy::MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
    }
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION(NULL);
#endif
  }
  return;
}	/* End of MSG_UI_GENERATOR_END_HTML.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_CLEAR_UI_TREE for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Delete the ui tree.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
