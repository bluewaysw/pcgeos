extern HTListHandle	AreaMaps;


/***********************************************************************
 *		MSG_UI_GENERATOR_INITIALIZE for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Initalize instance data in the UI Generator.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/15/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_INITIALIZE
{
  int count, i;
  HTMemHandle map;
  MapItem *mapItem;
  /*
   *  Clear fields
   */
  pself->UIG_target.obj = NULL;
  pself->UIG_target.class = NULL;
  /*
   *  Create a storage of Area Maps.
   */
  if (AreaMaps) {
    if ((count = HTListGetCount(AreaMaps)) > 0) {
      for (i = 0; i < count; i++) {
	HTListGetItem(AreaMaps, i, &map, sizeof(HTMemHandle));
	mapItem = (MapItem *)HTMemLock(map);
	HTListDelete(mapItem->MI_areas);
	HTMemFree(mapItem->MI_mapName);
	HTMemUnlockAndFree(map);
      }
    }
    HTListDelete(AreaMaps);
  }
  AreaMaps = HTListNew();
  /*
   *  UIG_content keeps a stack of global text formats.
   */
  if (pself->UIG_content)
    @call pself->UIG_content::MSG_GEN_DESTROY
      (VUM_DELAYED_VIA_UI_QUEUE,CCF_MARK_DIRTY);
  pself->UIG_content = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
    (&HTGenHtmlContentClass);
  @call pself->UIG_pmObj::MSG_PM_SET_CONTENT_OBJECT(pself->UIG_content);
  /*
   *  Clear any old data.
   */
  if (pself->UIG_currentMap) {
    HTMemFree(pself->UIG_currentMap);
    pself->UIG_currentMap = NULL;
  }
  /*
   *  Initially we are not in the <A> content.
   */
  pself->UIG_hrefToken = -1;
  @call pself->UIG_content::MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN(-1);

  return;
}	/* End of MSG_UI_GENERATOR_INITIALIZE.	*/



