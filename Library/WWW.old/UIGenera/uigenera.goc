  return;
}	/* End of MSG_UI_GENERATOR_CLEAR_UI_TREE.	*/



/***********************************************************************
 *		MSG_GEN_HR_PROCESS_ATTRIBUTE for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Process the attr list of <HR>
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:  Supported Attributes:
 *		SIZE = n, sets the height of the rule, in pixels.
 *		WIDTH = n, sets the width of the rule, either in pixels
 *			or as a percentage of window width.
 *		NOSHADE, draws the rule without 3-D shading.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHRClass, MSG_GEN_HR_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j;
  Boolean percent = FALSE;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_SIZE:
      pself->HTGHR_size = atoi(value);
      break;
    case HTML_ATTR_WIDTH:
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE)
	pself->HTGHR_width = atoi(value);
      break;
    case HTML_ATTR_NOSHADE:
      pself->HTGHR_noshade = TRUE;
      break;
    }
  }
  /*
   *  Expand the size of HR to the width of its parent.
   */
  @send self::MSG_META_ADD_VAR_DATA(HINT_EXPAND_WIDTH_TO_FIT_PARENT,0,NULL);
  return;
}	/* End of MSG_GEN_HR_PROCESS_ATTRIBUTE.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Intercept this message and draw <HR> according to
 *		    its size.
 * PARAMETERS:	    void (DrawFlags drawFlags, GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHRClass, MSG_VIS_DRAW
{
  Rectangle	bounds;
  int offset, width;
  VisTextInstance  * vself;

  vself = ObjDerefVis(oself);
  vself->VI_optFlags = vself->VI_optFlags & ~VOF_IMAGE_INVALID
    & ~VOF_WINDOW_INVALID;

  @callsuper();
  @call self::MSG_VIS_GET_BOUNDS(&bounds);
  /*
   *  If no shade, draw a rectangle; else fill a rectangle.
   */
  width = bounds.R_right - bounds.R_left;

  if (pself->HTGHR_noshade == TRUE) {
    if (pself->HTGHR_width && pself->HTGHR_width < width) {
      offset = (width - pself->HTGHR_width)/2;
      GrFillRect(gstate, bounds.R_left+offset, bounds.R_top+2, 
		 bounds.R_right-offset, bounds.R_bottom-2);
    }
    else 
      GrFillRect(gstate, bounds.R_left+2, bounds.R_top+2, 
		 bounds.R_right-2, bounds.R_bottom-2);
  }
  else {
    if (pself->HTGHR_width && pself->HTGHR_width < width) {
      offset = (width - pself->HTGHR_width)/2;
      GrDrawRect(gstate, bounds.R_left+offset, bounds.R_top+2, 
		 bounds.R_right-offset, bounds.R_bottom-2);
    }
    else
      GrDrawRect(gstate, bounds.R_left+2, bounds.R_top+2, 
		 bounds.R_right-2, bounds.R_bottom-2);
  }
  return;
}	/* End of MSG_VIS_DRAW.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Intercept this message and set the size of <HR>
 * PARAMETERS:	    SizeAsDWord (RecalcSizeArgs width,
 *				 RecalcSizeArgs height)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHRClass, MSG_VIS_RECALC_SIZE
{
  CompSizeHintArgs sizeArgs;
  SizeAsDWord  size;
  VisTextInstance  * vself;
  /*
   *  Get the parent's fixed size.
   */
  sizeArgs.CSHA_width = 0;
  @call @genParent::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  if (sizeArgs.CSHA_width > 0) {
    /*
     *  Set the size of the text object.
     */
    width = sizeArgs.CSHA_width;
    sizeArgs.CSHA_width = SST_PIXELS | (sizeArgs.CSHA_width-NESTED_MARGIN);
    if (pself->HTGHR_size == 0)
      sizeArgs.CSHA_height= HR_HEIGHT_Y;	/* default height for <HR> */
    else
      sizeArgs.CSHA_height= pself->HTGHR_size + HR_HEIGHT_Y;
    sizeArgs.CSHA_count = 0;
    @call self::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  }
  size = @callsuper();
  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set its new X and Y position.
 * PARAMETERS:	    (int xOrigin, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHRClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();

  xOrigin = DWORD_X(xy) + pself->HTGHR_xPos;
  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight(oself, pself->HTGHR_pageRow);

  @callsuper();
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_META_UIG_CALC_POSITION for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row number and X position.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHRClass, MSG_META_UIG_CALC_POSITION
{
  int row;
  SizeAsDWord size = @call self::MSG_VIS_GET_SIZE();
  /*
   *  Get an estimated position of the object
   */
  pself->HTGHR_xPos = UpdateItsPotentialPosition(oself, size, &row);
  pself->HTGHR_pageRow = row;
  return;
}	/* End of MSG_META_UIG_CALC_POSITION.	*/



