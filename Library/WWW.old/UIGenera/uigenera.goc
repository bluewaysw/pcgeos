/***********************************************************************
 *		MSG_UI_GENERATOR_START_TITLE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Store the TITLE of the document in the PManager.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Process <TITLE>
 *		<TITLE></TITLE> should be in the content of <HEAD>.
 *		When this handler is called, if pself->UIG_target is
 *		not empty, we know that we're not in the <HEAD> content.
 *		Thus, we'll simply ignore this element.  If pself->UIG_
 *		target is empty, it may or may not be in the <HEAD> 
 *		content.  UI Generator assumes the parser will check 
 *		validation of the elements, thus for this case we assume
 *		it is in the <HEAD> content.
 *
 *		We store @PManager in the UIG_target to serve as an
 *		indication that we're in the title mode.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/13/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_START_TITLE
{
  if (pself->UIG_target.obj || pself->UIG_target.class)
	return UI_GEN_ERROR;

  pself->UIG_target.class = (ClassStruct *)&PresentationManagerClass;
  pself->UIG_target.obj = pself->UIG_pmObj;

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_TITLE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_END_TITLE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Done with the TITLE content.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Process </TITLE>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/13/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_END_TITLE
{
  /*
   * If <TITLE></TITLE> was not in the <HEAD> content, we ignore the
   * <TITLE> and this </TITLE> element.
   */
  if (pself->UIG_target.class != (ClassStruct *)&PresentationManagerClass)
	return UI_GEN_ERROR;

  pself->UIG_target.class = NULL;
  pself->UIG_target.obj = NULL;

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_TITLE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_BASE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Record the URL of the document, for the purpose of
 *		    completing the partial URLs.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/14/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_BASE
{
  char *value;
  int index = 0;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_HREF:
      @call pself->UIG_pmObj::MSG_PM_SAVE_BASE(value);
      break;
    }
  }

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_BASE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_HR for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Create a horizontal rule
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/ 9/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_HR
{
  optr dummy;
  /* 
   *  Deal away the current target object.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTCellClass ||
      pself->UIG_target.class == (ClassStruct *)&HTGenTableClass ||
      pself->UIG_target.class == (ClassStruct *)&HTGenFormClass)
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
		(pself->UIG_target.obj);
  else if (pself->UIG_target.class == (ClassStruct *)&HTGenSelectClass ||
	   pself->UIG_target.class == (ClassStruct *)&HTGenOuterSelectClass||
	   pself->UIG_target.class == (ClassStruct *)&HTGenOptionClass)
    return UI_GEN_ERROR;
  else if (pself->UIG_target.obj) {
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ \
	(pself->UIG_target.obj);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
       (pself->UIG_target.obj);
#endif
  }
  /*
   * Now create an HR object and store it in target.obj.  Next, 
   * process the passed attribute list.
   */
  dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
	((ClassStruct *)&HTGenHRClass);

  @call dummy::MSG_GEN_HR_PROCESS_ATTRIBUTE(block, entity);
  /*
   *  Done with the HR object
   */
  @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION(dummy);
#endif
  @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&(pself->UIG_target.obj), &(pself->UIG_target.class));
  if (pself->UIG_target.obj == pself->UIG_pmObj) {
	pself->UIG_target.obj = NULL;
	pself->UIG_target.class = NULL;
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_HR.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_END_FORMAT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Pop a formatting token off the stack, and un-do the
 *		    text format according to the type of the token
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		This method is called whenever the parser sees 
 *		</..format elemet...>.  This method pops a token
 *		off the stack, and according to the token type, un-do
 *		the text format.  Thus, this method ignors whatever the
 *		format element the parser actually sees.
 *		Elements that can be handled:
 *			</B>, </I>, </STRIKE>, </S>, </SUPERSCRIPT>,
 *			</SUBSCRIPT>, </FONT>, </BIG>, </SMALL>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_END_FORMAT
{
  StyleType type;
  WWFixed number;
  optr	content;
  int 	counter;
  /*
   * Pop the top format token off the stack.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  type = @call content::MSG_GEN_HTML_CONTENT_REMOVE_CONTENT(&counter);
  /*
   * If the current target.obj is a text, stop bold face now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
    switch (type) {
      case STYLE_ANCHOR:
	EC_WARNING_IF(counter != 0, UIG_UNBALANCED_ANCHORS);
	if (pself->UIG_hrefToken != -1) {
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
					(ELEMENT_END, TS_UNDERLINE);
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_RECORD_HREF
	                                (ELEMENT_END, pself->UIG_hrefToken);
	  pself->UIG_hrefToken = -1;
	  @call content::MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN(-1);
	}
	break;
      case STYLE_BOLD:
	if (!counter)
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
					(ELEMENT_END, TS_BOLD);
	break;
      case STYLE_ITALIC:
	if (!counter)
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
					(ELEMENT_END, TS_ITALIC);
	break;
      case STYLE_STRIKE:
	if (!counter)
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
					(ELEMENT_END, TS_STRIKE_THRU);
	break;
      case STYLE_SUPERSCRIPT:
	if (!counter)
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
					(ELEMENT_END, TS_SUPERSCRIPT);
	break;
      case STYLE_SUBSCRIPT:
	if (!counter)
	  @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
					(ELEMENT_END, TS_SUBSCRIPT);
	break;
      case STYLE_FW_FONT:
	if (!counter)
	  @send pself->UIG_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_SANS,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
	break;
      case STYLE_PRE:
	@call self::MSG_UI_GENERATOR_END_FORMAT();
	/*	AddSpaceSeparator(&(pself->UIG_target), 2, TRUE); */
	AddNewLine(&(pself->UIG_target),2,pself->UIG_pmObj,pself->UIG_content);
	break;
      case STYLE_BQ:
/*	if (listIndex > 1)
	  AddSpaceSeparator(&(pself->UIG_target), 1);
*/
      case STYLE_UL:
      case STYLE_OL:
      case STYLE_DL:
	@call self::MSG_UI_GENERATOR_END_LIST();
	break;
      case STYLE_ALIGN:
	@call self::MSG_UI_GENERATOR_END_ALIGN();
	break;
      case STYLE_HEADER:
	@call self::MSG_UI_GENERATOR_END_FORMAT();	/* reset font */
	@call self::MSG_UI_GENERATOR_END_FORMAT();	/* reset bold */
	/*	AddSpaceSeparator(&(pself->UIG_target), 1, TRUE); */
	AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
	@call self::MSG_UI_GENERATOR_END_FORMAT();	/* reset alignment */
	break;
      case STYLE_FONT:
	number.WWF_int = @call content::MSG_GEN_HTML_CONTENT_POP_FONT_SIZE();
	number.WWF_frac= 0;
	@call pself->UIG_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
	 break;
      case STYLE_PARAGRAPH:
/*	@call self::MSG_UI_GENERATOR_END_FORMAT(); */
	/*	AddSpaceSeparator(&(pself->UIG_target), 1, FALSE); */
	AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
	break;	
      case STYLE_NOBR:
	/*	AddSpaceSeparator(&(pself->UIG_target), 1, FALSE); */
	AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
	@call self::MSG_UI_GENERATOR_END_NOBR();
	break;	
      default:
	return UI_GEN_ERROR;
    }
  }
  else {
    /*
     *  Current target object is not a text object.  We simply pop tokens
     *  from the some stack(s).
     */
    switch (type) {
      case STYLE_ANCHOR:
	EC_WARNING_IF(counter != 0, UIG_UNBALANCED_ANCHORS);
	if (pself->UIG_hrefToken != -1) {
	  pself->UIG_hrefToken = -1;
	  @call content::MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN(-1);
	}
	break;
      case STYLE_BQ:
/*	if (listIndex > 1)
	  AddSpaceSeparator(&(pself->UIG_target), 1);
*/
      case STYLE_UL:
      case STYLE_OL:
      case STYLE_DL:
	@call self::MSG_UI_GENERATOR_END_LIST();
	break;
      case STYLE_HEADER:
	@call self::MSG_UI_GENERATOR_END_FORMAT();	/* reset font */
	@call self::MSG_UI_GENERATOR_END_FORMAT();	/* reset bold */
	@call self::MSG_UI_GENERATOR_END_FORMAT();	/* reset alignment */
	break;
      case STYLE_ALIGN:
	@call self::MSG_UI_GENERATOR_END_ALIGN();
	break;
      case STYLE_FONT:
	@call content::MSG_GEN_HTML_CONTENT_POP_FONT_SIZE();
	break;
      case STYLE_PRE:
	@call self::MSG_UI_GENERATOR_END_FORMAT();
    }
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_FORMAT.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_BLOCKQUOTE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Set apart quotations in text.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/13/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_START_BLOCKQUOTE
{
  optr content;
  /*
   * Tell a HTML content object that we are now in the center mode.
   * Push format token onto the format stack.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  /*
   * Push format token onto the format stack.
   */
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BQ);
  /*
   * Add a blank line
   */
  /*  AddSpaceSeparator(&(pself->UIG_target), 2, TRUE); */
  AddNewLine(&(pself->UIG_target), 2, pself->UIG_pmObj, pself->UIG_content);
  /*
   * Push the list group info
   */
  @call content::MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP(STYLE_DL, 0, 0);

  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass)
    FormatSetTextBQ(pself->UIG_target.obj, content);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_BLOCKQUOTE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_START_CENTER for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Make the following text or ui objects to be centered.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/14/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_START_CENTER
{
  optr content;
  /*
   * Tell a HTML content object that we are now in the center mode.
   * Push format token onto the format stack.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_ALIGN);
  /*
   * Push the align token to the align Stack.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION(J_CENTER);
  /*
   * Add a line feed, to let the new alignment take effect.
   */
  /*  AddSpaceSeparator(&(pself->UIG_target), 1, FALSE); */
  AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
  /*
   * If the current target.obj is a text, change the alignment now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass)
    @call content::MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
	(pself->UIG_target.obj);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_CENTER.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_END_ALIGN for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Reset to the previous alignment
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/14/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_END_ALIGN
{
  VisTextParaAttrAttributes old_attr= 0, new_attr = 0;
  Justification old_just, new_just;
  optr content;
  /*
   * Get a content object.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  /*
   * Get the current alignment.
   */
  old_just = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION();
  old_attr = old_just << VTPAA_JUSTIFICATION_OFFSET;
  /*
   * End the current alignment.
   */
  @send content::MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION();

  /*  AddSpaceSeparator(&(pself->UIG_target), 1, TRUE); */
  AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);

  if (pself->UIG_target.class != (ClassStruct *)&HTGenTextClass) {
	/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	   !!!!!!!!!!!!!!!!!! To Be Filled In !!!!!!!!!!!!!!!!!!!!!
	   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
    ;
  }
  /*
   * Get the last align token from the stack.
   */
  new_just = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION();
  new_attr = new_just << VTPAA_JUSTIFICATION_OFFSET;

  @call pself->UIG_target.obj::MSG_VIS_TEXT_SET_PARA_ATTRIBUTES(
		old_attr, new_attr,
		TEXT_ADDRESS_PAST_END,
		TEXT_ADDRESS_PAST_END);
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_ALIGN.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_START_PARAGRAPH for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Denotes a paragraph
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/16/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_START_PARAGRAPH
{
  optr content, tmp;
  ClassStruct *class;
  StyleType groupType;
  int counter, level, i;
  char displayType, tab[1] = { C_TAB };
  /*
   *  If the current object is special, <P> implies to finish it.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenOptionClass) {
    /*
     *  Done with the option object
     */
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ
	(pself->UIG_target.obj);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
       (pself->UIG_target.obj);
#endif
    @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS(&tmp, &class);
    EC_ERROR_IF(class != (ClassStruct *)&HTGenSelectClass,
	UIG_UI_TREE_OPERATION_FAILS);
    /*
     *  Done the selection object.
     */
    @call tmp::MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
    /*
     *  End the GenOuterSelectClass.
     */
    @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(pself->UIG_target.obj), &(pself->UIG_target.class));
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
       (pself->UIG_target.obj);
#endif
  }
  /*
   *  Tell a HTML content object that we are starting a new paragraph.
   *  Push format tokens onto the format stack.
   *  Here we consider a new paragraph means the start of a new alignment
   *  and a line break.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  /*  start of a new alignment */
/*  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_ALIGN); */
  /*  we'll insert a line break after the paragraph is done */
/*  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_PARAGRAPH); */
  /*
   *  Process the attributes
  ProcessParagraphAttr(dataBlock, dataChunk, content);
   */
  /*
   * Add a line feed, to let the new alignment take effect.
   */
  /*  AddSpaceSeparator(&(pself->UIG_target), 2, FALSE); */
  AddNewLine(&(pself->UIG_target), 2, pself->UIG_pmObj, pself->UIG_content);
  /*
   *  Indent if inside a list of something.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);

  for(i = 0; i <= level; i++)
    @send pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);
  /*
   * If the current target.obj is a text, change the alignment now.
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass)
    @call content::MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
	(pself->UIG_target.obj);
   */

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_PARAGRAPH.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_START_DIV for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    denote a different kinds of containers, e.g.
 *		    chapter, section, abstract, or appendix.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/22/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_START_DIV
{
  /*
   * Push format token onto the format stack.
   */
/*  PushFormatStack(STYLE_ALIGN); 
  PushFormatStack(STYLE_PARAGRAPH); */
  /*
   * Add a blank line
   */
  /*  AddSpaceSeparator(&(pself->UIG_target), 1, TRUE); */
  AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
  /*
   * Process the attribute list.
  ProcessParagraphAttr(dataBlock, dataChunk, &(pself->UIG_target));
   */

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_DIV.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_NOBR for UIGeneratorClass
 ***********************************************************************
