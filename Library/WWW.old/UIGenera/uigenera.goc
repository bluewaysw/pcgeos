 *
 ***********************************************************************/
@method HTGenLineFeedClass, MSG_VIS_RECALC_SIZE
{
/*  CompSizeHintArgs sizeHintArgs; */
  Rectangle retValue, limitSize;
  SizeAsDWord size;

  size = @callsuper();
  @call pself->HTGLF_previous::MSG_VIS_GET_BOUNDS(&retValue);
  @call @genParent::MSG_VIS_GET_BOUNDS(&limitSize);

/*
  sizeHintArgs.CSHA_width = SST_PIXELS | (400 - retValue.R_right);
  sizeHintArgs.CSHA_height = 0;
  sizeHintArgs.CSHA_count = 0;
  @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(CompSizeHintArgs), &sizeHintArgs);
*/
  size = MAKE_SIZE_DWORD(/* 370 - retValue.R_right */ 390, 0);
  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *	MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Broadcast the MSG_VIS_RECALC_SIZE and 
 *                  MSG_VIS_POSITION_BRANCH down the ui (sub)tree.
 * PARAMETERS:	    (optr object)  object - parent of the (sub)tree.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/26/96   	Initial Revision
 *
 ***********************************************************************/
@method UIGeneratorClass, MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
{
  while(1) {
    if(object == NULL ||
       (@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenHtmlContentClass) ||
       object == pself->UIG_pmObj) && 
       !@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenCaptionClass)) { 
      /* &&
       !@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) { 
       The above is needed for nested image in caption for a table nested
       in another table.  However, it makes ui generator extreemely slow.
       More work is need to solve this problem.
       */
      if (!object) {
	object = pself->UIG_pmObj;
      }
      if (@call object::MSG_GEN_GET_USABLE()) {
	@send object::MSG_VIS_RECALC_SIZE
	   (RSA_CHOOSE_OWN_SIZE, RSA_CHOOSE_OWN_SIZE);
	@send object::MSG_VIS_POSITION_BRANCH(0,0);
      }
      break;
    }
    else
      object = @call object::MSG_GEN_FIND_PARENT();
  }
  return;
}	/* End of MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION.	*/



/***********************************************************************
 *		MSG_GEN_DESTROY for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method UIGeneratorClass, MSG_META_DETACH
{
  int count, i;
  HTMemHandle map;
  MapItem *mapItem;

  @callsuper();
  if (pself->UIG_currentMap) {
    HTMemFree(pself->UIG_currentMap);
    pself->UIG_currentMap = NULL;
  }
  if (AreaMaps) {
    if ((count = HTListGetCount(AreaMaps)) > 0) {
      for (i = 0; i < count; i++) {
	HTListGetItem(AreaMaps, i, &map, sizeof(HTMemHandle));
	mapItem = (MapItem *)HTMemLock(map);
	HTListDelete(mapItem->MI_areas);
	HTMemFree(mapItem->MI_mapName);
	HTMemUnlockAndFree(map);
      }
    }
    HTListDelete(AreaMaps);
    AreaMaps = NULL;
  }
  
  return;
}	/* End of MSG_GEN_DESTROY.	*/

