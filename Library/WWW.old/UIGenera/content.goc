@include <WWW/uigenera.goh>
@include <uifatals.goh>

@classdecl	HTGenHtmlContentClass;

#define POPPED	1	/* a previous list just popped off the stack */


/***********************************************************************
 *  MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Format the text object according to the current
 *		    HTML content.
 * PARAMETERS:	    (optr text, GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/15/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT
{
  int 		n;
  WWFixed 	number;
  StyleType 	token;
  FontID	fontId;
  /*
   * Set the default tabs.
   */
  @send text::MSG_VIS_TEXT_SET_DEFAULT_TABS(TAB_SIZE,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  /*
   * Set the font.  STYLE_FW_FONT is handled here.
   */
  if (!(pself->HTGHC_cntFWFont))
    fontId = FID_DTC_URW_SANS;
  else
    fontId = FID_DTC_URW_MONO;
  @send text::MSG_VIS_TEXT_SET_FONT_ID(fontId,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  /*
   * Set the font size.  The size is stored in the font stack.  Thus,
   * this handles any <FONT SIZE=n> that have been encountered before
   * the creation of the text object.  I.e. STYLE_FONT is handled here.
   */
  number.WWF_int = @call self::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  number.WWF_frac = 0;
  @call text::MSG_VIS_TEXT_SET_POINT_SIZE
		(number, TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  /*
   * Set the gstate
   */
  GrSetFont(gstate, fontId, MakeWWFixed(number.WWF_int));
  /* 
   *  Get the last alignment and set to the text object.  I.e
   *  STYLE_ALIGN is handled here.
   */
  @call self::MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT(text);

  for (n = 0, token = pself->HTGHC_formatStack[0];
	n < pself->HTGHC_formatIndex;
	n++, token = pself->HTGHC_formatStack[n]) {
    switch (token) {
	case STYLE_STRIKE:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_STRIKE_THRU);
	  break;
	case STYLE_ITALIC:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_ITALIC);
	  break;
	case STYLE_ANCHOR:
	  if (pself->HTGHC_hrefToken != -1) {
	    @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_UNDERLINE);
	    @call text::MSG_GEN_TEXT_RECORD_HREF       
                                (ELEMENT_START, pself->HTGHC_hrefToken);
	  }
	  break;
	case STYLE_BOLD:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_BOLD);
	  break;
	case STYLE_SUPERSCRIPT:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_SUPERSCRIPT);
	  break;
	case STYLE_SUBSCRIPT:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_SUBSCRIPT);
	  break;
	case STYLE_BQ:
/**	  FormatSetTextBQ (text); ****/
	  break;
  	case STYLE_PARAGRAPH:
	  break;
	case STYLE_ALIGN:
	  break;
	case STYLE_FONT:
	  number.WWF_int = @call self::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
	  number.WWF_frac= 0;
	  @call text::MSG_VIS_TEXT_SET_POINT_SIZE
	     (number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
	  break;
	case STYLE_FW_FONT:
	  if (!pself->HTGHC_cntFWFont)
	    @send text::MSG_VIS_TEXT_SET_FONT_ID(FID_DTC_URW_SANS,
						 TEXT_ADDRESS_PAST_END,
						 TEXT_ADDRESS_PAST_END);
	  break;
	case STYLE_PRE:
	case STYLE_UL:
	case STYLE_OL:
	  /* Already handled */
	case STYLE_HEADER:
	case STYLE_DL:
	  /* does nothing */
	  break;
    } /* end of switch */
  } 
  return;

}	/* End of MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_SET_CONTENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Add a new content type to the object.
 * PARAMETERS:	    (StyleType type)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_CONTENT
{
  pself->HTGHC_formatStack[pself->HTGHC_formatIndex] = type;
  pself->HTGHC_formatIndex++;
  EC_ERROR_IF(pself->HTGHC_formatIndex > 20, UIG_ERROR_IN_CONTENT_STACK);

  switch (type) {
    case STYLE_ANCHOR:
	pself->HTGHC_cntUnderline++;
	EC_WARNING_IF(pself->HTGHC_cntUnderline > 1,
		      UIG_NESTED_ANCHORS_IN_CONTENT);
	break;
    case STYLE_BOLD:
	pself->HTGHC_cntBold++;
	break;
    case STYLE_ITALIC:
	pself->HTGHC_cntItalic++;
	break;
    case STYLE_STRIKE:
	pself->HTGHC_cntStrike++;
	break;
    case STYLE_SUPERSCRIPT:
	pself->HTGHC_cntSuperscript++;
	break;
    case STYLE_SUBSCRIPT:
	pself->HTGHC_cntSubscript++;
	break;
    case STYLE_FW_FONT:
	pself->HTGHC_cntFWFont++;
	break;
  }
  return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_CONTENT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_REMOVE_CONTENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Remove a content type from the object.
 * PARAMETERS:	    StyleType (int &counter)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_REMOVE_CONTENT
{
  StyleType type;

  *counter = 0;

  EC_ERROR_IF(pself->HTGHC_formatIndex == 0, UIG_ERROR_IN_CONTENT_STACK);
  pself->HTGHC_formatIndex--;
  type = pself->HTGHC_formatStack[pself->HTGHC_formatIndex];
  /*
   *  Clear stack element.
   */
  pself->HTGHC_formatStack[pself->HTGHC_formatIndex] = NULL;

  switch (type) {
    case STYLE_ANCHOR:
	*counter = --pself->HTGHC_cntUnderline;
	break;
    case STYLE_BOLD:
	*counter = --pself->HTGHC_cntBold;
	break;
    case STYLE_ITALIC:
	*counter = --pself->HTGHC_cntItalic;
	break;
    case STYLE_STRIKE:
	*counter = --pself->HTGHC_cntStrike;
	break;
    case STYLE_SUPERSCRIPT:
	*counter = --pself->HTGHC_cntSuperscript;
	break;
    case STYLE_SUBSCRIPT:
	*counter = --pself->HTGHC_cntSubscript;
	break;
    case STYLE_FW_FONT:
	*counter = --pself->HTGHC_cntFWFont;
	break;
  }
  EC_WARNING_IF(*counter < 0, UIG_UNBALANCED_COUNTER);
  return type;
}	/* End of MSG_GEN_HTML_CONTENT_REMOVE_CONTENT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Get the current content type.
 * PARAMETERS:	    StyleType ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE
{
  return pself->HTGHC_formatStack[pself->HTGHC_formatIndex-1];
}	/* End of MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    (StyleType type)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT
{
  int count = 0;

  switch (type) {
    case STYLE_ANCHOR:
	count = pself->HTGHC_cntUnderline;
	break;
    case STYLE_BOLD:
	count = pself->HTGHC_cntBold;
	break;
    case STYLE_ITALIC:
	count = pself->HTGHC_cntItalic;
	break;
    case STYLE_STRIKE:
	count = pself->HTGHC_cntStrike;
	break;
    case STYLE_SUPERSCRIPT:
	count = pself->HTGHC_cntSuperscript;
	break;
    case STYLE_SUBSCRIPT:
	count = pself->HTGHC_cntSubscript;
	break;
    case STYLE_FW_FONT:
	count = pself->HTGHC_cntFWFont;
	break;
  }
  return count;
}	/* End of MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_FONT_SIZE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Return the current font size
 * PARAMETERS:	    byte ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_FONT_SIZE
{

  if(pself->HTGHC_fontIndex == 0)
	return DEFAULT_STYLE_FONT;

  return pself->HTGHC_fontStack[(pself->HTGHC_fontIndex) - 1];
}	/* End of MSG_GEN_HTML_CONTENT_GET_FONT_SIZE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Push a font size to the font stack.
 * PARAMETERS:	    (int size)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
{
  pself->HTGHC_fontStack[pself->HTGHC_fontIndex] = size;
  pself->HTGHC_fontIndex++;
  EC_ERROR_IF(pself->HTGHC_fontIndex > 10, UIG_ERROR_IN_CONTENT_STACK);

  return;
}	/* End of MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_POP_FONT_SIZE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Pop a font size off the font stack
 * PARAMETERS:	    int ();
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_POP_FONT_SIZE
{
  FontType size;

  if(pself->HTGHC_fontIndex == 0) {	/* It's impossible, but in case */
	EC_WARNING(UIG_INVALID_OPERATION);
	return DEFAULT_STYLE_FONT;      /* it's 0, return default. */
  }

  pself->HTGHC_fontIndex--;
  /* delete current font size */
  pself->HTGHC_fontStack[pself->HTGHC_fontIndex] = NULL;

  if(pself->HTGHC_fontIndex == 0)
	return DEFAULT_STYLE_FONT;	/* empty stack, return default */

  /* get the previous font size */
  size = pself->HTGHC_fontStack[pself->HTGHC_fontIndex - 1];

  return size;
}	/* End of MSG_GEN_HTML_CONTENT_POP_FONT_SIZE.	*/


/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Push a justification type to the align stack.
 * PARAMETERS:	    (Justfication align)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION
{
  pself->HTGHC_alignStack[pself->HTGHC_alignIndex] = align;
  pself->HTGHC_alignIndex++;
  EC_ERROR_IF(pself->HTGHC_alignIndex == 0, UIG_ERROR_IN_CONTENT_STACK);
  return;
}	/* End of MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION.	*/


/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Pop off one justification token from the align stack
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION
{
  if(pself->HTGHC_alignIndex == 0) {
	EC_WARNING(UIG_INVALID_OPERATION);
	return;
  }
  pself->HTGHC_alignIndex--;
  pself->HTGHC_alignStack[pself->HTGHC_alignIndex] = NULL;
  return;
}	/* End of MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION.	*/


/***********************************************************************
 *    MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Get the current text justification
 * PARAMETERS:	    Justification ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION
{
  if(pself->HTGHC_alignIndex == 0)
	return DEFAULT_ALIGNMENT;

  return pself->HTGHC_alignStack[pself->HTGHC_alignIndex - 1];
}	/* End of MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    (StyleType groupType, int start, char displayType)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP
{
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_groupType=groupType;
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_counter=start;
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_displayType=displayType;
  pself->HTGHC_listIndex++;
  EC_ERROR_IF(pself->HTGHC_listIndex > 10, UIG_ERROR_IN_CONTENT_STACK);
  return;
}	/* End of MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_POP_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_POP_LIST_GROUP
{
  if(pself->HTGHC_listIndex == 0) {	/* It's impossible, but in case */
	EC_WARNING(UIG_INVALID_OPERATION);
	return;
  }
  /*
   *  If there was any previous list group, it has POPPED, so erase it.
   */
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_groupType = NULL;

  pself->HTGHC_listIndex--;
  /* delete current font size */
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_groupType = POPPED;
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_counter = NULL;
  pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_displayType = NULL;

  return;
}	/* End of MSG_GEN_HTML_CONTENT_POP_LIST_GROUP.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Get the latest list goup information.
 * PARAMETERS:	(StyleType *group,int *counter,char *type,int *level)
 * 		group - <OL> or <UL>, or -1 if no list groups
 *		start - the next numeric number for the next list item
 *		type  - display type, A | a | I | i | 1
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
{
  if (pself->HTGHC_listIndex == 0) {
	*group = -1;
	*level = -1;
	return;
  }
  *group = pself->HTGHC_listStack[(pself->HTGHC_listIndex)-1].LG_groupType;
  *counter = pself->HTGHC_listStack[(pself->HTGHC_listIndex)-1].LG_counter;
  *type  = pself->HTGHC_listStack[(pself->HTGHC_listIndex)-1].LG_displayType;
  *level = pself->HTGHC_listIndex - 1;
}	/* End of MSG_GEN_HTML_CONTENT_GET_LIST_GROUP.	*/


/***********************************************************************
 *MSG_HTGHC_MSG_GEN_HTML_CONTENT_GET_ANY_LAST_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Is there any list group that just ended?
 * PARAMETERS:	    Boolean ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_HTGHC_MSG_GEN_HTML_CONTENT_GET_ANY_LAST_LIST_GROUP
{
  if (pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_groupType == POPPED){
	pself->HTGHC_listStack[pself->HTGHC_listIndex].LG_groupType = NULL;
	return TRUE;
  }
  else
	return FALSE;
}	/* End of MSG_HTGHC_MSG_GEN_HTML_CONTENT_GET_ANY_LAST_LIST_GROUP.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_UPDATE_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Update the LG_counter in the current OL group
 * PARAMETERS:	    (int start)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_UPDATE_COUNTER
{
  EC_WARNING_IF(pself->HTGHC_listIndex == 0, UIG_INVALID_OPERATION);
  EC_WARNING_IF(pself->HTGHC_listStack[pself->HTGHC_listIndex-1].\
	LG_groupType != STYLE_OL, UIG_INVALID_OPERATION);

  pself->HTGHC_listStack[pself->HTGHC_listIndex-1].LG_counter = start;
}	/* End of MSG_GEN_HTML_CONTENT_UPDATE_COUNTER.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	Increment the counter in the last group info.  This new
 *		counter value will be the number of the next list item.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER
{
  EC_WARNING_IF(pself->HTGHC_listIndex == 0, UIG_INVALID_OPERATION);
  EC_WARNING_IF(pself->HTGHC_listStack[pself->HTGHC_listIndex-1].\
	LG_groupType != STYLE_OL, UIG_INVALID_OPERATION);

  pself->HTGHC_listStack[(pself->HTGHC_listIndex)-1].LG_counter++;
}	/* End of MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER.	*/



/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
{
  VisTextParaAttrAttributes new_attr = 0, old_attr = 0;
  Justification	new_just, old_just;
  /*
   * Get the last align token off the stack.
   */
  if(pself->HTGHC_alignIndex == 0)
	new_just = DEFAULT_ALIGNMENT;
  else
	new_just = pself->HTGHC_alignStack[(pself->HTGHC_alignIndex)-1];
  
  if(pself->HTGHC_alignIndex <= 1)
	old_just = DEFAULT_ALIGNMENT;
  else
	old_just = pself->HTGHC_alignStack[(pself->HTGHC_alignIndex)-2];
  /*
   * Set the alignment.
   */
  new_attr = new_just << VTPAA_JUSTIFICATION_OFFSET;
  old_attr = old_just << VTPAA_JUSTIFICATION_OFFSET;
  @call text::MSG_VIS_TEXT_SET_PARA_ATTRIBUTES(
		old_attr, new_attr, 
		TEXT_ADDRESS_PAST_END,
		TEXT_ADDRESS_PAST_END);
  return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the hyperlink token.
 * PARAMETERS:	    (int token)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 6/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN
{
  pself->HTGHC_hrefToken = token;
}	/* End of MSG_GEN_HTML_CONTENT_SET_HREF_TOKEN.	*/



/***********************************************************************
 *MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the current object, find the current row
 *                  number and its x position in the row.
 * PARAMETERS:	    (optr obj, SizeAsDWord size, int *row)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE
{
  if (pself->HTGHC_currentObj != obj) {
    /*
     *  If this is a new object encountered for the first time(i.e.
     *  the previous object has settled), we update instance data
     *  to calculate the x position of the new object.
     */
    pself->HTGHC_accumulatedPrevWidth += pself->HTGHC_widthCurrentObj+MARGIN;
    if (!pself->HTGHC_maxHeightInRow)
      pself->HTGHC_maxHeightInRow = DWORD_HEIGHT(size);
    else if (pself->HTGHC_heightCurrentObj > pself->HTGHC_maxHeightInRow) {
      pself->HTGHC_maxHeightInRow = pself->HTGHC_heightCurrentObj;
    }
    pself->HTGHC_currentObj = obj;
  }
  pself->HTGHC_widthCurrentObj = DWORD_WIDTH(size);
  pself->HTGHC_heightCurrentObj= DWORD_HEIGHT(size);
  /*
   *  The new object is in the row number = array index + 1.
   *  The height element(array index + 1) doesn't exist in the height 
   *  array yet because we don't know its height until we will have
   *  encountered all the objects in the new row.
   */
  *row = pself->HTGHC_rowIndex + 1;
  return pself->HTGHC_accumulatedPrevWidth;
}	/* End of MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the variables and array that keep track of 
 *                  row information(specifically the row heights).
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER
{
  pself->HTGHC_rowIndex = -1;
  pself->HTGHC_currentObj = NULL;
  pself->HTGHC_maxHeightInRow = pself->HTGHC_heightCurrentObj = 
  pself->HTGHC_widthCurrentObj = 0;
  pself->HTGHC_sumOfHeights = MARGIN;    /* top margin */
  pself->HTGHC_accumulatedPrevWidth = 0; 
  pself->HTGHC_maxRowWidth = 0;
  if (pself->HTGHC_heightArray)
      HTListDeleteAllItems(pself->HTGHC_heightArray);
  else
      pself->HTGHC_heightArray = HTListNew();

  return;
}	/* End of MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the row number, return its absolute y- 
 *                  document coordinate.
 * PARAMETERS:	    (int row);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT
{
  int height = 0;
  /*  if (pself->HTGHC_heightIndex && pself->HTGHC_heightIndex != -1) */
  EC_ERROR_IF(row > pself->HTGHC_rowIndex, 1);
  HTListGetItem(pself->HTGHC_heightArray, row, &height, sizeof(int));
  return height;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_START_NEW_ROW for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    The current row is filled up with objects.  So, 
 *                  append the current row height to the 
 *                  HTGHC_heightArray.  Initialize all the instance
 *                  variables to the next new row.
 * PARAMETERS:	    int (SizeAsDWord size, int *row);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_START_NEW_ROW
{
  int height = DWORD_HEIGHT(size);

  if (pself->HTGHC_maxHeightInRow == 0)  /*  short cut */
    return 0;
  /*
   *  Add the current row height(= height of the highest object in the 
   *  row) to the accmulator (sumOfHeights).
   */
  /* Also add the bottom margin */
  pself->HTGHC_sumOfHeights += (pself->HTGHC_maxHeightInRow + MARGIN);
  /*
   *  Append the height of the finished row in the heightArray.
   */
  pself->HTGHC_rowIndex = HTListAppend
    (pself->HTGHC_heightArray, &(pself->HTGHC_sumOfHeights), sizeof(int));
  /*
   *  The new object is in the row number = array index + 1.
   *  The height element(array index + 1) doesn't exist in the height 
   *  array yet because we don't know its height untill we will have
   *  encountered all the objects in the new row.
   */
  *row = pself->HTGHC_rowIndex + 1;
  /*
   *  Update the maximum row width.
   */
  if (pself->HTGHC_accumulatedPrevWidth > pself->HTGHC_maxRowWidth)
    pself->HTGHC_maxRowWidth = pself->HTGHC_accumulatedPrevWidth;
  /*
   *  Initialize maxHeightInRow to the the height of the first object 
   *  in the new row.
   */
  pself->HTGHC_maxHeightInRow = height;    /* in the new row */
  pself->HTGHC_accumulatedPrevWidth = MARGIN; /* right margin */

  return pself->HTGHC_accumulatedPrevWidth;
}	/* End of MSG_GEN_HTML_CONTENT_START_NEW_ROW.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Sum up all the row heights in document.
 * PARAMETERS:	    int ();
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS
{
  /*
   *  HTGHC_sumOfHeights accumulates the row heights up to n-1 rows.
   *  HTGHC_maxHeightInRow keeps the row height of the n_th row.
   */
  return   pself->HTGHC_sumOfHeights + pself->HTGHC_maxHeightInRow 
    + MARGIN;  /* add the top and bottom margin */
}	/* End of MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Update the max height of the object in a row.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT
{
  /*
   *  HTGHC_heightCurrentObj is the height of the last object in the row.
   *  If it's greater the the max. height seen previously, update the max.
   */
  if (pself->HTGHC_heightCurrentObj > pself->HTGHC_maxHeightInRow)
       pself->HTGHC_maxHeightInRow = pself->HTGHC_heightCurrentObj;
  return;
}	/* End of MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT.	*/


/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_DESTROY
{
  @callsuper();
  HTListDelete(pself->HTGHC_heightArray);
  return;
}	/* End of MSG_GEN_DESTROY.	*/

