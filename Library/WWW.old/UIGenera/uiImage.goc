@end BmpData;


/***********************************************************************
 *		MSG_VIS_DRAW for HTGenImageClass
 ***********************************************************************
 * SYNOPSIS:	    Draw the image object.
 * PARAMETERS:	    void (DrawFlags drawFlags, 
 *			  GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_VIS_DRAW
{
  Rectangle bounds;
  Bitmap *bmp;

  @call self::MSG_VIS_GET_BOUNDS(&bounds);

  if(@self->HTGI_load) {
      /*
       * if the image been loaded, draw the real image
       */
      if(@self->HTGI_bitmapFile && @self->HTGI_bitmapBlock) {
	  GrDrawHugeBitmap(gstate, bounds.R_left + 3, bounds.R_top + 3,
		       @self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);
      }
      if (pself->HTGI_hrefToken != -1 && pself->HTGI_ismap == FALSE 
	  && pself->HTGI_focalAnchor != -1) {
	  /*
	   *  Draw the focus outline if it currently has the navigation focus.
	   */
	  GrSetLineMaskSys(gstate, SDM_50);
	  GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	  GrDrawRect(gstate, 
	       pself->HTGI_focalBound.RD_left, 
	       pself->HTGI_focalBound.RD_top, 
	       pself->HTGI_focalBound.RD_right, 
	       pself->HTGI_focalBound.RD_bottom);
      }
  } else {
      /*
       * else just draw a small icon
       */
      MemLock(OptrToHandle(@ImageIcon));
      bmp = LMemDeref(@ImageIcon);
      GrDrawBitmap(gstate, bounds.R_left + 3, bounds.R_top + 3,
		   bmp, 0);
      MemUnlock(OptrToHandle(@ImageIcon));
  }
}	/* End of MSG_VIS_DRAW.	*/



@method HTGenImageClass, MSG_VIS_RECALC_SIZE
{
  VisTextInstance  *vself;
  SizeAsDWord size;

  if (pself->HTGI_width && pself->HTGI_height) /* 5 to make some margin */
    size = MAKE_SIZE_DWORD(pself->HTGI_width+5,pself->HTGI_height+5);
  else if (pself->HTGI_width)
    size = MAKE_SIZE_DWORD(pself->HTGI_width+5,pself->HTGI_width+5);
  else if (pself->HTGI_height)
    size = MAKE_SIZE_DWORD(pself->HTGI_height+5, pself->HTGI_height+5);
  else
    size = MAKE_SIZE_DWORD(20,20);
  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();

  xOrigin = DWORD_X(xy) + pself->HTGI_xPos;
  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight(oself, pself->HTGI_pageRow);
  @callsuper();
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_META_UIG_CALC_POSITION for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_META_UIG_CALC_POSITION
{
  int row;
  SizeAsDWord size = @call self::MSG_VIS_GET_SIZE();
  /*
   *  Get an estimated position of the object
   */
  pself->HTGI_xPos = UpdateItsPotentialPosition(oself, size, &row);
  pself->HTGI_pageRow = row;

  return;
}	/* End of MSG_META_UIG_CALC_POSITION.	*/



/***********************************************************************
 *		MSG_META_START_SELECT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	Pass the mouse coordinates to the server.    
 * PARAMETERS:	void (MouseReturnParams *retVal,
 *		      sword xPosition, sword yPosition,
 *		      word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_META_START_SELECT
{
  Rectangle bound;
  int rel_x, rel_y, count, i;
  char *name, *name2;
  MapItem *mapItem;
  optr pmanager;
  HTMemHandle map;

  @callsuper();
  if (!(GET_BUTTON_INFO(inputState) & BI_PRESS))
    return;
  /*
   *  Find the mouse position relative to the (left, top) of the image.
   */
  @call self::MSG_VIS_GET_BOUNDS(&bound);
  rel_x = xPosition - bound.R_left;
  rel_y = yPosition - bound.R_top;
  if (pself->HTGI_usemap) {
      /*
       *  If there is a usemap, find the right map item from the usemap 
       *  list and find get the area item in that map item.
       */
      if ((count = HTListGetCount(AreaMaps)) > 0) {
	name2=(char*)HTMemLock(pself->HTGI_usemap);
        for (i = 0; i < count; i++) {
	  HTListGetItem(AreaMaps, i, &map, sizeof(HTMemHandle));
	  mapItem = (MapItem *)HTMemLock(map);
	  name=(char*)HTMemLock(mapItem->MI_mapName);
	  if (strcmp(name, name2+1) == 0) {
	    /*
	     *  Found the right <MAP> item.  See which <AREA> item that
	     *  the mouse event falls into.
	     */
	    pmanager = @call self::MSG_META_GET_OBJ_BLOCK_OUTPUT();
	    FigureDestinationForMouseEvent
		(mapItem->MI_areas, rel_x, rel_y, pmanager, oself);
	    HTMemUnlock(mapItem->MI_mapName);
	    HTMemUnlock(map);
	    break;
	  }
	  else {
	    HTMemUnlock(mapItem->MI_mapName);
	    HTMemUnlock(map);
	  }
	}
	HTMemUnlock(pself->HTGI_usemap);
      }
  }
  else if (pself->HTGI_ismap == TRUE && pself->HTGI_src) {
    /*  There is a href Token on this image */
    pmanager = @call self::MSG_META_GET_OBJ_BLOCK_OUTPUT();
    @call pmanager::MSG_PM_REFER_MAPLINK(rel_x, rel_y, pself->HTGI_src);
  }
  else if (pself->HTGI_hrefToken != -1) {
    /*  There is a href Token on this image */
    pmanager = @call self::MSG_META_GET_OBJ_BLOCK_OUTPUT();
    @call pmanager::MSG_PM_REFER_HYPERLINK(pself->HTGI_hrefToken);
  }
  else if (pself->HTGI_hrefToken == -1) {
    /*  There is no href Token on this image */
    pmanager = @call self::MSG_META_GET_OBJ_BLOCK_OUTPUT();
    @call pmanager::MSG_PM_CLEAR_HREF_LINK();
  }
  return;
}	/* End of MSG_META_START_SELECT.	*/



/***********************************************************************
 *		MSG_META_PTR for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_META_PTR
{
  Rectangle bound;
  Boolean found = FALSE;
  char *name, *name2;
  MapItem *mapItem;
  HTMemHandle map;
  int rel_x, rel_y, i, count;


  @callsuper();

  if (pself->HTGI_usemap) {
    /*
     *  If there is a usemap, find the right map item from the usemap 
     *  list and find get the area item in that map item.
     */
    if ((count = HTListGetCount(AreaMaps)) > 0) {
      @call self::MSG_VIS_GET_BOUNDS(&bound);
      rel_x = xPosition - bound.R_left;
      rel_y = yPosition - bound.R_top;
      /*
       *  Get an element and lock down its block.
       */
      name2 = (char*)HTMemLock(pself->HTGI_usemap);
      for (i = 0; i < count; i++) {
	HTListGetItem(AreaMaps, i, &map, sizeof(HTMemHandle));
	mapItem = (MapItem *)HTMemLock(map);
	name=(char *)HTMemLock(mapItem->MI_mapName);
	if (strcmp(name, name2+1) == 0) {
	  /*
	   *  Found the right <MAP> item.  See which <AREA> item that
	   *  the mouse event falls into.
	   */
	  found = FigureDestinationForMouseEvent
	    (mapItem->MI_areas, rel_x, rel_y, NULL, oself);
	  HTMemUnlock(mapItem->MI_mapName);
	  HTMemUnlock(map);
	  break;
	}
	else {
	  HTMemUnlock(mapItem->MI_mapName);
	  HTMemUnlock(map);
	}
      }
      HTMemUnlock(pself->HTGI_usemap);
    }
  }
  else if (pself->HTGI_hrefToken != -1) {
    found = TRUE;
  }

  if (found == TRUE) {
    /*  There is a href Token on this image */
    retVal->ptrImage = @BoxCursor;
    /* this event processed */
    retVal->flags = MRF_PROCESSED | MRF_SET_POINTER_IMAGE;
  }
  else
    retVal->flags = MRF_PROCESSED | MRF_CLEAR_POINTER_IMAGE;
  return;
}	/* End of MSG_META_PTR.	*/



/***********************************************************************
 *	MSG_UI_GENERATOR_START_MAP for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a MAP memory block to sotre AREA coordinates.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 8/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_MAP
{
  char *value, *cptr;
  HTMemHandle mapItem, nameChunk;
  MapItem *item;
  int index;
  /*
   *  Get the NAME attribute
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      /*
       *  Create a list if not exists.
       */
      if (!AreaMaps)
	return UI_GEN_ERROR;
      /*
       *  Allocate a MapItem
       */
      mapItem = HTMemAlloc(sizeof(MapItem));
      nameChunk = HTMemAlloc(sizeof(char) * (strlen(value)+1));
      /*
       *  Store the map name in MapItem.
       */
      item = (MapItem *)HTMemLock(mapItem);
      item->MI_mapName = nameChunk;
      cptr = (char *)HTMemLock(item->MI_mapName);
      strcpy(cptr, value);
      HTMemUnlock(item->MI_mapName);
      /*
       *  Allocate a memory block for the storage of the AREAs information.
       */
      item->MI_areas = HTListNew();
      HTMemUnlock(mapItem);
      /*
       *  Set the current mapItem in the UIGenerator, thus the later
       *  <AREA> elements are attached to this current MAP info.
       */
      @self->UIG_currentMap = mapItem;
      /*
       *  Append this map info in the list.
       */
      HTListAppend(AreaMaps, (void *)&mapItem, sizeof(HTMemHandle));
    }
  }

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_MAP.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_END_MAP for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    End the <MAP> business.
 * PARAMETERS:	    none.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/14/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_MAP
{
  /* 
   *  Done with the current Map.
   */
  pself->UIG_currentMap = NULL;
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_MAP.	*/



