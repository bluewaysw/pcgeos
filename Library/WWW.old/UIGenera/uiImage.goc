/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_IMAGE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an image object to render an image file.
 * PARAMETERS:	    (MemHandle block, SGML *entity, Boolean load)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 8/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_IMAGE
{
  optr dummy;
  HTMemHandle usemap;
  /* 
   *  If there is some object in UIG_target, we can assume the
   *  object is done.  Thus, give the object to the presentation
   *  manager for rendering.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTCellClass ||
      pself->UIG_target.class == (ClassStruct *)&HTGenTableClass ||
      pself->UIG_target.class == (ClassStruct *)&HTGenFormClass)
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
		(pself->UIG_target.obj);
  else if (pself->UIG_target.obj) {
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ \
		(pself->UIG_target.obj);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION(pself->UIG_target.obj);
#endif
  }
  /*
   *  Now create an image object and store it in target.obj.  Next, 
   *  process the passed attribute list.
   */
  dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
	((ClassStruct *)&HTGenImageClass);

  usemap = @call dummy::MSG_GEN_IMAGE_PROCESS_ATTRIBUTE(block,entity,load);
  /*
   *  
  if (usemap) {

  }
   */
  /*
   *  Set hyperlink on it if the current content has <A>...</A>
   */
  if (pself->UIG_hrefToken != -1) {
    @call dummy::MSG_META_SET_OBJ_BLOCK_OUTPUT(pself->UIG_pmObj);
    @call dummy::MSG_GEN_IMAGE_SET_HYPERLINK(pself->UIG_hrefToken);
  }

  /*
   *  Done with the image object
   */
  @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
#if 1
  @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION(dummy);
#endif
  @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&(pself->UIG_target.obj), &(pself->UIG_target.class));
  if (pself->UIG_target.obj == pself->UIG_pmObj) {
	pself->UIG_target.obj = NULL;
	pself->UIG_target.class = NULL;
  }
/*   return UI_GEN_NO_ERROR; */
  return dummy;
}	/* End of MSG_UI_GENERATOR_CREATE_IMAGE.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_SINGLE_IMAGE for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    create a single image object
 * PARAMETERS:	    nothing
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/28/97   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_SINGLE_IMAGE
{
  optr dummy;

  dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
	((ClassStruct *)&HTGenImageClass);

  @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);

  return dummy;
}	/* End of MSG_UI_GENERATOR_CREATE_SINGLE_IMAGE.	*/



