@method HTGenImageClass, MSG_GEN_IMAGE_FIND_LINK_IN_RECT
{
    if (pself->HTGI_hrefToken != -1 && pself->HTGI_ismap)
	return TRUE;
    else
	return FALSE;
}	/* End of MSG_GEN_IMAGE_FIND_LINK_IN_RECT.	*/


/***********************************************************************
 *		MSG_META_DETACH for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    when destroy the image, clean its bitmap.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	2/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_META_DETACH
{
    HugeArrayDestroy(@self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);
    if (pself->HTGI_src)
	HTMemFree(pself->HTGI_src);
    if (pself->HTGI_alt)
	HTMemFree(pself->HTGI_alt);
    if (pself->HTGI_usemap)
	HTMemFree(pself->HTGI_usemap);

    @callsuper();
}	/* End of MSG_META_DETACH.	*/

@start BmpData;
