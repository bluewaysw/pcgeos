/***********************************************************************
 *		MSG_GEN_IMAGE_ADD_ONE_LINE for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word line
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	1/30/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_ADD_ONE_LINE
{
  GStateHandle gstate;

  if(@self->first_draw) {
 	@send self::MSG_VIS_MARK_INVALID(
		VOF_IMAGE_INVALID, VUM_DELAYED_VIA_UI_QUEUE);
	@self->first_draw = FALSE;
	return;
  } else {
      gstate = @call self::MSG_VIS_VUP_CREATE_GSTATE();
      @send self::MSG_VIS_DRAW(0, gstate);
      GrDestroyState(gstate);
  }
}	/* End of MSG_GEN_IMAGE_ADD_ONE_LINE.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_DRAW_FOCUS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw the focus outline.
 * PARAMETERS:	    (GStateHandle gstate, Rectangle *objRect, 
 *                   RectDWord *rect)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_DRAW_FOCUS
{
  EventHandle msg;

  if (pself->HTGI_hrefToken != -1 && pself->HTGI_ismap == FALSE) {
    rect->RD_left = objRect->R_left + 1;
    rect->RD_top = objRect->R_top + 1;
    rect->RD_right = objRect->R_right - 1;
    rect->RD_bottom = objRect->R_bottom - 1;
    GrDrawRect(gstate, rect->RD_left, rect->RD_top, 
	       rect->RD_right, rect->RD_bottom);
    pself->HTGI_focalAnchor = 0;
    pself->HTGI_focalBound = *rect;

    msg = @record PresentationManagerClass::MSG_PM_DISPLAY_HREF_TARGET
	(@self->HTGI_hrefToken);
    @send self::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);

  }
  else
      rect->RD_right = rect->RD_left = 0;

  return;
}	/* End of MSG_GEN_IMAGE_DRAW_FOCUS.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_UNDRAW_FOCUS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Erase the focus outline.
 * PARAMETERS:	    (GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_UNDRAW_FOCUS
{
    GrSaveState(gstate);
    GrSetLineMaskSys(gstate, SDM_50);
    GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
    GrSetMixMode(gstate, MM_XOR);
    GrDrawRect(gstate, 
	       pself->HTGI_focalBound.RD_left, 
	       pself->HTGI_focalBound.RD_top, 
	       pself->HTGI_focalBound.RD_right, 
	       pself->HTGI_focalBound.RD_bottom);
    GrRestoreState(gstate);
    pself->HTGI_focalAnchor = -1;
    return;
}	/* End of MSG_GEN_IMAGE_UNDRAW_FOCUS.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_FIND_LINK_IN_RECT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Does this image have hyperlink on it?
 * PARAMETERS:	    
