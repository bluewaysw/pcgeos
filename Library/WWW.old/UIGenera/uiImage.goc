/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_AREA for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Specifies the shape of a "hot spot" in a client-
 *		    side image map.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_AREA
{
  char *value, *cptr;
  int index;
  HTMemHandle areaItem, tmpChunk;
  AreaItem *aItem;
  MapItem *mItem;

  if (!AreaMaps || !pself->UIG_currentMap)
    return UI_GEN_ERROR;		/*  <AREA> appears outside of <MAP>! */

  /*
   *  Allocate an AREA item to store the information
   */
  areaItem = HTMemAlloc(sizeof(AreaItem));
  aItem = (AreaItem *)HTMemLock(areaItem);
  aItem->AI_shape = AREA_RECT;  /* default shape */
  aItem->AI_coords = NULL;
  /*
   *  Get the NAME attribute
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_HREF:
    case HTML_ATTR_COORDS:
      tmpChunk = HTMemAlloc(sizeof(char) *strlen(value)+1);
      cptr = (char *)HTMemLock(tmpChunk);
      strcpy(cptr,value);
      HTMemUnlock(tmpChunk);
      if (entity[index].SGMLE_token == HTML_ATTR_HREF)	/* href */
	aItem->AI_href = tmpChunk;
      else
	aItem->AI_coords = tmpChunk;
      break;
    case HTML_ATTR_ALT:
      break;
    case HTML_ATTR_SHAPE:
      if (strcasecmp("rect", value) == 0 || 
	  strcasecmp("rectangle", value) == 0)
	aItem->AI_shape = AREA_RECT;
      else if (strcasecmp("circ", value) == 0 ||
	       strcasecmp("circle", value) == 0)
	aItem->AI_shape = AREA_CIRC;
      else if (strcasecmp("poly", value) == 0 ||
	       strcasecmp("polygon", value) == 0)
	aItem->AI_shape = AREA_POLY;
      else
	aItem->AI_shape = AREA_DEFAULT;
      break;
    }
  }

  mItem = (MapItem *)HTMemLock(@self->UIG_currentMap);

  HTListAppend(mItem->MI_areas,	(void *)&areaItem, sizeof(HTMemHandle));
  HTMemUnlock(@self->UIG_currentMap);
  HTMemUnlock(areaItem);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_AREA.	*/



/***********************************************************************
 *		FigureDestinationForMouseEvent
 ***********************************************************************
 *
 * SYNOPSIS:	Given the mouse coordinate and a list of <AREA>s, 
 *		check which <AREA> the mouse event falls into and 
 *		loads the specified URL.
 * CALLED BY:	void (HTListHandle areas;, rel_x, rel_y, optr image)
 * RETURN:	none.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/15/96   	Initial Revision
 *
 ***********************************************************************/
Boolean FigureDestinationForMouseEvent
(HTListHandle areaHandle, int x, int y, optr pmanager, optr image)
{
  int count, i, num;
  long c_x, c_y, cr;
  char *coord;
  AreaItem *areaItem;
  HTMemHandle area;
  GStateHandle gstate;
  Point *list;
  Rectangle rect;
  Boolean found = FALSE;
  WindowHandle win;

#if 0
  /* start testing */
  Rectangle test;
  /* end testing */
#endif 0

  if ((count = HTListGetCount(areaHandle)) > 0) {
    for (i = 0; i < count; i++) {
      HTListGetItem(areaHandle, i, &area, sizeof(HTMemHandle));
      areaItem = (AreaItem *)HTMemLock(area);
      if (!areaItem->AI_coords && !areaItem->AI_href) {
	HTMemUnlock(area);
	break;
      }
      else if (!areaItem->AI_coords && areaItem->AI_href) {
	if (areaItem->AI_shape == AREA_DEFAULT && pmanager) {
	  @call pmanager::MSG_PM_REFER_MAPLINK(-1,-1,areaItem->AI_href);
	  found = TRUE;
	}
	HTMemUnlock(area);
	break;
      }
      coord = (char*)HTMemLock(areaItem->AI_coords);
      /*
       *  Now check if the mouse event falls into the area.
       */
      if (areaItem->AI_shape == AREA_RECT) {
	ConvertRectSize(coord, &rect);
#if 0
	/* start testing */
	@call image::MSG_VIS_GET_BOUNDS(&test);
	win = @call image::MSG_VIS_QUERY_WINDOW();
	gstate = GrCreateState(win);
	GrDrawRect(gstate, test.R_left+rect.R_left, test.R_top+rect.R_top,
		   test.R_left+rect.R_right, test.R_top+rect.R_bottom);
	GrDestroyState(gstate);
	/* end testing */
#endif
	if (rect.R_left < x && rect.R_right > x && 
	    rect.R_top < y && rect.R_bottom > y) {
	  if (pmanager)
	    @call pmanager::MSG_PM_REFER_MAPLINK(-1,-1,areaItem->AI_href);
	  found = TRUE;
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
        }
      }
      else if (areaItem->AI_shape == AREA_CIRC) {
	ConvertCircleSize(coord, &c_x, &c_y, &cr);
#if 0
	/* start testing */
	@call image::MSG_VIS_GET_BOUNDS(&test);
	win = @call image::MSG_VIS_QUERY_WINDOW();
	gstate = GrCreateState(win);
	GrDrawEllipse(gstate, test.R_left+c_x-cr, test.R_top+c_y-cr, 
		      test.R_left+c_x+cr, test.R_top+c_y+cr);
	GrDestroyState(gstate);
	/* end testing */
#endif
	c_x = (c_x > x) ? (c_x - x) : (x - c_x);
	c_y = (c_y > y) ? (c_y - y) : (y - c_y);
	if ((c_x*c_x + c_y*c_y) < cr*cr) {
	  if (pmanager)
	    @call pmanager::MSG_PM_REFER_MAPLINK(-1,-1,areaItem->AI_href);
	  found = TRUE;
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
        }
      }
      else if (areaItem->AI_shape == AREA_POLY) {
	win = @call image::MSG_VIS_QUERY_WINDOW();
	gstate = GrCreateState(win);
	@call image::MSG_VIS_GET_BOUNDS(&rect);
	if((list = ConvertPolygonSize(coord, &num, &rect)) == NULL) {
	  GrDestroyState(gstate);
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
	}
#if 0
	/* start testing */
	GrDrawPolyline(gstate, list, num);
	/* end testing */
#endif
	if (GrTestPointInPolygon
	    (gstate,ODD_EVEN,list,num,x+rect.R_left,y+rect.R_top)) {
	  if (pmanager)
	    @call pmanager::MSG_PM_REFER_MAPLINK(-1,-1,areaItem->AI_href);
	  found = TRUE;
	  free(list);
	  GrDestroyState(gstate);
	  HTMemUnlock(areaItem->AI_coords);
	  HTMemUnlock(area);
	  break;
	}
	else {
	  free(list);
	  GrDestroyState(gstate);
	}
      }
      HTMemUnlock(areaItem->AI_coords);
      HTMemUnlock(area);
    }

  }
  return found;
}	/* End of FigureDestinationForMouseEvent.	*/


/***********************************************************************
 *		ConvertRectSize
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/16/96   	Initial Revision
 *
 ***********************************************************************/
int nextInteger(char *cptr)
{
  int i;
  for (i = 0; cptr[i] != NULL && cptr[i] != ',' &&
	cptr[i] >= '0' && cptr[i] <= '9'; i++)
	;
  if (cptr[i] == ',')
	i++;
  return i;
}


/***********************************************************************
 *		ConvertRectSize
 ***********************************************************************
 *
 * SYNOPSIS:	Read a char array, and return Rectangle.
 * CALLED BY:	void (char *coord, Rectangle *rect)
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/17/96   	Initial Revision
 *
 ***********************************************************************/
void ConvertRectSize (char *coord, Rectangle *rect)
{
  int	len;

  rect->R_left = rect->R_top = rect->R_right = rect->R_bottom = 0;

  rect->R_left = atoi(coord);
  if ((len = nextInteger(coord)) == 0)
	return;
  coord += len;
  rect->R_top = atoi(coord);
  if ((len = nextInteger(coord)) == 0)
	return;
  coord += len;
  rect->R_right = atoi(coord);
  if ((len = nextInteger(coord)) == 0)
	return;
  coord += len;
  rect->R_bottom = atoi(coord);

  return;
}	/* End of ConvertRectSize.	*/



/***********************************************************************
 *		ConvertPolygonSize
 ***********************************************************************
 *
 * SYNOPSIS:	Read a char array, create and return a array of Points.
 * CALLED BY:	
 * RETURN:	Points *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/16/96   	Initial Revision
 *
 ***********************************************************************/
Point *
ConvertPolygonSize(char *coord, int *cnt, Rectangle *rect)
{
  int len, i;
  char *cptr = coord;
  Point *point;

  for(*cnt = 1, cptr = coord; *cptr != NULL; cptr++) {
    if (*cptr == ',')
	(*cnt)++;
  }
  if (*cnt % 2)		/* not a pair */
    return NULL;

  *cnt = *cnt / 2;
  point = malloc(sizeof(Point) * (*cnt));

  for (i = 0; i < *cnt; i++) {
    point[i].P_x = atoi(coord) + rect->R_left;
    len = nextInteger(coord);
    EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
    coord += len;
    point[i].P_y = atoi(coord) + rect->R_top;
    len = nextInteger(coord);
    EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
    coord += len;
  }
  return point;
}	/* End of ConvertPolygonSize.	*/



/***********************************************************************
 *		ConvertCircleSize
 ***********************************************************************
 *
 * SYNOPSIS:	Read a char array, and get the (x, y) and r values.
 * CALLED BY:	void (char *coord, int *cx, int *cy, int *r);
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/17/96   	Initial Revision
 *
 ***********************************************************************/
void 
ConvertCircleSize (char *coord, long *cx, long *cy, long *cr)
{
  int len;

  *cx = atoi(coord);
  len = nextInteger(coord);
  EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
  coord += len;
  *cy = atoi(coord);
  len = nextInteger(coord);
  EC_WARNING_IF(len == 0, UIG_UNBALANCED_POLY_PAIRS);
  coord += len;
  *cr = atoi(coord);

  return;
}	/* End of ConvertCircleSize.	*/

