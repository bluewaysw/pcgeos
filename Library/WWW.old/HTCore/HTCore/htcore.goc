@include <WWW/htcore.goh>
@include "HTCore/htentry.goh"  /* All Library entry routines. */
@include "htfatals.goh"

/* 
 * Must be defined for fatal errors and warnings in htfatals.goh. 
 */

#if ERROR_CHECK
FatalErrors htcoreFatalErrors;
Warnings    htcoreWarnings;
#endif


/***********************************************************************
 *		HTCORELIBRARYENTRY
 ***********************************************************************
 * SYNOPSIS:	Library entry to initial various WWW Library components.
 * CALLED BY:	Kernel
 * RETURN:	0, required by Kernel.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 1/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTCORELIBRARYENTRY (LibraryCallType ty, GeodeHandle client)
{
    HTRequestLibraryEntry(ty, client);
    HTNetLibraryEntry(ty, client);
    HTSockManLibraryEntry(ty, client);
    HTPolicyLibraryEntry(ty, client);
    HTStringLibraryEntry(ty, client);
    HTAALibraryEntry(ty, client);
    HTAnchorLibraryEntry(ty, client);

    return 0;  /* Required by Kernel. */
}	/* End of HTCORELIBRARYENTRY.	*/
