@ifndef __HT_WWWSTR_GOH__
@define __HT_WWWSTR_GOH__

@include <stdapp.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htutils.goh>
#include <Ansi/string.h>
@include "htfatals.goh"

/*
 * Converts to 1 through 12.
 */
static char *months[12] = {
    "Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"
};

/* 
 * Converts to 0 through 6. 
 * Why is Geos inconsistent in month/wkday numbering? 
 */
static char * wkdays[7] = {
    "Sun","Mon","Tue","Wed","Thu","Fri","Sat"
};




/***********************************************************************
 *		make_num
 ***********************************************************************
 *
 * SYNOPSIS:	Make a number from a two-digit string. First digit is
 *              optional (e.g., " 9" and "14" are valid).
 * CALLED BY:	
 * RETURN:	int
 * SIDE EFFECTS:
 *	
 * STRATEGY:    These functions are taken from the server written by
 *              Ari Luotonen in W3C HTWWWStr.c.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 8/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
make_num (const char *s)
{
    if (*s >= '0' && *s <= '9')
	return 10 * (*s - '0') + *(s+1) - '0';
    else
	return *(s+1) - '0';
}	/* End of make_num.	*/



/***********************************************************************
 *		make_wkday
 ***********************************************************************
 *
 * SYNOPSIS:	Generate a weekday number from s based on DayOfTheWeek.
 * CALLED BY:	
 * RETURN:	int, 0-based week day.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Inspired by make_month.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 8/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
make_wkday (const char *s)
{
    int i, ret = 0;

    PUSHDS;
    SET_DS_LIB_DGROUP;                /* Uses static var wkdays */

    for (i=0; i<7; i++)
	if (!strncasecmp(wkdays[i], s, 3)) {
	    ret = i;
	    break;
	}

    POPDS;
    return ret;
}	/* End of make_wkday.	*/




/***********************************************************************
 *		make_month
 ***********************************************************************
 *
 * SYNOPSIS:	Make month number from its characters.
 * CALLED BY:	int, 1-based month.
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Ported from W3C make_month in HTWWWStr.c. Modified by 
 *              kkee to convert to Geos month format which starts from 
 *              1 instead 0.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 8/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
make_month (const char *s)
{
    int i, ret=0;
    PUSHDS;
    SET_DS_LIB_DGROUP;          /* Uses static var months */
    for (i=0; i<12; i++)
	if (!strncasecmp(months[i], s, 3)) {
	    ret=i+1;
	    break;
	}
    POPDS;
    return ret;
}	/* End of make_month.	*/




/***********************************************************************
 *		HTPARSETIME
 ***********************************************************************
 *
 * SYNOPSIS:    Parse a str in GMT format to a local time 
 *              TimerDateAndTime representation. 
 *              Four formats are accepted:
 *
 *		Wkd, 00 Mon 0000 00:00:00 GMT		(rfc1123)
 *		Weekday, 00-Mon-00 00:00:00 GMT		(rfc850)
 *		Wkd Mon 00 00:00:00 0000 GMT		(ctime)
 *		1*DIGIT					(delta-seconds) 
 *
 *              delta-seconds is NOT implemented!!!
 *
 * CALLED BY:	
 * RETURN:	TRUE if tm contains valid parsed TimerDateAndTime. 
 *              Otherwise FALSE.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Ported from W3C HTWWWStr.c HTParseTime which converts to
 *              Unix's time_t format. Why doesn't Geos use time_t format
 *              instead of the stupid TimerDateAndTime format????
 *              Arghhhhhhhhhhh!
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 8/96   	Initial Revision
 *
 ***********************************************************************/
Boolean _far _pascal
HTPARSETIME (const char *str, TimerDateAndTime *tm)
{
    const char * s, * p;

    if (!str) return FALSE;

    if ((s=strchr(str, ',')) != NULL) {/* Thursday, 10-Jun-93 01:29:59 GMT */
	s++;                          /* or: Thu, 10 Jan 1993 01:29:59 GMT */
	while (*s && *s==' ') s++;
	p = str;
	while (*p && *p==' ') p++;
	if (strchr(s,'-')) {				     /* First format */
	    if ((int)strlen(s) < 18) {
EC(		EC_WARNING(INVALID_TIME_FORMAT);                         )
		return FALSE;
	    }
	    tm->TDAT_dayOfWeek = make_wkday(p);
	    tm->TDAT_day = make_num(s);                /* day of the month */
	    tm->TDAT_month = make_month(s+3);
	    tm->TDAT_year = 1900 + make_num(s+7);      /* Assume 1900+ yr */
	    tm->TDAT_hours = make_num(s+10);
	    tm->TDAT_minutes = make_num(s+13);
	    tm->TDAT_seconds = make_num(s+16);
	} else {					    /* Second format */
	    if ((int)strlen(s) < 20) {   
EC(		EC_WARNING(INVALID_TIME_FORMAT);                         )
		return FALSE;
	    }
	    tm->TDAT_dayOfWeek = make_wkday(p);
	    tm->TDAT_day = make_num(s);
	    tm->TDAT_month = make_month(s+3);
	    tm->TDAT_year = 100*make_num(s+7) + make_num(s+9);
	    tm->TDAT_hours = make_num(s+12);
	    tm->TDAT_minutes = make_num(s+15);
	    tm->TDAT_seconds = make_num(s+18);

	}
    } else if (isdigit(*str)) {				    /* delta seconds */
	TimerGetDateAndTime(tm);              /* Current local calendar time */
	/* 
	 * This proves troublesome as I have to add delta seconds to tm...
	 * I wish I could do tm += atol(str);
	 */
	/* @@@ */
	return TRUE;

    } else {	      /* Try the other format:  Wed Jun  9 01:29:59 1993 GMT */
	s = str;
	while (*s && *s==' ') s++;
	if ((int)strlen(s) < 24) {
EC(		EC_WARNING(INVALID_TIME_FORMAT);                         )
	    return FALSE;
	}
	tm->TDAT_dayOfWeek = make_wkday(s);
	tm->TDAT_day = make_num(s+8);
	tm->TDAT_month = make_month(s+4);
	tm->TDAT_year = 100*make_num(s+20)+ make_num(s+22);
	tm->TDAT_hours = make_num(s+11);
	tm->TDAT_minutes = make_num(s+14);
	tm->TDAT_seconds = make_num(s+17);
    }
    if (tm->TDAT_seconds  < 0    ||  tm->TDAT_seconds  > 59  ||
	tm->TDAT_minutes  < 0    ||  tm->TDAT_minutes  > 59  ||
	tm->TDAT_hours    < 0    ||  tm->TDAT_hours    > 23  ||
	tm->TDAT_dayOfWeek< 0    ||  tm->TDAT_dayOfWeek> 6   ||
	tm->TDAT_day      < 1    ||  tm->TDAT_day      > 31  ||
	tm->TDAT_month    < 1    ||  tm->TDAT_month    > 12  ||
	tm->TDAT_year     < 1980 ||  tm->TDAT_year     > 2099) {
EC(     EC_WARNING(PARSED_ILLEGAL_TIME);                                )
	return FALSE;
    }

    /* 
     * There is no DayLightSaving field in TimerDateAndTime. Argh!!!
     */
#if 0
    /* This is Unix C time structure syntax */
    tm->tm_isdst = daylight;		       /* Already taken into account */
     /* OR */ 
    tm->tm_isdst = -1;
#endif

    return TRUE; 
}	/* End of HTPARSETIME.	*/


@endif
