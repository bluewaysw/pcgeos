@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htlist.goh>
#include <WWW/htmem.h>
@include <Ansi/string.h>
@include "htfatals.goh"


/* --------------------------------------------------------------------------
 * 		PRIVATE DATA
 * --------------------------------------------------------------------------*/

#define HTSTRING_HASH_TABLE_SIZE  51   /* Tunable */

/*
 * HTStringData is used to store HTStrings.
 */
@start HTStringData, data;

/*
 * HTStringResource is used in MemLock etc routines since we can't do 
 * MemLock(HTStringData), instead we have to use 
 * MemLock(OptrToHandle(@HTStringResource)). This is lame!
 */
@chunk char HTStringResource[] = "WWW HTString Library";

@chunk HTListHandle htStringHashTable[HTSTRING_HASH_TABLE_SIZE] = {0};

@end   HTStringData;


/* --------------------------------------------------------------------------
 * 		PRIVATE FUNCTIONS
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTStringDeleteAll
 ***********************************************************************
 *
 * SYNOPSIS:	Delete all elements in the hash table.
 * CALLED BY:	HTStringLibraryEntry
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/11/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
HTStringDeleteAll (void)
{
    HTListHandle *tptr;
    HTStringHandle stringHandle;
    word count, i, j, size = sizeof(HTStringHandle);
    MemHandle mh = OptrToHandle(@HTStringResource);

    MemLockExcl(mh);

    tptr = (HTListHandle *) LMemDeref(@htStringHashTable);

    for (i=0; i<HTSTRING_HASH_TABLE_SIZE; i++)
	if (tptr[i]) {
	    count = HTListGetCount(tptr[i]);

	    for (j=0; j<count; j++) {
		HTListRemoveItem(tptr[i], 0, &stringHandle, size);
		LMemFree(ConstructOptr(mh, stringHandle));
	    }

	    HTListDelete(tptr[i]);
	    tptr[i] = NULL;
	}

    MemUnlockExcl(mh);
}	/* End of HTStringDeleteAll.	*/



/* --------------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTStringLibraryEntry
 ***********************************************************************
 *
 * SYNOPSIS:	Initialize and cleanup HTString.
 * CALLED BY:	HTCoreLibraryEntry
 * RETURN:	0 required by Kernel
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/11/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTStringLibraryEntry (LibraryCallType ty, GeodeHandle client)
{
    if (ty == LCT_ATTACH) {
	/* 
	 * No need to clear the htStringHashTable as 
	 * all the buckets are zeros to begin with 
	 */

    } else if (ty == LCT_DETACH)
	HTStringDeleteAll();
    
    return 0;
}	/* End of HTStringLibraryEntry.	*/



/***********************************************************************
 *		ECCHECKHTSTRING
 ***********************************************************************
 *
 * SYNOPSIS:	Make sure a HTString is valid.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
ECCHECKHTSTRING (HTStringHandle string)
{
#if ERROR_CHECK
    MemHandle mh = OptrToHandle(@HTStringResource);

    if (!string) return;

    MemLockShared(mh);
    ECLMemExists(ConstructOptr(mh, string));
    MemUnlockShared(mh);
#endif
}	/* End of ECCHECKHTSTRING.	*/




/***********************************************************************
 *		HTSTRINGFOR
 ***********************************************************************
 *
 * SYNOPSIS:	Convert a NULL terminated string to a HTString.
 * CALLED BY:	Client.
 * RETURN:	HTStringHandle, or NULL if the string is empty.
 * SIDE EFFECTS:Locks the HTString exclusively using MemLockExcl,
 *
 *              You will deadlock if, while using HTSTRINGLOCK and
 *              before calling HTSTRINGUNLOCK, you call HTSTRINGFOR.
 *	
 * STRATEGY:    Allocate if it does not exist, else reuse an existing
 *              HTString. Uses a hash table to store and reuse HTStrings.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/11/96   	Initial Revision
 *
 ***********************************************************************/
HTStringHandle _far _pascal
HTSTRINGFOR (const char *string)
{
    const char* b;
    char *cptr;
    HTListHandle *tptr, list;
    HTStringHandle stringHandle;
    word hash, i, count, size = sizeof(HTStringHandle);
    MemHandle mh = OptrToHandle(@HTStringResource);
    Boolean found = FALSE;

#if ERROR_CHECK
    if (!strlen((char *)string)) EC_WARNING(HTSTRING_LENGTH_ZERO);   

    /* Lock count is in the upper byte */
    if (MemGetInfo(mh, MGIT_FLAGS_AND_LOCK_COUNT) & 0xff00)
	EC_ERROR(HTSTRING_RESOURCE_STILL_LOCKED);
#endif

    /* Empty string? */
    if (*string == '\0') return NULL;

    /* Generate hash function */
    for(b=string, hash=0; *b; b++) 
	hash =  (hash * 3 + (*(unsigned char *) b)) % 
	    HTSTRING_HASH_TABLE_SIZE;

    /* Search for the string in the hash table */
    MemLockExcl(mh);

    tptr = (HTListHandle *) LMemDeref(@htStringHashTable);

    list = tptr[hash];
    if (list) {
	count = HTListGetCount(list);

	for (i=0; i<count; i++) {
	    HTListGetItem(list, i, &stringHandle, size);
	    b = (char *)LMemDeref(ConstructOptr(mh, stringHandle));

	    if (!strcmp(b, string)) {
		found = TRUE;
		break;  /* Found! */
	    }
	}

    } else {
	/* Generate a new entry */
	if (!list) {
	    list = HTListNew();
	    tptr[hash] = list;
	}
    }
    

    /* Create a new HTString */
    if (!found) {

	stringHandle = LMemAlloc(mh, strlen((char *)string)+1);

	if (stringHandle) {
	    cptr = (char *)LMemDeref(ConstructOptr(mh, stringHandle));
	    strcpy(cptr, string);
	    HTListAppend(list, &stringHandle, size);
	}
    }

    MemUnlockExcl(mh);
	 
    return stringHandle;
}	/* End of HTSTRINGFOR.	*/




/***********************************************************************
 *		HTSTRINGLOCK
 ***********************************************************************
 *
 * SYNOPSIS:	Lock and dereference a HTString. You can read the string 
 *              using the return value. You *cannot* lock two HTStrings
 *              at the same time as that would a deadlock. If you need
 *              to read two HTStrings, lock one, read it, unlock it,
 *              and do it for the second HTString etc.
 * CALLED BY:	Client.
 * RETURN:	char pointer to string.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/11/96   	Initial Revision
 *
 ***********************************************************************/
const char* _far _pascal
HTSTRINGLOCK (HTStringHandle stringHandle)
{
    MemHandle mh = OptrToHandle(@HTStringResource);

EC( ECCheckHTString(stringHandle);                                       )

    if (!stringHandle) return NULL;
    MemLockShared(mh);
    return (char *) LMemDeref(ConstructOptr(mh, stringHandle));
}	/* End of HTSTRINGLOCK.	*/




/***********************************************************************
 *		HTSTRINGUNLOCK
 ***********************************************************************
 *
 * SYNOPSIS:	Unlock a HTString.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/11/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTSTRINGUNLOCK (HTStringHandle stringHandle)
{

EC( ECCheckHTString(stringHandle);                                       )

    if (!stringHandle) return;
    MemUnlockShared(OptrToHandle(@HTStringResource));
}	/* End of HTSTRINGUNLOCK.	*/



/***********************************************************************
 *		HTSTRINGLEN
 ***********************************************************************
 *
 * SYNOPSIS:	strlen for a HTStringHandle.
 * CALLED BY:	Client
 * RETURN:	int
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	1/21/97   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTSTRINGLEN (HTStringHandle stringHandle)
{
    const char *s;
    int ret;

EC( ECCheckHTString(stringHandle);                                       )

    s = HTStringLock(stringHandle);
    ret = strlen(s);

    HTStringUnlock(stringHandle);
    
    return ret;
}	/* End of HTSTRINGLEN.	*/




/***********************************************************************
 *		STRCASECMP
 ***********************************************************************
 *
 * SYNOPSIS:	Same as AnsiC strcmp, but case insensitive.
 * CALLED BY:	Client.
 * RETURN:	<0 if a<b
 *              0 if a==b
 *              >0 if a>b
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Copied from W3C HTString.c
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/25/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
STRCASECMP (const char *a, const char *b)
{
    int diff;

    for( ; *a && *b; a++, b++) {
	diff = tolower(*a) - tolower(*b);
	if (diff)
	    return diff;
    }

    if (*a) return 1;			/* a was longer than b */
    if (*b) return -1;			/* a was shorter than b */
    return 0;				/* Exact match */
}	/* End of STRCASECMP.	*/



/***********************************************************************
 *		STRCASECMPHTMEMHANDLE
 ***********************************************************************
 *
 * SYNOPSIS:    Same as strcasecmp, except that the first argument is a
 *              HTMemHandle.
 * CALLED BY:	Client
 * RETURN:	Same as strcasecmp
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	1/16/97   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
STRCASECMPHTMEMHANDLE (const HTMemHandle a, const char *b)
{
    char *s = (char *) HTMemLock(a);
    int ret;

    ret = strcasecmp(s, b);
    
    HTMemUnlock(a);

    return ret;
}	/* End of STRCASECMPHTMEMHANDLE.	*/




/***********************************************************************
 *		STRNCASECMP
 ***********************************************************************
 *
 * SYNOPSIS:	Same as strncmp, with case insensitive.
 * CALLED BY:	Client.
 * RETURN:	<0 if a<b
 *              0 if a==b
 *              >0 if a>b
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Copied from W3C HTString.c
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 1/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
STRNCASECMP (const char *a, const char *b, int n)
{
    const char *p, *q;
	
    for(p=a, q=b;; p++, q++) {
	int diff;
	if (p == a+n) return 0;	/*   Match up to n characters */
	if (!(*p && *q)) return *p - *q;
	diff = tolower(*p) - tolower(*q);
	if (diff) return diff;
    }

    /* We never get here, no need to return ? */
}	/* End of STRNCASECMP.	*/




/***********************************************************************
 *		STRCASESTR
 ***********************************************************************
 *
 * SYNOPSIS:	Like strstr(s1, s2), but case-insensitive.
 * CALLED BY:	Client.
 * RETURN:	pointer to first occurrence of string s2 in s1, or NULL
 *              if not present.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Copied from W3C HTString.c
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 2/96   	Initial Revision
 *
 ***********************************************************************/
char * _far _pascal
STRCASESTR (const char *s1, const char *s2)
{
    const char * ptr = s1;

    if (!s1 || !s2 || !*s2) return (char *) s1;

    while (*ptr) {
	if (toupper(*ptr) == toupper(*s2)) {
	    const char * cur1 = ptr + 1;
	    const char * cur2 = s2 + 1;
	    while (*cur1 && *cur2 && toupper(*cur1) == toupper(*cur2)) {
		cur1++;
		cur2++;
	    }
	    if (!*cur2)	return (char *) ptr;
	}
	ptr++;
    }
    return NULL;
}	/* End of STRCASESTR.	*/




/***********************************************************************
 *		STRTOLOWER
 ***********************************************************************
 *
 * SYNOPSIS:	Convert a string to all lower cases.
 * CALLED BY:	Client.
 * RETURN:	passed in string pointer.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
char * _far _pascal
STRTOLOWER (char *a)
{
    for ( ; *a; a++)
	*a = tolower(*a);

    return a;
}	/* End of STRTOLOWER.	*/



/***********************************************************************
 *		STRTOUPPER
 ***********************************************************************
 *
 * SYNOPSIS:	Convert a string to all upper cases.
 * CALLED BY:	Client.
 * RETURN:	passed in string pointer.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
char * _far _pascal
STRTOUPPER (char *a)
{
    for ( ; *a; a++)
	*a = toupper(*a);

    return a;
}	/* End of STRTOUPPER.	*/


/***********************************************************************
 *		STRLENHTMEM
 ***********************************************************************
 *
 * SYNOPSIS:	Same as Ansi strlen, but it takes a HTMemHandle.
 * CALLED BY:	Client.
 * RETURN:	string length.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/ 6/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
STRLENHTMEM (const HTMemHandle str)
{
    char *p;
    int ret;
    
    if (!str) return 0;
    p = (char *) HTMemLock(str);
    ret = strlen(p);
    HTMemUnlock(str);
    return ret;
}	/* End of STRLENHTMEM.	*/



/***********************************************************************
 *		STRCPYHTMEM
 ***********************************************************************
 *
 * SYNOPSIS:	Same as Ansi strcpy, but here we take two HTMemHandles.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/ 6/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
STRCPYHTMEM (const HTMemHandle s, const HTMemHandle t)
{
    char *p, *q;

    if (!s || !t) return;

    p = (char *) HTMemLock(s);
    q = (char *) HTMemLock(t);
    strcpy(p, q);

    HTMemUnlock(s);
    HTMemUnlock(t);
}	/* End of STRCPYHTMEM.	*/



/***********************************************************************
 *		STRCATHTMEM
 ***********************************************************************
 *
 * SYNOPSIS:	Same as Ansi strcat, but takes two HTMemHandles.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/ 6/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
STRCATHTMEM (const HTMemHandle s, const HTMemHandle ct)
{
    char *p, *q;

    if (!s || !ct) return;

    p = (char *) HTMemLock(s);
    q = (char *) HTMemLock(ct);
    strcat(p, q);
    HTMemUnlock(s);
    HTMemUnlock(ct);
}	/* End of STRCATHTMEM.	*/




/***********************************************************************
 *		HTSTRALLOCCOPY
 ***********************************************************************
 *
 * SYNOPSIS:	Allocate and copy a null-terminated string.
 *
 * CALLED BY:	Client.
 * RETURN:	HTMemHandle or NULL if cannot allocate.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/29/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTSTRALLOCCOPY (const char *str)
{
    HTMemHandle ret;
    char *p;
    
    if (!str) return NULL;

    p = (char *) HTMemAllocAndLock(&ret, strlen(str)+1);

    if (!ret) return NULL;
    
    strcpy(p, str);

    HTMemUnlock(ret);

    return ret;
}	/* End of HTSTRALLOCCOPY.	*/




/***********************************************************************
 *		HTSTRALLOCCAT
 ***********************************************************************
 *
 * SYNOPSIS:	Same as Ansi strcat, but take a HTMemHandle.
 * CALLED BY:	Client
 * RETURN:	HTMemHandle, containing s + t. If cannot allocate,
 *              return NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/10/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTSTRALLOCCAT (HTMemHandle s, const char *t)
{
    char *p;

    if (!s || !t) return NULL;

    s = HTMemReAlloc(s, strlenHTMem(s) + strlen(t) + 1);
    if (!s) return NULL;
    p = (char *) HTMemLock(s);
    strcat(p, t);
    HTMemUnlock(s);
    return s;
}	/* End of HTSTRALLOCCAT.	*/




/***********************************************************************
 *		HTSTRHTMEMALLOCCOPY
 ***********************************************************************
 *
 * SYNOPSIS:	Same as HTStrAllocCopy except we take a HTMemHandle here.
 *
 * CALLED BY:	Client
 * RETURN:	HTMemHandle, else NULL if cannot allocate.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/29/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTSTRHTMEMALLOCCOPY (const HTMemHandle str)
{
    HTMemHandle ret;
    char *p, *q;

    if (!str) return NULL;
    q = (char *) HTMemLock(str);
    p = (char *) HTMemAllocAndLock(&ret, strlen(q)+1);

    if (!ret) {
	HTMemUnlock(str);
	return NULL;
    }

    strcpy(p, q);

    HTMemUnlock(str);
    HTMemUnlock(ret);

    return ret;
}	/* End of HTSTRHTMEMALLOCCOPY.	*/



