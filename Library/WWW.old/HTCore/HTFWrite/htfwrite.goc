@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htfwrite.goh>


/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTFWriteClass;

/***********************************************************************
		Message Handlers
***********************************************************************/



/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Done writing.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_ABORT
{
    if (@self->HTFWI_fileHandle) {
	FileClose(@self->HTFWI_fileHandle, FALSE);
    }

    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/




/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Flush buffered data.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_FLUSH
{
    return HT_OK;   /* As we do not buffer any data */
}	/* End of MSG_HT_STREAM_FLUSH.	*/




/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Save data to a disk file.
 * PARAMETERS:	    int (byte *data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_PUT_BLOCK
{
    char *filename;
    int ret = HT_OK;

    /* Create a file for writing */
    if (!@self->HTFWI_fileHandle) {
	
	FilePushDir();
	FileSetStandardPath(SP_TOP);

	MemLock(OptrToHandle(@self->HTFWI_filename));
	filename = (char *) LMemDeref(@self->HTFWI_filename);

	@self->HTFWI_fileHandle = 
	    FileCreate(filename, 
		       FCF_NATIVE | FILE_CREATE_TRUNCATE |
		       FILE_DENY_RW | FILE_ACCESS_RW, 
		       FILE_ATTR_NORMAL);

	MemUnlock(OptrToHandle(@self->HTFWI_filename));

	FilePopDir();

	if (!@self->HTFWI_fileHandle)
	    return HT_CANNOT_OPEN_FILE;
    }

    if (FileWrite(@self->HTFWI_fileHandle, 
		  (void *) data, len, FALSE) == -1) {
	
	/* Failed to write */
	FileClose(@self->HTFWI_fileHandle, FALSE);
	
	FilePushDir();
	FileSetStandardPath(SP_TOP);
	
	FileDelete(filename);
	
	FilePopDir();
	
	ret = HT_CANNOT_WRITE_FILE;
    }

    return ret;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/

