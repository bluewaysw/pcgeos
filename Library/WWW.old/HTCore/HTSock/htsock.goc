/***********************************************************************
 *		HTSocketCreateStruct
 ***********************************************************************
 * SYNOPSIS:	Creates an asynchronous socket for reading and writing.
 * CALLED BY:   Client.	
 * RETURN:	HTSocketHandle, NullHandle if not created.
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:    Uses Geos socket Library.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/11/96   	Initial Revision
 *
 ***********************************************************************/
static HTSocketHandle _pascal
HTSocketCreateStruct (HTRequestHandle request, HTStreamHandle htsocket,
		      MemHandle htSockInfo, SemaphoreHandle isRunningSem)
{
    HTSocket *sptr;
    HTSocketHandle socket;

/* ECCheckRequest(request); Optional */

EC( ObjLockObjBlock(OptrToHandle(htsocket));                           )
EC( ECCheckObject(htsocket);                                           )
EC( MemUnlock(OptrToHandle(htsocket));                                 )
EC( ECCheckMemHandle(htSockInfo);                                      )

    socket = MemAlloc(sizeof(HTSocket), HF_SHARABLE | HF_SWAPABLE,
		      HAF_ZERO_INIT);

    if (!socket) return NullHandle;

    MemLock(socket);
    sptr = (HTSocket *) MemDeref(socket);

    /* 
     * Allocate a Geos socket.
     */
    if ((sptr->HTS_sockfd = SocketCreate(SDT_STREAM)) == 0) {
	MemUnlock(socket);
	MemFree(socket);
	return NullHandle;
    }

    /* 
     * Other default values for Geos socket specific info.
     */
    sptr->HTS_sockAddress.SA_port.SP_manuf = MANUFACTURER_ID_SOCKET_16BIT_PORT;
    PUSHDS;
    SET_DS_LIB_DGROUP;
    sptr->HTS_sockAddress.SA_domainSize = sizeof(tcpDomain) - 1;
    sptr->HTS_sockAddress.SA_domain = tcpDomain;
    POPDS;

    sptr->HTS_tcpAddress.HA_linkAddress.HTLA_size = 3;
    sptr->HTS_tcpAddress.HA_linkAddress.HTLA_type = LT_ID;

    sptr->HTS_htsocket = htsocket;
    sptr->HTS_htSockInfo = htSockInfo;
    sptr->HTS_threadIsRunning = isRunningSem;

    MemUnlock(socket);

    return socket;
}	/* End of HTSocketCreateStruct.	*/


/* 
 * We need this HTFixedCodeResource if we use TheadDestroy as 
 * ThreadDestroy can only be called from fixed code.
 * 
 * #pragma Code("HTFixedCodeResource") 
 */


/***********************************************************************
 *		HTSocketResolveAndConnectThread
 ***********************************************************************
 * SYNOPSIS:	Procedural thread for setting up a socket connection.
 * CALLED BY:   Kernel.
 * RETURN:	0, not used but required by the Kernel.
 * SIDE EFFECTS:
 * STRATEGY:    This routine must be declared with '_pascal' as Kernel's 
 *              StartThread routine calls it using 
 *              PROCCALLFIXEDORMOVABLE_PASCAL. 
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 6/96   	Initial Revision
 *
 ***********************************************************************/
word _pascal
HTSocketResolveAndConnectThread (HTSocketHandle socket)
{
    HTStreamHandle htsocket;
    HTSocketCallback cbf;
    SemaphoreHandle isRunning;
    int state;
    HTSocket *sptr;
    HTSocketInfo *siptr;

EC( ECCheckMemHandle(socket);                                           )

    MemLock(socket); 

    sptr = (HTSocket *) MemDeref(socket);

    if (HTSocketResolve(sptr) == HT_OK) {
	HTSocketConnect(sptr);
    }

    /*
     * Make a copy of data we want to use in callback as we can't
     * lock the socket in callback.
     */
    htsocket = sptr->HTS_htsocket;
    cbf = sptr->HTS_connectCbf;
    isRunning = sptr->HTS_threadIsRunning;

    MemLockShared(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    state = siptr->HTSI_state;
    MemUnlockShared(sptr->HTS_htSockInfo);

    MemUnlock(socket);
    
    if (cbf)
	ProcCallFixedOrMovable_pascal(htsocket, state, cbf);

    /* Acknowledge to HTSocket the thread is no longer running */
    ThreadVSem(isRunning);
    /*
     * ThreadDestroy sends MSG_META_ACK to htsocket. But we don't want
     * to loop using MSG_META_OBJ_FREE.
     *
     * ThreadDestroy(0, htsocket, ThreadGetInfo(0, TGIT_THREAD_HANDLE));
     *
     * Between ThreadVSem and exiting this thread, we have NOT exited
     * yet. We need a system API to KillThread(threadHandle) instead
     * of threadDestroy.
     */

    return 0;          /* Required by Kernel */
}	/* End of HTSocketResolveAndConnectThread.	*/

/* 
 * #pragma Code()
 */


@ifndef __TEST_HT_SOCKET__
@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		HTSocketReceiveThread
 ***********************************************************************
 *
 * SYNOPSIS:	Thread for receiving data. Possible socket states
 *              after thread exits: HT_OK, HT_CONNECTION_CLOSED,
 *              HT_INTERRUPTED, HT_SOCKET_ERROR.
 * CALLED BY:	Kernel
 * RETURN:	0, as required by kernel.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/14/96   	Initial Revision
 *
 ***********************************************************************/
word _pascal
HTSocketReceiveThread (HTSocketHandle socket)
{
    SemaphoreHandle isRunning;
    HTSocketCallback cbf;
    HTSocket *sptr;
    Socket sockfd;
    byte *buffer;
    HTStreamHandle target;
    HTSocketInfo *siptr;
    int state;
    SocketError errorCode = SE_NORMAL;
    word bytesRead;

EC( ECCheckMemHandle(socket);                                           )

    MemLock(socket);
    sptr = (HTSocket *) MemDeref(socket);
    sockfd = sptr->HTS_sockfd;
    target = sptr->HTS_target;
    buffer = sptr->HTS_buffer;
    cbf = sptr->HTS_receiveCbf;
    state = HT_OK;

    do {
	bytesRead =  SocketRecv(sockfd, 
				buffer,
				HTSOCKET_BUFFER_SIZE,
				2, /* short time out */
				0, 
				(SocketAddress *)0);
    
	if (bytesRead > 0) {
	    /* 
	     * Got data.
	     */
	    state = PUTBLOCK(target, buffer, bytesRead);
	    if (state != HT_OK)	break;  /* done! */

	} else if ((errorCode=ThreadGetError()) == SE_CONNECTION_CLOSED) {
	    state = HT_CONNECTION_CLOSED;
	    break;

	} else if (errorCode == SE_INTERRUPT) {
	    state = HT_INTERRUPTED;
	    break;

	} else if (errorCode != SE_NORMAL) {
	    state = HT_SOCKET_ERROR;
	    break;
	} 

	/* Fall through to errorCode == SE_NORMAL */
	/* Try again! */

    } while (state == HT_OK);

    /* Update execution state */
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = state;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    isRunning = sptr->HTS_threadIsRunning;
    MemUnlock(socket);

    if (cbf)
	ProcCallFixedOrMovable_pascal(target, state, cbf);

    ThreadVSem(isRunning);
    return 0;  /* Required by kernel */
}	/* End of HTSocketReceiveThread.	*/

@endif
@endif


@ifndef __TEST_HT_SOCKET__


/***********************************************************************
 *		HTSocketResolve
 ***********************************************************************
 * SYNOPSIS:	Blocking resolve. Possible HTSocket states after this 
 *              call: HT_RESOLVING_HOST_NAME,
 *              HT_CANNOT_RESOLVE_HOST_NAME and HT_OK.
 * CALLED BY:   MSG_HT_SOCKET_RESOLVE and HTSocketResolveAndConnectThread.
 * RETURN:	HT_OK if ok, else HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 6/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTSocketResolve (HTSocket *sptr)
{
    HTSocketInfo *siptr;
    int ret = HT_OK;

    /*
     * Resolve the raw IP address. Both character-based, e.g., 
     * www.geoworks.com, and numeric-based, e.g., 198.211.200.223, 
     * must be resolved.
     */
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = HT_RESOLVING_HOST;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    sptr->HTS_sockAddress.SA_addressSize = 
	SocketResolve(sptr->HTS_sockAddress.SA_domain, 
		      (byte *)&(sptr->HTS_tcpAddress),
		      sizeof(HTLinkAddress) + 
		      strlen(sptr->HTS_tcpAddress.HA_ipAddress),
		      (byte *)&(sptr->HTS_resolvedAddress),
		      MAX_RESOLVED_ADDRESS_LENGTH);

    /* Did we resolve the raw IP address? */

    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);

    if ((sptr->HTS_sockAddress.SA_addressSize == 0) ||
	(sptr->HTS_sockAddress.SA_addressSize >
	 MAX_RESOLVED_ADDRESS_LENGTH)) {
	/* Failed to resolve! */

	siptr->HTSI_state = HT_CANNOT_RESOLVE_HOST_NAME;
	ret = HT_NO;
    } else 
	siptr->HTSI_state = HT_OK;

    MemUnlockExcl(sptr->HTS_htSockInfo);

    return ret;
}	/* End of HTSocketResolve.	*/

@endif


@ifndef __TEST_HT_SOCKET__


/***********************************************************************
 *		HTSocketConnect
 ***********************************************************************
 * SYNOPSIS:	Blocking connect. Possible HTSocket states after this
 *              call: HT_CONNECTING_TO_SERVER, HT_OK, HT_LINK_FAILED, 
 *              HT_INTERRUPTED, and HT_CANNOT_CONNECT.
 * CALLED BY:	HTSocketConnectThread and HTSocketResolveAndConnectThread.
 * RETURN:	HT_OK if ok, else HT_NO.
 * SIDE EFFECTS:Update socket state in HTSocketInfo.HTSI_state.
 *
 * STRATEGY:   
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/11/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTSocketConnect (HTSocket *sptr)
{
    dword timerTicks;
    byte errorCode;  /* why can't SocketError errorCode work?? */
    HTSocketInfo *siptr;
    int ret = HT_NO;
    
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = HT_CONNECTING_TO_SERVER;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    /* 
     * Use SocketConnect as an estimate for round-trip time delay. 
     */
    timerTicks = TimerGetCount();

    errorCode = SocketConnect(sptr->HTS_sockfd, 
			      (SocketAddress *)&(sptr->HTS_sockAddress),
			      SOCKET_NO_TIMEOUT);

    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_connectionTime = TimerGetCount() - timerTicks;

    if ((errorCode == SE_NORMAL) || (errorCode == SE_SOCKET_IN_USE)) {
	/* 
	 * If we get SE_SOCKET_IN_USE, it means we are attempting to 
	 * connect an already connected socket. This is possible since 
	 * we may reuse HTSockets. 
	 */
	siptr->HTSI_state = HT_OK;
	ret = HT_OK;

	/* Save the medium to allow shutdown later */
	PUSHDS;
	SET_DS_LIB_DGROUP;
	SocketGetAddressMedium((SocketAddress *)&(sptr->HTS_sockAddress), 
			       &wwwMedium);
	wwwMediumIsUp = TRUE;
	POPDS;

    } else if ((errorCode == SE_LINK_FAILED) ||
	       (errorCode == SE_CONNECTION_RESET)) {
	/*
	 * LINK_FAILED indicates for some reason that we are not able
	 * use Geos socket; e.g., hardware not setup right, "ini" not
	 * correct.
	 * CONNECTION_RESET indicates that the server is refusing to 
	 * connect to us or we lack authentication. The authentication 
	 * here is not the same as HTTP authentcation.
	 */
        siptr->HTSI_state = HT_LINK_FAILED;

    } else if (errorCode == SE_INTERRUPT)
	siptr->HTSI_state = HT_INTERRUPTED;

    else
	siptr->HTSI_state = HT_CANNOT_CONNECT;

    MemUnlockExcl(sptr->HTS_htSockInfo);

    return ret;
}	/* End of HTSocketConnect.	*/

@endif 


@ifndef __TEST_HT_SOCKET__


/***********************************************************************
 *		HTSocketRecv
 ***********************************************************************
 * SYNOPSIS:	Read data into buffer. Possible HTSocket states after
 *              this call: HT_CONNECTION_CLOSED, HT_OK, HT_INTERRUPTED,
 *              HT_SOCKET_ERROR.
 * CALLED BY:	MSG_HT_SOCKET_READ and MSG_HT_SOCKET_READ_PTR.
 * RETURN:	number of bytes read.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    We can't use SOCKET_NO_TIMEOUT as we do not want the
 *              client to wait. The client can always try reading again.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 6/96   	Initial Revision
 *
 ***********************************************************************/
static word _pascal
HTSocketRecv (HTSocket *sptr, void *buffer, word length, int timeOut)
{
    word datasize;
    HTSocketInfo *siptr;
    SocketError errorCode = SE_NORMAL;

    datasize =  SocketRecv(sptr->HTS_sockfd, 
			   buffer,
			   length, 
			   timeOut,
			   0, 
			   (SocketAddress *)0);

    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);

    if (datasize > 0) {
	/* Data read. Ok */
	siptr->HTSI_state = HT_OK;

    } else if ((errorCode=ThreadGetError()) == SE_CONNECTION_CLOSED)
	siptr->HTSI_state = HT_CONNECTION_CLOSED;
 
    else if ((errorCode == SE_NORMAL) || (errorCode == SE_TIMED_OUT)) {
	/* 
	 * No data, but HTSI_state is still connected.
	 * Client should read later.
	 */
	siptr->HTSI_state = HT_OK;

    } else if (errorCode == SE_INTERRUPT) {
	siptr->HTSI_state = HT_INTERRUPTED;

    } else if (errorCode != SE_NORMAL)
	siptr->HTSI_state = HT_SOCKET_ERROR;

    MemUnlockExcl(sptr->HTS_htSockInfo);

    return datasize;
}	/* End of HTSocketRecv.	*/

@endif


@ifndef __TEST_HT_SOCKET__


/***********************************************************************
 *		HTSocketSend
 ***********************************************************************
 * SYNOPSIS:	Send data in buffer. Possible states after this call:
 *              HT_CONNECTION_CLOSED, HT_INTERRUPTED, HT_SOCKET_ERROR,
 *              HT_OK.
 * CALLED BY:	MSG_HT_SOCKET_WRITE and MSG_HT_STREAM_PUT_BLOCK.
 * RETURN:	HT_OK if written, else HT_SOCKET_ERROR.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/10/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTSocketSend (HTSocket *sptr, void *data, word length)
{
    SocketError status;
    HTSocketInfo *siptr;
    int ret = HT_OK;

    status = SocketSend(sptr->HTS_sockfd, data, length, 0, 
			(SocketAddress *)0);

    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);

    if (status == SE_CONNECTION_CLOSED) {
	siptr->HTSI_state = HT_CONNECTION_CLOSED;
	ret = HT_CONNECTION_CLOSED;

    } else if (status == SE_INTERRUPT) {
	siptr->HTSI_state = HT_INTERRUPTED;
	ret = HT_INTERRUPTED;

    } else if (status != SE_NORMAL)  {
	siptr->HTSI_state = HT_SOCKET_ERROR;
	ret = HT_SOCKET_ERROR;

    } else
	siptr->HTSI_state = HT_OK;

    MemUnlockExcl(sptr->HTS_htSockInfo);

    return ret;
}	/* End of HTSocketSend.	*/

@endif


/***********************************************************************
		Message Handlers
***********************************************************************/



/***********************************************************************
 *		MSG_META_OBJ_FREE for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Free socket instance data.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    Nothing
 *
 * STRATEGY:        We must synch termination of internal thread is
 *                  there is one.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_META_OBJ_FREE
{
    @call oself::MSG_HT_SOCKET_CLOSE();
    @callsuper();
}	/* End of MSG_META_OBJ_FREE.	*/



/***********************************************************************
 *		MSG_HT_SOCKET_INITIALIZE for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Initialize HTSocket before use. Must be called once.
 *                  Possible HTSocket states after this call:
 *                  HT_OK.
 * PARAMETERS:	    int (void)
 *                  - return HT_OK if initialization ok, else 
 *                    HT_SOCKET_ERROR.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_INITIALIZE
{
    HTSocketInfo *siptr;

    /* Close old socket if there is one. */
    @call oself::MSG_HT_SOCKET_CLOSE();

    @self->HTSI_htSockInfo = MemAlloc(sizeof(HTSocketInfo), 
				      HF_SHARABLE | HF_SWAPABLE,
				      HAF_ZERO_INIT | HAF_LOCK);
    if (!@self->HTSI_htSockInfo) return HT_SOCKET_ERROR;

    siptr = (HTSocketInfo *) MemDeref(@self->HTSI_htSockInfo);
    siptr->HTSI_state = HT_OK;

    MemUnlock(@self->HTSI_htSockInfo);

    /* Allocate a semaphore for synchcronizing background thread. */
    if (!@self->HTSI_threadIsRunning)
	@self->HTSI_threadIsRunning = ThreadAllocSem(1);

@ifdef __HT_STREAM_SOCKET__ 

    @self->HTSI_socket = 
	HTSocketCreateStruct(@self->HTSI_request, oself, 
			     @self->HTSI_htSockInfo, 
			     @self->HTSI_threadIsRunning);

@endif

@ifndef __HT_STREAM_SOCKET__

    @self->HTSI_socket = 
	 HTSocketCreateStruct(0, oself, @self->HTSI_htSockInfo,
			      @self->HTSI_threadIsRunning);

@endif

    if (!@self->HTSI_socket) {
	MemFree(@self->HTSI_htSockInfo);
	@self->HTSI_htSockInfo = NULL;

	ThreadFreeSem(@self->HTSI_threadIsRunning);
	@self->HTSI_threadIsRunning = NULL;

	return HT_SOCKET_ERROR;
    }

    return HT_OK;
}	/* End of MSG_HT_SOCKET_INITIALIZE.	*/



/***********************************************************************
 *		MSG_HT_SOCKET_GET_DESCRIPTOR for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Get Geos socket descriptor of HTSocket.
 * PARAMETERS:	    Socket (void), NULL if HTSocket is not initialized
 *                  using MSG_HT_SOCKET_INITIALIZE.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/14/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_GET_DESCRIPTOR
{
    Socket sockfd;
    HTSocket *sptr;

EC( if (!@self->HTSI_socket) EC_WARNING(HTSOCKET_NOT_INITIALIZED);      )

    if (!@self->HTSI_socket) return NULL;

    MemLockShared(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);
    sockfd = sptr->HTS_sockfd;
    MemUnlockShared(@self->HTSI_socket);

    return sockfd; 
    
}	/* End of MSG_HT_SOCKET_GET_DESCRIPTOR.	*/



/***********************************************************************
 *		MSG_HT_SOCKET_GET_STATE for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Get the state of a socket. Does not change HTSocket
 *                  state.
 * PARAMETERS:	    int (void), 
 *                  HT_OK
 *                     - previous operation on HTSocket was ok.
 *                  HT_NO
 *                     - htsocket was never initialized using 
 *                       MSG_HT_SOCKET_INITIALIZE.
 *                  HT_RESOLVING_HOST
 *                     - in the midst of resolving host.
 *                  HT_CANNOT_RESOLVE_HOST_NAME
 *                     - could not resolve host.
 *                  HT_CONNECTING_TO_SERVER
 *                     - in the midst of connecting to server.
 *                  HT_CANNOT_CONNECT
 *                     - could not connect to server.
 *                  HT_CONNECTION_CLOSED
 *                     - connection closed.
 *                  HT_LINK_FAILED
 *                     - low level link failed. Usually bad "ini" settings
 *                       or some low level protocol not working. Reboot!
 *                  HT_INTERRUPTED
 *                     - socket was interrupted.
 *                  HT_SOCKET_ERROR
 *                     - other generic unrecoverable socket error.
 *                  Others
 *                     - these are values returned from pushing data to 
 *                       target.
 * SIDE EFFECTS:    Nothing.
 *
 * STRATEGY:    We use MemLock to nondestructively look at the socket 
 *              status. This is important as HTSocketConnectThread may
 *              have locked the socket exclusively.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_GET_STATE
{
    int state;
    HTSocketInfo *siptr;

EC( if (!@self->HTSI_htSockInfo) EC_WARNING(HTSOCKET_NOT_INITIALIZED);  )

    if (!@self->HTSI_htSockInfo) return HT_NO;

    MemLockShared(@self->HTSI_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(@self->HTSI_htSockInfo);
    state = siptr->HTSI_state;
    MemUnlockShared(@self->HTSI_htSockInfo); 

    return state; 
}	/* End of MSG_HT_SOCKET_GET_STATE.	*/




/***********************************************************************
 *		MSG_HT_SOCKET_GET_CONNECT_TIME for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Get the time it took to perform an either
 *                  socketConnect. Does not change HTSocket state.
 * PARAMETERS:	    dword (void)
 *                  - return seconds or 0 if no socketConnect was 
 *                    performed prior to this call.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 2/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_GET_CONNECT_TIME
{
    dword time;
    HTSocketInfo *siptr;

EC( if (!@self->HTSI_htSockInfo) EC_WARNING(HTSOCKET_NOT_INITIALIZED);  )

    if (!@self->HTSI_htSockInfo) return 0;

    MemLockShared(@self->HTSI_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(@self->HTSI_htSockInfo);
    time = siptr->HTSI_connectionTime;
    MemUnlockShared(@self->HTSI_htSockInfo);

    return time; 
}	/* End of MSG_HT_SOCKET_GET_CONNECT_TIME.	*/




/***********************************************************************
 *		MSG_HT_SOCKET_GET_RESOLVED_ADDRESS for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Get the resolved hostname of HTSocket. If the name
 *                  was not resolved earlier using MSG_HT_SOCKET_RESOLVE,
 *                  the resolvedAddress returned is undefined. THis call
 *                  does not change HTSocket state.
 * PARAMETERS:	    word (byte *resolvedAddress, word length)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/30/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_GET_RESOLVED_ADDRESS
{
    HTSocket *sptr;
    word ret = 0;

EC( if (!@self->HTSI_socket) EC_WARNING(HTSOCKET_NOT_INITIALIZED);      )

    if (!@self->HTSI_socket) 
	return 0;  /* Don't write to resolvedAddress */

    MemLockShared(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    if ((sptr->HTS_sockAddress.SA_addressSize) && 
	(sptr->HTS_sockAddress.SA_addressSize >= length)) {
	memcpy(resolvedAddress, sptr->HTS_resolvedAddress, 
	       sptr->HTS_sockAddress.SA_addressSize);
	ret = sptr->HTS_sockAddress.SA_addressSize;

    } else if (sptr->HTS_sockAddress.SA_addressSize < length) {

EC( EC_WARNING(HTSOCKET_RESOLVED_ADDRESS_IS_LONGER_THAN_BUFFER);        )
    }

    MemUnlockShared(@self->HTSI_socket);

    return ret;
}	/* End of MSG_HT_SOCKET_GET_RESOLVED_ADDRESS.	*/




/***********************************************************************
 *		MSG_HT_SOCKET_RESOLVE_AND_CONNECT for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Nonblocking resolve and connect. Possible HTSocket
 *                  states after this call: 
 *                  HT_OK, 
 *                  HT_RESOLVING_HOST,
 *                  HT_CONNECTING_TO_SERVER,
 *                  HT_CANNOT_RESOLVE_HOST_NAME,
 *                  HT_LINK_FAILED, HT_INTERRUPTED,
 *                  and HT_CANNOT_CONNECT.
 * PARAMETERS:	    int (HTSocketAddress *htAddress), return HT_OK for
 *                  nonblocking resolve and connect is in progress,
 *                  else HT_NO.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Spawn a thread to perform socket resolve and connect.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 6/96   	Initial Revision
 *
 ***********************************************************************/
static word (*const resolveAndConnectFunc)(word) = 
	 &HTSocketResolveAndConnectThread;

@method HTSocketClass, MSG_HT_SOCKET_RESOLVE_AND_CONNECT
{
    HTSocket *sptr;
    HTSocketInfo *siptr;
    int ret = HT_OK;

EC( ECCheckProcessHandle(client);                                      )
EC( ECCheckMemHandle(@self->HTSI_socket);                              )

    /* Grab the thread running semaphore. */
    if (ThreadPTimedSem(@self->HTSI_threadIsRunning, 1) == SE_TIMEOUT) {
	/* 
	 * We already have a thread running. Come back later or 
	 * ignore? I take ignore. 
	 */
	return ret;
    }

EC( if (!@self->HTSI_socket) EC_WARNING(HTSOCKET_NOT_INITIALIZED);      )

    if (!@self->HTSI_socket) {  /* HTSocket not initialized */
	ThreadVSem(@self->HTSI_threadIsRunning);
	return HT_NO;
    }

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    /* Connect callback */
    sptr->HTS_connectCbf = cbf;

    /* Copy the HTSocketAddress */
    strcpy(sptr->HTS_tcpAddress.HA_ipAddress, htAddress->HTSA_ipAddress);
    sptr->HTS_sockAddress.SA_port.SP_port = htAddress->HTSA_port;
    sptr->HTS_tcpAddress.HA_linkAddress.HTLA_id = htAddress->HTSA_accessPoint;

    /* Changed from priority PRIORITY_STANDARD */
    @self->HTSI_runningThread = ThreadCreate(PRIORITY_HIGH, 
			     @self->HTSI_socket,
			     resolveAndConnectFunc,
			     SOCKET_THREAD_STACK_SIZE,
			     client);

    if (@self->HTSI_runningThread == NullHandle) {
	/* Failed to create a thread for nonblocking connect */
	MemLockExcl(@self->HTSI_htSockInfo);
	siptr = (HTSocketInfo *) MemDeref(@self->HTSI_htSockInfo);
	siptr->HTSI_state = HT_CANNOT_CONNECT;
	MemUnlockExcl(@self->HTSI_htSockInfo);

	ret = HT_NO;
	ThreadVSem(@self->HTSI_threadIsRunning);
    }
    /* 
     * Otherwise the runningThread will "V" the threadIsRunning 
     * semaphore.
     */

    MemUnlock(@self->HTSI_socket);
    return ret;
}	/* End of MSG_HT_SOCKET_RESOLVE_AND_CONNECT.	*/


@ifndef __TEST_HT_SOCKET__


/***********************************************************************
 *		MSG_HT_SOCKET_STOP for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Stop background resolve, connect, and receive. 
 *                  HTSocket states not affected after this call.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        If you want to stop synchronous operations, like 
 *                  htsocket read and htsocket write, you need to do it
 *                  outside of htsocket. Get the Geos socket descriptor
 *                  using MSG_HT_SOCKET_GET_DESCRIPTOR, then interrupt 
 *                  it using socketInterrupt.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/ 4/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_STOP
{
    HTSocket *sptr;
    int state = @call oself::MSG_HT_SOCKET_GET_STATE();

EC( if (!@self->HTSI_socket) EC_WARNING(HTSOCKET_NOT_INITIALIZED);      )

    if (!@self->HTSI_socket) return;

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    if (state == HT_RESOLVING_HOST) {
	SocketInterruptResolve(sptr->HTS_sockAddress.SA_domain,
			       (byte *)&(sptr->HTS_tcpAddress),
			       sizeof(HTLinkAddress) +
			       strlen(sptr->HTS_tcpAddress.HA_ipAddress));

    } 
    /* Try always interrupt socket to see if we can stop faster */
    SocketInterrupt(sptr->HTS_sockfd);

    MemUnlock(@self->HTSI_socket);

    /* If there is a thread running, wait for it to stop */
    if (@self->HTSI_runningThread) {
	ThreadPSem(@self->HTSI_threadIsRunning);
	ThreadVSem(@self->HTSI_threadIsRunning);
	@self->HTSI_runningThread = NULL;
    }
}	/* End of MSG_HT_SOCKET_STOP.	*/

@endif



/***********************************************************************
 *		MSG_HT_SOCKET_READ_PTR for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Read socket data into a buffer.
 * PARAMETERS:	    word (void *buffer, word length, int timeOut)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 6/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_READ_PTR
{
    HTSocket *sptr;
    word datasize;

EC( if (!(@self->HTSI_socket)) EC_WARNING(HTSOCKET_NOT_INITIALIZED);      )

    if (!@self->HTSI_socket) return 0;

    /* Don't read unless we are connected */
    if (@call oself::MSG_HT_SOCKET_GET_STATE() != HT_OK)
	return 0;
 
    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    datasize =  HTSocketRecv(sptr, buffer, length, timeOut);

    MemUnlock(@self->HTSI_socket);

    return datasize;
}	/* End of MSG_HT_SOCKET_READ_PTR.	*/




/***********************************************************************
 *		MSG_HT_SOCKET_WRITE_PTR for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Write data to socket.
 * PARAMETERS:	    int (void *data, word length)
 *                  - return HT_OK if written
 *                  - return HT_SOCKET_ERROR otherwise. You may want to check
 *                    the socket state using MSG_HT_SOCKET_GET_STATE.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_WRITE_PTR
{
    HTSocket *sptr;
    int ret;

    if ((data == NULL) || (length == 0)) return HT_OK;

EC( if (!(@self->HTSI_socket)) EC_WARNING(HTSOCKET_NOT_INITIALIZED);     )

    if (!@self->HTSI_socket) return HT_SOCKET_ERROR;

    /* Don't write unless we are connected */
    if (@call oself::MSG_HT_SOCKET_GET_STATE() != HT_OK)
	return HT_SOCKET_ERROR;
 
    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref (@self->HTSI_socket);

    ret = HTSocketSend(sptr, data, length);

    MemUnlock(@self->HTSI_socket);
    return ret;

}	/* End of MSG_HT_SOCKET_WRITE_PTR.	*/



/***********************************************************************
 *		MSG_HT_SOCKET_CLOSE for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Close a HTSocket. If you want to reuse this socket,
 *                  you must call MSG_HT_SOCKET_INITIALIZE again.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_CLOSE
{
    HTSocket *sptr;

    /* If there is a thread running, wait for it to stop */
    if (@self->HTSI_runningThread) {
	ThreadPSem(@self->HTSI_threadIsRunning);
	ThreadVSem(@self->HTSI_threadIsRunning);
	@self->HTSI_runningThread = NULL;
    }
    
EC( if (!(@self->HTSI_socket)) EC_WARNING(HTSOCKET_NOT_INITIALIZED);     )

    /* Free HTSocket structure */
    if (@self->HTSI_socket) {

	MemLock(@self->HTSI_socket);

	sptr = (HTSocket *) MemDeref(@self->HTSI_socket);
	if (sptr->HTS_sockfd)
	    SocketClose(sptr->HTS_sockfd);

	MemUnlock(@self->HTSI_socket);

	MemFree(@self->HTSI_socket);
	@self->HTSI_socket = NULL;
    }

    /* Free HTSocketInfo structure */
    if (@self->HTSI_htSockInfo) {
	MemFree(@self->HTSI_htSockInfo);
	@self->HTSI_htSockInfo = NULL;
    }

    /* Free the semaphore */
    if (@self->HTSI_threadIsRunning)  {
	ThreadFreeSem(@self->HTSI_threadIsRunning);
	@self->HTSI_threadIsRunning = NULL;
    }	
	
    /* These data instances are in HTStreamClass */
@ifdef __HT_STREAM_SOCKET__
    @self->HTSI_transparent = FALSE;
    @self->HTSI_target = NullOptr;
    @self->HTSI_request = NULL;
@endif
}	/* End of MSG_HT_SOCKET_CLOSE.	*/


/***********************************************************************
		Stream Socket Message Handlers
***********************************************************************/


@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Nothing to flsuh.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_STREAM_FLUSH
{
    return HT_OK;
}	/* End of MSG_HT_STREAM_FLUSH.	*/

@endif


@ifndef __TEST_HT_SOCKET__
@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    We do not abort a HTSocket since it might be
 *                  persistent. We must use HTSocket Manager's 
 *                  HTSocketDelete instead MSG_META_OBJ_FREE directly.
 *                  We also do not abort target as the protocol should
 *                  take care of that.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:       
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_STREAM_ABORT
{
    HTSocketDelete(oself, @self->HTSI_request);

    return HT_OK; 
}	/* End of MSG_HT_STREAM_ABORT.	*/

@endif
@endif


@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Put a block of data down HTSocket.
 * PARAMETERS:	    int (const byte *data, int len)
 *                  pass data = data to put.
 *                  pass len  = length of data in bytes.
 *                  - return HT_OK success.
 *                  - Otherwise return HT_SOCKET_ERROR.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Geos socket buffers data, so we need not buffer data.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_STREAM_PUT_BLOCK
{
    HTSocket *sptr;
    HTSocketInfo *siptr;
    int ret = HT_OK;

    if (len == 0) return HT_OK;

EC( if (!(@self->HTSI_htSockInfo)) EC_WARNING(HTSOCKET_NOT_INITIALIZED); )

    if (!@self->HTSI_htSockInfo) return HT_SOCKET_ERROR;

    MemLockShared(@self->HTSI_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(@self->HTSI_htSockInfo);
    if (siptr->HTSI_state != HT_OK) ret = HT_OK;
    MemUnlockShared(@self->HTSI_htSockInfo);

    if (ret == HT_OK) {
	MemLock(@self->HTSI_socket);
	sptr = (HTSocket *) MemDeref (@self->HTSI_socket);
	ret = HTSocketSend(sptr, data, len);
	MemUnlock(@self->HTSI_socket);
    }

    return ret;

}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/

@endif


@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_SOCKET_PUSH_ASYNCH for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Anyshronous receive data from socket and push data 
 *                  to target.
 * PARAMETERS:	    HT_OK if asych is started, else HT_SOCKET_ERROR.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Spawn a thread for receiving data and push to 
 *                  target.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/14/96   	Initial Revision
 *
 ***********************************************************************/
static word (*const receiveFunc)(word) = &HTSocketReceiveThread;

@method HTSocketClass, MSG_HT_SOCKET_PUSH_ASYNCH
{
    HTSocket *sptr;
    HTSocketInfo *siptr;
    int ret = HT_OK;

EC( ECCheckMemHandle(@self->HTSI_socket);                              )

    /* Grab the thread running semaphore. */
    if (ThreadPTimedSem(@self->HTSI_threadIsRunning, 1) == SE_TIMEOUT) {
	/* 
	 * We already have a thread running. Come back later or 
	 * ignore? I take ignore. 
	 */
	return HT_SOCKET_ERROR;
    }

    if (!@self->HTSI_socket) {  /* HTSocket not initialized */
EC(	EC_WARNING(HTSOCKET_NOT_INITIALIZED);                          )
	ThreadVSem(@self->HTSI_threadIsRunning);
	return HT_ERROR;
    }

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

EC( if (!@self->HTSI_target) EC_ERROR(HTSOCKET_NO_TARGET_TO_PUSH_DATA);)

    sptr->HTS_target = @self->HTSI_target;
    sptr->HTS_receiveCbf = cbf;
    sptr->HTS_stop = stop;
    MemUnlock(@self->HTSI_socket);

    @self->HTSI_runningThread = ThreadCreate(PRIORITY_HIGH, 
			     @self->HTSI_socket,
			     receiveFunc,
			     SOCKET_THREAD_STACK_SIZE,
			     GeodeGetProcessHandle());

    if (@self->HTSI_runningThread == NullHandle) {
	/* Failed to create a thread for nonblocking receive */
	MemLockExcl(@self->HTSI_htSockInfo);
	siptr = (HTSocketInfo *) MemDeref(@self->HTSI_htSockInfo);
	siptr->HTSI_state = HT_SOCKET_ERROR;
	MemUnlockExcl(@self->HTSI_htSockInfo);

	ret = HT_SOCKET_ERROR;
	ThreadVSem(@self->HTSI_threadIsRunning);
    }
    /* 
     * Otherwise the runningThread will "V" the threadIsRunning 
     * semaphore.
     */
    return ret;

}	/* End of MSG_HT_SOCKET_PUSH_ASYNCH.	*/

@endif


@ifndef __TEST_HT_SOCKET__
@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_SOCKET_PUSH for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Synch receive a packet and push to target.
 * PARAMETERS:	    int (void)
 *                  HT_OK, HT_CONNECTION_CLOSED, HT_INTERRUPTED,
 *                  HT_SOCKET_ERROR, or code returned from pushing 
 *                  data to target (protocol such as HTTP).
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/15/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_PUSH
{
    HTSocket *sptr;
    Socket sockfd;
    byte *buffer;
    HTSocketInfo *siptr;
    int state;
    SocketError errorCode;
    word bytesRead;

EC( ECCheckMemHandle(@self->HTSI_socket);                               )

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);
    sockfd = sptr->HTS_sockfd;
    buffer = sptr->HTS_buffer;
    errorCode = SE_NORMAL;

    bytesRead =  SocketRecv(sockfd, 
			    buffer,
			    HTSOCKET_BUFFER_SIZE,
			    2, /* short time out */
			    0, 
			    (SocketAddress *)0);
    
    if (bytesRead > 0) {
	/* 
	 * Got data.
	 */
	state = PUTBLOCK(@self->HTSI_target, buffer, bytesRead);

    } else if ((errorCode=ThreadGetError()) == SE_CONNECTION_CLOSED) {
	state = HT_CONNECTION_CLOSED;
	
    } else if (errorCode == SE_INTERRUPT) {
	state = HT_INTERRUPTED;

    } else if (errorCode != SE_NORMAL && errorCode != SE_TIMED_OUT) {
	state = HT_SOCKET_ERROR;

    } else
	/* Fall through to errorCode == SE_NORMAL */
	state = HT_OK;

    /* Update execution state */
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = state;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    MemUnlock(@self->HTSI_socket);

    return state;
}	/* End of MSG_HT_SOCKET_PUSH.	*/

@endif
@endif



/***********************************************************************
		Test routines that do not require connection.
***********************************************************************/

@ifdef __TEST_HT_SOCKET__



/***********************************************************************
 *		HTSocketResolve
 ***********************************************************************
 * SYNOPSIS:	Return HT_OK to indicate we resolved.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/10/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTSocketResolve (HTSocket *sptr)
{
    HTSocketInfo *siptr;
    
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = HT_OK;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    return HT_OK;
}	/* End of HTSocketResolve.	*/



/***********************************************************************
 *		HTSocketConnect
 ***********************************************************************
 * SYNOPSIS:	Return HT_OK to indicate we connected. We open a file.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/10/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTSocketConnect (HTSocket *sptr)
{
    HTSocketInfo *siptr;
    HTMemHandle htmh;
    HTRequest *rptr;
    char *cptr;
    
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = HT_OK;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    /* Open a file here */
    FilePushDir();
    FileSetStandardPath(SP_TOP);

    rptr = MemThreadGrab(sptr->HTS_request);
    MemLock(rptr->HTR_uriString);
    cptr = MemDeref(rptr->HTR_uriString);
    htmh = HTParseURI(cptr, NULL, HTURI_PARSE_HOST);
    cptr = (char *) HTMemLock(htmh);

    sptr->HTS_fileHandle = FileOpen(cptr,
				    FILE_DENY_W | FILE_ACCESS_R);

    FilePopDir();

    HTMemUnlockAndFree(htmh);
    MemUnlock(rptr->HTR_uriString);

    /* Fake the connection status, file open means connected,
       else not connected */
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);

    if (sptr->HTS_fileHandle)
	siptr->HTSI_state = HT_OK;
    else 
	siptr->HTSI_state = HT_CANNOT_CONNECT;

    MemUnlockExcl(sptr->HTS_htSockInfo);

    MemThreadRelease(sptr->HTS_request);
    return HT_OK;
}	/* End of HTSocketConnect.	*/



/***********************************************************************
 *		HTSocketRecv
 ***********************************************************************
 * SYNOPSIS:	Copy some data into buffer. Make the data we copy has
 *              the right syntax (unless of course if we want to 
 *              test how the library handles syntactically invalid 
 *              data objects.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Try using HT_CONNECTION_CLOSED and HT_OK.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/10/96   	Initial Revision
 *
 ***********************************************************************/
static word _pascal
HTSocketRecv (HTSocket *sptr, void *buffer, word length, int timeOut)
{
    word bytesRead;

    if (sptr->HTS_fileHandle)
	bytesRead = FileRead(sptr->HTS_fileHandle, buffer, length, FALSE);

    else 
	bytesRead = 0;

    if (!bytesRead && sptr->HTS_fileHandle) {
	FileClose(sptr->HTS_fileHandle, FALSE);
	sptr->HTS_fileHandle = NULL;
    }

    return bytesRead;
}	/* End of HTSocketRecv.	*/



/***********************************************************************
 *		HTSocketSend
 ***********************************************************************
 * SYNOPSIS:    Return HT_OK to indicate we have sent data.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/10/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTSocketSend (HTSocket *sptr, void *data, word length)
{
    return HT_OK;
}	/* End of HTSocketSend.	*/



/***********************************************************************
 *		HTSocketReceiveThread
 ***********************************************************************
 *
 * SYNOPSIS:	Thread for receiving data. Possible socket states
 *              after thread exits: HT_OK, HT_CONNECTION_CLOSED,
 *              HT_INTERRUPTED, HT_SOCKET_ERROR.
 * CALLED BY:	Kernel
 * RETURN:	0, as required by kernel.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/14/96   	Initial Revision
 *
 ***********************************************************************/
word _pascal
HTSocketReceiveThread (HTSocketHandle socket)
{
    SemaphoreHandle isRunning;
    HTSocketCallback cbf;
    HTSocket *sptr;
    byte *buffer;
    HTStreamHandle target;
    HTSocketInfo *siptr;
    int state;
    word bytesRead;

EC( ECCheckMemHandle(socket);                                           )

    MemLock(socket);
    sptr = (HTSocket *) MemDeref(socket);
    target = sptr->HTS_target;
    buffer = sptr->HTS_buffer;
    cbf = sptr->HTS_receiveCbf;
    state = HT_OK;

    do {
	bytesRead =  HTSocketRecv(sptr, buffer, HTSOCKET_BUFFER_SIZE, 1);
    
	if (bytesRead > 0) {
	    /* Got data */
	    state = PUTBLOCK(target, buffer, bytesRead);
	    if (state != HT_OK)	break;  /* done! */

	} else
	    state =  HT_CONNECTION_CLOSED;

    } while (state == HT_OK);

    /* Update execution state */
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = state;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    isRunning = sptr->HTS_threadIsRunning;
    MemUnlock(socket);

    if (cbf)
	ProcCallFixedOrMovable_pascal(target, state, cbf);

    ThreadVSem(isRunning);
    return 0;  /* Required by kernel */
}	/* End of HTSocketReceiveThread.	*/



@endif


/***********************************************************************
		Test method handlers
***********************************************************************/

@ifdef __TEST_HT_SOCKET__


/***********************************************************************
 *		MSG_HT_SOCKET_STOP for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Close file if still open.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/ 4/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_STOP
{
    HTSocket *sptr;

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    /* Close file here */
    if (sptr->HTS_fileHandle) {
	FileClose(sptr->HTS_fileHandle, FALSE);
	sptr->HTS_fileHandle = NULL;
    }

    MemUnlock(@self->HTSI_socket);

    /* If there is a thread running, wait for it to stop */
    if (@self->HTSI_runningThread) {
	ThreadPSem(@self->HTSI_threadIsRunning);
	ThreadVSem(@self->HTSI_threadIsRunning);
	@self->HTSI_runningThread = NULL;
    }
}	/* End of MSG_HT_SOCKET_STOP.	*/

@endif


@ifdef __TEST_HT_SOCKET__
@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTSocketClass
 ***********************************************************************
 * SYNOPSIS:	    Close file here.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_STREAM_ABORT
{
    HTSocket *sptr;

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    /* Close file here */
    if (sptr->HTS_fileHandle) {
	FileClose(sptr->HTS_fileHandle, FALSE);
	sptr->HTS_fileHandle = NULL;
    }

    MemUnlock(@self->HTSI_socket);
    
    HTSocketDelete(oself, @self->HTSI_request);

    return HT_OK;
}	/* End of MSG_HT_STREAM_ABORT.	*/

@endif
@endif


@ifdef __TEST_HT_SOCKET__
@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_SOCKET_PUSH for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Synch receive a packet and push to target.
 * PARAMETERS:	    int (void)
 *                  HT_OK, HT_CONNECTION_CLOSED, HT_INTERRUPTED,
 *                  HT_SOCKET_ERROR.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/15/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_SOCKET_PUSH
{
    HTSocket *sptr;
    HTSocketInfo *siptr;
    int state;
    word bytesRead;

EC( ECCheckMemHandle(@self->HTSI_socket);                               )

    MemLock(@self->HTSI_socket);
    sptr = (HTSocket *) MemDeref(@self->HTSI_socket);

    bytesRead =  HTSocketRecv(sptr, sptr->HTS_buffer, 
			      HTSOCKET_BUFFER_SIZE, 1);

    if (bytesRead > 0) {
	/* 
	 * Got data.
	 */
	state = PUTBLOCK(@self->HTSI_target, 
			 sptr->HTS_buffer, bytesRead);

    } else {
	/* Fall through to errorCode == SE_NORMAL */
	state = HT_CONNECTION_CLOSED;
    }

    /* Update execution state */
    MemLockExcl(sptr->HTS_htSockInfo);
    siptr = (HTSocketInfo *) MemDeref(sptr->HTS_htSockInfo);
    siptr->HTSI_state = state;
    MemUnlockExcl(sptr->HTS_htSockInfo);

    MemUnlock(@self->HTSI_socket);

    return state;
}	/* End of MSG_HT_SOCKET_PUSH.	*/

@endif
@endif


@ifdef __TEST_HT_SOCKET__
@ifdef __HT_STREAM_SOCKET__


/***********************************************************************
 *		MSG_HT_STREAM_SET_REQUEST for HTSocketClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set the request in HTSocket as well.
 * PARAMETERS:	    void (HTRequestHandle request)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/30/96   	Initial Revision
 *
 ***********************************************************************/
@method HTSocketClass, MSG_HT_STREAM_SET_REQUEST
{
    HTSocket *sptr;

    @callsuper();

    if (@self->HTSI_socket) {
	MemLock(@self->HTSI_socket);
	sptr = (HTSocket *) MemDeref(@self->HTSI_socket);
	sptr->HTS_request = request;
	MemUnlock(@self->HTSI_socket);
    }

}	/* End of MSG_HT_STREAM_SET_REQUEST.	*/

@endif
@endif







