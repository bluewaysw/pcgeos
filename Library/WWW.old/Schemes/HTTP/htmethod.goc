@include <WWW/HTCore/htreq.goh>         /* HTMethod */

/*
 * This table MUST match HTMethod enumeration table in 
 * WWW/HTCore/htreq.goh.
 */
static char *method_names[] = {
    "INVALID_METHOD",
    "OPTIONS",
    "GET",
    "HEAD",
    "POST",
    "PUT",
    "PATCH",
    "COPY",
    "MOVE",
    "DELETE",
    "LINK",
    "UNLINK",
    "TRACE",
    "WRAPPED",
    NULL
};



/***********************************************************************
 *		HTMethodName
 ***********************************************************************
 *
 * SYNOPSIS:	Get a HTTP method string givens it symbol. Assumes DS is
 *              pointing to library dgroup.
 * CALLED BY:	Client.
 * RETURN:	Pointer to string.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	2/10/97   	Initial Revision
 *	
 ***********************************************************************/
const char * _far _pascal
HTMethodName (HTMethod method)
{
    if (method & HTM_OPTIONS)
	return *(method_names+1);
    else if (method & HTM_GET)
	return *(method_names+2);
    else if (method & HTM_HEAD)
	return *(method_names+3);
    else if (method & HTM_POST)
	return *(method_names+4);
    else if (method & HTM_PUT)
	return *(method_names+5);
    else if (method & HTM_PATCH)
	return *(method_names+6);
    else if (method & HTM_COPY)
	return *(method_names+7);
    else if (method & HTM_MOVE)
	return *(method_names+8);
    else if (method & HTM_DELETE)
	return *(method_names+9);
    else if (method & HTM_LINK)
	return *(method_names+10);
    else if (method & HTM_UNLINK)
	return *(method_names+11);
    else if (method & HTM_TRACE)
	return *(method_names+12);
    else if (method & HTM_WRAPPED)
	return *(method_names+13);
    else 
	return *method_names;    /* INVALID_METHOD */

}	/* End of HTMethodName.	*/
