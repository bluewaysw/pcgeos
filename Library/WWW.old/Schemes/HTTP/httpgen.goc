@include <stdapp.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htreqMan.goh>
@include "httpgen.goh"

#include <Ansi/stdio.h>
#include <Ansi/string.h>

#define PUTBLOCK(target, data)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, strlen((char *)data))

/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTTPGenClass;


/***********************************************************************
		Private Routine
***********************************************************************/



/***********************************************************************
 *		HTTPMakeGeneralHeaders
 ***********************************************************************
 *
 * SYNOPSIS:	Create general headers for the HTTP request.
 * CALLED BY:	MSG_HT_STREAM_PUT_BLOCK
 * RETURN:	HT_OK or HT_ERROR
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTTPMakeGeneralHeaders (HTRequestHandle request, HTStreamHandle target,
			Boolean endHeader)
{
    return HT_OK;
}	/* End of HTTPMakeGeneralHeaders.	*/



/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_HTTP_GEN_END_HEADER for HTTPGenClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Indicates whether to end header by putting an empty
 *                  line consisting only of CRLF.
 * PARAMETERS:	    void (Boolean endHeader);
 * SIDE EFFECTS:    Nothing
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/23/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTTPGenClass, MSG_HTTP_GEN_END_HEADER
{
    @self->HTGI_endHeader = endHeader;
}	/* End of MSG_HTTP_GEN_END_HEADER.	*/




/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTTPGenClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Flush all buffered data down the input stream pipe.
 * PARAMETERS:	    int (void)
 *                  return HT_OK if sucessful, else HT_NO.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPGenClass, MSG_HT_STREAM_FLUSH
{
    int status = @call oself::MSG_HT_STREAM_PUT_BLOCK(NULL, 0);

EC( ECCheckStream(@self->HTSI_target);                                  )

    if (status == HT_OK)
	return @call @self->HTSI_target::MSG_HT_STREAM_FLUSH();
    return status;
}	/* End of MSG_HT_STREAM_FLUSH.	*/




/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTTPGenClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Put HTTP General headers down the stream pipe.
 * PARAMETERS:	    int (const byte data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        The HTTP General headers are set using HTRequestSet
 *                  APIs in <WWW/HTCore/htreq.goh>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPGenClass, MSG_HT_STREAM_PUT_BLOCK
{
    int status = HT_OK;

    if (@self->HTSI_transparent == TRUE)
	return @call @self->HTSI_target::MSG_HT_STREAM_PUT_BLOCK(
					data, len);
    else {
	status = HTTPMakeGeneralHeaders(@self->HTSI_request, 
					@self->HTSI_target,
					@self->HTGI_endHeader);
	if (status == HT_OK) 
	    status = @call @self->HTSI_target::MSG_HT_STREAM_PUT_BLOCK(
                                        data, len);
	@self->HTSI_transparent = TRUE;
    }
    return status;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/



/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTTPGenClass
 ***********************************************************************
 * SYNOPSIS:	    Abort the current stream and the target stream 
 * 		    object.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    Nothing.
 *
 * STRATEGY:	    Flush all input to target, abort the target, and
 *                  then free oself. For this to work, a stream object
 *                  must not be the target of multiple stream objects.
 *                  If it is, it must be able to handle multiple abort
 *                  messages. Must use @call as we must abort the 
 *                  stream pipes before returning. The client depends
 *                  on it as the request may be changed/deleted.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPGenClass, MSG_HT_STREAM_ABORT
{
    @call oself::MSG_HT_STREAM_FLUSH();

    if (@self->HTSI_target != NullOptr) {
	@call @self->HTSI_target::MSG_HT_STREAM_ABORT();
	@self->HTSI_target = NullOptr;
    }

    /*
     * Since the object class may go away before we get a chance
     * to execute the following forcequeued message, we need to 
     * change it's class pointer to its base class.
     */
    HTUtilChangeClassToHTStreamClass(oself);
    @send,forceQueue oself::MSG_META_OBJ_FREE();

    return HT_OK;
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
		Public Functions
***********************************************************************/


/***********************************************************************
 *		HTTPGenNew
 ***********************************************************************
 *
 * SYNOPSIS:	Create a HTTP General header generator. endHeader 
 *              indicates whether HTTPGen stream is going to terminate
 *              the headers by putting an empty line consisting of CRLF.
 * CALLED BY:	Library
 * RETURN:	HTStreamHandle, NullOptr if not created.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/23/97   	Initial Revision
 *	
 ***********************************************************************/
HTStreamHandle _far _pascal
HTTPGenNew (HTRequestHandle request, Boolean endHeader)
{
    HTStreamHandle stream;

EC( ECCheckRequest(request);                                            )

    PUSHDS;
    SET_DS_LIB_DGROUP;
    stream = ObjInstantiateForThread(0, &HTTPGenClass);
    POPDS;

    if (!stream) {
	/* Log error */
    } else {
	/* Initialize the stream instance data */
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);
	@call stream::MSG_HTTP_GEN_END_HEADER(endHeader);
    }
    return stream;
}	/* End of HTTPGenNew.	*/






