/***********************************************************************
 *		MSG_PM_ENTER_CAPTION_MODE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Switch the PManager's receiving object.  Let 
 *                  caption be the receiving object temporarily.
 * PARAMETERS:	    (ClassStruct *table, char align, optr caption)
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_ENTER_CAPTION_MODE
{
  int count;
  /*
   *  Back up the current receiving object.  Later on we'll switch it back.
   */
  pself->PM_recvObjBackup = pself->PM_recvObj;
  /*
   *  Traverse up the ui tree and find the table object which the 
   *  caption should belong to.
   */
  while(1) {
    if (@call pself->PM_recvObj::MSG_META_IS_OBJECT_IN_CLASS(table)) {
      /*
       *  Add the caption object before or after the table object, 
       *  depending on the align attribute.
       */
      pself->PM_recvObj = @call pself->PM_recvObj::MSG_GEN_FIND_PARENT();
      count = @call pself->PM_recvObj::MSG_GEN_COUNT_CHILDREN();
      if (align == 0)
	@call pself->PM_recvObj::MSG_GEN_ADD_CHILD(caption, count-1);
      else
	@call pself->PM_recvObj::MSG_GEN_ADD_CHILD(caption, CCO_LAST);

      break;
    }
    else
      pself->PM_recvObj = @call pself->PM_recvObj::MSG_GEN_FIND_PARENT();

    EC_ERROR_IF(pself->PM_recvObj == NULL, PM_ASSUMPTION_FAILS);
  }

  /*
   *  Now make the caption object be the receiving object.
   */
  pself->PM_recvObj = caption;
  return;
}	/* End of MSG_PM_ENTER_CAPTION_MODE.	*/


/***********************************************************************
 *		MSG_PM_EXIT_CAPTION_MODE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Switch back to whatever the receiving object was
 *                  before entering the caption mode.
 * PARAMETERS:	    void.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_EXIT_CAPTION_MODE
{
  pself->PM_recvObj = pself->PM_recvObjBackup;
  pself->PM_recvObjBackup = NULL;

  return;
}	/* End of MSG_PM_EXIT_CAPTION_MODE.	*/


/***********************************************************************
 *		DoesItHaveLinkInVisibleRegion
 ***********************************************************************
 *
 * SYNOPSIS:	Check to see if the object has a hyperlink in the given
 *              region or not.
 * CALLED BY:	
 * RETURN:	Boolean, TRUE or FALSE.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean
DoesItHaveLinkInVisibleRegion 
(optr object, RectDWord rect, int direction, ClassStruct *imageClass)
{
  if (@call object::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass))
      return @call object::MSG_GEN_TEXT_FIND_LINK_IN_RECT(rect, direction);
  else if (@call object::MSG_META_IS_OBJECT_IN_CLASS(imageClass))
      return @call object::MSG_GEN_IMAGE_FIND_LINK_IN_RECT(rect);
}	/* End of DoesItHaveLinkInVisibleRegion.	*/


/***********************************************************************
 *		IsThereLinkInOtherHorizColumn
 ***********************************************************************
 *
 * SYNOPSIS:	Given a visible rect region and search direction, find
 *              if there is any further object that is in the visible
 *              region as well.  Search starts from the given object.
 * CALLED BY:	
 * RETURN:	The returned boolean tells the caller that it returns
 *              an object in *parent that in the visible region.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/23/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean
IsThereLinkInOtherHorizColumn
(optr *parent, optr pmanager, int direction, RectDWord rect, ClassStruct *imageClass)
{
  int cnt, limit, cont = TRUE;
  optr grandMa, tmp = *parent;
  Rectangle retval;

  while(1) {
    if (tmp == pmanager) {
	*parent = NULL;
	break;
    }
    grandMa = @call tmp::MSG_GEN_FIND_PARENT();
    limit = @call grandMa::MSG_GEN_COUNT_CHILDREN();
    cnt = @call grandMa::MSG_GEN_FIND_CHILD(tmp);
    /*
     *  This inner loop checks the children in the grandma
     */
    while(1) {
	if (direction == SEARCH_FORWARD) {
	    if (cnt+1 == limit)
		break;  /* no more siblings in this level, break */
	    tmp = @call grandMa::MSG_GEN_FIND_CHILD_AT_POSITION(++cnt);
	    @call tmp::MSG_VIS_GET_BOUNDS(&retval);
	    if (retval.R_bottom > rect.RD_top &&
		retval.R_top < rect.RD_bottom) {
		/*
		 *  It has a portion within the visible region.
		 */
		tmp = GetLeftMostLeaf(tmp);
		if (DoesItHaveLinkInVisibleRegion(tmp, rect, 
						  direction, imageClass) 
		    == TRUE) {
		    *parent = tmp;  /* found */
		    cont = FALSE;
		    break;
		}
		else {
		    grandMa = @call tmp::MSG_GEN_FIND_PARENT();
		    limit = @call grandMa::MSG_GEN_COUNT_CHILDREN();
		    cnt = @call grandMa::MSG_GEN_FIND_CHILD(tmp);
		}
	    }
	}
	else {
	    if (cnt-1 < 0)
		break;  /* no more siblings in this level, break */
	    tmp = @call grandMa::MSG_GEN_FIND_CHILD_AT_POSITION(--cnt);
	    @call tmp::MSG_VIS_GET_BOUNDS(&retval);
	    if (retval.R_top < rect.RD_bottom &&
		retval.R_bottom > rect.RD_top) {
		/*
		 *  It has a portion within the visible region.
		 */
		tmp = GetRightMostLeaf(tmp);
		if (DoesItHaveLinkInVisibleRegion(tmp, rect, 
						  direction, imageClass) 
		    == TRUE) {
		    *parent = tmp;  /* found */
		    cont = FALSE;
		    break;
		}
		else {
		    grandMa = @call tmp::MSG_GEN_FIND_PARENT();
		    limit = @call grandMa::MSG_GEN_COUNT_CHILDREN();
		    cnt = @call grandMa::MSG_GEN_FIND_CHILD(tmp);
		}
	    }
	}
    }
    if (cont == FALSE)
	break;
    tmp = grandMa;  /* go up one level */
  }

  return cont;
}	/* End of IsThereLinkInOtherHorizColumn.	*/


/***********************************************************************
 *	MSG_PM_SHOW_FOCUS_IN_VISIBLE_RECT for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	Show the next focus object in the visible rectangle region
 * PARAMETERS:  (RectDWord rect, int direction, ClassStruct *imageClass)
 *              direction = 1 if view is scrolling downward.
 *                        = 0 if view is scrolling upward.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    The reason I pass image class because PManager
 *                  can't include uigenera library for the image class.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SHOW_FOCUS_IN_VISIBLE_RECT
{
  Rectangle objRect, box;
  optr parent = NULL;
  WindowHandle win;
  GStateHandle gstate;
  RectDWord drawBound;
  Boolean cont = TRUE;

  if (pself->PM_focalObj) {
    /*
     *  There was an object containining hyperlink in the visible 
     *  screen area.  If it is still in the current visible area, 
     *  keep it in focus.  Do nothing and return.
     */
    if (pself->PM_drawBound.RD_top > rect.RD_top && 
	pself->PM_drawBound.RD_left >rect.RD_left &&
	pself->PM_drawBound.RD_right < rect.RD_right &&
	pself->PM_drawBound.RD_bottom < rect.RD_bottom)
      return;
    parent = pself->PM_focalObj;
  }
  else if (direction == SEARCH_FORWARD) {
    if (pself->PM_referenceObj)
	parent = pself->PM_referenceObj;
    else
	parent = GetLeftMostLeaf(oself);
  }
  else { /* direction == SEARCH_BACKWARD */
    if (pself->PM_referenceObj)
	parent = pself->PM_referenceObj;
    else
	parent = GetRightMostLeaf(oself);
  }

  if (!parent || parent == oself)
      return;
  /*
   *  Create a gstring to draw the focal outline around the hyperlink.
   */
  win = @call parent::MSG_VIS_QUERY_WINDOW();
  gstate = GrCreateState(win);
  GrSetLineMaskSys( gstate, SDM_50 );
  GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
  GrSetMixMode(gstate, MM_XOR);

  while(parent) {
    @call parent::MSG_VIS_GET_BOUNDS(&objRect);
    if (direction == SEARCH_FORWARD) {
      if (objRect.R_top >= rect.RD_bottom) {
	/* 
	 *  Though the object is below the visible region already, 
	 *  there might be some object in the next column if the next
	 *  column exits.  Thus, we need to check further in the ui tree
	 *  to see if there is such column.  If so, search that column.
	 */
	cont = IsThereLinkInOtherHorizColumn
	    (&parent, oself, direction, rect, imageClass);

	if (parent == NULL)
	    break;  /* no more on the visible region. */
      }
      else if (objRect.R_bottom > rect.RD_top) {
	/*
	 *  A portion of the object's bound is in the visible area.
	 *  Now we check if there is a hyperlink in that visible portion.
	 */
	drawBound = FindAndDrawFocalBound(direction, parent, &objRect, 
					  &rect, &box, gstate, imageClass);
	if (drawBound.RD_right && drawBound.RD_right != drawBound.RD_left) {
	    break;  /* break if it has hyperlink in the visible portion */
	}
      }
    }
    else {
      if (objRect.R_bottom <= rect.RD_top) {
	cont = IsThereLinkInOtherHorizColumn
	    (&parent, oself, direction, rect, imageClass);
	if (parent == NULL)
	    break;  /* no more on the visible region. */
      }
      else if (objRect.R_top < rect.RD_bottom) {
	/*
	 *  A portion of the object's bound is in the visible area.
	 *  Now we check if there is a hyperlink in that visible portion.
	 */
	drawBound = FindAndDrawFocalBound(direction, parent, &objRect, 
					  &rect, &box, gstate, imageClass);
	if (drawBound.RD_right && drawBound.RD_right != drawBound.RD_left) {
	    break;  /* break if it has hyperlink in the visible portion */
	}
      }
    }
    if (cont == FALSE) {
	cont = TRUE;
	continue;
    }
    parent = GetNextSiblingOrParentsSibling
	(parent, direction, TEXT_AND_IMAGE, imageClass);
  }
  /*
   *  Erase the previous focus drawing.
   */
  if (pself->PM_focalObj && 
      (pself->PM_drawBound.RD_left != drawBound.RD_left ||
       pself->PM_drawBound.RD_top  != drawBound.RD_top  ||
       pself->PM_drawBound.RD_right != drawBound.RD_right ||
       pself->PM_drawBound.RD_bottom != drawBound.RD_bottom))
      UndrawFocalBound(pself->PM_focalObj, &(pself->PM_drawBound), 
		       &pself->PM_drawbox,
		       gstate, parent);
  /*
   *  Update the new object(can be NULL) that has hyperlink in visible
   *  region.
   */
  if (pself->PM_focalObj)
      pself->PM_referenceObj = pself->PM_focalObj;
  pself->PM_focalObj = parent;
  pself->PM_drawBound = drawBound;
  pself->PM_drawbox = box;
  
  GrDestroyState(gstate);

  return;
}	/* End of MSG_PM_SHOW_FOCUS_IN_VISIBLE_RECT.	*/

/***********************************************************************
 *		FindAndDrawFocalBound
 ***********************************************************************
 *
 * SYNOPSIS:	Given an object, find its hyperlink in the given rect
 *              region.  Return the drawing rectangle(A,B,C,D) of the 
 *              hyperlink.  It it's a text object that has link crossing
 *              mulitple lines, the *box contains the rectangle (a,b,c,d)
 *              of the inner box:
 *                                      (A,B)
 *                                        +---------+
 *                          (a,b)         |         |
 *                            +-----------+         |
 *                            |                     |
 *                            |                     |
 *                            |        +------------+ (c, d)
 *                            |        |         
 *                            +--------+
 *                                   (C, D)
 * 
 * CALLED BY:	(optr object, Rectangle *objRect, RectDWord *rect,
 *               GStateHandle gstate, ClassStruct *imageClass)
 * RETURN:	Return the actual drawing region around the link.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/18/97   	Initial Revision
 *	
 ***********************************************************************/
RectDWord
FindAndDrawFocalBound (int direction, optr object, Rectangle *objRect, 
		       RectDWord *rect, Rectangle *box, GStateHandle gstate, 
		       ClassStruct *imageClass)
{
  RectDWord ret;

  if (@call object::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass))
      @call object::MSG_GEN_TEXT_DRAW_FOCUS(direction, gstate, objRect, 
					    rect, &ret, box);
  else if (@call object::MSG_META_IS_OBJECT_IN_CLASS(imageClass)) {
      if (objRect->R_top >= rect->RD_top && objRect->R_left >= rect->RD_left 
	  && objRect->R_right <= rect->RD_right
	  && objRect->R_bottom <= rect->RD_bottom)
	  @call object::MSG_GEN_IMAGE_DRAW_FOCUS(gstate, objRect, &ret);
      else 
	  ret.RD_right = ret.RD_left = 0;

      box->R_right = box->R_left = box->R_top = box->R_bottom = 0;
  }
  else {
      ret.RD_right = ret.RD_left = 0;
      box->R_right = box->R_left = box->R_top = box->R_bottom = 0;
  }

  return ret;
}	/* End of FindAndDrawFocalBound.	*/

/***********************************************************************
 *		UndrawFocalBound
 ***********************************************************************
 *
 * SYNOPSIS:	Erase the outline drawing of the current hyperlink of 
 *              the given object.
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/19/97   	Initial Revision
 *	
 ***********************************************************************/
void
UndrawFocalBound 
(optr object, RectDWord *drawBound, Rectangle *box, 
GStateHandle gstate, optr newLink)
{
  if (@call object::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass))
      @call object::MSG_GEN_TEXT_UNDRAW_FOCUS(gstate, drawBound, box, newLink);
  else
      @call object::MSG_GEN_IMAGE_UNDRAW_FOCUS(gstate);

  return;
}	/* End of UndrawFocalBound.	*/


/***********************************************************************
 *		MSG_PM_SHOW_FOCUS for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find the next/previous focusable hyperlink.
 * PARAMETERS:	    (int direction, ClassStruct *imageClass);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/25/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SHOW_FOCUS
{
  optr currentObj;
  Rectangle objRect, box;
  RectDWord rect;
  RectDWord drawBound;
  WindowHandle win;
  GStateHandle gstate;
  EventHandle msg;

  if (pself->PM_focalObj) {
      currentObj = pself->PM_focalObj;
      if (@call currentObj::MSG_META_IS_OBJECT_IN_CLASS(imageClass))
	  currentObj = GetNextSiblingOrParentsSibling
	      (currentObj, direction, TEXT_AND_IMAGE, imageClass);
  }
  else if (direction == SEARCH_FORWARD)
      currentObj = GetLeftMostLeaf(oself);
  else  /* direction == SEARCH_BACKWARD */
      currentObj = GetRightMostLeaf(oself);

  if (currentObj == oself)
      return;
  /*
   *  Create a gstring to draw the focal outline around the hyperlink.
   */
  win = @call currentObj::MSG_VIS_QUERY_WINDOW();
  gstate = GrCreateState(win);
  GrSetLineMaskSys( gstate, SDM_50 );
  GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
  GrSetMixMode(gstate, MM_XOR);

  while(currentObj) {
    @call currentObj::MSG_VIS_GET_BOUNDS(&objRect);
    rect.RD_left = objRect.R_left;
    rect.RD_top  = objRect.R_top;
    rect.RD_right= objRect.R_right;
    rect.RD_bottom = objRect.R_bottom;

    drawBound = FindAndDrawFocalBound(direction, currentObj, &objRect, 
				      &rect, &box, gstate, imageClass);
    if (drawBound.RD_right && drawBound.RD_right != drawBound.RD_left) {
	if (drawBound.RD_right > drawBound.RD_left)
	  msg = @record GenViewClass::MSG_GEN_VIEW_MAKE_RECT_VISIBLE
		    (MRVF_USE_MARGIN_FROM_TOP_LEFT, MRVM_0_PERCENT, 
		     MRVF_USE_MARGIN_FROM_TOP_LEFT, MRVM_0_PERCENT, 
		     drawBound.RD_bottom, drawBound.RD_right, 
		     drawBound.RD_top, drawBound.RD_left);
	else
	  msg = @record GenViewClass::MSG_GEN_VIEW_MAKE_RECT_VISIBLE
		    (MRVF_USE_MARGIN_FROM_TOP_LEFT, MRVM_0_PERCENT, 
		     MRVF_USE_MARGIN_FROM_TOP_LEFT, MRVM_0_PERCENT, 
		     drawBound.RD_bottom, drawBound.RD_left, 
		     drawBound.RD_top, drawBound.RD_right);
	@send currentObj::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
	break;  /* break if it has hyperlink in the visible portion */
    }
    currentObj = GetNextSiblingOrParentsSibling
	(currentObj, direction, TEXT_AND_IMAGE, imageClass);
  }
  if (!currentObj) {
      GrDestroyState(gstate);
      return;
  }
  /*
   *  Update the new object(can be NULL) that has hyperlink in visible
   *  region.
   */
  if (pself->PM_focalObj && 
      (pself->PM_drawBound.RD_left != drawBound.RD_left ||
       pself->PM_drawBound.RD_top  != drawBound.RD_top  ||
       pself->PM_drawBound.RD_right != drawBound.RD_right ||
       pself->PM_drawBound.RD_bottom != drawBound.RD_bottom))
      UndrawFocalBound(pself->PM_focalObj, &(pself->PM_drawBound), 
		       &pself->PM_drawbox,
		       gstate, currentObj);

  if (pself->PM_focalObj)
      pself->PM_referenceObj = pself->PM_focalObj;
  pself->PM_focalObj = currentObj;
  pself->PM_drawBound = drawBound;
  pself->PM_drawbox = box;
  
  GrDestroyState(gstate);

  return;
}	/* End of MSG_PM_SHOW_FOCUS.	*/



/***********************************************************************
 *		SearchInText
 ***********************************************************************
 *
 * SYNOPSIS:	Search the key word in the passed text object.
 * CALLED BY:	(optr text, optr pmanager, MemHandle searchInfo)
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/16/96   	Initial Revision
 *
 ***********************************************************************/
optr
SearchInText (optr text, optr genContent, MemHandle searchInfo)
{
  VisTextRange range;
  VisTextConvertOffsetParams params;
  static optr previousObj;
  int direction;
  SearchReplaceStruct *srs;

  /*
   *  Find the current search direction.
   */
  srs = (SearchReplaceStruct *)MemLock(searchInfo);
  if (srs->params & SO_BACKWARD_SEARCH)
    direction = SEARCH_BACKWARD;
  else
    direction = SEARCH_FORWARD;
  MemUnlock(searchInfo);
  /*
   *  Search the word in the cuurent text object.
   */
  searchFound = TRUE;
  @call text::MSG_SEARCH(searchInfo);
  @call text::MSG_VIS_TEXT_GET_SELECTION_RANGE(&range);
  /*
   *  If not found, tell the caller to continue the search for the 
   *  next text object.  If found, scroll the view to see the word.
   */
  if (text == previousObj && direction == SEARCH_FORWARD 
      && searchRange.VTR_start >= range.VTR_start
      && searchRange.VTR_end >= range.VTR_end)
    return CONTINUE;
  else if (text == previousObj && direction == SEARCH_BACKWARD 
      && searchRange.VTR_start <= range.VTR_start
      && searchRange.VTR_end <= range.VTR_end)
    return CONTINUE;
  if (searchFound == TRUE && range.VTR_start != range.VTR_end) {
    params.VTCOP_offset = range.VTR_start;
    @call text::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE(&params);
    @call genContent::MSG_HTML_CONTENT_VIEW_OBJECT
       (params.VTCOP_xPos, params.VTCOP_yPos);
    searchRange.VTR_start = range.VTR_start;
    searchRange.VTR_end   = range.VTR_end;
    previousObj = text;
    return STOP;
  }
  return CONTINUE;
}	/* End of SearchInText.	*/


/***********************************************************************
 *		GetNextSiblingOrParentsSibling
 ***********************************************************************
 *
 * SYNOPSIS:	Given the current object, find the next sibling object
 *              in the ui tree.
 * CALLED BY:	
 * RETURN:	optr - next sibling text object.  NULL if no more.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *              At any time, searchObj must be a leaf.  It can not be 
 *              a node in the middle of tree!
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/16/96   	Initial Revision
 *
 ***********************************************************************/
optr
GetNextSiblingOrParentsSibling 
    (optr currentObj, int direction, int how, ClassStruct *imageClass)
{
  optr parent;
  int index;
  /*
   *  Get the child index of the current searchObj.
   */
  parent = @call currentObj::MSG_GEN_FIND_PARENT();
  index  = @call parent::MSG_GEN_FIND_CHILD(currentObj);
  /*
   *  Find the leaf of the next subtree.
   */
  while (1) {
    if (direction == SEARCH_FORWARD)
      currentObj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(++index);
    else
      currentObj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(--index);

    if (!currentObj) {
      /*
       *  No more siblings.  Thus go one level up the tree.
       */
      currentObj = parent;
      if (@call currentObj::MSG_META_IS_OBJECT_IN_CLASS
      (&PresentationManagerClass)) {
	return NULL;
      }
      parent = @call currentObj::MSG_GEN_FIND_PARENT();
      index  = @call parent::MSG_GEN_FIND_CHILD(currentObj);
    }
    else {
      /*
       *  Got the next subtree.
       */
      if (direction == SEARCH_FORWARD) {
	/*
	 *  Find the left-most leaf.
	 */
	currentObj = GetLeftMostLeaf(currentObj);
      }
      else {
	/*
	 *  Find the right-most leaf
	 */
	currentObj = GetRightMostLeaf(currentObj);
      }
      /*
       *  If searchObj is a text object.  Return it to caller.
       *  If searchObj is a graphic object and graphi is also what the
       *  caller is interested in, return to caller.
       */
      if (@call currentObj::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass)) {
	if (direction == SEARCH_FORWARD)
	  @call currentObj::MSG_VIS_TEXT_SELECT_START();
	else
	  @call currentObj::MSG_VIS_TEXT_SELECT_END();
	break;
      }
      else if (how == TEXT_AND_IMAGE &&
	       @call currentObj::MSG_META_IS_OBJECT_IN_CLASS(imageClass))
	break;
      else {
	/*
	 *  Loop to find the next sibling of currentObj.
	 */
	parent = @call currentObj::MSG_GEN_FIND_PARENT();
	index  = @call parent::MSG_GEN_FIND_CHILD(currentObj);
      }
    }
  }
  searchRange.VTR_start = searchRange.VTR_end = 0;
  return currentObj;
}	/* End of GetNextSiblingOrParentsSibling.	*/



/***********************************************************************
 *		DepthFirstSearch
 ***********************************************************************
 *
 * SYNOPSIS:    Do a depth first search.
 * CALLED BY:	
 * RETURN:	optr - the optr of the leaf chlid, NULL if no more.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/16/96   	Initial Revision
 *
 ***********************************************************************/
optr
DepthFirstSearch (optr leaf, optr genContent, MemHandle searchInfo)
{
  MemHandle dup;
  optr temp;
  SearchReplaceStruct *src;
  int direction;

  src = (SearchReplaceStruct *)MemLock(searchInfo);
  if (src->params & SO_BACKWARD_SEARCH)
    direction = SEARCH_BACKWARD;
  else
    direction = SEARCH_FORWARD;
  MemUnlock(searchInfo);

  while (1) {  /* loops as long as there is an object for searching */
    if (@call leaf::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass)) {
      dup = DuplicateSearchInfo(searchInfo);
      if (SearchInText(leaf, genContent, searchInfo) == STOP) {
	MemFree(dup);
	return leaf;  /* found it, return the object */
      }
      searchInfo = dup;
    }
    temp = GetNextSiblingOrParentsSibling(leaf, direction, TEXT_ONLY, 0);
    if (!temp)
      break;  /* no more text object for searching. */
    leaf = temp;
  }
  MemFree(searchInfo);
  return NULL;
}	/* End of DepthFirstSearch.	*/


/***********************************************************************
 *		DuplicateSearchInfo
 ***********************************************************************
 *
 * SYNOPSIS:	Duplicate the searchInfo.
 * CALLED BY:	
 * RETURN:	MemHandle of the duplicate.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/17/96   	Initial Revision
 *
 ***********************************************************************/
MemHandle 
DuplicateSearchInfo (MemHandle searchInfo)
{
  SearchReplaceStruct *srs, *copy;
  MemHandle copyHan;

  srs = (SearchReplaceStruct *)MemLock(searchInfo);
  copyHan = MemAlloc(sizeof(SearchReplaceStruct) + srs->searchSize, 
		     HF_SHARABLE | HF_SWAPABLE,
		     HAF_NO_ERR);
  copy = (SearchReplaceStruct *)MemLock(copyHan);
  *copy = *srs;
  strcpy((char *)copy+sizeof(SearchReplaceStruct), 
	 (char *)srs+sizeof(SearchReplaceStruct));
  MemUnlock(copyHan);
  MemUnlock(searchInfo);

  return copyHan;
}	/* End of DuplicateSearchInfo.	*/


