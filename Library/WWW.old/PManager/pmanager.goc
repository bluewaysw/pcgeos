@classdecl PMSearchCtrClass;


@extern method HTMLContentClass, MSG_META_START_SELECT;
@extern method HTMLContentClass, MSG_META_END_SELECT;
@extern method HTMLContentClass, MSG_META_MOUSE_PTR;
@extern method PresentationManagerClass, MSG_PM_COPY_SELECTED_OBJECTS;

/*
 *  Define two constants for the depth first search algorithm.
 */
#define CONTINUE 0
#define STOP     1
/*
 *  Define constants for how to search the ui tree.
 */
#define TEXT_ONLY 0
#define TEXT_AND_IMAGE 1

/*
 *  Object being searched for a key word.
 */
optr searchObj;
VisTextRange searchRange;
/*
 *  Flags used to help to see if the key word has been found.
 */
Boolean searchFound;

RectDWord FindAndDrawFocalBound (int direction, optr object, 
				 Rectangle *objRect, RectDWord *rect, 
				 Rectangle *box, GStateHandle gstate, 
				 ClassStruct *imageClass);
void UndrawFocalBound(optr object, RectDWord *drawBound, Rectangle *box,
		      GStateHandle gstate, optr newLink);

void InitializeDepthFirstSearch (void);
optr DepthFirstSearch (optr leaf, optr genContent, MemHandle searchInfo);
optr SearchInText(optr text, optr genContent, MemHandle searchInfo);
optr GetNextSiblingOrParentsSibling (optr currentObj, int direction, 
				     int how, ClassStruct *imageClass);
MemHandle DuplicateSearchInfo (MemHandle searchInfo);



/***********************************************************************
 *	MSG_PM_INITIALIZE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Initialize PManager's instance data.
 * PARAMETERS:	    (optr obj)
 * SIDE EFFECTS:    none
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/17/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_INITIALIZE
{
  pself->PM_recvObj = oself;

  if (pself->PM_hrefs)
      HTListDeleteAllItems(pself->PM_hrefs);
  else
      pself->PM_hrefs = HTListNew();       /* Store the HREFs on the page */

  if (pself->PM_anchorName)
      HTListDeleteAllItems(pself->PM_anchorName);
  else
      pself->PM_anchorName = HTListNew();  /* Store the NAMEs on the page */

  if (pself->PM_nameElement)
      HTListDeleteAllItems(pself->PM_nameElement);
  else
      pself->PM_nameElement = HTListNew();/* Store needed info about NAMEs */

  return;
}



