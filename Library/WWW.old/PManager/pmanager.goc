/***********************************************************************
 *		CreateChunkToSaveData
 ***********************************************************************
 * SYNOPSIS:	Allocate and return a chunk in the owner resource.
 * CALLED BY:	
 * RETURN:	HTMemHandle
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/14/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle 
CreateChunkToSaveData (char *ptr)
{
  HTMemHandle handle;
  char *dest;
  /*
   *  Allocate a memory chunk.
   */
  handle = HTMemAlloc(sizeof(char) * (strlen(ptr)+1));
EC(ECCheckHTMemHandle(handle);)
  /*
   *  Copy the title string over.
   */
  dest = (char *)HTMemLock(handle);
  strcpy(dest, ptr);
  HTMemUnlock(handle);
  return handle;
}	/* End of CreateChunkToSaveData.	*/


/***********************************************************************
 *		MSG_PM_SAVE_TITLE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Store the title of the document.  The title is the
 *		    text between <TITLE> and </TITLE>
 * PARAMETERS:	    (char *ptr)
 *			ptr - points the text.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/13/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_TITLE
{
  /*
   *  If there is a title already, free it.  Actually, it's weird if it
   *  already exists, unless the HTML source file has two <TITLE>'s.
   */
  if (pself->PM_title)
	HTMemFree(pself->PM_title);
  /*
   *  Create a chunk in pself->PM_title to store the data.
   */
  pself->PM_title = CreateChunkToSaveData(ptr);

  return;
}	/* End of MSG_PM_SAVE_TITLE.	*/


/***********************************************************************
 *		MSG_PM_SAVE_BASE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Store the base URL, which will be used to complete
 *		    any partial URLs on the html document.
 * PARAMETERS:	    (char *ptr)
 *			ptr - points the text.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/14/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_BASE
{
  /*
   *  If there is a base already, free it.  Actually, it's weird if it
   *  already exists, unless the HTML source file has two <BASE HREF=>'s.
   */
  if (pself->PM_base)
	HTMemFree(pself->PM_base);
  /*
   *  Create a chunk to store the base data in PM_base.
   */
  pself->PM_base = CreateChunkToSaveData(ptr);

  return;
}	/* End of MSG_PM_SAVE_BASE.	*/


/***********************************************************************
 *		MSG_PM_SAVE_HREF for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the HREF value and return a HREF token of it.
 * PARAMETERS:	    (char *href)
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_HREF
{
  int len, index;

  len = strlen(href);
  /*
   *  Has the HREF existed before?  If not, store it.
   */
  index = HTListFindItem(pself->PM_hrefs, href, len);
  if (index == -1)
    index = HTListAppend(pself->PM_hrefs, href, len);

  return index;
}	/* End of MSG_PM_SAVE_HREF.	*/


/***********************************************************************
 *		MSG_PM_SAVE_ANCHOR_NAME for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the NAME attribute value of an <A> element.
 * PARAMETERS:	    (char *name)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_ANCHOR_NAME
{
  NameElement elm;
  int len, check1, check2;

  len = strlen(name);

  check1 = HTListAppend(pself->PM_anchorName, name, len);
  elm.NE_object = object;
  elm.NE_offset = offset;
  check2 = HTListAppend(pself->PM_nameElement, &elm, sizeof(NameElement));
  /*
   *  PM_anchorName and PM_nameElement have one-to-one relationship.  
   *  That is, the first element in PM_anchorName is related to the
   *  first elment in PM_nameElement, and so on....
   */
  EC_WARNING_IF(check1 != check2, PM_ASSUMPTION_FAILS);

  return;
}	/* End of MSG_PM_SAVE_ANCHOR_NAME.	*/


/***********************************************************************
 *		MSG_PM_REFER_HYPERLINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the hrefToken, jump to the destination, which
 *                  could be
 *                  1) a named place on the same page, or
 *                  2) a different URL.
 * PARAMETERS:	    (int hrefToken)
 * SIDE EFFECTS:    
 *
 * STRATEGY:  If the refered place is 
 *            1) a named location on the same page, scroll the view to
 *               that place.
 *            2) a URL, make a request to load the page.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_HYPERLINK
{
  int len, nameToken;
  char *buffer;
  MemHandle mem;
  NameElement elm;
  Rectangle rect;
  VisTextConvertOffsetParams params;
  /*
   *  Find out the href string size, so we know how much space to 
   *  allocate to get the href string.
   */
  len = HTListGetItemSize(pself->PM_hrefs, hrefToken);
  mem = MemAlloc((len+1) * sizeof(char),
		    HF_DYNAMIC, HAF_STANDARD);
  buffer = MemLock(mem);
  HTListGetItem(pself->PM_hrefs, hrefToken, buffer, len);
  buffer[len] = NULL;
  if (buffer[0] == '#') {
    /* 
     *  It's a reference to the same page.
     */
    nameToken = HTListFindItem(pself->PM_anchorName, buffer, len);
    if (nameToken != -1) {
      HTListGetItem(pself->PM_nameElement, nameToken,
		    &elm,sizeof(NameElement));
      if (elm.NE_offset == -1) {
	/* Bring up the BOTTOM of this object on the screen. */
	@call elm.NE_object::MSG_VIS_GET_BOUNDS(&rect);
	@call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	   (rect.R_left, rect.R_bottom);
      }
      else if (elm.NE_offset == 0) {
	/* Bring up the TOP of this object on the screen. */
	@call elm.NE_object::MSG_VIS_GET_BOUNDS(&rect);
	@call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	   (rect.R_left, rect.R_top);
      }
      else {
	/* elm.NE_object MUST be a text object. */
	if (elm.NE_object &&
	    @call elm.NE_object::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass)){
	  params.VTCOP_offset = elm.NE_offset;
	  @call elm.NE_object::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE
	     (&params);
	  @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	     (params.VTCOP_xPos, params.VTCOP_yPos);
	}
      }
    }
    EC_WARNING_IF(nameToken == -1, PM_ANCHOR_NAME_NOT_FOUND);
    MemFree(mem);
  }
  else {
    /*
     *  It's a referece to another page.  Thus make a request to the 
     *  socket library to fetch a new page.
     */
    if (pself->PM_linkUnderMouse)
      MemFree(pself->PM_linkUnderMouse);
    pself->PM_linkUnderMouse = mem;
    MemUnlock(mem);
  }
  return;
}	/* End of MSG_PM_REFER_HYPERLINK.	*/



/***********************************************************************
 *		MSG_PM_REFER_MAPLINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    return the mouse coordinate on the image.
 * PARAMETERS:	    (int rel_x, rel_y, HTMemHandle src)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/18/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_MAPLINK
{
  pself->PM_x = rel_x;
  pself->PM_y = rel_y;
  pself->PM_src = src;
}	/* End of MSG_PM_REFER_ISMAP.	*/



/***********************************************************************
 *		MSG_PM_CLEAR_HREF_LINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the PM_linkUnderMouse;
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/21/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_CLEAR_HREF_LINK
{
  if (pself->PM_linkUnderMouse) {
    MemFree(pself->PM_linkUnderMouse);
    pself->PM_linkUnderMouse = NULL;
  }
  return;
}	/* End of MSG_PM_CLEAR_HREF_LINK.	*/



/***********************************************************************
 *		MSG_PM_CLEAR_UI_TREE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Delete the ui tree.
 * PARAMETERS:	    none.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_CLEAR_UI_TREE
{
  @send @genChildren::MSG_GEN_DESTROY
     (VUM_DELAYED_VIA_UI_QUEUE,CCF_MARK_DIRTY);
  pself->PM_recvObj = oself;
  if (pself->PM_title) {
    HTMemFree(pself->PM_title);
    pself->PM_title = NULL;
  }
  if (pself->PM_base) {
    HTMemFree(pself->PM_base);
    pself->PM_base = NULL;
  }
  if (pself->PM_linkUnderMouse) {
    MemFree(pself->PM_linkUnderMouse);
    pself->PM_linkUnderMouse = NULL;
  }
  if (pself->PM_query) {
    HTListDelete(pself->PM_query);
    pself->PM_query = NULL;
  }

  if (pself->PM_hrefs)
    HTListDeleteAllItems(pself->PM_hrefs);
  else
    pself->PM_hrefs = HTListNew();      /* Store the HREFs on the page */

  if (pself->PM_anchorName)
    HTListDeleteAllItems(pself->PM_anchorName);
  else
    pself->PM_anchorName = HTListNew(); /* Store the NAMEs on the page */
    
  if (pself->PM_nameElement)
    HTListDeleteAllItems(pself->PM_nameElement);
  else
    pself->PM_nameElement= HTListNew(); /* Store needed info about NAMEs */

  searchObj = NULL;
  searchRange.VTR_start = searchRange.VTR_end = 0;

  pself->PM_focalObj = pself->PM_referenceObj = NULL;
  pself->PM_drawBound.RD_left = pself->PM_drawBound.RD_right = 0;

  return;
}	/* End of MSG_PM_CLEAR_UI_TREE.	*/



