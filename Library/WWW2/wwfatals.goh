@ifndef __HT_FATALS_GOH
@define __HT_FATALS_GOH

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    ATTEMPTING_TO_RESUBMIT_AN_IN_USE_REQUEST,
    BUFFER_CANNOT_BE_ZERO_SIZE,
    BUFFER_IS_NOT_BIG_ENOUGH,
    WE_HAVE_OVER_BUFFERED_DATA,
    CANNOT_CHANGE_TO_NON_ANCESTOR_CLASS,
    CANNOT_REMOVE_FIRST_STREAM_OBJECT_IN_STREAM_STACK,
    CANNOT_REMOVE_LAST_STREAM_OBJECT_IN_STREAM_STACK,
    CANNOT_FREE_LIVE_HTNET, /* Net state must be HTNET_DEAD to be freed */
    CONTENT_CALLBACK_NOT_PROVIDED,
    EXCEED_MAX_PERSISTENT_CONNECTIONS,
    HTOBJATTACH_HAS_BEEN_CALLED_FOR_THREAD,
    HTOBJATTACH_NOT_CALLED_FOR_THREAD,
    HTLIST_INDEX_OUT_OF_RANGE,
    HTNET_NO_SCHEDULER,
    HTSCANNER_QUEUE_EMPTY,
    HTSCANNER_QUEUE_FULL,
    HTSOCKET_NO_TARGET_TO_PUSH_DATA,
    HTSTRING_RESOURCE_STILL_LOCKED,
    INVALID_ACCESS_METHOD_NAME,
    INVALID_CONTENT_HANDLER_NAME,
    INVALID_DATA_AND_LENGTH,
    INVALID_CLIENT,
    INVALID_BLOCK_IN_MSG_HT_STREAM_PUT_BLOCK,
    INVALID_HTDOCUMENT,
    INVALID_HTMEMORY,
    INVALID_HTNET_THREAD,
    INVALID_HTRELOAD_MODE,
    INVALID_HTSTREAMHANDLE,
    INVALID_HTTP_TYPE,
    INVALID_HTTP_METHOD,
    INVALID_HTTP_VERSION,
    INVALID_ID_FOR_HTLIST,
    INVALID_ID_FOR_HTOBJ,
    INVALID_WWW_CLIENT,
    INVALID_PORT_NUMBER,
    INVALID_PROTOCOL_NAME,
    INVALID_REQUEST,
    MUST_BE_A_PARENT_ANCHOR,
    MUST_HAVE_URL,
    NO_PERSISTENT_CONNECTIONS,
    NON_BASE64_OCTETS_PRESENT,
    NOT_IMPLEMENTED,
    NOT_A_SUBCLASS_OF_HTSTREAMCLASS,
    POSTCALLBACK_NOT_ALLOWED_IN_HTTP_0_9,
    PROGRAM_ERROR_HOST_NAME_EXCEEDS_MAX_HOST_NAME_LENGTH,
    PROTOCOL_NOT_IN_SCHEDULER_QUEUE,
    SOURCE_ANCHOR_MUST_HAVE_CONTENT_LENGTH,
    STATE_NOT_HANDLED,
    TEXT_STRINGS_CONTAIN_NULL
} FatalErrors;
#endif /* ERROR_CHECK */

/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    BUFFER_IS_NOT_OF_RECOMMENDED_SIZE,
    HTLIST_ELEMENT_SIZE_EXCEEDS_PASSED_IN_SIZE,
    HTLIST_REPLACE_ITEM_NOT_THE_SAME_SIZE,
    SCANNED_IDENTIFIER_LONGER_THAN_MAX_RESERVED_WORD_LENGTH,
    SCANNER_IGNORE_A_CHARACTER,
    HTSOCKET_NOT_INITIALIZED,   /* You need to initialize socket using 
				 MSG_HT_SOCKET_INITIALIZE before using 
				 it or to reuse a socket after calling
				 MSG_HT_SOCKET_CLOSE. */
    HTSOCKET_RESOLVED_ADDRESS_IS_LONGER_THAN_BUFFER,
    HTSTRING_LENGTH_ZERO,
    INVALID_TIME_FORMAT,
    NO_CONTENT_TYPE_SO_USING_DEFAULT_CONTENT_TYPE,
    PARSED_ILLEGAL_TIME,
    PROTOCOL_CALLBACK_NOT_SUPPORTED,
    SLIST_NOT_COMPLETELY_DELETED   
} Warnings;
#endif


#if ERROR_CHECK
extern FatalErrors htcoreFatalErrors;
extern Warnings    htcoreWarnings;
#endif 

@endif /* __HT_FATALS_GOH */



