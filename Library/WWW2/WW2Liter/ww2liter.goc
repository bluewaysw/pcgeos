@include <WWW2/WW2Core/ww2liter.goh>
@include <WWW2/WW2Core/wwutils.goh>
#include <ec.h>
#include "WWW2/wwMacro.h"


#define _wwlist pself->__wwlist
#define _current pself->__current
/*
*/

@classdecl WWListIteratorClass;

/*---------------------------------------------------------------------------
//		WWListIterator::WWListIterator()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Default constructor.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/30/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method WWListIteratorClass, WWListIterator /* (WWList *list = NULL); */
{
    _wwlist = wwlist;
    _current = NULL;
    @callsuper();
}	/* End of WWListIterator::WWListIterator() */


/*---------------------------------------------------------------------------
//		WWListIterator::Initialize()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Initialize a wwlist iterator. Must be called before
//              using other methods.
// SCOPE:	
// RETURN:	
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/30/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method WWListIteratorClass, LiterInitialize /* (WWList *wwlist); */
{
    PARAM_ASSERT(wwlist != NULL);
    _wwlist = wwlist;
}	/* End of WWListIterator::Initialize() */


/*---------------------------------------------------------------------------
//		WWListIterator::First()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Set iterator to begin iterating at start of list.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/30/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method WWListIteratorClass, First /* () */
{     
    ASSERTS(_wwlist != NULL,
            "WWListIterator::Initialize() was not called");
    
    _current = @call (_wwlist)::Head();
}	/* End of WWListIterator::First() */


/*---------------------------------------------------------------------------
//		WWListIterator::Next()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Move to the next element.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/30/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method WWListIteratorClass, Next /* () */
{
    ASSERTS(_wwlist != NULL,
            "WWListIterator::Initializez() was not called");

    if (_current) {
        _current = @call _current::GetNext();
    }
}	/* End of WWListIterator::Next() */


/*---------------------------------------------------------------------------
//		WWListIterator::CurrentElement()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the current element.
// SCOPE:	Public
// RETURN:	WWListElement or NULL
// STRATEGY:	Public
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/30/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method WWListIteratorClass, CurrentElement /* () const */
{
    ASSERTS(_wwlist != NULL,
            "WWListIterator::Initialize() was not called");

    return _current;
}	/* End of WWListIterator::CurrentElement() */



/*---------------------------------------------------------------------------
//		WWListIterator::IsDone()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Whether we have iterated the whole list.
// SCOPE:	Public
// RETURN:	TRUE if done else FALSE
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/30/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method WWListIteratorClass, IsDone /* () const */
{
    ASSERTS(_wwlist != NULL,
            "WWListIterator::Initialize() was not called");

    return (_current == NULL ? TRUE : FALSE);
}	/* End of WWListIterator::IsDone() */


