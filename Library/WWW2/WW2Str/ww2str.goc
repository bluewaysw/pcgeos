/*--------------------------------------------------------------------------
// WWStrCaseCmp
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as AnsiC strcmp, but case insensitive.
//
// SCOPE:           PUBLIC
//
// PARAMETERS:
//      [in]        pString     the string to store
//
// RETURN:          <0 if a<b
//                  0 if a==b
//                  >0 if a>b
//
// IMPLEMENTATION:  Copied from W3C HTString.c. This is double byte and
//                  the sematic of larger is down to the definition of
//                  TCHAR under New Sokoto, ie the UNICODE ordering. Works
//                  like strcmp.
//
//                  This would be easy with templates but we are not using
//                  them. The browser needs access to single and double
//                  byte versions of this code independent of the width of
//                  TCHAR used in the build.
//
// REVISION HISTORY:
//      Name        Date        Description
//      ----        ----        -----------
//      kkee         9/25/96    Initial Revision
//      jsenior     10/30/97    New Sokoto Port.
//
//------------------------------------------------------------------------*/

int _far _pascal WWStrCaseCmp(const char *pA, const char *pB) 
{
    int diff;

    for(; *pA && *pB; pA++, pB++)
    {
        diff = TOLOWER(*pA) - TOLOWER(*pB);
        if (diff)
        {
            return (int)diff;
        }
    }

    if (*pA) return 1;  /* a was longer than b */
    if (*pB) return -1; /* a was shorter than b */

    return 0;           /* Exact match */
} /* End of WWStrCaseCmp. */



/*--------------------------------------------------------------------------
// WWStrCaseCmpWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     As WWStrCaseCmp but takes a WWMemHandle for the first
//                  argument.
//
// SCOPE:           PUBLIC
//
// RETURN:          See WWStrCaseCmp.
//
// IMPLEMENTATION:  Locks the handle and passes the work to WWStrCaseCmp.
//
//                  This would be easy with templates but we are not using
//                  them. The browser needs access to single and double
//                  byte versions of this code independent of the width of
//                  TCHAR used in the build.
//
//                  If pB is single byte, the string on the handle is 
//                  assumed single byte also.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        9/26/96         Initial Revision
//      jsenior     10/28/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/

int _far _pascal WWStrCaseCmpWWMem(const WWMemHandle hA, const char *pB) 
{
    int result;

    EC(ECCheckWWMemHandle(hA);)
    char *pA = (char *)WWMemLock(hA);

    result = WWStrCaseCmp(pA, pB);

    EC(ECCheckWWMemHandle(hA);)
    WWMemUnlock(hA);

    return result;
} /* End of WWstrcasecmpWWMem. */
  

/*--------------------------------------------------------------------------
// WWStrNCaseCmp
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as Ansi strncmp, but case insensitive.
//
// SCOPE:           PUBLIC
//
// PARAMETERS:
//      [in]        pString     the string to store
//
// RETURN:          <0 if a<b
//                  0 if a==b
//                  >0 if a>b
//
// IMPLEMENTATION:  Copied from W3C HTString.c. This is double byte and
//                  the sematic of larger is down to the definition of
//                  TCHAR under New Sokoto, ie the UNICODE ordering. Works
//                  like strcmp.
//
//                  This would be easy with templates but we are not using
//                  them. The browser needs access to single and double
//                  byte versions of this code independent of the width of
//                  TCHAR used in the build.
//
// REVISION HISTORY:
//      Name        Date        Description
//      ----        ----        -----------
//      kkee        10/ 1/96    Initial Revision
//      jsenior     10/30/97    New Sokoto Port.
//
//------------------------------------------------------------------------*/

int _far _pascal WWStrNCaseCmp(const char *pA, const char *pB, int n) 
{
    if (!pA && pB) /* see comments in WWStrNCaseCmpWWMem below */
    {
        return -1;
    }
    if (pA && !pB)
    {
        return 1;
    }
    if (!pA && !pB)
    {
        return 0;
    }

    const char *pAPos, *pBPos;
    
    for (pAPos = pA, pBPos = pB;; pAPos++, pBPos++)
    {   /* traverse both strings unconditionally */
        int diff;

        if (pAPos == pA + n)
        {
            return 0;   /*   Match up to n characters */
        }
        if (!(*pAPos && *pBPos)) /* reached the end  */
        {
            return (int)(*pAPos - *pBPos);
        }
        diff = TOLOWER(*pAPos) - TOLOWER(*pBPos); /* check for difference */
        if (diff)
        {
            return diff;
        }
    }

    return 0; /* for completeness */
    /* this is nasty and hacky but it works fast. */
} /* End of WWStrNCaseCmp. */



/*--------------------------------------------------------------------------
// WWStrCaseCmpWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     As WWStrNCaseCmp but takes a WWMemHandle for the first
//                  argument.
//
// SCOPE:           PUBLIC
//
// RETURN:          See WWStrCaseCmp.
//
// IMPLEMENTATION:  Locks the handle and passes the work to WWStrNCaseCmp.
//
//                  This would be easy with templates but we are not using
//                  them. The browser needs access to single and double
//                  byte versions of this code independent of the width of
//                  TCHAR used in the build.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee         4/ 8/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
int _far _pascal 
WWStrNCaseCmpWWMem(const WWMemHandle hA, const char *pB, int n) 
{
    if (!n) /* no chars match perfectly */
    {
        return 0;
    }
    if (!hA && pB) /* no A string is smaller than B string */
    {
        return -1;
    }
    if (hA && !pB) /* A string is bigger than no B string */
    {
        return 1;
    }
    if (!hA && !pB) /* no strings are the same */
    {
        return 0;
    }

    int result;

    EC(ECCheckWWMemHandle(hA);)
    char *pA = (char *)WWMemLock(hA);

    result = WWStrNCaseCmp(pA, pB, n);

    EC(ECCheckWWMemHandle(hA);)
    WWMemUnlock(hA);

    return result;
} /* End of WWStrNCaseCmpWWMem. */
  
  
/*--------------------------------------------------------------------------
// WWStrCaseCmpWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Like Ansi strstr(s1, s2), but case-insensitive.
//
// SCOPE:           PUBLIC
//
// RETURN:          pointer to first occurrence of string s2 in s1, or NULL
//                  if not present.
//
// IMPLEMENTATION:  Copied from W3C HTString.c
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        10/ 2/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/

char * _far _pascal WWStrCaseStr(const char *pS1, const char *pS2) 
{
    if (!pS1 || !pS2 || !*pS2) /* this behaviour according to strstr definition */
    {
        return (char *)pS1; /* non const */
    }

    const char *pFirstLetter = pS1;

    while (*pFirstLetter)
    {
        if (TOLOWER(*pFirstLetter) == TOLOWER(*pS2)) /* found a matching first letter */
        {
            const char *pCurPos1 = pFirstLetter + 1; /* The offset of where the first matching letter was found + 1 */
            const char *pCurPos2 = pS2 + 1;          /* the second letter of S2 */

            while (*pCurPos1 && *pCurPos2 && TOLOWER(*pCurPos1) == TOLOWER(*pCurPos2))
            { /* check the rest of the string matches */
                pCurPos1++;
                pCurPos2++;
            }
            if (!*pCurPos2) /* only if you reach the end of S2 have you found a omplete match */
            {
                return (char *)pFirstLetter; /* non const */
            }
        }
        pFirstLetter++;
    }

    return NULL; /* didn't find any occurences of matching strings */
} /* End of WWStrCaseStr. */


/*--------------------------------------------------------------------------
// WWStrToLower
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Convert a string to all lower case.
//
// SCOPE:           PUBLIC
//
// RETURN:          passed in string pointer to modified parameter.
//
// IMPLEMENTATION:  Dependent upon New Sokoto tolower function which
//                  operates on a single character. This function
//                  modifies its parameter.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee         9/26/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/

char * _far _pascal WWStrToLower(char *pString) 
{
    if (!pString)
    {
        return NULL;
    }

    char *pResult = pString;

    for (; *pString; pString++)
    {
        *pString = TOLOWER(*pString);
    }

    return pResult;
} /* End of WWStrToLower. */



/*--------------------------------------------------------------------------
// WWStrToUpper
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Convert a string to all upper case.
//
// SCOPE:           PUBLIC
//
// RETURN:          passed in string pointer to modified parameter.
//
// IMPLEMENTATION:  Dependent upon New Sokoto toupper function which
//                  operates on a single character. This function
//                  modifies its parameter.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee         9/26/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
char * _far _pascal WWStrToUpper(char *pString) 
{
    if (!pString)
    {
        return NULL;
    }

    char *pResult = pString;

    for (; *pString; pString++)
    {
        *pString = TOUPPER(*pString);
    }

    return pResult;
} /* End of WWStrToUpper. */


/*---------------------------------------------------------------------------
//		stralloccopy()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Allocate and copy string.
// SCOPE:	Public
// RETURN:	string, must be freed by caller using "delete [] ..."
//              NULL if passed str is NULL or cannot allocate.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/09/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
char * _far _pascal 
stralloccopy(const char *str)
{
    if (!str) return NULL;
    char *ret =(char *) malloc(sizeof(char) * (strlen(str)+1));
    if (!ret) return NULL;
    return strcpy(ret, str);
}	/* End of stralloccopy() */


/*---------------------------------------------------------------------------
//		stralloccopyTCHAR()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Allocate and copy string.
// SCOPE:	Public
// RETURN:	string, must be freed by caller using "delete [] ..."
//              NULL if passed str is NULL or cannot allocate.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/09/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
TCHAR * _far _pascal
stralloccopyTCHAR(const char *str)
{
    if (!str) return NULL;
    TCHAR *ret = (TCHAR *)malloc(sizeof(TCHAR) * (strlen(str)+1));
    if (!ret) return NULL;
    return Jstrcpy(ret, str);
}	/* End of stralloccopy() */



/*---------------------------------------------------------------------------
//		strnalloccopy()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Allocate and copy string of n bytes.
// SCOPE:	Public
// RETURN:	string, must be freed by caller using "delete [] ..."
//              NULL if passed str is NULL or cannot allocate.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	5/11/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
char * _far _pascal
strnalloccopy(const char *str, word n)
{
    if (!str || !n) {
        return NULL;
    }
    char *ret = (char *)malloc(sizeof(char) * (n+1));
    if (!ret) return NULL;
    strncpy(ret, str, n);
    ret[n] = '\0';
    return ret;
}	/* End of strnalloccopy() */


/*---------------------------------------------------------------------------
//		strnalloccopyTCHAR()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Alloc and copy char* to TCHAR*.
// SCOPE:	Public
// RETURN:	TCHAR*, if not null, must be freed using "delete [] ..."
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	5/26/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
TCHAR * _far _pascal
strnalloccopyTCHAR(const char *str, word n)
{
    if (!str || !n) {
        return NULL;
    }
    TCHAR* ret = (TCHAR *)malloc(sizeof(TCHAR) * (n+1));
    if (!ret) return NULL;
    Jstrncpy(ret, str, n);
    ret[n] = C_NULL;
    return ret;
}	/* End of strnalloccopyTCHAR() */


/*---------------------------------------------------------------------------
//		strncpy()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Copy a char string to TCHAR.
// SCOPE:	Public
// RETURN:	Copied TCHAR string.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	mzhu    	3/19/98 	Initial version 
//	kkee    	3/19/98 	Commented
//	
//-------------------------------------------------------------------------*/
TCHAR * _far _pascal
strncpyToTCHAR(TCHAR *s1, const byte *s2, word len)
{
    PARAM_ASSERT(s1 && s2);

    word i;
    for(i=0; i<len; i++) {
        *(s1+i) = (TCHAR)*(s2+i);
    }
    /* Null-terminated the result string. */
    *(s1+i) = 0;
    return s1;
}	/* End of strncpy() */

/*---------------------------------------------------------------------------
//              strncpy()
//---------------------------------------------------------------------------
//
// SYNOPSIS:    Copy a TCHAR string to a uint8 buffer. Pad if TCHAR string
//              less than len long.
// SCOPE:       Public
// RETURN:      Copied uint8 string.
// STRATEGY:
//
// REVISION HISTORY:
//      Name            Date            Description
//      ----            ----            -----------
//      hlee            980430          Initial version
//
//--------------------------------------------------------------------------*/
byte * _far _pascal
strncpyTCHAR(byte *s, const TCHAR *ct, size_t n)
{
    PARAM_ASSERT(s && ct);

    size_t i = 0;
    for (; (i < n) && (s[i] = (const byte) ct[i]); i++) ;
    for (; (i < n); i++) 
        s[i] = 0;

    return s;
}	/* End of strncpy() */



/*--------------------------------------------------------------------------
// WWStrLenWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as Ansi strlen, but it takes a WWMemHandle.
//
// SCOPE:           PUBLIC
//
// RETURN:          The String's length.
//
// IMPLEMENTATION:  Checks for valid handle and then calls strlen
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        12/ 6/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
size_t _far _pascal WWStrLenWWMem(const WWMemHandle hString)
{
EC( ECCheckWWMemHandle(hString); )

    if (!hString)
    {
        return 0;
    }
    const char *pString;
    int result = 0;

    pString = (char *)WWMemLock(hString);
    if (pString != NULL)
    {
        result = strlen(pString);
    }

    EC( ECCheckWWMemHandle(hString); )
    WWMemUnlock(hString);
    
    return result;
} /* End of WWStrLenWWMem. */


size_t _far _pascal WWStringLen(const WWMemHandle hString)
{
    return WWStrLenWWMem(hString);
}


/*--------------------------------------------------------------------------
// WWStrCpyWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as Ansi strcpy, but here we take two WWMemHandles.
//
// SCOPE:           PUBLIC
//
// RETURN:          Passed in hDest which is now a copy of hSource.
//
// IMPLEMENTATION:  Locks the handles and then calls strcpy to do the 
//                  work. Allocation must take place outside this function.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        12/ 6/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
WWMemHandle _far _pascal 
WWStrCpyWWMem(const WWMemHandle hDest, const WWMemHandle hSource)
{
EC( ECCheckWWMemHandle(hDest); )
EC( ECCheckWWMemHandle(hSource); )
    if (hDest && hSource)
    {
        void *pDest,
             *pSource;

        pDest = WWMemLock(hDest);
        pSource = WWMemLock(hSource);
        
        strcpy((char *)pDest, (char *)pSource);
    
        WWMemUnlock(hDest);
        WWMemUnlock(hSource);
    }

    return (WWMemHandle)hDest; /* non const */
} /* End of WWStrCpyWWMem. */



/*--------------------------------------------------------------------------
// WWStrCatWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as Ansi strcat, but takes two WWMemHandles.
//
// SCOPE:           PUBLIC
//
// RETURN:          Passed in hS1 which is now has hS2 concatenated on
//                  the end.
//
// IMPLEMENTATION:  Locks the handles and then calls strcat to do the 
//                  work. Allocation must take place outside this function.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        12/ 6/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
WWMemHandle _far _pascal
WWStrCatWWMem(const WWMemHandle hS1, const WWMemHandle hS2)
{
    if (hS1 && hS2)
    {
        void *pS1,
             *pS2;

        pS1 = WWMemLock(hS1);
        pS2 = WWMemLock(hS2);

        strcat((char *)pS1, (char *)pS2);

        WWMemUnlock(hS1);
        WWMemUnlock(hS2);
    }

    return (WWMemHandle)hS1; /* non const */
} /* End of WWStrCatWWMem. */



/*--------------------------------------------------------------------------
// WWStrAllocCopy
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Allocate and copy a null-terminated string.
//
// SCOPE:           PUBLIC
//
// RETURN:          WWMemHandle to TCHAR or NULL if cannot allocate.
//
// IMPLEMENTATION:  Allocate and lock, then call strcpy to do the work.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        11/29/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
WWMemHandle _far _pascal WWStrAllocCopy(const char *pString)
{
    if (!pString)
    {
        return NULL;
    }

    WWMemHandle hResult;
    char *pResult;
    
    pResult = (char *)WWMemAllocAndLock(&hResult, strlen(pString) + 1);
    if (!hResult)
    {
        return NULL;
    }
    strcpy(pResult, pString);

    WWMemUnlock(hResult);

    return hResult;
} /* End of WWStrAllocCopy. */


/*---------------------------------------------------------------------------
//		WWStrAllocCopy()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Allocate and copy a null terminated TCHAR string.
// SCOPE:	Public
// RETURN:	NULL if failed to allocated.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	7/17/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
WWMemHandle _far _pascal
WWStrAllocCopyTCHAR(const TCHAR *pString)
{
    if (!pString)
    {
        return NULL;
    }

    WWMemHandle hResult;
    TCHAR *pResult;
    
    pResult = (TCHAR *)WWMemAllocAndLock(&hResult, 
                        sizeof(TCHAR*)*(Tstrlen(pString) + 1));
    if (!hResult)
    {
        return NULL;
    }
    Tstrcpy(pResult, pString);

    WWMemUnlock(hResult);

    return hResult;
}	/* End of WWStrAllocCopy() */


/*---------------------------------------------------------------------------
//		WWStrNAllocCopyTCHAR()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Copy a single byte string to a double byte string and 
//              return a WWMemHandle.
// SCOPE:	Public
// RETURN:	WWMemHandle or NULL.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/25/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
WWMemHandle _far _pascal
WWStrNAllocCopyTCHAR(const char *pString, word length)
{
    WWMemHandle ret;
    TCHAR *p = (TCHAR*) WWMemAllocAndLock(&ret, (length+1)*sizeof(TCHAR));
    if (!ret) {
        return NULL;
    }

    strncpy(p, pString, length);
/*    length = SjisStringToUnicodeString((char *)pString, p, length); */

    p[length] = C_NULL;
    WWMemUnlock(ret);
    return ret;
}	/* End of WWStrNAllocCopyTCHAR() */



/*--------------------------------------------------------------------------
// WWStrNAllocCopy
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as strncat, but takes a WWMemHandle. 
//                  Note 1. if no bytes are requested to be copied, ie n == 0
//                  no alloc vill take place.
//                  Note 2. if n is less than the length of the string + it's
//                  null terminator the result will be a string with no null
//                  terminator.
//
// SCOPE:           PUBLIC
//
// RETURN:          WWMemHandle to TCHAR or NULL if cannot allocate.
//
// IMPLEMENTATION:  Allocate and lock, then call strncpy to do the work.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee         6/ 5/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
WWMemHandle _far _pascal
WWStrNAllocCopy(const char *pString, size_t n) 
{
    if (!pString || !n)
    {
        return NULL;
    }

    WWMemHandle hResult;
    char *pResult;

    pResult = (char *)WWMemAllocAndLock(&hResult, n + 1);

    if (!hResult)
    {
        return NULL;
    }
    
    strcpy(pResult, pString);

    WWMemUnlock(hResult);

    return hResult;
} /* End of WWStrNAllocCopy. */


  
/*--------------------------------------------------------------------------
// WWStrAllocCat
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Similar to strcat with auto-reallocation.
//
// SCOPE:           PUBLIC
//
// RETURN:          WWMemHandle to TCHAR or NULL if cannot allocate.
//
// IMPLEMENTATION:  hString is re-allocated internally, then locked before 
//                  strcat is called to do the work.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        12/10/96        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/
WWMemHandle _far _pascal 
WWStrAllocCat(WWMemHandle hString, const char *pAppendage) 
{
    if (!hString || !pAppendage) 
    {
        return NULL;
    }

    char *pString;

    if (!WWMemRealloc(hString, 
                      (WWStrLenWWMem(hString) + strlen(pAppendage) + 1))) 
	{
        /* realloc failed */
        return NULL;
    }

    pString = (char *)WWMemLock(hString);
    strcat(pString, pAppendage);

    WWMemUnlock(hString);

    return hString;
} /* End of WWStrAllocCat. */



/*--------------------------------------------------------------------------
// WWStrNAllocCat
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as strncat, but the first paramater is a
//                  WWMemHandle.
//                  The passed in handle may not be locked.
//
// SCOPE:           PUBLIC
//
// RETURN:          WWMemHandle to TCHAR or NULL if cannot allocate. The
//                  returned handle might be different to hString.
//
// IMPLEMENTATION:  Realloc the string, lock it and call strncat to do the
//                  work.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee         6/ 4/97        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//------------------------------------------------------------------------*/

WWMemHandle _far _pascal 
WWStrNAllocCat(WWMemHandle hString, const char *pAppendage, int n) 
{
    if (!pAppendage || !n) 
    {
        return hString;
    }
    char *pString;

    if (!WWMemRealloc(hString, (WWStrLenWWMem(hString) + n + 1))) 
	{
        /* realloc failed */
        return NULL;
    }

    pString = (char *)WWMemLock(hString);
    strncat(pString, pAppendage, n);

    WWMemUnlock(hString);

    return hString;
} /* End of WWStrNAllocCat. */


/*---------------------------------------------------------------------------
//		WWStrNAllocCatTCHAR()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Append a single byte string to a double byte string
//              and return the resulting double byte string. The
//              passed in strH is deleted.
// SCOPE:	Public
// RETURN:	WWMemHandle or NULL.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/25/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
WWMemHandle _far _pascal
WWStrNAllocCatTCHAR(WWMemHandle strH, const char *append, word length)
{
    PARAM_ASSERT(strH);
    if (!length) {
        return NULL;
    }

    TCHAR *p = (TCHAR*) WWMemLock(strH);
    word oldLength = Tstrlen(p);
    WWMemUnlock(strH);

    if (!WWMemRealloc(strH, (oldLength+length+1)*sizeof(TCHAR))) {
        /* Reallocation failed */
        return NULL;
    }

    p = (TCHAR*) WWMemLock(strH);


    strncpy(&p[oldLength], append, length);
/*    length = SjisStringToUnicodeString((char *)append, &p[oldLength], length); */


    p[oldLength+length] = C_NULL;
    WWMemUnlock(strH);
    return strH;
}	/* End of WWStrNAllocCatTCHAR() */


/*---------------------------------------------------------------------------
//		strnalloccatTCHAR()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Alloc and concate.
// SCOPE:	Public
// RETURN:	TCHAR*, if not NULL, must be freed by "delete [] ...".
// STRATEGY:	The passed in str is consumed and maybe deleted,
//              expanded to concate extra string.
//
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	5/26/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
TCHAR* _far _pascal
strnalloccatTCHAR(TCHAR* str, const char *append, word length)
{
    PARAM_ASSERT(str);
    if (!length || !append) return NULL;
    word slen = Tstrlen(str);
    TCHAR *p = (TCHAR *)malloc(sizeof(TCHAR) * (slen + length + 1));
    if (!p) return NULL;
    Tstrncpy(p, str, slen);

    strncpy(&p[slen], append, length);
/*    length = SjisStringToUnicodeString((char*)append, &p[slen], length); */

    p[slen+length] = C_NULL;
    return p;
}	/* End of strnalloccatTCHAR() */


/*--------------------------------------------------------------------------
// WWStrAllocCopyWWMem
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Same as WWStrAllocCopy except we take a WWMemHandle here
//
// SCOPE:           PUBLIC
//
// RETURN:          WWMemHandle to TCHAR or NULL if cannot allocate.
//
// IMPLEMENTATION:  Lock passed in handle, Allocate for result and call    
//                  strcpy to do the work.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        11/29/97        Initial Revision
//      jsenior     10/30/97        New Sokoto Port.
//
//-------------------------------------------------------------------------*/
WWMemHandle _far _pascal WWStrAllocCopyWWMem(const WWMemHandle hString)
{
    if (!hString)
    {
        return NULL;
    }

    WWMemHandle hResult;
    char *pString,
         *pResult;

    pString = (char *)WWMemLock(hString);
    pResult = (char *)WWMemAllocAndLock(&hResult, 
                                        sizeof(char) * (strlen(pString) + 1));
    
    if (!hResult)
    {
        WWMemUnlock(hString);
        return NULL;
    }

    strcpy((char *)pResult, (char *)pString);
    
    WWMemUnlock(hString);
    WWMemUnlock(hResult);

    return hResult;
} /* End of WWStrAllocCopyWWMem. */



