                               _TEXT("Mon"),
                               _TEXT("Tue"),
                               _TEXT("Wed"),
                               _TEXT("Thu"),
                               _TEXT("Fri"),
                               _TEXT("Sat")};
    int currentDay = 0,
        result = 0;

    for (; currentDay < 7; currentDay++)
    {
        if (!WWStrNCaseCmp(wkdays[currentDay], pDayString, 3)) 
        {
            result = currentDay;
            break;
        }
    }

    return result;
} /* End of WWTime::MakeWkDay. */



//--------------------------------------------------------------------------
// WWTime::MakeMonth
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Make month number from its characters.
//
// SCOPE:           PRIVATE
//
// RETURN:          uint8, 1-based month
//
// IMPLEMENTATION:  Ported from W3C make_month in HTWWWStr.c. Modified by 
//                  kkee to convert to Geos month format which starts from 
//                  1 instead 0.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        11/ 8/97        Initial Revision
//      jsenior     11/10/97        New Sokoto Port.
//
//--------------------------------------------------------------------------  
uint8 WWTime::MakeMonth(const char *pMonthString)
{
    uint8 currentMonth = 0,
          result = 0;
    
    for (; currentMonth < 12; currentMonth++)
    {
        if (!WWStrNCaseCmp(months[currentMonth], pMonthString, 3))
        {
            result = currentMonth + 1;
            break;
        }
    }

    return result;
} /* End of WWTime::MakeMonth. */



//--------------------------------------------------------------------------
// WWTime::AddSeconds
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Take a DateTime and add some seconds to it
//
// SCOPE:           PRIVATE
//
// RETURN:          modify DateTime passed in
//
// IMPLEMENTATION:  Years past 65000 are not supported
//                  Adding more than 4294967235 seconds not supported
//  
//                  Deal with seconds and days independently. Convert date
//                  to days since 1600, add extra days and convert back.
//                  More comprehensive version than New Sokoto AddSeconds.
//                  See code comments for specifics.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      jsenior     11/10/97        Initial revision.
//
//--------------------------------------------------------------------------  
void WWTime::AddSeconds(uint32 addTime, DateTime *dateTime)
{
    if (!dateTime ||
        !addTime ||
        (dateTime->year > 65000) ||
        (addTime > 4294967235))
    {
        return; 
    }

    // split up the days and the seconds to stay within 32 bits
    int32 addDay = addTime / 86400; // 24 * 60 * 60

    addTime %= 86400; // remove the whole days from the time part

    // calculate the time

    addTime += dateTime->second;
    addTime += dateTime->minute * 60;
    addTime += dateTime->hour * 3600;

    addTime -= (dateTime->second = (addTime % 60));
    addTime /= 60;
    addTime -= (dateTime->minute = (addTime % 60));
    addTime /= 60;
    addTime -= (dateTime->hour = (addTime % 24));

    if (addTime / 24) // overflow from seconds
    {
        addDay++;
    }

    if (!addDay) // no more processing needed
    {
        return;
    }

    // done the time of day, now the date (bit more complicated)
    // first convert date to days since 1601, a convenient date mathematically
    dateTime->year -= 1601;
    uint32 existingDays = dateTime->year * 365;
    existingDays += dateTime->year / 4;    // add leap years
    existingDays -= dateTime->year / 100;  // don't leap on centuries
    existingDays += dateTime->year / 400;  // leap on 4century boundaries
    existingDays += daysBeforeMonthTable[dateTime->month - 1];
    if (IsLeapYear(dateTime->year + 1601) && (dateTime->month > 2))
    {
        existingDays++;
    }
    // add days of the month remembering they start at 1
    existingDays += dateTime->day - 1;

    addDay += existingDays; // total days since 1601 - now convert back

    // first calculate year (-1601)
    addDay -= (dateTime->year = addDay / 365) * 365;
    addDay -= dateTime->year / 4;
    addDay += dateTime->year / 100;
    addDay -= dateTime->year / 400;

    // correct for negative days from simple algorithm
    while (addDay < 0)
    {
        dateTime->year--;
        addDay += 365;
        if (IsLeapYear(dateTime->year + 1601))
        {
            addDay++;
        }   
    }

    uint8 leapCorrectionFactor = 0;
    if (IsLeapYear(dateTime->year + 1601))
    {
        leapCorrectionFactor = 1;
    }

    // calculate the month, taking into account leap years
    dateTime->month = 1;
    while ((dateTime->month < 12) && // it's Dec so must have finished
        (((addDay >= daysBeforeMonthTable[dateTime->month]) && // there are enough days
        ((dateTime->month < 2) || (!leapCorrectionFactor))) || // it's not a leap year or it's before Feb
        ((dateTime->month >= 2) && // it's after Feb but even with the extra day
        (addDay >= (daysBeforeMonthTable[dateTime->month] + leapCorrectionFactor))))) // there are enough days
    {
        dateTime->month++;
    }
    addDay -= daysBeforeMonthTable[dateTime->month - 1]; // take off days soaked up by previous months
    if (dateTime->month > 2)
    {
        addDay -= leapCorrectionFactor;
    }
    // assign days left over to day of the month remebering days start at 1
    dateTime->day = addDay + 1;
    // correct year
    dateTime->year += 1601;
    
    return;
} /* End of WWTime::AddSeconds. */



//--------------------------------------------------------------------------
// WWTime::ParseTime
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Parse a str in GMT format to a local time 
//                  DateTime representation. 
//                  Four formats are accepted:
//
//                  Wkd, 00 Mon 0000 00:00:00 GMT   (rfc1123) // second
//                  Weekday, 00-Mon-00 00:00:00 GMT (rfc850) // first
//                  Wkd Mon 00 00:00:00 0000 GMT    (ctime) // remaining
//                  1*DIGIT                         (delta-seconds) // delta
//
// SCOPE:           PUBLIC
//
// RETURN:          TRUE if dateTime successfully initialized.
//                  Otherwise FALSE.
//
// IMPLEMENTATION:  Ported from W3C HTWWWStr.c HTParseTime which converts to
//                  Unix's time_t format. Why doesn't Geos use time_t format
//                  instead of the stupid TimerDateAndTime format????
//                  Arghhhhhhhhhhh!
//                  Now converts to similar New Sokoto format but inside a
//                  class.
//                  This function writes back to a DateTime Class which has
//                  been malloce'd OUTSIDE this function. Using a class object
//                  which may use fixed memory was decided upon after discussion
//                  between kkee & jsenior.
//                  This function used to compute and store the Day of the Week.
//                  Since New Sokoto does not store this information we no
//                  longer calculate it. The day of the week is avaliable from
//                  New Sokoto's DayOfWeek funtion in datetime.h
//                  Still don't take into account relaive time zones (GMT)
//
// REVISION HISTORY:
//      Name        Date        Description
//      ----        ----        -----------
//      kkee        11/ 8/96    Initial Revision
//      jsenior     10/10/97    New Sokoto Port.
//
//--------------------------------------------------------------------------  
Boolean WWTime::ParseTime(const char *pString, DateTime *dateTime)
{
    if (!pString || !dateTime)
    {
        return FALSE;
    }

    const char *pDate;

    if ((pDate = strchr(pString, ',')) != NULL) /* Thursday, 10-Jun-93 01:29:59 GMT */
    {                                           /* or: Thu, 10 Jan 1993 01:29:59 GMT */
        pDate++;                          
        while (*pDate == ' ')
        {
            pDate++;
        }
        if (strchr(pDate, '-')) /* First format */
        {                
            if ((int)strlen(pDate) < 18)
            {
                EC_WARN("String too short - Date invalid\n");
                return FALSE;
            }
            
            dateTime->year = MakeNum(pDate + 7); // cope with the millenium problem
            if (dateTime->year >= 80)
            {
                dateTime->year += 1900;
            }
            else
            {
                dateTime->year += 2000;
            }
            dateTime->month  = MakeMonth(pDate + 3);
            dateTime->day    = MakeNum(pDate);
            dateTime->hour   = MakeNum(pDate + 10);
            dateTime->minute = MakeNum(pDate + 13); 
            dateTime->second = MakeNum(pDate + 16); 
        }
        else    /* Second format */
        {
            if ((int)strlen(pDate) < 20) 
            {   
                EC_WARN("String too short - Date invalid\n");
                return FALSE;
            }
            dateTime->year   = 100 * MakeNum(pDate + 7) +
                                   MakeNum(pDate + 9);
            dateTime->month  = MakeMonth(pDate + 3);            
            dateTime->day    = MakeNum(pDate);
            dateTime->hour   = MakeNum(pDate + 12);
            dateTime->minute = MakeNum(pDate + 15);
            dateTime->second = MakeNum(pDate + 18);    
        }
    }
    else if (ISDIGIT(*pString)) /* Delta seconds format */
    {
        uint32 delta = 0;

        PlatformDriver::GetRealTime(dateTime); /* Current local time */
        while (ISDIGIT(*pString))
        {
            delta *= 10;
            delta += (*pString++) - ('0');
        }
        AddSeconds(delta, dateTime);
       
        return TRUE;
    }
    else /* Try the remaining format:  Wed Jun  9 01:29:59 1993 GMT */
    {        
        pDate = pString;
        while (*pDate == ' ')
        {
            pDate++;
        }
        if ((int)strlen(pDate) < 24)
        {
            EC_WARN("String too short - Date invalid\n");
            return FALSE;
        }
        dateTime->year   = 100 * MakeNum(pDate + 20) +
                               MakeNum(pDate + 22);
        dateTime->month  = MakeMonth(pDate + 4);
        dateTime->day    = MakeNum(pDate + 8);
        dateTime->hour   = MakeNum(pDate + 11);
        dateTime->minute = MakeNum(pDate + 14);
        dateTime->second = MakeNum(pDate + 17);
    }

    if (dateTime->second > 59   || // simple checks
        dateTime->minute > 59   ||
        dateTime->hour   > 23   ||
        dateTime->day    < 1    ||
        dateTime->day    > 31   ||
        dateTime->month  < 1    ||
        dateTime->month  > 12   ||
        dateTime->year   < 1980 ||
        dateTime->year   > 2099)
    {
        EC_WARN("DateTime out of bounds.\n");
        return FALSE;
    }

    return TRUE; 
} /* End of WWTime::ParseTime. */



//--------------------------------------------------------------------------
// WWTime::Write2Digits
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Opposite of MakeNum - a helper function
//
// SCOPE:           PRIVATE
//
// RETURN:          void - can't really go wrong unless pString is wrong
//                  modified pString (the whole point)
//
// IMPLEMENTATION:  see code - too obvoius
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      jsenior     11/19/97        Initial revision
//
//--------------------------------------------------------------------------  
void WWTime::Write2Digits(char *pString, uint8 number)
{
EC( if (!pString || (number > 99))
    {
        EC_WARN("Bad parametes to Write2Digits function (called by CreateTime)");
    } )
    *pString++ = (number / 10) + '0';
    *pString = (number % 10) + '0';
} /* End of WWTime::Write2Digits. */



//--------------------------------------------------------------------------
// WWTime::CreateTime
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Convert the New Sokoto internal time format to that
//                  specified in (rfc1123) ie: Wkd, 00 Mon 0000 00:00:00 GMT
//
// SCOPE:           PUBLIC
//
// RETURN:          TRUE if dateTime successfully converted.
//
// IMPLEMENTATION:  This function reads from a DateTime Class which has
//                  been malloce'd OUTSIDE this function. The result string
//                  is malloced inside this function and the handle returned
//                  must be freed by the caller. The handle is to a TCHAR.
//                  Still don't take into account relaive time zones (GMT)
//                  Assuming New Sokoto clock is set to GMT.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      jsenior     11/19/97        Initial revision
//
//--------------------------------------------------------------------------  
WWMemHandle WWTime::CreateTime(const DateTime * const dateTime)
{
    if (!dateTime)
    {
        EC_WARN("Invalid pointer passed to WWCreateTime.");
        return NULL;
    }

EC( if (!DateIsValid(dateTime->year, dateTime->month, dateTime->day) ||
        !TimeIsValid(dateTime->hour, dateTime->minute, dateTime->second))
    {
        EC_WARN("Invalid dateTime passed to WWCreateTime.");
    } )

    WWMemHandle hResult;
    char *pResult = (char *)WWMemAllocAndLock(&hResult, (strlen(timeTemplate) + 1) * sizeof(char));
    if (!hResult)
    {
        EC_WARN("Malloc failed in WWCreateTime.");
        return NULL;
    }

    strcpy(pResult, timeTemplate);
    strncpy(pResult,
            wkdays[DayOfWeek(dateTime->year,
                             dateTime->month,
                             dateTime->day)],
            3);
    strncpy(&pResult[8],
            months[dateTime->month - 1],
            3);
    Write2Digits(&pResult[5], dateTime->day);
    Write2Digits(&pResult[12], dateTime->year / 100);
    Write2Digits(&pResult[14], dateTime->year % 100);
    Write2Digits(&pResult[17], dateTime->hour);
    Write2Digits(&pResult[20], dateTime->minute);
    Write2Digits(&pResult[23], dateTime->second);

    WWMemUnlock(hResult);

    return hResult;
} /* End of WWTime::CreateTime. */

