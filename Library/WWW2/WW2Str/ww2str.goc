void _far _pascal WWStringECCheck(WWMemHandle hString)
{
    ECCheckWWMemHandle(hString);
    return;
}

/***********************************************************************
 *			Tstrlen
 ***********************************************************************
 * SYNOPSIS:	    Returns the number of TCHARs in the string, not
 *	    	    counting the terminator.
 * CALLED BY:	    
 * RETURN:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mchen	9/28/95   	Initial Revision
 *
 ***********************************************************************/
size_t _far _pascal Tstrlen(const TCHAR *s)
{

#ifdef DO_DBCS
    ASSERTS( !((int32)s & 0x01), "DBCS string is not aligned on even boundary" );
#endif

    const TCHAR *start = s;
    while(*s != 0) { 
	s++;
    }
    return (s - start);
}	/* End of Tstrlen.	*/


/***********************************************************************
 *			Tstrcpy
 ***********************************************************************
 * SYNOPSIS:	 Copies from (TCHAR) string to (TCHAR) string.
 * CALLED BY:	     
 * RETURN:	 A pointer to the destination (TCHAR) string    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mrowlee	9/26/95   	Initial Revision
 *
 ***********************************************************************/
TCHAR* _far _pascal Tstrcpy( TCHAR *s, const TCHAR *ct )
{

#ifdef DO_DBCS
    ASSERTS( !( ((int32)s & 0x01) || ((int32)ct & 0x01)), "DBCS string not aligned on even boundary" );
#endif

    TCHAR *tmp = s;
    while ( (*s++ = *ct++) ) {
	;
    }

    return( tmp );

}	/* End of Tstrcpy.	*/

/***********************************************************************
 *			Tstrncpy
 ***********************************************************************
 * SYNOPSIS:	 A strncpy function that copies (up to n) chars
 *               from TCHAR to TCHAR     
 * CALLED BY:	    
 * RETURN:	 A pointer to the (modified) TCHAR string.   
 * SIDE EFFECTS: If n > chars in source, pad destination with '\0's   
 *
 * STRATEGY:	 Copy at most n characters from source string to
 *               destination string. Pad with '\0's if source string has
 *               fewer than n characters.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mrowlee	9/27/95   	Initial Revision
 *
 ***********************************************************************/
TCHAR* Tstrncpy( TCHAR *s, const TCHAR *ct, size_t n )
{

#ifdef DO_DBCS
    ASSERTS( !( ((int32)s & 0x01) || ((int32)ct & 0x01)), "DBCS string not aligned on even boundary" );
#endif

    TCHAR *tmp = s;
    while ( ( n ) && (  *s++ = *ct++ ) ) {
        n--;	/* must do it here so that the check below is valid for
		   size_t being unsigned */
    }

    /*
     * If n > 0, then pad with '\0's.
     * Is this necessary???? The
     * current Clib function doesn't do this
     *
     * Changed to n > 1 because n didn't get decremented above when it
     * copied the null character, but the string pointers did. Thus,
     * it used to write one more character than the value passed in (n)
     *   - dbaumann
     */ 
    while ( n > 1 ) {     
        *s++ = '\0';
	n--;
    }


    return( tmp );

}	/* End of Tstrncpy.	*/


/***********************************************************************
 *			Tstrrchr
 ***********************************************************************
 * SYNOPSIS:	 Find last occurrence of c in string cs.   
 * CALLED BY:	    
 * RETURN:	 Pointer to last occurrence of c in string cs. Return
 *               NULL if not present.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mrowlee	9/27/95   	Initial Revision
 *	lester  11/7/97         Fixed to check first character in string
 *                              and handle searching for the null character.
 *
 ***********************************************************************/
TCHAR* _far _pascal
Tstrrchr( const TCHAR *cs, int c )
{
#ifdef DO_DBCS
    ASSERTS( !((int32)cs & 0x01) ,"DBCS string is not aligned on even boundary" );
#endif

    const TCHAR *p = cs + Tstrlen(cs);

    do {
        if (*p == (TCHAR)c) {
            return (TCHAR *)p;
        }
    } while (--p >= cs);

    return NULL;

}	/* End of Tstrrchr.	*/


/***********************************************************************
 *			Tstrcat
 ***********************************************************************
 * SYNOPSIS:	 A function that concatenates the source string to the
 *               end of the destination string.
 * CALLED BY:	    
 * RETURN:	 A pointer to the (concatenated) string.    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	 Find the end of the destination string and append the
 *               source string
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mrowlee	9/27/95   	Initial Revision
 *
 ***********************************************************************/
TCHAR* _far _pascal
Tstrcat( TCHAR *s, const TCHAR *ct )
{


#ifdef DO_DBCS
    ASSERTS( !( ((int32)s & 0x01) || ((int32)ct & 0x01)), "DBCS string not aligned on even boundary" );
#endif

    TCHAR *tmp = s;
    /*
     * Find the end of s
     */
    while ( *s++ ) {
        ;
    }
    s--;              /*  Set s to point to '\0' value */
    
    /*
     * Append ct onto end of s
     */
    while ( (*s++ = *ct++) ) {
	;
    }

    return ( tmp );

}	/* End of Tstrcat.	*/



/***********************************************************************
 *			Jstrcpy
 ***********************************************************************
 * SYNOPSIS:	 Copies from (TCHAR) string to (char) string
 * CALLED BY:	    
 * RETURN:	 A pointer to the (char) string.   
 * SIDE EFFECTS: Converts full-width roman to ASCII equivalent.
 *		 Non-mapping chars become "~".
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mrowlee	9/26/95   	Initial Revision
 *
 ***********************************************************************/
char* _far _pascal
Jstrcpy(TCHAR *s, const char *ct )
{
    TCHAR *tmp = s;
    while ( (*s++ = ( TCHAR )*ct++) ) {
	;
    }
    return( tmp );
}

