//--------------------------------------------------------------------------
// WWTime::MakeNum
//--------------------------------------------------------------------------
//
// DESCRIPTION:     Make a number from a two-digit string. First digit is
//                  optional (e.g. " 9" and "14" are valid).
//                  Note this function returns a silly value without
//                  warning if an inappropriate string is passed in.
//
// SCOPE:           PRIVATE
//
// RETURN:          The decimal equivalent of the number in the string.
//
// IMPLEMENTATION:  These functions are taken from the server written by
//                  Ari Luotonen in W3C HTWWWStr.c.
//
// REVISION HISTORY:
//      Name        Date            Description
//      ----        ----            -----------
//      kkee        11/ 8/97        Initial Revision
//      jsenior     11/10/97        New Sokoto Port.
//
//--------------------------------------------------------------------------  
uint8 WWTime::MakeNum(const char *pString)
{
    if (*pString >= '0' && *pString <= '9')
    {
        return 10 * (*pString - '0') + *(pString + 1) - '0';
    }
    else
    {
        return *(pString + 1) - '0';
    }
} /* End of WWTime::MakeNum. */



