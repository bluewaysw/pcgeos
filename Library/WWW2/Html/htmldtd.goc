/*
**              HTML Elements
**              -------------
**
**   If you add a new element here, make sure to update the number of elements in htmlDTD
**   below. Currently we have 111 elements. The endScope value *SHOULD* be the same as the
**   startScope value defined in htmlft.goc.
**
**
**   Tag         Token                Attributes        NumOfAttrs    		Content         endScope
**   ---         -----                ----------        ----------              -------         --------
**
*/
static SGMLTag htmlTags[] = {
    {"A",         HTMLT_A,            a_attr, 	       ALEN(a_attr),		SGMLC_MIXED,       2},
    {"ABBREV",    HTMLT_ABBREV,       gen_attr,        ALEN(gen_attr),  	SGMLC_MIXED,       3},
    {"ABSTRACT",  HTMLT_ABSTRACT,     gen_attr,        ALEN(gen_attr),  	SGMLC_MIXED,       3},
    {"ACRONYM",   HTMLT_ACRONYM,      gen_attr,        ALEN(gen_attr),  	SGMLC_MIXED,       3},
    {"ADDED",     HTMLT_ADDED,        gen_attr,        ALEN(gen_attr),  	SGMLC_MIXED,       3},
    {"ADDRESS",   HTMLT_ADDRESS,      0,                0,  			SGMLC_MIXED,       3},
