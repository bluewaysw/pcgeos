@include "WWW2/Conv/htciter.goh"
@include "WWW2/Conv/htcomp.goh"
@include "WWW2/wwMacro.h"

@classdecl HTChildrenIteratorClass, neverSaved;

#define _parent  (pself->__parent)
#define _current (pself->__current)

//---------------------------------------------------------------------------
//		HTChildrenIterator::HTChildrenIterator()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Constructor
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method 
HTChildrenIteratorClass, HTChildrenIterator // (HTComposite *parent) :
{
    _parent = parent;
    _current = 0;
}	/* End of HTChildrenIterator::HTChildrenIterator() */


//---------------------------------------------------------------------------
//		HTChildrenIterator::Initialize()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Initialize a children iterator. Must be called before
//              using other methods. Alternatively, the parent glyph 
//              can be provided in the constructor.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTChildrenIteratorClass, HTCIInitialize // (HTComposite *parent)
{
    PARAM_ASSERT(parent);
    _parent = parent;
}	/* End of HTChildrenIterator::Initialize() */



//---------------------------------------------------------------------------
//		HTChildrenIterator::First()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Set the iterator to begin iterating at the start of
//              children list.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // inline void
HTChildrenIteratorClass, HTCIFirst // ()
{
    ASSERTS(_parent != NULL,
            "HTChildrenIterator::Initialize() was not called");
    _current = @call _parent::FirstChild();
}	/* End of HTChildrenIterator::First() */



//---------------------------------------------------------------------------
//		HTChildrenIterator::Next()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Move to the next child.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // inline void
HTChildrenIteratorClass, HTCINext // ()
{
    ASSERTS(_parent != NULL,
            "HTChildrenIterator::Initialize() was not called");
    if (_current) {
        _current = @call /* (HTGlyph*) */ _current::GetSibling();
    }
}	/* End of HTChildrenIterator::Next() */



//---------------------------------------------------------------------------
//		HTChildrenIterator::CurrentGlyph()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the current child glyph in the iterator.
// SCOPE:	Public
// RETURN:	HTGlyph or NULL
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // inline HTGlyph*
HTChildrenIteratorClass, CurrentGlyph // () const
{
    ASSERTS(_parent != NULL,
            "HTChildrenIterator::Initialize() was not called");
    return _current;
}	/* End of HTChildrenIterator::CurrentGlyph() */



//---------------------------------------------------------------------------
//		HTChildrenIterator::IsDone()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Whether we have iterated all the children glyph.
// SCOPE:	Public
// RETURN:	TRUE if done else FALSE.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // inline Boolean
HTChildrenIteratorClass, HTCIIsDone // () const
{
    ASSERTS(_parent != NULL,
            "HTChildrenIterator::Initialize() was not called");
    return (_current == NULL ? TRUE : FALSE);
}	/* End of HTChildrenIterator::IsDone() */

