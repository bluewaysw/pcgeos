@include "WWW2/Conv/htcomp.goh"
@include "WWW2/wwMacro.h"

@classdecl HTCompositionClass;

@method HTCompositionClass, HTComposition
{
}


@method  //   virtual Boolean 
HTCompositionClass, Format // (HTFormat * formatter)
{
    EC_FAIL("Can't format HTComposition");
    return TRUE;
}


@method //    virtual Boolean 
HTCompositionClass, GetMinMaxWidth // (MinMaxAccumulator * minmax)
{
    return TRUE;
}


@method //  virtual void 
HTCompositionClass, RequestBounds // (HTGlyph * child, HTSize * newSize) 
{
    EC_FAIL("HTComposition::RequestBounds() not allowed");
}


@method //    virtual HTMLToken 
HTCompositionClass, GetIdentity // () 
{
    return HTMLT_XXX_INVALID;
}
