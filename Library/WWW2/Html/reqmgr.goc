@include <Ansi/stdio.h>
@include <Ansi/stdlib.h>
@include <Ansi/string.h>
@include "WWW2/Conv/req.goh"
@include "WWW2/Conv/reqmgr.goh"
@include "WWW2/Conv/sched.goh"
@include "WWW2/wwMacro.h"

#define REQ_MGR_THREAD_STACK_SIZE 1024   /* No ui stuff, 1K is enough. */


@classdecl ServerClass;
@classdecl HTRequestManagerClass;

#define _flexframe (pself->__flexframe)
#define _viewer    (pself->__viewer)
#define _proxyName (pself->__proxyName)
#define _proxyPort (pself->__proxyPort)
#define _loadImage (pself->__loadImage)
#define _serverThread (pself->__serverThread)
#define _scheduler (pself->__scheduler)
#define _pendingRequest (pself->__pendingRequest)
#define _stopping (pself->__stopping)
#define _sem (pself->__sem)
#define _numRequest (pself->__numRequest)
#define _appHandle (pself->__appHandle)

#if 0
