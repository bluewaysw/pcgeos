//---------------------------------------------------------------------------
//		HTGlyph::HTGlyph()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Constructor.
// SCOPE:	Protected.
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/18/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method HTGlyphClass, HTGlyph // (HTGlyph *parent)
{
    if (parent) {
        _sibling = parent;
        _flags.pointToParent = 1;
    } else {
        _sibling = NULL;
        _flags.pointToParent = 0;
    }

    _flags.geometryValid = 0;
    _flags.sizeValid = 0;
}	/* End of HTGlyph::HTGlyph() */


//---------------------------------------------------------------------------
//		HTGlyph::SetGeometryValid()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Set the geometry of a glyph to be valid or invalid.
//              A glyph with invalid geometry will be formatted.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	4/27/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTGlyphClass, SetGeometryValid // (Boolean flag)
{
    _flags.geometryValid = (flag == TRUE ? 1 : 0);
}	/* End of HTGlyph::SetGeometryValid() */


//---------------------------------------------------------------------------
//		HTGlyph::IsGeometryValid()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Check to see if the geometry is valid
// SCOPE:	Public
// RETURN:	TRUE if it is, FALSE otherwise.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	4/27/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTGlyphClass, IsGeometryValid // ()
{
    return (_flags.geometryValid ? TRUE : FALSE);
}	/* End of HTGlyph::IsGeometryValid() */


//---------------------------------------------------------------------------
//		HTGlyph::InsertSibling()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Insert a sibling after a glyph. The sibling will have
//              the same parent as the glyph. If the passed in glyph
//              is NULL, it will be insert after the callee glyph.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/28/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTGlyphClass, InsertSibling // (HTGlyph *sibling, HTGlyph *glyph)
{
    PARAM_ASSERT(sibling);

    if (!glyph) {
        // Its ok to modify as it is passed by value
        glyph = oself;
    }
    
    // Make sure glyph is linked to the UI tree. This is 
    // checked by making sure the glyph has a parent.
    ASSERTS(@call glyph::GetParent() != NULL,
            "HTGlyph::InsertSibling() glyph not linked to HTML uitree");

    optr temp = @call glyph::GetSiblingGlyph();
    @call sibling::SetSiblingGlyph(temp);

    @call glyph::SetSiblingGlyph(sibling);
    if (@call glyph::DoesPointToParent()) {
        @call glyph::SetPointToParent(0);
        @call sibling::SetPointToParent(1);
    }
}	/* End of HTGlyph::InsertSibling() */



//---------------------------------------------------------------------------
//		HTGlyph::GetParent()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the parent of a glyph. Returns NULL if no parent.
// SCOPE:	Public
// RETURN:	HTGlyph*
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/17/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // HTGlyph*
HTGlyphClass, GetParent // () const
{
    optr /* HTGlyph * */ temp = /* (HTGlyph*)this */ oself;
    while (temp && !@call temp::DoesPointToParent()) {
        temp = @call temp::GetSiblingGlyph();
    }

#if ERROR_CHECK
    if (temp && !@call temp::DoesPointToParent()) {
        EC_FAIL("HTGlyph::GetParent() invalid parent");
    }
#endif

    return (temp == NULL ? NULL : @call temp::GetSiblingGlyph());
}	/* End of HTGlyph::GetParent() */


