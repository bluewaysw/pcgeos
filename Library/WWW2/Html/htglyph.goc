@if 0 
#if ERROR_CHECK
@method // void
HTBoundedGlyphClass, ECPrintBounds // (File *fp)
{
    PARAM_ASSERT(fp);

    char str[124];
    sprintf(str, "\n  Bounds = (%d,%d) - (%d,%d)", 
            _coord.x0, _coord.y0, _coord.x1, _coord.y1);
    @call fp::Write((byte*)str, strlen(str));

    sprintf(str, "\n  GeometryValid = ", 
            _coord.x0, _coord.y0, _coord.x1, _coord.y1);
    if (_flags.geometryValid) {
        strcat(str, "TRUE");
    } else {
        strcat(str, "FALSE");
    }
    @call fp::Write((byte*)str, strlen(str));
}	/* End of HTBoundedGlyph::ECPrintBounds() */
