//---------------------------------------------------------------------------
//		MinMaxAccumulator::MinMaxAccumulator()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Constructor
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	4/17/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method MinMaxAccumulatorClass, MinMaxAccumulator // () 
{
    _min = 0;
    _max = 0;
    _runningMin = 0;
    _runningMax = 0;
    _indentLevel= 0;
}	/* End of MinMaxAccumulator::MinMaxAccumulator() */


//---------------------------------------------------------------------------
//		MinMaxAccumulator::NewRow()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	New line, so we reset running min and max.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	4/17/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
MinMaxAccumulatorClass, NewRow // ()
{
    _runningMin += (_indentLevel * HT_INDENT_SPACE);
    _min = (_runningMin > _min ? _runningMin : _min);
    _runningMax += (_indentLevel * HT_INDENT_SPACE);
    _max = (_runningMax > _max ? _runningMax : _max);
    _runningMin = 0;
    _runningMax = 0;
}	/* End of MinMaxAccumulator::NewRow() */


@method 
MinMaxAccumulatorClass, AcceptMyMin // (sword width)
{
    _runningMin = (width > _runningMin ? width : _runningMin);
}

@method // inline void
MinMaxAccumulatorClass, AcceptMyMax // (sword width)
{
    _runningMax += width;
}


@method // inline sword
MinMaxAccumulatorClass, GetMin // () 
{
    @call self::NewRow();
    return _min;
}

@method // inline sword
MinMaxAccumulatorClass, GetMax // () 
{
    @call self::NewRow();
    return _max;
}



@method // inline void
MinMaxAccumulatorClass, IncrementIndent // () 
{
    _indentLevel++;
}


@method // inline void
MinMaxAccumulatorClass, DecrementIndent // () 
{
    if (_indentLevel) {
        _indentLevel--;
    }
}
