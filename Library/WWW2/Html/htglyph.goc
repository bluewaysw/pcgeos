//---------------------------------------------------------------------------
//		HTBoundedGlyph::HTBoundedGlyph()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Constructor.
// SCOPE:	Protected
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	4/23/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method /* void */ HTBoundedGlyphClass, HTBoundedGlyph // ()
{
    _coord.x0 = 0;
    _coord.y0 = 0;
    _coord.x1 = 0;
    _coord.y1 = 0;
}	/* End of HTBoundedGlyph::HTBoundedGlyph() */


//---------------------------------------------------------------------------
//		HTBoundedGlyph::RequestDraw()
//---------------------------------------------------------------------------
// 
// SYNOPSIS:    For a glyph to request to be drawn.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	5/04/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method /* void */
HTBoundedGlyphClass, RequestDraw // ()
{
    if (_flags.geometryValid) {
        // Draw only if geometry is valid
        optr /* HTGlyph * */ parent = @call self::GetParent();
        if (parent) {
            @call parent::RequestDrawFromChild(oself, _coord);
        }
    }
}	/* End of HTBoundedGlyph::RequestDraw() */


//---------------------------------------------------------------------------
//		HTBoundedGlyph::RequestDrawFromChild()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Accept a request to draw from a child.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	We add our bounds to coord and pass it on to our
//              parent. This process repeats itself until it reaches a
//              glyph that knows when to display, normally this is the
//              root of the uitree. So the root glyph would intercept
//              this method to draw the child.
// 
//              Note: what happen if my geometry is invalid while the
//              child's geometry is valid? Do i still pass the request
//              draw to my parent?
//
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	5/05/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method /* void */
HTBoundedGlyphClass, RequestDrawFromChild // (HTGlyph *child, HTCoord absCoord)
{
    PARAM_ASSERT(child);
    
    optr /* HTGlyph * */ parent = @call self::GetParent();
    if (parent) {
        coord.x0 += _coord.x0;
        coord.y0 += _coord.y0;
        coord.x1 += _coord.x1;
        coord.y1 += _coord.y1;
        @call parent::RequestDrawFromChild(child, coord);
    }
}	/* End of HTBoundedGlyph::RequestDrawFromChild() */


//---------------------------------------------------------------------------
//		HTBoundedGlyph::SetBounds()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Set the bounds of a object.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/19/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTBoundedGlyphClass, SetBounds // (const HTCoord *bounds)
{
    PARAM_ASSERT(bounds);
    ASSERT(bounds->x0 >= 0);
    ASSERT(bounds->y0 >= 0);
    ASSERT(bounds->x1 >= 0);    
    ASSERT(bounds->y1 >= 0);

    _coord = *bounds;
    @call self::SetSizeValid(TRUE);
}	/* End of HTBoundedGlyph::SetBounds() */



//---------------------------------------------------------------------------
//		HTBoundedGlyph::GetBounds()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the bounds of a glyph.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/18/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTBoundedGlyphClass, GlyphGetBounds // (HTCoord *rect) const
{
    PARAM_ASSERT(bounds);
    *bounds = _coord;
}	/* End of HTBoundedGlyph::GetBounds() */


//---------------------------------------------------------------------------
//		HTBoundedGlyph::GetAbsoluteBounds()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the document bounds of a glyph.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin   	4/20/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method /* void  */
HTBoundedGlyphClass, GetAbsoluteBounds // (HTCoord *rect)
{
    optr /* HTGlyph * */ parent;
    HTCoord prect;

    *rect = _coord;
    parent = oself;

    while((parent = @call parent::GetParent())) {
        // Add the offset of the parent as going up the ui tree.
        @call parent::GlyphGetBounds(&prect);
        rect->x0 += prect.x0;
        rect->y0 += prect.y0;
        rect->x1 += prect.x0;
        rect->y1 += prect.y0;
    }

    return;
}


//---------------------------------------------------------------------------
//		HTBoundedGlyph::GetSize()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the width and height.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/31/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTBoundedGlyphClass, GetSize // (HTSize *size) const
{
    PARAM_ASSERT(size);
    size->width = _coord.x1 - _coord.x0;
    size->height = _coord.y1 - _coord.y0;
}	/* End of HTBoundedGlyph::GetSize() */


//---------------------------------------------------------------------------
//		HTBoundedGlyph::SetSize()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Change of the bounds to reflect the new size relative to 
//              position (0,0) and invalidates the geometry.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/31/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // inline void
HTBoundedGlyphClass, SetSize // (sword width, sword height)
{
    PARAM_ASSERT(width>=0);
    PARAM_ASSERT(height>=0);

    @call self::SetGeometryValid(FALSE);
    @call self::SetSizeValid(TRUE);
    
    _coord.x0 = 0;
    _coord.y0 = 0;
    _coord.x1 = width;
    _coord.y1 = height;
}	/* End of HTBoundedGlyph::SetSize() */


@method // sword
HTBoundedGlyphClass, GetWidth // () const 
{
    return (_coord.x1 - _coord.x0);
}


@method // sdword
HTBoundedGlyphClass, GetHeight // () const
{
    return (_coord.y1 - _coord.y0);
}


@method // Boolean
HTBoundedGlyphClass, HasSize // () const
{
    return ((_coord.y1 - _coord.y0 > 0) ||
        (_coord.x1 - _coord.x0 > 0) ? TRUE : FALSE);
}



//---------------------------------------------------------------------------
//		HTBoundedGlyph::Intersects()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Check to see a virtual window point intersects a glyph.
// SCOPE:	Public
// RETURN:	HTGLYPH_ABOVE_BOUNDS Glyph is above point.
//              HTGLYPH_IN_BOUNDS    Glyph overlaps with point.
//              HTGLYPH_BELOW_BOUNDS Glyph is below point.
//              HTGLYPH_OUT_BOUNDS   None of the above.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/18/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // HTGlyphBoundsCheck
HTBoundedGlyphClass, Intersects // (const HTPoint *point)
{
    PARAM_ASSERT(point);
    // The fastest way to check for intersection is to 
    // check for non-intersection.
    if (point->y < _coord.y0) {
        return HTGLYPH_BELOW_BOUNDS;
    } else if (point->y > _coord.y1) {
        return HTGLYPH_ABOVE_BOUNDS;
    } else if (point->x < _coord.x0 || point->x > _coord.x1) {
        return HTGLYPH_OUT_BOUNDS;
    }
    return HTGLYPH_IN_BOUNDS;
}	/* End of HTBoundedGlyph::Intersects() */


//---------------------------------------------------------------------------
//		HTBoundedGlyph::Overlap()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Check for overlapping.
// SCOPE:	Public
// RETURN:	HTGLYPH_IN_BOUNDS
//              HTGLYPH_ABOVE_BOUNDS
//              HTLGYPH_BELOW_BOUNDS
//              HTGLYPH_OUT_BOUNDS
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/19/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // HTGlyphBoundsCheck
HTBoundedGlyphClass, Overlap // (const HTOffsetAndSize *exposed)
{
    PARAM_ASSERT(exposed);

    // The following explains the algorithm, but implemented 
    // differently to make it efficient
#if 0
    // Normalize my coordinates by adding exposed offset.
    HTCoord myCoord = {_coord.x0 + exposed->offset.x,
                       _coord.y0 + exposed->offset.y,
                       _coord.x1 + exposed->offset.x,
                       _coord.y1 + exposed->offset.y};
    // The fastest way to check for overlapping is to eliminate
    // all non-overlapping cases.
    if (myCoord.y1 < 0 ||
        exposed->size.height < myCoord.y0 ||
        myCoord.x1 < 0 ||
        exposed->size.width < myCoord.x0) {
        // Fullfill all non-overlapping conditions
        return FALSE;
    }
    return TRUE;
#endif
     // This is the implementation 
    if (!_coord.y1 ||   // Zero height (size) 
        (_coord.y1 + exposed->offset.y <= 0)) {
        return HTGLYPH_ABOVE_BOUNDS;
    } else if ((exposed->size.height <= (_coord.y0 +
                                         exposed->offset.y))) {
        return HTGLYPH_BELOW_BOUNDS;
    } else if ((_coord.x1 + exposed->offset.x <= 0) ||
               (exposed->size.width <= (_coord.x0 +
                                        exposed->offset.x))) {
        // x0 and x1 can't tell us about whether one is above
        // or below another.
        return HTGLYPH_OUT_BOUNDS;
    }
    return HTGLYPH_IN_BOUNDS;
}	/* End of HTBoundedGlyph::Overlap() */


@method HTCompositeClass, HTComposite
{
    _firstChild = NULL;
    _lastChild  = NULL;
}


//---------------------------------------------------------------------------
//		HTComposite::~HTComposite()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Delete children.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/26/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method 
HTCompositeClass, MSG_META_FINAL_OBJ_FREE  // ::~HTComposite()
{
    optr /* HTGlyph * */ child, head = _firstChild;
    while (head) {
        if (head == oself) {
            // end of list
            break;
        }
        child = head;
        head = @call child::GetSiblingGlyph();
        @call child::MSG_META_OBJ_FREE();
    }
}	/* End of HTComposite::~HTComposite() */



//---------------------------------------------------------------------------
//		HTComposite::Draw()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Draw self and then draw children.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	context is optional. If no context, use default 
//              context.
//
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/18/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTCompositeClass, Draw /* (FlexPanel *panel, HTOffsetAndSize exposed, 
                  HTGlyphContext *context) */
{
    PARAM_ASSERT(panel);

    @call self::DrawSelf(panel, exposed, context);
    // Draw all its children
    optr /* HTGlyph * */ child = _firstChild;

     // Add my offset to the exposed region as all children
     // _coord are relative to the parent.
     //
    exposed.offset.x += _coord.x0;
    exposed.offset.y += _coord.y0;

    HTGlyphBoundsCheck boundsCheck;
    
    while (child) {
        if (@call child::IsGeometryValid() &&
            (boundsCheck = @call child::Overlap(&exposed)) ==
            HTGLYPH_IN_BOUNDS) {
            @call child::Draw(panel, exposed, context);
        } 
        // Note: This else statement causes some glyphs not 
        // to be drawn. So I commented it out -kkee.
        //
        // else if (boundsCheck == HTGLYPH_BELOW_BOUNDS) {
        // No need to check further as the rest of the glyphs
        // will be below the exposed region.
        // break;
        // }

        if (@call child::DoesPointToParent()) {
            ASSERTS(@call child::GetSiblingGlyph() == oself,
                    "HTComposite::Draw() sibling to parent linkage corrupted");
            break;
        }
        child = @call child::GetSiblingGlyph();

        ASSERTS(child != oself,
                 "HTComposite::Draw() sibling to parent linkage corrupted");
    }
}	/* End of HTComposite::Draw() */


//---------------------------------------------------------------------------
//		HTComposite::GetMinMaxWidth()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the min and max of the children of the
//              composite. The composite min and max is determined bu
//              its children glyphs.
// SCOPE:	Public
// RETURN:	TRUE if ok, FALSE otherwise.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	4/18/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTCompositeClass, GetMinMaxWidth // (MinMaxAccumulator *minmax)
{
    PARAM_ASSERT(minmax);
    optr /* HTGlyph * */ child = _firstChild;

    while (child) {
        if (!@call child::GetMinMaxWidth(minmax)) {
            return FALSE;
        }

        if (@call child::DoesPointToParent()) {
            ASSERTS(@call child::GetSiblingGlyph() == oself,
            "HTComposite::GetMinMaxWidth() parent linkage corrupted");
            break;
        }
        child = @call child::GetSiblingGlyph();

        ASSERTS(child != oself,
        "HTComposite::GetMinMaxWidth() parent linkage corrupted");
    }
    return TRUE;
}	/* End of HTComposite::GetMinMaxWidth() */


@method /* inline HTGlyph* */ HTCompositeClass, FirstChild // () const
{
    return _firstChild;
}

@method /* inline HTGlyph* */ HTCompositeClass, LastChild // () const
{
    return _lastChild;
}


//---------------------------------------------------------------------------
//		HTComposite::Append()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Add a child. This and Get() implements FIFO.
// SCOPE:	Public
// RETURN:	TRUE if ok, FALSE if out of memory.
// STRATEGY:	1. break link to parent
//              2. use the code WWList::Append()
//              3. Restore link to parent
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/18/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTCompositeClass, Append // (HTGlyph *glyph)
{
    PARAM_ASSERT(glyph != NULL);
    
    @call glyph::SetSiblingGlyph(NULL);

    // Break the last child link to parent
    if (_lastChild) {
        ASSERTS(@call _lastChild::GetSiblingGlyph() == oself,
                "HTComposite::Append() corrupted _sibling linkage");
        ASSERTS(@call _lastChild::DoesPointToParent() == 1,
                "HTComposite::Append() corrupted _sibling linkage");
        @call _lastChild::SetSiblingGlyph(NULL);
        @call _lastChild::SetPointToParent(0);
    }
    
    if (!_firstChild) {
        _firstChild = glyph;
        _lastChild = glyph;
    } else {
        @call _lastChild::SetSiblingGlyph(glyph);
        _lastChild = glyph;
    }

    // Restore last child link to parent
    if (_lastChild) {
        ASSERTS(@call _lastChild::GetSiblingGlyph() == NULL,
                "HTComposite::Append() sibling parent linkage corrupted");
        @call _lastChild::SetSiblingGlyph(oself);
        @call _lastChild::SetPointToParent(1);
    }

    return TRUE;
}	/* End of HTComposite::Append() */


//---------------------------------------------------------------------------
//		HTComposite::Get()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Remove the first child. This and Append() implements FIFO.
// SCOPE:	Public
// RETURN:	HTCompositeElement or NULL
// STRATEGY:	1. break link to parent
//              2. use the code WWList::Get()
//              3. Restore link to parent
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/28/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // HTGlyph*
HTCompositeClass, GlyphGet // ()
{
    optr /* HTGlyph * */ ret = _firstChild;

    if (!ret) {
        return NULL;
    }

    // Temporary break the link to parent to deal with a
    // null-terminated list
    if (_lastChild) {
        ASSERTS(@call _lastChild::GetSiblingGlyph() == oself,
                "HTComposite::Get() corrupted _sibling linkage");
        ASSERTS(@call _lastChild::DoesPointToParent() == 1,
                "HTComposite::Get() corrupted _sibling linkage");
        @call _lastChild::SetSiblingGlyph(NULL);
        @call _lastChild::SetPointToParent(0);
    }
    
    _firstChild = @call ret::GetSiblingGlyph();
    @call ret::SetSiblingGlyph(NULL);

    if (ret == _lastChild) {
        _lastChild = NULL;
    }

    // Restore the last child link to parent
    if (_lastChild) {
        ASSERTS(@call _lastChild::GetSiblingGlyph() == NULL,
                "HTComposite::Remove() sibling parent linkage corrupted");
        @call _lastChild::SetSiblingGlyph(oself);
        @call _lastChild::SetPointToParent(1);
    }
    
    return ret;
}	/* End of HTComposite::Get() */


//---------------------------------------------------------------------------
//		HTComposite::Remove()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Remove a child.
// SCOPE:	Public
// RETURN:	HTGlyph or NULL if glyph not a child.
// STRATEGY:	1. break link to parent
//              2. use the code WWList::Remove()
//              3. Restore link to parent
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	1/28/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // HTGlyph*
HTCompositeClass, GlyphRemove // (HTGlyph *glyph)
{
    optr /* HTGlyph * */ prev = NULL, tmp = _firstChild;

    // Temporarily break the lastChild's link to parent so that
    // we can search a NULL-terminated list.
    if (_lastChild) {
        ASSERTS(@call _lastChild::GetSiblingGlyph() == oself,
                "HTComposite::Remove() sibling parent linkage corrupted");
        ASSERTS(@call _lastChild::DoesPointToParent() == 1,
                "HTComposite::Remove() corrupted _sibling linkage");
        @call _lastChild::SetSiblingGlyph(NULL);
        @call _lastChild::SetPointToParent(0);
    }
    
    while (tmp) {
        if (tmp == glyph) {
            break;
        }
        prev = tmp;
        tmp = @call tmp::GetSiblingGlyph();
    }

    // There is a match
    if (tmp) {  
        if (tmp == _firstChild) {
            _firstChild = @call tmp::GetSiblingGlyph();
        }
        if (tmp == _lastChild) {
            _lastChild = prev;
        }
        if (prev) {
            optr temp = @call tmp::GetSiblingGlyph();
            @call prev::SetSiblingGlyph(temp);
        }
        @call tmp::SetSiblingGlyph(NULL);
    }

    // Restore link to parent
    if (_lastChild) {
        ASSERTS(@call _lastChild::GetSiblingGlyph() == NULL,
                "HTComposite::Remove() sibling parent linkage corrupted");
        @call _lastChild::SetSiblingGlyph(oself);
        @call _lastChild::SetPointToParent(1);
    }
    
    return tmp;
}	/* End of HTComposite::Remove() */


//---------------------------------------------------------------------------
//		HTComposite::HandleMouseEvent()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Pass the mouse event down to the ui object that is under the
//              mouse click.
// SCOPE:	Public
// RETURN:      TRUE if handled, FALSE otherwise.
// STRATEGY:
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	4/08/98 	Initial version 
//      kkee            4/15/98         Changed to return Boolean
//	
//---------------------------------------------------------------------------
@if 0
Boolean
HTComposite::HandleMouseEvent(MouseEvent & event, HTPoint point, 
                              HTFrame *frame)
{
    PARAM_ASSERT(frame);

    HTGlyph *child = _firstChild;

    // Add my offset to the exposed region as all children
    // _coord are relative to the parent.
    //
    point.x -= _coord.x0;
    point.y -= _coord.y0;

    HTGlyphBoundsCheck boundsCheck;
    
    while (child) {
        if (child->IsGeometryValid() &&
            (boundsCheck = child->Intersects(&point)) 
            == HTGLYPH_IN_BOUNDS) {
            if (child->HandleMouseEvent(event, point, frame)) {
                return TRUE;
            }
        }
        // Note: We could miss some glyphs that actually
        // overlap with the following else statement. So 
        // I commented it out -kkee
        //
        // else if (boundsCheck == HTGLYPH_BELOW_BOUNDS) {
        // Stop checking since none of the glyphs will
        // overlap the point as they are all below point.
        // return FALSE;
        // }
        
        if (child->_flags.pointToParent) {
            ASSERTS(child->_sibling == this,
            "HTComposite::HandleMouseEvent() parent linkage corrupted");
            break;
        }
        child = child->_sibling;

        ASSERTS(child != this,
        "HTComposite::HandleMouseEvent() parent linkage corrupted");
    }
    return FALSE;
}
@endif

//---------------------------------------------------------------------------
//		HTComposite::IsChild()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Check is a glyph is a direct or indirect child.
// SCOPE:	Public
// RETURN:	TRUE/FALSE
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	6/16/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTCompositeClass, IsChild // (HTGlyph *glyph)
{
    PARAM_ASSERT(glyph);

    optr /* HTGlyph * */ child = _firstChild;

    while (child) {
        if (glyph == child || @call self::IsChild(glyph)) {
            return TRUE;
        }

        if (@call child::DoesPointToParent()) {
            ASSERTS(@call child::GetSiblingGlyph() == oself,
                    "HTComposite::IsChild() sibling to parent linkage corrupted");
            break;
        }
        child = @call child::GetSiblingGlyph();

        ASSERTS(child != oself,
                 "HTComposite::IsChild() sibling to parent linkage corrupted");
    }
    return FALSE;
}	/* End of HTComposite::IsChild() */


