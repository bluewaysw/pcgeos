@method HTAnchoredLeafClass, HTAnchoredLeaf // ()
{
    _anchor = NULL;
}

@if 0
//---------------------------------------------------------------------------
//		HTAnchoredLeaf::HandleMouseEvent()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Handle the mouse event.
// SCOPE:	Public
// RETURN:	TRUE if the event is handled, else FALSE.
// STRATEGY:	If there is a link, go to the link.
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	4/12/98 	Initial version 
//	kkee    	4/15/98 	Moved to HTAnchoredLeaf so that not
//                                      all derived leaf objects need not
//                                      provide code to handle common events.
//  kkee        5/1/98      Child does not always exist.
//	
//---------------------------------------------------------------------------
Boolean
HTAnchoredLeaf::HandleMouseEvent(MouseEvent &event, HTPoint point, HTFrame *frame)
{
    USE_IT(event);
    USE_IT(point);
    
    if (_anchor /* && event._eventType == MOUSE_PRESSED */) {
        //
        // Hyperlink. Get the absolute URL and load that document.
        //
        WWMemHandle relUrlH = _anchor->GetHref();

        if (relUrlH) {
            // check to see if it's a reference to the current page
            char *ref = (char *)WWMemLock(relUrlH);
            if (ref[0] == '#') {
                HTMLAnchorItem *item;
                // scroll the document to the matching #NAME position.
                item = frame->FindNameAnchor(ref);
                if (item) {
                    HTCoord rect;
                    // Found a matching anchor object.
                    // Now Find the first child's coordinate.
                    HTGlyph *child = item->GetFirstChild();
                    if (child) {
                        // Possible not to have a child
                        child->GetAbsoluteBounds(&rect);
                        frame->DisplayPosition(&rect);
                    }
                }
                WWMemUnlock(relUrlH);
                return TRUE;
            }
            WWMemUnlock(relUrlH);
            //
            // Else, it's not a reference to the current page.
            //
            WWMemHandle baseUrlH = frame->GetBaseUrlH();
            if (!baseUrlH) {
                baseUrlH = frame->GetUrlH();
            }
            ASSERTS(baseUrlH != NULL, "HTFrame must have a url");

            char *url = WWParseURI(relUrlH, baseUrlH);
            if (!url) {
                return FALSE;
            }
            
            // Make a request for the URL document and target it 
            // to the viewer. We don't care if it fails to load.
            frame->GetURLNotify(url);

            free(url);

            return TRUE;
        }
    }
    return FALSE;
}	/* End of HTAnchoredLeaf::HandleMouseEvent() */
@endif


