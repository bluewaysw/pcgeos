/*---------------------------------------------------------------------------
//		HTMLViewer::GetBounds()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Get the position and size of the HTMLViewer.
// SCOPE:	Public
// RETURN:	(coordX, coordY) and width and height.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	4/10/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
@method /* void */
HTMLViewerClass, GetBounds /* (uint16 *coordX, uint16 *coordY, 
                      uint16 *width, uint16 *height) */
{
    PARAM_ASSERT(coordX);
    PARAM_ASSERT(coordY);
    PARAM_ASSERT(width);
    PARAM_ASSERT(height);
    *coordX = _xPos;
    *coordY = _yPos;
    *width  = _width;
    *height = _height;
}	/* End of HTGlyph::GetBounds() */


