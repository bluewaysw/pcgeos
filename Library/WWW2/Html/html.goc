#define _yPos       (pself->__yPos)
#define _width      (pself->__width)
#define _height     (pself->__height)

#define FRAME_NOT_YET_DEFINED 0
#define IMG_FRAME_NOT_YET_DEFINE 0

typedef struct arg { 
    HTRequest *req;
    optr  viewer;
    word  xPos;
    dword yPos;
    word  width;
    dword height;
    optr  *wwFrame
} Arg;

typedef struct htcoord
{
    word  x0;
    dword y0;
    word  x1;
    dword y1;
} HTCoord;

