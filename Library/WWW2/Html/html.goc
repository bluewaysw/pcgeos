CreateNewImgFrame(word hi, word lo);
#if 0
(optr /* HTRequest * */ req, optr /* HTMLViewer * */ viewer, 
                  HTCoord *coord, optr /* ImgFrame ** */ *newFrame);
#endif

/* Callback to UI thread to delete a WWFrame object.   */
