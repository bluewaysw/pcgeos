#endif
@endif



@method 
HTMLAnchorListClass, HTMLAnchorList // () 
{
    _anchorNameToBeViewed = NULL;
}


//---------------------------------------------------------------------------
//		HTMLAnchorList::!HTMLAnchorList()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	delete all anchor items in the list
// SCOPE:	public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	3/30/98     Initial version 
//	
//---------------------------------------------------------------------------
@method 
HTMLAnchorListClass, MSG_META_OBJ_FREE // ::~HTMLAnchorList()
{
    optr /* HTMLAnchorItem * */ item;
    while ((item = /* (HTMLAnchorItem *) */ @call self::Get()) != NULL) {
        @call item::MSG_META_OBJ_FREE();
    }
    if (_anchorNameToBeViewed) {
        WWMemFree(_anchorNameToBeViewed);
    }
}


//---------------------------------------------------------------------------
//		HTMLAnchorList::FindNameAnchor()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Find an anchor object whose NAME attribute matching the
//              passed name.
// SCOPE:	public
// RETURN:	HTMLAnchorItem * if found, NULL otherwise.
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	4/20/98     Initial version 
//	
//---------------------------------------------------------------------------
@method // HTMLAnchorItem* 
HTMLAnchorListClass, FindNameAnchor // (char * name)
{
    WWMemHandle nameH;
    optr /* HTMLAnchorItem * */ item = 
	/* (HTMLAnchorItem *) */ @call self::Head();

    ASSERTS(name[0] == '#', "The passed name char array is not #name");

    while (item) {
        nameH = @call item::GetName();
        if (nameH && WWStrCaseCmpWWMem(nameH, name+1) == 0) {
            return item;
        }
@if FRAME_NOT_YET_DEFINED
        item = /* (HTMLAnchorItem *) */ item->_next;
@else
        item = NULL;
@endif
    }
    return NULL;
}


//---------------------------------------------------------------------------
//		HTMLAnchorList::SetAnchorToBeViewed()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Store the anchor name that will be used to match any 
//              added element.  If a match is found in the Append method, 
//              it will be brought to the screen.
// SCOPE:	public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	4/21/98     Initial version 
//	
//---------------------------------------------------------------------------
@method // void 
HTMLAnchorListClass, SetAnchorToBeViewed // (WWMemHandle anchorName)
{
    if (_anchorNameToBeViewed) {
        WWMemFree(_anchorNameToBeViewed);
    }
    _anchorNameToBeViewed = anchorName;
}


//---------------------------------------------------------------------------
//		HTMLAnchorList::Append()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Append an element to the list. If it matches an existing
//              anchor name, bring the anchor object to the screen.
// SCOPE:	public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	4/21/98     Initial version 
//      kkee            5/1/98      Fix the case where anchor
//                                  does not have a child.
//	
//---------------------------------------------------------------------------
@method // void 
HTMLAnchorListClass, AnchorAppend // (WWListElement * element)
{
@if FRAME_NOT_YET_DEFINED
    WWList::Append(element);
@endif

    if (_anchorNameToBeViewed) {
        //  There is an existing anchor name for matching.
        WWMemHandle nameH;
        if ((nameH = @call /* (HTMLAnchorItem *) */ element::GetName())) {
            char *name = (char *)WWMemLock(nameH);
            if (name[0] == '#')
                name++;
            if (WWStrCaseCmpWWMem(_anchorNameToBeViewed, name) == 0) {
                // Found a matching anchor object!
                HTCoord rect;
                // Now Find the first child's coordinate.
                optr /* HTGlyph * */ child = @call /* (HTMLAnchorItem *) */ 
                                                   element::GetFirstChild();
                if (!child) {  // Always has a child - kkee??
                    WWMemUnlock(nameH);
                    return;
                }
                @call child::GetAbsoluteBounds(&rect);
                // Currently it's the parser thread call this method.
                // We need to let the ui thread to update the screen.
@if FRAME_NOT_YET_DEFINED
                _frame->DisplayPositionOnUIThread(&rect);
@endif
                // A match has been found.  Delete the _anchorNameToBeViewed
                WWMemFree(_anchorNameToBeViewed);
                _anchorNameToBeViewed = NULL;
            }
            WWMemUnlock(nameH);
        }
    }
}


@method //    void 
HTMLAnchorListClass, SetFrame // (HTFrame *frame)
{
    _frame = frame;
}

