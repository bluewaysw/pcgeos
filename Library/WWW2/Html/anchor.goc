// @include "htfmtter.h"
@include "WWW2/Conv/htframe.goh"
@include "WWW2/Conv/anchor.goh"
#include "WWW2/wwMacro.h"

@classdecl HTMLAnchorListClass, neverSaved;
@classdecl HTMLAnchorItemClass, neverSaved;

@extern method HTMLAnchorItemClass, GetIdentity;
@extern method HTMLAnchorItemClass, Format;

@define FRAME_NOT_YET_DEFINED 0

#define _href       (pself->__href)
#define _name       (pself->__name)
#define _target     (pself->__target)
#define _title      (pself->__title)
#define _firstChild (pself->___firstChild)
#define _anchorNameToBeViewed (pself->__anchorNameToBeViewed)
#define _frame      (pself->__frame)


//---------------------------------------------------------------------------
//		HTMLAnchorItem::HTMLAnchorItem()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	create an anchor item and null its instance data.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	3/30/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method HTMLAnchorItemClass, HTMLAnchorItem /* () : _href(NULL), _name(NULL),
    _target(NULL), _title(NULL), _firstChild(NULL) */
{
    _href = NULL;
    _name = NULL;
    _target = NULL;
    _title = NULL;
    _firstChild = NULL;
}

//---------------------------------------------------------------------------
//		HTMLAnchorItem::~HTMLAnchorItem()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	de-allocate its instance data.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	3/30/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method HTMLAnchorItemClass, MSG_META_OBJ_FREE // ::~HTMLAnchorItem()
{
    if (_href) {
        WWMemFree(_href);
    }
    if (_name) {
        WWMemFree(_name);
    }
    if (_target) {
        WWMemFree(_target);
    }
    if (_title) {
        WWMemFree(_title);
    }
    return;
}

//---------------------------------------------------------------------------
//		HTMLAnchorItem::ParseAttrs()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Parse the attribute list to initialize instance data.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	edwin    	3/30/98 	Initial version 
//      kkee            4/14/98         Free _href etc if non-NULL.
//	
//---------------------------------------------------------------------------
@method // Boolean 
HTMLAnchorItemClass, ParseAttrs // (const SGMLEntity entity [ ])
{
    Boolean done = FALSE;
    byte i = 0;

    while (!done) {
        switch (entity[i].SGMLE_token) {
         case HTML_ATTR_HREF:
            if (_href) {
                WWMemFree(_href);
            }
            _href = WWStrAllocCopy((const char *)entity[i].SGMLE_value);
            break;
         case HTML_ATTR_NAME:
            if (_name) {
                WWMemFree(_name);
            }
            _name = WWStrAllocCopy((const char *)entity[i].SGMLE_value);
            break;
         case HTML_ATTR_TARGET:
            if (_target) {
                WWMemFree(_target);
            }
            _target = WWStrAllocCopy((const char *)entity[i].SGMLE_value);
            break;
         case HTML_ATTR_TITLE:
            if (_title) {
                WWMemFree(_title);
            }
            _title = WWStrAllocCopy((const char *)entity[i].SGMLE_value);
            break;
         case HTML_ATTR_XXX_INVALID:
            done = TRUE;
            break;
         default:
            break;
        }
        i++;
    }

    return TRUE;
}


@method HTMLAnchorItemClass, GetHref
{ 
    return _href; 
}

@method // WWMemHandle 
HTMLAnchorItemClass, GetName // () 
{ 
    return _name; 
}


@method // WWMemHandle 
HTMLAnchorItemClass, AnchorGetTarget // () 
{ 
    return _target;
}


@method // WWMemHandle 
HTMLAnchorItemClass, GetTitle // ()
{ 
    return _title;
}


@method // void 
HTMLAnchorItemClass, SetFirstChild // (HTGlyph *child)
{
    _firstChild = child;
}


@method // HTGlyph* 
HTMLAnchorItemClass, GetFirstChild // ()
{
    return _firstChild;
}


@method // virtual HTMLToken 
HTMLAnchorItemClass, GetIdentity // ()
{ 
    return HTMLT_A;
}




//---------------------------------------------------------------------------
//		HTMLAnchorItem::Format()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Format the anchor object.
// SCOPE:	Public
// RETURN:	TRUE if ok, FALSE if out of memory
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	3/30/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTMLAnchorItemClass, Format // (HTFormat *formatter)
{
    PARAM_ASSERT(formatter);
@if FRAME_NOT_YET_DEFINED
    return @call formatter::FormatHTAnchor(this);
@else
    return FALSE;
@endif
}	/* End of HTMLAnchorItem::Format() */


@if 0
#ifdef ERROR_CHECK
//---------------------------------------------------------------------------
