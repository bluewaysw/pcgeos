//---------------------------------------------------------------------------
//		HTMLFrame::HTMLFrame()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Constructor.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:	Initialize the frame.
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	mzhu    	2/13/98 	Initial version
//	kkee    	3/18/98 	Moved from HTMLFrame to HTFrame
//
//---------------------------------------------------------------------------
@method HTFrameClass, HTFrame /* (HTRequestManager *reqManager, WWMemHandle urlH,
                 uint16 x, uint16 y, uint16 width, uint16 height) : */
{
    PARAM_ASSERT(reqManager);

    _reqManager = reqManager;
    _uitree = 0;
    _compositeTargetList = NULL;
    _compositor = 0;
    _formatContext = 0;
    _preformatContext = 0;
    _finishFormat = FALSE;
    _needToReformat = FALSE;
    _formatSem = ThreadAllocSem(1);
    _noSizeGlyph = 0;
    _noSizeGlyphSem = ThreadAllocSem(1);
    _currentForm = 0;
    _glyphContext = 0;
    _progressiveDisplay = TRUE;
    _title = NULL;
    _urlH = urlH;
    _baseUrlH = NULL;
    _panel = 0;
    _dummy = 0;
    _outerPanel = 0;
    _vScrollbar = 0;
    _hScrollbar = 0;
    _ignoreLWS  = TRUE;
@if NOT_DEFINED_YET
    _baseTextState(HTDEFAULT_FONT_SIZE, TID_DEFAULT, RGB_BLACK, 0, 0, 0, 0);
@endif

    _exposed.offset.x = coordX;
    _exposed.offset.y = coordY;
    _exposed.size.width = width;
    _exposed.size.height = height;

    _tableCorrection.nestingLevel = 0;

    _textTargetList = ObjInstantiate(HandleOf(oself), &WWListClass);
    @call _textTargetList::WWList();
    _composition = ObjInstantiate(HandleOf(oself), &HTCompositionClass);
    @call _composition::HTComposition();
    _anchorList = ObjInstantiate(HandleOf(oself), &HTMLAnchorListClass);
    @call _anchorList::HTMLAnchorList();
    _mapList = ObjInstantiate(HandleOf(oself), &HTMapListClass);
    @call _mapList::WWList(); // HTMapList();
    _formList = ObjInstantiate(HandleOf(oself), &WWListClass);
    @call _formList::WWList();

@if NOT_DEFINED_YET
#ifdef GR_NATIVE16
    _backgroundImage = 0;
    _bgColor = HTDEFAULT_BGCOLOR;
    _linkColor = HTDEFAULT_LINKCOLOR;
#endif

#ifdef ERROR_CHECK
    _initialized = FALSE;
//    _uitreeFile = NULL;
#endif
#ifdef EC_LOG
   _logFile = theFileStoreManager.Open(LOGFILE, O_CREAT | O_RDWR);
   if (!_logFile) {
       EC_WARN("HTFrame::HTFrame() unable to create log file");
   } else {
       // Truncate the file to zero length
       _logFile->LSeek(0,0);
       _logFile->SetSize(0);
   }
#endif
@endif
}	/* End of HTFrame::HTFrame() */


//---------------------------------------------------------------------------
//		HTFrame::~HTFrame()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Destructor
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	mzhu    	2/13/98 	Initial version
//	kkee    	3/18/98 	Moved from HTFrame to HTFrame
//
//---------------------------------------------------------------------------
@method HTFrameClass, MSG_META_OBJ_FREE // ::~HTFrame()
{
@if NOT_DEFINED_YET
    // When _title goes away, we will see garbage on the title bar,
    // so before we delete, set the title bar to empty.
    if (_reqManager) {
        _reqManager->GetFlexFrame()->SetTitle(_TEXT(""));
    }
    delete [] _title;
    if(_urlH) WWMemFree(_urlH);
    if(_baseUrlH) WWMemFree(_baseUrlH);

    // Order of delete is important, must delete form stuff and uitree
    // first before deleting _panel. This is because the parent
    // of form stuff and _uitree is _panel.
    HTForm *form;
    while ((form = (HTForm*)_formList.Get()) != NULL) {
        delete form;
    }
    delete _glyphContext;
    delete _compositor;
    delete _compositeTargetList;
    delete _formatContext;
    delete _preformatContext;
    // Must be the last to be deleted as other deletions
    // depend on it to exist
    delete _uitree;

    // Remove from the listener list.
    _vScrollbar->RemoveAdjustmentListener(*this);
    _hScrollbar->RemoveAdjustmentListener(*this);
    (_reqManager->GetAppBase())->RemoveKeyListener(*this);
    //(_reqManager->GetAppBase())->RemoveMouseListener(*this);
    _dummy->RemoveMouseListener(*this);

    _outerPanel->Remove(_hScrollbar);
    delete _hScrollbar;
    _outerPanel->Remove(_vScrollbar);
    delete _vScrollbar;
    _outerPanel->Remove(_panel);
    delete _panel;
    (_reqManager->GetFlexFrame())->Remove(_outerPanel);
    delete _outerPanel;

    // this line provent the new page is not off the right position!!!
    (_reqManager->GetAppBase())->Invalidate();

#ifdef GR_NATIVE16
    if(_backgroundImage)
        delete _backgroundImage;
#endif

#ifdef EC_LOG
    if (_logFile) {
        // No need to delete file created by theFileStoreManager
        _logFile->Close();
    }
#endif

@endif
    @callsuper();
}


//---------------------------------------------------------------------------
//		HTFrame::Initialize()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Initialize a frame. It is illegal to call Initialize()
//              more than once.
// SCOPE:	Public
// RETURN:	TRUE if init ok, else FALSE for out of memory.
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	mzhu    	2/17/98 	Initial version
//      kkee            3/19/98         Moved from frame.cpp to here.
//
//---------------------------------------------------------------------------
@method // Boolean
HTFrameClass, FrameInitialize // ()
{
    ASSERTS(_initialized == FALSE,
            "HTFrame::Initialize() called more than once");

    // Create a composite target list
    _compositeTargetList = ObjInstantiate(HandleOf(oself), 
					  &CompositeTargetListClass);
    @call _compositeTargetList::CompositeTargetList(oself);

    if (!_compositeTargetList || 
        !@call _compositeTargetList::SetCurrentCompositeTarget(_composition)) 
    {
        return FALSE;
    }
@if NOT_DEFINED_YET
    // Create a UI tree
    _uitree = new HTUITree(this);
    if (!_uitree) {
        return FALSE;
    }

    // Panel for drawing anything.
    _panel = new FlexPanel();
    if(!_panel) {
        return FALSE;
    }
    _outerPanel = new FlexPanel();
    if(!_outerPanel) {
        delete _panel;
        return FALSE;
    }

    // Initialize the anchor name
    char *anchor = WWParseURI(_urlH, NULL, WWURI_PARSE_ANCHOR);
    if (anchor) {
        _anchorList.SetAnchorToBeViewed(WWStrAllocCopy(anchor));
        free(anchor);
    }

    // Set panel
    //_outerPanel->SetBackground(RGB_WHITE);
    //_panel->SetBackground(RGB_WHITE);
    _outerPanel->SetBounds(_exposed.offset.x, _exposed.offset.y,
                           _exposed.size.width, _exposed.size.height);
    (_reqManager->GetFlexFrame())->Add(_outerPanel);
    _outerPanel->Add(_panel);
    // make room for the vertical bar.
    _exposed.size.width -= HT_SCROLLBAR_WIDTH;
    _exposed.size.height -= HT_SCROLLBAR_HEIGHT;
    _panel->SetBounds(0,0, _exposed.size.width, _exposed.size.height);

    // make a penel for horizontal scrollbar
    // Create scrollbars
    _vScrollbar = theUIFactory->CreateFlexScrollbar(HINT_SCROLLBAR_LOOK);
    _hScrollbar = theUIFactory->CreateFlexScrollbar(HINT_SCROLLBAR_LOOK);
    if(!_vScrollbar || !_hScrollbar) {
        return FALSE;
    }
    _vScrollbar->SetValue(0);
    _vScrollbar->SetMinimum(0);
    _vScrollbar->SetMaximum(_exposed.size.height);
    _vScrollbar->SetVisibleAmount(_exposed.size.height);
    _vScrollbar->SetUnitIncrement(HT_SCROLLING_INCREMENT_UNIT);
    _vScrollbar->SetBlockIncrement(
        _exposed.size.height-HT_SCROLLING_INCREMENT_UNIT*2);
    _vScrollbar->SetBounds(_exposed.size.width, 0,
                           HT_SCROLLBAR_WIDTH, _exposed.size.height);
    //_vScrollbar->SetID();
    _outerPanel->Add(_vScrollbar);

    _hScrollbar->SetValue(0);
    _hScrollbar->SetMinimum(0);
    _hScrollbar->SetMaximum(_exposed.size.width);
    _hScrollbar->SetVisibleAmount(_exposed.size.width);
    _hScrollbar->SetUnitIncrement(HT_SCROLLING_INCREMENT_UNIT);
    _hScrollbar->SetOrientation(FlexScrollbar::SOT_HORIZONTAL);
    _hScrollbar->SetBlockIncrement(
        _exposed.size.width-HT_SCROLLING_INCREMENT_UNIT*2);
    _hScrollbar->SetBounds(0, _exposed.size.height,
                           _exposed.size.width, HT_SCROLLBAR_HEIGHT);
    //_hScrollbar->SetID();
    _outerPanel->Add(_hScrollbar);

    // Add listeners
    _vScrollbar->AddAdjustmentListener(*this);
    _hScrollbar->AddAdjustmentListener(*this);
    //XXX this looks odd --hlee
    (_reqManager->GetAppBase())->AddKeyListener(*this);

    //We don't want the system to do any geometry work
    //_outerPanel->SetGeometryValid(FALSE);
    //_panel->SetGeometryValid(FALSE);

    //add the dummy FlexComp
    _dummy = new DummyUI(this);
    if (!_dummy) {
        return FALSE;
    }
    _panel->Add(_dummy);
    _dummy->SetBounds(0, 0, _exposed.size.width, _exposed.size.height);
    _dummy->AddMouseListener(*this);

    //create drawing context
    _glyphContext = new HTGlyphContext();
    if (!_glyphContext) {
        return FALSE;
    }

    // Set the window coordinates to that of the physical window,
    // that is, the currently exposed part of the document.
    // Save space for the v-scrollbar
    _exposed.offset.x = 0;        // _panel is referenced from (0,0)
    _exposed.offset.y = 0;

#ifdef ERROR_CHECK
    _initialized = TRUE;
#endif

    // Set the frame in the anchor list.
    _anchorList.SetFrame(this);

    // Create a compositor
    _compositor = new HTFormatter();
    if (!_compositor) {
        return FALSE;
    }
    _formatContext = new HTFormatContext(HTALIGN_LEFT);
    if (!_formatContext) {
        return FALSE;
    }
    _preformatContext = new HTPreformatContext(this);
    if (!_preformatContext) {
        return FALSE;
    }

    return @call _compositor::SetComposition(oself, _composition, _uitree,
                                       _exposed.size.width, _formatContext);
@else
    return NULL;
@endif
}	/* End of HTFrame::Initialize() */


//---------------------------------------------------------------------------
//		HTFrame::GetURL()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	
// SCOPE:	
// RETURN:	
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	7/22/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTFrameClass, HTFrameGetURL /* (const char *url,
                HTMLViewer::LoadMode loadMode,
                RequestResponse *target) */
{
    // We have to Inc first before submitting as we could
    // get Request::Done() while running GetURL()
    @call self::WWFrameIncNumRequest();
    if (@call _reqManager::ReqMgrGetURL(url, loadMode, target)) {
        @call self::WWFrameDecNumRequest();
    }
}	/* End of HTFrame::GetURL() */


//---------------------------------------------------------------------------
//		HTFrame::GetURLNotify()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	
// SCOPE:	
// RETURN:	
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	7/22/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTFrameClass, HTFrameGetURLNotify /* (const char *url,
                      HTMLViewer::LoadMode loadMode,
                      RequestResponse *target) */
{
    // We have to Inc first before submitting as we could
    // get Request::Done() while running GetURL()
    @call self::WWFrameIncNumRequest();
    if (!(@call _reqManager::GetURLNotify(url, loadMode, target))) {
        @call self::WWFrameDecNumRequest();
    }
}	/* End of HTFrame::GetURLNotify() */



//---------------------------------------------------------------------------
//		HTFrame::PostURL()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	
// SCOPE:	
// RETURN:	
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	7/22/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTFrameClass, HTFramePostURL
 /* (const char *url,
                    const uint8 *buffer,
                    const uint32 len,
                    Boolean file) */
{
    // We have to Inc first before submitting as we could
    // get Request::Done() while running GetURL()
    @call self::WWFrameIncNumRequest();
    if (!(@call _reqManager::ReqMgrPostURL(url, buffer, len, file))) {
        @call self::WWFrameDecNumRequest();
    }
}	/* End of HTFrame::PostURL() */

