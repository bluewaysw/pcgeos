@method // inline Boolean
HTFrameClass, OkToFormat // () 
{
    // Allow format if we are appending to the root composition, 
    // otherwise let other composites decide when they want to 
    // format. Also make sure all the glyphs have a size to avoid
    // unnecessary reformat.
#if 0
    return ((IsCompositionTarget() && (GetNumNoSizeGlyph()==0)) ? 
        TRUE:FALSE);
#else 
    return ((@call self::IsCompositionTarget()) ? TRUE:FALSE);
#endif
}



