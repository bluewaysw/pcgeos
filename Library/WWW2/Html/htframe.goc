//---------------------------------------------------------------------------
//		HTFrame::DisplayPositionOnUIThread()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Append a message on the ui thread to scroll the document to
//              bring the passed coordinate to the screen.
// SCOPE:	Public
// RETURN:
// STRATEGY:    Also see DisplayAnchorPosition.
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	edwin     	4/20/98 	Initial version
//
//---------------------------------------------------------------------------
@method // void 
HTFrameClass, DisplayPositionOnUIThread // (HTCoord * rect)
{
@if NOT_DEFINED_YET
    // Call UI thread to display
    ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
        ((QueuedFunction) DisplayAnchorPosition,
         (MessageArg) _vScrollbar, (MessageArg) rect->x0, (MessageArg) rect->y0);
@endif
}


//---------------------------------------------------------------------------
//		DisplayAnchorPosition()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Callback routine by DisplayPositionOnUIThread handler.
//              Scroll the document to bring up the specified coordinate,
//              like DisplayPosition method.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	edwin     	4/20/98 	Initial version
//
//---------------------------------------------------------------------------
static void
DisplayAnchorPosition(optr /* FlexScrollbar * */ scrollbar, sword x, sdword y)
{
@if NOT_DEFINED_YET
    USE_IT(x);

    int32 visible = scrollbar->GetVisibleAmount();
    int32 max = scrollbar->GetMaximum();

    if (visible + y > max) {
        // If the desired position is beyond the current scroller's range,
        // increase that range by setting a new max value.
        scrollbar->SetMaximum(visible + y);
    }

    scrollbar->SetValue(y);
@endif
}	/* End of DrawHTFrame() */


//---------------------------------------------------------------------------
//		AdjustScrollers()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	For Callback to uithread.
