//---------------------------------------------------------------------------
//		HTFrame::ECPrintUITree()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Print UITree for debugging purposes.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	4/02/98 	Initial version
//
//---------------------------------------------------------------------------
@if 0
#ifdef ERROR_CHECK
void
HTFrame::ECPrintUITree()
{
    _uitreeFile = theFileStoreManager.Open(UITREEFILE, O_CREAT | O_RDWR);
    if (!_uitreeFile) {
       EC_WARN("HTFrame::HTFrame() unable to create uitree file");
    }
    if (_uitreeFile) {
        char preamble[256];
        preamble[0] = 0;   // Null-terminate this string.

        _uitreeFile->LSeek(0,0);
        _uitreeFile->SetSize(0);   // Truncate all data

        _uitree->ECPrintSelf(_uitreeFile, preamble);
        _uitreeFile->Close();
    }
}	/* End of HTFrame::ECPrintUITree() */
#endif
@endif


