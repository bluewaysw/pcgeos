@method // inline void
HTFrameClass, IncNoSizeGlyph // ()
{
    ThreadPSem(_noSizeGlyphSem);
    _noSizeGlyph += 1;
    ThreadVSem(_noSizeGlyphSem);
}


@method // inline void
HTFrameClass, DecNoSizeGlyph // ()
{
    ThreadPSem(_noSizeGlyphSem);
    _noSizeGlyph -= 1;
    ASSERT(_noSizeGlyph >= 0);
    ThreadVSem(_noSizeGlyphSem);
}


@method // inline int16
HTFrameClass, GetNumNoSizeGlyph // ()
{
    ThreadPSem(_noSizeGlyphSem);
    sword ret = _noSizeGlyph;
    ThreadVSem(_noSizeGlyphSem);
    return ret;
}


