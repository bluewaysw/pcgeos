//---------------------------------------------------------------------------
//		HTFrame::Reformat()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Reformat the page. Grabs format semapore.
// SCOPE:	Private
// RETURN:	TRUE/FALSE
// STRATEGY:	Reformat if the document is completely formatted,
//              otherwise delay reformat until we are done formatting.
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	6/16/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTFrameClass, Reformat // ()
{
    ThreadPSem(_formatSem);
    if (_finishFormat) {
        @call self::ReformatLow();
    } else {
        _needToReformat = TRUE;
    }
    ThreadVSem(_formatSem);
    return TRUE;
}	/* End of HTFrame::Reformat() */


//---------------------------------------------------------------------------
//		HTFrame::ReformatLow()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Reformat the page. Assumes format semaphore is grabbed.
// SCOPE:	Private
// RETURN:	TRUE/FALSE
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	6/16/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // Boolean
HTFrameClass, ReformatLow // ()
{
    optr /* HTUITree * */ oldUITree = _uitree;

@if NOT_DEFINED_YET
    _uitree = new HTUITree(this);
    if (!_uitree) {
        _uitree = oldUITree;
        return FALSE;
    }

    // Create a new compositor
    delete _compositor;
    _compositor = new HTFormatter();
    if (!_compositor) {
        return FALSE;
    }
    delete _formatContext;
    _formatContext = new HTFormatContext(HTALIGN_LEFT);
    if (!_formatContext) {
        return FALSE;
    }

    if (_compositor->SetComposition(this, oldUITree, _uitree,
                                    _exposed.size.width, _formatContext)) 
    {
        // Reformat now.
#ifdef ERROR_CHECK
        _compositor->ComposeEC();
#else 
        _compositor->Compose();
#endif
        _compositor->Done();
    }
    delete oldUITree;

    // Call UI thread to draw
    ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
        ((QueuedFunction) DrawHTFrame,
         (MessageArg) this);
@endif
    return TRUE;
}	/* End of HTFrame::ReformatLow() */


//---------------------------------------------------------------------------
//		HTFrame::IsCompositionTarget()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Check to see if _composition is the current composite target.
// SCOPE:	Private
// RETURN:	TRUE if HTFrame is the current composite target, else FALSE.
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	3/27/98 	Initial version
//
//---------------------------------------------------------------------------
//inline Boolean
@method
HTFrameClass, IsCompositionTarget // ()
{
    return (@call _compositeTargetList::GetCurrentCompositeTarget() 
        == _composition ? TRUE : FALSE);
}	
/* End of HTFrame::IsCompositionTarget() */



//---------------------------------------------------------------------------
//		DrawHTFrame()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Procedural call to draw a uitree. Provided so that
//              non-UI thread can call UI thread to draw.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	3/25/98 	Initial version
//
//---------------------------------------------------------------------------
static void
DrawHTFrame(optr /* HTFrame * */ frame)
{
    PARAM_ASSERT(frame);
    @call frame::DrawFrame();
}	/* End of DrawHTFrame() */


//---------------------------------------------------------------------------
//		DrawHTGlyph()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Procedural call to draw a htglyph. Provided so that
//              non-UI thread can call UI thread to draw.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	5/06/98 	Initial version
//
//---------------------------------------------------------------------------
static void
DrawHTGlyph(optr /* HTFrame * */ frame, optr /* HTGlyph * */ glyph, 
	    sword x0, sdword y0, sword x1, sdword y1)
{
    PARAM_ASSERT(frame);
    PARAM_ASSERT(glyph);
    HTCoord absCoord;
    absCoord.x0 = x0;
    absCoord.y0 = y0;
    absCoord.x1 = x1;
    absCoord.y1 = y1;
    @call frame::DrawGlyph(glyph, &absCoord);
}	/* End of DrawHTGlyph() */

