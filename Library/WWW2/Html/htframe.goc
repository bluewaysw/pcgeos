@method //    HTMLAnchorList *
HTFrameClass, GetAnchorList // () 
{
    return _anchorList;
}



//---------------------------------------------------------------------------
//		HTFrame::Done()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	We are done receiving all HTML tokens and
//              data. Cleanup unnecessary data that was allocated
//              during the formatting process.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	3/25/98 	Initial version
//
//---------------------------------------------------------------------------
@method // void
HTFrameClass, HTFrameDone // ()
{
    // Format whatever leftover glyphs not formatted.
    ThreadPSem(_formatSem);

@if NOT_DEFINED_YET

#ifdef ERROR_CHECK
    @call _compositor::ComposeEC();
#else
    @call _compositor::Compose();
#endif
    @call _compositor::HTFormatDone();

    // Call UI thread to draw
    ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
        ((QueuedFunction) DrawHTFrame,
         (MessageArg) this);
@endif

    // In case we need to reformat the uitree
    _finishFormat = TRUE;
    if (_needToReformat) {
        @call self::ReformatLow();
    }
    ThreadVSem(_formatSem);
}	/* End of HTFrame::Done() */


//---------------------------------------------------------------------------
//		HTFrame::SetBounds()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	In addition to setting the frame bounds, we need to
//              resize the frame scrollbar.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:    Update scrollbars.
//              Progressive display if we are within the exposed
//              region and also when we first get out of bounds.
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	3/24/98 	Initial version
//
//---------------------------------------------------------------------------
@method // void
HTFrameClass, HTFrameSetBounds // (const HTCoord *bounds)
{
@if NOT_DEFINED_YET
    sdword vmax = _vScrollbar->GetMaximum();
    sdword hmax = _hScrollbar->GetMaximum();

    if (bounds->y1 > vmax && bounds->x1 > hmax) {
        // New virtual document size after formatting
        ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
            ((QueuedFunction) AdjustScrollers,
            (MessageArg) _vScrollbar,
            (MessageArg) bounds->y1,
            (MessageArg) _hScrollbar,
            (MessageArg) bounds->x1);
    } else if (bounds->y1 > vmax) {
        ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
            ((QueuedFunction) AdjustOneScroller,
            (MessageArg) _vScrollbar,
            (MessageArg) bounds->y1);
    } else if (bounds->x1 > hmax) {
        ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
            ((QueuedFunction) AdjustOneScroller,
            (MessageArg) _hScrollbar,
            (MessageArg) bounds->x1);
    }

    if (bounds->y1 > vmax || bounds->x1 > hmax) {
        // Call UI thread to refresh scroller
        ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
            ((QueuedFunction) RepaintScrollers,
            (MessageArg) _vScrollbar,
            (MessageArg) _hScrollbar);
    }

    if (_progressiveDisplay && bounds->y1 > _exposed.size.height) {
        _progressiveDisplay = FALSE;
#if 0
        // Call UI thread to draw
        ((_reqManager->GetAppBase())->GetMessageQueue())->QueuedFunctionCall
            ((QueuedFunction) DrawHTFrame,
            (MessageArg) this);
#endif
    }
@endif
}	/* End of HTFrame::SetBounds() */


//---------------------------------------------------------------------------
//		HTFrame::Draw()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Draw frame. Clear screen as Frame is the top-level
//              window.
// SCOPE:	Protected.
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	3/24/98 	Initial version
//
//---------------------------------------------------------------------------
@method // void
HTFrameClass, DrawFrame // ()
{
@if NOT_DEFINED_YET

    ASSERTS(_initialized == TRUE,
            "HTFrame::Draw() Initialize() was not called");

    AppBase::SetFocus(NULL);
    // Clean the old drawing ontext.
    _glyphContext->Clean();

    //draw background color or clean the screen
    _panel->FillRect(0,
                     0,
                     _exposed.size.width,
                     _exposed.size.height,
#ifdef GR_NATIVE16
                     _bgColor
#else
                     RGB_WHITE
#endif
                     );

#ifdef GR_NATIVE16
    //draw background image here
    if(_backgroundImage)
        _backgroundImage->Draw(_panel, _exposed, _glyphContext);
#endif

    // this time we need to draw Flex stuff
    _glyphContext->SetDrawFlexFlag(TRUE);

    // this doesnt mean we wont draw text this time, it will affect the next
    // DrawText function. As we draw text here, we don't want draw it again.
    // _glyphContext->SetDrawTextFlag(FALSE);

    _uitree->Draw(_panel, _exposed, _glyphContext);

    _glyphContext->SetDrawTextFlag(TRUE);
@endif
}	/* End of HTFrame::Draw() */

//---------------------------------------------------------------------------
//		HTFrame::DrawText()
//---------------------------------------------------------------------------
// 
// SYNOPSIS:   Draw text only. 	
// SCOPE:      Public
// RETURN:     Nothing
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	mzhu    	5/08/98 	Initial version 
//	
//---------------------------------------------------------------------------
@method // void
HTFrameClass, DrawText // ()
{
    ASSERTS(_initialized == TRUE,
            "HTFrame::Draw() Initialize() was not called");

@if NOT_DEFINED_YET

    if(@call _glyphContext::GetDrawTextFlag()) {
        @call _panel::FillRect(0, 0, _exposed.size.width,
                        _exposed.size.height, 
#ifdef GR_NATIVE16
                        _bgColor
#else
                        RGB_WHITE
#endif
                        );

#ifdef GR_NATIVE16
        //draw background image here
        if(_backgroundImage)
            @call _backgroundImage::Draw(_panel, _exposed, _glyphContext);
#endif

        @call _glyphContext::SetDrawFlexFlag(FALSE);
        @call _uitree::UITreeDraw(_panel, _exposed, _glyphContext);
    }
@endif

}	/* End of HTFrame::DrawText() */


//---------------------------------------------------------------------------
//		HTFrame::Draw()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Draw a HTGlyph given its absolute coords.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
//	kkee    	5/06/98 	Initial version
//
//---------------------------------------------------------------------------
@method // void
HTFrameClass, DrawGlyph // (HTGlyph *glyph, const HTCoord *absCoord)
{
    HTOffsetAndSize exposed;
    exposed.offset.x = absCoord->x0 + _exposed.offset.x;
    exposed.offset.y = absCoord->y0 + _exposed.offset.y;
    exposed.size.width = _exposed.size.width;
    exposed.size.height = _exposed.size.height;
    if (@call glyph::Overlap(&exposed) == HTGLYPH_IN_BOUNDS) {
#if 0
        @call glyph::Draw(_panel, exposed, _glyphContext);
#else 
        // Try drawing the whole frame to improve perceived performance.
    	@call self::DrawFrame();
#endif
    }
}	/* End of HTFrame::Draw() */


//---------------------------------------------------------------------------
//		HTFrame::RequestDraw()
//---------------------------------------------------------------------------
//
// SYNOPSIS: 	Accept a request to draw from a glyph in the uitree.
// SCOPE:	Public
// RETURN:	Nothing
// STRATEGY:
//
// REVISION HISTORY:
//	Name		Date		Description
//	----		----		-----------
