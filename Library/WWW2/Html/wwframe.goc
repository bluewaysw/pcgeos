// #include <system.h>
// #include "wwframe.h"

@include "WWW2/Conv/wwframe.goh"

#define _sem        (pself->__sem)
#define _numRequest (pself->__numRequest)


@classdecl WWFrameClass, neverSaved;


@method 
WWFrameClass, WWFrame // () : 
{
    _sem = ThreadAllocSem(1);
    _numRequest = ThreadAllocSem(0);
}


@method // inline void
WWFrameClass, WWFrameIncNumRequest // () 
{
    ThreadPSem(_sem);
    _numRequest++;
    ThreadVSem(_sem);
}


@method // inline void
WWFrameClass, WWFrameDecNumRequest // ()
{
    ThreadPSem(_sem);
    if (_numRequest) _numRequest--;
    Boolean done = (_numRequest == 0 ? TRUE : FALSE);
    ThreadVSem(_sem);
    if (done) {
        @call self::WWFrameDone();
    }
}
