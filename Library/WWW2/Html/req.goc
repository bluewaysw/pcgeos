/*---------------------------------------------------------------------------
//		HTRequest::DuplicateURL()
//---------------------------------------------------------------------------
// 
// SYNOPSIS: 	Duplicate URL, if there is no scheme, default to http://
// SCOPE:	Private
// RETURN:	char*, must be deleted by caller via delete [] .
// STRATEGY:	
// 
// REVISION HISTORY: 
//	Name		Date		Description 
//	----		----		----------- 
//	kkee    	6/15/98 	Initial version 
//	
//-------------------------------------------------------------------------*/
char*
HTRequestDuplicateURL(HTRequest *pself, const char *url)
{
    EC_BOUNDS(url);
    if (!strchr(url, ':')) {
        /* Default to http://, which requires 7 spaces */
        char *ret = (char *)malloc(sizeof(char)*(strlen(url) + 8));
        if (!ret) {
            return NULL;
        }
        strcpy(ret, "http://");
        return strcat(ret, url);
    } else {
        return stralloccopy(url);
    }
}	/* End of HTRequest::DuplicateURL() */


void HTRequestSetStreamPreemptable(HTRequest *pself,
				   optr /* WWStream * */ stream)
{
EC (ECCheckLMemObject(stream));
    ASSERT(_stream == NULL);
    ThreadPSem(_preemptStream);
    _stream = stream;
    ThreadVSem(_preemptStream);
}


void HTRequestDeleteStream(HTRequest *pself)
{
    ThreadPSem(_preemptStream);
    @call _stream::MSG_META_OBJ_FREE();
    _stream = NULL;
    ThreadVSem(_preemptStream);
}



#if ERROR_CHECK
/* Remove stream without deleting it   */
optr /* WWStream* */ HTRequestRemoveStream(HTRequest *pself)
{
    ThreadPSem(_preemptStream);
    optr /* WWStream * */ ret = _stream;
    _stream = NULL;
    ThreadVSem(_preemptStream);
    return ret;
}
#endif
