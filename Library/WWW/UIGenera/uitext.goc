/***********************************************************************
 *	MSG_UI_GENERATOR_APPEND_TEXT_PTR for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	Append the character data in a text object.  If there is
 *		no text object available, a text object will be created.
 * PARAMETERS:	(char *ptr, int len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		- assume the data character has no entity references
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/16/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_APPEND_TEXT_PTR
{
  char old;

  if (!(pself->UIG_target.obj)) {
    /* 
     *  No target.obj.  Thus, create a text object,
     *  initialize it, and store character data.
     */
    @call self::MSG_UI_GENERATOR_CREATE_TEXT_OBJECT
	(ptr, pself->UIG_content, len);
  }
  else if(pself->UIG_target.class == (ClassStruct *)&HTGenTextClass ||
	  pself->UIG_target.class == (ClassStruct *)&HTGenFormTextClass) {
    if ((@call pself->UIG_target.obj::MSG_VIS_TEXT_GET_TEXT_SIZE() + len) 
	> 5000) {
      @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ
	 (pself->UIG_target.obj);
#if 1
      @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
	 (pself->UIG_target.obj);
#endif
      @call self::MSG_UI_GENERATOR_CREATE_TEXT_OBJECT
	 (ptr, pself->UIG_content, len);
      EC_WARNING(UIG_TEXT_SPLITS_AT_5K_BYTES);
    }
    else 
      /*
       * The target is a text object, so we simply append the text to it.
       */
      @call pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(ptr, len);
  }
  /* Added for HTTextAreaClass */
/*******
  else if( pself->UIG_target.class == (ClassStruct *)&HTTextAreaClass) {
    pself->UIG_target.obj::MSG_HTTA_SET_TEXT_PTR(ptr, len);
  }
*******/
  else if(pself->UIG_target.class == (ClassStruct *)&HTGenOptionClass) {
    /*
     *  The target is an <option> obj in the <form>.  So the text
     *  is assumed to be the vis_moniker for the <option> object.
     */
    old = ptr[len];
    ptr[len] = '\0';
    if (len == 1 && ptr[0] == ' ')
      ;
    else
      @call pself->UIG_target.obj::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
	(ptr, VUM_DELAYED_VIA_UI_QUEUE);
    ptr[len] = old;
  }
  /* Added for HTGenMultiLineSelectClass. */
  else if(pself->UIG_target.class == (ClassStruct *)&HTGenMultiLineSelectClass) {
    old = ptr[len];
    ptr[len] = '\0';
    @call pself->UIG_target.obj::MSG_HTGMLS_ADD_OPTION_TEXT
       (ptr);
    ptr[len] = old;
  }
  else if(pself->UIG_target.class == (ClassStruct *)&HTGenTCellClass ||
	  pself->UIG_target.class == (ClassStruct*)&HTGenCaptionClass) {
    /*
     *  Create a text object which will be inside the table cell.
     *  Note, the TCell object contains text formating contents.
     */
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
				(pself->UIG_target.obj);
    @call self::MSG_UI_GENERATOR_CREATE_TEXT_OBJECT
	(ptr, pself->UIG_target.obj, len);
  }
  else if(pself->UIG_target.class == (ClassStruct *)&HTGenFormClass) {
    /*
     *  Now we have text inside a table.  This text is formated 
     *  according to the global text contents.
     */
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
				(pself->UIG_target.obj);
    @call self::MSG_UI_GENERATOR_CREATE_TEXT_OBJECT
	(ptr, pself->UIG_target.obj, len);

  }
  else if(pself->UIG_target.class==(ClassStruct*)&PresentationManagerClass){
    /*
     * We're in the <TITLE>....</TITLE> content.  Tell the PManager to
     * store the title of the document.
     */
    @call pself->UIG_target.obj::MSG_PM_SAVE_TITLE(ptr);
  }
  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *	MSG_UI_GENERATOR_CREATE_TEXT_OBJECT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a text object and initialize it
 * PARAMETERS:	    (char *text, optr cell, int len)
 *		    if cell is NULL, that means we don't do any text
 *		    formatting according to the global HTML contents.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		1) Instantiate a text object
 *		2) Add HINTs to the object
 *		3) Format it according to the current HTML content
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/10/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_TEXT_OBJECT
{
  GStateHandle gstate;
  /*
   * Create a text object.
   */
  pself->UIG_target.obj = @call pself->UIG_pmObj::\
	MSG_PM_OBJECT_INSTANTIATE(&HTGenTextClass);
  pself->UIG_target.class = (ClassStruct *)&HTGenTextClass;
  /*
   * Initialization:
   * 1) Create gstate, used to calculate the min width required for
   *	the text object.
   * 2) Create a text storage for the object.
   * 3) Mark text non-editable, non-scrollable, add HINTs
   */
  gstate = @call pself->UIG_target.obj::MSG_GEN_TEXT_INITIALIZE();
  /*
   *  Set text output object to be the PManager, which has all the HREF
   *  information.  Thus, when a hyperlink is clicked, the text object
   *  can send HREF token to the output object(PManager) to fetch.
   */
  @call pself->UIG_target.obj::MSG_META_SET_OBJ_BLOCK_OUTPUT
     (pself->UIG_pmObj);
  /*
   * Do text formating stuff...
   *    Format the text object, i.g. bold, font size, alignment, 
   *	according to the current HTML content.  Note, the cell object 
   *	contains information about the current HTML content.
   */
  if (cell != NULL)
    @call cell::MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT
	(pself->UIG_target.obj, gstate);

  /*
   * Append the text.
   */
  if (text != NULL)
    @call pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(text, len);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_TEXT_OBJECT.	*/



/***********************************************************************
 *	MSG_UI_GENERATOR_START_BOLD for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Mark the beginning of bold character rending
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		This method is intended to render the text in the
 *		contents of:  <B>, <STRONG>
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/28/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_BOLD
{
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin the bold mode.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BOLD);
  /*
   * If the current target.obj is a text, do the bold rendering now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass)
    @call pself->UIG_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_BOLD);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_BOLD	*/



