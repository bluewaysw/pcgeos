/***********************************************************************
 *	MSG_UI_GENERATOR_START_FIXED_WIDTH_FONT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Render text in fixed-width font
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <CODE>, <KBD>, 
 *		<SAMP>, and <TT>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 6/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_FIXED_WIDTH_FONT
{
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin the subscript mode.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FW_FONT);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
	@send pself->UIG_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_MONO,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_FIXED_WIDTH_FONT.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_FONT_SIZE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change the text font size.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		This method is intended to handle:
 *		<FONT SIZE=n>, <BASEFONT SIZE=n>, 
 *		where n = [+|-] 1 | 2 | 3 | 4 | 5 | 6 | 7
 *		n = 3 is default.
 *		
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_FONT_SIZE
{
  char *value;
  int	index, size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_SIZE:
      /*
       * get the 'size' attribute.  calculate the value if necessary.
       */
      size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
      size = MapPointSizeToAttrSize (size);

      if (value[0] == '+') {		/* Is this +size ? */
	size += atoi(value+1);
      }
      else if ( value[0] == '-' || value[0] == '-')
	size -= atoi(value+1);         /* Is this -size ? */
      else
	size = atoi(value);	       /* It's absolute size */
      /*
       * Map the attribute size to the actual font point size.
       */
      MapAttrSizeToPointSize(size, &number);
      /* 
       * Store the font point size in the fontStack, so later we know
       * what font point size to return from.
       */
      @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
	 (number.WWF_int);
      /*
       * If the current target.obj is a text, change the font now.
       */
      if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
	@call pself->UIG_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
	   (number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
      }
      break;
    }
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_FONT_SIZE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_CHANGE_SMALL_FONT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change font size smaller than the current one.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Get the current font size.  Change to the next smaller
 *		size.  This method is intended to handle <SMALL>.
 *		We treat <SMALL> as <FONT SIZE = -1>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 2/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CHANGE_SMALL_FONT
{
  int size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  /*
   * Get current font size
   */
  size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  /*
   * change to a smaller size than the current one.  i.e. SIZE = -1
   */
  switch(size) {
	case STYLE_FONT_0:
		number.WWF_int = STYLE_FONT_0;	/* can't be any smaller */
		break;
	case STYLE_FONT_1:
		number.WWF_int = STYLE_FONT_0;
		break;
	case STYLE_FONT_2:
		number.WWF_int = STYLE_FONT_1;
		break;
	case STYLE_FONT_3:
		number.WWF_int = STYLE_FONT_2;
		break;
	case STYLE_FONT_4:
		number.WWF_int = STYLE_FONT_3;
		break;
	case STYLE_FONT_5:
		number.WWF_int = STYLE_FONT_4;
		break;
	case STYLE_FONT_6:
		number.WWF_int = STYLE_FONT_5;
		break;
	case STYLE_FONT_7:
		number.WWF_int = STYLE_FONT_6;
		break;
	default:
		number.WWF_int = STYLE_FONT_3;	/* error checking */
		break;
  }
  number.WWF_frac= 0;
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
		(number.WWF_int);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
	@call pself->UIG_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CHANGE_SMALL_FONT.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_CHANGE_BIG_FONT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change font size smaller than the current one.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Get the current font size.  Change to the next larger
 *		size.  This method is intended to handle <LARGE>. 
 *		We treat <BIG> as <FONT SIZE = +1>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 2/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CHANGE_BIG_FONT
{
  int size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  /*
   * Get current font size
   */
  size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  /*
   * change to a larger size than the current one.  i.e. SIZE = +1
   */
  switch(size) {
	case STYLE_FONT_1:
		number.WWF_int = STYLE_FONT_2;
		break;
	case STYLE_FONT_2:
		number.WWF_int = STYLE_FONT_3;
		break;
	case STYLE_FONT_3:
		number.WWF_int = STYLE_FONT_4;
		break;
	case STYLE_FONT_4:
		number.WWF_int = STYLE_FONT_5;
		break;
	case STYLE_FONT_5:
		number.WWF_int = STYLE_FONT_6;
		break;
	case STYLE_FONT_6:
		number.WWF_int = STYLE_FONT_7;
		break;
	case STYLE_FONT_7:
		number.WWF_int = STYLE_FONT_8;
		break;
	case STYLE_FONT_8:
		number.WWF_int = STYLE_FONT_8;	/* can't be any larger */
		break;
	default:
		number.WWF_int = STYLE_FONT_3;	/* error checking */
		break;
  }
  number.WWF_frac= 0;
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
		(number.WWF_int);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
	@call pself->UIG_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CHANGE_BIG_FONT.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_HEADER for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Set header font
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Assume the HTML parser will generate the size attribute
 *		like
 *		<H1 size=6>
 *		<H2 size=5>
 *		<H3 size=4>
 *		<H4 size=3>
 *		<H5 size=2>
 *		<H6 size=1>
 *		Supported attributes: ALIGN
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_HEADER
{
  optr content;
  if (pself->UIG_target.class == (ClassStruct *)&HTGenOptionClass) {
    FinishCurrentObjectInForm(pself->UIG_pmObj,&(pself->UIG_target));
    @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
       (&(pself->UIG_target.obj), &(pself->UIG_target.class));
  }
  /*
   * Push format token onto the format stack.
   * Note, here we're pushing three format tokens, so we'll pop four 
   * tokens all together later in the MSG_UI_GENERATOR_END_FORMAT.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_ALIGN);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BOLD);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_HEADER);
  /*
   * Add a blank line for the header.
   */
  AddNewLine(&(pself->UIG_target), 2, pself->UIG_pmObj, pself->UIG_content);
  /*
   * Process the attribute list.
   */
  ProcessHeaderAttr(block, entity, &(pself->UIG_target), content);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_HEADER.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_START_UNORDERED_LIST for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Draws lines of text as a bulleted list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <UL>, <MENU>, <DIR>
 *		Supported Attributes:
 *		<UL>	: TYPE = disk | circle | square
 *		<MENU>	: same as above
 *		<DIR>	: same as above
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_UNORDERED_LIST
{
  optr content;
  StyleType groupType;
  int	counter, level;
  char	displayType;
  /*
   * Do some initializing work common to both <UL> and <OL>.
   * This function does:
   * 	1) Push format token onto the format stack.
   *	2) Add a line break before the first list item if we're in the
   *	   first list level.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_UL);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (level == -1)
    AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
  /*
   * Process the attribute list, push the list info to the list stack.
   */
  ProcessUnorderedListAttr(block, entity, content);

  return UI_GEN_NO_ERROR;
 }	/* End of MSG_UI_GENERATOR_START_UNORDERED_LIST.	*/



/***********************************************************************
 *	MSG_UI_GENERATOR_START_ORDERED_LIST for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Draws lines of text as an ordered list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <OL>
 *		Supported Attributes:
 *		<OL>	: START=n, TYPE= A | a | I| i | 1
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_ORDERED_LIST
{
  optr content;
  StyleType groupType;
  int	counter, level;
  char	displayType;
  /*
   * Do some initializing work common to both <UL> and <OL>.
   * This function does:
   * 	1) Push format token onto the format stack.
   *	2) Add a line break before the first list item if we're in the
   *	   first list level.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_OL);
  /*
   * If it's a nested list, we don't need to insert a new-line.  <LI>
   * will add a new line.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (level == -1)
    AddNewLine(&(pself->UIG_target),1,pself->UIG_pmObj, pself->UIG_content);
  /*
   * Process the attribute list, push the list info to the list stack.
   */
  ProcessOrderedListAttr(block, entity, content);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_ORDERED_LIST.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_END_LIST for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Mark the text object the end of a list group.
 * PARAMETERS:	    none, 
 * SIDE EFFECTS:    Called internally by MSG_UI_GENERATOR_END_FORMAT
 *
 * STRATEGY:	This method handles </UL>, </OL>, and </BQ>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 9/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_LIST
{
  StyleType groupType;
  int	counter, level;
  char	displayType;
  Tab	nextTab;
  optr	content;
  /*
   * Pop format token onto the format stack.
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_POP_LIST_GROUP();

  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  /*
   * Insert a line break to begin a new paragraph, whose left margin
   * will be set as followed.
   */
  if (groupType == (StyleType)-1)
    AddNewLine(&(pself->UIG_target),2,pself->UIG_pmObj, pself->UIG_content);
  else
    AddNewLine(&(pself->UIG_target),1,pself->UIG_pmObj, pself->UIG_content);
  /*
   * Mark the margin of the new paragraph.
   */
  if (pself->UIG_target.class == (ClassStruct *)&HTGenTextClass) {
    @send pself->UIG_target.obj::MSG_VIS_TEXT_SET_LEFT_MARGIN(
				TAB_SIZE * ( level + 1 ),
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
    /*
     * Restore the next tab which has been set an anchor from the
     * previous nested list group.
     */
    nextTab.T_position	= TAB_SIZE * (level + 2);	/* reset the */
    nextTab.T_attr	= TL_NONE | TT_LEFT;		/* next tab. */
    nextTab.T_lineWidth	= nextTab.T_lineSpacing	=
			  nextTab.T_grayScreen	= 0;
    @call pself->UIG_target.obj::MSG_VIS_TEXT_SET_TAB(nextTab,		
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_LIST.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_LIST_ITEM for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Denotes one item of a list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <LI>.
 * 		- add a new line
 *		- tab to the right position
 *		- add a item header.  (message call)
 *		- set left margine for the item text.
 *
 *		If this is under <OL>,
 *
 *		If this is under <UL>, <MENU>, or <DIR>,
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_LIST_ITEM
{
  StyleType format, groupType;
  int counter, level, i;
  char displayType, tab[1] = { C_TAB };
  optr content;

  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  format = @call content::MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE();
  if (format != STYLE_OL && format != STYLE_UL) {
	EC_WARNING(UIG_INVALID_LI_ITEM); 
	return UI_GEN_ERROR;
  }

  if (pself->UIG_target.class != (ClassStruct *)&HTGenTextClass) {
    /* No text object, so create and initialize one */
    @call pself->UIG_pmObj::
	MSG_PM_TAKE_UNFINISHED_UI_OBJ(pself->UIG_target.obj);
    @call self::MSG_UI_GENERATOR_CREATE_TEXT_OBJECT(NULL, content, 0);
  }
  /*
   * The new item starts on a new line.  If there has been a nested
   * list that just ended, then a new line has been added.  Thus
   * we don't need to add another new line here.
   */
  if (@call content::\
	MSG_HTGHC_MSG_GEN_HTML_CONTENT_GET_ANY_LAST_LIST_GROUP() == FALSE)
    AddNewLine(&(pself->UIG_target),1,pself->UIG_pmObj, pself->UIG_content);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  EC_WARNING_IF(format != groupType, UIG_UNBALANCED_LIST_STACK);
  /*
   * Process any passed attributes list.
   */
  ProcessLIAttr(block, entity, groupType, &counter, &displayType,
	content);
  /*
   * add a 'right' tab for the item header.
   */
  SetTabsForListGroup(level, pself->UIG_target.obj);
  /*
   * Since the new line break brought the cursor to position 1, we
   * need to tab to the right position for the list item.
   */
  if (level == 0)
    for(i = 0; i <= level; i++)
      @send pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);
  else
    for(i = 0; i < level; i++)
      @send pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);

  if (format == STYLE_UL) {
	/* create an unordered list header */
	@call self::MSG_UI_GENERATOR_CREATE_UNORDERED_LIST_ITEM(
		displayType, level);
  }
  else {					/* STYLE_OL */
	/* create an ordered list header */
	@call self::MSG_UI_GENERATOR_CREATE_ORDERED_LIST_ITEM(
		counter, displayType, level);
  }
  /*
   * Set the left margin so the item text wraps around at the right place
   */
  @send pself->UIG_target.obj::MSG_VIS_TEXT_SET_LEFT_MARGIN(
				(TAB_SIZE * ( level + 1 )) + 24,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_LIST_ITEM.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_CREATE_UNORDERED_LIST_ITEM for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an item header for an unordered list item.
 * PARAMETERS:	    (char displayType, int level)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	- add a new line
 *		- tab to the right position
 *		- change to the symbol font
 *		- add a symbol representing a item header.
 *		- change the font back.
 *		- set left margine for the item text.
 *		  
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_UNORDERED_LIST_ITEM
{
  char	bullet[3] = { C_U_SIGMA, C_TAB };
  optr	content;
  /*
   * Different nesting level has a different item header, unless the
   * attriute specifies otherwise.  This follows the Netscape style.
   */
  if (displayType == 'c')
	bullet[0] = C_SMALL_O;
  else if (displayType == 's')
	bullet[0] = C_DBLDAGGER;
  else if (displayType == 'd')
	bullet[0] = C_U_SIGMA;
  else if (level == 0)
	bullet[0] = C_U_SIGMA;
  else if (level == 1)
	bullet[0] = C_SMALL_O;
  else if (level > 1)
	bullet[0] = C_DBLDAGGER;

  /* change font to get a nice looking bullet */
  @call pself->UIG_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_SYMBOLPS,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  /* 
   * Add the item header 
   */
  @call pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(bullet, 2);
  /*
   * change back the font
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  if (@call content::MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT
	(STYLE_FW_FONT)) {
    @send pself->UIG_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_MONO,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }
  else {
    @send pself->UIG_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_SANS,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_UNORDERED_LI.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_CREATE_ORDERED_LIST_ITEM for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an item header for an ordered list item.
 * PARAMETERS:	    (int counter, char displayType, int level)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 9/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_ORDERED_LIST_ITEM
{
  int	i;
  char	temp[20];
  optr	content;
  /*
   * Different level has a different item header.  Unless the attriute 
   * of the list item specifies otherwise, we use the default item 
   * headers.  This follows the Netscape style.
   */
  if (displayType == 'A')
    MyVisTextFormatNumber(temp, counter, VTNT_LETTER_UPPER_A);
  else if (displayType == 'a')
    MyVisTextFormatNumber(temp, counter, VTNT_LETTER_LOWER_A);
  else if (displayType == 'I')
    VisTextFormatNumber(temp, counter, VTNT_ROMAN_NUMERAL_UPPER);
  else if (displayType == 'i')
    VisTextFormatNumber(temp, counter, VTNT_ROMAN_NUMERAL_LOWER);
  else 
    VisTextFormatNumber(temp, counter, VTNT_NUMBER);

  for (i=0; temp[i] != '\0'; i++)
	;
  temp[i++]	= C_PERIOD;
  temp[i++]	= C_TAB;
  temp[i]	= '\0';

  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @send content::MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER();
  /* 
   * Add the item header 
   */
  @call pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(temp, 0);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_ORDERED_LIST_ITEM.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_PRE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    render text in a separated multi-line group
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Add a new line, change to fixed-width font.  This
 *		method is intended to handle <PRE>, <XMP> and <LISTING>
 *
 *		NOTE!!!!:
 *		This message assumes the parser will not strip off
 *		multiple spaces and line breaks in the source html file
 *		from now on until the end element is seen.
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 6/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_PRE
{
  optr content;

  AddNewLine(&(pself->UIG_target), 2, pself->UIG_pmObj, pself->UIG_content);
  @call self::MSG_UI_GENERATOR_START_FIXED_WIDTH_FONT();
  /*
   * Push format token onto the format stack. 
   */
  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_PRE);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_PRE.	*/



/***********************************************************************
 *	MSG_UI_GENERATOR_START_DEFINITION_LIST for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_DEFINITION_LIST
{
  optr content;
  StyleType groupType;
  int counter, level;
  char displayType;

  content = @call self::MSG_UI_GENERATOR_GET_CONTENT();
  /*
   * Push format token onto the format stack.
   */
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_DL);
  /*
   * Add a line break before the first list item if it's the first
   * level of list
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (level == -1)
    AddNewLine(&(pself->UIG_target),1,pself->UIG_pmObj, pself->UIG_content);
  /*
   * Push the list group info
   */
  @call content::MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP(STYLE_DL, 0, 0);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_DEFINITION_LIST.	*/



/***********************************************************************
 *	MSG_UI_GENERATOR_CREATE_DEFINITION_DT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_DEFINITION_DT
{
  StyleType groupType;
  int counter, level, i;
  char displayType, tab[1] = { C_TAB }, null[] = { C_NULL };
  optr content = @call self::MSG_UI_GENERATOR_GET_CONTENT();

  if (pself->UIG_target.class != (ClassStruct *)&HTGenTextClass) {
    /* No text object, so create and initialize one */
    @call self::MSG_UI_GENERATOR_APPEND_TEXT_PTR(null,0);
  }
  /*
   * the new item starts on a new line
   */
  AddNewLine(&(pself->UIG_target), 1, pself->UIG_pmObj, pself->UIG_content);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  EC_WARNING_IF(groupType != STYLE_DL, UIG_UNBALANCED_LIST_STACK);
  /*
   * Since the new line break brought the cursor to position 1, we
   * need to tab to the right position for the list item.
   */
/*  if (listIndex > 1)	* if it's a nested definition list, *
  	level++;			* then skip the right tab */
	
  for(i = 0; i < level; i++)
    @call pself->UIG_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_DEFINITION_DT.	*/



