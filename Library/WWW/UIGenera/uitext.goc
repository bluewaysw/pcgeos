{
  searchWrapObj = NULL;
  @callsuper();
  return;
}	/* End of MSG_SEARCH.	*/



/***********************************************************************
 *		MSG_META_GET_OBJECT_FOR_SEARCH_SPELL for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Record the search status in global variables.
 * PARAMETERS:	    option
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_META_GET_OBJECT_FOR_SEARCH_SPELL
{

  if(option == GSSOT_FIRST_OBJECT || option == GSSOT_LAST_OBJECT) {
    @call self::MSG_VIS_TEXT_GET_SELECTION_RANGE(&searchWrapRange);
    searchWrapObj = oself;
  }
  else
    searchWrapObj = NULL;
  return @callsuper();
}	/* End of MSG_META_GET_OBJECT_FOR_SEARCH_SPELL.	*/



/***********************************************************************
 *		MSG_VIS_TEXT_SELECT_RANGE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    To make the selected text in the document
 *                  stay selected when there is no more matched string
 *                  during the search process.
 * PARAMETERS:	    (@stack dword end, dword start)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/22/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SELECT_RANGE
{
  if (searchWrapObj == oself) {
    start = searchWrapRange.VTR_start;
    end = searchWrapRange.VTR_end;
  }
  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_SELECT_RANGE.	*/


