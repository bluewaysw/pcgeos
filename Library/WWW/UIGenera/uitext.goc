/***********************************************************************
 *		MSG_VIS_TEXT_SET_FONT_ID for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept the message and update its gstate.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	HTGT_gstate is used to calculate the width, in pixels,
 *		needed to draw the text.  That width will be used to
 *		set the width of text object.  Thus, the text won't 
 *		appear wider than necesary.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SET_FONT_ID
{
  GrSetFont(pself->HTGT_gstate, fid, 0);
  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_SET_FONT_ID.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_APPEND_PTR for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept this message and update the HTGT_accLen
 * PARAMETERS:	    (const char *text, word textLen)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	HTGT_accLen is used to accumulate the text  length, 
 *		in pixels to draw the current line of text.  This 
 *		length will be used to set the width of text object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_APPEND_PTR
{
  int len;
  if (text[0] == C_TAB)
    pself->HTGT_accLen += (textLen * TAB_POINT);
  else if (text[0] == C_LF)
    return;
  else {
    if (textLen == 0)
      len = strlen(text);
    else
      len = textLen;
    pself->HTGT_accLen += (GrTextWidth(pself->HTGT_gstate,text,len)+6);
  }
  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_APPEND_PTR.	*/


