/***********************************************************************
 *		MSG_VIS_DRAW for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    In the print process, make the text backgroud white
 *                  so that the text on the print out won't have light
 *                  grey background.
 * PARAMETERS:	    (DrawFlags drawFlags, GStateHandle gstate);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/10/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_DRAW
{
  VisTextWashColorModeRed modeRed;
  VisTextWashColorBlueGreen blueGreen;
  VisTextGetWashColor retVal;
  VisTextInstance  * vself;
  VisTextIntFlags flag;

  if (drawFlags & DF_PRINT) {
    @call self::MSG_VIS_TEXT_GET_WASH_COLOR(&retVal);
    modeRed.VTWCMR_redOrIndex = C_WHITE;
    modeRed.VTWCMR_mapMode = CF_INDEX;
    blueGreen.VTWCBG_green = blueGreen.VTWCBG_blue = 0;
    vself = ObjDerefVis(oself);
    flag = vself->VTI_intFlags;
    vself->VTI_intFlags |= VTIF_SUSPENDED;
    @call self::MSG_VIS_TEXT_SET_WASH_COLOR(modeRed, blueGreen);
    vself->VTI_intFlags = flag;
  }
  @callsuper();
  if (drawFlags & DF_PRINT) {
    @call self::MSG_VIS_TEXT_SET_WASH_COLOR(retVal.VTGWC_modeRed,
					    retVal.VTGWC_blueGreen);
  }
  if (pself->HTGT_focalAnchor != -1) {
    /*
     *  Redraw the focus outlink if it currently has focus.
     */
    GrSaveState(gstate);
    GrSetLineMaskSys(gstate, SDM_50 );
    GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GREY, 0, 0);
    GrSetMixMode(gstate, MM_XOR);
  if (pself->HTGT_focalBox.R_left != pself->HTGT_focalBox.R_right) {
	  GrDrawLine(gstate, pself->HTGT_focalBound.RD_left, 
		     pself->HTGT_focalBound.RD_top, 
		     pself->HTGT_focalBox.R_right, 
		     pself->HTGT_focalBound.RD_top);
	  GrDrawLine(gstate, pself->HTGT_focalBox.R_right, 
		     pself->HTGT_focalBound.RD_top,
		     pself->HTGT_focalBox.R_right, 
		     pself->HTGT_focalBox.R_bottom);
	  GrDrawLine(gstate, pself->HTGT_focalBox.R_right, 
		     pself->HTGT_focalBox.R_bottom,
		     pself->HTGT_focalBound.RD_right, 
		     pself->HTGT_focalBox.R_bottom);
	  GrDrawLine(gstate, pself->HTGT_focalBound.RD_right, 
		     pself->HTGT_focalBox.R_bottom,
		     pself->HTGT_focalBound.RD_right, 
		     pself->HTGT_focalBound.RD_bottom);
	  GrDrawLine(gstate, pself->HTGT_focalBound.RD_right, 
		     pself->HTGT_focalBound.RD_bottom,
		     pself->HTGT_focalBox.R_left, 
		     pself->HTGT_focalBound.RD_bottom);
	  GrDrawLine(gstate, pself->HTGT_focalBox.R_left, 
		     pself->HTGT_focalBound.RD_bottom,
		     pself->HTGT_focalBox.R_left, 
		     pself->HTGT_focalBox.R_top);
	  GrDrawLine(gstate, pself->HTGT_focalBox.R_left, 
		     pself->HTGT_focalBox.R_top,
		     pself->HTGT_focalBound.RD_left, 
		     pself->HTGT_focalBox.R_top);
	  GrDrawLine(gstate, pself->HTGT_focalBound.RD_left, 
		     pself->HTGT_focalBox.R_top,
		     pself->HTGT_focalBound.RD_left, 
		     pself->HTGT_focalBound.RD_top);
  }
  else
      GrDrawRect(gstate, 
		 pself->HTGT_focalBound.RD_left, 
		 pself->HTGT_focalBound.RD_top, 
		 pself->HTGT_focalBound.RD_right, 
		 pself->HTGT_focalBound.RD_bottom);
    GrRestoreState(gstate);
  }
  return;
}	/* End of MSG_VIS_DRAW.	*/



