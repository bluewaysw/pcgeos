/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenCaptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/13/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenCaptionClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;
  CompSizeHintArgs sizeArgs;
  int value;
  VisTextInstance  *vself;

  sizeArgs.CSHA_width = 0;
  @call self::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  if (sizeArgs.CSHA_width == 0) {
    @call @genParent::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
    width = sizeArgs.CSHA_width;	/* assume it's SST_PIXELS */
    if (width > NESTED_MARGIN)
      sizeArgs.CSHA_width = width - NESTED_MARGIN;
    else
      sizeArgs.CSHA_width = width;
    sizeArgs.CSHA_count = 0;
    sizeArgs.CSHA_height = 0;
    EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  }
  else
    width = sizeArgs.CSHA_width;	/* assume it's SST_PIXELS */

  size = @callsuper();
  /*
   *  Clear all the row information.  Tell its children to calculate
   *  their own position and store that information in a heigtArray.
   */
  @call self::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();
  @send @genChildren::MSG_META_UIG_CALC_POSITION();
  /*
   *  Sum up the heights of rows in this form.
   */
  height = @call self::MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS();
  
  size = MAKE_SIZE_DWORD(width, height);
  /*
   *  Finish the last row.
   */
  @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &value);
  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		  InitializeTableCellCommon
 ***********************************************************************
 * SYNOPSIS:	Create a HTGenTCellClass object.
 * CALLED BY:	Common function called by <TH> and <TD> msg handlers.
 * RETURN:	optr table - HTGenTable object.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 4/96   	Initial Revision
 *
 ***********************************************************************/
optr 
InitializeTableCellCommon (optr pmObj, ObjInfo *target)
{
  int row, col;
  optr table;
  Rectangle rect;
  /*
   *  Insert whatever object in target to the ui tree, and trace back
   *  up the tree to find the first table ui object.
   */
  @call pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ(target->obj);

  if (target->class != (ClassStruct *)&HTGenTableClass) {
    while (1) {
	@call pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(target->obj),&(target->class));
	/*
	 * Now target->obj has PManager's recvObj.
	 */
	EC_ERROR_IF(target->class == NULL || target->obj == NULL ||
	    target->class == (ClassStruct *)&HTGenTextClass,
	    UIG_INVALID_OPERATION_ON_UI_TREE);
	if (target->class == (ClassStruct *)&HTGenTableClass)
		break;
    }
  }
  /*
   * Now we know PManager's recvObj must be a HTGenTable object.
   */
  EC_ERROR_IF(target->class != (ClassStruct *)&HTGenTableClass,
	UIG_UI_TREE_OPERATION_FAILS);
  /*
   *  Ask the table ui object for the cell position for this new
   *  table cell object.  Table object will use the suggested
   *  column count and take into account any nearby cells that span 
   *  over rows or columns to calculate the actual cell position.
   */
  @call target->obj::MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION(&row, &col);
  /*
   * Now create a table cell object.
   */
  table = target->obj;
  target->obj = @call pmObj::MSG_PM_OBJECT_INSTANTIATE(&HTGenTCellClass);
  target->class = (ClassStruct *)&HTGenTCellClass;
  /*
   * Mark its table position.
   */
  @send target->obj::MSG_GEN_TCELL_SET_CELL_POSITION(row, col);
  /*
   * Add HINTs
   */
  if ((@call table::MSG_GEN_TABLE_SHOW_BORDER()) == TRUE) {
    rect.R_left = -7;
    rect.R_top = -7;
    rect.R_right = -1;
    rect.R_bottom= -7;
    @send target->obj::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
    @send target->obj::MSG_META_ADD_VAR_DATA
       (HINT_CUSTOM_EXTRA_MARGINS, sizeof(Rectangle), &rect);
  }
  /*
  @send target->obj::MSG_META_ADD_VAR_DATA
	(HINT_NO_WIDER_THAN_CHILDREN_REQUIRE,0,NULL);
  @send target->obj::MSG_META_ADD_VAR_DATA
	(HINT_NO_TALLER_THAN_CHILDREN_REQUIRE,0,NULL);
  */
  TrMode = FALSE;
  return table;
}	/* End of   InitializeTableCellCommon.	*/


