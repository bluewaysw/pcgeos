@include <stdapp.goh>
@include <WWW/pmanager.goh>
@include <WWW/uigenera.goh>
@include "uifatals.goh"
#include <Ansi/string.h>
#include <Ansi/stdlib.h>        	/* atoi() defined */

@classdecl	HTGenTableClass;	/* <TABLE>	*/
@classdecl	HTGenTCellClass;	/* <TH> + <TD>	*/
@classdecl	HTGenCaptionClass;	/* <CAPTION>	*/


optr InitializeTableCellCommon (optr pmObj, ObjInfo *target);

Boolean	TrMode = FALSE;


/***********************************************************************
 *		MSG_UI_GENERATOR_START_TABLE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a ui object representing a table.
 *
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/27/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_TABLE
{
  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
   */
  if ((pself->UIG_target.class == (ClassStruct *)&HTGenFormClass)  ||
      (pself->UIG_target.class == (ClassStruct *)&HTGenTableClass) ||
      (pself->UIG_target.class == (ClassStruct *)&HTGenTCellClass) ){
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(pself->UIG_target.obj);
  }
  else if (pself->UIG_target.obj) {
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ
	(pself->UIG_target.obj);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
       (pself->UIG_target.obj);
#endif
  }
  /*
   *  Now create and store a table object in target.obj.
   */
  pself->UIG_target.obj = 
    @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE(&HTGenTableClass);
  pself->UIG_target.class = (ClassStruct *)&HTGenTableClass;
  /*
   *  Process the attributes.
   */
  @call pself->UIG_target.obj::MSG_GEN_TABLE_PROCESS_ATTRIBUTE
     (block, entity);

  TrMode = FALSE;
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_TABLE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_END_TABLE for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Finish up the table object and ask PManager 
 *		    to render it.
 *		    
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/28/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_TABLE
{
  optr obj;
  if (!pself->UIG_target.obj)
    return UI_GEN_ERROR;
  /*
   *  Travel up the ui tree till a table is seen,  and mark all the 
   *  objects usable along the way.
   */
  @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(pself->UIG_target.obj);
  if (pself->UIG_target.class != (ClassStruct *)&HTGenTableClass) {
    while (1) {
      @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(pself->UIG_target.obj),&(pself->UIG_target.class));
      EC_ERROR_IF(pself->UIG_target.obj == NULL ||
		pself->UIG_target.class==(ClassStruct*)&HTGenTextClass,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if (pself->UIG_target.class == (ClassStruct *)&HTGenTableClass) {
        break;
      }
    }
  }
  EC_ERROR_IF(pself->UIG_target.class != (ClassStruct *)&HTGenTableClass,
	UIG_INVALID_OPERATION_ON_UI_TREE);
  /*
   *  Tell the receiving object (which should be HTGenTable object)
   *  that there are no more children for the table.  So the 
   *  presentation manager can mark the table usable.
   */
  obj = pself->UIG_target.obj;
  @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(pself->UIG_target.obj),&(pself->UIG_target.class));
#if 1
  @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION(obj);
#endif

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_TABLE.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_START_CAPTION for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a ui representing the caption for a table.
 *	
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/28/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_CAPTION
{
  int index;
  char *value, align = 0;
  optr caption;
  /*
   *  Process its attribute list.
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (entity[index].SGMLE_token == HTML_ATTR_ALIGN) {
      if (entity[index].SGMLE_value) {
	value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
	if (strcasecmp(value, "top") == 0)
	    align = 0;
	else if (strcasecmp(value, "bottom") == 0)
	    align = 1;
      }
    }
  }
  /*
   *  Finished whatever object is there.
   */
  @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
      (pself->UIG_target.obj);
  /*
   *  Create a caption object and switch PM's PM_receiving object.
   */
  caption = @call pself->UIG_pmObj::\
      MSG_PM_OBJECT_INSTANTIATE(&HTGenCaptionClass);
  /*
   *  Tell the PM to save the current receiving object, and back 
   *  up the ui tree to the same level as the table, and add the
   *  caption object before or after(depending align) the table 
   *  object.
   */
  @call pself->UIG_pmObj::MSG_PM_ENTER_CAPTION_MODE
      (&HTGenTableClass, align, caption);
  @call caption::MSG_GEN_CAPTION_SAVE_UIG_STATE
      (pself->UIG_target.obj, pself->UIG_target.class);

  pself->UIG_target.obj = caption;
  pself->UIG_target.class = &HTGenCaptionClass;

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		MSG_UI_GENERATOR_END_CAPTION for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_CAPTION
{
  optr dummy;
  ClassStruct *class;

  if (!pself->UIG_target.obj)
    return UI_GEN_ERROR;
  /*
   *  Finish whatever current object.
   */
  @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(pself->UIG_target.obj);
  /*
   *  Traverse up the ui tree to the caption level.
   */
  if (pself->UIG_target.class != (ClassStruct *)&HTGenCaptionClass) {
    while (1) {
      @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(pself->UIG_target.obj),&(pself->UIG_target.class));
      EC_ERROR_IF(pself->UIG_target.obj == NULL ||
		pself->UIG_target.class==(ClassStruct*)&HTGenTextClass,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if (pself->UIG_target.class == (ClassStruct *)&HTGenCaptionClass){
        break;
      }
    }
  }
  EC_ERROR_IF(pself->UIG_target.class!=(ClassStruct*)&HTGenCaptionClass,
	      UIG_INVALID_OPERATION_ON_UI_TREE);
  /*
   *  And make the caption subtree usable.
   */
  @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE(&dummy, &class);

#if 1
  @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
	(pself->UIG_target.obj);
#endif
  /*
   *  Tell the PM to restore the receiving object to what it was 
   *  before the caption object was created.
   */
  @call pself->UIG_pmObj::MSG_PM_EXIT_CAPTION_MODE();
  @call pself->UIG_target.obj::MSG_GEN_CAPTION_RESTORE_UIG_STATE
	(&dummy,&class);
  pself->UIG_target.obj   = dummy;
  pself->UIG_target.class = class;

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_CAPTION.	*/



/***********************************************************************
 *		MSG_UI_GENERATOR_START_TR for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	End the modication of the ui objects in the previous 
 *		table cell if there is any.
 *		
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		If target.obj has any object from the previous
 *		modification, insert it to the ui tree and traverse up
 *		the tree to find the first table object.  We mark all
 *		the encouting objects usable while traversing up the
 *		tree.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_TR
{
  if (!pself->UIG_target.obj)
	return UI_GEN_ERROR;

  if (pself->UIG_target.class != (ClassStruct *)&HTGenTableClass) {
    /*
     *  No matter what's in the current target.obj, insert that object 
     *  to the bottom leaf of the ui tree.
     */
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(pself->UIG_target.obj);
    /*
     * Traverse up the ui tree from the leaf to find the first table 
     * object.  Any future table cell objects will be added to the
     * children list of this table object.  In other word, we tell the
     * PManager to travel up the ui tree until a table object becomes
     * its recvObj.
     */
    while (1) {
	@call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(pself->UIG_target.obj), &(pself->UIG_target.class));
	/*
	 * Now pself->UIG_target.obj contains PManager's recvObj.
	 */
	EC_ERROR_IF(pself->UIG_target.class == NULL || 
		    pself->UIG_target.obj == NULL ||
		    pself->UIG_target.class==(ClassStruct *)&HTGenTextClass,
		    UIG_INVALID_OPERATION_ON_UI_TREE);
	if (pself->UIG_target.class == (ClassStruct *)&HTGenTableClass)
		break;	/* found the table object */
    }
  }
  if (TrMode == FALSE) {
      /*
       * Reset the suggested rowNo and colNo to the next new row of cells.
       */
      @call pself->UIG_target.obj::MSG_GEN_TABLE_INCREMENT_ROW_COUNT();
      TrMode = TRUE;
  }

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_TH for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a header cell <TH> for the TABLE construct.
 *
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_TH
{
  optr table;
  int colSpan;
  /*
   *  Do some work common both for <TH> header cells and <TD> data cells.
   */
  table = InitializeTableCellCommon(pself->UIG_pmObj,&(pself->UIG_target));
  /*
   *  By default, the text is bold for <TH>.
   */
  @call self::MSG_UI_GENERATOR_START_BOLD();
  /*
   *  Process the attribute list.
   */
  colSpan = @call pself->UIG_target.obj::MSG_GEN_TCELL_PROCESS_ATTRIBUTE
  				(block, entity, 1, table);
  /* 
   *  Passing colspan value (at least 1) to increment the suggested
   *  colNo for the next future table cell in the same row.
   */
  @send table::MSG_GEN_TABLE_INCREMENT_COL_COUNT(colSpan);

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_TD for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a data cell <TD> for the TABLE construct
 *		    
 * PARAMETERS:	    (MemHandle dataBlock, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_TD
{
  optr table;
  int colSpan;
  /*
   *  Do some comon work for both <TH> header cells and <TD> data cells.
   */
  table = InitializeTableCellCommon(pself->UIG_pmObj,&(pself->UIG_target));
  /*
   *  Process the attribute list.
   */
  colSpan = @call pself->UIG_target.obj::MSG_GEN_TCELL_PROCESS_ATTRIBUTE
  				(block, entity, 0, table);
  /* 
   *  Passing colspan value (at least 1) to increment the suggested 
   *  colNo for the next future table cell in the same row.
   */
  @send table::MSG_GEN_TABLE_INCREMENT_COL_COUNT(colSpan);

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		MSG_GEN_TABLE_PROCESS_ATTRIBUTE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the TABLE element
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *	Supported Attr:
 *		BORDER
 *		CELLPADDING = n
 *		CELLSPACING = n
 *		WIDTH = n | n%
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j, *array, i;
  Boolean percent;

  for(index = 0; entity[index].SGMLE_token; index++) {
    /*
     *  Border can have no value.  It's a special case.
     */
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_token == HTML_ATTR_BORDER) {
	pself->HTGT_showBorder = TRUE;
	@send self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
      }
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_BORDER:                       /* BORDER */
      if (*value != '0') {
	pself->HTGT_showBorder = TRUE;
	@send self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
      }
      break;
    case HTML_ATTR_WIDTH:                        /* WIDTH */
      /*
       *  Checking for % sign.
       */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE)
	pself->HTGT_width = atoi(value);         /* No percent sign */
      else
	pself->HTGT_width = -atoi(value);        /* negative means % */
      break;
    case HTML_ATTR_CELLPADDING:                  /* CELLPADDING */
      pself->HTGT_cellpadding = atoi(value);
      break;
    case HTML_ATTR_CELLSPACING:                  /* CELLSPACING */
      pself->HTGT_cellspacing = atoi(value);
      break;
    }
  }
  /*
   *  No 3-D look.
  @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_FLAT,0,NULL);
   */
  /*
   *  Initialize the row and column array.
   */
  @self->HTGT_rowHeight = LMemAlloc(HandleOf(oself), sizeof(int)*ROW_SIZE);
  array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  @self->HTGT_rowSize = ROW_SIZE;
  for (i=0; i < ROW_SIZE; i++) array[i] = 0;

  @self->HTGT_colWidth = LMemAlloc(HandleOf(oself), sizeof(int)*COLUMN_SIZE);
  array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
  @self->HTGT_columnSize = COLUMN_SIZE;
  for (i=0; i < COLUMN_SIZE; i++) array[i] = 0;

  @self->HTGT_finalColWidth=LMemAlloc(HandleOf(oself),sizeof(int)*COLUMN_SIZE);
  array=(int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_finalColWidth);
  for (i=0; i < COLUMN_SIZE; i++) array[i] = 0;

  return;
}	/* End of MSG_GEN_TABLE_PROCESS_ATTRIBUTE.	*/


/***********************************************************************
 *	MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Find the actuall cell position for the new cell obj.
 * PARAMETERS:	    (int *row, int *col)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 5/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION
{
  int rowPos, colPos, rowSpan, colSpan, i, *array, j;
  optr child = NULL;

  child = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(0);

  for (i=0; child != NULL; 
	i++, child = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(i)) {
    @call child::MSG_GEN_TCELL_GET_CELL_POSITION(&rowPos, &colPos);

    if (colPos > @self->HTGT_colNo)
	continue;   /* cells byond the current column will not affect */
    else if (rowPos == @self->HTGT_rowNo)
	break;

    EC_ERROR_IF (rowPos > @self->HTGT_rowNo, UIG_UI_TABLE_OPERATION_FAILS);

    @call child::MSG_GEN_TCELL_GET_CELL_SPAN(&rowSpan, &colSpan);
    /* 
     *  Is the cell(rowPos, colPos) occupies the suggested new cell 
     *  position?
     */
    if ((rowPos + rowSpan - 1) >= @self->HTGT_rowNo) {
	/*
	 * This cell spans to the suggested row.
	 */
	if ((colPos + colSpan - 1) >= @self->HTGT_colNo)
	  /* 
	   * This cell also spans to the suggested column.
	   */
	  @self->HTGT_colNo = colPos + colSpan;
	else if (colPos == @self->HTGT_colNo)
	  /* 
	   * This cell span rows only.  Increment the suggested column
	   * number if it's in the same column as this cell.
	   */
	  @self->HTGT_colNo++;
	if (@self->HTGT_colNo > @self->HTGT_columnSize) {
	  /*
	   *  Realloc the array.
	   */
	  EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
	  j = @self->HTGT_columnSize;
	  @self->HTGT_columnSize += COLUMN_SIZE;
	  LMemReAllocHandles(HandleOf(oself),
			     @self->HTGT_colWidth, 
			     sizeof(int) * @self->HTGT_columnSize);
	  array=(int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
	  for (; j < @self->HTGT_columnSize; j++) array[j] = 0;
	  
	  LMemReAllocHandles(HandleOf(oself),
			     @self->HTGT_finalColWidth,
			     sizeof(int) * @self->HTGT_columnSize);
	  array=(int*)LMemDerefHandles(HandleOf(oself), 
				       @self->HTGT_finalColWidth);
	  j = @self->HTGT_columnSize - COLUMN_SIZE;
	  for (; j < @self->HTGT_columnSize; j++) array[j] = 0;
	  
	}
    }
  }
  *row = @self->HTGT_rowNo;
  *col = @self->HTGT_colNo;

  return;
}	/* End of MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION.	*/


/***********************************************************************
 *	MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Keep track the maxinum size of the biggest table
 *		    cell.
 * PARAMETERS:	    (int row, int col, int width, int height);
 *		    row - row number of the table cell.
 *		    height - height of the table cell.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT
{
  int *array;

  EC_ERROR_IF(row > pself->HTGT_rowNo, UIG_ERROR_IN_TABLE);
  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_rowHeight);

  if (height > array[row - 1]) {
    if (array[row - 1] != 0 && array[row - 1] == array[row])
      array[row] = height - array[row-1];
    array[row - 1] = height;
  }
  return;
}	/* End of MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT. */


/***********************************************************************
 *	MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Given the row and column number, calculate the
 *		    position of that cell, in pixels, relative to (0,0).
 *
 * PARAMETERS:	     (int row, int col, int *xPixel, int *yPixel)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION
{
  int i, *array, *array2;

  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_rowHeight);
  array2 =(int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_finalColWidth);

  *xPixel = *yPixel = 0;
  /*
   *  Add up the space for row heights and the cellspace.
   */
  for (i=0; i < (row-1) && i < pself->HTGT_rowSize; i++) {
	*yPixel += (array[i] + pself->HTGT_cellspacing);
  }
  *yPixel += pself->HTGT_cellspacing;
  /*
   *  Add up the space for column widths and the cellspace.
   */
  for (i=0; i < (col-1) && i < pself->HTGT_columnSize; i++) {
	*xPixel += (array2[i] + pself->HTGT_cellspacing);
  }
  *xPixel += pself->HTGT_cellspacing;

  return;
}	/* End of MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_INCREMENT_ROW_COUNT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Increment the row count whenever <TR> is seen
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Increment the row count.
 *		Reset the column count to 1.
 *		This (row count, column count) will be the table
 *		 position of the next table cell object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 5/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_INCREMENT_ROW_COUNT
{
  int i, *array;
  /*
   *  Reset the position count for the next new table cell.
   */
  pself->HTGT_rowNo++;
  if (pself->HTGT_rowNo > pself->HTGT_rowSize) {
    /*
     *  Realloc the array.
     */
    EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
    i = pself->HTGT_rowSize;
    pself->HTGT_rowSize += ROW_SIZE;
    LMemReAllocHandles(HandleOf(oself), 
		       pself->HTGT_rowHeight, 
		       sizeof(int) * pself->HTGT_rowSize);
    array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
    for (; i < @self->HTGT_rowSize; i++) array[i] = 0;
  }

  @self->HTGT_colNo = 1;	/* reset to 1 */
}	/* End of MSG_GEN_TABLE_INCREMENT_ROW_COUNT.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_INCREMENT_COL_COUNT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Increment the col count for any new <TH> or <TD>
 * PARAMETERS:	    (int incAmount)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This column count is the suggested column position in
 *		the current row.  (Note, the actual column position 
 *		for the new table cell object will be determined by 
 *		taking into account any nearby object that spans over
 *		rows or columns.)
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 6/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_INCREMENT_COL_COUNT
{
  int *array, i;

  pself->HTGT_colNo += incAmount;
  if (pself->HTGT_colNo > pself->HTGT_columnSize) {
    /*
     *  Realloc the array.
     */
    EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
    i = pself->HTGT_columnSize;
    pself->HTGT_columnSize += COLUMN_SIZE;
    LMemReAllocHandles(HandleOf(oself),
		       pself->HTGT_colWidth, 
		       sizeof(int) * pself->HTGT_columnSize);
    array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
    for (; i < @self->HTGT_columnSize; i++) array[i] = 0;

    i = @self->HTGT_columnSize - COLUMN_SIZE;
    LMemReAllocHandles(HandleOf(oself),
		      @self->HTGT_finalColWidth, 
		      sizeof(int) * @self->HTGT_columnSize);
    array = (int*)LMemDerefHandles(HandleOf(oself), 
				   @self->HTGT_finalColWidth);
    for (; i < @self->HTGT_columnSize; i++) array[i] = 0;
  }
  /*
   *  Keep track of the maximum number of columns among all table rows.
   */
  if ((@self->HTGT_colNo - 1) > @self->HTGT_numCols)
	@self->HTGT_numCols = @self->HTGT_colNo - 1;

}	/* End of MSG_GEN_TABLE_INCREMENT_COL_COUNT.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_GET_ROWSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	   Given the starting row number and ROWSPAN, accumulate
 *		   the heights of the rows that the cell spans.
 * PARAMETERS:	   (int rowNo, int rowSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_ROWSPAN_SIZE
{
  int height, *array;

  EC_ERROR_IF(rowNo < 1, UIG_ERROR_IN_TABLE);
  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_rowHeight);

  for(height = 0, --rowNo; rowSpan > 0 && rowNo < pself->HTGT_rowNo; 
      rowSpan--, rowNo++) {
    height += array[rowNo];
  }

  return height;
}	/* End of MSG_GEN_TABLE_GET_ROWSPAN_SIZE.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_GET_COLSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	  Given the starting column number and COLSPAN, 
 *		  accumlate the widths of the columns that the cell spans.
 * PARAMETERS:	  int (int colNo, int colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_COLSPAN_SIZE
{
  int width, *array;

  EC_ERROR_IF(colNo < 1, UIG_ERROR_IN_TABLE);
  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_colWidth);

  for(width = 0, --colNo; colSpan > 0 && colNo < pself->HTGT_colNo; 
      colSpan--, colNo++) {
    width += array[colNo];
  }
  return width;
}	/* End of MSG_GEN_TABLE_GET_COLSPAN_SIZE.	*/


