/***********************************************************************
 *	MSG_GEN_TABLE_DISTRIBUTE_COLUMN_WIDTH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the parent's width, either distribute the 
 *                  width equally among the table columns, or use it to
 *                  blow up the proportion of the columns.
 * PARAMETERS:	    (int width)  width - the parent object's width
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_DISTRIBUTE_COLUMN_WIDTH
{
  int share_w, i, sum_w, sum_pixel = 0, sum_percent = 0, no_value = 0,
    *array, *array2;
  Boolean  percent = FALSE, pixel = FALSE;

  if (pself->HTGT_numCols == 0)
    return;

  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_colWidth);
  array2 =(int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_finalColWidth);

  if (array2[0] == 0) {
    /*
     *  The table is doing its first pass of calculating the sizes
     *  of its children.
     */
    /*
     *  Scan through column widths to see if they have correct values.
     */
    for (i=0; i < pself->HTGT_numCols; i++) {
      if (array[i] > 0) {
	pixel = TRUE;
	sum_pixel += array[i];
      }
      else if (array[i] < 0) {
	percent = TRUE;
	sum_percent += array[i];
      }
      else
	no_value++;
    }
    /* 
     *  Width values MUST uniformly either be in % or in absolute pixels.
     */
    if (pixel == TRUE && percent == TRUE) {
      /*
       *  Absolute pixel value overwrite the percent value.
       */
      for (i=0; i < pself->HTGT_numCols; i++) {
	if (array[i] < 0)
	  array[i] = width / pself->HTGT_numCols;
      }
    }
    else if (pixel == FALSE && percent == TRUE) {
      /*
       *  Make sure percentages add up to 100%!
       */
      if (sum_percent != -100) {
	for (i=0; i < pself->HTGT_numCols; i++) {
	  if (array[i] == 0) {
	    if (sum_percent > -100)
	      array[i] = -((100+sum_percent) / no_value);
	    else
	      array[i] = (100+sum_percent) / no_value;
	  }
	}
      }
      for (i=0; i < pself->HTGT_numCols; i++) {
	array[i] = 
	  (((float)(-array[i])) / (float)100) * width ;
      }
    }
    else if (pixel == TRUE && percent == FALSE) {
      if (sum_pixel < width) {
	for (i=0; i < pself->HTGT_numCols; i++) {
	  if (array[i] == 0)
	    array[i] = (width - sum_pixel) / no_value;
	}
      }
      else {
	for (i=0; i < pself->HTGT_numCols; i++) {
	  if (array[i] == 0)
	    array[i] = (width) / pself->HTGT_numCols;
	}
      }
    }
    else /* if (pixel == FALSE && percent == FALSE) */ {
      /*
       *  Table cell elements (<TD> or <TH>) didn't have WIDTH attribute.
       *  Thus, We make our own guess about the column widths by
       *  dividing the width equally among all the columns.
       */
      share_w = width / pself->HTGT_numCols;
      for (i=0; i < pself->HTGT_numCols; i++) {
	array[i] = share_w;
      }
    }
  }
  else {
    /*
     *  The table is doing its second pass of re-calculating the sizes
     *  of its children.
     */
    if (pself->HTGT_width) {
      /*
       *  Now, we can use the current column widths
       *  and adjust its proportion to the right sizes.
       */
      for (i=0, sum_w=0; i < pself->HTGT_numCols; i++)
	sum_w += array2[i];
      /*
       *  If there is CELLSPACING attr, we need to take it into account.
       */
      width -= (pself->HTGT_numCols+1) * pself->HTGT_cellspacing;
      /*
       *  Now blow up the proportion of each columns
       */
      if (width > 0)
	for (i=0; i < pself->HTGT_numCols; i++) {
	      array[i]=
		  (((float)array2[i])/(float)sum_w)*width;
	}
    }
  }
  return;
}	/* End of MSG_GEN_TABLE_DISTRIBUTE_COLUMN_WIDTH.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the width of the column at colPos.  This width
 *		    is the calculated value from the Geometry Manager
 *		    after all its children sizes have been resized.
 *                  Return the maximun width seen so far for this column
 *                  Or the width adjusted for the colSpan.
 * PARAMETERS:	    int (int colPos, int width, bye colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
{
  int acc_width, span = colSpan, pos = colPos, *array, *array2;

  EC_ERROR_IF(colPos < 1, UIG_ERROR_IN_TABLE);
  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_colWidth);
  array2 =(int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_finalColWidth);

  if (colSpan == 1) {
    if (array2[colPos-1] < width)
      array2[colPos-1] = width;
  }
  
  for(acc_width = 0, --colPos; colSpan > 0; colSpan--, colPos++) {
    acc_width += array2[colPos];
  }
  if (acc_width == 0 && span > 0) {
    /*  Too bad that we are in the first row and have no previous
	row to give us this information */
    for(--pos; span > 0; span--, pos++) {
      acc_width += array[pos];
      array2[pos] = array[pos];
    }
  }
  return acc_width;
}	/* End of MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_STORE_TCELL_WIDTH for HTGenTableClass
 ***********************************************************************
