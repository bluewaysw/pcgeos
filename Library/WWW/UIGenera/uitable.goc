/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Free allocated space.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/10/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_DESTROY
{
  @callsuper();
  LMemFreeHandles(HandleOf(oself), pself->HTGT_rowHeight);
  LMemFreeHandles(HandleOf(oself), pself->HTGT_colWidth);
  LMemFreeHandles(HandleOf(oself), pself->HTGT_finalColWidth);

  return;
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Disable the 3-D border when printing.
 * PARAMETERS:	    (DrawFlags drawFlags, GStateHandle gstate = bp)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 7/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_DRAW
{
  word ra, lo;

  if (drawFlags & DF_PRINT) {
    /*
     *  Delete any 3-D hints in printing.
     */
    ra = @call self::MSG_META_DELETE_VAR_DATA(HINT_DRAW_STYLE_3D_RAISED);
    lo = @call self::MSG_META_DELETE_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED);
    /*
     *  Draw in flat style
     */
    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_FLAT,0,NULL);
    @callsuper();
    @call self::MSG_META_DELETE_VAR_DATA(HINT_DRAW_STYLE_FLAT);
    /*
     *  Restore any 3-D hints.
     */
    if (!ra)
      @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_RAISED,0,NULL);
    if (!lo)
      @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED,0,NULL);
  }
  else
    @callsuper();
  return;
}	/* End of MSG_VIS_DRAW.	*/



/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenTCellClass
 ***********************************************************************
 * SYNOPSIS:	Intercept this message and update its genParent about
 *		its new size.  Thus, later the parent will know how
 *		much it should expand itself.
 * PARAMETERS:	    SizeAsDWord (RecalcSizeArgs width,
 *				RecalcSizeArgs height)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;
  CompSizeHintArgs sizeArgs;
  int max_width, value;
  Boolean forceSize = FALSE;

  /*
   *  Get the suggested width of the table cell.
   */
  width = @call @genParent::MSG_GEN_TABLE_GET_COLSPAN_SIZE
		(pself->HTGTC_colPos, pself->HTGTC_colSpan);
  if (!(pself->HTGTC_positioning)) {
    sizeArgs.CSHA_width = SST_PIXELS | width;
    sizeArgs.CSHA_height = 0;
    sizeArgs.CSHA_count = 1;
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
    pself->HTGTC_positioning = TRUE;
    /*    if (pself->HTGTC_cellType == CELL_HEADER)
      @call self::MSG_META_ADD_VAR_DATA
	(HINT_ORIENT_CHILDREN_HORIZONTALLY,0,0); */
    size = @callsuper();
    /*
     *  Tell the parent about its actual cell width and also get
     *  the size adjusted to the colspan.
     */
    @call self::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();
    @send @genChildren::MSG_META_UIG_CALC_POSITION();
    max_width = @call @genParent::MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
	(pself->HTGTC_colPos, pself->HTGHC_maxRowWidth, 
	 pself->HTGTC_colSpan);
    /*
     *  Sum up the heights of rows in this table cell.
     */
    height = @call self::MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS();
    /*
     *  Update the maximum height seen so far, in the parent.
     */
    @call @genParent::MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT(
		pself->HTGTC_rowPos, height);
  }
  else {
    sizeArgs.CSHA_width = 0;
    @call self::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
    if (width != sizeArgs.CSHA_width) {
      /*
       *  If current assigned width is different from the previous
       *  assigned width, that means the parent has done a second pass
       *  of the re-calculation of the columns widths.  Thus, the 
       *  table cell needs to updates its fixed size to reflect the
       *  new width from the parent's second pass of calculation.
       */
      sizeArgs.CSHA_width = SST_PIXELS | width;
      sizeArgs.CSHA_height = sizeArgs.CSHA_count = 0;
      @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
      forceSize = TRUE;
    }
    size = @callsuper();
    @call self::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();
    @send @genChildren::MSG_META_UIG_CALC_POSITION();
    height = @call self::MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS();
    @call @genParent::MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT(
		pself->HTGTC_rowPos, height);
    /*
     *  Get the height.
     */
    height = @call @genParent::MSG_GEN_TABLE_GET_ROWSPAN_SIZE
		(pself->HTGTC_rowPos, pself->HTGTC_rowSpan);
    if (forceSize == TRUE || (DWORD_WIDTH(size) == 0))
      size = MAKE_SIZE_DWORD(width, DWORD_HEIGHT(size));
    /*
     *  Tell the parent about its actual cell width and also get the
     *  size adjusted to the colspan.
     */
    max_width = @call @genParent::MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
      (pself->HTGTC_colPos, DWORD_WIDTH(size),pself->HTGTC_colSpan);
  }
  size = MAKE_SIZE_DWORD(max_width, height);
  /*
   *  Finish the last row.
   */
  @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &value);

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenTCellClass
 ***********************************************************************
 * SYNOPSIS:	Intercept this message and ask its parent, which is
 *		a table object, for its position(in pixels).  Also,
 *		set its vis bound if this cell spans rows or columns.
 * PARAMETERS:	    void (int xOrigin, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord position;
  /*
   *  Get the parent's absolute position in pixels.
   */
  position = @call @genParent::MSG_VIS_GET_POSITION();
  /*
   *  Ask the parent the (left, top) position, relatvie to the table's 
   *  origin, given row number and column number.
   */
  @call @genParent::MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION(
	pself->HTGTC_rowPos, pself->HTGTC_colPos,
	&xOrigin, &yOrigin);
  /*
   *  Calculate the cell's (left, top) absolute position, in pixels.
   */
  xOrigin += DWORD_X(position);
  yOrigin += DWORD_Y(position);

  @callsuper();
  @call self::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID, 
				   VUM_DELAYED_VIA_UI_QUEUE);

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



