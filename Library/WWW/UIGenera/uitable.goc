/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept this message and calculate its size 
 *		    manually.
 * PARAMETERS:	    SizeAsDWord (RecalcSizeArgs width,
 *				RecalcSizeArgs height)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_RECALC_SIZE
{
  int i, *array, *array2;
  SizeAsDWord size;
  CompSizeHintArgs sizeArgs;

  sizeArgs.CSHA_width = 0;		/* clear the field */

  @call self::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  if (sizeArgs.CSHA_width == 0) {	/* Has the width been set before? */
    /*
     *  Set the width of the table cell object.
     *
     *  Two sources where we can get the width:
     *	1) The WIDTH attribute stored in HTGT_width
     *	2) The parent width sets the width of this object.
     */
    if (pself->HTGT_width) {
      /*
       *  Method (1), the table specifies its own size, according to
       *  the WIDTH attribute.
       */
      if (pself->HTGT_width < 0) {
        /*
         *  HTGT_width is negative, that means the width is a percentage
	 *  of the parent size.
         */
        @call @genParent::MSG_META_GET_VAR_DATA
	  (HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
        /* assume CSHA_width is in SST_PIXELS */
	width = sizeArgs.CSHA_width * (- pself->HTGT_width) / 100;
        sizeArgs.CSHA_width = SST_PIXELS | width;
      }
      else
	/*
	 *  HTGT_width stores an absolute size in pixels.
	 */
        sizeArgs.CSHA_width = SST_PIXELS | pself->HTGT_width;
    }
    else {
      /*
       *  Method (2), the parent size determine the size of the table
       *  cell.
       */
      @call @genParent::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
      width = sizeArgs.CSHA_width;	/* assume it's SST_PIXELS */
      sizeArgs.CSHA_width = SST_PIXELS | width; /* - NESTED_MARGIN; */
    }
    /*
     *  Set the width.
     */
    sizeArgs.CSHA_height = 0;
    sizeArgs.CSHA_count = 1;
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  }
  /*
   *  Now we know the size of the table and the number of columns in
   *  the table.  So we can distribute the table width to determine
   *  the size of each column.
   */
  width = sizeArgs.CSHA_width;
  @call self::MSG_GEN_TABLE_DISTRIBUTE_COLUMN_WIDTH(width);

  size = @callsuper();
  /*  @send @genChildren::MSG_VIS_RECALC_SIZE(width, height); */
     
  /*
   *  After calling the super class, all the children under the table
   *  cell have calculate its size.  Thus, HTGT_rowHeight and 
   *  HTGT_colWidth contain the updated infomation, which we can use
   *  to shrink the table cell tight to contain all the children objects.
   */
  array = (int *)LMemDerefHandles(HandleOf(oself), pself->HTGT_rowHeight);
  for (i=0, height = 0; array[i] != 0 && i < pself->HTGT_rowSize; i++){
	height += (array[i] + pself->HTGT_cellspacing);
  }
  array2 = (int *)LMemDerefHandles(HandleOf(oself),pself->HTGT_finalColWidth);
  for (i=0, width = 0; array2[i] != 0 && i < pself->HTGT_columnSize; i++) {
	width += (array2[i] + pself->HTGT_cellspacing);
  }
  size = MAKE_SIZE_DWORD(
	width + pself->HTGT_cellspacing,
	height+ pself->HTGT_cellspacing);

  return size;   
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_META_UIG_CALC_POSITION for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/31/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_META_UIG_CALC_POSITION
{
  int row;
  SizeAsDWord size = @call self::MSG_VIS_GET_SIZE();
  /*
   *  Get an estimate position of the object
   */
  pself->HTGT_xPos = UpdateItsPotentialPosition(oself, size, &row);
  pself->HTGT_pageRow = row;

  return;
}	/* End of MSG_META_UIG_CALC_POSITION.	*/



