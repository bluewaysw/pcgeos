  array[colPos-1] = width;

  return;
}	/* End of MSG_GEN_TABLE_STORE_TCELL_WIDTH.	*/



/***********************************************************************
 *		MSG_GEN_TCELL_PROCESS_ATTRIBUTE for HTGenTCellClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the TR element
 * PARAMETERS:	    int (MemHandle block, SGMLEntity *entity, 
 *			int type, optr table)
 *		    if type is non-zero, it's <TH>, else it's <TD> cell.
 *		    return colspan number
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		Supported Attr:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_GEN_TCELL_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j, align = -1, valign = 1;
  Boolean percent = FALSE;

  pself->HTGTC_rowSpan = pself->HTGTC_colSpan = 1;

  if (type)
    pself->HTGTC_cellType = CELL_HEADER;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_ALIGN:                                  /* ALIGN */
      if (strcasecmp(value, "left") == 0)
	align = 0;
      else if (strcasecmp(value, "center") == 0)
	align = 1;
      else if (strcasecmp(value, "right") == 0)
	align = 2;
      break;
    case HTML_ATTR_VALIGN:                                 /* VALIGN */
      if (strcasecmp(value, "top") == 0)
	valign = 0;
      else if (strcasecmp(value, "middle") == 0)
	valign = 1;
      else if (strcasecmp(value, "bottom") == 0)
	valign = 2;
      break;
    case HTML_ATTR_ROWSPAN:                                /* ROWSPAN */
      pself->HTGTC_rowSpan = atoi(value);
      break;
    case HTML_ATTR_COLSPAN:                                /* COLSPAN */
      pself->HTGTC_colSpan = atoi(value);
      break;
    case HTML_ATTR_WIDTH:                                  /* WIDTH */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE)
	@send table::MSG_GEN_TABLE_STORE_TCELL_WIDTH
	  (pself->HTGTC_colPos, atoi(value));
      else
	@send table::MSG_GEN_TABLE_STORE_TCELL_WIDTH
	  (pself->HTGTC_colPos, -atoi(value));
      /* negative value means % */
      break;
    }
  }
  switch (align) {
    case 0:	/* left align */
/*      @send self::MSG_META_ADD_VAR_DATA
		(HINT_LEFT_JUSTIFY_CHILDREN,0,NULL);  default already */
      break;
    case 1:	/* center align */
      @send self::MSG_META_ADD_VAR_DATA
		(HINT_CENTER_CHILDREN_HORIZONTALLY,0,NULL);
      break;
    case 2:	/* right align */
      @send self::MSG_META_ADD_VAR_DATA
		(HINT_RIGHT_JUSTIFY_CHILDREN,0,NULL);
      break;
/*    default:
      if (type)
	@send self::MSG_META_ADD_VAR_DATA(
		HINT_CENTER_CHILDREN_HORIZONTALLY,0,NULL);
*/
  }

  switch (valign) {
    case 0:		/* top align */
      @send self::MSG_META_ADD_VAR_DATA
	(HINT_TOP_JUSTIFY_CHILDREN,0,NULL);
      break;
    case 1:		/* center align */
      @send self::MSG_META_ADD_VAR_DATA
	(HINT_CENTER_CHILDREN_VERTICALLY, 0, NULL);
      break;
    case 2:		/* bottom align */
      @send self::MSG_META_ADD_VAR_DATA
	(HINT_BOTTOM_JUSTIFY_CHILDREN, 0, NULL);
      break;
  }
  return pself->HTGTC_colSpan;
}


