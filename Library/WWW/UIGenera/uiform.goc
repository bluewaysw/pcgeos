/***********************************************************************
 *	MSG_GEN_FORM_TEXT_PROCESS_ATTRIBUTE for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Process the <TEXTAREA> attribute list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Attributes processed:  NAME, COLS, ROWS.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_FORM_TEXT_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index, cols = 12, rows = 1;
  HTMemHandle nameOptr;
  CompSizeHintArgs sizeArgs;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      nameOptr = HTMemAlloc(sizeof(char) * (strlen(value)+1));
      cptr = (char *)HTMemLock(nameOptr);
      strcpy(cptr,value);
      HTMemUnlock(nameOptr);
      pself->HTGFT_name = nameOptr;
      break;
    case HTML_ATTR_COLS:
      cols = atoi(value);
      if (cols > 75)
	  cols = 75;
      else if (cols <= 0)
	  cols = 12;     /* get back to default */
      break;
    case HTML_ATTR_ROWS:
      rows = atoi(value);
      if (rows > 50)
	  rows = 50;
      else if (rows <= 0)
	  rows = 1;     /* get back to default */
      break;
    }
  }
  sizeArgs.CSHA_width = SST_AVG_CHAR_WIDTHS | cols;
  sizeArgs.CSHA_height = SST_LINES_OF_TEXT | rows;
  sizeArgs.CSHA_count = 0;
  EC_ERROR_IF(cols < 0, UIG_ERROR_NEGATIVE_WIDTH);
  @call self::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  return;
}	/* End of MSG_GEN_FORM_TEXT_PROCESS_ATTRIBUTE.	*/


