/***********************************************************************
 *		MSG_META_UIG_CALC_POSITION for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row number and X position.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/31/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_META_UIG_CALC_POSITION
{
  int row;
  SizeAsDWord size = @call self::MSG_VIS_GET_SIZE();
  /*
   *  Get an estimate position of the object
   */
  pself->HTGF_xPos = UpdateItsPotentialPosition(oself, size, &row);
  pself->HTGF_pageRow = row;
  return;
}	/* End of MSG_META_UIG_CALC_POSITION.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set its new X and Y position
 * PARAMETERS:	    (int xOrigin = cx, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_VIS_POSITION_BRANCH
{
#if 0
  /*
  @send @genChildren::MSG_VIS_POSITION_BRANCH(0,0);
  @send self::MSG_VIS_MARK_INVALID
     (VOF_IMAGE_INVALID, VUM_DELAYED_VIA_UI_QUEUE);
     */
#endif
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
    
  xOrigin = DWORD_X(xy) + pself->HTGF_xPos;
  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight(oself, pself->HTGF_pageRow);

  @callsuper();

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;
  CompSizeHintArgs sizeArgs;
  int value;

  sizeArgs.CSHA_width = 0;
  @call self::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  if (sizeArgs.CSHA_width == 0) {
    @call @genParent::MSG_META_GET_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
    width = sizeArgs.CSHA_width;	/* assume it's SST_PIXELS */
    if (width > NESTED_MARGIN)
      sizeArgs.CSHA_width = width - NESTED_MARGIN;
    else
      sizeArgs.CSHA_width = width;
    sizeArgs.CSHA_count = 0;
    sizeArgs.CSHA_height = 0;
    EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  }
  else
    width = sizeArgs.CSHA_width;	/* assume it's SST_PIXELS */

  size = @callsuper();
  /*
   *  Clear all the row information.  Tell its children to calculate
   *  their own position and store that information in a heigtArray.
   */
  @call self::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();
  @send @genChildren::MSG_META_UIG_CALC_POSITION();
  /*
   *  Sum up the heights of rows in this form.
   */
  height = @call self::MSG_GEN_HTML_CONTENT_SUM_ROW_HEIGHTS();
  
  size = MAKE_SIZE_DWORD(width, height);
  /*
   *  Finish the last row.
   */
  @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &value);

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



