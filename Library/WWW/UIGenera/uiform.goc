}	/* End of MSG_VIS_DRAW.	*/



/***********************************************************************
 *		AddInputToForm
 ***********************************************************************
 *
 * SYNOPSIS:	Add the input object to the linked list under the form.
 * CALLED BY:	(optr form, optr inputObj)
 * RETURN:	void 
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
void
AddInputToForm (optr form, optr inputObj)
{
  while(!@call form::MSG_META_IS_OBJECT_IN_CLASS(&HTGenFormClass)) {
    form = @call form::MSG_GEN_FIND_PARENT();
    if (@call form::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass)){
      EC_WARNING(UIG_INVALID_OPERATION);
      return;
    }
  }
  @send inputObj::MSG_GEN_ITEM_GROUP_SET_DESTINATION(form);
  @call form::MSG_GEN_FORM_ADD_INPUT(inputObj);
  return;
}	/* End of AddInputToForm.	*/

/***********************************************************************
 *		FormGeneratorNameValuePairs
 ***********************************************************************
 *
 * SYNOPSIS:	Generate Name/Value pair for each form items.
 * CALLED BY:	
 * RETURN:	none
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/26/97   	Initial Revision
 *	
 ***********************************************************************/
void
FormGeneratorNameValuePairs (optr object, HTListHandle query)
{
  optr child;
  int i, cnt;
  ClassStruct *class;

  if ((cnt = @call object::MSG_GEN_COUNT_CHILDREN()) == 0)
    return;

  for (i = 0; i < cnt; i++) {
    child = @call object::MSG_GEN_FIND_CHILD_AT_POSITION(i);
    class = @call child::MSG_META_GET_CLASS();
    if (class == (ClassStruct *)&HTGenFormTextClass)
      @call child::MSG_GEN_FORM_TEXT_SUBMIT(query);
/*    else if (class == (ClassStruct *)&HTTextAreaClass)
      @call child::MSG_HTTA_SUBMIT(query);
*/
    else if (class == (ClassStruct *)&HTGenFormHiddenClass)
      @call child::MSG_GEN_FORM_HIDDEN_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenFormTriggerClass)
      @call child::MSG_GEN_FORM_TRIGGER_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenOuterSelectClass) {
      /* HTGenSelect is the child of HTGenOuterSelect */
      child = @call child::MSG_GEN_FIND_CHILD_AT_POSITION(0);
      @call child::MSG_GEN_SELECT_SUBMIT(query);
    }
    else if (class == (ClassStruct *)&HTGenMultiLineSelectClass)
      @call child::MSG_HTGMLS_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenInputClass)
      @call child::MSG_GEN_INPUT_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenTextClass)
      	;
    else if (@call child::MSG_GEN_COUNT_CHILDREN() > 0) {
      FormGeneratorNameValuePairs(child, query);
    }
  }
  return;
}	/* End of FormGeneratorNameValuePairs.	*/
