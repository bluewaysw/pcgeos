/* The code for MultiLineSelection. */

/***********************************************************************
 *		MSG_HTGMLS_PROCESS_ATTRIBUTE for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index = 0;

  @self->HTGMLS_exclusive = TRUE;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if(entity[index].SGMLE_token == HTML_ATTR_MULTIPLE) {
      	@self->HTGMLS_exclusive = FALSE;
	continue;
    }

    if (!entity[index].SGMLE_value)
	continue;

    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);

    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      /* allocate a chunk to store the NAME data */
      @self->HTGMLS_name = LMemAlloc(HandleOf(oself), strlen(value)+1);
      cptr = (char *)LMemDerefHandles(HandleOf(oself), @self->HTGMLS_name);
      strcpy(cptr,value);
      break;
    case HTML_ATTR_SIZE:
      pself->HTGMLS_size = atoi(value);
      /* the size must be greater than one! */
      EC_ERROR_IF(pself->HTGMLS_size <= 1, UIG_UI_TREE_OPERATION_FAILS);
      break;
    }
  }
  return;
}	/* End of MSG_HTGMLS_PROCESS_ATTRIBUTE.	*/



/***********************************************************************
 *		MSG_HTGMLS_ADD_ONE_OPTION_VALUE for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	 char *value, Boolean selected
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
typedef struct {
    Boolean OS_selected;
    Boolean OS_default;
    byte    OS_valueOffset;
    byte    OS_textOffset;
} OptionStruct;

@method HTGenMultiLineSelectClass, MSG_HTGMLS_ADD_OPTION_VALUE
{
    OptionStruct *option;

    /*
     * Check if there is a valid chunkarray. 
     */
    if(!@self->HTGMLS_optionsHandle) {
	/* Create one memory block for it. */
	@self->HTGMLS_optionsHandle = MemAllocLMem(LMEM_TYPE_GENERAL,
					sizeof(LMemBlockHeader));
	MemLock(@self->HTGMLS_optionsHandle);

    	/* Create a chunkarray for it. */
	@self->HTGMLS_optionsChunk = ChunkArrayCreate(
				@self->HTGMLS_optionsHandle,
				0, sizeof(ChunkArrayHeader), 0);
	MemUnlock(@self->HTGMLS_optionsHandle);
    }

    MemLock(@self->HTGMLS_optionsHandle);

    option = ChunkArrayAppendHandles(@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk,
			sizeof(OptionStruct) + strlen(value) + 1);
    option->OS_selected = selected;
    option->OS_default = selected;
    option->OS_valueOffset = sizeof(OptionStruct);
    option->OS_textOffset = sizeof(OptionStruct) + strlen(value) + 1;
    strcpy((char *)((char *)option + option->OS_valueOffset), value);

    MemUnlock(@self->HTGMLS_optionsHandle);
  
    return;
}	/* End of MSG_HTGMLS_ADD_OPTION_VALUE.	*/



/***********************************************************************
 *		MSG_HTGMLS_ADD_OPTION_TEXT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    char *text
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_ADD_OPTION_TEXT
{
    OptionStruct *option;
    int	last;
    word size;
    GStateHandle gstate;

    gstate = GrCreateState(0);

    /*
     * Check if there is a valid chunkarray. 
     */
    if(!@self->HTGMLS_optionsHandle) {
	/* Create one memory block for it. */
	@self->HTGMLS_optionsHandle = MemAllocLMem(LMEM_TYPE_GENERAL,
					sizeof(LMemBlockHeader));
	MemLock(@self->HTGMLS_optionsHandle);

    	/* Create a chunkarray for it. */
	@self->HTGMLS_optionsChunk = ChunkArrayCreate(
				@self->HTGMLS_optionsHandle,
				0, sizeof(ChunkArrayHeader), 0);

     	option = ChunkArrayAppendHandles(@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk,
			sizeof(OptionStruct) + strlen(text) + 1);
    	option->OS_selected = FALSE;
  	option->OS_valueOffset = sizeof(OptionStruct);
  	option->OS_textOffset = sizeof(OptionStruct);
    	strcpy((char *)((char *)option + option->OS_textOffset), text);

	MemUnlock(@self->HTGMLS_optionsHandle);

   	return;
    }

    MemLock(@self->HTGMLS_optionsHandle);

    last = ChunkArrayGetCountHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_optionsChunk) - 1;

    if(last < 0) return;

    option = ChunkArrayElementToPtrHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_optionsChunk, last, &size);

    ChunkArrayElementResizeHandles(
			@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk, 
			last,
			size + strlen(text) + 1);

    option = ChunkArrayElementToPtrHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_optionsChunk, last, &size);

    strcpy((char *)((char *)option + option->OS_textOffset), text);

    MemUnlock(@self->HTGMLS_optionsHandle);

    /* 
     * Find the longest text string. 
     */ 
    size = GrTextWidth(gstate, text, strlen(text));
    if(size > @self->HTGMLS_len) @self->HTGMLS_len = size;
  
    return;
}	/* End of MSG_HTGMLS_ADD_OPTION_TEXT.	*/



/***********************************************************************
 *		MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT
{
    optr list, scroll, item, *tmp;
    int i;
    SpecSizeSpec sizeSpec;
    CompSizeHintArgs sizeArgs;
  
    sizeSpec = SST_PIXELS | 0;
   
    sizeArgs.CSHA_width = SST_PIXELS | @self->HTGMLS_len;
    sizeArgs.CSHA_height = SST_LINES_OF_TEXT | 1;
    sizeArgs.CSHA_count = 1;

    EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
    @call self::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);

    MemLock(@self->HTGMLS_optionsHandle);

    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA(
			HINT_ORIENT_CHILDREN_HORIZONTALLY, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA(
			HINT_NO_TALLER_THAN_CHILDREN_REQUIRE, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA(
			HINT_NO_WIDER_THAN_CHILDREN_REQUIRE, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA
		(HINT_CUSTOM_CHILD_SPACING, sizeof(SpecSizeSpec), 
		 &sizeSpec); 

    if( ChunkArrayGetCountHandles(@self->HTGMLS_optionsHandle,
		@self->HTGMLS_optionsChunk) > @self->HTGMLS_size){

    	scroll = ObjInstantiateForThread(0, (ClassStruct *)&GenInteractionClass);
    	@call scroll::MSG_META_ADD_VAR_DATA(
			HINT_ORIENT_CHILDREN_VERTICALLY, 0, NULL);
    	@call scroll::MSG_META_ADD_VAR_DATA(
			HINT_FULL_JUSTIFY_CHILDREN_VERTICALLY, 0, NULL);
    	@call scroll::MSG_META_ADD_VAR_DATA(
			HINT_EXPAND_HEIGHT_TO_FIT_PARENT, 0, NULL);

    	@call self::MSG_GEN_ADD_CHILD(scroll, CCF_MARK_DIRTY);
	@call scroll::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);

    	item = ObjInstantiateForThread(0, (ClassStruct *)&GenTriggerClass);
	@call item::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			"UP", VUM_DELAYED_VIA_APP_QUEUE);
	@call item::MSG_GEN_TRIGGER_SET_ACTION_MSG(MSG_HTGMLS_SCROLL_UP);
	@call item::MSG_GEN_TRIGGER_SET_DESTINATION(oself);	
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_DRAW_STYLE_FLAT, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
		HINT_ALIGN_TOP_EDGE_WITH_OBJECT, sizeof(optr), &scroll);

    	@call scroll::MSG_GEN_ADD_CHILD(item, CCF_MARK_DIRTY);
	@self->HTGMLS_up = item;

    	item = ObjInstantiateForThread(0, (ClassStruct *)&GenTriggerClass);
	@call item::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			"DN", VUM_DELAYED_VIA_APP_QUEUE);
	@call item::MSG_GEN_TRIGGER_SET_ACTION_MSG(MSG_HTGMLS_SCROLL_DOWN);
	@call item::MSG_GEN_TRIGGER_SET_DESTINATION(oself);	
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_DRAW_STYLE_FLAT, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
		HINT_ALIGN_BOTTOM_EDGE_WITH_OBJECT, sizeof(optr), &scroll);

    	@call scroll::MSG_GEN_ADD_CHILD(item, CCF_MARK_DIRTY);
	@call item::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
	@self->HTGMLS_down = item;
    }

    list = ObjInstantiateForThread(0, (ClassStruct *)&GenInteractionClass);

    @call list::MSG_META_ADD_VAR_DATA(
			HINT_ORIENT_CHILDREN_VERTICALLY, 0, NULL);
    @call list::MSG_META_ADD_VAR_DATA
		(HINT_CUSTOM_CHILD_SPACING, sizeof(SpecSizeSpec), 
		 &sizeSpec); 

    @call self::MSG_GEN_ADD_CHILD(list, CCF_MARK_DIRTY);
    @call list::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);

    /* Create a chunkarray to hold the children. */
    @self->HTGMLS_itemChunk = ChunkArrayCreate(
				@self->HTGMLS_optionsHandle,
				sizeof(optr), sizeof(ChunkArrayHeader), 0);

    for(i=0; i<@self->HTGMLS_size; i++) {
	item = ObjInstantiateForThread(0, (ClassStruct *)&HTOtherOptionClass);
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_EXPAND_WIDTH_TO_FIT_PARENT, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_EXPAND_HEIGHT_TO_FIT_PARENT, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_DRAW_STYLE_FLAT, 0, NULL);
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);
	EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
    	@call item::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);

	@call list::MSG_GEN_ADD_CHILD(item, CCF_MARK_DIRTY);
    	tmp = ChunkArrayAppendHandles(@self->HTGMLS_optionsHandle,
			@self->HTGMLS_itemChunk, 0);
	*tmp = item;

	@call item::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
	@call item::MSG_HTOO_SET_ML(oself);
    }
/*
    sizeArgs.CSHA_height = SST_LINES_OF_TEXT | @self->HTGMLS_size;
    EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
    @call list::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
*/

    MemUnlock(@self->HTGMLS_optionsHandle);

    @call self::MSG_HTGMLS_SET_ALL_MONIKER();

}	/* End of MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT.	*/



/***********************************************************************
 *		MSG_HTGMLS_SET_ALL_MONIKER for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_SET_ALL_MONIKER
{
    OptionStruct *option;
    char  *text;
    int  i, realItem;
    word  size;
    optr *item;

    EC_ERROR_IF(!@self->HTGMLS_optionsHandle, UIG_UI_TREE_OPERATION_FAILS);

    MemLock(@self->HTGMLS_optionsHandle);

    for(i=0; i<@self->HTGMLS_size; i++) {
    	realItem = i + @self->HTGMLS_currentFirst;
	item = ChunkArrayElementToPtrHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_itemChunk, 
				@self->HTGMLS_size - i - 1, &size);

	option = ChunkArrayElementToPtrHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_optionsChunk, realItem, &size);
	text = ((char *)option + option->OS_textOffset);

	@send (*item)::MSG_HTOO_SET_SEL(option->OS_selected);

	@send (*item)::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			(char *)text, VUM_DELAYED_VIA_APP_QUEUE);
    }

    MemUnlock(@self->HTGMLS_optionsHandle);
}	/* End of MSG_HTGMLS_SET_ALL_MONIKER.	*/



/***********************************************************************
 *		MSG_HTGMLS_SCROLL_UP for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_SCROLL_UP,
				   MSG_HTGMLS_SCROLL_DOWN
{
    if(message == MSG_HTGMLS_SCROLL_UP) {
	@self->HTGMLS_currentFirst --;
    } else {
	@self->HTGMLS_currentFirst ++;
    }

    @call self::MSG_HTGMLS_SET_ALL_MONIKER();

    if(@self->HTGMLS_currentFirst) 
        @send @self->HTGMLS_up::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
    else 
        @send @self->HTGMLS_up::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_APP_QUEUE);

    MemLock(@self->HTGMLS_optionsHandle);
	
    if( ChunkArrayGetCountHandles(@self->HTGMLS_optionsHandle,
		@self->HTGMLS_optionsChunk) - @self->HTGMLS_currentFirst 
		> @self->HTGMLS_size)
    	@send @self->HTGMLS_down::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
    else
    	@send @self->HTGMLS_down::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_APP_QUEUE);

}	/* End of MSG_HTGMLS_SCROLL_UP.	*/



/***********************************************************************
 *		MSG_HTGMLS_CHANGE_SELECT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    optr item
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_CHANGE_SELECT
{
    word count, i, size, current;
    optr *tmp;
    OptionStruct *option;

    MemLock(@self->HTGMLS_optionsHandle);

    count = ChunkArrayGetCountHandles(@self->HTGMLS_optionsHandle,
		@self->HTGMLS_optionsChunk);

    if(@self->HTGMLS_exclusive) {
	for(i=0; i<@self->HTGMLS_size; i++) {
	    tmp = ChunkArrayElementToPtrHandles(@self->HTGMLS_optionsHandle,
			@self->HTGMLS_itemChunk, i, &size);
	    if(*tmp != item) {
		if (@call (*tmp)::MSG_HTOO_GET_SEL()) {
		    @call (*tmp)::MSG_HTOO_SET_SEL(FALSE);
		    @send (*tmp)::MSG_VIS_INVALIDATE();
	 	}
	    } else
		current = i;
	}

	current = @self->HTGMLS_size - current - 1 
			+ @self->HTGMLS_currentFirst;

	for(i=0; i<count; i++) {
	    option = ChunkArrayElementToPtrHandles(
			@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk, i, &size);
	    if(i == current) 
		option->OS_selected = !option->OS_selected;
	    else if(option->OS_selected) 
		option->OS_selected = FALSE;
	}		

    } else {

	for(i=0; i<@self->HTGMLS_size; i++) {
	    tmp = ChunkArrayElementToPtrHandles(@self->HTGMLS_optionsHandle,
			@self->HTGMLS_itemChunk, i, &size);
	    if(*tmp == item) current = i;
	}

	current = @self->HTGMLS_size - current - 1 
			+ @self->HTGMLS_currentFirst;

	for(i=0; i<count; i++) {
	    option = ChunkArrayElementToPtrHandles(
			@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk, i, &size);
	    if(i == current) 
		option->OS_selected = !option->OS_selected;
	}		
    }

    MemUnlock(@self->HTGMLS_optionsHandle);

}	/* End of MSG_HTGMLS_CHANGE_SELECT.	*/



/***********************************************************************
 *		MSG_HTGMLS_SUBMIT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    HTListHandle query
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_SUBMIT
{
    char *cptr, *name;
    word count, i, size;
    OptionStruct *option;
    HTMemHandle htmh;

    if(!@self->HTGMLS_name) return;

    name = LMemDerefHandles(OptrToHandle(oself), @self->HTGMLS_name);

    MemLock(@self->HTGMLS_optionsHandle);

    count = ChunkArrayGetCountHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_optionsChunk);
	
    for(i=0; i<count; i++) {
	option = ChunkArrayElementToPtrHandles(
			@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk, i, &size);
 	if(option->OS_selected) {
	    cptr = (char *)option + option->OS_valueOffset;
	    htmh = HTStrAllocCopy(name);
	    HTListAppend(query, &htmh, sizeof(HTMemHandle));
	    htmh = HTStrAllocCopy(cptr);
	    HTListAppend(query, &htmh, sizeof(HTMemHandle));
	}
    }

    MemUnlock(@self->HTGMLS_optionsHandle);

  return;
}	/* End of MSG_HTGMLS_SUBMIT.	*/



/***********************************************************************
 *		MSG_GEN_RESET for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_GEN_RESET
{
    word count, i, size;
    OptionStruct *option;

    MemLock(@self->HTGMLS_optionsHandle);

    count = ChunkArrayGetCountHandles(@self->HTGMLS_optionsHandle,
				@self->HTGMLS_optionsChunk);
	
    for(i=0; i<count; i++) {
	option = ChunkArrayElementToPtrHandles(
			@self->HTGMLS_optionsHandle,
			@self->HTGMLS_optionsChunk, i, &size);
	option->OS_selected = option->OS_default;
    }

    MemUnlock(@self->HTGMLS_optionsHandle);

    @self->HTGMLS_currentFirst = 0;
    @send self::MSG_HTGMLS_SET_ALL_MONIKER();

    if(@self->HTGMLS_down && @self->HTGMLS_up) {
    	@send @self->HTGMLS_up::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
    	@send @self->HTGMLS_down::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
    }

    return;
}	/* End of MSG_GEN_RESET.	*/



/***********************************************************************
 *		MSG_META_UIG_CALC_POSITION for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_META_UIG_CALC_POSITION
{
  int row;
  SizeAsDWord size = @call self::MSG_VIS_GET_SIZE();
  /*
   *  Get an estimate position of the object
   */
  pself->HTGMLS_xPos = UpdateItsPotentialPosition(oself, size, &row);
  pself->HTGMLS_pageRow = row;
}	/* End of MSG_META_UIG_CALC_POSITION.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();

  xOrigin = DWORD_X(xy) + pself->HTGMLS_xPos;
  yOrigin = DWORD_Y(xy)+GetItsPotentialHeight(oself, pself->HTGMLS_pageRow);

  @callsuper();
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_META_START_SELECT for HTOtherOptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTOtherOptionClass, MSG_META_START_SELECT
{
    @send (@self->HTOO_multiLine)::MSG_HTGMLS_CHANGE_SELECT(oself);
    @self->HTOO_selected = !@self->HTOO_selected;

    @send self::MSG_VIS_INVALIDATE();
