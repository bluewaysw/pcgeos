/***********************************************************************
 *		MSG_GEN_FORM_TEXT_SUBMIT for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate the name=value pair and store in the query
 *                  list.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Handle <INPUT type=TEXT | PASSWORD name=? value=?>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_FORM_TEXT_SUBMIT
{
  char *value;
  int len;
  HTMemHandle temp;

  if (pself->HTGFT_name) {
    /*
     *  If there is no entered text nor any default text, 
     *  Don't generate a pair.
     */
    len = @call self::MSG_VIS_TEXT_GET_TEXT_SIZE();
    if (len <= 0) return;
    /*
     *  Append the "name".
     */
    temp = HTStrHTMemAllocCopy(pself->HTGFT_name);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
    /*
     *  Append the value
     */
    value = (char *) HTMemAllocAndLock(&temp, sizeof(char) * (len+1));
    @call self::MSG_VIS_TEXT_GET_ALL_PTR(value);
    HTMemUnlock(temp);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
  }
  return;
}	/* End of MSG_GEN_FORM_TEXT_SUBMIT.	*/



/***********************************************************************
 *		MSG_GEN_RESET for HTGenFormTextClass
 ***********************************************************************
 * SYNOPSIS:	    Reset the text object back to its default value, if
 *		    there was any.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_RESET
{
  char *cptr;

  if (pself->HTGFT_value) {
    /*
     *  Ok, there were some default text string.
     */
    cptr = HTMemLock(pself->HTGFT_value);
    @call self::MSG_VIS_TEXT_REPLACE_ALL_PTR(cptr, 0);
    HTMemUnlock(pself->HTGFT_value);
    @call self::MSG_VIS_TEXT_SCREEN_UPDATE();
  }
  else
    /*
     *  Cear any text in the input field.
     */
    @call self::MSG_VIS_TEXT_DELETE_ALL();

  return;
}	/* End of MSG_GEN_RESET.	*/



/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Tell the Geometry Manager to sent 
 *                  MSG_VIS_POSITION_BRANCH instead of calling a routine.
 * PARAMETERS:	    SizeAsDWord (RecalcSizeArgs width, 
 *				 RecalcSizeArgs height)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_RECALC_SIZE
{
  VisTextInstance  * vself;
  SizeAsDWord size;

  size = @callsuper();
  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set its new X and Y position.
 * PARAMETERS:	    (int xOrigin, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();

  xOrigin = DWORD_X(xy) + pself->HTGFT_xPos;
  yOrigin = DWORD_Y(xy) + 
    GetItsPotentialHeight(oself, pself->HTGFT_pageRow) - 1;

  @callsuper();
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



