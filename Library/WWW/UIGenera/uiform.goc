@include <WWW/uigenera.goh>
@include <WWW/pmanager.goh>
@include "uifatals.goh"
#include <Ansi/string.h>
#include <Ansi/stdlib.h>        /* atoi defined */

@classdecl	HTGenFormClass;
@classdecl      HTGenOuterSelectClass;
@classdecl	HTGenSelectClass;
@classdecl	HTGenMultiLineSelectClass;
@classdecl	HTGenInputClass;
@classdecl	HTOtherOptionClass;
@classdecl	HTGenOptionClass;
@classdecl	HTGenFormTextClass;
/*@classdecl	HTTextAreaClass; */
@classdecl	HTGenFormHiddenClass;
@classdecl	HTGenFormTriggerClass;

@extern method HTGenOptionClass, MSG_META_UIG_SELECT_ALL;
@extern method HTGenOptionClass, MSG_META_UIG_SELECT_NONE;

void AddInputToForm(optr form, optr inputObj);
void FormGeneratorNameValuePairs (optr object, HTListHandle query);


/***********************************************************************
 *		MSG_UI_GENERATOR_START_FORM for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	Create a ui object representing a fill-out form.
 *		Information about the form fields are expected to 
 *		be known as more incoming HTML elements are processed.
 *		    
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *	Supported Attr:	ACTION, METHOD
 *
 * INPUT, SELECT and TEXTAREA are only allowed within FORM elements.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_FORM
{
  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
   */
  if ((pself->UIG_target.class == (ClassStruct *)&HTGenTableClass) ||
      (pself->UIG_target.class == (ClassStruct *)&HTGenTCellClass) ) {
    @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(pself->UIG_target.obj);
  }
  else if (pself->UIG_target.obj) {
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ
	(pself->UIG_target.obj);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
       (pself->UIG_target.obj);
#endif
  }
  /*
   * Now create a form object and store it in target.obj.  Next, process
   * the passed attribute list.
   */
  pself->UIG_target.obj = @call pself->UIG_pmObj::\
	MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenFormClass);
  pself->UIG_target.class = (ClassStruct *)&HTGenFormClass;
  /*
   *  Process attributes
   */
  @call pself->UIG_target.obj::MSG_GEN_FORM_PROCESS_ATTRIBUTE
     (block, entity);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_FORM.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_END_FORM for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the presentation manager that the form object
 *		    is ready to be displayed.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_FORM
{
  /* 
   * If there is some object in target.obj, we can assume the object 
   * is done.  Thus, give the object to the presentation manager for
   * rendering.
   */
  if (pself->UIG_target.obj)
	@call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
				(pself->UIG_target.obj);

  if (pself->UIG_target.class != (ClassStruct *)&HTGenFormClass) {
    while (1) {
      @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(pself->UIG_target.obj), &(pself->UIG_target.class));
      EC_ERROR_IF(pself->UIG_target.class == NULL || 
		pself->UIG_target.obj == NULL,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if (pself->UIG_target.class == (ClassStruct *)&HTGenSelectClass)
	@call pself->UIG_target.obj::
		MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
      else if (pself->UIG_target.class == 
				(ClassStruct *)&HTGenMultiLineSelectClass)
	@call pself->UIG_target.obj::
		MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT();
      
      if (pself->UIG_target.class == (ClassStruct *)&HTGenFormClass)
	  break;
    }
  }

  /*
   * Tell the receiving object(which must be a HTGenForm object) in 
   * the ui tree that there are no more children for it.  So the 
   * presentation manager can mark it usable and display it.
   */
  @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
	(&(pself->UIG_target.obj), &(pself->UIG_target.class));
#if 1
  @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
     (pself->UIG_target.obj);
#endif
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_FORM.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_START_SELECT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a HTGenSelect object and process the 
 *		    attribute list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_SELECT
{
  char *value;
  int	index, size = 0;
  Boolean multiLine = FALSE;

  /*
   *  Finish and append whatever ui object in the target to the ui tree.
   *  Return the form object that contains that ui object.
   */
  FinishCurrentObjectInForm(pself->UIG_pmObj, &(pself->UIG_target));

  /* 
   * Go to get the attributes first. Use the size to determine which 
   * kind selection object to create, either HTGenSelectClass or
   * HTGenMultiLineSelectClass.
   */

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    if(entity[index].SGMLE_token == HTML_ATTR_SIZE) {
      size = atoi(value);
      if (size > 1) multiLine = TRUE;
      break;
    }
  }

  /*
   *  Now create a select object and store it in target.obj.
   *  Then, process the passed attribute list.
   */
  if(!multiLine) {
      /*
       *  Create a dummy container for the HTGenSelectClass.  This container
       *  is used to get the size of the GenItemGroup customized in the
       *  penelope SPUI.
       */
      pself->UIG_target.obj = @call pself->UIG_pmObj::\
	  MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenOuterSelectClass);
      @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	 (pself->UIG_target.obj);
      pself->UIG_target.obj = @call pself->UIG_pmObj::\
	  MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenSelectClass);
      pself->UIG_target.class = (ClassStruct *)&HTGenSelectClass;
      @call pself->UIG_target.obj::MSG_GEN_SELECT_PROCESS_ATTRIBUTE
          (block, entity);

      @call pself->UIG_target.obj::MSG_META_ADD_VAR_DATA
	  (HINT_ORIENT_CHILDREN_HORIZONTALLY, 0, NULL);
      @call pself->UIG_target.obj::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED
	  (FALSE);
  } else {
      pself->UIG_target.obj = @call pself->UIG_pmObj::\
	  MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenMultiLineSelectClass);
      pself->UIG_target.class = (ClassStruct *)&HTGenMultiLineSelectClass;
      @call pself->UIG_target.obj::MSG_HTGMLS_PROCESS_ATTRIBUTE
          (block, entity);
  }

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_SELECT.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_END_SELECT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the presentation manager that the HTGenSelect
 *		    object is done.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_SELECT
{
  optr select;
  ClassStruct *class;
  /* 
   * If there is some object in target.obj (likely, it can be a 
   * HTGenOption object), we can assume the object is done.  Thus, give
   * the object to the presentation manager for rendering.
   */
  if (pself->UIG_target.obj &&
      pself->UIG_target.class == (ClassStruct *)&HTGenOptionClass) {
	@call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ \
				(pself->UIG_target.obj);
  } else if(pself->UIG_target.obj && (
     pself->UIG_target.class==(ClassStruct*)&HTGenMultiLineSelectClass ||
     pself->UIG_target.class==(ClassStruct*)&HTGenSelectClass)) {
	@call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
				(pself->UIG_target.obj);
  }

  @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&select, &class);
  EC_ERROR_IF(class != (ClassStruct *)&HTGenSelectClass &&
	class != (ClassStruct *)&HTGenMultiLineSelectClass,
	UIG_UI_TREE_OPERATION_FAILS);
  /*
   * Finalize the select object, like setting it exclusive or 
   * non-exclusive.
   */
  if(class == (ClassStruct *)&HTGenSelectClass) {
      @send select::MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
      @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
	 (&(pself->UIG_target.obj), &(pself->UIG_target.class));
  }
  else 
      @send select::MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT();
  /*
   * Tell the receiving object(which must be a HTGenSelect object) in 
   * the ui tree that there are no more children for it.  So the 
   * presentation manager can mark it usable and display it.
   */
  @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE
	(&(pself->UIG_target.obj), &(pself->UIG_target.class));

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_END_SELECT.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_CREATE_OPTION for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create HTGenOption object and process the attribute
 *		    list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_OPTION
{
  optr select;
  ClassStruct *class;
  int id;
  char *value;
  int	index = 0;
  Boolean selected = FALSE;

  if (pself->UIG_target.obj && 
      pself->UIG_target.class == (ClassStruct *)&HTGenMultiLineSelectClass){

      for(index = 0; entity[index].SGMLE_token; index++) {
          switch(entity[index].SGMLE_token) {
          case HTML_ATTR_VALUE:
              if (entity[index].SGMLE_value) 
                  value = (char *)LMemDerefHandles(block, 
				entity[index].SGMLE_value);
              break;
          case HTML_ATTR_SELECTED:
              selected = TRUE;
              break;
          }
      }

      @call (pself->UIG_target.obj)::MSG_HTGMLS_ADD_OPTION_VALUE(
			value, selected);

      return UI_GEN_NO_ERROR;
  }

  /*
   * add any existing ui object in target.obj to the ui tree.
   */
  if (pself->UIG_target.obj && 
      pself->UIG_target.class == (ClassStruct *)&HTGenOptionClass)
	@call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ
				(pself->UIG_target.obj);
  else if (pself->UIG_target.obj) 
	@call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
				(pself->UIG_target.obj);

  @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS \
	(&select, &class);
  EC_ERROR_IF(class != (ClassStruct *)&HTGenSelectClass,
	UIG_UI_TREE_OPERATION_FAILS);

  /*
   * Now create a option object and store it in target.obj.  Then
   * process the passed attribute list.
   */
  pself->UIG_target.obj = @call pself->UIG_pmObj::\
	MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenOptionClass);
  pself->UIG_target.class = (ClassStruct *)&HTGenOptionClass;

  /*
   * Assign a unique id to the option object.
   */
  id = @call select::MSG_GEN_SELECT_GET_AND_INCREMENT_OPTION_ID();
  @call pself->UIG_target.obj::MSG_GEN_ITEM_SET_IDENTIFIER(id);
  /*
   * Process attributes
   */
  @call pself->UIG_target.obj::MSG_GEN_OPTION_PROCESS_ATTRIBUTE
	(block, entity, select);

  @call pself->UIG_target.obj::MSG_META_ADD_VAR_DATA
	(HINT_EXPAND_WIDTH_TO_FIT_PARENT, 0, NULL);

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_OPTION.	*/


/***********************************************************************
 *		MSG_UI_GENERATOR_CREATE_INPUT for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Define user input field as part of the contents
 *		    in a FORM element.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: TYPE = TEXT | PASSWORD | CHECKBOX | 
 *				       RADIO | SUBMIT | RESET | HIDDEN |
 *				       IMAGE.
 *				NAME, VALUE, SRC, CHECKED, SIZE, 
 *				MAXLENGTH.
 *
 * INPUT elements are not containers and so the end tag is forbidden. 
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_CREATE_INPUT
{
  char *value, *cptr = NULL;
  int index, maxLen = 0, size = 13;	/* default SIZE attribute value */
  Boolean checked = FALSE;
  InputType Itype = INPUT_TEXT;		/* default input type */
  CompSizeHintArgs sizeArgs;
  optr container, dummy;
  ChunkHandle tmpChunk;
  HTMemHandle tmpOptr=NULL, nameOptr=NULL, valueOptr=NULL, srcOptr=NULL;
  WWFixed number;
  VisMonikerWithText *moniker;
  ClassStruct *class;

  if (pself->UIG_target.obj == NULL) {
    EC_WARNING(UIG_WRONG_ASSUMPTION);
    return UI_GEN_NO_ERROR;
  }
  /*
   *  Finish whatever ui object in the target and append it to the ui tree.
   *  Travel up the ui tree and return the first container object(which
   *  can be a form object, or a HTGenTCell object) that is encountered.
   */
  container=FinishCurrentObjectInForm(pself->UIG_pmObj,&(pself->UIG_target));

  /*
   *  This FOR loop processes the attribute list, collecting attribute
   *  values that will be needed later on.
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_token == HTML_ATTR_CHECKED)
	checked = TRUE;
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
    case HTML_ATTR_VALUE:
    case HTML_ATTR_SRC:
      /* 
       *  Allocate a chunk to store the NAME, VALUE or SRC data.
       */
      tmpOptr = HTMemAlloc(sizeof(char) * (strlen(value)+1));
      cptr = (char *)HTMemLock(tmpOptr);
      strcpy(cptr,value);
      HTMemUnlock(tmpOptr);
      /*
       * Decide which type(NAME/VALUE/SRC) of chunk we're creating.
       */
      if (entity[index].SGMLE_token == HTML_ATTR_NAME)	/* type = NAME */
	nameOptr  = tmpOptr;
      else if (entity[index].SGMLE_token==HTML_ATTR_VALUE)/* type = VALUE */
	valueOptr = tmpOptr;
      else				                /* type = SRC */
	srcOptr = tmpOptr;
      break;
    case HTML_ATTR_CHECKED:
      checked = TRUE;
      break;
    case HTML_ATTR_SIZE:
      size = atoi(value);
      if (size > 70)
	  size = 70;
      else if (size <= 0)
	  size = 13;     /* get back to default */
      break;
    case HTML_ATTR_MAXLENGTH:
      maxLen = atoi(value);
      break;
    case HTML_ATTR_TYPE:
      if (strcasecmp("text", value) == 0)
	Itype = INPUT_TEXT;
      else if (strcasecmp("password", value) == 0)
	Itype = INPUT_PASSWORD;
      else if (strcasecmp("checkbox", value) == 0)
	Itype = INPUT_CHECKBOX;
      else if (strcasecmp("radio", value) == 0)
	Itype = INPUT_RADIO;
      else if (strcasecmp("submit", value) == 0)
	Itype = INPUT_SUBMIT;
      else if (strcasecmp("reset", value) == 0)
	Itype = INPUT_RESET;
      else if (strcasecmp("hidden", value) == 0)
	Itype = INPUT_HIDDEN;
      else if (strcasecmp("image", value) == 0)
	Itype = INPUT_IMAGE;
      else if (strcasecmp("button", value) == 0) {
	pself->UIG_target.obj = container;
	pself->UIG_target.class=@call container::MSG_META_GET_CLASS();
	EC_WARNING(UIG_BUTTON_NOT_SUPPORTED);
	return UI_GEN_ERROR;
      }
EC(   else if (strcasecmp("file", value) == 0)
	/*	Itype = INPUT_FILE;				*/
	EC_WARNING(UIG_FILE_NOT_SUPPORTED); )
      break;
    }
  }

  switch (Itype) {
    case INPUT_TEXT:
    case INPUT_PASSWORD:
	/*
	 * Create a text input feild(text object) for user input.
	 */
	dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
		((ClassStruct *)&HTGenFormTextClass);
	/*
	 * Store the attributes data.
	 */
	if (valueOptr != NULL) {
	  /*
	   *  The default VALUE for TYPE=TEXT is displayed right away.
	   */
	  cptr = (char *)HTMemLock(valueOptr);
	  @call dummy::MSG_VIS_TEXT_APPEND_PTR(cptr, 0);
	  HTMemUnlock(valueOptr);
	}
	@call dummy::MSG_GEN_FORM_TEXT_INITIALIZE(nameOptr, valueOptr);
	/*
	 * Set single-text attribute, and width of the object.
	 */
	@send dummy::MSG_GEN_TEXT_SET_ATTRS(GTA_SINGLE_LINE_TEXT, 0);
	sizeArgs.CSHA_width = SST_AVG_CHAR_WIDTHS | size;
	sizeArgs.CSHA_height = 0;
	sizeArgs.CSHA_count = 1;
	EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
	@call dummy::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
	/*
	 *  Set MAXLENGTH if it is specified.
	 */
	if (maxLen > 0 && maxLen < 1000)	/* 1000 is a protection */
	  @call dummy::MSG_VIS_TEXT_SET_MAX_LENGTH(maxLen);
	/*
	 *  If it's a password type, set the BISON font size 13 so that
	 *  '*' is displayed for every char input.
	 */
	if (Itype == INPUT_PASSWORD) {
	  @send dummy::MSG_VIS_TEXT_SET_FONT_ID(
				FID_BISON,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);	
	  number.WWF_int = 13;
	  number.WWF_frac = 0;
	  @call dummy::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
	}
	break;
    case INPUT_HIDDEN:
	/*
	 *  Create a text object for user input.
	 */
	dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
		((ClassStruct *)&HTGenFormHiddenClass);
	/*
	 *  Store NAME and VALUE attributes.
	 */
	@call dummy::MSG_GEN_FORM_HIDDEN_INITIALIZE(nameOptr, valueOptr);
	break;
    case INPUT_CHECKBOX:
    case INPUT_RADIO:
      /*
       *  Create a Input object(GenItemGroup).
       */
      dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
	((ClassStruct *)&HTGenInputClass);
      @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ(dummy);
      /*
       *  Initialize the Input object.
       */
      @call dummy::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(FALSE);
      @call dummy::MSG_GEN_INPUT_STORE_DATA(nameOptr, valueOptr, 
					    Itype, checked);
      /* 
       *  Add the INPUT object to the linked list under the FORM object.
       */
      AddInputToForm(container, dummy);
      /*
       * Insert the Input(ItemGroup) to the ui tree.
       */
      @call pself->UIG_pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ(dummy);
      /*
       * Create a genItem object 
       */
      dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
	((ClassStruct *)&GenItemClass);
      @call dummy::MSG_GEN_ITEM_SET_IDENTIFIER(0);

      @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
      @call pself->UIG_pmObj::MSG_PM_MARK_RECV_OBJECT_DONE(&dummy, &class);
      pself->UIG_target.obj = dummy;
      pself->UIG_target.class = class;
      break;
    case INPUT_RESET:
    case INPUT_SUBMIT:
	/*
	 * Create a text object for user input.
	 */
	dummy = @call pself->UIG_pmObj::MSG_PM_OBJECT_INSTANTIATE
		((ClassStruct *)&HTGenFormTriggerClass);
	@call dummy::MSG_GEN_FORM_TRIGGER_INITIALIZE(nameOptr, Itype);
	/*
	 *  Set up the the vis Moniker on the trigger.
	 */
	if (valueOptr) {
	  /*
	   *  Create a visMoniker, and copy the text moniker.
	   */
	  ObjLockObjBlock(HandleOf(dummy));
	  cptr = (char *)HTMemLock(valueOptr);
	  tmpChunk = LMemAlloc(HandleOf(dummy), 
			strlen(cptr) + 1 + sizeof(VisMonikerWithText));
	  moniker = LMemDerefHandles(HandleOf(dummy), tmpChunk);
	  moniker->VMWT_common.VM_type = 0;
	  moniker->VMWT_common.VM_width= 0;
	  moniker->VMWT_mnemonicOffset = -1;
	  strcpy((char *)moniker + VMWT_text, cptr);
	  MemUnlock(HandleOf(dummy));
	  HTMemUnlock(valueOptr);
	  HTMemFree(valueOptr);

	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_OPTR
		(ConstructOptr(HandleOf(dummy),tmpChunk), VUM_NOW);
	}
	else if (Itype == INPUT_SUBMIT)
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		("Submit", VUM_DELAYED_VIA_UI_QUEUE);
	else
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		("Reset", VUM_DELAYED_VIA_APP_QUEUE);
	/*
	 *  Set the RESET action message and destination
	 */
	if (Itype == INPUT_RESET) {
	  @call dummy::MSG_GEN_TRIGGER_SET_ACTION_MSG(MSG_GEN_FORM_RESET);
	  while(!@call container::MSG_META_IS_OBJECT_IN_CLASS
	        (&HTGenFormClass)) {
	    container = @call container::MSG_GEN_FIND_PARENT();
	  }
	  @call dummy::MSG_GEN_TRIGGER_SET_DESTINATION(container);
	}
	else
	  @call dummy::MSG_META_SET_OBJ_BLOCK_OUTPUT(pself->UIG_pmObj);
        break;
    case INPUT_IMAGE:
        EC_WARNING(UIG_NOT_SUPPORTED);
	dummy = @call pself->UIG_pmObj::\
		MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenImageClass);
	@call dummy::MSG_GEN_IMAGE_REQUEST(srcOptr);
	break;
  }
  if (Itype != INPUT_CHECKBOX && Itype != INPUT_RADIO) {
    /*
     *  Done with the new object.  CHECKBOX and RADIO will get its
     *  visMoniker later.
     */
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
    @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS \
		(&(pself->UIG_target.obj), &(pself->UIG_target.class));
  }
    
  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_CREATE_INPUT.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_START_TEXTAREA for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Creates a multiple-line text entry control in
 *		    which the user can enter and edit text. 
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: COLS, NAME, ROWS
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_START_TEXTAREA
{
  /*
   *  Finish and append whatever ui object in the target to the ui tree.
   *  Travel up the tree and return the first container object(which
   *  can be a form object, or a HTGenTCell object) encountered.
   */
  FinishCurrentObjectInForm(pself->UIG_pmObj,&(pself->UIG_target));

  /*
   * Now create a select object and store it in target.obj.  
   * Then process the passed attribute list.
   */
  pself->UIG_target.obj = @call pself->UIG_pmObj::\
	MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTGenFormTextClass);
  pself->UIG_target.class = (ClassStruct *)&HTGenFormTextClass; 
  @call pself->UIG_target.obj::MSG_GEN_FORM_TEXT_PROCESS_ATTRIBUTE
	(block, entity); 
/*****
  pself->UIG_target.obj = @call pself->UIG_pmObj::\
	MSG_PM_OBJECT_INSTANTIATE((ClassStruct *)&HTTextAreaClass);
  pself->UIG_target.class = (ClassStruct *)&HTTextAreaClass; 
  @call pself->UIG_target.obj::MSG_HTTA_PROCESS_ATTRIBUTE
	(block, entity); 
*****/

  return UI_GEN_NO_ERROR;
}	/* End of MSG_UI_GENERATOR_START_TEXTAREA.	*/


/***********************************************************************
 *	MSG_UI_GENERATOR_END_TEXTAREA for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Finish up the <TEXTAREA> object.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@extern method UIGeneratorClass, MSG_UI_GENERATOR_END_TEXTAREA
{
  HTMemHandle tmpOptr;
  int	len;
  char	*cptr;
  /* 
   *  If there is some object in target.obj (It must be a GenFormText
   *  object), now we can mark it done.  Thus, pass the object to the 
   *  presentation manager for rendering.
   */
  if (pself->UIG_target.obj) {
    EC_ERROR_IF(pself->UIG_target.class != 
	(ClassStruct *)&HTGenFormTextClass, UIG_UI_TREE_OPERATION_FAILS);
/*	(ClassStruct *)&HTTextAreaClass, UIG_UI_TREE_OPERATION_FAILS);	*/
    @call pself->UIG_pmObj::MSG_PM_TAKE_FINISHED_UI_OBJ
				(pself->UIG_target.obj);
#if 1
    @call self::MSG_UI_GENERATOR_BROADCAST_RESIZE_POSITION
       (pself->UIG_target.obj);
#endif
    /*
     *  If there is some text between <TEXTAREA> and </TEXTAREA>, 
     *  store a copy of the text in the HTGFT_value.  This copy is used
     *  to restore the TEXTAREA back to its initial state when the RESET
     *  trigger is pressed.
     */
    if((len = @call pself->UIG_target.obj::MSG_VIS_TEXT_GET_TEXT_SIZE())>0){
      tmpOptr = HTMemAlloc(sizeof(char)* (len + 1));
      cptr = (char *)HTMemLock(tmpOptr);
      len = @call pself->UIG_target.obj::MSG_VIS_TEXT_GET_ALL_PTR(cptr);
      @call pself->UIG_target.obj::MSG_GEN_FORM_TEXT_INITIALIZE(0,tmpOptr);
      HTMemUnlock(tmpOptr);
    }
/*
    @call pself->UIG_target.obj::MSG_HTTA_COMPLETE_TEXTAREA_CONSTRUCT();
*/
    @call pself->UIG_pmObj::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&pself->UIG_target.obj, &pself->UIG_target.class);
    EC_ERROR_IF(pself->UIG_target.class != 
	(ClassStruct *)&HTGenFormClass, UIG_UI_TREE_OPERATION_FAILS);
    return UI_GEN_NO_ERROR;
  }
  else
    return UI_GEN_ERROR;
}	/* End of MSG_UI_GENERATOR_END_TEXTAREA.	*/



/***********************************************************************
 *		MSG_GEN_FORM_PROCESS_ATTRIBUTE for HTGenFormClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the FORM element
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: action, method
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_FORM_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index = 0;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch (entity[index].SGMLE_token) {
    case HTML_ATTR_ACTION:
      /* allocate a chunk to store the ACTION URL */
      @self->HTGF_action = HTMemAlloc(sizeof(char) * (strlen(value)+1));
      cptr = (char *)HTMemLock(@self->HTGF_action);
      strcpy(cptr,value);
      HTMemUnlock(@self->HTGF_action);
      break;
    case HTML_ATTR_METHOD:
      if (strcasecmp(value, "post") == 0)
	@self->HTGF_method = HTM_POST;	/* FORM_GET by default */
      else
	@self->HTGF_method = HTM_GET;	/* FORM_GET by default */
      break;
    }
  }
  return;
}	/* End of MSG_GEN_FORM_PROCESS_ATTRIBUTE.	*/



