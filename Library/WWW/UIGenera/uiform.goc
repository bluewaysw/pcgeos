    	bkgColors.BC_selectedColor1 = C_DARK_GRAY;
    	bkgColors.BC_selectedColor2 = C_DARK_GRAY;

    } else {
        bkgColors.BC_unselectedColor1 = C_LIGHT_GRAY;
        bkgColors.BC_unselectedColor2 = C_LIGHT_GRAY;
    	bkgColors.BC_selectedColor1 = C_LIGHT_GRAY;
    	bkgColors.BC_selectedColor2 = C_LIGHT_GRAY;
    }

    @call self::MSG_META_ADD_VAR_DATA
