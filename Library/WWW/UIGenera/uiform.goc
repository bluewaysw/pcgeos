/***********************************************************************
 *		MSG_GEN_FORM_TRIGGER_SUBMIT for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate the name=value pair and store in the query.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Handle <INPUT TYPE = SUBMIT NAME=? VALUE=?>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_GEN_FORM_TRIGGER_SUBMIT
{
  char *cptr;
  ChunkHandle moniker;
  HTMemHandle temp;

  if (pself->HTGFT_name && pself->HTGFT_type == INPUT_SUBMIT) {
    /*
     *  Append the "name".
     */
    temp = HTStrHTMemAllocCopy(pself->HTGFT_name);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
    /*
     *  Append the "value".
     */
    moniker = @call oself::MSG_GEN_GET_VIS_MONIKER();
    cptr = (char *)LMemDerefHandles(OptrToHandle(oself), moniker) 
      + sizeof(VisMonikerWithText);
    temp = HTStrAllocCopy(cptr);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
  }
  return;
}	/* End of MSG_GEN_FORM_TRIGGER_SUBMIT.	*/




/***********************************************************************
 *		MSG_META_START_SELECT for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Assemble a query URL of the form:
 *                  action?name=value&name=value&name=value
 *                  ("action" here is the URL specified by the ACTION 
 *                  attribute to the FORM tag, or the current document
 *                  URL if no ACTION attribute was specified.)
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTriggerClass, MSG_META_START_SELECT
{
  optr parent;

  @callsuper();
  if (pself->HTGFT_type == TRIGGER_SUBMIT) {
    parent = oself;
    while(1) {
      parent = @call parent::MSG_GEN_FIND_PARENT();
      if (@call parent::MSG_META_IS_OBJECT_IN_CLASS(&HTGenFormClass)) {
	@call parent::MSG_GEN_FORM_SUBMIT();
	break;
      }
    }
  }
  return;
}	/* End of MSG_META_START_SELECT.	*/



