/***********************************************************************
 *		FinishCurrentObjectInForm
 ***********************************************************************
 *
 * SYNOPSIS:	Finish the object in target and append it to the ui
 *		tree.  Return the parent object of the subtree(either
 *              a form or table cell).  This parent object is the typen
 *              of a GenInteractin subclass.
 * CALLED BY:	(optr pmObj, ObjInfo *target);
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
optr
FinishCurrentObjectInForm (optr pmObj, ObjInfo *target)
{
  ClassStruct *class;
  optr	container;

  /*
   * Add whatever object in UIG_target to the leaf of the ui-tree, and
   * travel up the tree branch to find the first FORM or HTGenTCell
   * object that can take more children objects.
   */
  @call pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ(target->obj);
  if (target->class != (ClassStruct *)&HTGenFormClass &&
      target->class != (ClassStruct *)&HTGenTCellClass) {
    while (1) {
	@call pmObj::MSG_PM_MARK_RECV_OBJECT_DONE(&container, &class);
	EC_ERROR_IF(class == NULL || container == NULL ||
	  class == (ClassStruct *)&HTGenTextClass,
	  UIG_INVALID_OPERATION_ON_UI_TREE);
	if (class == (ClassStruct *)&HTGenFormClass ||
	    class == (ClassStruct *)&HTGenTCellClass)
	  break;
	else if (class == (ClassStruct *)&HTGenSelectClass)
	  @call container::MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
/*	else if (class == (ClassStruct *)&HTGenMultiLineSelectClass)
	  @call container::MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT();
	  */  /* edwin's observation */
    }
  }
  else 
    container = target->obj;

  /*
   *  Note, container may contain a FORM object or a HTGenTCell object.
   */
  return container;
}	/* End of FinishCurrentObjectInForm.	*/


/* The code for HTTextAreaClass (<TEXTAREA>). */

/***********************************************************************
 *		MSG_HTTA_PROCESS_ATTRIBUTE for HTTextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    ChunkHandle block, SGMLEntity *entity
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/27/96   	Initial Revision
 *
 ***********************************************************************/
/***********
@method HTTextAreaClass, MSG_HTTA_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index;
  ChunkHandle nameChunk;
  CompSizeHintArgs sizeArgs;

  @self->HTTA_cols = 12;
  @self->HTTA_rows = 4;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      nameChunk = LMemAlloc(HandleOf(oself), strlen(value)+1);
      cptr = (char *)LMemDerefHandles(HandleOf(oself), nameChunk);
      strcpy(cptr,value);
      pself = ObjDerefGen(oself);
      pself->HTGFT_name = nameChunk;
      break;
    case HTML_ATTR_COLS:
      @self->HTTA_cols = atoi(value);
      break;
    case HTML_ATTR_ROWS:
      @self->HTTA_rows = atoi(value);
      break;
    }
  }
  sizeArgs.CSHA_width = SST_AVG_CHAR_WIDTHS | cols;
  sizeArgs.CSHA_height = SST_LINES_OF_TEXT | rows;
  sizeArgs.CSHA_count = 0;
  EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
  @call self::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
  return;
}	******/ /* End of MSG_HTTA_PROCESS_ATTRIBUTE.	*/



/***********************************************************************
 *		MSG_HTTA_SET_TEXT_PTR for HTTextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    char *text, word len
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/27/96   	Initial Revision
 *
 ***********************************************************************/
/**************
@method HTTextAreaClass, MSG_HTTA_SET_TEXT_PTR
{
    char *default;

    if(!(*text) || len<=0) return;

    if(!@self->HTTA_textHandle) {
	@self->HTTA_textHandle = MemAllocLMem(LMEM_TYPE_GENERAL,
					sizeof(LMemBlockHeader));
    }

    MemLock(@self->HTTA_textHandle);
   
    @self->HTTA_defaultText = LMemAlloc(@self->HTTA_textHandle,
					len);

    default = LMemDeref(@self->HTTA_textHandle, @self->HTTA_defaultText);

    strcpy(default, text, len);

    MemUnlock(@self->HTTA_textHandle);
} ********/	/* End of MSG_HTTA_SET_TEXT_PTR.	*/



