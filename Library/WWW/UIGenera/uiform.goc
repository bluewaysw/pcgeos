 *	EY	6/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenSelectClass, MSG_GEN_SELECT_SET_SELECT_ID
{
  pself->HTGS_select = id;
  return;
}	/* End of MSG_GEN_SELECT_SET_SELECT_ID.	*/



