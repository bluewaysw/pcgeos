/***********************************************************************
 *		MSG_GEN_OPTION_PROCESS_ATTRIBUTE for HTGenOptionClass
 ***********************************************************************
 * SYNOPSIS:	    Process OPTION attribute list
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity, optr select)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenOptionClass, MSG_GEN_OPTION_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index = 0;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_value == HTML_ATTR_SELECTED) {
	@self->HTGO_selected = TRUE;
	@send select::MSG_GEN_SELECT_SET_SELECT_ID(@self->GII_identifier);
      }
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_VALUE:
      /* allocate a chunk to store the ACTION URL */
      @self->HTGO_value = HTMemAlloc(sizeof(char) * (strlen(value)+1));
      cptr = (char *)HTMemLock(@self->HTGO_value);
      strcpy(cptr, value);
      HTMemUnlock(@self->HTGO_value);
      break;
    case HTML_ATTR_SELECTED:
      @self->HTGO_selected = TRUE;
      @send select::MSG_GEN_SELECT_SET_SELECT_ID(@self->GII_identifier);
      break;
    }
  }
  return;
}	/* End of MSG_GEN_OPTION_PROCESS_ATTRIBUTE.	*/


