/***********************************************************************
 *		MSG_VIS_DRAW for HTOtherOptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTOtherOptionClass, MSG_VIS_DRAW
{
    BackgroundColors bkgColors;

/*
    Rectangle bounds;

    if(@self->HTOO_selected) {
    	@call self::MSG_VIS_GET_BOUNDS(&bounds);
	GrSaveState(gstate);
        GrSetAreaColor(gstate, CF_INDEX, C_DARK_GRAY, 0, 0);  
	GrSetMixMode(gstate, MM_XOR);
        GrFillRect(gstate, bounds.R_left, bounds.R_top,
			bounds.R_right, bounds.R_bottom);
  	GrRestoreState(gstate);
    }
*/
    if(@self->HTOO_selected) {
     	bkgColors.BC_unselectedColor1 = C_DARK_GRAY;
