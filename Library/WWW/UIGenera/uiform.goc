/***********************************************************************
 *		MSG_GEN_INPUT_STORE_DATA for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the identity of the INPUT object.  Some of
 *                  data will be submitted to a remote server.
 * PARAMETERS:	    (HTMemHandle name,
 *                   HTMemHandle value, Boolean checked, InputType type)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 8/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_STORE_DATA
{
  pself->HTGI_name  = name;
  pself->HTGI_value = value;

  if (type == INPUT_CHECKBOX)
    pself->GIGI_behaviorType = GIGBT_NON_EXCLUSIVE;

  if (checked == TRUE) {
    @call oself::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0, FALSE);
    pself->HTGI_select = TRUE;
  }

  return;
}	/* End of MSG_GEN_INPUT_STORE_DATA.	*/


