@include <WWW/htcore.goh>
@include <WWW/HTCore/htuu.goh>
@include "b64enc.goh"

#define BASE64_ENCODING_CHUNK 57*9    /* 57 bytes encoded in 76 bytes */
#define BASE64_ENCODED_SIZE   57*12+1 /* 4/3*BASE64_ENCODING_CHUNK+1 */

extern char   CRLF[];     /* In htsmtp.goc */

#define PUTBLOCK(target, data, len)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, len)


/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTBase64EncodeClass;

/***********************************************************************
 *		HTBase64EncodeNew
 ***********************************************************************
 *
 * SYNOPSIS:	Create a new base64 encoding stream.
 * CALLED BY:	Client
 * RETURN:	HTStreamHandle, NULL if not created
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/15/97   	Initial Revision
 *	
 ***********************************************************************/
HTStreamHandle _far _pascal
HTBase64EncodeNew (HTRequestHandle request, HTStreamHandle target)
{
    HTStreamHandle stream;

EC( ECCheckRequest(request);                                            )

    stream = HTObjInstantiateForThread(0, &HTBase64EncodeClass);

    if (!stream) {
	/* Log error */
    } else {
	/* Initialize the stream instance data */
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);
	@call stream::MSG_HT_STREAM_SET_TARGET(target);
    }
    return stream;
}	/* End of HTBase64EncodeNew.	*/




/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_META_INITIALIZE for HTBase64EncodeClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Initialize buffer for base64 encoding.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTBase64EncodeClass, MSG_META_INITIALIZE
{
    @self->HTBEI_bufferHandle = HTMemAlloc(BASE64_ENCODED_SIZE);
    @self->HTBEI_buffer = (byte *) HTMemLock(@self->HTBEI_bufferHandle);
    @callsuper();
}	/* End of MSG_META_INITIALIZE.	*/



/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTBase64EncodeClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Free allocated memory.
 * PARAMETERS:	    int (int status)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTBase64EncodeClass, MSG_HT_STREAM_ABORT
{
    if (@self->HTBEI_bufferHandle)
	HTMemUnlockAndFree(@self->HTBEI_bufferHandle);
    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTBase64EncodeClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Convert a block of data to base64 and put to target.
 *                  len *MUST* be a multiple of 57 bytes (a line that is
 *                  encoded in 76 bytes). Only the last block of data
 *                  must be <= 57 bytes. This not necessary, but it 
 *                  keep the amount of data encoded and sent to the minimal
 *                  allowed by base64 encoding.
 * PARAMETERS:	    int (const byte *data, word len)
 *                      len should be multiples of 57, execpt for the 
 *                       last block of data.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    1. Base64 encoding is used.
 *                  2. We must make sure lines == 76 bytes execpt
 *                     for the very last line.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTBase64EncodeClass, MSG_HT_STREAM_PUT_BLOCK
{
    int ret;
    int nbytes;                /* Number of bytes to encode */
    int encodedLen;            /* Length of encoded buffer */
    int mbytes;
    byte *edata;

    if (!data || !len) return HT_OK;

    while (len) {
	nbytes = (len >= BASE64_ENCODING_CHUNK) ? 
	    BASE64_ENCODING_CHUNK : len;
	len -= nbytes;

	edata = @self->HTBEI_buffer;
	encodedLen = HTUUEncodePtr((byte *)data, nbytes, edata);
	data += nbytes;

	while (encodedLen) {
	    /* 
	     * Put encoded data to target. The encoded buffer is multiple
 	     * of 76 bytes since the input buffer is multiple of of 56 
	     * bytes, except for the last buffer.
	     */
	    mbytes = (encodedLen >= 76) ? 76 : encodedLen;
	    encodedLen -= mbytes;

	    ret = PUTBLOCK(@self->HTSI_target, edata, mbytes);
	    edata += mbytes;

	    if (mbytes == 76)
		ret = PUTBLOCK(@self->HTSI_target, (byte *)CRLF, 2);
	    
	    if (ret != HT_OK) return ret;
	}

    }

    return HT_OK;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/


