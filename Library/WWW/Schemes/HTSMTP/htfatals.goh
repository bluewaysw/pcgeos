@ifndef __HTSMTP_FATALS_GOH__
@define __HTSMTP_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    HTSMTP_STATE_NOT_HANDLED,
    HTSMTP_RESPONSE_NOT_HANDLED,
    HTSMTP_COMMAND_SYNTAX_ERROR,
    HTSMTP_INVALID_REQUEST,
    HTSMTP_REQUEST_NOT_SET,
    HTSMTP_MUST_HAVE_A_SENDER,
    HTSMTP_INVALID_ADDRESS_ROLE,
    HTSMTP_MUST_HAVE_EMAIL_ADDR,
    HTSMTP_ATTACHMENT_MUST_HAVE_FILENAME,
    HTSMTP_NO_RECEIVER_AT_THIS_INDEX,
    HTSMTP_ENCODING_TYPE_NOT_HANDLED,
    HTSMTP_Q_ENCODED_LINE_GREATER_THAN_76
} FatalErrors;
#endif /* ERROR_CHECK */

/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    HTSMTP_CONTENT_TYPE_NOT_HANDLED,
    HTSMTP_CORRUPTED_RESPONSE
} Warnings;
#endif

#if ERROR_CHECK
extern FatalErrors htsmtpFatalErrors;
extern Warnings    htsmtpWarnings;
#endif

@endif /* __HTSMTP_FATALS_GOH__ */
