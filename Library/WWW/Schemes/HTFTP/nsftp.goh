/* define the states of the machine 
 */
typedef enum _FTPStates {
FTP_WAIT_FOR_RESPONSE,
FTP_CONTROL_CONNECT, /* no more FTP_CONTROL_CONNECT_WAIT*/
FTP_SEND_USERNAME,
FTP_SEND_USERNAME_RESPONSE,
FTP_GET_PASSWORD,
FTP_GET_PASSWORD_RESPONSE,
FTP_SEND_PASSWORD,
FTP_SEND_PASSWORD_RESPONSE,
FTP_SEND_ACCT,
FTP_SEND_ACCT_RESPONSE,
FTP_SEND_REST_ZERO,
FTP_SEND_REST_ZERO_RESPONSE,
FTP_SEND_SYST,
FTP_SEND_SYST_RESPONSE,
FTP_SEND_MAC_BIN,
FTP_SEND_MAC_BIN_RESPONSE,
FTP_SEND_PWD,
FTP_SEND_PWD_RESPONSE,
FTP_SEND_PASV,
FTP_SEND_PASV_RESPONSE,
FTP_PASV_DATA_CONNECT,
FTP_PASV_DATA_CONNECT_WAIT,
FTP_FIGURE_OUT_WHAT_TO_DO,
FTP_SEND_DELETE_FILE,
FTP_SEND_DELETE_FILE_RESPONSE,
FTP_SEND_DELETE_DIR,
FTP_SEND_DELETE_DIR_RESPONSE,
FTP_SEND_MKDIR,
FTP_SEND_MKDIR_RESPONSE,
FTP_SEND_PORT,
FTP_SEND_PORT_RESPONSE,
FTP_GET_FILE_TYPE,
FTP_SEND_BIN,
FTP_SEND_BIN_RESPONSE,
FTP_SEND_ASCII,
FTP_SEND_ASCII_RESPONSE,
FTP_GET_FILE_SIZE,
FTP_GET_FILE_SIZE_RESPONSE,
FTP_GET_FILE_MDTM,
FTP_GET_FILE_MDTM_RESPONSE,
FTP_GET_FILE,
FTP_BEGIN_PUT,
FTP_BEGIN_PUT_RESPONSE,
FTP_DO_PUT,
FTP_SEND_REST,
FTP_SEND_REST_RESPONSE,
FTP_SEND_RETR,
FTP_SEND_RETR_RESPONSE,
FTP_SEND_CWD,
FTP_SEND_CWD_RESPONSE,
FTP_SEND_LIST_OR_NLST,
FTP_SEND_LIST_OR_NLST_RESPONSE,
FTP_SETUP_STREAM,
FTP_WAIT_FOR_ACCEPT,
FTP_START_READ_FILE,
FTP_READ_CACHE,
FTP_READ_FILE,
FTP_START_READ_DIRECTORY,
FTP_READ_DIRECTORY,
FTP_PRINT_DIR,
FTP_LOGOUT_AND_DONE, /* jeremyb added*/
FTP_DONE,
FTP_ERROR_DONE,
FTP_FREE_DATA
} FTPStates;

typedef enum _FTPFileType {
FTP_FILE_TYPE_TEXT,
FTP_FILE_TYPE_BIN
} FTPFileType;

typedef struct _FTPConData {

    HTMemHandle addressHandle;            /* the URL part */
    dword    content_length;              /* length of the incoming data */

    int            status;          /* current status */
    dword          bytes_received;  /* number of bytes received so far */

    HTMemHandle hostnameHandle;
    HTSocketHandle csock;          /* control socket */
    int     server_type;    /* type of server */
    Boolean no_restart;     /* do we know that restarts don't work? */

    FTPStates     next_state;        /* the next state of the machine */

    HTStreamHandle stream;               /* outgoing meaning from us to the 
					  * file being written. */

    HTMemHandle   cc;  /* information about the control connection */
    
    /* Placed both of these in globals for persistence*/
    HTSocketHandle listen_sock;          /* socket to listen on */

    /* But SocketAccept returns a connected socket, gotta keep it somewhere*/
    Socket connected_listen_sock;
    HTSocketHandle pasvSockHandle;      /* used only for pasv connections*/

    Boolean    pasv_mode;            /* using pasv mode? */

    FTPStates   next_state_after_response;  /* the next state after 
					     * full response recieved */
    int         response_code;              /* code returned in response */
    HTMemHandle return_msg_handle;
    int         return_msg_length;
    int         cont_response;              /* a continuation code */

    HTMemHandle filenameHandle;   /* name of the file we are getting */ 

    HTMemHandle path_handle;
    int     fileType;                 /* a type indicator for the file */
    HTMemHandle usernameHandle;
    HTMemHandle passwordHandle;

    HTMemHandle   cwd_message_handle;     /* used to print out server 
					   * help messages */
    HTMemHandle   login_message_handle;   /* used to print out server 
					   * help messages */
    Boolean       use_default_path;
    
} FTPConData;

/* forward decls */
HTMemHandle FTPParseURL (HTMemHandle urlHandle, int parts_requested, 
			  int *length);

