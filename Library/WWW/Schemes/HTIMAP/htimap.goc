#ifndef IMAP_PORT
#define IMAP_PORT 143             /* Default TCP port */
#endif

char CRLF[] = {CR,LF,0};

#define FETCH_LIST_LEN  34
static char FETCH_LIST[] = " (RFC822.SIZE BODY FLAGS ENVELOPE)";

