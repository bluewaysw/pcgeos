@ifndef __RESP_GOH__
@define __RESP_GOH__

@include <stdapp.goh>
#include <WWW/htmem.h>
@include <WWW/htimap.goh>
@include "parse.goh"
@include "const.goh"


/*
 * IMAP Response data. This assigns semantics to the data parsed 
 * by parser.goc. Each decides what & how the parameters passed to 
 * RespAdd will be used.
 */
typedef enum {
    IMRD_BODY_NUMBER,            /* str1 */
    IMRD_BODY_FLD_OCTETS,        /* num1 */
    IMRD_BODY_STRING_LENGTH,     /* num1 */
    IMRD_DATE,                   /* str1 */
    IMRD_SUBJECT,                /* str1 */
    IMRD_TO,                     /* str1 = name, str2 = emailAdrress */
    IMRD_CC,                     /* str1 = name, str2 = emailAdrress */
    IMRD_BCC,                    /* str1 = name, str2 = emailAdrress */
    IMRD_FROM,                   /* str1 = Name, str2 = emailAdrress */
    IMRD_SENDER,                 /* str1 = Name, str2 = emailAdrress */
    IMRD_REPLY_TO,               /* str1 = Name, str2 = emailAdrress */
    IMRD_CONTENT_TYPE,           /* str1 = type & str2 = subtype */
    IMRD_FLD_PARAM,              /* str1 = name & str2 = value */
                                 /* We only look for charset and name */
    IMRD_FLD_ENC,                /* Content Transfer Encoding */
    IMRD_RFC822_SIZE,            /* num1 */
    IMRD_SEEN,                   /* Nothing */
    IMRD_UID,                    /* str1 */
    IMRD_UIDVALIDITY             /* str1 */
} IMAPRespData;

extern void _pascal RespNew (IMAPParser *p, IMAPRequest req);

extern void _pascal RespNewBody (IMAPParser *p);

extern void _pascal RespAdd (IMAPParser *p, IMAPRespData itype, 
			     HTMemHandle str1, HTMemHandle str2,
			     dword num1, dword num2);

extern int _pascal RespPush (IMAPParser *p, HTIMAPState cmd);

extern void _pascal RespDelete (IMAPParser *p);

@endif

