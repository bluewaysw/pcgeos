@include <stdapp.goh>
@include <WWW/htfile.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htreqMan.goh>
@include <WWW/HTCore/htpolicy.goh>
@include <WWW/HTCore/htnet.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/hturi.goh>
#include <WWW/htmem.h>
@include <WWW/HTCore/htsuffix.goh>
@include "htfatals.goh"
#include <Ansi/string.h>
#include <Ansi/stdio.h>

#define HTFILE_BUFFER_SIZE      512

/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTFileClass;


/***********************************************************************
		Message Handlers
***********************************************************************/



/***********************************************************************
 *		MSG_META_INITIALIZE for HTFileClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Initialize protocol instance data.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    Nothing
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFileClass, MSG_META_INITIALIZE
{
	/* Initialize HTFile state machine to initial state */
	@self->HTFI_currentState = HTFILE_BEGIN;

	@callsuper();
}	/* End of MSG_META_INITIALIZE.	*/



/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTFileClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clean up allocated memory.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	2/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTFileClass, MSG_HT_STREAM_ABORT
{
    if (@self->HTFI_block)
	MemFree(@self->HTFI_block);

    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/





/***********************************************************************
 *		MSG_HT_PROTOCOL_LOAD for HTFileClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Load a file protocol. This is a state-based 
 *                  implementation of the HTFile protocol.
 *
 * PARAMETERS:	    int (int status)
 *                  - return HT_OK if all is well.
 *                  - return HT_NO_CONTENT.
 *                  - return HT_OUT_OF_MEMORY.
 *                  - return HT_FILE_NOT_FOUND.
 *                  - return HT_LOADED if we are done reading file.
 *                  - passed in status is ignored.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Implemented in a state-based fashion. This means 
 *                  that this handler exits after a stable state is 
 *                  reached, and then reenter later to resume execution
 *                  from the previous state.
 *
 *                  If we return anything other than HT_OK, the protocol
 *                  will be terminated by the Library.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFileClass, MSG_HT_PROTOCOL_LOAD
{
    int ret = HT_OK;

EC ( if (@self->HTSI_request == NULL) EC_ERROR(HTFILE_REQUEST_NOT_SET); )

    /* 
     * Now we jump into the state machine. We know the state from the
     * previous run. This is one big switch loop.
     */
    while (1) {
	switch (@self->HTFI_currentState) {

	case HTFILE_BEGIN:
	    @self->HTFI_block =  MemAlloc(HTFILE_BUFFER_SIZE,
					  HF_SHARABLE | HF_SWAPABLE,
					  HAF_LOCK);
	    if (!@self->HTFI_block)
		return HT_OUT_OF_MEMORY;

	    @self->HTFI_buffer = (char *) MemDeref(@self->HTFI_block);

	    /* 
	     * Get fullpath filename & try to open it.
	     */
	    {
		HTMemHandle physical;
		HTRequest *rptr;
		char *cptr;

		rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
		physical = HTAnchorPhysical(rptr->HTR_anchor);

		cptr = (char *) HTMemLock(physical);
		cptr = strcasestr(cptr, "file://");
		if (cptr && cptr+7) 
		    strncpy(@self->HTFI_buffer, cptr+7, HTFILE_BUFFER_SIZE);
		else 
		    @self->HTFI_buffer[0] = 0;

		HTMemUnlockAndFree(physical);
		MemThreadRelease(@self->HTSI_request);

		while ((cptr=strchr(@self->HTFI_buffer, '/'))!=NULL) 
		    *cptr = '\\';                      /* DOS style */
	    }

	    /* 
	     * Attempt to open file. We try the following options.
	     * if "/f:/pene.ec/file.htm", try "f:/pene.ec/file.htm".
	     * if "f:/pene.ec/file.htm" try as is.
	     * if "/document/file.htm" try "document/file.htm" 
	     *                  relative to SP_TOP.
	     * if "document/file.htm" try relative to SP_TOP.
	     */

	    /* Always assume relative to SP_TOP directory */
	    FilePushDir();
	    FileSetStandardPath(SP_TOP);

	    if (@self->HTFI_buffer[0] == '\\')
		/* Absolute directory */
		@self->HTFI_fileHandle = 
		    FileOpen(@self->HTFI_buffer+1, FILE_DENY_W | FILE_ACCESS_R);
	    else {
		@self->HTFI_fileHandle = 
		    FileOpen(@self->HTFI_buffer, FILE_DENY_W | FILE_ACCESS_R);

		/* If failed, try "f/filename" with "f:/filename" */
		if (!@self->HTFI_fileHandle && @self->HTFI_buffer[1]=='\\') {
		    HTMemHandle abs;
		    char *c = (char *) HTMemAllocAndLock(&abs, 
					  strlen(@self->HTFI_buffer)+2);
		    *c = @self->HTFI_buffer[0];
		    *(c+1) = ':';
		    strcpy(c+2, @self->HTFI_buffer+1);

		    @self->HTFI_fileHandle = 
			FileOpen(c, FILE_DENY_W | FILE_ACCESS_R);
		    HTMemUnlockAndFree(abs);		    
		}
		
	    }

	    FilePopDir();

	    if (!@self->HTFI_fileHandle) {
		ret = HT_CANNOT_OPEN_FILE;

	    } else {
		/*
		 * Provide filesize as content length. This maybe over
		 * written by MIME parser if it sees a content-length
		 * in the file.
		 */
		HTRequest *rptr;
		char *cptr;

		rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);
		HTAnchorSetContentLength(rptr->HTR_anchor, 
					 FileSize(@self->HTFI_fileHandle));
		MemThreadRelease(@self->HTSI_request);

		/* 
		 * Check file extension or use a guess stream.
		 */

		/* Inform client what we are going to do next */
		ret = HTNetReportProgress(@self->HTSI_request,	
					  HT_LOADING_DATA);

		if (ret != HT_OK)
		    return ret;	

		/* Look for file suffix */
		cptr = strrchr(@self->HTFI_buffer, '.'); 
		if (cptr) cptr++;              /* Skip the '.' */

		@self->HTSI_target = HTSuffixCreate(cptr,
						    @self->HTSI_request);

		if (!@self->HTSI_target)
		    @self->HTSI_target = 
			HTPolicyStreamStack(HT_WWW_GUESS,
					    NULL,
					    @self->HTSI_target,
					    @self->HTSI_request,
					    FALSE);

		if (!@self->HTSI_target) 
		    return HT_NO_CONTENT;

		/*
		 * The output stream stack is now:
		 *       htfile --> stream (created from htsuffix?) 
		 *                OR
		 *       htfile --> guess stream --> + streams to be 
		 *                                   created by guess stream.
		 */
		@self->HTFI_currentState = HTFILE_READ;

	    }
	    return ret;

	case HTFILE_READ:
	    /* 
	     * Read one chunk at a time and then push data to 
	     * output stream pipe (there is no input stream pipe
	     * as there is no data for client to provide to 
	     * the Library).
	     */
	    {
		word bytesRead;

		bytesRead = FileRead(@self->HTFI_fileHandle, 
				     (void *) @self->HTFI_buffer, 
				     HTFILE_BUFFER_SIZE, FALSE);
	    
		if (!bytesRead) {
		    FileClose(@self->HTFI_fileHandle, FALSE);
		    ret = HT_LOADED;
		    
		} else {
		    ret = @call @self->HTSI_target::
			MSG_HT_STREAM_PUT_BLOCK((byte *)@self->HTFI_buffer, 
						bytesRead);
		    if (ret == HT_OK)
			ret = HTNetReportProgress(@self->HTSI_request, 
						  HT_MORE_DATA);
		}

		return ret;
	    }

	default:

EC(         EC_ERROR(HTFILE_STATE_NOT_HANDLED);                         )

	    break;
	}
    }
}	/* End of MSG_HT_PROTOCOL_LOAD.	*/




