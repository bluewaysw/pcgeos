@ifndef __HT_FATALS_GOH__
@define __HT_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    HTFILE_REQUEST_NOT_SET,
    HTFILE_STATE_NOT_HANDLED
} FatalErrors;
#endif /* ERROR_CHECK */


/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    THIS_IS_A_DUMMY_ZZZ_WARNING
} Warnings;

#endif


#if ERROR_CHECK
extern FatalErrors htFileFatalErrors;
extern Warnings    htFileWarnings;
#endif 

@endif



