@ifndef _HTTP_GEN_GOH
@define _HTTP_GEN_GOH

/* --------------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. HTTPGen CLASS
 * --------------------------------------------------------------------------*/

/****************************************************************************

  The HTTPGenClass is inherited from HTStreamClas in htstream.goh.
  HTTPGenClass is part of a request input stream stack. It is used to push
  HTTP general headers for a request.

 ****************************************************************************/

@class HTTPGenClass, HTStreamClass;

/*
 * Indicates whether this HTTPGen stream is going to end the headers
 * by putting an empty line consisting only of CRLF.
 *
 * Context:	Push data to server.
 * Source:	self
 * Destination:	HTTPGen objects.
 * Interception:No.
 */
@message void MSG_HTTP_GEN_END_HEADER(Boolean endHeader);

/* 
 * Indicates whether headers are to end here. If so, put an empty line
 * containing only CRLF.
 */
@instance Boolean HTGI_endHeader;
@endc

@endif


extern HTStreamHandle _far _pascal
	HTTPGenNew(HTRequestHandle request, Boolean endHeader);


