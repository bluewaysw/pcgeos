@ifndef __HTTP_REQ_GOH__
@define __HTTP_REQ_GOH__

/* --------------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. HTTPReq CLASS
 * --------------------------------------------------------------------------*/

/****************************************************************************

  The HTTPReqClass is inherited from HTStreamClas in htstream.goh.
  HTTPReqClass is part of a request input stream stack. It is used to push
  HTTP request headers for a request.

 ****************************************************************************/

@class HTTPReqClass, HTStreamClass;


/*
 * Indicates whether this HTTPReq stream is going to end the headers
 * by putting an empty line consisting only of CRLF.
 *
 * Context:	Push data to server.
 * Source:	self
 * Destination:	HTTPReq objects.
 * Interception:No.
 */
@message void MSG_HTTP_REQ_END_HEADER(Boolean endHeader);


/* 
 * Indicates whether headers are to end here. If so, put an empty line
 * containing only CRLF.
 */
@instance Boolean HTRI_endHeader;
@endc

@endif


extern HTStreamHandle _far _pascal
	HTTPReqNew(HTRequestHandle request, Boolean endHeader);


