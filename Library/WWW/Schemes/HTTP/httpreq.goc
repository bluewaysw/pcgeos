#include <Ansi/stdio.h>
#include <Ansi/string.h>

#define PUTBLOCK(target, data)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, strlen((char *)data))

/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTTPReqClass;

/***********************************************************************
		Private Routine
***********************************************************************/



/***********************************************************************
 *		HTTPMake09Request
 ***********************************************************************
 *
 * SYNOPSIS:	Make a HTTP/0.9 request.
 *
 * CALLED BY:	MSG_HT_STREAM_PUT_BLOCK
 * RETURN:	HT_OK or HT_ERROR
 * SIDE EFFECTS:
 *	
 * STRATEGY:    We don't have to check every status of PUTBLOCK.
 *              We can just check the last PUTBLOCK because if the 
 *              anyone of fails, then the last one must fail.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTTPMake09Request (HTRequest *rptr, HTStreamHandle target, Boolean endHeader)
{
    HTMemHandle urlHtmh;
    HTMemHandle htmh;
    byte crlf[] = {CR, LF, '\0'};
    char *cptr;
    int ret;

#if ERROR_CHECK
    ECCheckStream(target);

    if (rptr->HTR_method != HTM_GET)
	EC_ERROR(HTTP_0_9_SUPPORTS_GET_METHOD_ONLY);
#endif

    PUTBLOCK(target, (byte *)"GET ");
 
    /*
     * We have to use the complete URI if we are using a proxy, 
     * else use the URI abs_path. 
     */
    urlHtmh = HTAnchorAddress(rptr->HTR_anchor);
    cptr = (char *) HTMemLock(urlHtmh);

    if (rptr->HTR_proxy)
	PUTBLOCK(target, (byte *)cptr);

    else {
	byte *b;
	htmh = HTParseURI(cptr, NULL,
			  HTURI_PARSE_PATH | HTURI_PARSE_PUNCTUATION);
	b = (byte *) HTMemLock(htmh);
	PUTBLOCK(target, b);
	HTMemUnlockAndFree(htmh);
    }

    HTMemUnlockAndFree(urlHtmh);

    ret = PUTBLOCK(target, crlf);

    if (endHeader) ret = PUTBLOCK(target, crlf);

    return ret;
}	/* End of HTTPMake09Request.	*/




/***********************************************************************
 *		HTTPMakeRequest
 ***********************************************************************
 *
 * SYNOPSIS:	Make HTTP 1.0 and higher request headers.
 *
 * CALLED BY:	MSG_HT_STREAM_PUT_BLOCK
 * RETURN:	HT_OK or HT_ERROR
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
HTTPMakeRequest (HTNetThread *net, HTRequest *rptr, 
		 HTStreamHandle target, Boolean endHeader)
{
    HTMemHandle urlHtmh;
    HTMemHandle htmh;
    byte linebuf[256];
    byte crlf[] = {CR, LF, '\0'};
    char *cptr;

EC( ECCheckStream(target);                                              )

    /* 
     * Put HTTP request-line; METHOD URI HTTPVersion CRLF.
     */
    if (rptr->HTR_method != HTM_INVALID) {
    	PUTBLOCK(target, (byte *)HTMethodName(rptr->HTR_method));
	PUTBLOCK(target, (byte *)" ");
    } else {
	PUTBLOCK(target, (byte *)"GET ");
    }

    /*
     * We have to use the complete URI if we are using a proxy, 
     * else use the URI abs_path.
     */
    urlHtmh = HTAnchorAddress(rptr->HTR_anchor);
    cptr = (char *) HTMemLock(urlHtmh);

    if (rptr->HTR_proxy) 
	PUTBLOCK(target, (byte *)cptr);

    else { 
	byte *b;
	htmh = HTParseURI(cptr, NULL,
			  HTURI_PARSE_PATH | HTURI_PARSE_PUNCTUATION);
	b = (byte *) HTMemLock(htmh);
	PUTBLOCK(target, b);
	HTMemUnlockAndFree(htmh);
    }

    switch (rptr->HTR_version) {
    case HTTPV_1_0:
	sprintf((char *)linebuf, " HTTP/1.0%c%c", CR, LF);
	break;

    case HTTPV_1_1:
	sprintf((char *)linebuf, " HTTP/1.1%c%c", CR, LF);
	break;

    default:

EC(     EC_ERROR(HTTP_VERSION_NOT_IMPLEMENTED);                         )

        break;
    }

    PUTBLOCK(target, linebuf);

    /* 
    ** Put HTTP request headers.
    ** ------------------------
    */
    
    /*
     * Maintain persistent connection
     *
     * Connection: Keep-Alive
     */
    if (rptr->HTR_version == HTTPV_1_0) {
	/* 
	 * Net is persistent until connection closed by server
	 * or us in garbage collecting Net threads.
	 */
	HTNetSetPersistent(net, TRUE);
	PUTBLOCK(target, (byte*)"Connection: Keep-Alive");
	PUTBLOCK(target, (byte*)crlf);
    }

    /*
     * User-Agent: ...
     */
    htmh = HTSessionLookup(rptr->HTR_client); 
    if (htmh) {
	HTLibEnv *env = (HTLibEnv *) HTMemLock(htmh);
	if (env->HTLE_userAgent) {
	    byte *b;
	    PUTBLOCK(target, (byte*)"User-Agent: ");
	    b = (byte*)HTMemLock(env->HTLE_userAgent);
	    PUTBLOCK(target, b);
	    HTMemUnlock(env->HTLE_userAgent);
	    PUTBLOCK(target, (byte *)crlf);
	}
	HTMemUnlock(htmh);
    }

    /*
     * Host: ...
     */
    htmh = HTParseURI(cptr, NULL, HTURI_PARSE_HOST | 
		      HTURI_PARSE_PORT | HTURI_PARSE_PUNCTUATION);
    if (htmh) {
	byte *b;
	PUTBLOCK(target, (byte*)"Host: ");
	b = (byte *) HTMemLock(htmh);
	PUTBLOCK(target, b);
	PUTBLOCK(target, (byte*)crlf);
	HTMemUnlockAndFree(htmh);
    }
    HTMemUnlockAndFree(urlHtmh);

    /*
     * Authorization: ...
     */
    HTAAComposeAuth(rptr);
    if (rptr->HTR_aa.HTA_authorization) {
	byte *b;
	PUTBLOCK(target, (byte *)"Authorization: Basic ");
	b = (byte *) HTMemLock(rptr->HTR_aa.HTA_authorization);
	PUTBLOCK(target, b);
	HTMemUnlock(rptr->HTR_aa.HTA_authorization);
	PUTBLOCK(target, (byte *)crlf);
	/* Cache response only for the current session */
	rptr->HTR_persistentCache = FALSE;
    }

    /*
     * If-Modified-Since: ...
     */
    if (rptr->HTR_method == HTM_GET &&
	rptr->HTR_anchor && HTAnchorCacheHit(rptr->HTR_anchor)) {
	HTMemHandle date;
	date = HTAnchorLastModified(rptr->HTR_anchor);
	if (!date) date = HTAnchorExpires(rptr->HTR_anchor);
	if (!date) date = HTAnchorDate(rptr->HTR_anchor);
	if (date) {
	    byte *b;
	    PUTBLOCK(target, (byte *)"If-Modified-Since: ");
	    b = (byte*) HTMemLock(date);
	    PUTBLOCK(target, b);
	    HTMemUnlockAndFree(date);
	    PUTBLOCK(target, (byte*)crlf);
	}
    }

    /*
     * Pragma: no-cache
     */
    if (rptr->HTR_reloadMode == HTRELOAD_FORCE_RELOAD) {
	PUTBLOCK(target, (byte*)"Pragma: no-cache");
	PUTBLOCK(target, (byte*)crlf);
    }
    
    /*
     * Proxy-Authorization: "Basic" SP basic-cookie
     */
    if (rptr->HTR_proxy && rptr->HTR_proxyAuth) {
	byte *b;
	PUTBLOCK(target, (byte*)"Proxy-Authorization: Basic ");
	b = (byte *) HTMemLock(rptr->HTR_proxyAuth);
	PUTBLOCK(target, b);
	HTMemUnlock(rptr->HTR_proxyAuth);
	PUTBLOCK(target, (byte *)crlf);
    }

    /* 
     * Accept: image/gif, image/jpeg, 
     */
    if (rptr->HTR_reqHdMask & HTRH_ACCEPT) {
	PUTBLOCK(target, (byte*)"Accept: image/gif, image/jpeg, */*");
	PUTBLOCK(target, (byte*)crlf);
    }
    
    /* 
     * Accept-Charset: iso-8859-1
     */
    if (rptr->HTR_reqHdMask & HTRH_ACCEPT_CHARSET) {
	PUTBLOCK(target, (byte*)"Accept-Charset: iso-8859-1");
	PUTBLOCK(target, (byte*)crlf);
    }
    
    /* 
     * Accept-Language: en
     */
    if (rptr->HTR_reqHdMask & HTRH_ACCEPT_LANGUAGE) {
	PUTBLOCK(target, (byte*)"Accept-Language: en");
	PUTBLOCK(target, (byte*)crlf);
    }

    /*
     * Accept-Encoding
     */
    /* @@@ */

    /* 
     * Cookie: ... (Netscape HTTP Cookies) 
     */
    {
	HTListHandle list = HTAnchorFindCookies(rptr->HTR_anchor);
	if (list) {
	    int count = HTListGetCount(list);
	    if (count) {
		int i;
		HTMemHandle tmp;
		char *c;

		PUTBLOCK(target, (byte*)"Cookie: ");
		for (i=0; i<count; i++) {
		    if (i != 0) {
			PUTBLOCK(target, (byte*)"; ");
		    }
		    HTListRemoveItem(list, 0, &tmp, sizeof(HTMemHandle));
		    c = HTMemLock(tmp);
		    PUTBLOCK(target, (byte*)c);
		    HTMemUnlockAndFree(tmp);
		}
		PUTBLOCK(target, (byte*)crlf);
	    }
	    HTListDelete(list);
	}
    }

    /* Extra headers as "name: value" pairs */
    if (rptr->HTR_extraHeaders) {
	HTMemHandle str;
	char *c;
	int i = 0, count = HTListGetCount(rptr->HTR_extraHeaders);
	/* Must be even, see HTRequestAddHeader */
EC(     if (count%2 != 0) EC_ERROR(1);                                  )
	while (count) {
	    HTListGetItem(rptr->HTR_extraHeaders, i, (void*)&str, 
			  sizeof(HTMemHandle));
	    c = (char *)HTMemLock(str);
	    PUTBLOCK(target, (byte*)c);
	    PUTBLOCK(target, (byte*)": ");
	    HTMemUnlock(str);

	    HTListGetItem(rptr->HTR_extraHeaders, i+1, (void*)&str, 
			  sizeof(HTMemHandle));
	    c = (char *)HTMemLock(str);
	    PUTBLOCK(target, (byte*)c);
	    PUTBLOCK(target, (byte*)crlf);
	    HTMemUnlock(str);

	    i += 2;
	    count -= 2;
	}
    }
    
    if (endHeader) PUTBLOCK(target, crlf);

    return HT_OK;
    /* see HTTPReq.c */
}	/* End of HTTPMakeRequest.	*/



/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_HTTP_REQ_END_HEADER for HTTPReqClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Indicates whether to end header by putting an empty
 *                  line consisting only of CRLF.
 * PARAMETERS:	    void (HTNetThread *net, Boolean endHeader);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/23/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTTPReqClass, MSG_HTTP_REQ_END_HEADER
{
    @self->HTRI_net = net;
    @self->HTRI_endHeader = endHeader;
}	/* End of MSG_HTTP_REQ_END_HEADER.	*/




/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTTPReqClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Flush all buffered data down the input stream pipe.
 * PARAMETERS:	    int (void)
 *                  return HT_OK if sucessful, else HT_NO.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPReqClass, MSG_HT_STREAM_FLUSH
{
    return @call oself::MSG_HT_STREAM_PUT_BLOCK(NULL, 0);
}	/* End of MSG_HT_STREAM_FLUSH.	*/




/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTTPReqClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Put HTTP request headers down the stream pipe.
 * PARAMETERS:	    int (const byte data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        The HTTP request headers are set using HTRequestSet
 *                  APIs in <WWW/HTCore/htreq.goh>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPReqClass, MSG_HT_STREAM_PUT_BLOCK
{
    int status = HT_OK;
    HTRequest *rptr;
    
    if (@self->HTSI_transparent)
	return @call @self->HTSI_target::MSG_HT_STREAM_PUT_BLOCK(
					data, len);

    else {
	rptr = (HTRequest *) MemThreadGrab(@self->HTSI_request);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	if (rptr->HTR_version == HTTPV_0_9)
	    status = HTTPMake09Request(rptr, @self->HTSI_target, TRUE);
	else 
	    status = HTTPMakeRequest(@self->HTRI_net, rptr,
				     @self->HTSI_target, 
				     @self->HTRI_endHeader);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	MemThreadRelease(@self->HTSI_request);

	if (status == HT_OK)
	    status = @call @self->HTSI_target::MSG_HT_STREAM_PUT_BLOCK(
					data, len);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	@self->HTSI_transparent = TRUE;
    }

    return status;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/




/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTTPReqClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Abort the current stream and the target stream 
 * 		    object.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    Nothing.
 *
 * STRATEGY:	    Flush all input to target, abort the target, and
 *                  then free oself. For this to work, a stream object
 *                  must not be the target of multiple stream objects.
 *                  If it is, it must be able to handle multiple abort
 *                  messages. Must use @call as we must abort the 
 *                  stream pipes before returning. The client depends
 *                  on it as the request may be changed/deleted.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTTPReqClass, MSG_HT_STREAM_ABORT
{

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (@self->HTSI_target != NullOptr) {
	@call @self->HTSI_target::MSG_HT_STREAM_ABORT(status);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	@self->HTSI_target = NullOptr;
    }

    /*
     * Since the object class may go away before we get a chance
     * to execute the following forcequeued message, we need to 
     * change it's class pointer to its base class.
     */
    HTUtilChangeClassToHTStreamClass(oself);
    @send,forceQueue oself::MSG_META_OBJ_FREE();

    return HT_OK;
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
		Public Functions
***********************************************************************/


/***********************************************************************
 *		HTTPReqNew
 ***********************************************************************
 *
 * SYNOPSIS:	Create a HTTP Request header generator. endHeader 
 *              indicates whether HTTPReq stream is going to terminate
 *              the headers by putting an empty line consisting of CRLF.
 * CALLED BY:	Library
 * RETURN:	HTStreamHandle, NullOptr if not created.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/23/97   	Initial Revision
 *	
 ***********************************************************************/
HTStreamHandle _far _pascal
HTTPReqNew (HTNetThread *net, Boolean endHeader)
{
    HTStreamHandle stream;

    PUSHDS;
    SET_DS_LIB_DGROUP;
    stream = HTObjInstantiateForThread(0, &HTTPReqClass);
    POPDS;

    if (!stream) {
	/* Log error */
    } else {
	/* Initialize the stream instance data */
	@call stream::MSG_HT_STREAM_SET_REQUEST(net->HTNT_request);
	@call stream::MSG_HTTP_REQ_END_HEADER(net, endHeader);
    }
    return stream;
}	/* End of HTTPReqNew.	*/
