@ifndef __PM_UTILITY_GOH__
@define __PM_UTILITY_GOH__

typedef struct {
    ClassStruct *HC_text;         /* HTGenTextClass */
    ClassStruct *HC_formText;     /* HTGenFormTextClass */
    ClassStruct *HC_textareaText; /* TextAreaTextClass */
    ClassStruct *HC_textarea;     /* TextAreaClass */
    ClassStruct *HC_image;        /* HTGenImageClass */
    ClassStruct *HC_table;        /* HTGenTableClass */
    ClassStruct *HC_tcell;        /* HTGenTCellClass */
    ClassStruct *HC_input;        /* HTGenInputClass */
    ClassStruct *HC_trigger;      /* HTGenFormTriggerClass */
    ClassStruct *HC_otherOption;  /* HTOtherOptionClass */
    ClassStruct *HC_selection;    /* HTGenMultiLineSelectClass */
    ClassStruct *HC_hr;           /* HTGenHRClass */
    ClassStruct *HC_caption;      /* HTGenCaptionClass */
    ClassStruct *HC_content;      /* HTGenHtmlContentClass */
} HTMLClasses;

extern HTMLClasses htmlClass;

@endif
