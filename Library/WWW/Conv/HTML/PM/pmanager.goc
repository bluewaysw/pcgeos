/***********************************************************************
 *	MSG_PM_SEARCH_NO_MORE_FOUND for ISPresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Intercept this routine and update the ui about the
 *                  search state.
 * PARAMETERS:	    (int direction)
 *                  direction == 1 if search forward.
 *                            == 0 if serach backward.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/30/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SEARCH_NO_MORE_FOUND
{
    @send (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	    (UI_SEARCH_NOT_FOUND, direction);
    return;
}	/* End of MSG_PM_SEARCH_NO_MORE_FOUND.	*/

@endif /*ifndef product_responder */

@ifdef BROTHER_KERNEL
/***********************************************************************
 *		GetPathToFocusImage
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    The application wants the full path of the image.
 *	Send a message to the object, but verify that it's an image.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	jeremyb 	11/17/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal GetPathToFocusImage()
{
	HTMemHandle urlHtmh;
	ClassStruct *currClass;

	PUSHDS ;
	SET_DS_LIB_DGROUP ;

	urlHtmh = 0 ;	
	currClass = @call (uiMgr.UIM_currentDoc)->PM_focalObj::
		MSG_META_GET_CLASS();

	/* Here's the only good reason not to have the app call the obj
	 * directly
	 */
	if (currClass == htmlClass.HC_image) {	
		urlHtmh = @call ((uiMgr.UIM_currentDoc)->PM_focalObj)::
			MSG_GEN_IMAGE_GET_FULL_PATH() ;
	}

	POPDS; 
	return (urlHtmh);
}	/* End of MSG_PM_GET_FOCUS_IMAGE.	*/

@endif
