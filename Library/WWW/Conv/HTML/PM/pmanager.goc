}	/* End of MSG_PM_PRINT_UI_TREE.	*/



/***********************************************************************
 *		CreateChunkToSaveData
 ***********************************************************************
 * SYNOPSIS:	Allocate and return a chunk in the owner resource.
 * CALLED BY:	
 * RETURN:	HTMemHandle
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/14/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle 
CreateChunkToSaveData (char *ptr)
{
  HTMemHandle handle;
  char *dest;
  /*
   *  Allocate a memory chunk.
   */
  handle = HTMemAllocWID(uiMgr.UIM_currentDoc->HTUI_memID, sizeof(char) * (strlen(ptr)+1));
EC(ECCheckHTMemHandle(handle);)
  /*
   *  Copy the title string over.
   */
  dest = (char *)HTMemLock(handle);
  strcpy(dest, ptr);
  HTMemUnlock(handle);
  return handle;
}	/* End of CreateChunkToSaveData.	*/



/***********************************************************************
 *		MSG_PM_SAVE_HREF for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the HREF value and return a HREF token of it.
 * PARAMETERS:	    (char *href)
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_HREF
{
  int len, index;

  len = strlen(href);
  /*
   *  Has the HREF existed before?  If not, store it.
   */
  index = HTListFindItem((uiMgr.UIM_currentDoc)->PM_hrefs, href, len);
  if (index == -1)
    index = HTListAppend((uiMgr.UIM_currentDoc)->PM_hrefs, href, len);

  return index;
}	/* End of MSG_PM_SAVE_HREF.	*/


/***********************************************************************
 *		MSG_PM_SAVE_ANCHOR_NAME for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the NAME attribute value of an <A> element.
 * PARAMETERS:	    (char *name)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SAVE_ANCHOR_NAME
{
  NameElement elm;
  int len, check1, check2;

  if (name[0] == '#')
      name++;  /* skip the # sign */
  len = strlen(name);

  check1 = HTListAppend((uiMgr.UIM_currentDoc)->PM_anchorName, name, len);
  elm.NE_object = object;
  elm.NE_offset = offset;
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  check2 = HTListAppend((uiMgr.UIM_currentDoc)->PM_nameElement, &elm, sizeof(NameElement));
  /*
   *  PM_anchorName and PM_nameElement have one-to-one relationship.  
   *  That is, the first element in PM_anchorName is related to the
   *  first elment in PM_nameElement, and so on....
   */
  EC_WARNING_IF(check1 != check2, PM_ASSUMPTION_FAILS);

  return;
}	/* End of MSG_PM_SAVE_ANCHOR_NAME.	*/


/***********************************************************************
 *		MSG_PM_REFER_HYPERLINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the hrefToken, jump to the destination, which
 *                  could be
 *                  1) a named place on the same page, or
 *                  2) a different URL.
 * PARAMETERS:	    (int hrefToken)
 * SIDE EFFECTS:    
 *
 * STRATEGY:  If the refered place is 
 *            1) a named location on the same page, scroll the view to
 *               that place.
 *            2) a URL, make a request to load the page.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_HYPERLINK
{
  int len, nameToken;
  char *buffer, *url, *q;
  MemHandle mem;
  HTMemHandle urlHtmh;
  NameElement elm;
  SizeAsDWord sz;
  /*
   *  Find out the href string size, so we know how much space to 
   *  allocate to get the href string.
   */
  len = HTListGetItemSize((uiMgr.UIM_currentDoc)->PM_hrefs, hrefToken);
  mem = MemAlloc((len+1) * sizeof(char),
		    HF_DYNAMIC | HF_SHARABLE, HAF_STANDARD);
  buffer = MemLock(mem);
  HTListGetItem((uiMgr.UIM_currentDoc)->PM_hrefs, hrefToken, buffer, len);
  buffer[len] = NULL;
  if (buffer[0] == '#') {
    /* 
     *  It's a reference to the same page.
     */
    nameToken = HTListFindItem((uiMgr.UIM_currentDoc)->PM_anchorName, buffer+1, len-1);
    if (nameToken != -1) {
    HTListGetItem((uiMgr.UIM_currentDoc)->PM_nameElement, nameToken,
		  &elm,sizeof(NameElement));
    sz = @call self::MSG_VIS_GET_SIZE();
    @call self::MSG_PM_SHOW_ANCHOR(elm, DWORD_HEIGHT(sz));
    }
    EC_WARNING_IF(nameToken == -1, PM_ANCHOR_NAME_NOT_FOUND);
    MemFree(mem);
  }
  else {
    /*
     *  It's a referece to another page.  Thus make a request to the 
     *  socket library to fetch a new page.
     */
    url = HTMemAllocAndLock(&urlHtmh, len + 1);
    strcpy(url, buffer);
    *(url + len) = 0;

    if ((q=strchr(url, '#')) != NULL) {
	/*
	 *  If it has #anchor, record it for the next page.
	 */
	if (uiMgr.UIM_jumpToAnchor)
	    HTMemFree(uiMgr.UIM_jumpToAnchor);
	uiMgr.UIM_jumpToAnchor = HTStrAllocCopyWID
	    (uiMgr.UIM_currentDoc->HTUI_memID,q+1);
    }
    HTMemUnlock(urlHtmh);

    @send (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	    (UI_APPLY_ON_LINK, urlHtmh);

    if ((uiMgr.UIM_currentDoc)->PM_linkUnderMouse)
      MemFree((uiMgr.UIM_currentDoc)->PM_linkUnderMouse);
    (uiMgr.UIM_currentDoc)->PM_linkUnderMouse = mem;
    MemUnlock(mem);
  }
  return;
}	/* End of MSG_PM_REFER_HYPERLINK.	*/


/***********************************************************************
 *	MSG_PM_SET_ANCHOR for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the targeted anchor object that will be 
 *                  brought into the view.
 * PARAMETERS:	    (optr obj, int offset)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SET_ANCHOR
{
    (uiMgr.UIM_currentDoc)->PM_anchorObj = obj;
    (uiMgr.UIM_currentDoc)->PM_anchorOffset = offset;
    return;
}	/* End of MSG_PM_SET_ANCHOR.	*/


/***********************************************************************
 *		MSG_PM_RECORD_ANCHOR_OBJECT for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Record a focusable object into a list.
 * PARAMETERS:	    (optr object);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_RECORD_ANCHOR_OBJECT
{
    word cnt;
    optr lastObj;
    cnt = HTListGetCount((uiMgr.UIM_currentDoc)->PM_anchorList);
    if (cnt > 0) {
	HTListGetItem((uiMgr.UIM_currentDoc)->PM_anchorList, cnt-1, &lastObj, sizeof(optr));
	if (lastObj == object)
	    return;
    }
    HTListAppend((uiMgr.UIM_currentDoc)->PM_anchorList, &object, sizeof(optr));
    return;
}	/* End of MSG_PM_RECORD_ANCHOR_OBJECT.	*/

/***********************************************************************
 *		MSG_VIS_SET_SIZE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Intercept this routine to check if there is any
 *                  destination anchor we'd like to bring up into the
 *                  view.  Note, at this momement GenView should be
 *                  be set bigger before the PManager and content set
 *                  bigger.
 * PARAMETERS:	    (int width, int height);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/17/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_VIS_SET_SIZE
{
  Rectangle objrect;
  @callsuper();
  /*
   *  There is an anchorObj waiting to be brought into the view.  This object
   *  is the targeted anchor pointer of <A HREF=url#name> that user had
   *  clicked on the previous page.
   */
  if ((uiMgr.UIM_currentDoc)->PM_anchorObj) {
    @call (uiMgr.UIM_currentDoc)->PM_anchorObj::MSG_VIS_GET_BOUNDS(&objrect);
    if ((@call (uiMgr.UIM_currentDoc)->PM_anchorObj::MSG_VIS_GET_ATTRS() & VA_REALIZED) &&
	height > objrect.R_top) {
      NameElement elm;
      elm.NE_object = (uiMgr.UIM_currentDoc)->PM_anchorObj;
      elm.NE_offset = (uiMgr.UIM_currentDoc)->PM_anchorOffset;
      if (@call self::MSG_PM_SHOW_ANCHOR(elm, height))
	  (uiMgr.UIM_currentDoc)->PM_anchorObj = (uiMgr.UIM_currentDoc)->PM_anchorOffset = NULL;
    }
  }
  return;
}	/* End of MSG_VIS_SET_SIZE.	*/


/***********************************************************************
 *		MSG_VIS_OPEN for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    If this ui tree is rebuilt from cache, and this
 *                  action is the result of user's clicking on a link,
 *                  and the link has "#anchor", then bring the anchor
 *                  into view.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	12/10/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_VIS_OPEN
{
  int len, index;
  char *name;
  NameElement elm;
  SizeAsDWord sz;

  @callsuper();
  if (uiMgr.UIM_jumpToAnchor && uiMgr.UIM_currentDoc &&
      (uiMgr.UIM_currentDoc)->PM_anchorName &&
      (uiMgr.UIM_currentDoc)->PM_nameElement) {
      name = HTMemLock(uiMgr.UIM_jumpToAnchor);
      len = strlen(name);
      /*
       *  Has the HREF existed before?  If not, erase it.
       */
      index = HTListFindItem((uiMgr.UIM_currentDoc)->PM_anchorName, name, len);
      if (index > -1) {
	  elm.NE_object = NULL;
	  HTListGetItem((uiMgr.UIM_currentDoc)->PM_nameElement, index,
			&elm, sizeof(NameElement));
	  EC_ERROR_IF(elm.NE_object == NULL, 1);
	  sz = @call self::MSG_VIS_GET_SIZE();
	  @call self::MSG_PM_SHOW_ANCHOR(elm, DWORD_HEIGHT(sz));
      }
      HTMemUnlockAndFree(uiMgr.UIM_jumpToAnchor);
      uiMgr.UIM_jumpToAnchor = 0;
  }

  EC_ERROR_IF(uiMgr.UIM_view == NULL, 1);
  if (uiMgr.UIM_currentDoc && 
      ((uiMgr.UIM_currentDoc)->HTUI_viewOrigin.PD_y ||
       (uiMgr.UIM_currentDoc)->HTUI_viewOrigin.PD_x)) {
      /*
       *  Restore the origin of the cached page!
       */
      @call (uiMgr.UIM_view)::MSG_GEN_VIEW_SET_ORIGIN
	  ((uiMgr.UIM_currentDoc)->HTUI_viewOrigin.PD_y, 
	   (uiMgr.UIM_currentDoc)->HTUI_viewOrigin.PD_x);
  }
  else
      @call (uiMgr.UIM_view)::MSG_GEN_VIEW_SET_ORIGIN(0,0);

  return;
}	/* End of MSG_VIS_OPEN.	*/



/***********************************************************************
 *		MSG_PM_SHOW_ANCHOR for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Bring the anchor object into the view.  If the 
 *                  document is not long enough(i.e. the destination 
 *                  anchor is outside the document), it will do nothing.
 * PARAMETERS:	    (NameElement elm, int contentHeight)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_SHOW_ANCHOR
{
  Rectangle rect;
  VisTextConvertOffsetParams params;
  word pos;
  optr parent, next;

  if (elm.NE_offset == -1) {
      /*
       *  Bring up the BOTTOM of this object on the screen.  However, 
       *  if we can find the next object, then bring the top edge of
       *  the next object into view.
       */
      parent = @call elm.NE_object::MSG_GEN_FIND_PARENT();
      pos = @call parent::MSG_GEN_FIND_CHILD(elm.NE_object);
      next = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(pos+1);
      if (next) {
	  @call next::MSG_VIS_GET_BOUNDS(&rect);
	  if (rect.R_top > contentHeight)
	      return FALSE;
	  @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	      (rect.R_left, rect.R_top);
      }
      else {
	  @call elm.NE_object::MSG_VIS_GET_BOUNDS(&rect);
	  if (rect.R_bottom > contentHeight)
	      return FALSE;
	  @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	      (rect.R_left, rect.R_bottom);
      }
  }
  else if (elm.NE_offset == 0) {
      /* Bring up the TOP of this object on the screen. */
      @call elm.NE_object::MSG_VIS_GET_BOUNDS(&rect);
      if (rect.R_top > contentHeight)
	  return FALSE;
      @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
	  (rect.R_left, rect.R_top);
  }
  else {
      /* elm.NE_object MUST be a text object. */
      if (elm.NE_object &&
	  @call elm.NE_object::MSG_META_IS_OBJECT_IN_CLASS(&GenTextClass)){
	  if (!(@call elm.NE_object::MSG_VIS_GET_OPT_FLAGS() & 
	      VOF_GEOMETRY_INVALID)) {
	    params.VTCOP_offset = elm.NE_offset;
	    @call elm.NE_object::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE
		(&params);
	    if (params.VTCOP_yPos + Y_SCREEN_SIZE > contentHeight)
		return FALSE;
	    @call @genParent::MSG_HTML_CONTENT_VIEW_OBJECT
		(params.VTCOP_xPos, params.VTCOP_yPos);
	}
      }
  }
  return TRUE;
}	/* End of MSG_PM_SHOW_ANCHOR.	*/



/***********************************************************************
 *	MSG_PM_REFER_AREAMAP_LINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the URL of the clicked <AREA>
 * PARAMETERS:	    (HTMemHandle src)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/18/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_AREAMAP_LINK
{
  HTMemHandle urlHtmh;
  char *url, *cptr;
  /*
   *  User has chosen a hot spot in an client-side image map.  
   *  Thus, we pass the the HREF url in the clicked <AREA>.
   */
  (uiMgr.UIM_currentDoc)->PM_x = -1;
  (uiMgr.UIM_currentDoc)->PM_y = -1;

  cptr = HTMemLock(src);

  url = HTMemAllocAndLock(&urlHtmh, strlen(cptr) + 1);
  strcpy(url, cptr);


  HTMemUnlock(urlHtmh);
  /* can't free src.  It's not a copy but pointing to an actual data */
  HTMemUnlock(src);
	
  @send (ConstructOptr(uiMgr.UIM_client, 0))::
      {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	  (UI_APPLY_ON_LINK, urlHtmh);
  return;
}	/* End of MSG_PM_REFER_AREAMAP_LINK.	*/


/***********************************************************************
 *		MSG_PM_REFER_ISMAP_LINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the URL of the <A> and the mouse coordinates
 * PARAMETERS:	    (int rel_x, int rel_y, int hrefToken)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/28/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_REFER_ISMAP_LINK
{
  int len;
  HTMemHandle mem, urlHtmh;
  char *buffer, *url, *cptr;
  /*
   *  User has chosen a server-side ismap.  Thus, we pass the 
   *  URL of the anchor <A> and the mouse's relative coordinates.
   */
  (uiMgr.UIM_currentDoc)->PM_x = rel_x;
  (uiMgr.UIM_currentDoc)->PM_y = rel_y;
  len = HTListGetItemSize((uiMgr.UIM_currentDoc)->PM_hrefs, hrefToken);
  buffer = HTMemAllocAndLockWID(uiMgr.UIM_currentDoc->HTUI_memID, &mem, (len+1) * sizeof(char));
  HTListGetItem((uiMgr.UIM_currentDoc)->PM_hrefs, hrefToken, buffer, len);
  buffer[len] = NULL;
  HTMemUnlock(mem);
  (uiMgr.UIM_currentDoc)->PM_src = mem;


  /*
   */
  cptr = HTMemLock((uiMgr.UIM_currentDoc)->PM_src);

  if((uiMgr.UIM_currentDoc)->PM_x > 0 && (uiMgr.UIM_currentDoc)->PM_y > 0) {
      url = HTMemAllocAndLock(&urlHtmh, strlen(cptr) + 10);

      sprintf(url,"%s?%d,%d", cptr, (uiMgr.UIM_currentDoc)->PM_x, (uiMgr.UIM_currentDoc)->PM_y);
  } else {
      url = HTMemAllocAndLock(&urlHtmh, strlen(cptr) + 1);
      strcpy(url, cptr);
  }

  HTMemUnlock(urlHtmh);
  /* can't free PM_src.  It's not a copy but an actual pointer */
  HTMemUnlock((uiMgr.UIM_currentDoc)->PM_src);
  (uiMgr.UIM_currentDoc)->PM_src = NullOptr;
	
  @send (ConstructOptr(uiMgr.UIM_client, 0))::
      {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	  (UI_APPLY_ON_LINK, urlHtmh);
}	/* End of MSG_PM_REFER_ISMAP_LINK.	*/



/***********************************************************************
 *		MSG_PM_CLEAR_HREF_LINK for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the PM_linkUnderMouse;
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/21/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_CLEAR_HREF_LINK
{
  if ((uiMgr.UIM_currentDoc)->PM_linkUnderMouse) {
    MemFree((uiMgr.UIM_currentDoc)->PM_linkUnderMouse);
    (uiMgr.UIM_currentDoc)->PM_linkUnderMouse = NULL;
  }
  return;
}	/* End of MSG_PM_CLEAR_HREF_LINK.	*/



/***********************************************************************
 *		MSG_PM_INITIALIZE for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Delete the ui tree.
 * PARAMETERS:	    none.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_INITIALIZE
{
  VisInstance  * vself;
  RectDWord rect;
  /*
   *  The reason to set focalObj -1 is because when MSG_GEN_DESTROY is
   *  called, MSG_SPEC_NAVIGATE_TO_NEXT(PREVIOUS)_FIELD will not look 
   *  for next focusable object.
   */
  /* Manage the geometry directly */
  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_MANAGED;

  (uiMgr.UIM_currentDoc)->PM_focalObjIndex = -1;
  (uiMgr.UIM_currentDoc)->PM_recvObj = oself;
  (uiMgr.UIM_currentDoc)->PM_focalLink = -1;
  (uiMgr.UIM_currentDoc)->PM_focalImage = 0;
  (uiMgr.UIM_currentDoc)->PM_hrefs = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);      /* Store the HREFs on the page */
  (uiMgr.UIM_currentDoc)->PM_anchorList = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID); /* Store the HREFs on the page */
  (uiMgr.UIM_currentDoc)->PM_anchorName = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID); /* Store the NAMEs on the page */
  (uiMgr.UIM_currentDoc)->PM_nameElement= HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID); /* Store needed info about NAMEs */
  /*
   *  Initialize navigation focus.
   */
  @call uiMgr.UIM_view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&rect);
  pmFocusRect = rect;
  return;
}	/* End of MSG_PM_INITIALIZE.	*/


