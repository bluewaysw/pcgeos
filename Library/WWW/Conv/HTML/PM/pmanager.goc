/***********************************************************************
 *	MSG_PM_TAKE_UNFINISHED_UI_OBJ for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Add a new ui object to the ui tree.
 *		    This object is not ready to be displayed yet because
 *		    more modifications will be added to this object at
 *		    some points later.
 * PARAMETERS:	    ErrorMsg (optr newObj)
 * SIDE EFFECTS:    none
 *
 * STRATEGY:
 *		    Add the newObj to the children list of the
 *		    receiving object(PM_recvObj) in the ui-tree.  This
 *		    object becomes the new receiving object.  Any future
 *		    incoming ui objects will be added to this object's
 *		    children list until this object is marked done
 *		    (usable).
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/17/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_TAKE_UNFINISHED_UI_OBJ
{
  if (newObj && (uiMgr.UIM_currentDoc)->PM_recvObj && (uiMgr.UIM_currentDoc)->PM_recvObj != newObj) {
      /* 
       * Add the new ui object to the ui tree
       */
      @call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_GEN_ADD_CHILD(newObj, CCO_LAST);
      /*
       * The ui object becomes the new receiving object for the next
       * ui object.
       */
      pself = ObjDerefGen( oself );
      (uiMgr.UIM_currentDoc)->PM_recvObj = newObj;
  }
  return PM_NO_ERROR;
}	/* End of MSG_PM_TAKE_UNFINISHED_UI_OBJ.	*/


/***********************************************************************
 *	MSG_PM_TAKE_FINISHED_UI_OBJ for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Add a new object to the ui-tree, set it usable.
 *		    This object is ready to be rendered on the screen.
 * PARAMETERS:	    ErrorMsg (optr newObj)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		    Add the new object to the children list of the
 *		    receiving object in the ui-tree.  Mark this new
 *		    object usable because this object will not have
 *		    any children.  The recieving object in the ui tree
 *		    is still the same object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/22/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_TAKE_FINISHED_UI_OBJ
{
  if (newObj && (uiMgr.UIM_currentDoc)->PM_recvObj) {
    /* 
     *  Add the new ui object to the ui tree
     *  Mark the new object usable.
     */
    @call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_GEN_ADD_CHILD(newObj, CCO_LAST);
    @call newObj::MSG_GEN_SET_USABLE(VUM_NOW);
    /*
     *  Let the object figure out the size and position in its content.
     */
    @call newObj::MSG_UI_CALC_SIZE_POSITION();
  }
  return PM_NO_ERROR;
}	/* End of MSG_PM_TAKE_FINISHED_UI_OBJ.	*/


/***********************************************************************
 *	MSG_PM_MARK_RECV_OBJECT_DONE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    The receiving ui object in the ui tree is ready
 *		    to be rendered on the screen.  (That means, the
 *		    receiving object don't have any more ui children,
 *		    and it has completely done figuring out the geometry
 *		    of its ui children.)
 * PARAMETERS:	    ErrorMsg ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		    Set the current receiving object of the ui-tree
 *		    usable, and set receiving object to its parent.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/22/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_MARK_RECV_OBJECT_DONE
{
  if (!(uiMgr.UIM_currentDoc)->PM_recvObj)
      return PM_ERROR;
  if ((uiMgr.UIM_currentDoc)->PM_recvObj != oself) {
      /*
       * Mark the receiving object usable.
       */
      @call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_GEN_SET_USABLE(VUM_NOW);

      /*
       *  Let the object figure out the size and position in its content.
       */
      @call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_UI_CALC_SIZE_POSITION();

      /*
       * Re-assign the receiving object optr to its parent.
       */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen( oself );
@endif
      (uiMgr.UIM_currentDoc)->PM_recvObj = 
	  @call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_GEN_FIND_PARENT();
  }

  if ((uiMgr.UIM_currentDoc)->PM_recvObj != oself) {	
      *parent = (uiMgr.UIM_currentDoc)->PM_recvObj;	/* the object is not PManager */
      *class = (ClassStruct *)@call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_META_GET_CLASS();
  } else {
      *parent = NULL;
      *class = NULL;
  }
  return PM_NO_ERROR;
}	/* End of MSG_PM_MARK_RECV_OBJ_DONE.	*/


/***********************************************************************
 *	MSG_PM_MARK_RECV_OBJECT_NOT_DONE for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    This routine is made special for the <CAPTION>
 *		    element.  Because it's not set usable until the
 *		    table construct is completed.
 * PARAMETERS:	    ErrorMsg ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/22/96   	Initial Revision
 *
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_MARK_RECV_OBJECT_NOT_DONE
{
  EC_ERROR_IF (!(uiMgr.UIM_currentDoc)->PM_recvObj, 1);
  if ((uiMgr.UIM_currentDoc)->PM_recvObj != oself) {
      (uiMgr.UIM_currentDoc)->PM_recvObj = @call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_GEN_FIND_PARENT();
  }
  if ((uiMgr.UIM_currentDoc)->PM_recvObj != oself) {	
      *parent = (uiMgr.UIM_currentDoc)->PM_recvObj;	/* the object is not PManager */
      *class = (ClassStruct *)@call (uiMgr.UIM_currentDoc)->PM_recvObj::MSG_META_GET_CLASS();
  }
  else {
      *parent = NULL;
      *class = NULL;
  }
  return PM_NO_ERROR;
}	/* End of MSG_PM_MARK_RECV_OBJ_NOT_DONE.	*/



/***********************************************************************
 *	MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS for PresentationManagerClass
 ***********************************************************************
 * SYNOPSIS:	    Return the optr of the current receiving object in
 *		    the ui tree.
 * PARAMETERS:	    void (optr *recvObj, ClassStruct **class)
