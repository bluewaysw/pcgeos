/***********************************************************************
 *	MSG_PM_DISPLAY_HREF_TARGET for ISPresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Intercept this routine to get the destination of
 *                  the link in focus.
 * PARAMETERS:	    (int hrefToken, optr imageOptr)
 *                  hrefToken - the token reference of the HREF value
 *                  imageOptr - if not NULL, it contains a image object
 *                              that has default icon and ready to be
 *                              fully extended.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method PresentationManagerClass, MSG_PM_DISPLAY_HREF_TARGET
{
  char *url;
  int len;
  HTMemHandle srcHtmh;

  if (!uiMgr.UIM_currentDoc || !((uiMgr.UIM_currentDoc)->PM_hrefs))
      return;

  (uiMgr.UIM_currentDoc)->PM_focalLink = hrefToken;
  (uiMgr.UIM_currentDoc)->PM_focalImage = imageOptr;

  if (hrefToken != -1) {

      len = HTListGetItemSize((uiMgr.UIM_currentDoc)->PM_hrefs, hrefToken);
      url = HTMemAllocAndLock(&srcHtmh, len + 1);
      HTListGetItem((uiMgr.UIM_currentDoc)->PM_hrefs, hrefToken, url, len);
      *(url + len) = 0;
      HTMemUnlock(srcHtmh);

      if(imageOptr)
	  @send (ConstructOptr(uiMgr.UIM_client, 0))::
	      {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
		  (UI_FOCUS_ON_IMAGE_LINK, srcHtmh);
      else
	  @send (ConstructOptr(uiMgr.UIM_client, 0))::
	      {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
		  (UI_FOCUS_ON_LINK, srcHtmh);

  } else if(imageOptr != NullOptr) {

      srcHtmh = @call imageOptr::MSG_GEN_IMAGE_GET_SRC();
      if (srcHtmh) 
	  @send (ConstructOptr(uiMgr.UIM_client, 0))::
	      {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
		  (UI_FOCUS_ON_IMAGE, srcHtmh);
  }

  return;
}	/* End of MSG_PM_DISPLAY_HREF_TARGET.	*/

