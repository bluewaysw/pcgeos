RedrawFocus (GStateHandle gstate, RectDWord *bound);

/*
 *  Define two constants for the depth first search algorithm.
 */
#define CONTINUE 0
#define STOP     1
/*
 *  Define constants for how to search the ui tree.
 */
#define TEXT_ONLY 0
#define TEXT_AND_IMAGE 1

/*
 *  Define structure containing all HTML classes defined in UIGenerator lib.
 *  This structure is used to do quick comparison instead of doing call
 *  MSG_META_IS_OBJECT_IN_CLASS.
 */
HTMLClasses htmlClass = {
    &HTGenTextClass,
    &HTGenFormTextClass,
    &TextAreaTextClass,
    &TextAreaClass,
    &HTGenImageClass,
    &HTGenTableClass,
    &HTGenTCellClass,
    &HTGenInputClass,
    &HTGenFormTriggerClass,
    &HTOtherOptionClass,
    &HTMLSelectClass,
    &HTGenHRClass,
    &HTGenCaptionClass,
    &HTGenHtmlContentClass,
};

/*
 *  Object being searched for a key word.
 */
optr searchObj;
VisTextRange searchRange;
/*
 *  Flags used to help to see if the key word has been found.
 */
Boolean searchFound;

/*
 *  Custom mask for the bound of the navigation focus.
 */
const DrawMask customMask = { 0xcc, 0xcc, 0x33, 0x33, 0xcc, 0xcc, 0x33, 0x33 };


RectDWord FindAndDrawFocalBound (int direction, optr object, 
				 Rectangle *objRect, RectDWord *rect, 
				 Rectangle *box);
void UndrawFocalBound(optr object, optr newLink);

@ifdef PRODUCT_NIKE  /* In first Penelope release we don't support search */
optr DepthFirstSearch (optr leaf, optr genContent, MemHandle searchInfo);
optr SearchInText(optr text, optr genContent, MemHandle searchInfo);
MemHandle DuplicateSearchInfo (MemHandle searchInfo);
@endif
optr GetNextSiblingOrParentsSibling (optr currentObj, int direction, int how);
void DrawMultiLineBox (GStateHandle gstate, 
		  RectDWord *drawBound, Rectangle *drawbox);



/***********************************************************************
 *		MSG_VIS_DRAW for PresentationManagerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw background when printing
 * PARAMETERS:	    void (DrawFlags drawFlags, GStateHandle gstate);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	joon    	9/18/97   	Initial Revision
 *	
 ***********************************************************************/

typedef struct {
    byte WCI_red;
    byte WCI_flags;
    byte WCI_green;
    byte WCI_blue;
} WinColorInfo;


@method PresentationManagerClass, MSG_VIS_DRAW
{
  @callsuper();

  if ((uiMgr.UIM_currentDoc)->PM_focalObj && 
      (uiMgr.UIM_currentDoc)->PM_drawbox.R_right == 0) {
    ClassStruct *currClass = @call (uiMgr.UIM_currentDoc)->PM_focalObj::
	MSG_META_GET_CLASS();
    if (currClass == htmlClass.HC_image ||
	currClass == htmlClass.HC_textarea ||
	currClass == htmlClass.HC_selection ||
	currClass == htmlClass.HC_formText)
	RedrawFocus (gstate, &((uiMgr.UIM_currentDoc)->PM_drawBound));
  }
}	/* End of MSG_VIS_DRAW.	*/



