}	/* End of MSG_UI_SET_NEW_POSITION.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenHRClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/


#ifdef __HIGHC__
#pragma Code("BROADCASTRESIZE");
#endif
#ifdef __BORLANDC__
#pragma codeseg BROADCASTRESIZE
#endif



/***********************************************************************
 *	UIGen_BROADCAST_RESIZE_POSITION_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Broadcast the MSG_VIS_RECALC_SIZE and 
 *                  MSG_VIS_POSITION_BRANCH down the ui (sub)tree.
 * PARAMETERS:	    (optr object)  object - parent of the (sub)tree.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/26/96   	Initial Revision
 *
 ***********************************************************************/
void UIGen_BROADCAST_RESIZE_POSITION_Int(optr object)
{
  optr content, changeObj = object, image = object, view;
  SizeAsDWord newSize, objSize;
  Rectangle objBound;
  RectDWord viewBound;
  Boolean sizeChanged = FALSE;
  word width, height;

  EC_ERROR_IF(!@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenImageClass),1);
  if (!object || @call object::MSG_GEN_IMAGE_IS_REPOSITION() == FALSE)
      return;
  @call image::MSG_VIS_GET_BOUNDS(&objBound);

  while(1) {
    if(@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenHtmlContentClass)||
       object == (uiMgr.UIM_currentDoc)->HTUI_pmanager) {
      /*
       *  Pass the parent object and the object that changes size to the
       *  content Note, the parent object can be the content.
       */
      if (object == (uiMgr.UIM_currentDoc)->HTUI_pmanager) {
	  content = (uiMgr.UIM_currentDoc)->HTUI_pmContent;
	  @call content::MSG_GEN_HTML_CONTENT_GET_DIMENSION(&width, &height);
	  if (width < X_SCREEN_SIZE)
	      width = X_SCREEN_SIZE;
          objSize = MAKE_SIZE_DWORD(width, height);
          newSize = @call content::MSG_GEN_HTML_CONTENT_RECALC_POSITIONS
	      (changeObj, object);
	  @call changeObj::MSG_VIS_POSITION_BRANCH(0,0);
      }
      else {
	  newSize = @call object::MSG_GEN_HTML_CONTENT_RECALC_POSITIONS
	      (changeObj, object);
	  if (@call changeObj::MSG_VIS_FIND_PARENT())
	      @call changeObj::MSG_VIS_POSITION_BRANCH(0,0);
	  objSize = @call object::MSG_VIS_GET_SIZE();
      }
      if (DWORD_HEIGHT(newSize) > DWORD_HEIGHT(objSize) ||
	  DWORD_WIDTH(newSize) > DWORD_WIDTH(objSize)) {
	/*
	 *  Now the child expands to be bigger than the parent.  Thus,
	 *  parent needs to expands as well.
	 */
	sizeChanged = TRUE;
	if (object == (uiMgr.UIM_currentDoc)->HTUI_pmanager) {
	  /*
	   *  PManager can't have a width smaller than the screen width.
	   *  Otherwise, the centered or right-aligned objects can't be
	   *  interacted.
	   */
	  if (DWORD_WIDTH(newSize) < X_SCREEN_SIZE)
	    newSize = MAKE_SIZE_DWORD(X_SCREEN_SIZE, DWORD_HEIGHT(newSize));
	  @call object::MSG_VIS_SET_SIZE(DWORD_WIDTH(newSize),
					 DWORD_HEIGHT(newSize));
	  object = @call object::MSG_GEN_FIND_PARENT();
	  @call object::MSG_VIS_SET_SIZE(DWORD_WIDTH(newSize),
					 DWORD_HEIGHT(newSize));
	  @call object::MSG_HTML_CONTENT_SET_VIEW_DOC_BOUNDS(newSize);
	  break;
        }
	else if (@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)){
	  /*
	   *  Now expand the parent(i.e. object) to properly contain the 
	   *  changeObj.
	   */
	  changeObj = object;
	  @call object::MSG_VIS_SET_SIZE(DWORD_WIDTH(newSize),
					 DWORD_HEIGHT(newSize));
	  object = @call object::MSG_GEN_FIND_PARENT();
	  EC ( EC_ERROR_IF(!@call object::MSG_META_IS_OBJECT_IN_CLASS
			   (&HTGenTableClass), 1); )
	  @call object::MSG_GEN_TABLE_RECALC_POSITIONS(changeObj, newSize);
	  if (@call object::MSG_GEN_GET_USABLE() == FALSE)
	      break;
	  changeObj = object;
	  object = @call object::MSG_GEN_FIND_PARENT();
	}
	else {
	  @call object::MSG_VIS_SET_SIZE(DWORD_WIDTH(newSize),
					 DWORD_HEIGHT(newSize));
	  /*
	   *  IF object is a Table or a Form, we depends on 
	   *  MSG_VIS_POSITION_BRANCH to resize to contain all children.
	   */
	  if (@call object::MSG_GEN_GET_USABLE() == FALSE)
	      break;
	  changeObj = object;
	  object = @call object::MSG_GEN_FIND_PARENT();
        }
      }
@if 0
      else if (DWORD_HEIGHT(newSize) < DWORD_HEIGHT(objSize)) {
	if (object == (uiMgr.UIM_currentDoc)->HTUI_pmanager) {
	  /*
	   *  PManager can't have a width smaller than the screen width.
	   *  Otherwise, the centered or right-aligned objects can't be
	   *  interacted.
	   */
	  if (DWORD_WIDTH(newSize) < X_SCREEN_SIZE)
	    newSize = MAKE_SIZE_DWORD(X_SCREEN_SIZE, DWORD_HEIGHT(newSize));
	  @call object::MSG_VIS_SET_SIZE(DWORD_WIDTH(newSize),
					 DWORD_HEIGHT(newSize));
	  object = @call object::MSG_GEN_FIND_PARENT();
	  @call object::MSG_VIS_SET_SIZE(DWORD_WIDTH(newSize),
					 DWORD_HEIGHT(newSize));
	  @call object::MSG_HTML_CONTENT_SET_VIEW_DOC_BOUNDS(newSize);
	  break;
        }
	else if (@call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)){
	  optr table;
	  word pwidth, pheight, newHeight, diff;
	  SizeAsDWord size;
	  table = @call object::MSG_GEN_FIND_PARENT();
	  EC_ERROR_IF(!@call table::MSG_META_IS_OBJECT_IN_CLASS
		      (&HTGenTableClass), 1);
	  diff = @call table::MSG_GEN_TABLE_SHRINK_ROW(object, newSize);
	  if (diff == 0)
	      break;
	  size = @call table::MSG_VIS_RECALC_SIZE(RSA_CHOOSE_OWN_SIZE,
						 RSA_CHOOSE_OWN_SIZE);
	  @call table::MSG_VIS_SET_SIZE(DWORD_WIDTH(size),
					DWORD_HEIGHT(size));
	  changeObj = object;
	  object = @call object::MSG_GEN_FIND_PARENT();
        }
      }
@endif
      else {
	/*
	 *  Ok, The size didn't change, but its children objects certainly
	 *  have changed positions.
	 *  Invalid that region of place.
	 */
	break;
      }
    }
    else {
	if (@call object::MSG_GEN_GET_USABLE() == FALSE)
	    break;
	changeObj = object;
	object = @call object::MSG_GEN_FIND_PARENT();
    }
  }
  if (@call image::MSG_VIS_FIND_PARENT())
      @send image::MSG_VIS_MARK_INVALID(VOF_IMAGE_INVALID,
					VUM_DELAYED_VIA_UI_QUEUE);
  /*
   *  Invalid a portion of screen if needed.
   */
      view = @call object::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&GenViewClass);
      @call view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&viewBound);
      if (sizeChanged == TRUE &&
	  objBound.R_top < viewBound.RD_bottom &&
	  objBound.R_left < viewBound.RD_right &&
	  objBound.R_right > viewBound.RD_left) 
	  /*
	   *  Object expanding at the top can move object below!
	   *  objBound.R_bottom > viewBound.RD_top 
	   *  Invalid the whole screen if the parent size changed as well.
	   */
	  InvalidRegion((uiMgr.UIM_currentDoc)->HTUI_pmanager,
			 0, 0, viewBound.RD_right - viewBound.RD_left,
			 viewBound.RD_bottom - viewBound.RD_top);
  return;
}	/* End of UIGen_BROADCAST_RESIZE_POSITION_Int.	*/


