/***********************************************************************
 *		UpdateHeightArray
 ***********************************************************************
 *
 * SYNOPSIS:	An object in a row expands the row height, so we need to
 *              add the difference of the old and height to the 
 *              following rows.  Note: all heights are in absolute 
 *              document coordinate.
 * CALLED BY:	
 * RETURN:	the sum of the heights of rows in the document.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
word
UpdateHeightArray 
(word newHeight, word heightPrevRow, HTListHandle heightArray, int row, 
 word totalCnt, optr parent, optr firstObj, int firstIndex)
{
    optr obj, view;
    word objRow;
    int diff, left, top, right, bottom;
    RectDWord viewBound;
    Rectangle objBound;
    /*
     *  diff can be positive(expanding) or negative(shrinking).
     */
    diff = heightPrevRow - newHeight;
    /*
     *  Update the row height for the row.
     */
    HTListReplaceItem(heightArray, row, 
		      &heightPrevRow, sizeof(int));
    /*  if (row+1 < totalCnt)
     *  Update the rest of row heights: simply add the difference.
     */
    for (objRow = row+1; objRow < totalCnt; objRow++) {
	HTListGetItem(heightArray, objRow,
		      &heightPrevRow, sizeof(int));
	heightPrevRow += diff;
	HTListReplaceItem(heightArray,
			  objRow, &heightPrevRow, sizeof(int));
    }
    /*
     *  Re-positioning starting from the firstObj, i.e. the first obj
     *  of the row in which the passed obj changes its size.
     */
    view = @call parent::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&GenViewClass);
    @call view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&viewBound);
    for (obj = firstObj; obj; ){
	if (!@call obj::MSG_VIS_FIND_PARENT())
	    break;  /* rest of siblings are not positioned yet */
	/*
	 *  invalid the old position.
	 */
	@call obj::MSG_VIS_GET_BOUNDS(&objBound);
	if (objBound.R_left < viewBound.RD_right && 
	    objBound.R_right > viewBound.RD_left && 
	    objBound.R_top < viewBound.RD_bottom &&
	    objBound.R_bottom > viewBound.RD_top) {

	    left = objBound.R_left - viewBound.RD_left;
	    top = objBound.R_top - viewBound.RD_top;
	    right = objBound.R_right - viewBound.RD_left;
	    bottom = objBound.R_bottom - viewBound.RD_top;
	    if (diff < 0) {
		bottom -= diff;
		top += diff;
	    }
	    else {
		bottom += diff;
		top -= diff;
	    }
	    InvalidRegion (parent, left, top, right, bottom);
	}
	@call obj::MSG_VIS_POSITION_BRANCH(0,0);
	obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(++firstIndex);
    }
    return heightPrevRow;
}	/* End of UpdateHeightArray.	*/


#ifdef __HIGHC__
#pragma Code("CONTENTRECALC");
#endif
#ifdef __BORLANDC__
#pragma codeseg CONTENTRECALC
#endif


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_RECALC_POSITIONS for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Re-position objects to the right of and below the
 *                  passed startObj that just changed its size.
 * PARAMETERS:	    (optr startObj, optr parent)
 *                  startObj - the object whose size just changed.
 *                  parent   - can be oself, or can be PManager.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/ 3/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_RECALC_POSITIONS
{
  int startPos, startRow, row, i, firstIndex, objRow, tmp, nextRow;
  optr obj, firstObj;
  SizeAsDWord objSize;
  word pWidth, heightPrevRow, heightCurrRow, accWidthCurrRow = MARGIN,
       accumulatedMargin = MARGIN,
       totalCnt = HTListGetCount(@self->HTGHC_heightArray), diff;
  optr view;
  RectDWord viewBound;
  Rectangle objBound;
  optr stopObj;

  if(@self->HTGHC_rowIndex < 0) {
      /* This can happen when loading *.gif or .jpg file directly */
      @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, startObj);
      totalCnt = HTListGetCount(@self->HTGHC_heightArray);
  }
  /*
   *  Scan to the first object in the row.
   *  While scanning backward in this row, find max height of objects seen
   *  so far in the backward direction, also accumulate the widths.
   */
  startPos = @call parent::MSG_GEN_FIND_CHILD(startObj);
  startRow = @call startObj::MSG_UI_GET_ROW_POSITION();
  obj = startObj;
  for (i = startPos - 1, heightCurrRow = 0; i >= 0; i--) {
    firstObj = obj;
    obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(i);
    row = @call obj::MSG_UI_GET_ROW_POSITION();
    if (row == -1)
	continue;  /*  it may be a HTGenFormHiddenClass */
    if (row != startRow)
	break;  /*  Break if we reach an object in the previous row. */
    EC_ERROR_IF(row > startRow, 1);
    /*
     *  Got one object still in the current row in the backward direction.
     *  Now update the max height and accumulate the width.
     */
    objSize = @call obj::MSG_VIS_GET_SIZE();
    if (heightCurrRow < DWORD_HEIGHT(objSize))
      heightCurrRow = DWORD_HEIGHT(objSize);
    if (!@call obj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenImageClass)) {
        accWidthCurrRow += (DWORD_WIDTH(objSize) + MARGIN);
        accumulatedMargin += MARGIN;
    }
  }
  firstIndex = i+1; /* the child index of the first object in the startRow */
  if (i == -1) {
    /*
     *  startObj is already the first object in the row.  In fact,
     *  the row is the first row of the document.
     */
    firstObj = obj;
  }
  if (startRow < 1)
    heightPrevRow = MARGIN;
  else
    /*
     *  startObj is in a row other than the first row.  Thus, let's get the
     *  absolute height of the previous row.  Later, we'll calculate the
     *  new absolute height this current row where the startObj changes its
     *  size.
     */
    HTListGetItem(@self->HTGHC_heightArray, startRow-1,
		  &heightPrevRow, sizeof(int));

  if (parent == uiMgr.UIM_currentDoc->HTUI_pmanager)
      pWidth = @call uiMgr.UIM_currentDoc->HTUI_pmContent::
	  MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE();
  else
      pWidth = @call parent::MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE();
  objSize = @call startObj::MSG_VIS_GET_SIZE();
  if (pWidth < DWORD_WIDTH(objSize))
      /* 
       * The startObj will expand its parent size anyway, so the pWidth
       * should be updated to the size of objSize.
       */
      pWidth = DWORD_WIDTH(objSize);

  /*
   *         (-:        LET'S REPOSITION OBJECTS       :-)
   *
   *  startPos - the child index of the passed object whose size 
   *             just changed.
   *  startRow - the row in which the passed object changed its size, 0-based.
   *  heightCurrRow - height of tallest object to the left of 
   *                  startObj in the same row.
   *  accWidthCurrRow - the sum of widths of all objects to the left of
   *                 startObj in the same row.
   *  heightPrevRow - the Y document position of the previous row.
   *  accumulatedMargin - accmulate the spaces between objects in 
   *                      the same row.
   */
  for (i = startPos, obj = startObj, row = startRow;
       obj;
       i++, obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(i)) {

    Boolean isObjImage = @call obj::
			MSG_META_IS_OBJECT_IN_CLASS(&HTGenImageClass) ;

    objSize = @call obj::MSG_VIS_GET_SIZE();

    if ((objRow = @call obj::MSG_UI_GET_ROW_POSITION()) > row) {
      /*
       *  We've reach an object that is already beyond the current adjusted 
       *  row.  We can stop repositioning all the following objects.
       */
      HTListReplaceItem(@self->HTGHC_rowArray, row, 
			&accWidthCurrRow, sizeof(int));
      /*
       *  Update the max row width.
       */
      if (accWidthCurrRow > @self->HTGHC_maxRowWidth) 
	@self->HTGHC_maxRowWidth = accWidthCurrRow; /* +MARGIN; */
      /*
       *  Update the rest of row heights.
       */
	heightPrevRow += heightCurrRow + MARGIN;
/******
      if (!isObjImage) {
	heightPrevRow += heightCurrRow + MARGIN;
      }
******/
      HTListGetItem(@self->HTGHC_heightArray, row,
		    &diff, sizeof(int));
      if (diff != heightPrevRow) {
	  heightPrevRow = UpdateHeightArray
	      (diff, heightPrevRow, @self->HTGHC_heightArray, row, totalCnt, 
	       parent, firstObj, firstIndex);
	  @self->HTGHC_sumOfHeights = heightPrevRow;
      }
      else {
	/*
	 *  Object didn't change size.  No resizing, no repositioning.
	 *  Simply return the hiehgt of the whole document.
	 */
	HTListGetItem(@self->HTGHC_heightArray, totalCnt-1,
			&heightPrevRow, sizeof(int));
	stopObj = obj;
	obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(firstIndex);

	view = @call parent::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&GenViewClass);
	@call view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&viewBound);

	for (; obj && obj != stopObj; ) {
	    if (!@call obj::MSG_VIS_FIND_PARENT())
		break; /*  Following sibling objects are not built yet. */
	    @call obj::MSG_VIS_GET_BOUNDS(&objBound);
	    InvalidRegion (parent, 
			   objBound.R_left - viewBound.RD_left,
			   objBound.R_top - viewBound.RD_top,
			   objBound.R_right - viewBound.RD_left,
			   objBound.R_bottom - viewBound.RD_top);
	    @call obj::MSG_VIS_POSITION_BRANCH(0,0);
	    @send obj::MSG_VIS_MARK_INVALID(VOF_IMAGE_INVALID,
					    VUM_DELAYED_VIA_UI_QUEUE);
	    obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(++firstIndex);
	}
      }
EC(   for (objRow = 0, i=0; objRow < totalCnt; objRow++) {
        HTListGetItem(@self->HTGHC_heightArray, objRow, 
		      &heightCurrRow, sizeof(int));
	EC_ERROR_IF(i >= heightCurrRow, 1);
	i = heightCurrRow;
      } )
      return MAKE_SIZE_DWORD(@self->HTGHC_maxRowWidth, heightPrevRow);
    }
    /*
     *  Can the object fit in the currently adjusted row?
     */
    if (accWidthCurrRow <= MARGIN || 
	accWidthCurrRow + DWORD_WIDTH(objSize) <= 
	(pWidth + accumulatedMargin)) {
	/*
	 *  The object can FIT in the current row.  Row is 0-based.
	 */
	@call obj::MSG_UI_SET_NEW_POSITION(accWidthCurrRow, row);
	accWidthCurrRow += DWORD_WIDTH(objSize);
	if (!isObjImage) {
	  accWidthCurrRow += MARGIN;
	  accumulatedMargin += MARGIN;
	}
	if (heightCurrRow < DWORD_HEIGHT(objSize))
	  heightCurrRow = DWORD_HEIGHT(objSize);
    }
    else {
      /*
       *  Can't fit in the current line.  Thus, let's wrap up all the 
       *  information of the current line before reseting variables for
       *  the next line.
       */
      heightPrevRow += heightCurrRow + MARGIN;
/*****
      if (!isObjImage) {
        heightPrevRow += MARGIN;
      }
*****/
      if (row < totalCnt) {
	  HTListGetItem(@self->HTGHC_heightArray, row,
			&diff, sizeof(int));
	  if (diff != heightPrevRow) {
	      @self->HTGHC_sumOfHeights = UpdateHeightArray
		  (diff, heightPrevRow, @self->HTGHC_heightArray, row, 
		   totalCnt, parent, firstObj, firstIndex);
	  }
	  HTListReplaceItem(@self->HTGHC_rowArray,
			    row, &accWidthCurrRow, sizeof(int));
      }
      else {
	  @self->HTGHC_rowIndex++;
	  totalCnt++;
	  tmp = HTListAppend(@self->HTGHC_heightArray,
		       &heightPrevRow, sizeof(int));
	  EC_ERROR_IF(tmp != @self->HTGHC_rowIndex, 1);
	  tmp = HTListAppend(@self->HTGHC_rowArray,
		       &accWidthCurrRow, sizeof(int));
	  EC_ERROR_IF(tmp != @self->HTGHC_rowIndex, 1);
	  EC_ERROR_IF(@self->HTGHC_sumOfHeights > heightPrevRow, 1);
	  @self->HTGHC_sumOfHeights = heightPrevRow;
      }
/*      EC_ERROR_IF(!(@self->GI_states & GS_USABLE), 1); */
      row++;
      if (!isObjImage) {
      @call obj::MSG_UI_SET_NEW_POSITION(MARGIN, row);
      } else {
	@call obj::MSG_UI_SET_NEW_POSITION(0, row);
      }
      if (accWidthCurrRow > @self->HTGHC_maxRowWidth)
	@self->HTGHC_maxRowWidth = accWidthCurrRow; /* + MARGIN; */
      accWidthCurrRow = DWORD_WIDTH(objSize) ;
      if (!isObjImage) {
        accWidthCurrRow = MARGIN + MARGIN;
        accumulatedMargin = MARGIN+MARGIN;
      }
      heightCurrRow = DWORD_HEIGHT(objSize);
    }
  }
  /*
   *  We've run out of children object of the parent.  Let's update the
   *  information of the last row.
   */
  /* JB: 6/8/98: Not changing this code: don't have an obj to refer to */
  heightPrevRow += heightCurrRow + MARGIN;
  if (row < totalCnt) {
    HTListGetItem(@self->HTGHC_heightArray, row,
		  &diff, sizeof(int));
    if (diff != heightPrevRow) {
	heightPrevRow = UpdateHeightArray
	    (diff, heightPrevRow, @self->HTGHC_heightArray, row, 
	     totalCnt, parent, firstObj, firstIndex);
	@self->HTGHC_sumOfHeights = heightPrevRow;
    }
    HTListReplaceItem(@self->HTGHC_rowArray,
		      row, &accWidthCurrRow, sizeof(int));
  }
/*  else if (row == totalCnt && !(@self->GI_states & GS_USABLE)) {
      ;   totalCnt is 1-based.
  } */
  else {
    @self->HTGHC_rowIndex++;
EC( totalCnt++;
    EC_ERROR_IF(@self->HTGHC_rowIndex != (totalCnt-1), 1);)
    i = HTListAppend(@self->HTGHC_heightArray,
		     &heightPrevRow, sizeof(int));
    EC_ERROR_IF(i != @self->HTGHC_rowIndex, 1);
    i = HTListAppend(@self->HTGHC_rowArray,
		 &accWidthCurrRow, sizeof(int));
    EC_ERROR_IF(i != @self->HTGHC_rowIndex, 1);
    EC_ERROR_IF(@self->HTGHC_sumOfHeights > heightPrevRow, 1);
    @self->HTGHC_sumOfHeights = heightPrevRow;
  }
  if (accWidthCurrRow > @self->HTGHC_maxRowWidth) 
      @self->HTGHC_maxRowWidth = accWidthCurrRow; /* +MARGIN; */

EC( obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(firstIndex); )
EC( EC_ERROR_IF(obj != firstObj, 1); )

  /*
   *  Start positioning the objects.
   */
  view = @call parent::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&GenViewClass);
  @call view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&viewBound);
  for (obj = firstObj; obj; ){
    if (!@call obj::MSG_VIS_FIND_PARENT())
	break;	/*  The next sibling object is not built out yet. */
    @call obj::MSG_VIS_GET_BOUNDS(&objBound);
    InvalidRegion (parent, 
		   objBound.R_left - viewBound.RD_left,
		   objBound.R_top - viewBound.RD_top,
		   objBound.R_right - viewBound.RD_left,
		   objBound.R_bottom - viewBound.RD_top);
    @call obj::MSG_VIS_POSITION_BRANCH(0,0);
    @send obj::MSG_VIS_MARK_INVALID(VOF_IMAGE_INVALID,
				    VUM_DELAYED_VIA_UI_QUEUE);
    obj = @call parent::MSG_GEN_FIND_CHILD_AT_POSITION(++firstIndex);
  }
EC(   for (objRow = 0, i=0; objRow < totalCnt; objRow++) {
        HTListGetItem(@self->HTGHC_heightArray, objRow, 
		      &heightCurrRow, sizeof(int));
	EC_ERROR_IF(i >= heightCurrRow, 1);
	i = heightCurrRow;
      } )
  return MAKE_SIZE_DWORD(@self->HTGHC_maxRowWidth, heightPrevRow);
}	/* End of MSG_GEN_HTML_CONTENT_RECALC_POSITIONS.	*/


/***********************************************************************
 *MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Return the accumulated row heights.
 * PARAMETERS:	    (word *width, word *height);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS
{
    *width = @self->HTGHC_maxRowWidth;
    *height = @self->HTGHC_sumOfHeights;
    return;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_SET_ROW_RESIZE for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Reposition rows after the table which shrinks in
 *                  height.  The rows are in the global content.
 * PARAMETERS:	    (optr startObj, int diff);
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	12/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_ROW_RESIZE
{
  int i, row, totalCnt;
  word oldHeight;
  SizeAsDWord sz;
  optr parent;

  if ((row = @call startObj::MSG_UI_GET_ROW_POSITION()) == -1)
      /*
       *  This happend when the document is loaded for the first time.
       *  If the page is re-built, for example the page has been loaded,
       *  and user goes backward, and goes forward to the page again.
       *  In this case all object would have row number already, and
       *  would fail this test condition.
       */
      return;
  /*
   *  Assume table can cause this to happen.
   */
  EC_ERROR_IF(!@call startObj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTableClass), 1);

  totalCnt = HTListGetCount(@self->HTGHC_heightArray);

  EC_ERROR_IF(diff < 0, 1);

  for (i = row+1; i < totalCnt; i++) {
    HTListGetItem(@self->HTGHC_heightArray, i, &oldHeight, sizeof(word));
    oldHeight -= diff;
    EC_ERROR_IF(oldHeight < 0, 1);
    HTListReplaceItem(@self->HTGHC_heightArray,i,&oldHeight,sizeof(word));
  }
  EC_ERROR_IF(i != totalCnt, 1);
  @self->HTGHC_sumOfHeights = oldHeight;

  parent = @call @self->HTGHC_pmObj::MSG_GEN_FIND_PARENT();
  sz = MAKE_SIZE_DWORD(@self->HTGHC_maxRowWidth, @self->HTGHC_sumOfHeights);
  @call parent::MSG_HTML_CONTENT_SET_VIEW_DOC_BOUNDS(sz);
  @call parent::MSG_VIS_SET_SIZE(@self->HTGHC_maxRowWidth,
				 @self->HTGHC_sumOfHeights);
  @call @self->HTGHC_pmObj::MSG_VIS_SET_SIZE(@self->HTGHC_maxRowWidth,
					     @self->HTGHC_sumOfHeights);
  /*
   *  Reposition following objects.
   */
  i=@call (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_GEN_FIND_CHILD(startObj);
  i++;
  startObj = @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::
      MSG_GEN_FIND_CHILD_AT_POSITION(i);
  for (;i < totalCnt && startObj; i++) {
      @call startObj::MSG_VIS_POSITION_BRANCH(0,0);
      startObj = @call (uiMgr.UIM_currentDoc)->HTUI_pmanager::
	  MSG_GEN_FIND_CHILD_AT_POSITION(i);
  }
  return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_ROW_RESIZE.	*/


/***********************************************************************
 *		MSG_GEN_SET_USABLE for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Delete some instance data that are no longer needed.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	11/ 6/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_SET_USABLE
{
    HTListDelete(@self->HTGHC_fontStack);
    @self->HTGHC_fontStack = 0;
    HTListDelete(@self->HTGHC_formatStack);
    @self->HTGHC_formatStack = 0;
    HTListDelete(@self->HTGHC_listStack);
    @self->HTGHC_listStack = 0;
    HTListDelete(@self->HTGHC_alignStack);
    @self->HTGHC_alignStack = 0;

    @callsuper();
    return;
}	/* End of MSG_GEN_SET_USABLE.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These would be destroyed when we delete the blocks using
     * HTListDeleteAllWID.
     *
     * HTListDelete(@self->HTGHC_heightArray);
     * HTListDelete(@self->HTGHC_rowArray);
     * HTListDelete(@self->HTGHC_fontStack);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/
