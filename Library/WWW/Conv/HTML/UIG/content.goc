@include <stdapp.goh>
@include <WWW/html.goh>
@include "htfatals.goh"
@include "UIG/utility.goh"

@classdecl	HTGenHtmlContentClass;

@extern method HTGenHtmlContentClass, MSG_GEN_PREPARE_FOR_DESTROY;



/***********************************************************************
 *  MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Format the text object according to the current
 *		    HTML content.
 * PARAMETERS:	    (optr text, GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/15/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT
{
  int 		n;
  WWFixed 	number;
  StyleType 	token;
  FontID	fontId;
  /*
   * Set the default tabs.
   */
  @send text::MSG_VIS_TEXT_SET_DEFAULT_TABS(TAB_SIZE,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  /*
   * Set the font.  STYLE_FW_FONT is handled here.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (!(@self->HTGHC_cntFWFont)) {
    fontId = FID_DTC_URW_SANS;
    @send text::MSG_VIS_TEXT_SET_FONT_ID(fontId,
					 TEXT_ADDRESS_PAST_END,
					 TEXT_ADDRESS_PAST_END);
  }
  /*
   * Set the font size.  The size is stored in the font stack.  Thus,
   * this handles any <FONT SIZE=n> that have been encountered before
   * the creation of the text object.  I.e. STYLE_FONT is handled here.
   */
  number.WWF_int = @call self::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  number.WWF_frac = 0;
  @call text::MSG_VIS_TEXT_SET_POINT_SIZE
		(number, TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  /*
   * Set the gstate
   */
  GrSetFont(gstate, fontId, MakeWWFixed(number.WWF_int));
  /* 
   *  Get the last alignment and set to the text object.  I.e
   *  STYLE_ALIGN is handled here.
   */
  @call self::MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT(text);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  EC_ERROR_IF(@self->HTGHC_formatIndex > 0 &&
	      @self->HTGHC_formatStack == NULL, 1);

  for (n = 0; n < @self->HTGHC_formatIndex; n++) {
    HTListGetItem(@self->HTGHC_formatStack, n, &token, sizeof(StyleType));
    switch (token) {
	case STYLE_STRIKE:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_STRIKE_THRU);
	  break;
	case STYLE_ITALIC:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_ITALIC);
	  break;
	case STYLE_ANCHOR:
	  if (@self->HTGHC_hrefToken != -1) {
	    @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_UNDERLINE);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	    @call text::MSG_GEN_TEXT_RECORD_HREF       
                                (ELEMENT_START, @self->HTGHC_hrefToken);
	  }
	  break;
	case STYLE_BOLD:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_BOLD);
	  break;
	case STYLE_SUPERSCRIPT:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_SUPERSCRIPT);
	  break;
	case STYLE_SUBSCRIPT:
	  @call text::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_SUBSCRIPT);
	  break;
	case STYLE_BQ:
	  FormatSetTextBQ (text, oself);
	  break;
  	case STYLE_PARAGRAPH:
	  break;
	case STYLE_ALIGN:
	  break;
	case STYLE_FONT:
	  number.WWF_int = @call self::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
	  number.WWF_frac= 0;
	  @call text::MSG_VIS_TEXT_SET_POINT_SIZE
	     (number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
	  break;
	case STYLE_FW_FONT:
	  EC_WARNING_IF(!@self->HTGHC_cntFWFont, 1);
	  @send text::MSG_VIS_TEXT_SET_FONT_ID(FID_DTC_URW_MONO,
					       TEXT_ADDRESS_PAST_END,
					       TEXT_ADDRESS_PAST_END);
	  break;
	case STYLE_PRE:
	case STYLE_UL:
	case STYLE_OL:
	  /* Already handled */
	case STYLE_HEADER:
	case STYLE_DL:
	  /* does nothing */
	  break;
    } /* end of switch */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  } 
  return;

}	/* End of MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_SET_CONTENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Add a new content type to the object.
 * PARAMETERS:	    (StyleType type)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_CONTENT
{
  word index;

  if (!@self->HTGHC_formatStack)
    @self->HTGHC_formatStack = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

  index = HTListAppend(@self->HTGHC_formatStack, &type, sizeof(StyleType));

  EC_ERROR_IF(index != @self->HTGHC_formatIndex, 1);
  @self->HTGHC_formatIndex++;

  switch (type) {
    case STYLE_ANCHOR:
	@self->HTGHC_cntUnderline++;
	EC_WARNING_IF(@self->HTGHC_cntUnderline > 1,
		      UIG_NESTED_ANCHORS_IN_CONTENT);
	break;
    case STYLE_BOLD:
	@self->HTGHC_cntBold++;
	break;
    case STYLE_ITALIC:
	@self->HTGHC_cntItalic++;
	break;
    case STYLE_STRIKE:
	@self->HTGHC_cntStrike++;
	break;
    case STYLE_SUPERSCRIPT:
	@self->HTGHC_cntSuperscript++;
	break;
    case STYLE_SUBSCRIPT:
	@self->HTGHC_cntSubscript++;
	break;
    case STYLE_FW_FONT:
	@self->HTGHC_cntFWFont++;
	break;
  }
  return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_CONTENT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_REMOVE_CONTENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Remove a content type from the object.
 * PARAMETERS:	    StyleType (int &counter)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_REMOVE_CONTENT
{
  StyleType type;
EC(int cnt;	)

  *counter = 0;

  EC_ERROR_IF(@self->HTGHC_formatIndex == 0, UIG_ERROR_IN_CONTENT_STACK);
  @self->HTGHC_formatIndex--;

  /*
   *  Clear stack element.
   */
  EC_ERROR_IF(@self->HTGHC_formatStack == NULL, 1);
  HTListRemoveItem(@self->HTGHC_formatStack, @self->HTGHC_formatIndex,
		   &type, sizeof(StyleType));
EC(cnt = HTListGetCount(@self->HTGHC_formatStack);
   EC_ERROR_IF(cnt != @self->HTGHC_formatIndex, 1); )

  switch (type) {
    case STYLE_ANCHOR:
	*counter = --@self->HTGHC_cntUnderline;
	break;
    case STYLE_BOLD:
	*counter = --@self->HTGHC_cntBold;
	break;
    case STYLE_ITALIC:
	*counter = --@self->HTGHC_cntItalic;
	break;
    case STYLE_STRIKE:
	*counter = --@self->HTGHC_cntStrike;
	break;
    case STYLE_SUPERSCRIPT:
	*counter = --@self->HTGHC_cntSuperscript;
	break;
    case STYLE_SUBSCRIPT:
	*counter = --@self->HTGHC_cntSubscript;
	break;
    case STYLE_FW_FONT:
	*counter = --@self->HTGHC_cntFWFont;
	break;
  }
  EC_WARNING_IF(*counter < 0, UIG_UNBALANCED_COUNTER);
  return type;
}	/* End of MSG_GEN_HTML_CONTENT_REMOVE_CONTENT.	*/

/***********************************************************************
 *		MSG_GEN_HTML_CONTENT_SET_BR for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the state of <NOBR> content.
 * PARAMETERS:	    status = STYLE_NOBR, <NOBR> starts
 *                         or
 *                         = 0, </NOBR>
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	7/10/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_BR
{
    @self->HTGHC_noBr = status;
    return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_BR.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Get the current content type.
 * PARAMETERS:	    StyleType ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE
{
  StyleType type;

  if (@self->HTGHC_formatIndex == 0)
      return -1;
  EC_ERROR_IF(@self->HTGHC_formatStack == NULL, 1);
  HTListGetItem(@self->HTGHC_formatStack, @self->HTGHC_formatIndex-1,
		&type, sizeof(StyleType));
  return type;
}	/* End of MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    (StyleType type)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT
{
  int count = 0;

  switch (type) {
    case STYLE_ANCHOR:
	count = @self->HTGHC_cntUnderline;
	break;
    case STYLE_BOLD:
	count = @self->HTGHC_cntBold;
	break;
    case STYLE_ITALIC:
	count = @self->HTGHC_cntItalic;
	break;
    case STYLE_STRIKE:
	count = @self->HTGHC_cntStrike;
	break;
    case STYLE_SUPERSCRIPT:
	count = @self->HTGHC_cntSuperscript;
	break;
    case STYLE_SUBSCRIPT:
	count = @self->HTGHC_cntSubscript;
	break;
    case STYLE_FW_FONT:
	count = @self->HTGHC_cntFWFont;
	break;
  }
  return count;
}	/* End of MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_FONT_SIZE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Return the current font size
 * PARAMETERS:	    byte ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_FONT_SIZE
{
  WWFixed number;
  FontType byte;

  if(@self->HTGHC_fontIndex == 0) {
      if (@self->HTGHC_baseFont) {
	  /*
	   * Map the attribute size to the actual font point size.
	   */
	  MapAttrSizeToPointSize(@self->HTGHC_baseFont, &number);
	  return number.WWF_int;
      }
      else
	  return DEFAULT_STYLE_FONT;
  }
  EC_ERROR_IF(@self->HTGHC_fontStack == NULL, 1);
  HTListGetItem(@self->HTGHC_fontStack, @self->HTGHC_fontIndex-1, &byte, 
		sizeof(FontType));
  return byte;
}	/* End of MSG_GEN_HTML_CONTENT_GET_FONT_SIZE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Push a font size to the font stack.
 * PARAMETERS:	    (FontType size)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
{
  word index;

  if (!@self->HTGHC_fontStack)
      @self->HTGHC_fontStack = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

  index = HTListAppend(@self->HTGHC_fontStack, &size, sizeof(FontType));
  EC_ERROR_IF(index != @self->HTGHC_fontIndex, 1);

  @self->HTGHC_fontIndex++;

  return;
}	/* End of MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_POP_FONT_SIZE for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Pop a font size off the font stack
 * PARAMETERS:	    int ();
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_POP_FONT_SIZE
{
  FontType size;
  WWFixed number;

  if (@self->HTGHC_fontIndex > 0) {
      EC_ERROR_IF(HTListGetCount(@self->HTGHC_fontStack) != 
		  @self->HTGHC_fontIndex, 1);;
      @self->HTGHC_fontIndex--;
      /* delete current font size */
      size = 0;
      EC_ERROR_IF(@self->HTGHC_fontStack == NULL, 1);
      HTListRemoveItem(@self->HTGHC_fontStack, @self->HTGHC_fontIndex,
		       &size, sizeof(FontType));
  }
  /*
   *  if @self->HTGHC_fontIndex == 0, then
   *  Sorry kid, we don't handle <FONT COLOR FACE>.  Thus, </font>
   *  doesn't have any thing for you.
   */

  if(@self->HTGHC_fontIndex == 0) {
      if (@self->HTGHC_baseFont) {
	  /*
	   * Map the attribute size to the actual font point size.
	   */
	  MapAttrSizeToPointSize(@self->HTGHC_baseFont, &number);
	  return number.WWF_int;
      }
      else
	  return DEFAULT_STYLE_FONT;
  }

  /* get the previous font size */
  EC_ERROR_IF(@self->HTGHC_fontStack == NULL, 1);
  HTListGetItem(@self->HTGHC_fontStack, @self->HTGHC_fontIndex-1, &size, 
		sizeof(FontType));
  return size;
}	/* End of MSG_GEN_HTML_CONTENT_POP_FONT_SIZE.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_BASEFONT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Return the base font.
 * PARAMETERS:	    int
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_BASEFONT
{
    if (@self->HTGHC_baseFont)
	return @self->HTGHC_baseFont;
    else
	return DEFAULT_BASEFONT;
}	/* End of MSG_GEN_HTML_CONTENT_GET_BASEFONT.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_SET_BASEFONT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set the new base font
 * PARAMETERS:	    (int size)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_BASEFONT
{
    @self->HTGHC_baseFont = size;
    return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_BASEFONT.	*/



/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Push a justification type to the align stack.
 * PARAMETERS:	    (Justfication align)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION
{
  int index;
  if (!@self->HTGHC_alignStack)
    @self->HTGHC_alignStack = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

  index = HTListAppend(@self->HTGHC_alignStack, &align, sizeof(Justification));
  EC_ERROR_IF(index != @self->HTGHC_alignIndex, 1);

  @self->HTGHC_alignIndex++;
  EC_ERROR_IF(@self->HTGHC_alignIndex == 0, UIG_ERROR_IN_CONTENT_STACK);
  return;
}	/* End of MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION.	*/


/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Pop off one justification token from the align stack
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION
{
  Justification old;

  if(@self->HTGHC_alignIndex <= 0) {
	EC_WARNING(UIG_INVALID_OPERATION);
	return DEFAULT_ALIGNMENT;
  }
  @self->HTGHC_alignIndex--;

  /* delete current justification */
  HTListRemoveItem(@self->HTGHC_alignStack, @self->HTGHC_alignIndex,
		   &old, sizeof(Justification));
  EC_ERROR_IF(HTListGetCount(@self->HTGHC_alignStack) != 
	      @self->HTGHC_alignIndex, 1);

  return old;
}	/* End of MSG_GEN_HTML_CONTENT_POP_JUSTIFICATION.	*/


/***********************************************************************
 *    MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Get the current text justification
 * PARAMETERS:	    Justification (word *br)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/17/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION
{
  Justification just;

  *br = @self->HTGHC_noBr;

  if(@self->HTGHC_alignIndex <= 0)
	return DEFAULT_ALIGNMENT;

  HTListGetItem(@self->HTGHC_alignStack, @self->HTGHC_alignIndex-1,
		   &just, sizeof(Justification));
  return just;
}	/* End of MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    (StyleType groupType, int start, char displayType)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP
{
  ListGroup group;
  int index;

  if (!@self->HTGHC_listStack)
    @self->HTGHC_listStack = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

  group.LG_groupType = groupType;
  group.LG_counter = start;
  group.LG_displayType = displayType;

  index = HTListAppend(@self->HTGHC_listStack, &group, sizeof(ListGroup));
  EC_ERROR_IF(index != @self->HTGHC_listIndex, 1);

  @self->HTGHC_listIndex++;

  return;
}	/* End of MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_POP_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_POP_LIST_GROUP
{
  ListGroup group;

  if(@self->HTGHC_listIndex <= 0) {	/* It's impossible, but in case */
	EC_WARNING(UIG_INVALID_OPERATION);
	return;
  }

  EC_ERROR_IF(@self->HTGHC_listStack == NULL, 1);
  EC_ERROR_IF(HTListGetCount(@self->HTGHC_listStack) != 
	       @self->HTGHC_listIndex, 1);

  /*
   *  If there was any previous list group, it has POPPED, so erase it.
   */
  @self->HTGHC_listIndex--;
  /* delete current font size */
  HTListRemoveItem(@self->HTGHC_listStack, @self->HTGHC_listIndex,
		       &group, sizeof(ListGroup));

  return;
}	/* End of MSG_GEN_HTML_CONTENT_POP_LIST_GROUP.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_LIST_GROUP for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Get the latest list goup information.
 * PARAMETERS:	(StyleType *group,int *counter,char *type,int *level)
 * 		group - <OL> or <UL>, or -1 if no list groups
 *		start - the next numeric number for the next list item
 *		type  - display type, A | a | I | i | 1
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
{
  ListGroup item;

  if (@self->HTGHC_listIndex == 0) {
	*group = -1;
	*level = -1;
	return;
  }
  EC_ERROR_IF(@self->HTGHC_listStack == NULL, 1);
  HTListGetItem(@self->HTGHC_listStack, @self->HTGHC_listIndex-1, &item, 
		sizeof(ListGroup));

  *group = item.LG_groupType;
  *counter = item.LG_counter;
  *type  = item.LG_displayType;
  *level = @self->HTGHC_listIndex - 1;
  return;
}	/* End of MSG_GEN_HTML_CONTENT_GET_LIST_GROUP.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_UPDATE_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    Update the LG_counter in the current OL group
 * PARAMETERS:	    (int start)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_UPDATE_COUNTER
{
  ListGroup group;

  EC_WARNING_IF(@self->HTGHC_listIndex == 0, UIG_INVALID_OPERATION);

  HTListGetItem(@self->HTGHC_listStack, @self->HTGHC_listIndex-1, &group, 
		sizeof(ListGroup));
  EC_WARNING_IF(group.LG_groupType != STYLE_OL, UIG_INVALID_OPERATION);

  group.LG_counter = start;
  HTListReplaceItem(@self->HTGHC_listStack, @self->HTGHC_listIndex - 1,
		    &group, sizeof(ListGroup));
  return;
}	/* End of MSG_GEN_HTML_CONTENT_UPDATE_COUNTER.	*/


/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	Increment the counter in the last group info.  This new
 *		counter value will be the number of the next list item.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER
{
  ListGroup group;
  EC_WARNING_IF(@self->HTGHC_listIndex == 0, UIG_INVALID_OPERATION);

  HTListGetItem(@self->HTGHC_listStack, @self->HTGHC_listIndex-1, &group, 
		sizeof(ListGroup));
  EC_WARNING_IF(group.LG_groupType != STYLE_OL, UIG_INVALID_OPERATION);

  group.LG_counter++;
  HTListReplaceItem(@self->HTGHC_listStack, @self->HTGHC_listIndex - 1,
		    &group, sizeof(ListGroup));
  return;
}	/* End of MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER.	*/



/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    (optr text);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
{
  VisTextParaAttrAttributes new_attr = 0, old_attr = 0;
  Justification	new_just, old_just = 255;
  /*
   * Get the last align token off the stack.
   */
  if(@self->HTGHC_alignIndex == 0)
	new_just = DEFAULT_ALIGNMENT;
  else
      HTListGetItem(@self->HTGHC_alignStack, @self->HTGHC_alignIndex-1,
		   &new_just, sizeof(Justification));
  if (@self->HTGHC_alignIndex > 1)
      HTListGetItem(@self->HTGHC_alignStack, @self->HTGHC_alignIndex-2,
		   &old_just, sizeof(Justification));

  /*
   * Set the alignment.
   */
  new_attr = new_just << VTPAA_JUSTIFICATION_OFFSET;
  old_attr = old_just << VTPAA_JUSTIFICATION_OFFSET;
  @call text::MSG_VIS_TEXT_SET_PARA_ATTRIBUTES(
		old_attr, new_attr, 
		TEXT_ADDRESS_PAST_END,
		TEXT_ADDRESS_PAST_END);
  return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT.	*/



