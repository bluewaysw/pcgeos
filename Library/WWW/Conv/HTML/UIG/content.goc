/***********************************************************************
 *MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the current object, find the current row
 *                  number and its x position in the row.
 * PARAMETERS:	    (optr obj, SizeAsDWord size, int *row, 
 *                   optr *prevObj, word *br);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE
{
  if (@self->HTGHC_currentObj != obj) {
    Boolean isObjImage = @call obj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenImageClass) ;


    /*
     *  If this is a new object encountered for the first time(i.e.
     *  the previous object has settled), we update instance data
     *  to calculate the x position of the new object.
     */
    @self->HTGHC_accumulatedPrevWidth += @self->HTGHC_widthCurrentObj;
    if (!isObjImage) {
      @self->HTGHC_accumulatedPrevWidth += MARGIN ;
      @self->HTGHC_accumulatedMargin += MARGIN ;
    } 
    if (!@self->HTGHC_maxHeightInRow)
      @self->HTGHC_maxHeightInRow = DWORD_HEIGHT(size);
    else if (@self->HTGHC_heightCurrentObj > @self->HTGHC_maxHeightInRow) {
      @self->HTGHC_maxHeightInRow = @self->HTGHC_heightCurrentObj;
    }
    *prevObj = @self->HTGHC_currentObj;
    @self->HTGHC_currentObj = obj;
  }
  else
    *prevObj = NULL;
  @self->HTGHC_widthCurrentObj = DWORD_WIDTH(size);
  @self->HTGHC_heightCurrentObj= DWORD_HEIGHT(size);
  /*
   *  The new object is in the row number = array index + 1.
   *  The height element(array index + 1) doesn't exist in the height 
   *  array yet because we don't know its height until we will have
   *  encountered all the objects in the new row.
   */
  *row = @self->HTGHC_rowIndex + 1;
  *br = @self->HTGHC_noBr;
  *sumMargin = @self->HTGHC_accumulatedMargin;
  return @self->HTGHC_accumulatedPrevWidth;
}	/* End of MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the variables and array that keep track of 
 *                  row information(specifically the row heights).
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER
{
  @self->HTGHC_rowIndex = -1;
  @self->HTGHC_currentObj = NULL;
  @self->HTGHC_maxHeightInRow = @self->HTGHC_heightCurrentObj = 
  @self->HTGHC_widthCurrentObj = 0;
  @self->HTGHC_sumOfHeights = MARGIN;    /* top margin */
  @self->HTGHC_accumulatedPrevWidth = 0; 
  @self->HTGHC_accumulatedMargin = 0;
  @self->HTGHC_maxRowWidth = MARGIN;
  /*
   *  heightArray stores the heights of each row.
   */
  if (@self->HTGHC_heightArray)
      HTListDeleteAllItems(@self->HTGHC_heightArray);
  else
      @self->HTGHC_heightArray = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);
  /*
   *  rowArray stores the line with of each row.
   */
  if (@self->HTGHC_rowArray)
      HTListDeleteAllItems(@self->HTGHC_rowArray);
  else
      @self->HTGHC_rowArray = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

  return;
}	/* End of MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the row number, return its absolute y- 
 *                  document coordinate.
 * PARAMETERS:	    (int row);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT
{
  int height = 0;

  EC_ERROR_IF(row > @self->HTGHC_rowIndex, 1);
  HTListGetItem(@self->HTGHC_heightArray, row, &height, sizeof(int));
  return height;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT.	*/



/***********************************************************************
 *	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH for HTGenHtmlContentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the row number, return its absolute y- 
 *                  document coordinate.
 * PARAMETERS:	    (int row);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenHtmlContentClass, MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH
{
  int width = 0;

  EC_ERROR_IF(row > @self->HTGHC_rowIndex, 1);
  HTListGetItem(@self->HTGHC_rowArray, row, &width, sizeof(int));
  return width;
}	/* End of MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT.	*/


