typedef struct {
	HTMemHandle	MI_mapName;
	HTListHandle	MI_areas;
} MapItem;

typedef struct {
	HTMemHandle	AI_href;
	HTMemHandle	AI_coords;
	AreaType	AI_shape;
} AreaItem;

typedef struct {
        int             AE_token;
        dword           AE_start;
        dword           AE_end;
} AnchorElement;

#define min(x,y) (((x)>=(y))?(y):(x))

#define	NO_JUSTIFICATION  255

