/***********************************************************************
 *		MSG_GEN_IMAGE_GET_REQUESTED_SIZE for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Get the WIDTH and HEIGHT attribute of the <IMG>
 * PARAMETERS:	    void (word *width, word *height)
 *                  Return width and height. width will not be zero.
 *                  height could be zero.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	10/23/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_GET_REQUESTED_SIZE
{
    if (@self->HTGI_width > (X_SCREEN_SIZE-MARGIN-MARGIN))
	*width = X_SCREEN_SIZE-MARGIN-MARGIN;
    else
	*width = @self->HTGI_width;
    if (*width == 0) *width = X_SCREEN_SIZE;
    *height = @self->HTGI_height;
}	/* End of MSG_GEN_IMAGE_GET_REQUESTED_SIZE.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_DRAW_FOCUS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw the focus outline.
 * PARAMETERS:	    (Rectangle *objRect, RectDWord *rect)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_DRAW_FOCUS
{
  EventHandle msg;

@ifdef PRODUCT_NIKE
  if (@self->HTGI_src || @self->HTGI_target) {
@else
  if ((@self->HTGI_src || @self->HTGI_target) && 
      (@self->HTGI_load == ILS_UNLOAD || 
      (@self->HTGI_hrefToken != -1 && @self->HTGI_ismap == FALSE) ||
       (@self->HTGI_load == ILS_LOADED && @self->HTGI_input))) {
@endif
    rect->RD_left = objRect->R_left - 1;
    rect->RD_top = objRect->R_top - 2;
    rect->RD_right = objRect->R_right + 1;
    rect->RD_bottom = objRect->R_bottom + 1;

    @self->HTGI_focalAnchor = 0;
    @self->HTGI_focalBound = *rect;

    if (@self->HTGI_load == ILS_UNLOAD)
      msg = @record PresentationManagerClass::MSG_PM_DISPLAY_HREF_TARGET
	  (@self->HTGI_hrefToken, oself);
    else
      msg = @record PresentationManagerClass::MSG_PM_DISPLAY_HREF_TARGET
	  (@self->HTGI_hrefToken, NULL);

    @send self::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
  }
  else
      rect->RD_right = rect->RD_left = 0;

  return;
}	/* End of MSG_GEN_IMAGE_DRAW_FOCUS.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_UNDRAW_FOCUS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Erase the focus outline.
 * PARAMETERS:	    ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_UNDRAW_FOCUS
{
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    @self->HTGI_focalAnchor = -1;
    return;
}	/* End of MSG_GEN_IMAGE_UNDRAW_FOCUS.	*/


