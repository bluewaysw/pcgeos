 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	9/29/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_SET_NEXT
{
    if(@self->HTGI_next) 
	@send, forceQueue @self->HTGI_next::MSG_GEN_IMAGE_SET_NEXT(next);
    else 
	@self->HTGI_next = next;
}	/* End of MSG_GEN_IMAGE_SET_NEXT.	*/

