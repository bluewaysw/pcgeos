/***********************************************************************
 *		MSG_GEN_IMAGE_SET_BITMAP for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    VMFileHandle bitmapFile, VMBlockHandle bitmapBlock
 *                  word scaleDividend, word scaleDivisor
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/24/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_SET_BITMAP
{
   optr view;
   VisInstance *vself;
   int left, top;
   RectDWord viewBound;

   @self->HTGI_bitmapFile = bitmapFile;
   @self->HTGI_bitmapBlock = bitmapBlock;
   @self->first_draw = TRUE;

   /*
    *  Erase the default icon.
    */
   view = @call self::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&GenViewClass);
   @call view::MSG_GEN_VIEW_GET_VISIBLE_RECT(&viewBound);

   vself = ObjDerefVis(oself);
   if (vself->VI_bounds.R_left < viewBound.RD_right && 
       vself->VI_bounds.R_top < viewBound.RD_bottom) {
       left = vself->VI_bounds.R_left - viewBound.RD_left - 1;
       top = vself->VI_bounds.R_top - viewBound.RD_top - 2;
       if (left < 0)
	   left = 0;
       if (top < 0)
	   top = 0;
       InvalidRegion((uiMgr.UIM_currentDoc)->HTUI_pmanager, left, top, 
		     left+31, top+31);
   }

    if(@self->HTGI_next)
	@send, forceQueue @self->HTGI_next::MSG_GEN_IMAGE_SET_BITMAP
	    (bitmapFile, bitmapBlock, scaleDividend, scaleDivisor);

    /*
     *  Store the image scaling factor.
     */
    @self->HTGI_scaleRatio = MAKE_SIZE_DWORD(scaleDividend, scaleDivisor);

    return;
}	/* End of MSG_GEN_IMAGE_SET_BITMAP.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_SET_NEXT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
