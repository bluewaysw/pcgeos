/***********************************************************************
 *		MSG_VIS_DRAW for HTGenImageClass
 ***********************************************************************
 * SYNOPSIS:	    Draw the image object.
 * PARAMETERS:	    void (DrawFlags drawFlags, 
 *			  GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_VIS_DRAW
{
  Rectangle bounds;
@ifndef	BROTHER_KERNEL
@ifndef RESPONDER_KERNEL
  Bitmap *bmp;
@endif
@endif
  char *alt;

  GrSaveState(gstate);

  @call self::MSG_VIS_GET_BOUNDS(&bounds);

  /*
   * if the image been loaded, draw the real image
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
@ifdef PRODUCT_NIKE
  if(@self->HTGI_load == ILS_LOADED && @self->HTGI_bitmapFile) {
@else
  if(@self->HTGI_load == ILS_LOADED || @self->HTGI_bitmapFile) {
@endif
      if(@self->HTGI_bitmapFile && @self->HTGI_bitmapBlock) {
	  GrDrawHugeBitmap(gstate, bounds.R_left, bounds.R_top,
		       @self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);
      }
      else {
	  /*
	   * draw the small icon and alt text
	   */
@ifndef BROTHER_KERNEL
@ifndef RESPONDER_KERNEL
	  MemLock(OptrToHandle(@ImageIcon));
	  bmp = LMemDeref(@ImageIcon);
	  GrDrawBitmap(gstate, bounds.R_left, bounds.R_top-1, bmp, 0);
	  MemUnlock(OptrToHandle(@ImageIcon));
@endif
@endif
	  
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  if(@self->HTGI_alt) {
	      alt = HTMemLock(@self->HTGI_alt);
	      GrDrawText(gstate, bounds.R_left + 30, bounds.R_top + 13,
		     alt, strlen(alt));
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	      HTMemUnlock(@self->HTGI_alt);
	  }
      }
  } else {
      /*
       * else just draw a small icon
       */
@ifndef	BROTHER_KERNEL
@ifndef RESPONDER_KERNEL
      MemLock(OptrToHandle(@ImageIcon));
      if (@self->HTGI_load == ILS_UNLOAD)
	  bmp = LMemDeref(@ImageIcon);
      else
	  bmp = LMemDeref(@BrokenImageIcon);
      GrDrawBitmap(gstate, bounds.R_left, bounds.R_top-1, bmp, 0);
      MemUnlock(OptrToHandle(@ImageIcon));
@endif

@else /* for NIKE only */

    /*
     * the box and alt text.
     */
      if(@self->HTGI_altWidth > bounds.R_right - bounds.R_left ||
	 @self->HTGI_altHeight > bounds.R_bottom - bounds.R_top) {
/*	  GrInvalRect(gstate, bounds.R_left, bounds.R_top,
		      bounds.R_left + @self->HTGI_altWidth + 1, 
		      bounds.R_top + @self->HTGI_altHeight + 1);
*/
	  @call self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION
	      (0, VARF_NOT_IF_ALREADY_INVALID, 
	       bounds.R_top + @self->HTGI_altHeight + 1,
	       bounds.R_left + @self->HTGI_altWidth + 1, 
	       bounds.R_top, bounds.R_left);

	  @self->HTGI_altWidth = @self->HTGI_altHeight = 0;
      } else {
	@self->HTGI_altWidth = bounds.R_right - bounds.R_left - 1;
	@self->HTGI_altHeight = bounds.R_bottom - bounds.R_top - 1;
      }
    /*
     *  Draw a border.
     */

    GrSetLineColor(gstate, CF_INDEX, C_DARK_GRAY, 0, 0);
    GrDrawRect(gstate,  bounds.R_left, bounds.R_top, 
		 bounds.R_right - 1, bounds.R_bottom - 1);

    if(@self->HTGI_alt && ((bounds.R_bottom - bounds.R_top) > 12)) {
	alt = HTMemLock(@self->HTGI_alt);

	GrSetTextColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	if(GrTextWidth(gstate, alt, strlen(alt)) > bounds.R_right - bounds.R_left) {
	    word len = 0, i;
	    for(i=0; i<strlen(alt); i++) {
		len += GrTextWidth(gstate, alt+i, 1);
		if(len >= bounds.R_right - bounds.R_left) break;
	    }
	    GrDrawText(gstate, bounds.R_left + 1, bounds.R_top + 1,
		   alt, i);
	} else
	    GrDrawText(gstate, bounds.R_left + 1, bounds.R_top + 1,
		   alt, strlen(alt));
	HTMemUnlock(@self->HTGI_alt);
    }

@endif
  }

  /*
   *  Draw thick border that is distinct from the focus box.
   *  If the image has a link and the BORDER attribute, BORDER attribute
   *  will be ignored.  When such an image receives focus, it will have
   *  both link border the focus box.
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
@ifdef PRODUCT_NIKE
  if ((@self->HTGI_border && @self->HTGI_load == ILS_LOADED)) {
@else
  if ((@self->HTGI_border && @self->HTGI_load == ILS_LOADED) ||
      @self->HTGI_hrefToken != -1) {
@endif
      /*
       *  Draw a border.
       */
      GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
      GrSetLineWidth(gstate, MakeWWFixed(2));
      GrDrawRect(gstate,  bounds.R_left + 2, bounds.R_top+1, 
		 bounds.R_right-1, bounds.R_bottom-1);
  }
  GrRestoreState(gstate);

  return;
}	/* End of MSG_VIS_DRAW.	*/



@method HTGenImageClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;

  if (uiMgr.UIM_currentDoc->PM_loadImage == FALSE || 
      (!@self->HTGI_width && !@self->HTGI_height))
      size = MAKE_SIZE_DWORD(IMAGE_DEFAULT_SIZE, IMAGE_DEFAULT_SIZE);
  else if (@self->HTGI_width && @self->HTGI_height) {

      size = MAKE_SIZE_DWORD(@self->HTGI_width,@self->HTGI_height);

     } else if (@self->HTGI_width) {

      size = MAKE_SIZE_DWORD(@self->HTGI_width,0);

     }
  else /* if (@self->HTGI_height) */ {

      size = MAKE_SIZE_DWORD(0, @self->HTGI_height);
  }
  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  VisInstance * vself;

  if (@self->HTGI_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGI_xPos;
  }
  else {
    lineWidth = @call @self->HTGI_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGI_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	xOrigin = DWORD_X(xy) + @self->HTGI_xPos;
     } else if (@self->HTGI_align == J_RIGHT) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGI_xPos);
     } else {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGI_xPos);
     }
  }

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
      (@self->HTGI_content, @self->HTGI_pageRow, oself);

  vself = ObjDerefVis(oself);
  if (vself->VI_attrs & VA_DRAWABLE && @self->HTGI_load != ILS_LOADED)
      InvalidRegion((uiMgr.UIM_currentDoc)->HTUI_pmanager, 
		    vself->VI_bounds.R_left, vself->VI_bounds.R_top, 
		     vself->VI_bounds.R_left+31, vself->VI_bounds.R_top+31);
  @callsuper();

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  if (@self->HTGI_focalAnchor != -1)
      @call self::MSG_GEN_IMAGE_UPDATE_FOCAL_BOUND();
  vself = ObjDerefVis(oself);
  vself->VI_attrs |= VA_DRAWABLE;
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID);

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  VisInstance * vself;
  SizeAsDWord size;
  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;
  vself->VI_attrs &= ~VA_DRAWABLE;
  /*
   *  Get an estimated position of the object
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  pos = UpdateItsPotentialPosition(oself, @self->HTGI_content, &row, &size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_xPos = pos;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_pageRow = row;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_SPEC_BUILD_BRANCH
{
    @callsuper();
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGI_guessSize),
				 DWORD_HEIGHT(@self->HTGI_guessSize));
    return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/


/***********************************************************************
 *		MSG_UI_GET_ROW_POSITION for HTGenHRClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
