/***********************************************************************
 *		MSG_GEN_IMAGE_SET_LOAD_STATUS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set the image object that it's has fully loaded
 *                  image.
 * PARAMETERS:	    ImageLoadStatus status
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/31/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_SET_LOAD_STATUS
{
    VisInstance *vself;

    @self->HTGI_load = status;
    if(@self->HTGI_next)
	@send, forceQueue @self->HTGI_next::MSG_GEN_IMAGE_SET_LOAD_STATUS(status);
    @send self::MSG_VIS_MARK_INVALID(VOF_IMAGE_INVALID, 
				     VUM_DELAYED_VIA_UI_QUEUE);

    vself = ObjDerefVis(oself);
    if (vself->VI_attrs & VA_DRAWABLE && @self->HTGI_load != ILS_LOADED)
	InvalidRegion((uiMgr.UIM_currentDoc)->HTUI_pmanager, 
		      vself->VI_bounds.R_left, vself->VI_bounds.R_top, 
		      vself->VI_bounds.R_left+31, vself->VI_bounds.R_top+31);
    return;
}	/* End of MSG_GEN_IMAGE_SET_LOADED.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_MARK_INPUT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Mark the object <INPUT type=image>
 * PARAMETERS:	    (int formId, HTMemHandle nameHandle, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/30/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_MARK_INPUT
{
  word br;

  @self->HTGI_input = TRUE;
  @self->HTGI_content = content;
  @self->HTGI_name = nameHandle;
  @self->HTGI_formId = formId;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGI_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGI_noBr = br;
  /*
   *  No focus on it initially.
   */
  @self->HTGI_focalAnchor = -1;
  return;
}	/* End of MSG_GEN_IMAGE_MARK_INPUT.	*/


/***********************************************************************
 *		MSG_HTML_FORM_SUBMIT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Submitting name/value pair.  It's <INPUT type=image>.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/30/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_HTML_IMAGE_SUBMIT
{
  HTMemHandle temp1, temp2;
  char temp[5];

  if (@self->HTGI_input && @self->HTGI_name) {
    /*
     *  Append the "name.x"
     */
    temp1 = HTStrHTMemAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, 
	@self->HTGI_name);
    temp1 = HTStrAllocCatWID(uiMgr.UIM_currentDoc->HTUI_memID, temp1, ".x");
    HTListAppend(query, &temp1, sizeof(HTMemHandle));
    /*
     *  Append the x value
     */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    EC_ERROR_IF(@self->HTGI_input_x > 16384, 1);
    VisTextFormatNumber(temp, @self->HTGI_input_x, VTNT_NUMBER);
    temp2 = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, temp);
    HTListAppend(query, &temp2, sizeof(HTMemHandle));
    /*
     *  Append the "name.y"
     */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    temp1 = HTStrHTMemAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, @self->HTGI_name);
    temp1 = HTStrAllocCatWID(uiMgr.UIM_currentDoc->HTUI_memID, temp1, ".y");

    HTListAppend(query, &temp1, sizeof(HTMemHandle));
    /*
     *  Append the y value
     */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    EC_ERROR_IF(@self->HTGI_input_y > 16384, 1);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    VisTextFormatNumber(temp, @self->HTGI_input_y, VTNT_NUMBER);
    temp2 = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, temp);
    HTListAppend(query, &temp2, sizeof(HTMemHandle));

    /*
     *  Clear the field.
     */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    @self->HTGI_input_x = 0;
    @self->HTGI_input_y = 0;
  }
  return;
}	/* End of MSG_GEN_IMAGE_SUBMIT.	*/


/***********************************************************************
 *		MSG_GEN_IMAGE_STORE_CONTENT for HTGenImageClass
 ***********************************************************************
