/***********************************************************************
 *		UIGen_CREATE_IMAGE_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an image object to render an image file.
 * PARAMETERS:	    (MemHandle block, SGML *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 8/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_IMAGE_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr content;
  optr dummy;
@if @SHORT_LONG_TOUCH
  ShortLongTouchParams touch;
@endif /* SHORT_LONG_TOUCH */

  content = uiMgr.UIM_currentDoc->HTUI_pmContent;
  /* 
   *  Deal away the current target object.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass ||
      uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass ||
      uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenCaptionClass) {
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
		(uiMgr.UIM_currentDoc->HTUI_target.obj);
    content = uiMgr.UIM_currentDoc->HTUI_target.obj;
  }
  else if (uiMgr.UIM_currentDoc->HTUI_target.class == 
	   (ClassStruct *)&HTMLSelectClass) {
    EC_ERROR(1);
    return UI_GEN_ERROR;
  }
  else if (uiMgr.UIM_currentDoc->HTUI_target.obj) {
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ \
	(uiMgr.UIM_currentDoc->HTUI_target.obj);
    content = UIGen_GET_CONTENT_Int();
  }
  /*
   *  Now create an image object and store it in target.obj.  Next, 
   *  process the passed attribute list.
   */
  dummy = UICreateObj((ClassStruct *)&HTGenImageClass);

  @call dummy::MSG_GEN_IMAGE_PROCESS_ATTRIBUTE(block, entity, content);

@if @SHORT_LONG_TOUCH
  touch.SLTP_shortMessage = MSG_META_UIG_SHORT_TOUCH_NOTIFY;
  touch.SLTP_longMessage = MSG_META_UIG_LONG_TOUCH_NOTIFY;
  touch.SLTP_shortDestination = touch.SLTP_longDestination
      = TO_SELF;
  @call dummy::MSG_META_ADD_VAR_DATA(
	HINT_SHORT_LONG_TOUCH | VDF_SAVE_TO_STATE,
	sizeof(ShortLongTouchParams),
	&touch);
@endif /* SHORT_LONG_TOUCH */
  /*
   *  Set hyperlink on it if the current content has <A>...</A>
   */
  if (uiMgr.UIM_currentDoc->HTUI_hrefToken != -1) {
    @call dummy::MSG_GEN_IMAGE_SET_HYPERLINK(uiMgr.UIM_currentDoc->HTUI_hrefToken);
  }

  /*
   *  Done with the image object
   */
  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&(uiMgr.UIM_currentDoc->HTUI_target.obj), &(uiMgr.UIM_currentDoc->HTUI_target.class));

  if (uiMgr.UIM_currentDoc->HTUI_target.obj == uiMgr.UIM_currentDoc->HTUI_pmanager) {
	uiMgr.UIM_currentDoc->HTUI_target.obj = NULL;
	uiMgr.UIM_currentDoc->HTUI_target.class = NULL;
  }
  /*
   *  Add the object to the list of focusable objects.
   */
@ifdef PRODUCT_NIKE
  if (uiMgr.UIM_currentDoc->PM_loadImage) {
      @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);	
  }
@else
  if (uiMgr.UIM_currentDoc->HTUI_hrefToken != -1 || 
      uiMgr.UIM_currentDoc->PM_loadImage == FALSE)
      @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);
@endif
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_IMAGE_Int.	*/



/***********************************************************************
 *		UIGen_CREATE_SINGLE_IMAGE_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    create a single image object
 * PARAMETERS:	    nothing
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/28/97   	Initial Revision
 *
 ***********************************************************************/
optr UIGen_CREATE_SINGLE_IMAGE_Int()
{
  optr dummy;

  dummy = UICreateObj((ClassStruct *)&HTGenImageClass);

  @call dummy::MSG_GEN_IMAGE_STORE_CONTENT(uiMgr.UIM_currentDoc->HTUI_pmContent);
  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);

  return dummy;
}	/* End of UIGen_CREATE_SINGLE_IMAGE_Int.	*/



/***********************************************************************
 *		MSG_GEN_IMAGE_SET_BOUNDS for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word width, word height
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/28/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_SET_BOUNDS
{
  word right, bottom;
  VisInstance *vself;
  vself = ObjDerefVis(oself);

  /*
   *  If the actual image size is smaller than the specified size in the
   *  html source, the actual image size should be stretched to the 
   *  specified size.
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  if (@self->HTGI_width != width || @self->HTGI_height != height ||
	((uiMgr.UIM_currentDoc)->PM_loadImage == FALSE && 
	 (vself->VI_bounds.R_right - vself->VI_bounds.R_left) == 
	 IMAGE_DEFAULT_SIZE &&
	 (vself->VI_bounds.R_bottom - vself->VI_bounds.R_top) == 
	 IMAGE_DEFAULT_SIZE))
      @self->HTGI_reposition = TRUE;

  @self->HTGI_guessSize = MAKE_SIZE_DWORD(width, height);
  @call self::MSG_VIS_SET_SIZE(width, height);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif

  if(@self->HTGI_next) {
    @send, forceQueue @self->HTGI_next::MSG_GEN_IMAGE_SET_BOUNDS(width,height);
    if (@self->HTGI_reposition == TRUE)
      @send, forceQueue @self->HTGI_next::MSG_GEN_IMAGE_DUPLICATE_RESIZE();
  }

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_width = width;
  @self->HTGI_height= height;

  @call (uiMgr.UIM_currentDoc)->HTUI_pmContent::MSG_GEN_HTML_CONTENT_GET_ACCUMULATED_HEIGHTS
	(&right, &bottom);

  if (bottom>=MAX_COORD || right>=MAX_COORD) {
      EC_WARNING(1);
      return UI_GEN_ERROR;
  }
#if 0
  /*
   *  If the attribute already says the definite width and height, 
   *  force the size.
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
     if (!@self->HTGI_width) {
      @self->HTGI_width = width;
     }

     if (!@self->HTGI_height) {
      @self->HTGI_height= height;
     }
  /*
   *  Should be removed!!!!
   */
  @call self::MSG_VIS_SET_SIZE(@self->HTGI_width, @self->HTGI_height);
#endif
  return UI_GEN_NO_ERROR;
}	/* End of MSG_GEN_IMAGE_SET_BOUNDS.	*/



/***********************************************************************
 *		MSG_GEN_IMAGE_GET_SRC for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Return the SRC attribute value.
 * PARAMETERS:	    HTMemHandle ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	1/23/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_GET_SRC
{
    HTMemHandle ret;
    char *src;

    if(@self->HTGI_src) {
	src = HTMemLock(@self->HTGI_src);
	ret = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, src);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	HTMemUnlock(@self->HTGI_src);
	return ret;
    } else if(@self->HTGI_target)
	return (@call @self->HTGI_target::MSG_GEN_IMAGE_GET_SRC());
    else 
	return 0;
}	/* End of MSG_GEN_IMAGE_GET_SRC.	*/


@method HTGenImageClass, MSG_GEN_IMAGE_GET_SRC_NO_COPY
{
    if(@self->HTGI_src)
	return @self->HTGI_src;
    else if(@self->HTGI_target)
	return (@call @self->HTGI_target::MSG_GEN_IMAGE_GET_SRC_NO_COPY());
    else 
	return 0;
}	/* End of MSG_GEN_IMAGE_GET_SRC.	*/




/***********************************************************************
 *		MSG_GEN_IMAGE_PROCESS_ATTRIBUTE for HTGenImageClass
 ***********************************************************************
 * SYNOPSIS:	    Process IMG attribute list
 * PARAMETERS:	    HTMemHandle (MemHandle block, SGMLEntity *entity, content)
 *			If this image is an image map, the optr
 *			containing the USEMAP name is returned.
 * SIDE EFFECTS:    The passed block MUST be locked!
 *
 * STRATEGY:	Supported Attrs: 
 *		BORDER:
 *		HEIGHT:
 *		ISMAP:
 *		SRC:
 *		USEMAP:
 *		WIDTH:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/ 8/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_PROCESS_ATTRIBUTE
{
  char *value;
  int	index;
  HTMemHandle tmpChunk;
  word br;
  word j;
  int per;
  Boolean percent;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value) {
	if(entity[index].SGMLE_token == HTML_ATTR_ISMAP) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	    @self->HTGI_ismap = TRUE;
	} else if (entity[index].SGMLE_token == HTML_ATTR_BORDER) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	    @self->HTGI_border = TRUE;
	}
	continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_SRC:    /* SRC */
    case HTML_ATTR_ALT:    /* ALT */
    case HTML_ATTR_USEMAP: /* USEMAP */
      /*
       *  Allocate a chunk to store a copy of the attribute value.
       */
      tmpChunk = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, value);
      if (entity[index].SGMLE_token == HTML_ATTR_SRC)	   /* SRC */
	@call self::MSG_GEN_IMAGE_REQUEST(tmpChunk);
      else if (entity[index].SGMLE_token == HTML_ATTR_ALT) { /* ALT */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	@self->HTGI_alt = tmpChunk;
      } else {			                   /* USEMAP */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	@self->HTGI_usemap = tmpChunk;
      }
      break;
    case HTML_ATTR_ISMAP:                                  /* ISMAP */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGI_ismap = TRUE;
      break;
    case HTML_ATTR_BORDER:                                 /* BORDER */
	if (atoi(value) > 0) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  @self->HTGI_border = TRUE;
	}
      break;
    case HTML_ATTR_WIDTH:                                  /* WIDTH */
      /*
       *  Checking for % sign.
       */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	@self->HTGI_width = atoi(value);         /* No percent sign */
      } else {
	  if ((per = atoi(value)) > 100) 
	    per = 100;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	@self->HTGI_width = (per / 100.00) * 
	DWORD_WIDTH(@call content::MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE());
      }
      if (uiMgr.UIM_currentDoc->PM_loadImage &&
	  @call content::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
	/*
	 *  Tell the parent to reserve enough width space.  This also makes
	 *  the following text objects to fit in the new width.
	 */
	optr parent = @call content::MSG_GEN_FIND_PARENT();
	int row, col;
	word rowSpan, colSpan;
	@call content::MSG_GEN_TCELL_GET_CELL_INFO(&row, &col, 
						   &rowSpan, &colSpan);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	@call parent::MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH(col, @self->HTGI_width, colSpan);
      }
      break;
    case HTML_ATTR_HEIGHT:                                 /* HEIGHT */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGI_height= atoi(value);
      break;
    }
  }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  /*
   *  Store the content object.
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_content = content;
  /*
   *  Store the current alignment.
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_noBr = br;
  /*
   *  Initially not in any row.
   */
  @self->HTGI_pageRow = -1;
  /*
   *  No focus on it initially.
   */
  @self->HTGI_focalAnchor = -1;

@ifdef BROTHER_KERNEL
  @self->HTGI_altWidth = @self->HTGI_altHeight = 0;
@endif
  return;
}	/* End of MSG_GEN_IMAGE_PROCESS_ATTRIBUTE.	*/


/***********************************************************************
 *		MSG_META_INITIALIZE for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Initalize a field.  The reason I intercept this 
 *                  routine and initialize one particular field is
 *                  that user may simply load a .gif or .jpg file
 *                  into a browser.  In that case, MSG_GEN_IMAGE_
 *                  PROCESS_ATTRIBUTE is not called to initialize
 *                  hrefToken field to -1.  Note, hrefToken stores
 *                  href token of the image.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/28/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_META_INITIALIZE
{
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGI_hrefToken = -1;
  @callsuper();

  return;
}	/* End of MSG_META_INITIALIZE.	*/



/***********************************************************************
 *		MSG_GEN_IMAGE_REQUEST for HTGenImageClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the imaeg object to receive the imgae file.
 * PARAMETERS:	    (HTMemHandle src);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_GEN_IMAGE_REQUEST
{
    word i, count;
    optr *image;
    HTMemHandle srcHtmh;
    char *src1, *src2;
    MemHandle mem;

    /*
     * add this image to the list by check if there is another image pointing
     * to the same image.
     */
    if(!(uiMgr.UIM_currentDoc)->HTUI_imageList) 
	(uiMgr.UIM_currentDoc)->HTUI_imageList = 
	    HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

    count = HTListGetCount(uiMgr.UIM_currentDoc->HTUI_imageList);

    src1 = HTMemLock(srcOptr);

    for(i=count; i>0; i--) {
	image = HTListLockItem(uiMgr.UIM_currentDoc->HTUI_imageList, i-1, &mem);
	srcHtmh = @call (*image)::MSG_GEN_IMAGE_GET_SRC_NO_COPY();
	src2 = HTMemLock(srcHtmh);

	if(!strcmp(src1, src2)) {
	    /*
	     * Ok, we found it
	     */
	    HTMemUnlockAndFree(srcOptr);
	    @self->HTGI_target = *image;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	    @send (*image)::MSG_GEN_IMAGE_SET_NEXT(oself);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	    HTMemUnlock(srcHtmh);
	    HTListUnlock(mem);
	    return;
	}
	HTMemUnlock(srcHtmh);
	HTListUnlock(mem);
    }

    HTMemUnlock(srcOptr);

    HTListAppend(uiMgr.UIM_currentDoc->HTUI_imageList, &oself, sizeof(optr));
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif

    @self->HTGI_src = srcOptr;

/*	@self->HTGI_ismap = TRUE; */
    return;
}	/* End of MSG_GEN_IMAGE_REQUEST.	*/


