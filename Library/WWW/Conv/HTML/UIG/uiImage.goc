/***********************************************************************
 *		MSG_META_END_SELECT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	Record mouse co-ordinates for use by short/long touch
 *		notification.
 * PARAMETERS:	void (MouseReturnParams *retVal,
 *		      sword xPosition, sword yPosition,
 *		      word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	allen   	10/28/97   	Initial Revision
 *	
 ***********************************************************************/

@if @SHORT_LONG_TOUCH

@method HTGenImageClass, MSG_META_END_SELECT
{
  @self->HTGI_rawMouseCoord.P_x = xPosition;
  @self->HTGI_rawMouseCoord.P_y = yPosition;
  @callsuper();
}	/* End of MSG_META_END_SELECT.	*/

@endif /* SHORT_LONG_TOUCH */


/***********************************************************************
 *	if SHORT_LONG_TOUCH
 *		MSG_META_UIG_SHORT_TOUCH_NOTIFY for HTGenImageClass
 *	else
 *		MSG_META_START_SELECT for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	Pass the mouse coordinates to the server.    
 * PARAMETERS:
 *	MSG_META_UIG_SHORT_TOUCH_NOTIFY:
 *		void ()
 *	MSG_META_START_SELECT:
 *		void (MouseReturnParams *retVal,
 *		      sword xPosition, sword yPosition,
 *		      word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/12/96   	Initial Revision
 *
 ***********************************************************************/
@if @SHORT_LONG_TOUCH
@method HTGenImageClass, MSG_META_UIG_SHORT_TOUCH_NOTIFY
@else
@method HTGenImageClass, MSG_META_START_SELECT
@endif /* SHORT_LONG_TOUCH */
{
  Rectangle bound;
  int rel_x, rel_y, count, i;
  char *name, *name2;
  MapItem *mapItem;
  HTMemHandle map;
  SemaphoreHandle sem = uiMgr.UIM_access;

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;

  if(!uiMgr.UIM_currentDoc ||
     (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
@if !@SHORT_LONG_TOUCH
      retVal->flags = MRF_PROCESSED;
@endif /* !SHORT_LONG_TOUCH */

      ThreadVSem(sem);
      return;
  }

@if !@SHORT_LONG_TOUCH
  @callsuper();
  if (!(GET_BUTTON_INFO(inputState) & BI_PRESS)) {
      ThreadVSem(sem);
      return;
  }
@endif /* !SHORT_LONG_TOUCH */
  /*
   *  Find the mouse position relative to the (left, top) of the image.
   */
  @call self::MSG_VIS_GET_BOUNDS(&bound);
@if @SHORT_LONG_TOUCH
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  rel_x = @self->HTGI_rawMouseCoord.P_x - bound.R_left;
  rel_y = @self->HTGI_rawMouseCoord.P_y - bound.R_top;
@else
  rel_x = xPosition - bound.R_left;
  rel_y = yPosition - bound.R_top;
@endif /* SHORT_LONG_TOUCH */
  /*
   *  Adjust for the scaling factor, which is high_word / low_word of
   *  @self->HTGI_scaleRatio.
   */
  rel_x = (float)rel_x / (float)DWORD_WIDTH(@self->HTGI_scaleRatio) 
	   * (float)DWORD_HEIGHT(@self->HTGI_scaleRatio);
  rel_y = (float)rel_y / (float)DWORD_WIDTH(@self->HTGI_scaleRatio) 
	   * (float)DWORD_HEIGHT(@self->HTGI_scaleRatio);

  if (@self->HTGI_usemap) {
      /*
       *  If there is a usemap, find the right map item from the usemap 
       *  list and find get the area item in that map item.
       */
      if ((count = HTListGetCount(uiMgr.UIM_currentDoc->HTUI_areaMaps)) > 0) {
	name2=(char*)HTMemLock(@self->HTGI_usemap);
        for (i = 0; i < count; i++) {
	  HTListGetItem(uiMgr.UIM_currentDoc->HTUI_areaMaps, i, &map, sizeof(HTMemHandle));
	  mapItem = (MapItem *)HTMemLock(map);
	  name=(char*)HTMemLock(mapItem->MI_mapName);
	  if (strcmp(name, name2+1) == 0) {
	    /*
	     *  Found the right <MAP> item.  See which <AREA> item that
	     *  the mouse event falls into.
	     */
	    FigureDestinationForMouseEvent
		(mapItem->MI_areas, rel_x, rel_y, uiMgr.UIM_currentDoc->HTUI_pmanager, oself);
	    HTMemUnlock(mapItem->MI_mapName);
	    HTMemUnlock(map);
	    break;
	  }
	  else {
	    HTMemUnlock(mapItem->MI_mapName);
	    HTMemUnlock(map);
	  }
	}
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	HTMemUnlock(@self->HTGI_usemap);
      }
  }
  else if (@self->HTGI_ismap && @self->HTGI_hrefToken > -1) {
    /*  There is a href Token on this image */
    EC_ERROR_IF(!uiMgr.UIM_currentDoc->HTUI_pmanager, 1);
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_REFER_ISMAP_LINK(rel_x,rel_y,@self->HTGI_hrefToken);
  }
  else if (@self->HTGI_hrefToken != -1) {
    /*  There is a href Token on this image */
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_REFER_HYPERLINK(@self->HTGI_hrefToken);
  }
  else if (@self->HTGI_input) {
    @self->HTGI_input_x = rel_x;
    @self->HTGI_input_y = rel_y;
    HTML_FORM_SUBMIT(@self->HTGI_formId, oself);
  }
  else if (@self->HTGI_load == ILS_UNLOAD &&
	   (@self->HTGI_src || @self->HTGI_target)) {
    Rectangle box;
    bound.R_left -= 1;
    bound.R_top -= 2;
    bound.R_right += 1;
    bound.R_bottom += 1;
    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
      (oself, bound, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @self->HTGI_focalBound.RD_left = bound.R_left;
    @self->HTGI_focalBound.RD_top = bound.R_top;
    @self->HTGI_focalBound.RD_right = bound.R_right;
    @self->HTGI_focalBound.RD_bottom = bound.R_bottom;
    @self->HTGI_focalAnchor = 0;
  }
  else {
    EC_ERROR_IF((@self->HTGI_hrefToken != -1), 1);
    /*  There is no href Token on this image */
    EC_ERROR_IF(!uiMgr.UIM_currentDoc->HTUI_pmanager, 1);
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_CLEAR_HREF_LINK();
  }

  ThreadVSem(sem);

@if !@SHORT_LONG_TOUCH
  retVal->flags = MRF_PROCESSED;
  return;
@endif /* !SHORT_LONG_TOUCH */
}	/* End of MSG_META_START_SELECT.	*/

/***********************************************************************
 *		MSG_META_UIG_LONG_TOUCH_NOTIFY for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Grab the focus, but don't activate hyperlink.
 * PARAMETERS:	    void ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	allen   	10/31/97   	Initial Revision
 *	
 ***********************************************************************/

@if @SHORT_LONG_TOUCH

@method HTGenImageClass, MSG_META_UIG_LONG_TOUCH_NOTIFY
{
    Rectangle box;
    Rectangle bound;
  SemaphoreHandle sem = uiMgr.UIM_access;

    if (@self->HTGI_hrefToken == -1 &&
	(@self->HTGI_load != ILS_UNLOAD ||
	 !(@self->HTGI_src || @self->HTGI_target))) {
	return;
    }

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;

  if(!uiMgr.UIM_currentDoc ||
     (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
      ThreadVSem(sem);
      return;
  }

    @call self::MSG_VIS_GET_BOUNDS(&bound);
    bound.R_left -= 1;
    bound.R_top -= 2;
    bound.R_right += 1;
    bound.R_bottom += 1;
    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
      (oself, bound, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @self->HTGI_focalBound.RD_left = bound.R_left;
    @self->HTGI_focalBound.RD_top = bound.R_top;
    @self->HTGI_focalBound.RD_right = bound.R_right;
    @self->HTGI_focalBound.RD_bottom = bound.R_bottom;
    @self->HTGI_focalAnchor = 0;

    /*
     * HINT_SHORT_LONG_TOUCH was added to this object only if it has a link.
     * So here we can safely assume it has a link.
     */
    if (@self->HTGI_load == ILS_UNLOAD)
      @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_DISPLAY_HREF_TARGET
	  (@self->HTGI_hrefToken, oself);
    else
      @send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_DISPLAY_HREF_TARGET
	  (@self->HTGI_hrefToken, NULL);

    ThreadVSem(sem);
}	/* End of MSG_META_UIG_LONG_TOUCH_NOTIFY.	*/

@endif /* SHORT_LONG_TOUCH */


/***********************************************************************
 *		MSG_META_PTR for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/18/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenImageClass, MSG_META_PTR
{
  Rectangle bound;
  Boolean found = FALSE;
  char *name, *name2;
  MapItem *mapItem;
  HTMemHandle map;
  int rel_x, rel_y, i, count;
  SemaphoreHandle sem = uiMgr.UIM_access;

  /*
   * We want to aviod doing anything when we switch pages.
   */
  if(!uiMgr.UIM_currentDoc || 
     (@self->HTGI_usemap && !uiMgr.UIM_currentDoc->HTUI_areaMaps) ||
     (@self->HTGI_hrefToken != -1 && !uiMgr.UIM_currentDoc->PM_hrefs)) {

    retVal->flags = MRF_PROCESSED;
    return;
  }

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;

  if((@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
      retVal->flags = MRF_PROCESSED;
      ThreadVSem(sem);
      return;
  }

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  if (@self->HTGI_usemap) {
    /*
     *  If there is a usemap, find the right map item from the usemap 
     *  list and find get the area item in that map item.
     */
    if ((count = HTListGetCount(uiMgr.UIM_currentDoc->HTUI_areaMaps)) > 0) {
      @call self::MSG_VIS_GET_BOUNDS(&bound);
      rel_x = xPosition - bound.R_left;
      rel_y = yPosition - bound.R_top;
    /*
     *  Adjust for the scaling factor, which is high_word / low_word of
     *  @self->HTGI_scaleRatio.
     */
      rel_x = (float)rel_x / (float)DWORD_WIDTH(@self->HTGI_scaleRatio) 
	  * (float)DWORD_HEIGHT(@self->HTGI_scaleRatio);
      rel_y = (float)rel_y / (float)DWORD_WIDTH(@self->HTGI_scaleRatio) 
	  * (float)DWORD_HEIGHT(@self->HTGI_scaleRatio);
      /*
       *  Get an element and lock down its block.
       */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      name2 = (char*)HTMemLock(@self->HTGI_usemap);
      for (i = 0; i < count; i++) {
	HTListGetItem(uiMgr.UIM_currentDoc->HTUI_areaMaps, i, &map, sizeof(HTMemHandle));
	mapItem = (MapItem *)HTMemLock(map);
	name=(char *)HTMemLock(mapItem->MI_mapName);
	if (strcmp(name, name2+1) == 0) {
	  /*
	   *  Found the right <MAP> item.  See which <AREA> item that
	   *  the mouse event falls into.
	   */
	  found = FigureDestinationForMouseEvent
	    (mapItem->MI_areas, rel_x, rel_y, NULL, oself);
	  HTMemUnlock(mapItem->MI_mapName);
	  HTMemUnlock(map);
	  break;
	}
	else {
	  HTMemUnlock(mapItem->MI_mapName);
	  HTMemUnlock(map);
	}
      }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      HTMemUnlock(@self->HTGI_usemap);
    }
  }
  else if (@self->HTGI_hrefToken != -1 || @self->HTGI_input) {
    found = TRUE;
  }

  if(@self->HTGI_hrefToken != -1 && (uiMgr.UIM_currentDoc)->PM_hrefs) {
      int len;
      char *url;
      HTMemHandle urlHtmh;
      len = HTListGetItemSize((uiMgr.UIM_currentDoc)->PM_hrefs, 
			    @self->HTGI_hrefToken);
      url = HTMemAllocAndLock(&urlHtmh, len + 1);
      HTListGetItem((uiMgr.UIM_currentDoc)->PM_hrefs, 
		    @self->HTGI_hrefToken, url, len);
      *(url + len) = 0;
      HTMemUnlock(urlHtmh);

      @send (ConstructOptr(uiMgr.UIM_client, 0))::
	  {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	      (UI_MOUSE_OVER_LINK, urlHtmh);
  }else if(@self->HTGI_load == ILS_UNLOAD) {
      HTMemHandle urlHtmh;
      urlHtmh = @call self::MSG_GEN_IMAGE_GET_SRC();

      @send (ConstructOptr(uiMgr.UIM_client, 0))::
	  {MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	      (UI_MOUSE_OVER_IMAGE, urlHtmh);
  }

  if (found) {
    /*  There is a href Token on this image */
    retVal->ptrImage = @BoxCursor;
    /* this event processed */
    retVal->flags = MRF_PROCESSED | MRF_SET_POINTER_IMAGE;
  }
  else
    retVal->flags = MRF_PROCESSED | MRF_CLEAR_POINTER_IMAGE;

  ThreadVSem(sem);
  return;
}	/* End of MSG_META_PTR.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenImageClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    if (@self->HTGI_bitmapFile && @self->HTGI_bitmapBlock)
	HugeArrayDestroy(@self->HTGI_bitmapFile, @self->HTGI_bitmapBlock);

    /* 
     * These would be destroyed when we delete the blocks using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGI_src)
     *   HTMemFree(@self->HTGI_src);
     * 
     * if (@self->HTGI_name)
     *   HTMemFree(@self->HTGI_name);
     * 
     * if (@self->HTGI_alt)
     *   HTMemFree(@self->HTGI_alt);
     * 
     * if (@self->HTGI_usemap)
     *   HTMemFree(@self->HTGI_usemap);
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/


/***********************************************************************
 *		MSG_META_KBD_CHAR for HTGenImageClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Allow Input image submit data.
 * PARAMETERS:	    (word character, word flags, word state)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenImageClass, MSG_META_KBD_CHAR
{
    if (@self->HTGI_input && @self->HTGI_load == ILS_LOADED &&
	( ( (word)( CS_CONTROL << 8 ) | VC_ENTER ) == character ) && 
	( CF_FIRST_PRESS & flags )) {
	@self->HTGI_input_x = 0;
	@self->HTGI_input_y = 0;
        HTML_FORM_SUBMIT(@self->HTGI_formId, oself);
    }
    @callsuper();
    return;
}	/* End of MSG_META_KBD_CHAR.	*/


