}	/* End of MSG_VIS_MARK_INVALID.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    This message has three purposes, 
 *                    1. set the size
 *                    2. set some flags
 *                    3. set notification
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_SPEC_BUILD_BRANCH
{
  VisCompInstance * vself;
  word t = 0;
  VisTextExtendedFilterType filter;
  @callsuper();

  /*
   * set the reasonable size
   */
  @self->TATI_height = @call self::MSG_VIS_TEXT_CALC_HEIGHT
      (@self->TATI_width, FALSE);

  if(@self->TATI_height < @self->TATI_length) 
      @self->TATI_height = @self->TATI_length + 2;

  @call self::MSG_VIS_SET_SIZE(@self->TATI_width, @self->TATI_height+1); 


  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID);
/*  @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();*/

  @call self::MSG_GEN_TEXT_SET_ATTRS(GTA_DONT_SCROLL_TO_CHANGES, 0);
  /*
   * declare that we want to get all the notificatioin happened for 
   * this text object
   */
  @call self::MSG_META_ADD_VAR_DATA(ATTR_VIS_TEXT_NOTIFY_CURSOR_POSITION,
		sizeof(word), &t);

  filter = VTEFT_REPLACE_PARAMS;
  @call self::MSG_META_ADD_VAR_DATA(ATTR_VIS_TEXT_EXTENDED_FILTER,
		sizeof(VisTextExtendedFilterType), &filter);

  @self->TATI_origin.P_x = @self->TATI_origin.P_y = 0;

/*
  if (!vself->VTI_lines) {
      vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			      VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();
  }
*/

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    We don't want to draw the text out of the textarea,
 *                  so we intercept this message and set the clipRect.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/11/97   	Initial Revision
 *	sean		11/19/97	Printing changes.
 *					Fixes #73182.
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_DRAW
{
    Rectangle		oldBounds;
    VisInstance    	*vself;

    vself = ObjDerefVis(oself);

    if(!vself->VI_bounds.R_left && !vself->VI_bounds.R_top) 
	return;

    vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID);

    /* For printing, we have to have the correct vis bounds to */
    /* print.  Since this object's bounds are bigger than what */
    /* is visible, let's set the bounds, and restore them      */
    /* later.  For Penelope, we need a scalable (printable)    */
    /* font also.  Fixes #73182.  Sean 11/19/97.	       */
    if(drawFlags & DF_PRINT)
    {
      @call self::MSG_VIS_GET_BOUNDS(&oldBounds);
      vself->VI_bounds.R_left = @self->TATI_x;
      vself->VI_bounds.R_top = @self->TATI_y + 1;
      vself->VI_bounds.R_right = @self->TATI_x + @self->TATI_width;
      vself->VI_bounds.R_bottom = @self->TATI_y + @self->TATI_length;
@ifdef	TRUNK
      NPTextConvertFontID(oself, FID_PENELOPE, FID_DTC_URW_SANS);
@endif
    }
    else
    {    
      GrSaveState(gstate); 

      GrSetWinClipRect(gstate, PCT_REPLACE,
		  @self->TATI_x, @self->TATI_y + 1, 
		  @self->TATI_x + @self->TATI_width, 
		  @self->TATI_y + @self->TATI_length);
    }

    @callsuper();

    if(drawFlags & DF_PRINT)
    {
      vself = ObjDerefVis(oself);
      vself->VI_bounds.R_left = oldBounds.R_left;
      vself->VI_bounds.R_top = oldBounds.R_top;
      vself->VI_bounds.R_right = oldBounds.R_right;
      vself->VI_bounds.R_bottom = oldBounds.R_bottom;
@ifdef	TRUNK
      NPTextConvertFontID(oself, FID_DTC_URW_SANS, FID_PENELOPE);
@endif
    }
    else
    {
      GrRestoreState(gstate);
    }
}	/* End of MSG_VIS_DRAW.	*/


/***********************************************************************
 *		MSG_TAT_RESET for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Reset the position and size when user reset it.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_RESET
{
    XYValueAsDWord xy;
    @self->TATI_firstChar.P_x = @self->TATI_firstChar.P_y = 0;

    @self->TATI_height = @call self::MSG_VIS_TEXT_CALC_HEIGHT
      (@self->TATI_width, FALSE);

    if(@self->TATI_height < @self->TATI_length) 
	@self->TATI_height = @self->TATI_length;

    @call self::MSG_VIS_SET_SIZE(@self->TATI_width, @self->TATI_height+1); 

    xy = @call @genParent::MSG_VIS_GET_POSITION();
    
    @self->TATI_x = @self->TATI_origin.P_x = DWORD_X(xy);
    @self->TATI_y = @self->TATI_origin.P_y = DWORD_Y(xy);
    @call self::MSG_VIS_POSITION_BRANCH(0,0);

    @call self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION
	(0, VARF_NOT_IF_ALREADY_INVALID, 
	 @self->TATI_y + @self->TATI_length,
	 @self->TATI_x + @self->TATI_width - 1, 
	 @self->TATI_y + 1, @self->TATI_x + 1);

    @call self::MSG_VIS_INVALIDATE(); 
    return;
}	/* End of MSG_TAT_RESET.	*/


/***********************************************************************
 *		MSG_TAT_INITIALIZE for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_INITIALIZE
{
    VisTextGetLineInfoReturnValues retValue;
    VisTextGetLineInfoParameters vtglip;
    LineInfo lineInfo;

    @self->TATI_firstChar.P_x = @self->TATI_firstChar.P_y = 0;

    vtglip.VTGLIP_buffer = &lineInfo;
    vtglip.VTGLIP_bsize = sizeof(LineInfo);
    vtglip.VTGLIP_line = 0;
    @call self::MSG_VIS_TEXT_GET_LINE_INFO
	(&retValue, &vtglip);
    @self->TATI_lineHeight = lineInfo.LI_hgt.WBF_int;
}	/* End of MSG_TAT_INITIALIZE.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_GENERATE_NOTIFY for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    The main field for us to simulate the scrolling here.
 *                  We want to keep the cursor always inside the textarea,
 *                  so whenever the cursor position changed, we check if 
 *                  it's still inside the area. If so, return. If not, we
 *                  reposition the text object to keep the cursor still
 *                  visable. 
 *                  After that, we need to transform the gstate which is
 *                  used by the system to draw the cursor and new chars.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_TEXT_GENERATE_NOTIFY
{
    VisTextInstance * vself;
    int line;
    TransMatrix tm;

    /* 
     * check if it's a cursor notification, and if we get some thing to
     * display.
     */
    if((params->VTGNP_notificationTypes & VTNF_CURSOR_POSITION)
       && (@call self::MSG_VIS_TEXT_GET_TEXT_SIZE())>0) {

	vself = ObjDerefVis(oself);

	if(!vself->VTI_cursorPos.P_x && !vself->VTI_cursorPos.P_y
	   || !vself->VI_bounds.R_top && !vself->VI_bounds.R_left)
	    return;
	   
	if(!vself->VTI_gstate){
	    @self->TATI_lastGState = 0;
	    return;
	}

	if(!@self->TATI_lineHeight) {
	    @call self::MSG_TAT_INITIALIZE();

	    @self->TATI_lastGState = vself->VTI_gstate;

	    GrGetTransform(vself->VTI_gstate, &tm);
	    @self->TATI_lastTMe32 = tm.TM_e32.DWF_int;
	    GrSetTransform(vself->VTI_gstate, &tm);

	    return;

	}
 	
	if( vself->VTI_selectStart == vself->VTI_selectEnd) {
	    if(!@self->TATI_lastGState) {
		line = vself->VTI_cursorPos.P_y / @self->TATI_lineHeight;
		if(line >= @self->TATI_firstChar.P_y + @self->TATI_rows){
		    vself->VTI_cursorPos.P_x = 0;
		    vself->VTI_cursorPos.P_y = 1;
		}

		@self->TATI_lastGState = vself->VTI_gstate;

		GrGetTransform(vself->VTI_gstate, &tm);
		@self->TATI_lastTMe32 = tm.TM_e32.DWF_int;
		GrSetTransform(vself->VTI_gstate, &tm);

		return;

	    } else if(@self->TATI_lastGState != vself->VTI_gstate) {
		@self->TATI_lastGState = vself->VTI_gstate;
		
		@call self::MSG_VIS_TEXT_FLASH_CURSOR_OFF();

		GrGetTransform(vself->VTI_gstate, &tm);
		tm.TM_e32.DWF_int = @self->TATI_lastTMe32;
		GrSetTransform(vself->VTI_gstate, &tm);

		@call self::MSG_VIS_TEXT_FLASH_CURSOR_ON();

		return;
	    }


	    line = vself->VTI_cursorPos.P_y / @self->TATI_lineHeight;

	} else {
	    line = @call self::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET
		(vself->VTI_lastOffset);
	}

	@call self::MSG_TAT_DISPLAY_POSITION(line);
    }
}	/* End of MSG_VIS_TEXT_GENERATE_NOTIFY.	*/


/***********************************************************************
 *		MSG_TAT_DISPLAY_POSITION for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_DISPLAY_POSITION
{
    VisTextInstance * vself;
    TransMatrix tm;

    if(line >= @self->TATI_firstChar.P_y + @self->TATI_rows)
	@self->TATI_firstChar.P_y = line - @self->TATI_rows + 1;
    else if(line < @self->TATI_firstChar.P_y) 
	@self->TATI_firstChar.P_y = line;
    else 
	return;

    @self->TATI_origin.P_y = @self->TATI_y - 
	@self->TATI_firstChar.P_y * @self->TATI_lineHeight;

    @call self::MSG_VIS_SET_POSITION
	(@self->TATI_origin.P_x, @self->TATI_origin.P_y);
    @call self::MSG_VIS_POSITION_BRANCH(0,0);

    @call self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION
	(0, VARF_NOT_IF_ALREADY_INVALID, 
	 @self->TATI_y + @self->TATI_length, 
	 @self->TATI_x + @self->TATI_width - 1, 
	 @self->TATI_y + 1, @self->TATI_x + 1);

    vself = ObjDerefVis(oself);

    GrGetTransform(vself->VTI_gstate, &tm);
    tm.TM_e32.DWF_int = @self->TATI_origin.P_y-1;
    GrSetTransform(vself->VTI_gstate, &tm);
    @self->TATI_lastTMe32 = tm.TM_e32.DWF_int;

    @send self::MSG_VIS_INVALIDATE();
}	/* End of MSG_TAT_DISPLAY_POSITION.	*/



/***********************************************************************
 *		MSG_META_LARGE_PTR for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    MouseReturnParams *retVal = bpaxdxcx,
 *                  LargeMouseData *largeMouseDataStruct=ss:bp
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_META_LARGE_PTR
{
    word yPosition, line;

    yPosition = (word)largeMouseDataStruct->LMD_location.PDF_y.DWF_int;

    if(yPosition < @self->TATI_origin.P_y + @self->TATI_height - 5 &&
       yPosition > @self->TATI_origin.P_y + 5) {

	if(!@self->TATI_lineHeight) @call self::MSG_TAT_INITIALIZE();
	line = (yPosition - @self->TATI_origin.P_y)/ @self->TATI_lineHeight;

	@call self::MSG_TAT_DISPLAY_POSITION(line);
    }

    @callsuper();
    
}	/* End of MSG_META_LARGE_PTR.	*/


/***********************************************************************
 *		MSG_META_KBD_CHAR for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    set the clip rect for the VTI_gstate before callsuper.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_META_KBD_CHAR
{
    VisTextInstance * vself;

    if(  (character != ((VC_ISCTRL << 8) | VC_LEFT)) &&
	 (character != ((VC_ISCTRL << 8) | VC_RIGHT)) &&
	 (character != ((VC_ISCTRL << 8) | VC_UP)) &&
	 (character != ((VC_ISCTRL << 8) | VC_DOWN))) {
	
	vself = ObjDerefVis(oself);
	if(vself->VTI_gstate) 
	    GrSetWinClipRect(vself->VTI_gstate, PCT_REPLACE,
			 @self->TATI_x + 1, @self->TATI_y + 1, 
			 @self->TATI_x + @self->TATI_width - 1, 
			 @self->TATI_y + @self->TATI_length);
    }

    if( !(flags & CF_RELEASE) &&
	    (((flags >> 8) & SS_LCTRL) 
	    || ((flags >> 8) & SS_RCTRL) ))  {
	/* 
 	 * Short cut keys
	 */
	if(character == ((VC_ISANSI << 8) | 'A') ||
	   character == ((VC_ISANSI << 8) | 'a')) {
	    /*
	     * Select all
	     */
	    @send self::MSG_VIS_TEXT_SELECT_ALL();
	    return;

	} else if(character == ((VC_ISANSI << 8) | 'C') ||
	    character == ((VC_ISANSI << 8) | 'c')) {
	    /*
	     * Copy to clipboard
	     */
	    @send self::MSG_META_CLIPBOARD_COPY();
	    return;

	} else if(character == ((VC_ISANSI << 8) | 'V') ||
	    character == ((VC_ISANSI << 8) | 'v')) {
	    /* 
	     * Paste 
	     */
	    @send self::MSG_META_CLIPBOARD_PASTE();
	    return;

	} else if(character == ((VC_ISANSI << 8) | 'X') ||
	    character == ((VC_ISANSI << 8) | 'x')) {
	    /* 
	     * Cut
	     */
	    @send self::MSG_META_CLIPBOARD_CUT();
	    return;
	}
    }

    @callsuper();
}	/* End of MSG_META_KBD_CHAR.	*/



/***********************************************************************
 *		MSG_VIS_TEXT_HEIGHT_NOTIFY for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    if the height changed, we need to change the size
 *                  as well.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_TEXT_HEIGHT_NOTIFY
{
    if(newHeight != @self->TATI_height && newHeight > @self->TATI_length) { 
	@self->TATI_height = newHeight;
	@call self::MSG_VIS_SET_SIZE(@self->TATI_width, @self->TATI_height+1); 
    }

    @call self::MSG_VIS_INVALIDATE(); 
    @callsuper(); 
}	/* End of MSG_VIS_TEXT_HEIGHT_NOTIFY.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_FILTER_VIA_REPLACE_PARAMS for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    This function copied from Notepd/toc.goc
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	10/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_TEXT_FILTER_VIA_REPLACE_PARAMS
{
    if (params->VTRP_insCount == 0) 
    {
	/* if this is a delete, allow it to go forward */
	return FALSE;
    } 
    else /* insert */
    {
	/*
	 * if the text object block is already over a certain size,
	 * we won't let any more text be inserted, even if the current
	 * amount of text is less than the maximum allowable.
	 */
	if (MemGetInfo(OptrToHandle(oself), MGIT_SIZE) + params->VTRP_insCount
	    > MAX_TEXT_BLOCK_SIZE)
	{
	    return TRUE;
	}
	/* 
	 * If the text object height is already beyond a certain limit,
	 * don't let any more text be inserted, to make sure it doesn't
	 * get too tall.
	 */
	if (DWORD_HEIGHT(@call oself::MSG_VIS_GET_SIZE()) > 
	    MAX_TEXT_OBJECT_HEIGHT)
	{
	    return TRUE;
	}
	return FALSE;
    }
}	/* End of MSG_VIS_TEXT_FILTER_VIA_REPLACE_PARAMS.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Use our own position.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_POSITION_BRANCH
{
    xOrigin = @self->TATI_origin.P_x;
    yOrigin = @self->TATI_origin.P_y - 2;

    @callsuper();

    return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_TAT_SET_SIZE for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_SET_SIZE
{
    @self->TATI_width = width - 1;
    @self->TATI_length = length;
}	/* End of MSG_TAT_SET_SIZE.	*/

@method TextAreaTextClass, MSG_TAT_SET_POSITION
{
    @self->TATI_x = x;
    @self->TATI_y = y;
    @self->TATI_origin.P_x = x;
    @self->TATI_origin.P_y = y;

    @call self::MSG_VIS_SET_POSITION
	(@self->TATI_origin.P_x, @self->TATI_origin.P_y);
    @call self::MSG_VIS_POSITION_BRANCH(0,0);
}

@method TextAreaTextClass, MSG_TAT_SET_ROWS
{
    @self->TATI_rows = rows;
}

@method TextAreaTextClass, MSG_TAT_SET_COLUMNS
{
    @self->TATI_columns = columns;
}


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    VisTextInstance * vself;
    /*
     * This is not allocated by TextAreaText, but by its superclass.
     * I have to find out all such handles and memory leaks and delete
     * them.... or send MSG_GEN_DESTROY to it.
     * 
     * if (@self->TATI_lastGState) 
     *  GrDestroyState(@self->TATI_lastGState);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * UICreateObj.
     */
    vself = ObjDerefVis(oself);
    if (vself->VTI_gstate)
	GrDestroyState(vself->VTI_gstate);
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/


#ifdef __HIGHC__
#pragma Code("FORMSELECT");
#endif
#ifdef __BORLANDC__
#pragma codeseg FORMSELECT
#endif

/* The code for MultiLineSelection. */
@classdecl	HTMLSelectClass;
@classdecl	HTOtherOptionClass;

/***********************************************************************
 *	MSG_HTML_SELECT_PROCESS_ATTRIBUTE for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_PROCESS_ATTRIBUTE
{
  char *value;
  int	index = 0;

  @self->HTMLS_exclusive = TRUE;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if(entity[index].SGMLE_token == HTML_ATTR_MULTIPLE) {
      	@self->HTMLS_exclusive = FALSE;
	continue;
    }

    if (!entity[index].SGMLE_value)
	continue;

    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      @self->HTMLS_name = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, 
					    value);
      break;
    case HTML_ATTR_SIZE:
      @self->HTMLS_size = atoi(value);
      break;
    }
  }

  return;
}	/* End of MSG_HTML_SELECT_PROCESS_ATTRIBUTE.	*/



/***********************************************************************
 *	MSG_HTML_SELECT_ADD_ONE_OPTION_VALUE for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	 char *value, Boolean selected
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *      MZHU    12/97           Second Revision - removed HTGenFormClass,
 *                                combined HTGenSelectClass and 
 *                                HTGenMultiLineSelectClass.
 *
 ***********************************************************************/
typedef struct {
    Boolean OS_selected;
    Boolean OS_default;
    HTMemHandle OS_value;
    HTMemHandle OS_text;
} OptionStruct;

@method HTMLSelectClass, MSG_HTML_SELECT_ADD_OPTION_VALUE
{
    OptionStruct option;

    /*
     * Check if there is a valid chunkarray. 
     */
    if(!@self->HTMLS_optionsList) {
       @self->HTMLS_optionsList = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);
       @self->HTMLS_optionsNum = 0;
    }

    option.OS_selected = selected;
    option.OS_default = selected;
    option.OS_value = 0;
    option.OS_text = 0;

    if (value) {
	char *ptr;
	ptr = (char *)HTMemAllocAndLockWID(uiMgr.UIM_currentDoc->HTUI_memID, &(option.OS_value), strlen(value)+1);
	strcpy(ptr, value);
	HTMemUnlock(option.OS_value);
    }

    HTListAppend(@self->HTMLS_optionsList, &option, sizeof(OptionStruct));

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  
    return;
}	/* End of MSG_HTML_SELECT_ADD_OPTION_VALUE.	*/



/***********************************************************************
 *	MSG_HTML_SELECT_ADD_OPTION_TEXT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    char *text
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_ADD_OPTION_TEXT
{
    OptionStruct *option, opt;
    int	last;
    word size = 0;
    GStateHandle gstate;
    MemHandle mem;
    char *ptr;

    /*
     * Check if there is a valid chunkarray. 
     */
    if(!@self->HTMLS_optionsList) {
       @self->HTMLS_optionsList = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);
       @self->HTMLS_optionsNum = 0;

       opt.OS_selected = FALSE;
       opt.OS_default = FALSE;
       opt.OS_value = 0;
       opt.OS_text = 0;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
       HTListAppend(@self->HTMLS_optionsList, &opt, sizeof(OptionStruct));
    }


    last = HTListGetCount(@self->HTMLS_optionsList) - 1;

    if(last < 0) return;

    gstate = GrCreateState(0);	/* for finding the longest text string */

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    option = HTListLockItem(@self->HTMLS_optionsList, last, &mem);

    if (!option->OS_text) {
	ptr = (char *)HTMemAllocAndLockWID(uiMgr.UIM_currentDoc->HTUI_memID, &(option->OS_text), strlen(text)+1);
	strcpy(ptr, text);
	HTMemUnlock(option->OS_text);
	size = GrTextWidth(gstate, text, strlen(text));
    } else {
	/*
	 *  Append the new text to the old text.
	 */
	word len;
	ptr = (char *)HTMemLock(option->OS_text);
	len = strlen(ptr)+1;
	HTMemUnlock(option->OS_text);
	option->OS_text = HTMemReAllocWID(uiMgr.UIM_currentDoc->HTUI_memID, option->OS_text, len+strlen(text));
	ptr = (char *)HTMemLock(option->OS_text);
	strcat(ptr, text);
	size = GrTextWidth(gstate, ptr, strlen(ptr));
	HTMemUnlock(option->OS_text);
    }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

    HTListUnlock(mem);

    /* 
     * Find the longest text string. 
     */ 
    if(size > @self->HTMLS_len) @self->HTMLS_len = size;
    GrDestroyState(gstate);

    return;
}	/* End of MSG_HTML_SELECT_ADD_OPTION_TEXT.	*/



/***********************************************************************
 *  MSG_HTML_SELECT_COMPLETE_SELECT_CONSTRUCT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *      MZHU    12/97           Second Revision - removed HTGenFormClass,
 *                                combined HTGenSelectClass and 
 *                                HTGenMultiLineSelectClass.
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_COMPLETE_SELECT_CONSTRUCT
{
    optr item, sel;
    int i, selectedItem = -1;
    SpecSizeSpec sizeSpec;
    CompSizeHintArgs sizeArgs;
    BackgroundColors bgColors;
    OptionStruct *option;
    MemHandle mh;

    if(!@self->HTMLS_optionsList) return;

    @self->HTMLS_optionsNum = HTListGetCount(@self->HTMLS_optionsList);

@ifndef PRODUCT_NIKE
    if(@self->HTMLS_optionsNum <2 || @self->HTMLS_exclusive && 
       (@self->HTMLS_size && @self->HTMLS_size < 4 || 
	!@self->HTMLS_size && @self->HTMLS_optionsNum < 4)) {
	/*
	 * This this case we use Selection Box.
	 */
	@self->HTMLS_size = 1;
	@self->HTMLS_len += 66; /* for the arrows */

        @call self::MSG_META_ADD_VAR_DATA
	    (HINT_ORIENT_CHILDREN_VERTICALLY, 0, NULL);

	sel = UICreateObj((ClassStruct *)&GenItemGroupClass);

	@call sel::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(0);
	@call sel::MSG_GEN_ITEM_GROUP_SET_BEHAVIOR_TYPE(GIGBT_EXCLUSIVE);
	@call sel::MSG_META_ADD_VAR_DATA
		(HINT_ITEM_GROUP_MINIMIZE_SIZE, 0, NULL);

	sizeArgs.CSHA_width = SST_PIXELS | @self->HTMLS_len;
	sizeArgs.CSHA_height = 0;
	sizeArgs.CSHA_count = 1;

/*	@call self::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
*/
	@call sel::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);

	@call self::MSG_GEN_ADD_CHILD(sel, CCF_MARK_DIRTY);
	@call sel::MSG_GEN_SET_USABLE(VUM_NOW);

	selectedItem = -1;
        for(i=0; i<@self->HTMLS_optionsNum; i++) {
	    item = UICreateObj((ClassStruct *)&GenItemClass);
	    @call sel::MSG_GEN_ADD_CHILD(item, CCF_MARK_DIRTY);
	    @call item::MSG_GEN_SET_USABLE(VUM_NOW);
	    option = HTListLockItem(@self->HTMLS_optionsList, i, &mh);
	    @call item::MSG_GEN_ITEM_SET_IDENTIFIER(i);
	    if(option->OS_text) {
		@call item::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		    (HTMemLock(option->OS_text), VUM_DELAYED_VIA_APP_QUEUE);
		HTMemUnlock(option->OS_text);
	    } else 
		@send item::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			"", VUM_DELAYED_VIA_APP_QUEUE);

            if(option->OS_selected) selectedItem = i;
            HTListUnlock(mh);
	}
	
	if(selectedItem != -1)
	    @call sel::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(selectedItem, 0);
	else
	    @call sel::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0, 0);

	@self->HTMLS_itemGroup = sel;

    } else {

	@self->HTMLS_itemGroup = 0;
	/*
	 * Now we will use Listbox control.
	 */
	if(!@self->HTMLS_size) 
	    @self->HTMLS_size = min(4, @self->HTMLS_optionsNum);
	else if(@self->HTMLS_size == 1) 
	    @self->HTMLS_size = 2; /* min size */
	else
	    @self->HTMLS_size = min(@self->HTMLS_size, @self->HTMLS_optionsNum);
@else
	if(!@self->HTMLS_size) 
	    @self->HTMLS_size = min(3, @self->HTMLS_optionsNum);
	else if(@self->HTMLS_optionsNum <= 3) 
	    @self->HTMLS_size = @self->HTMLS_optionsNum;
	else if((@self->HTMLS_size <= 2)) 
	    @self->HTMLS_size = 3; /* min size */
	else
	    @self->HTMLS_size = min(@self->HTMLS_size, @self->HTMLS_optionsNum);

@endif

	bgColors.BC_unselectedColor1 = C_WHITE;
	bgColors.BC_unselectedColor2 = C_WHITE;
	bgColors.BC_selectedColor1 = C_WHITE;
	bgColors.BC_selectedColor2 = C_WHITE;
  
	sizeSpec = SST_PIXELS | 0;

EC_ERROR_IF(@self->HTMLS_len < 0, UIG_ERROR_NEGATIVE_WIDTH);
	sizeArgs.CSHA_width = SST_PIXELS | @self->HTMLS_len;
	sizeArgs.CSHA_height = SST_LINES_OF_TEXT | 1;
	sizeArgs.CSHA_count = 1;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

        @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX, 0, NULL);
@ifdef TRUNK
        @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED, 0, NULL);
@endif
        @call self::MSG_META_ADD_VAR_DATA
	    (HINT_ORIENT_CHILDREN_VERTICALLY, 0, NULL);
	@call self::MSG_META_ADD_VAR_DATA
	    (HINT_NO_TALLER_THAN_CHILDREN_REQUIRE, 0, NULL);
	@call self::MSG_META_ADD_VAR_DATA
	    (HINT_NO_WIDER_THAN_CHILDREN_REQUIRE, 0, NULL);
	@call self::MSG_META_ADD_VAR_DATA
	    (HINT_CUSTOM_CHILD_SPACING, sizeof(SpecSizeSpec), &sizeSpec); 
	@call self::MSG_META_ADD_VAR_DATA
	    (HINT_GADGET_BACKGROUND_COLORS, sizeof(BackgroundColors), &bgColors);

	/* Create a chunkarray to hold the children. */
	@self->HTMLS_itemList = HTListNewWID(uiMgr.UIM_currentDoc->HTUI_memID);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

        for(i=0; i<@self->HTMLS_size; i++) {
	    item = UICreateObj((ClassStruct *)&HTOtherOptionClass);

@ifndef RESPONDER_KERNEL
	    @call item::MSG_META_ADD_VAR_DATA
		(HINT_DRAW_STYLE_FLAT, 0, NULL);
@endif
	    @call item::MSG_META_ADD_VAR_DATA
		(HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);

     	    @call item::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);

	    @call self::MSG_GEN_ADD_CHILD(item, CCF_MARK_DIRTY);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	    @call item::MSG_HTOO_SET_ML(oself);
	    @call item::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);

	    HTListAppend(@self->HTMLS_itemList, &item, sizeof(optr));
	}

	@call self::MSG_HTML_SELECT_SET_ALL_MONIKER();

@ifndef PRODUCT_NIKE
    }
@endif

}	/* End of MSG_HTML_SELECT_COMPLETE_SELECT_CONSTRUCT.	*/



/***********************************************************************
 *		MSG_HTML_SELECT_SET_ALL_MONIKER for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_SET_ALL_MONIKER
{
    OptionStruct *option;
    char  *text;
    int  i, realItem;
    optr *item;
    MemHandle imem, omem;

    EC_ERROR_IF(!@self->HTMLS_optionsList, UIG_UI_TREE_OPERATION_FAILS);

    if(!@self->HTMLS_optionsList) return;

    for(i=0; i<@self->HTMLS_size; i++) {
    	realItem = i + @self->HTMLS_currentFirst;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
        if(realItem < @self->HTMLS_optionsNum) {
	    item = HTListLockItem
		(@self->HTMLS_itemList,
		 min(@self->HTMLS_size,@self->HTMLS_optionsNum) - i - 1, 
		 &imem);

	    option = HTListLockItem
		(@self->HTMLS_optionsList,
		 realItem, &omem);

	    @send (*item)::MSG_HTOO_SET_SEL(option->OS_selected);

	    if(option->OS_text) {
		text = HTMemLock(option->OS_text);
		@call (*item)::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			(char *)text, VUM_DELAYED_VIA_APP_QUEUE);
		HTMemUnlock(option->OS_text);
	    } else 
		@send (*item)::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			"", VUM_DELAYED_VIA_APP_QUEUE);

	    HTListUnlock(imem);
	    HTListUnlock(omem);
	}
    }
}	/* End of MSG_HTML_SELECT_SET_ALL_MONIKER.	*/



/***********************************************************************
 *		MSG_HTML_SELECT_SCROLL_UP for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_SCROLL_UP,
				   MSG_HTML_SELECT_SCROLL_DOWN
{
    Rectangle rect;
    
    @call self::MSG_VIS_GET_BOUNDS(&rect);

    if(message == MSG_HTML_SELECT_SCROLL_UP && @self->HTMLS_currentFirst) {
	@self->HTMLS_currentFirst --;
	if(!@self->HTMLS_currentFirst && @self->HTMLS_timerHandle) {

	    TimerStop(@self->HTMLS_timerHandle, @self->HTMLS_timerId);
	    @self->HTMLS_timerHandle = 0;
	    @self->HTMLS_timerId = 0;
	    @self->HTMLS_pressUpOrDown = 0;
	}
    } else if(message == MSG_HTML_SELECT_SCROLL_DOWN && 
	      ((@self->HTMLS_optionsNum - @self->HTMLS_currentFirst)
		> @self->HTMLS_size)) {
	@self->HTMLS_currentFirst ++;
	    
	if(((@self->HTMLS_optionsNum - @self->HTMLS_currentFirst)
	    == @self->HTMLS_size) && @self->HTMLS_timerHandle) {

	    TimerStop(@self->HTMLS_timerHandle, @self->HTMLS_timerId);
	    @self->HTMLS_timerHandle = 0;
	    @self->HTMLS_timerId = 0;
	    @self->HTMLS_pressUpOrDown = 0;
	}
    }

    @call self::MSG_HTML_SELECT_SET_ALL_MONIKER();

    /* 
     * Redraw the arrows
     */
    @send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_top + (ARROW_HEIGHT + 1), 
		rect.R_right - 1,
		rect.R_top + 1, 
		rect.R_right - (ARROW_WIDTH + 1));

    @send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_bottom - 1, 
		rect.R_right - 1,
		rect.R_bottom - (ARROW_HEIGHT + 1), 
		rect.R_right - (ARROW_WIDTH + 1));

}	/* End of MSG_HTML_SELECT_SCROLL_UP.	*/



/***********************************************************************
 *		MSG_HTML_SELECT_CHANGE_SELECT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    optr item
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_CHANGE_SELECT
{
    word i, current;
    optr *tmp;
    OptionStruct *option;
    MemHandle imem, omem;

    if(!@self->HTMLS_optionsList) return;

    if(@self->HTMLS_exclusive) {
	for(i=0; i<@self->HTMLS_size; i++) {
	    tmp = HTListLockItem(@self->HTMLS_itemList, i, &imem);
	    if(*tmp != item) {
		if (@call (*tmp)::MSG_HTOO_GET_SEL()) {
		    @call (*tmp)::MSG_HTOO_SET_SEL(FALSE);
		    @send (*tmp)::MSG_VIS_INVALIDATE();
	 	}
	    } else
		current = i;

	    HTListUnlock(imem);
	}

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	current = @self->HTMLS_size - current - 1 
			+ @self->HTMLS_currentFirst;

	for(i=0; i<@self->HTMLS_optionsNum; i++) {
	    option = HTListLockItem(@self->HTMLS_optionsList, i, &omem);
	    if(i == current) 
		option->OS_selected = !option->OS_selected;
	    else if(option->OS_selected) 
		option->OS_selected = FALSE;

	    HTListUnlock(omem);
	}		

    } else {

	for(i=0; i<@self->HTMLS_size; i++) {
	    tmp = HTListLockItem(@self->HTMLS_itemList, i, &imem);
	    if(*tmp == item) current = i;
	    HTListUnlock(imem);
	}

	current = @self->HTMLS_size - current - 1 
			+ @self->HTMLS_currentFirst;

	option = HTListLockItem(@self->HTMLS_optionsList, current, &omem);
	option->OS_selected = !option->OS_selected;
	HTListUnlock(omem);
    }

}	/* End of MSG_HTML_SELECT_CHANGE_SELECT.	*/


/***********************************************************************
 *		MSG_META_START_SELECT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    MouseReturnParams *retVal = bpaxdxcx,
 *		    sword xPosition = cx,
 *	       	    sword yPosition = dx,
 *		    word inputState = bp
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *            what we want to do here is to check if the user click on 
 *            the up-down arrows areas. if it is, we need send up/down 
 *            message to ourself and mark the event processed, otherwise, 
 *            we callsuper and let the event go down to the option items.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_META_START_SELECT
{
    Rectangle rect, box;
    SemaphoreHandle sem = uiMgr.UIM_access;
    
    /* prevent crash */
    if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;
    if(!uiMgr.UIM_currentDoc ||
       (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
	((ClassStruct *)&GenContentClass)) != 
       uiMgr.UIM_currentDoc->HTUI_genContent) {
	retVal->flags = MRF_PROCESSED;
	ThreadVSem(sem);
	return;
    }

    @call self::MSG_VIS_GET_BOUNDS(&rect);

    if(!@self->HTMLS_itemGroup) {
	rect.R_left -= 2;
	rect.R_right += 1;
	rect.R_top -= 2;
	rect.R_bottom += 2;
    } else {
	rect.R_right -= 1;
	rect.R_bottom -= 1;
    }
    @self->HTMLS_focalBound.RD_left = rect.R_left;
    @self->HTMLS_focalBound.RD_right = rect.R_right;
    @self->HTMLS_focalBound.RD_top = rect.R_top;
    @self->HTMLS_focalBound.RD_bottom = rect.R_bottom;

    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    @send (uiMgr.UIM_currentDoc)->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
	(oself, rect, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);

    if(@self->HTMLS_itemGroup) {/* for a Selection Box */
	ThreadVSem(sem);
	@callsuper();
	return;
    }

    @self->HTMLS_pressUpOrDown = 0;
    if(xPosition < rect.R_right - ARROW_WIDTH || 
       (yPosition > rect.R_top + ARROW_HEIGHT && yPosition < rect.R_bottom - ARROW_HEIGHT)) { 
	@callsuper();
    }
    else {
	if(yPosition < rect.R_top + ARROW_HEIGHT) {
	    /* up arrow */
	    if(@self->HTMLS_currentFirst) {
		@self->HTMLS_pressUpOrDown = 1;
		@send self::MSG_HTML_SELECT_SCROLL_UP(); 

		@self->HTMLS_timerHandle = TimerStart
		    ( TIMER_EVENT_CONTINUAL, oself, 10, 
		     MSG_HTML_SELECT_SCROLL_UP, 10, 
		     &(@self->HTMLS_timerId));
	    }
	} else {
	    if(@self->HTMLS_optionsNum - @self->HTMLS_currentFirst 
	       > @self->HTMLS_size) {
		@self->HTMLS_pressUpOrDown = 2;
		@send self::MSG_HTML_SELECT_SCROLL_DOWN(); 

		@self->HTMLS_timerHandle = TimerStart
		    (TIMER_EVENT_CONTINUAL, oself, 10, 
		     MSG_HTML_SELECT_SCROLL_DOWN, 10,
		     &(@self->HTMLS_timerId));
	    }
	}
    }

    @call self::MSG_VIS_GRAB_MOUSE();
    @call @visParent::MSG_VIS_TAKE_GADGET_EXCL(oself); 

    ThreadVSem(sem);

    retVal->flags = MRF_PROCESSED;
    return;
}	/* End of MSG_META_START_SELECT.	*/


/***********************************************************************
 *		MSG_META_END_SELECT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/23/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_META_END_SELECT
{
    Rectangle rect;
    
    if(@self->HTMLS_itemGroup) {/* this is a Selection Box */
	@callsuper();
	return;
    }

    @call self::MSG_VIS_GET_BOUNDS(&rect);

    @call self::MSG_VIS_RELEASE_MOUSE();
    @call @visParent::MSG_VIS_RELEASE_GADGET_EXCL(oself); 

    if(@self->HTMLS_timerHandle) {
	TimerStop(@self->HTMLS_timerHandle, @self->HTMLS_timerId);
	@self->HTMLS_timerHandle = 0;
	@self->HTMLS_timerId = 0;
    }

    if(@self->HTMLS_pressUpOrDown == 1) {
	@send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_top + (ARROW_HEIGHT + 1), 
		rect.R_right - 1,
		rect.R_top + 1, 
		rect.R_right - (ARROW_WIDTH + 1));
    } else if(@self->HTMLS_pressUpOrDown == 2) {
	@send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_bottom - 1, 
		rect.R_right - 1,
		rect.R_bottom - (ARROW_HEIGHT + 1), 
		rect.R_right - (ARROW_WIDTH + 1));
    }

    @self->HTMLS_pressUpOrDown = 0;
	
    retVal->flags = MRF_REPLAY;
    return;
}	/* End of MSG_META_END_SELECT.	*/


@method HTMLSelectClass, MSG_META_GAINED_FOCUS_EXCL
{
    @callsuper();

    if(@self->HTMLS_itemGroup) {
	@send @self->HTMLS_itemGroup::MSG_META_GRAB_TARGET_EXCL();
	@send @self->HTMLS_itemGroup::MSG_META_GRAB_FOCUS_EXCL();
    }
}


/***********************************************************************
 *		MSG_META_FUP_KBD_CHAR for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word character = cx,
 *			word flags = dx,
 *			word state = bp
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_META_FUP_KBD_CHAR
{
    if(@self->HTMLS_itemGroup) /* this is a Selection Box */
	return @callsuper();

    if( ! ((flags & CF_RELEASE)
	    || ((flags >> 8) & SS_LCTRL) 
	    || ((flags >> 8) & SS_RCTRL) )) {
	if(character == (VC_ISCTRL << 8 | VC_UP)) {
	    if(@self->HTMLS_currentFirst) {
		@send self::MSG_HTML_SELECT_SCROLL_UP();
		return TRUE;
	    }
	} else if(character == (VC_ISCTRL << 8 | VC_DOWN)) {
	    if( @self->HTMLS_optionsNum - @self->HTMLS_currentFirst 
		> @self->HTMLS_size) {
		@send self::MSG_HTML_SELECT_SCROLL_DOWN();
		return TRUE;
	    }
	}
    }
    return @callsuper();
}	/* End of MSG_META_FUP_KBD_CHAR.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/22/97   	Initial Revision
 *	sean		11/12/97	Use arrow bitmaps now.
 *					Fixes #71096.
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_VIS_DRAW
{
    Rectangle rect;
    Bitmap    *bmp;

    @call self::MSG_VIS_GET_BOUNDS(&rect);

    @callsuper();

    if(@self->HTMLS_itemGroup) return;

    /*
     *  Draw the bound.
     */
    GrSaveState(gstate);
    GrSetLineColor(gstate, CF_INDEX, C_DARK_GREY, 0, 0);
@ifdef PRODUCT_NIKE
    GrDrawRect(gstate, rect.R_left, rect.R_top,
		   rect.R_right-2, rect.R_bottom-2);
@else
    GrDrawRect(gstate, rect.R_left, rect.R_top,
		   rect.R_right-1, rect.R_bottom);
@endif
    GrRestoreState(gstate);

    if(@self->HTMLS_currentFirst) {
	if(@self->HTMLS_pressUpOrDown != 1) {
	    MemLock(OptrToHandle(@UpArrowBitmap));
	    bmp = LMemDeref(@UpArrowBitmap);
	    GrDrawBitmap(gstate, 
			 rect.R_right - (ARROW_WIDTH + 1), 
			 rect.R_top + 1, 
			 bmp, 0);
	    MemUnlock(OptrToHandle(@DownArrowBitmap));
	} else {
	    MemLock(OptrToHandle(@UpSelectedArrowBitmap));
	    bmp = LMemDeref(@UpSelectedArrowBitmap);
	    GrDrawBitmap(gstate,
			 rect.R_right - (ARROW_WIDTH + 1), 
			 rect.R_top + 1, 
			 bmp, 0);
	    MemUnlock(OptrToHandle(@UpSelectedArrowBitmap));
	}
    } 

    if( @self->HTMLS_optionsNum - @self->HTMLS_currentFirst 
		> @self->HTMLS_size) {
	if(@self->HTMLS_pressUpOrDown != 2) {
	    MemLock(OptrToHandle(@DownArrowBitmap));
	    bmp = LMemDeref(@DownArrowBitmap);
	    GrDrawBitmap(gstate, 
        		 rect.R_right - (ARROW_WIDTH + 1), 
			 rect.R_bottom -(ARROW_HEIGHT + 1), 
 			 bmp, 0);
	    MemUnlock(OptrToHandle(@DownArrowBitmap));

	} else {
	    MemLock(OptrToHandle(@DownSelectedArrowBitmap));
	    bmp = LMemDeref(@DownSelectedArrowBitmap);
	    GrDrawBitmap(gstate, 
        		 rect.R_right - (ARROW_WIDTH + 1), 
			 rect.R_bottom - (ARROW_HEIGHT + 1), 
 			 bmp, 0);
	    MemUnlock(OptrToHandle(@DownSelectedArrowBitmap));
	}
    }

    return;
}	/* End of MSG_VIS_DRAW.	*/


@method HTMLSelectClass, MSG_VIS_MARK_INVALID
{
  VisCompInstance *vself;
  
  vself = ObjDerefVis(oself);
  if (!(vself->VI_attrs & VA_REALIZED)) {
    /*
     *  Avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
     */
    @call self::MSG_VIS_OPEN(0);
  }

    return;
}	/* End of MSG_VIS_MARK_INVALID.	*/


/***********************************************************************
 *	MSG_HTML_SELECT_STORE_CONTENT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_STORE_CONTENT
{
  word br;
  @self->HTMLS_content = content;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTMLS_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTMLS_noBr = br;
  @self->HTMLS_pageRow = -1;

  return;
}	/* End of MSG_HTML_SELECT_STORE_CONTENT.	*/


/***********************************************************************
 *		MSG_HTML_SELECT_SET_FOCUS for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_SET_FOCUS
{
    if(!@self->HTMLS_itemGroup) {
	rect->RD_left -= 2;
	rect->RD_right += 1;
	rect->RD_top -= 2;
	rect->RD_bottom += 2;
    } else {
	rect->RD_right -= 1;
	rect->RD_bottom -= 1;
    }

    @self->HTMLS_focalBound = *rect;
    return;
}	/* End of MSG_HTML_SELECT_SET_FOCUS.	*/

@method HTMLSelectClass, MSG_HTML_SELECT_CLEAR_FOCUS
{
  @self->HTMLS_focalBound.RD_left = @self->HTMLS_focalBound.RD_right = 0;
  return;
}	/* End of MSG_HTML_SELECT_SET_FOCUS.	*/



/***********************************************************************
 *		MSG_HTML_SELECT_SUBMIT for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    HTListHandle query
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_SELECT_SUBMIT
{
    char *cptr, *name;
    word i;
    OptionStruct *option;
    HTMemHandle htmh;
    MemHandle mem;
    word selected = -1;

    if(!@self->HTMLS_name) return;

    if(@self->HTMLS_itemGroup) 
	selected = @call @self->HTMLS_itemGroup::MSG_GEN_ITEM_GROUP_GET_SELECTION();

    name = HTMemLock(@self->HTMLS_name);

    for(i=0; i<@self->HTMLS_optionsNum; i++) {
	option = HTListLockItem(@self->HTMLS_optionsList, i, &mem);
	if(!@self->HTMLS_itemGroup && option->OS_selected ||
	   @self->HTMLS_itemGroup && selected == i) {
	    if(option->OS_value) 
		cptr = HTMemLock(option->OS_value);
	    else 
		cptr = HTMemLock(option->OS_text);

	    htmh = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, name);
	    HTListAppend(query, &htmh, sizeof(HTMemHandle));
	    htmh = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, cptr);
	    HTListAppend(query, &htmh, sizeof(HTMemHandle));

	    if(option->OS_value)
		HTMemUnlock(option->OS_value);
	    else 
		HTMemUnlock(option->OS_text);
	}
	HTListUnlock(mem);
    }

    HTMemUnlock(@self->HTMLS_name);

  return;
}	/* End of MSG_HTML_SELECT_SUBMIT.	*/



/***********************************************************************
 *		MSG_HTML_FORM_RESET for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_HTML_FORM_RESET
{
    word i;
    OptionStruct *option;
    MemHandle mem;
    Rectangle rect;

    if(!@self->HTMLS_optionsList) return;

    if(@self->HTMLS_itemGroup) {/* Selection Box */
	@call @self->HTMLS_itemGroup::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(0);

	for(i=0; i<@self->HTMLS_optionsNum; i++) {
	    option = HTListLockItem(@self->HTMLS_optionsList, i, &mem);
	    if(option->OS_default) {
		@call @self->HTMLS_itemGroup::
		    MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(i, 0);
		HTListUnlock(mem);
		break;
	    }
	    HTListUnlock(mem);
	}
	if (i == @self->HTMLS_optionsNum)
	    /* no default selected option, so reset to the first object */
	    @call @self->HTMLS_itemGroup::
		MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0, 0);
    } else {
	for(i=0; i<@self->HTMLS_optionsNum; i++) {
	    option = HTListLockItem(@self->HTMLS_optionsList, i, &mem);
	    option->OS_selected = option->OS_default;
	    HTListUnlock(mem);
	}

	@self->HTMLS_currentFirst = 0;
	@send self::MSG_HTML_SELECT_SET_ALL_MONIKER();

	@call self::MSG_VIS_GET_BOUNDS(&rect);
	/* 
	 * Redraw the arrows
	 */
	@send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_top + (ARROW_HEIGHT + 1), 
		rect.R_right - 1,
		rect.R_top + 1, 
		rect.R_right - (ARROW_WIDTH + 1));

	@send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_bottom - 1, 
		rect.R_right - 1,
		rect.R_bottom - (ARROW_HEIGHT + 1), 
		rect.R_right - (ARROW_WIDTH + 1));
    }
    return;
}	/* End of MSG_HTML_FORM_RESET.	*/


/***********************************************************************
 *		MSG_GEN_DESTROY for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_GEN_DESTROY
{
    word i;
    OptionStruct *option;
    MemHandle mem;

    if(@self->HTMLS_optionsList) {
	for(i=0; i<@self->HTMLS_optionsNum; i++) {
	    option = HTListLockItem(@self->HTMLS_optionsList, i, &mem);
	    if(option->OS_value) HTMemFree(option->OS_value);
	    if(option->OS_text) HTMemFree(option->OS_text);
	    HTListUnlock(mem);
	}
	HTListDeleteAllItems(@self->HTMLS_optionsList);
    } 

    if(@self->HTMLS_itemList) {
	HTListDeleteAllItems(@self->HTMLS_itemList);
    } 

    if (@self->HTMLS_name)
	HTMemFree(@self->HTMLS_name);
    
    if (@self->HTMLS_timerHandle)
	TimerStop(@self->HTMLS_timerHandle, @self->HTMLS_timerId);

    @callsuper();
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * All these stuff is allocated using HTListNewWID, HTMemAllocWID,
     * etc. Hence will be destroyed using HTListDeleteAllWID and 
     * HTMemFreeAllWID.
     */
    /*
     * word i;
     * OptionStruct *option;
     * MemHandle mem;
     *
     * if(@self->HTMLS_optionsList) {
     *   for(i=0; i<@self->HTMLS_optionsNum; i++) {
     *	    option = HTListLockItem(@self->HTMLS_optionsList, i, &mem);
     *	    if(option->OS_value) HTMemFree(option->OS_value);
     *	    if(option->OS_text) HTMemFree(option->OS_text);
     *	    HTListUnlock(mem);
     *	}
     *	HTListDeleteAllItems(@self->HTMLS_optionsList);
     * } 
     *
     * if(@self->HTMLS_itemList) {
     *   HTListDeleteAllItems(@self->HTMLS_itemList);
     * } 
     * 
     * if (@self->HTMLS_name)
     *   LMemFreeHandles(HandleOf(oself), @self->HTMLS_name);
     *
     */

    if (@self->HTMLS_timerHandle)
	TimerStop(@self->HTMLS_timerHandle, @self->HTMLS_timerId);

    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_SPEC_BUILD_BRANCH
{
  VisCompInstance * vself; 

  @callsuper();

  @call self::MSG_VIS_RECALC_SIZE(RSA_CHOOSE_OWN_SIZE,
				  RSA_CHOOSE_OWN_SIZE);

  if (@self->HTMLS_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTMLS_guessSize),
				 DWORD_HEIGHT(@self->HTMLS_guessSize));
  /*
   *  Clear the bits.  We don't rely on system to do updates anymore.
   */
  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID);

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *	MSG_UI_CALC_SIZE_POSITION for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  /*
   *  Get an estimate position of the object
   */
  pos = UpdateItsPotentialPosition(oself,@self->HTMLS_content,&row,&size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTMLS_xPos = pos;
  @self->HTMLS_pageRow = row;
  @self->HTMLS_guessSize = size;
  @call self::MSG_VIS_SET_ATTRS(0, VA_DRAWABLE, VUM_DELAYED_VIA_APP_QUEUE);
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/12/97   	Initial Revision
 *	sean		11/12/97	Added TRUNK-only code.
 *					Helps fix #71096.
 *	
 ***********************************************************************/
@method HTMLSelectClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;
  word oheight=0;
  word owidth=0;  
  size = @callsuper();

  if (!size) {

      if(!@self->HTMLS_itemGroup) { 

    /*
     *  Vis tree is not build up yet, so the system doesn't know how
     *  big this vis composite object should be.  Well, I manually pass
     *  MSG_VIS_RECALC_SIZE to its children to calculate and store its
     *  size.  When they're SPEC_BUILD, then I set the stored size.
     */
    @send @genChildren::MSG_VIS_RECALC_SIZE(RSA_CHOOSE_OWN_SIZE, 
					    RSA_CHOOSE_OWN_SIZE);
    /*
     *  Hey, I can make an educated guess about the size!
     *  14 is the left+right margin, same for top+bottom margin.
     *  17 is the default height of the single-line selection gadge in
     *  Penelope.
     */
    oheight = @self->HTMLS_size * 17 + 14;
    owidth = @self->HTMLS_len + 14;

    /* If there should be arrows, let's make room for them */
    /* Helps fix #71096.  Sean 11/12/97.		   */
@ifdef	TRUNK
    if(@self->HTMLS_size < @self->HTMLS_optionsNum)        
    {
	owidth += (ARROW_WIDTH - 2);
    }
@endif
    return MAKE_SIZE_DWORD(owidth, oheight);

    } else {
	size = MAKE_SIZE_DWORD(@self->HTMLS_len, 30);
    }
  }
  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTMLSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTMLSelectClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTMLS_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTMLS_xPos;
  }
  else {
    lineWidth = @call @self->HTMLS_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTMLS_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTMLS_xPos;
    else if (@self->HTMLS_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTMLS_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTMLS_xPos);
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
	(@self->HTMLS_content, @self->HTMLS_pageRow, oself);

  @call self::MSG_VIS_SET_ATTRS(VA_DRAWABLE, 0, VUM_DELAYED_VIA_APP_QUEUE);
  @callsuper();

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTMLS_focalBound.RD_left != 0 &&
      @self->HTMLS_focalBound.RD_right != 0 &&
      @self->HTMLS_focalBound.RD_top != @self->HTMLS_focalBound.RD_bottom){
    /*
     *  The object currently has a focus.  Update its new position.
     */
    Rectangle rect;

    @call self::MSG_VIS_GET_BOUNDS(&rect);
    if(!@self->HTMLS_itemGroup) {
	rect.R_left -= 2;
	rect.R_right += 1;
	rect.R_top -= 2;
	rect.R_bottom += 2;
    } else {
	rect.R_right -= 1;
	rect.R_bottom -= 1;
    }
    @self->HTMLS_focalBound.RD_left = rect.R_left;
    @self->HTMLS_focalBound.RD_right = rect.R_right;
    @self->HTMLS_focalBound.RD_top = rect.R_top;
    @self->HTMLS_focalBound.RD_bottom = rect.R_bottom;
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_UPDATE_FOCUS
	(@self->HTMLS_focalBound);
  }
  
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



