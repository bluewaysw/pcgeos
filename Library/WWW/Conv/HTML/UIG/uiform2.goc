/***********************************************************************
 *		MSG_TEXT_AREA_APPEND_TEXT_PTR for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the initial text.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_APPEND_TEXT_PTR
{
    char *cptr;
    int length = len;

    if(!length) length = strlen(text);
    cptr = HTMemAllocAndLockWID(uiMgr.UIM_currentDoc->HTUI_memID, &(@self->TAI_text), length+1);

    strncpy(cptr, text, length);

    *(cptr + length) = 0;
    
    HTMemUnlock(@self->TAI_text);

}	/* End of MSG_TEXT_AREA_APPEND_TEXT_PTR.	*/


/***********************************************************************
 *		MSG_TEXT_AREA_GET_TEXT_HANDLE for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	11/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_GET_TEXT_HANDLE
{
    HTMemHandle ret = 0;
    char *ptr;
    word len;

    len = @call @self->TAI_textObj::MSG_VIS_TEXT_GET_TEXT_SIZE();

    ptr = HTMemAllocAndLockWID(uiMgr.UIM_currentDoc->HTUI_memID, &ret, len+1);
    @call @self->TAI_textObj::MSG_VIS_TEXT_GET_ALL_PTR(ptr);
    HTMemUnlock(ret);

    return ret;
}	/* End of MSG_TEXT_AREA_GET_TEXT_HANDLE.	*/


/***********************************************************************
 *		MSG_HTML_FORM_RESET for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    When user press reset button, reset the text object
 *                  to use the initial text.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_HTML_FORM_RESET
{
    char *ptr;

    @call @self->TAI_textObj::MSG_TAT_RESET();

    if(@self->TAI_text) {
	ptr = HTMemLock(@self->TAI_text);
	@call @self->TAI_textObj::MSG_VIS_TEXT_REPLACE_ALL_PTR(ptr, 0);
	HTMemUnlock(@self->TAI_text);
    } else 
	@call @self->TAI_textObj::MSG_VIS_TEXT_REPLACE_ALL_PTR("", 0);

}	/* End of MSG_HTML_FORM_RESET.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Since the GenInteration doesn't take fixed size,
 *                  so we return our own size to overwrite the system
 *                  size for our TextArea.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_VIS_RECALC_SIZE
{
  VisCompInstance * vself;
  SizeAsDWord size;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    /* 
     * use our own size 
     */
    size = MAKE_SIZE_DWORD(@self->TAI_width, @self->TAI_length);

  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/

/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  SizeAsDWord size;
  char *ptr;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

    if(@self->TAI_align == J_LEFT) {
	xOrigin = DWORD_X(xy) + @self->TAI_xPos;
    } else {
	lineWidth = @call @self->TAI_content::
	    MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->TAI_pageRow);
	pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
	if (lineWidth > pWidth) {
	    xOrigin =  DWORD_X(xy) + @self->TAI_xPos;
	}
	else if(@self->TAI_align == J_RIGHT) {
	    xOrigin = DWORD_X(xy) + 
		(pWidth - lineWidth + @self->TAI_xPos);
	} else {
	    xOrigin = DWORD_X(xy) + 
		(((pWidth - lineWidth)/2) + @self->TAI_xPos);
	}
    }
	
    yOrigin = DWORD_Y(xy) + 
	GetItsPotentialHeight(@self->TAI_content, @self->TAI_pageRow, oself)
	- 1;

  @call self::MSG_VIS_SET_ATTRS(VA_DRAWABLE, 0, VUM_DELAYED_VIA_APP_QUEUE);
  @callsuper();

  if(!@self->TAI_textObj) {
      /* 
       * create the text object 
       */
      @self->TAI_textObj = UICreateObj((ClassStruct *)&TextAreaTextClass);

      /*
       *  Let TAB to switch to different object, instead of inserting a tab.
       */
      @call @self->TAI_textObj::MSG_GEN_TEXT_SET_ATTRS
	  (GTA_USE_TAB_FOR_NAVIGATION, 0);
      @call @self->TAI_textObj::MSG_GEN_SET_ATTRS
	  (GA_TARGETABLE, 0);
      @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA
	  (HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);

      @call @self->TAI_textObj::MSG_TAT_SET_ROWS(@self->TAI_rows);
      @call @self->TAI_textObj::MSG_TAT_SET_COLUMNS(@self->TAI_columns);

      size = MAKE_SIZE_DWORD(@self->TAI_width, @self->TAI_length);
      @call @self->TAI_textObj::MSG_TAT_SET_SIZE(DWORD_WIDTH(size), 
						 DWORD_HEIGHT(size)-2);

      @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA
	  (HINT_TEXT_WHITE_WASH_COLOR, 0, NULL);

@ifdef TRUNK
    @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA(
			HINT_DRAW_STYLE_FLAT, 0, NULL);
@endif

      @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA
	  (HINT_TEXT_NO_FRAME, 0, NULL);

      @call @self->TAI_textObj::MSG_VIS_TEXT_SET_MAX_LENGTH(MAX_TEXT_BLOCK_SIZE);
      
      if(@self->TAI_text) {
	  ptr = HTMemLock(@self->TAI_text);
	  @call @self->TAI_textObj::MSG_VIS_TEXT_APPEND_PTR(ptr, 0);
	  HTMemUnlock(@self->TAI_text);
      } else 
	  @call @self->TAI_textObj::MSG_VIS_TEXT_APPEND_PTR("", 0);

      @call self::MSG_GEN_ADD_CHILD(@self->TAI_textObj, CCF_MARK_DIRTY);

      /* 
       * I cannot switch the below two lines. Why?
       */
      @call @self->TAI_textObj::MSG_GEN_SET_USABLE(VUM_NOW);
      @call @self->TAI_textObj::MSG_TAT_SET_POSITION(xOrigin, yOrigin);
  }

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


/***********************************************************************
 *		MSG_UI_GET_ROW_POSITION for TextAreaClass
 ***********************************************************************
