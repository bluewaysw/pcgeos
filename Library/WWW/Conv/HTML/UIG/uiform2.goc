/***********************************************************************
 *	UIGen_START_SELECT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a HTGenSelect object and process the 
 *		    attribute list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *      MZHU    12/97           Second Revision - removed HTGenForm class
 *                                combined HTGenSelectClass and 
 *                                HTGenMultiLineSelectClass
 *
 ***********************************************************************/
ErrorCode UIGen_START_SELECT_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr obj, content;
  HTMLForm *form;
  MemHandle mh, mh2;
  word itemNum;
  HTMLFormItem item;

  /*
   * If this is out of a form, ignore it.
   */
EC(  EC_ERROR_IF(uiCurrentFormId < 0, UIG_UI_TREE_OPERATION_FAILS);         )

  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
  */
  if ((uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass) ||
      (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass) ) {

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(uiMgr.UIM_currentDoc->HTUI_target.obj);
    content = uiMgr.UIM_currentDoc->HTUI_target.obj;

  } else if (uiMgr.UIM_currentDoc->HTUI_target.obj) {

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	(uiMgr.UIM_currentDoc->HTUI_target.obj);

    content = UIGen_GET_CONTENT_Int();

  }  else
    content = uiMgr.UIM_currentDoc->HTUI_pmContent;

  obj = UICreateObj((ClassStruct *)&HTMLSelectClass);
  @call obj::MSG_HTML_SELECT_STORE_CONTENT(content);

  uiMgr.UIM_currentDoc->HTUI_target.obj = obj;
  uiMgr.UIM_currentDoc->HTUI_target.class = (ClassStruct *)&HTMLSelectClass;

  /*
   * Add this object to the current form list.
   */
  item.HTFI_object = obj;
  item.HTFI_type = FE_SELECTION;
  item.HTFI_nameId = -1;
  item.HTFI_value = 0;
  form = HTListLockItem(uiMgr.UIM_currentDoc->HTUI_formList, uiCurrentFormId, &mh);
  itemNum = HTListAppend(form->HTF_itemList, &item, sizeof(HTMLFormItem));
  HTListUnlock(mh);
  
  @call obj::MSG_HTML_SELECT_PROCESS_ATTRIBUTE(block, entity);

  /*
   *  Add the object to the list of focusable objects
   */
  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(obj);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_SELECT_Int.	*/


/***********************************************************************
 *		UIGen_END_SELECT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the presentation manager that the HTGenSelect
 *		    object is done.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *      MZHU    12/97           Second Revision - removed HTGenForm class
 *                                combined HTGenSelectClass and 
 *                                HTGenMultiLineSelectClass
 *
 ***********************************************************************/
ErrorCode UIGen_END_SELECT_Int()
{
  optr select;
  ClassStruct *class;

EC( EC_ERROR_IF(uiMgr.UIM_currentDoc->HTUI_target.class !=\
   (ClassStruct *)&HTMLSelectClass, UIG_UI_TREE_OPERATION_FAILS);          )

    @send uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_HTML_SELECT_COMPLETE_SELECT_CONSTRUCT();

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(uiMgr.UIM_currentDoc->HTUI_target.obj);

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&uiMgr.UIM_currentDoc->HTUI_target.obj, &uiMgr.UIM_currentDoc->HTUI_target.class);

    if(uiMgr.UIM_currentDoc->HTUI_target.obj == uiMgr.UIM_currentDoc->HTUI_pmanager) {
	uiMgr.UIM_currentDoc->HTUI_target.obj = 0;
	uiMgr.UIM_currentDoc->HTUI_target.class = 0;
    }

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_SELECT_Int.	*/




/***********************************************************************
 *	UIGen_CREATE_OPTION_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create HTGenOption object and process the attribute
 *		    list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_OPTION_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr select;
  int id;
  char *value = NULL;
  int	index = 0;
  Boolean selected = FALSE;
  optr obj;

EC(  EC_ERROR_IF(uiCurrentFormId < 0, UIG_UI_TREE_OPERATION_FAILS);         )
EC( EC_ERROR_IF(uiMgr.UIM_currentDoc->HTUI_target.class !=\
   (ClassStruct *)&HTMLSelectClass, UIG_UI_TREE_OPERATION_FAILS);          )

  if (uiMgr.UIM_currentDoc->HTUI_target.obj) {

      for(index = 0; entity[index].SGMLE_token; index++) {
          switch(entity[index].SGMLE_token) {
          case HTML_ATTR_VALUE:
              if (entity[index].SGMLE_value) 
                  value = (char *)LMemDerefHandles(block, 
				entity[index].SGMLE_value);
              break;
          case HTML_ATTR_SELECTED:
              selected = TRUE;
              break;
          }
      }

      @call (uiMgr.UIM_currentDoc->HTUI_target.obj)::
	  MSG_HTML_SELECT_ADD_OPTION_VALUE(value, selected);

  }

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_OPTION_Int.	*/


#ifdef __HIGHC__
#pragma Code("HTGENINPUT");
#endif
#ifdef __BORLANDC__
#pragma codeseg HTGENINPUT
#endif


/***********************************************************************
 *		UIGen_CREATE_INPUT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Define user input field as part of the contents
 *		    in a FORM element.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: TYPE = TEXT | PASSWORD | CHECKBOX | 
 *				       RADIO | SUBMIT | RESET | HIDDEN |
 *				       IMAGE.
 *				NAME, VALUE, SRC, CHECKED, SIZE, 
 *				MAXLENGTH.
 *
 * INPUT elements are not containers and so the end tag is forbidden. 
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *	sean	7/25/97		Switch order or when set single-line
 *				text attribute.  Fixes 68542.
 *      MZHU    12/97           Second Revision - removed HTGenFormClass,
 *                                HTGenHiddenClass
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_INPUT_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value, *cptr = NULL;
  int index, maxLen = 0, size = 13;	/* default SIZE attribute value */
  Boolean checked = FALSE;
  FormElementType Itype = FE_TEXT;		/* default input type */
  CompSizeHintArgs sizeArgs;
  optr content=0, dummy=0, gitem;
  ChunkHandle tmpChunk;
  HTMemHandle tmpOptr=NULL, nameOptr=NULL, valueOptr=NULL, srcOptr=NULL;
  HTMemHandle *htmh;
  WWFixed number;
  VisMonikerWithText *moniker;
  ClassStruct *class;
@if @SHORT_LONG_TOUCH
  ShortLongTouchParams touch;
@endif /* SHORT_LONG_TOUCH */

  MemHandle mh, mh2;
  HTMLForm form;
  HTMLFormItem item;
  int  i, count;

EC(  EC_ERROR_IF(uiCurrentFormId < 0, UIG_UI_TREE_OPERATION_FAILS);         )

@if @SHORT_LONG_TOUCH
  touch.SLTP_shortMessage = MSG_META_UIG_SHORT_TOUCH_NOTIFY;
  touch.SLTP_longMessage = MSG_META_UIG_LONG_TOUCH_NOTIFY;
  touch.SLTP_shortDestination = touch.SLTP_longDestination
      = TO_SELF;
@endif /* SHORT_LONG_TOUCH */

  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
   */
  if ((uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass) ||
      (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass) ) {

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(uiMgr.UIM_currentDoc->HTUI_target.obj);
    content = uiMgr.UIM_currentDoc->HTUI_target.obj;

  } else if (uiMgr.UIM_currentDoc->HTUI_target.obj) {

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	(uiMgr.UIM_currentDoc->HTUI_target.obj);

    content = UIGen_GET_CONTENT_Int();

  }  else
    content = uiMgr.UIM_currentDoc->HTUI_pmContent;

  /*
   * Add this object to the current form list.
   */
  HTListGetItem(uiMgr.UIM_currentDoc->HTUI_formList, 
			uiCurrentFormId, &form, sizeof(HTMLForm));

  item.HTFI_nameId = -1;

  /*
   *  This FOR loop processes the attribute list, collecting attribute
   *  values that will be needed later on.
   */

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_token == HTML_ATTR_CHECKED)
	checked = TRUE;
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
	count = HTListGetCount(form.HTF_nameList);
	for(i=0; i<count; i++) {
	    htmh = HTListLockItem(form.HTF_nameList, i, &mh2);
	    if(!strcasecmp(HTMemLock(*htmh), value)) {
		item.HTFI_nameId = i;
		HTMemUnlock(*htmh);
		HTListUnlock(mh2);
		break;
	    }
	    HTMemUnlock(*htmh);
	    HTListUnlock(mh2);
	}
	if(item.HTFI_nameId == -1)
	    nameOptr = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, value);

      break;
    case HTML_ATTR_VALUE:
      valueOptr = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, value);
      break;
    case HTML_ATTR_SRC:
      srcOptr = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, value);
      break;
    case HTML_ATTR_CHECKED:
      checked = TRUE;
      break;
    case HTML_ATTR_SIZE:
      size = atoi(value);
      if (size > 70)  size = 70;
      else if (size <= 2)  size = 3;
      break;
    case HTML_ATTR_MAXLENGTH:
      maxLen = atoi(value);
      if(maxLen > DEFAULT_TEXT_MAX_LENGTH) maxLen = DEFAULT_TEXT_MAX_LENGTH;
      break;
    case HTML_ATTR_TYPE:
      if (strcasestr(value, "text"))
	Itype = FE_TEXT;
      else if (strcasestr(value, "checkbox"))
	Itype = FE_CHECKBOX;
      else if (strcasestr(value, "radio"))
	Itype = FE_RADIO;
      else if (strcasestr(value, "submit"))
	Itype = FE_SUBMIT;
      else if (strcasestr(value, "reset"))
	Itype = FE_RESET;
      else if (strcasestr(value, "hidden"))
	Itype = FE_HIDDEN;
      else if (strcasestr(value, "image"))
	Itype = FE_IMAGE;
      else if (strcasestr(value, "password"))
	Itype = FE_PASSWORD;
      else {
	  /* the reset we don't support */
	  if(nameOptr) HTMemFree(nameOptr);
	  if(srcOptr) HTMemFree(nameOptr);
	  if(valueOptr) HTMemFree(nameOptr);

	  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	      (&uiMgr.UIM_currentDoc->HTUI_target.obj, &uiMgr.UIM_currentDoc->HTUI_target.class);

	  if(uiMgr.UIM_currentDoc->HTUI_target.obj == uiMgr.UIM_currentDoc->HTUI_pmanager) {
	      uiMgr.UIM_currentDoc->HTUI_target.obj = 0;
	      uiMgr.UIM_currentDoc->HTUI_target.class = 0;
	  }
	  return UI_GEN_ERROR;
      }
    }
  }

  if(item.HTFI_nameId == -1 && nameOptr) {
      item.HTFI_nameId = HTListAppend
	  (form.HTF_nameList, &nameOptr, sizeof(optr));
  }
  item.HTFI_type = Itype;
  item.HTFI_value = valueOptr;
  item.HTFI_checked = checked;

    switch (Itype) {
    case FE_HIDDEN:

	item.HTFI_object = 0;
	HTListAppend(form.HTF_itemList, &item, sizeof(HTMLFormItem));

	@call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS \
	    (&(uiMgr.UIM_currentDoc->HTUI_target.obj), &(uiMgr.UIM_currentDoc->HTUI_target.class));
	if(uiMgr.UIM_currentDoc->HTUI_target.obj == uiMgr.UIM_currentDoc->HTUI_pmanager) {
	    uiMgr.UIM_currentDoc->HTUI_target.obj = 0;
	    uiMgr.UIM_currentDoc->HTUI_target.class = 0;
	}

	return UI_GEN_NO_ERROR;

    case FE_TEXT:
    case FE_PASSWORD:
	/*
	 * Create a text input feild(text object) for user input.
	 */
	dummy = UICreateObj((ClassStruct *)&HTGenFormTextClass);
	/*
	 * Single-line text attribute must be set first.  Fixes 68542.
         * Sean 7/25/97.
	 */
	@call dummy::MSG_GEN_TEXT_SET_ATTRS(GTA_SINGLE_LINE_TEXT, 0); 

	@call dummy::MSG_GEN_FORM_TEXT_INITIALIZE(content);
	/*
	 * Set width of the object.
	 */
	sizeArgs.CSHA_width = SST_AVG_CHAR_WIDTHS | size;
	sizeArgs.CSHA_height = 0;
	sizeArgs.CSHA_count = 1;
	EC_ERROR_IF(size < 0, UIG_ERROR_NEGATIVE_WIDTH);
	@call dummy::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
	/*
	 *  Set MAXLENGTH if it is specified.
	 */
	if(maxLen)
	    @call dummy::MSG_VIS_TEXT_SET_MAX_LENGTH(maxLen);
	else
	    @call dummy::MSG_VIS_TEXT_SET_MAX_LENGTH(DEFAULT_TEXT_MAX_LENGTH);

	/*
	 *  If it's a password type, set the BISON font size 13 so that
	 *  '*' is displayed for every char input.
	 */
	if (Itype == FE_PASSWORD) {
	  @send dummy::MSG_VIS_TEXT_SET_FONT_ID(
				FID_BISON,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);	
	  number.WWF_int = 13;
	  number.WWF_frac = 0;
	  @call dummy::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
	}

	break;

    case FE_CHECKBOX:
    case FE_RADIO:
      /*
       *  Create a Input object(GenItemGroup).
       */
      dummy = UICreateObj((ClassStruct *)&HTGenInputClass);
      /*
       *  Initialize the Input object.
       */
      @call dummy::MSG_GEN_INPUT_STORE_DATA
	  (uiCurrentFormId, item.HTFI_nameId, Itype, content);
      /*
       * Create a genItem object 
       */
      gitem = UICreateObj((ClassStruct *)&GenItemClass);
      @call gitem::MSG_GEN_ITEM_SET_IDENTIFIER(0);
      @call dummy::MSG_GEN_ADD_CHILD(gitem, CCF_MARK_DIRTY);

      @send gitem::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
      @call dummy::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(FALSE);
      if(checked) 
	  @send, forceQueue dummy::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0, 0);

      break;

    case FE_RESET:
    case FE_SUBMIT:
	/*
	 * Create a text object for user input.
	 */
	dummy = UICreateObj((ClassStruct *)&HTGenFormTriggerClass);
	@call dummy::MSG_GEN_FORM_TRIGGER_INITIALIZE
	    (uiCurrentFormId, item.HTFI_nameId, Itype, content);
@if @SHORT_LONG_TOUCH
	@call dummy::MSG_META_ADD_VAR_DATA(
	    HINT_SHORT_LONG_TOUCH | VDF_SAVE_TO_STATE,
	    sizeof(ShortLongTouchParams),
	    &touch);
@endif /* SHORT_LONG_TOUCH */
	/*
	 *  Set up the the vis Moniker on the trigger.
	 */
	if (valueOptr) {
	  /*
	   *  Create a visMoniker, and copy the text moniker.
	   */
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		(HTMemLock(valueOptr), VUM_NOW);
	  HTMemUnlock(valueOptr);
	} else if (Itype == FE_SUBMIT)
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		("Submit", VUM_DELAYED_VIA_UI_QUEUE);
	else
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		("Reset", VUM_DELAYED_VIA_APP_QUEUE);

        break;

    case FE_IMAGE:
	dummy = UICreateObj((ClassStruct *)&HTGenImageClass);
	@call dummy::MSG_GEN_IMAGE_REQUEST(srcOptr);
	@call dummy::MSG_GEN_IMAGE_MARK_INPUT
	    (uiCurrentFormId, item.HTFI_nameId, nameOptr, content);
@if @SHORT_LONG_TOUCH
	@call dummy::MSG_META_ADD_VAR_DATA(
	    HINT_SHORT_LONG_TOUCH | VDF_SAVE_TO_STATE,
	    sizeof(ShortLongTouchParams),
	    &touch);
@endif /* SHORT_LONG_TOUCH */
	break;
  }

EC(  EC_ERROR_IF(!dummy, UIG_UI_TREE_OPERATION_FAILS);                       )

    item.HTFI_object = dummy;

    HTListAppend(form.HTF_itemList, &item, sizeof(HTMLFormItem));

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS \
	  (&(uiMgr.UIM_currentDoc->HTUI_target.obj), &(uiMgr.UIM_currentDoc->HTUI_target.class));
    if(uiMgr.UIM_currentDoc->HTUI_target.obj == uiMgr.UIM_currentDoc->HTUI_pmanager) {
	uiMgr.UIM_currentDoc->HTUI_target.obj = 0;
	uiMgr.UIM_currentDoc->HTUI_target.class = 0;
    }
    
   if ((Itype == FE_TEXT || Itype == FE_PASSWORD) && valueOptr != NULL) {
       cptr = (char *)HTMemLock(valueOptr);
       @call dummy::MSG_VIS_TEXT_APPEND_PTR(cptr, 0);
       HTMemUnlock(valueOptr);
   }

    /*
     *  Add the Reset/Submit object to the list of focusable objects
     */
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);

    return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_INPUT_Int.	*/



#ifdef __HIGHC__
#pragma Code("HTGENTEXTAREA");
#endif
#ifdef __BORLANDC__
#pragma codeseg HTGENTEXTAREA
#endif



/***********************************************************************
 *	UIGen_START_TEXTAREA_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Creates a multiple-line text entry control in
 *		    which the user can enter and edit text. 
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: COLS, NAME, ROWS
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_TEXTAREA_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr obj, content;
  HTMLForm form;
  HTMLFormItem item;
  int index, itemNum;
  char *value;
  HTMemHandle nameHandle;
  int cols = 0, rows = 0;

EC(  EC_ERROR_IF(uiCurrentFormId < 0, UIG_UI_TREE_OPERATION_FAILS);          )

  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
   */
  if ((uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass) ||
      (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass) ) {

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(uiMgr.UIM_currentDoc->HTUI_target.obj);
    content = uiMgr.UIM_currentDoc->HTUI_target.obj;

  } else if (uiMgr.UIM_currentDoc->HTUI_target.obj) {

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	(uiMgr.UIM_currentDoc->HTUI_target.obj);

    content = UIGen_GET_CONTENT_Int();

  }  else
    content = uiMgr.UIM_currentDoc->HTUI_pmContent;

  /*
   * Now create a select object and store it in target.obj.  
   * Then process the passed attribute list.
   */
  obj = UICreateObj((ClassStruct *)&TextAreaClass);
  
  uiMgr.UIM_currentDoc->HTUI_target.obj = obj;
  uiMgr.UIM_currentDoc->HTUI_target.class = (ClassStruct *)&TextAreaClass; 

  /*
   * Add this object to the current form list.
   */
  HTListGetItem(uiMgr.UIM_currentDoc->HTUI_formList, 
			uiCurrentFormId, &form, sizeof(HTMLForm));
  item.HTFI_object = obj;
  item.HTFI_type = FE_TEXTAREA;
  item.HTFI_nameId = -1;
  item.HTFI_value = 0;

  /* 
   * Processs the attributes.
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      nameHandle = HTStrAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, value);
      item.HTFI_nameId = HTListAppend(form.HTF_nameList, &nameHandle, sizeof(optr));
      break;
    case HTML_ATTR_COLS:
      cols = atoi(value);
      break;
    case HTML_ATTR_ROWS:
      rows = atoi(value);
      break;
    }
  }

  @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_TEXT_AREA_INITIAL
	(cols, rows, content);
  /*
   *  Add the text area object to the list of focusable objects
   */
  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(obj);

  itemNum = HTListAppend(form.HTF_itemList, &item, sizeof(HTMLFormItem));

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_TEXTAREA_Int.	*/



/***********************************************************************
 *	UIGen_END_TEXTAREA_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Finish up the <TEXTAREA> object.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_TEXTAREA_Int()
{
  HTMemHandle tmpOptr;
  int	len;
  char	*cptr;
  optr  obj;

EC(    EC_ERROR_IF(uiMgr.UIM_currentDoc->HTUI_target.class != \
	(ClassStruct *)&TextAreaClass, UIG_UI_TREE_OPERATION_FAILS);   )

  /* 
   *  If there is some object in target.obj (It must be a GenFormText
   *  object), now we can mark it done.  Thus, pass the object to the 
   *  presentation manager for rendering.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.obj) {

    obj = uiMgr.UIM_currentDoc->HTUI_target.obj;

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(uiMgr.UIM_currentDoc->HTUI_target.obj);

    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&uiMgr.UIM_currentDoc->HTUI_target.obj, &uiMgr.UIM_currentDoc->HTUI_target.class);

    if(uiMgr.UIM_currentDoc->HTUI_target.obj == uiMgr.UIM_currentDoc->HTUI_pmanager) {
	uiMgr.UIM_currentDoc->HTUI_target.obj = 0;
	uiMgr.UIM_currentDoc->HTUI_target.class = 0;
    }

    @call obj::MSG_TEXT_AREA_FINISH();
    
    return UI_GEN_NO_ERROR;
  }
  else
    return UI_GEN_ERROR;
}	/* End of UIGen_END_TEXTAREA_Int.	*/


/***********************************************************************
  Code for TextAreaClass and TextAreaTextClass
***********************************************************************/
@classdecl	TextAreaClass; 
@classdecl	TextAreaTextClass; 

/* These two constants copied from Notepd */
/* max size the text object block is allowed to reach - no more text 	*/
/* will be inserted after it reaches this size 	    	    	    	*/ 
#define MAX_TEXT_BLOCK_SIZE 	    0x6000

/* max height, in pixels, a text object is allowed to reach - no more 	*/
/* text will be inserted after it reaches this size 	    	    	*/
#define MAX_TEXT_OBJECT_HEIGHT 	    0x1000

/***********************************************************************
 *		MSG_TEXT_AREA_INITIAL for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word rows, cols, optr content
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	11/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_INITIAL
{
  word br;

  @self->TAI_content = content;
  @self->TAI_pageRow = -1;

  if (cols > 50)  cols = 50;
  if (cols <= 0)  cols = 140/8;     /* get back to default */

  if (rows < 4) rows = 4;
  if (rows > 8) rows = 8;

  @self->TAI_rows = rows;
  @self->TAI_columns = cols;

  @self->TAI_width = cols * 8;  /* char width */
  @self->TAI_length = rows * 17 + 2; /* line of text */

  /*
   *  Make the object to be able to grab focus exclusive.
   */
  @call self::MSG_GEN_SET_ATTRS(GA_TARGETABLE,0);

  @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX, 0, NULL);
@ifdef TRUNK
    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED, 0, NULL);
@endif

    @self->TAI_align = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION
	(&br);
  @self->TAI_noBr = br;

  return;
}	/* End of MSG_TEXT_AREA_INITIAL.	*/


