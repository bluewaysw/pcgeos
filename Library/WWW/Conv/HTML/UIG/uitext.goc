/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear some instance data.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_DESTROY
{
  @call self::MSG_VIS_TEXT_FREE_STORAGE(TRUE);

  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  HTListDelete(@self->HTGT_anchorList);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
     if (@self->HTGT_gstate) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      GrDestroyState(@self->HTGT_gstate);
     }
  return;
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_SET_USABLE for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Set some states in the Vis part of the text.
 * PARAMETERS:	    (WindowHandle window = bp)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_SET_USABLE
{
  VisTextStates	visTextStateSet = 0, visTextStateClear = 0;
  char buffer[2];
  word len;
  /*
   *  I tried to add the following ATTR in my MSG_GEN_TEXT_INITIALIZE.
   *  Somehow this attr is deleted after setting the object usable... :(
   */
  @call self::MSG_META_ADD_VAR_DATA
	(ATTR_VIS_TEXT_DONT_SHOW_POSITION_ON_GAINED_TARGET_EXCL, 0, NULL);
  @call self::MSG_GEN_TEXT_SET_ATTRS(GTA_DONT_SCROLL_TO_CHANGES, 0);
  /*
   *  If the last character is C_RETURN, delete it because the next
   *  sibling object starts at the new line anyway.
   *  Note, we just finish appending text.  Thus, we assume the text
   *  cursor position is at the end.
   */
  @call self::MSG_VIS_TEXT_SELECT_RELATIVE(-1, 0);
  len = @call self::MSG_VIS_TEXT_GET_SELECTION_PTR(buffer);
  if (len == 1 && buffer[0] == C_ENTER)
      @call self::MSG_VIS_TEXT_DELETE_SELECTION();
  /*
   *  Its parent may not have been set usable, so the vis branch is not
   *  build and the all HINTs in text are not evaluated yet.  So now I
   *  need to force the text object to evaluate it.
   */
  @call self::MSG_SPEC_SCAN_GEOMETRY_HINTS();

  @callsuper();

  /*
   *  make modified states.
   *  If we'd like to support Search Feature or dragging in the browser,
   *  we may need to set the following bits differently.
   */
@ifdef PRODUCT_NIKE
  visTextStateSet = VTS_SELECTABLE | VTS_TARGETABLE;
  visTextStateClear = VTS_EDITABLE;
@else
  visTextStateSet = /* VTS_SELECTABLE VTS_TARGETABLE */ 0;
  visTextStateClear = VTS_EDITABLE | VTS_SELECTABLE | VTS_TARGETABLE;
@endif
  @call self::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(visTextStateSet,
						      visTextStateClear);
  /*
   *  Dealloc gstate that won't be used anymore.  Save space.
   */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  if (@self->HTGT_gstate) {
      GrDestroyState(@self->HTGT_gstate);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGT_gstate = NULL;
  }

  return;
}	/* End of MSG_GEN_SET_USABLE.	*/



/***********************************************************************
 *		MSG_VIS_TEXT_SET_FONT_ID for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept the message and update its gstate.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	HTGT_gstate is used to calculate the width, in pixels,
 *		needed to draw the text.  That width will be used to
 *		set the width of text object.  Thus, the text won't 
 *		appear wider than necesary.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SET_FONT_ID
{
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  GrSetFont(@self->HTGT_gstate, fid, 0);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_SET_FONT_ID.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_APPEND_PTR for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept this message and update the HTGT_accLen
 * PARAMETERS:	    (const char *text, word textLen)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	HTGT_accLen is used to accumulate the text  length, 
 *		in pixels to draw the current line of text.  This 
 *		length will be used to set the width of text object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_APPEND_PTR
{
  int len;
  optr object;

  if (text[0] == C_TAB) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    @self->HTGT_accLen += (textLen * TAB_POINT);
  } else 
      if (text[0] == C_LF)
	  return;
  
  else if (text[0] == C_ENTER) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      if (@self->HTGT_accLen > @self->HTGT_maxLen) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  @self->HTGT_maxLen = @self->HTGT_accLen;
      }
      EC_ERROR_IF(globalVarWidth <= 0 || globalVarWidth > 16384, 1);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
     if (@self->HTGT_accLen < globalVarWidth) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  globalVarSumOfAccLen+=((globalVarWidth-@self->HTGT_accLen)*textLen);
     } else {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  globalVarSumOfAccLen += @self->HTGT_accLen;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
     }

     /* If there is more text after the C_ENTER, make sure to update */
     /* HTGT_accLen appropriately to include the whole text.         */

     if (text[1] != C_NULL) {
         len = GrTextWidth(@self->HTGT_gstate,text,textLen)+6;
         @self->HTGT_accLen = len;
     }
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGT_multiline = TRUE;
  }
  else {
    len = strlen(text);
    if(len < textLen) textLen = len;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    len = GrTextWidth(@self->HTGT_gstate,text,textLen)+6;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
    @self->HTGT_accLen += len;
    globalVarSumOfAccLen += len;
  }

  /**
   *  If the text is under a table cell, we don't want word wrapping.
   */
  len = strlen(text);
  if (len > 3) {
      if (text[len] == NULL)
	  len--;
      object = (uiMgr.UIM_currentDoc)->PM_recvObj;
      if (object && 
	 @call object::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
	  /*
	   *  Text is under the table cell.  Make sure the text has a
	   *  width no narrower than the longest word.
	   */
	  int maxLengthSeen = 0, tempLen = 0;
	  char *charPtr = NULL;
	  while (len >= 0) {
	      if (len == 0 || isspace(text[len]) || iscntrl(text[len])) {
		  if (tempLen > maxLengthSeen) {
		      maxLengthSeen = tempLen;
		      charPtr = (char *)text+len;
		  }
		  tempLen = 0;
	      }
	      else {
		  tempLen++;
	      }
	      len--;
	  }
	  tempLen = GrTextWidth(@self->HTGT_gstate,charPtr,maxLengthSeen);
	  if (tempLen > @self->HTGT_maxWordWidth)
	      @self->HTGT_maxWordWidth = tempLen;
      }
  }

  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_APPEND_PTR.	*/



/***********************************************************************
 *		MSG_META_MOUSE_PTR for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Change Mouse pointer Image when it's over a link.
 * PARAMETERS:	    (word xPosition,word yPosition, word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_META_PTR
{
  int hrefToken, len;
  char *url;
  HTMemHandle urlHtmh;
  SemaphoreHandle sem = uiMgr.UIM_access;

  @callsuper();

  if(!uiMgr.UIM_currentDoc || !uiMgr.UIM_currentDoc->PM_hrefs) {
    retVal->flags = MRF_PROCESSED;
    return;
  }

  hrefToken = @call self::MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
    (xPosition, yPosition, NULL, NULL, NULL);

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;
  if((@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
      retVal->flags = MRF_PROCESSED;
      ThreadVSem(sem);
      return;
  }
  
  if (hrefToken != -1) {
    retVal->ptrImage = @BoxCursor;
    /* this event processed */
    retVal->flags = MRF_PROCESSED | MRF_SET_POINTER_IMAGE;

    len = HTListGetItemSize((uiMgr.UIM_currentDoc)->PM_hrefs, 
			    hrefToken);
    url = HTMemAllocAndLock(&urlHtmh, len + 1);
    HTListGetItem((uiMgr.UIM_currentDoc)->PM_hrefs, 
		  hrefToken, url, len);
    *(url + len) = 0;
    HTMemUnlock(urlHtmh);

    @send (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	    (UI_MOUSE_OVER_LINK, urlHtmh);
  }
  else {
      retVal->flags |= MRF_CLEAR_POINTER_IMAGE;
    @send (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)
	    (UI_MOUSE_OVER_NOTHING, 0);
  }
  ThreadVSem(sem);
  return;
}	/* End of MSG_META_MOUSE_PTR.	*/


/***********************************************************************
 *	if SHORT_LONG_TOUCH
 *		MSG_META_UIG_SHORT_TOUCH_NOTIFY for HTGenTextClass
 *	else
 *		MSG_META_START_SELECT for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Detect hyperlink on the text object.
 * PARAMETERS:
 *	MSG_META_UIG_SHORT_TOUCH_NOTIFY
 *		void ()
 *	MSG_META_START_SELECT:
 *		(MouseReturnParams *retVal,
 *			      sword xPosition,
 *			      sword yPosition,
 *			      word inputState) 
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@if @SHORT_LONG_TOUCH
@method HTGenTextClass, MSG_META_UIG_SHORT_TOUCH_NOTIFY
@else
@method HTGenTextClass, MSG_META_START_SELECT
@endif /* SHORT_LONG_TOUCH */
{
  int hrefToken;
  SemaphoreHandle sem = uiMgr.UIM_access;

  @self->HTGT_selected = TRUE;

@if !@SHORT_LONG_TOUCH
  @callsuper();

  if (!(GET_BUTTON_INFO(inputState) & BI_PRESS))
    return;
@endif /* !SHORT_LONG_TOUCH */

@if @SHORT_LONG_TOUCH
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  hrefToken = @call self::MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
    (@self->HTGT_rawMouseCoord.P_x, @self->HTGT_rawMouseCoord.P_y, NULL, NULL,
     NULL);
@else
  hrefToken = @call self::MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
    (xPosition, yPosition, NULL, NULL, NULL);
@endif /* SHORT_LONG_TOUCH */

  /* prevent crash */
  if(ThreadPTimedSem(sem, 1) == SE_TIMEOUT)
      return;
  if(!uiMgr.UIM_currentDoc ||
     (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
      ((ClassStruct *)&GenContentClass)) != 
     uiMgr.UIM_currentDoc->HTUI_genContent) {
@if !@SHORT_LONG_TOUCH
      retVal->flags = MRF_PROCESSED;
@endif /* !SHORT_LONG_TOUCH */
      ThreadVSem(sem);
      return;
  }

  if (hrefToken != -1) {
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_REFER_HYPERLINK(hrefToken);
  }

@if 0
Bug fix #72199
  else {
    Rectangle box;
    EventHandle msg;
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_CLEAR_HREF_LINK();
    /*
     *  If the previous object in focus is not this text, clear the 
     *  focal bound.
     */
    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    msg = @record PresentationManagerClass::MSG_PM_GRAB_NEW_FOCUS
	(oself, box, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
    @send oself::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
  }
@endif 
    ThreadVSem(sem);
  return;
}	/* End of MSG_META_START_SELECT.	*/

/***********************************************************************
 *		MSG_META_UIG_LONG_TOUCH_NOTIFY for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Grab the focus, but don't activate hyperlink.
 * PARAMETERS:	    void ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	allen   	11/ 4/97   	Initial Revision
 *	
 ***********************************************************************/

@if @SHORT_LONG_TOUCH

@method HTGenTextClass, MSG_META_UIG_LONG_TOUCH_NOTIFY
{
    RectDWord retd;
    Rectangle ret, box;
    int hrefToken;
    dword start, end;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    /*
     *  Get the href token from the text object and pass to the PManager.
     */
    hrefToken = @call self::MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
	(@self->HTGT_rawMouseCoord.P_x, @self->HTGT_rawMouseCoord.P_y,
	 &start, &end, &(@self->HTGT_focalAnchor));

    if(!uiMgr.UIM_currentDoc || !uiMgr.UIM_currentDoc->PM_hrefs
        || (@call self::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
	((ClassStruct *)&GenContentClass)) != 
       uiMgr.UIM_currentDoc->HTUI_genContent) {
	return;
    }

    if (hrefToken != -1) {
	@call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_CLEAR_HREF_LINK();
	box = GetDocumentCoordFromOffsets(oself, start, end, &(retd.RD_left),
		&(retd.RD_top), &(retd.RD_right), &(retd.RD_bottom));
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	@self->HTGT_focalBound = retd;
	@self->HTGT_focalBox = box;
	ret.R_left = retd.RD_left;
	ret.R_top = retd.RD_top;
	ret.R_right = retd.RD_right;
	ret.R_bottom = retd.RD_bottom;
	@send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GRAB_NEW_FOCUS
	    (oself, ret, box, &HTGenTextClass, &HTGenImageClass,
	     &HTGenInputClass);

	@send uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_DISPLAY_HREF_TARGET
	    (hrefToken, NULL);
    }
}	/* End of MSG_META_UIG_LONG_TOUCH_NOTIFY.	*/

@endif /* SHORT_LONG_TOUCH */

/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_RECALC_SIZE
{
  word neededLen;
  SizeAsDWord size, sz;
@ifdef PRODUCT_NIKE /* This is how we're going to get round the text 
		     * clipping problem */
  word heightsize ;
  word heightsz ;
@endif
  int minWidth;

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  neededLen = (((word) @self->HTGT_accLen) < ((word)@self->HTGT_maxLen)) ?
      @self->HTGT_maxLen : @self->HTGT_accLen;

  if ((neededLen < width) && (@self->HTGT_multiline == FALSE ||
      !@call @genParent::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass)))
      width = neededLen;

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  minWidth = (@self->HTGT_maxWordWidth > 50) ? @self->HTGT_maxWordWidth :
      50;
  if (@self->HTGT_multiline && width < minWidth)
      width = minWidth;
  else if(@self->HTGT_multiline==FALSE && width < minWidth && neededLen > minWidth)
      width = minWidth;

  size = @callsuper();
@ifdef PRODUCT_NIKE
  heightsize = @call self::MSG_VIS_TEXT_CALC_HEIGHT(width, FALSE) ;
@endif

@if 1
  if (@call @genParent::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
    width -= 35;
    while(((int)width) > 50) {
      EC_WARNING_IF(width > 1000, 1);
      EC_ERROR_IF(width > 11000,1);
      sz = @callsuper();
@ifdef PRODUCT_NIKE
      heightsz = @call self::MSG_VIS_TEXT_CALC_HEIGHT(width, FALSE) ;
      if (heightsz > heightsize)
@else
      if (DWORD_HEIGHT(sz) > DWORD_HEIGHT(size))
@endif
	  break;
@ifdef PRODUCT_NIKE
      heightsize = heightsz;
@else
      size = sz;
@endif
      width -= 35;
    }
  }
@endif /* 1 */
@ifdef PRODUCT_NIKE
  return MAKE_SIZE_DWORD(DWORD_WIDTH(size), heightsize+1) ;
@else
  return MAKE_SIZE_DWORD(DWORD_WIDTH(size), DWORD_HEIGHT(size)+1);
@endif
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Manually position the object.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  VisTextInstance  * vself;

    if (@self->HTGT_align == J_LEFT) {
	xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
    }
    else {
	lineWidth = @call @self->HTGT_content::
	    MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGT_pageRow);
	if (lineWidth > (MARGIN+MARGIN))
	    lineWidth -= (MARGIN+MARGIN);
	pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
/*	EC_ERROR_IF(lineWidth > pWidth, 1); */
	if (lineWidth > pWidth) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	    xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
	} else if (@self->HTGT_align == J_RIGHT) {
	    xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGT_xPos-MARGIN);
	}
	else {
	    xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGT_xPos-MARGIN);
	}
    }
  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
      (@self->HTGT_content, @self->HTGT_pageRow, oself);

  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
  @callsuper();
  vself = ObjDerefVis(oself);
  if (!vself->VTI_lines)
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();
  /*
   *  Update the navigation focus when the text object changed.
   */
  if (@self->HTGT_focalAnchor != -1) {
      AnchorElement elm;
      Rectangle box;
      RectDWord ret;
      HTListGetItem(@self->HTGT_anchorList, @self->HTGT_focalAnchor, 
		    &elm, sizeof(AnchorElement));
      box = GetDocumentCoordFromOffsets
	  (oself, elm.AE_start, elm.AE_end, &(ret.RD_left),  &(ret.RD_top), 
	   &(ret.RD_right), &(ret.RD_bottom));
@ifdef PRODUCT_RESPONDER
    pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGT_focalBound = ret;
      @self->HTGT_focalBox = box;
      uiMgr.UIM_currentDoc->PM_drawBound = ret;
      uiMgr.UIM_currentDoc->PM_drawbox = box;
  }
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Manually calculate the position of the object.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  VisTextInstance  * vself;
  SizeAsDWord size;

  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  /*
   *  Ask the text object's content object to figure out the size and
   *  position of the text object.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  pos = UpdateItsPotentialPosition(oself, @self->HTGT_content, &row, &size);

  /*
   *  Store the returned x position in the returned row number.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGT_xPos = pos;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGT_pageRow = row;
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  @self->HTGT_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_SPEC_BUILD_BRANCH
{
  VisTextInstance  * vself;
  int row = -1, col, width, curtCnt;
  word rowSpan, colSpan;
  optr table, nextChild;

  @callsuper();
  
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif

  if (@call @genParent::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
      curtCnt = @call @genParent::MSG_GEN_FIND_CHILD(oself);
      nextChild = @call @genParent::MSG_GEN_FIND_CHILD_AT_POSITION(curtCnt+1);
      if (nextChild)
	  row = @call nextChild::MSG_UI_GET_ROW_POSITION();
      if (row == -1 || row > @self->HTGT_pageRow) {

      table = @call @genParent::MSG_GEN_FIND_PARENT();
      @call @genParent::MSG_GEN_TCELL_GET_CELL_INFO(&row, &col,
						    &rowSpan, &colSpan);
      width = @call table::MSG_GEN_TABLE_GET_COLSPAN_SIZE(col, 1);
      EC_ERROR_IF(DWORD_WIDTH(!@self->HTGT_guessSize),1);
      if (width-MARGIN-MARGIN >=
	  ((int)DWORD_WIDTH(@self->HTGT_guessSize))) {
	  @self->HTGT_guessSize = @call self::MSG_VIS_RECALC_SIZE
	      (width-MARGIN-MARGIN, RSA_CHOOSE_OWN_SIZE);
	  @call @self->HTGT_content::
	      MSG_GEN_TCELL_SET_MAX_ROW_WIDTH_N_NEW_HEIGHT
	      (@self->HTGT_pageRow, 
	       DWORD_WIDTH(@self->HTGT_guessSize)+MARGIN+MARGIN,
	       DWORD_HEIGHT(@self->HTGT_guessSize));
      }

      }
  }

     if (@self->HTGT_guessSize) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGT_guessSize),
				   DWORD_HEIGHT(@self->HTGT_guessSize));
     }
  /*
   *  If the text object is in a form/table, the bit is set again when
   *  the vis part is built.  Thus, we clear it here again.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;
  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/


/***********************************************************************
 *		MSG_UI_GET_ROW_POSITION for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/21/97   	Initial Revision
