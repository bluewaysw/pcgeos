}	/* End of UIGen_END_ADDRESS_Int.	*/



/***********************************************************************
 *		UIGen_CHANGE_SMALL_FONT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change font size smaller than the current one.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Get the current font size.  Change to the next smaller
 *		size.  This method is intended to handle <SMALL>.
 *		We treat <SMALL> as <FONT SIZE = -1>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 2/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CHANGE_SMALL_FONT_Int()
{
  int size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  /*
   * Get current font size
   */
  size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  /*
   * change to a smaller size than the current one.  i.e. SIZE = -1
   */
  switch(size) {
	case STYLE_FONT_0:
		number.WWF_int = STYLE_FONT_0;	/* can't be any smaller */
		break;
	case STYLE_FONT_1:
		number.WWF_int = STYLE_FONT_0;
		break;
	case STYLE_FONT_2:
		number.WWF_int = STYLE_FONT_1;
		break;
	case STYLE_FONT_3:
		number.WWF_int = STYLE_FONT_2;
		break;
	case STYLE_FONT_4:
		number.WWF_int = STYLE_FONT_3;
		break;
	case STYLE_FONT_5:
		number.WWF_int = STYLE_FONT_4;
		break;
	case STYLE_FONT_6:
		number.WWF_int = STYLE_FONT_5;
		break;
	case STYLE_FONT_7:
		number.WWF_int = STYLE_FONT_6;
		break;
	default:
		number.WWF_int = STYLE_FONT_3;	/* error checking */
		break;
  }
  number.WWF_frac= 0;
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
		(number.WWF_int);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
	@call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CHANGE_SMALL_FONT_Int.	*/



/***********************************************************************
 *		UIGen_CHANGE_BIG_FONT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change font size smaller than the current one.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Get the current font size.  Change to the next larger
 *		size.  This method is intended to handle <LARGE>. 
 *		We treat <BIG> as <FONT SIZE = +1>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 2/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CHANGE_BIG_FONT_Int()
{
  int size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  /*
   * Get current font size
   */
  size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  /*
   * change to a larger size than the current one.  i.e. SIZE = +1
   */
  switch(size) {
	case STYLE_FONT_1:
		number.WWF_int = STYLE_FONT_2;
		break;
	case STYLE_FONT_2:
		number.WWF_int = STYLE_FONT_3;
		break;
	case STYLE_FONT_3:
		number.WWF_int = STYLE_FONT_4;
		break;
	case STYLE_FONT_4:
		number.WWF_int = STYLE_FONT_5;
		break;
	case STYLE_FONT_5:
		number.WWF_int = STYLE_FONT_6;
		break;
	case STYLE_FONT_6:
		number.WWF_int = STYLE_FONT_7;
		break;
	case STYLE_FONT_7:
		number.WWF_int = STYLE_FONT_8;
		break;
	case STYLE_FONT_8:
		number.WWF_int = STYLE_FONT_8;	/* can't be any larger */
		break;
	default:
		number.WWF_int = STYLE_FONT_3;	/* error checking */
		break;
  }
  number.WWF_frac= 0;
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
		(number.WWF_int);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
	@call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CHANGE_BIG_FONT_Int.	*/


/***********************************************************************
 *		UIGen_SET_BASEFONT_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set the base font size.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/12/97   	Initial Revision
 *	
 ***********************************************************************/
ErrorCode UIGen_SET_BASEFONT_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value;
  int size, index;
  optr content;
  WWFixed number;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    if (entity[index].SGMLE_token == HTML_ATTR_SIZE) {
	size = atoi(value);
	if (size < 1)
	    size = 1;
	else if (size > 7)
	    size = 7;
	/*
	 *  Set the basefont in the content object.
	 */
	content = UIGen_GET_CONTENT_Int();
	@call content::MSG_GEN_HTML_CONTENT_SET_BASEFONT(size);
    }
  }
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
      /*
       * Map the attribute size to the actual font point size.
       */
      MapAttrSizeToPointSize(size, &number);
      @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
	  (number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_SET_BASEFONT_Int.	*/



/***********************************************************************
 *		UIGen_START_HEADER_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Set header font
 * PARAMETERS:	    (int size, MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Assume the HTML parser will generate the size attribute
 *		like
 *		<H1 size=6>
 *		<H2 size=5>
 *		<H3 size=4>
 *		<H4 size=3>
 *		<H5 size=2>
 *		<H6 size=1>
 *		Supported attributes: ALIGN
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 3/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_HEADER_Int
		(int size, MemHandle block, SGMLEntity *entity)
{
  optr content;
  Justification just;
  WWFixed number;
  word br;

  /*
   * Push format token onto the format stack.
   * Note, here we're pushing three format tokens, so we'll pop four 
   * tokens all together later in the UIGen_END_FORMAT_Int.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_ALIGN);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BOLD);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_HEADER);
  /*
   * Add a blank line for the header.
   */
  AddNewLine(&(uiMgr.UIM_currentDoc->HTUI_target), 2, (uiMgr.UIM_currentDoc),
	     content, TRUE);
  /*
   * Process the attribute list.
   */
  /*
   * Map the attribute size to the actual font point size.
   */
  MapAttrSizeToPointSize(size, &number);
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
      (number.WWF_int);
  /*
   *  set alignment.
   */
  just = ProcessDivParagraphAttr(block, entity);
  if(just == NO_JUSTIFICATION)
    just = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
   
  /*
   * Store this new align info, because later we may have another
   * nesting layer of aligment.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION(just);
  /*
   * If the current target.obj is a text, change the alignment 
   * and change the font now.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
    @call content::MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
	(uiMgr.UIM_currentDoc->HTUI_target.obj);
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
	(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
	(ELEMENT_START, TS_BOLD);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_HEADER_Int.	*/



/***********************************************************************
 *		UIGen_START_PRE_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    render text in a separated multi-line group
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Add a new line, change to fixed-width font.  This
 *		method is intended to handle <PRE>, <XMP> and <LISTING>
 *
 *		NOTE!!!!:
 *		This message assumes the parser will not strip off
 *		multiple spaces and line breaks in the source html file
 *		from now on until the end element is seen.
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 6/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_PRE_Int()
{
  optr content;
  content = UIGen_GET_CONTENT_Int();

  AddNewLine(&(uiMgr.UIM_currentDoc->HTUI_target), 2, (uiMgr.UIM_currentDoc),
	     content, TRUE);
  UIGen_START_FIXED_WIDTH_FONT_Int();
  /*
   * Push format token onto the format stack. 
   */
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_PRE);
  /*
   *  Set PRE if currently we have text.
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass)
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_GEN_TEXT_SET_PRE();
   */

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_PRE_Int.	*/


