/***********************************************************************
 *		UIGen_START_SUPERSCRIPT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Render text in superscript
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Specifically to handle <SUPERSCRIPT>
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/30/96   	Initial Revision
 *	sean	11/10/97	Fixed #72246.
 *
 ***********************************************************************/
ErrorCode UIGen_START_SUPERSCRIPT_Int()
{  
  optr content;
  int  styleCount;

  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin the superscript mode.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_SUPERSCRIPT);

  /* We get the style count to see if we've nested.  If the style count */
  /* is not 0, then we won't try to superscript.  Fixes 72246.        */
  /* Sean 11/10/97.						      */

  styleCount = @call content::MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT
						(STYLE_FW_FONT);

  /*
   * If the current target.obj is a text, do the superscript now.
   */
  if((uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) &&
     (styleCount == 0))
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_SUPERSCRIPT);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_SUPERSCRIPT_Int.	*/


/***********************************************************************
 *		UIGen_START_SUBSCRIPT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Render text in subscript
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Specifically to handle <SUBSCRIPT>
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/30/96   	Initial Revision
 *	sean	11/10/97	Fixed #72246.
 *
 ***********************************************************************/
ErrorCode UIGen_START_SUBSCRIPT_Int()
{
  optr content;
  int  styleCount;

  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin the subscript mode.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_SUBSCRIPT);

  /* We get the styel count to see if we've nested.  If the style count */
  /* is not 0, then we won't try to subscript.  Fixes 72246.          */
  /* Sean 11/10/97.						      */

  styleCount = @call content::MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT
							(STYLE_FW_FONT);

  /*
   * If the current target.obj is a text, do the subscript now.
   */
  if((uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) &&
     (styleCount == 0))
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_SUBSCRIPT);
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_SUBSCRIPT_Int.	*/


/***********************************************************************
 *		UIGen_START_ADDRESS_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/19/97   	Initial Revision
 *	
 ***********************************************************************/
ErrorCode UIGen_START_ADDRESS_Int()
{
  optr content;
  content = UIGen_GET_CONTENT_Int();
  AddNewLine(&(uiMgr.UIM_currentDoc->HTUI_target), 3, (uiMgr.UIM_currentDoc),
	     content, TRUE);
  UIGen_START_ITALIC_Int();
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_ADDRESS_Int.	*/


