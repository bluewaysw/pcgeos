@method HTGenTextClass, MSG_VIS_MARK_INVALID
{
  VisCompInstance *vself;
  
  vself = ObjDerefVis(oself);
  if (!(vself->VI_attrs & VA_REALIZED) && 
	   @call self::MSG_VIS_QUERY_WINDOW() != NULL)
    /*
     *  Avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
     */
    @call self::MSG_VIS_OPEN(0);

    return;
}


/***********************************************************************
 *		MSG_VIS_DRAW for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    In the print process, make the text backgroud white
 *                  so that the text on the print out won't have light
 *                  grey background.
 * PARAMETERS:	    (DrawFlags drawFlags, GStateHandle gstate);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/10/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_DRAW
{
  VisTextWashColorModeRed modeRed;
  VisTextWashColorBlueGreen blueGreen;
  VisTextGetWashColor retVal;
  VisTextInstance  * vself;
  VisTextIntFlags flag;

  vself = ObjDerefVis(oself);
  if (vself->VI_bounds.R_left == 0 && vself->VI_bounds.R_top == 0)
      /*
       *  Objects have some margins with the edges.  If the bounds starts
       *  at (0,0), the object hasn't been positioned yet.  This is to
       *  prevent text object that is set usable when the text is over
       *  4 or 5 K limit, and MSG_VIS_DRAW is sent to the text object
       *  before it has a chance to position itself in the document.
       */
      return;
  if (drawFlags & DF_PRINT) {
    @call self::MSG_VIS_TEXT_GET_WASH_COLOR(&retVal);
    modeRed.VTWCMR_redOrIndex = C_WHITE;
    modeRed.VTWCMR_mapMode = CF_INDEX;
    blueGreen.VTWCBG_green = blueGreen.VTWCBG_blue = 0;
    flag = vself->VTI_intFlags;
    vself->VTI_intFlags |= VTIF_SUSPENDED;
    @call self::MSG_VIS_TEXT_SET_WASH_COLOR(modeRed, blueGreen);
    vself->VTI_intFlags = flag;
  }

  /*
   *  Tell the text to set the bit VTIF_HAS_LINES to make it drawable.
   *  Another purpose is to create chunk array for VTI_lines field.
   */
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
  vself->VI_attrs |= VA_REALIZED;
  if (!vself->VTI_lines)
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();

  @callsuper();
  if (drawFlags & DF_PRINT) {
    @call self::MSG_VIS_TEXT_SET_WASH_COLOR(retVal.VTGWC_modeRed,
					    retVal.VTGWC_blueGreen);
  }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  if (@self->HTGT_focalAnchor != -1) {
    /*
     *  Redraw the focus outlink if it currently has focus.
     */
    GrSaveState(gstate);
    GrSetLineMaskCustom(gstate, (const unsigned char (*)[8])customMask);
    GrSetLineColor(gstate, CF_INDEX, C_WHITE, 0, 0);
    GrSetMixMode(gstate, MM_XOR);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
  if (@self->HTGT_focalBox.R_left != @self->HTGT_focalBox.R_right) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBound.RD_left, 
		     @self->HTGT_focalBound.RD_top, 
		     @self->HTGT_focalBox.R_right, 
		     @self->HTGT_focalBound.RD_top);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBox.R_right, 
		     @self->HTGT_focalBound.RD_top,
		     @self->HTGT_focalBox.R_right, 
		     @self->HTGT_focalBox.R_bottom);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBox.R_right, 
		     @self->HTGT_focalBox.R_bottom,
		     @self->HTGT_focalBound.RD_right, 
		     @self->HTGT_focalBox.R_bottom);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBound.RD_right, 
		     @self->HTGT_focalBox.R_bottom,
		     @self->HTGT_focalBound.RD_right, 
		     @self->HTGT_focalBound.RD_bottom);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBound.RD_right, 
		     @self->HTGT_focalBound.RD_bottom,
		     @self->HTGT_focalBox.R_left, 
		     @self->HTGT_focalBound.RD_bottom);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBox.R_left, 
		     @self->HTGT_focalBound.RD_bottom,
		     @self->HTGT_focalBox.R_left, 
		     @self->HTGT_focalBox.R_top);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBox.R_left, 
		     @self->HTGT_focalBox.R_top,
		     @self->HTGT_focalBound.RD_left, 
		     @self->HTGT_focalBox.R_top);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
	  GrDrawLine(gstate, @self->HTGT_focalBound.RD_left, 
		     @self->HTGT_focalBox.R_top,
		     @self->HTGT_focalBound.RD_left, 
		     @self->HTGT_focalBound.RD_top);
  }
  else
      GrDrawRect(gstate, 
		 @self->HTGT_focalBound.RD_left, 
		 @self->HTGT_focalBound.RD_top, 
		 @self->HTGT_focalBound.RD_right, 
		 @self->HTGT_focalBound.RD_bottom);
    GrRestoreState(gstate);
  }
  return;
}	/* End of MSG_VIS_DRAW.	*/



/***********************************************************************
 *		MSG_SEARCH for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Reset a global variable.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_SEARCH
{
  searchWrapObj = NULL;
  @callsuper();
  return;
}	/* End of MSG_SEARCH.	*/



/***********************************************************************
 *		MSG_META_GET_OBJECT_FOR_SEARCH_SPELL for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Record the search status in global variables.
 * PARAMETERS:	    option
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_META_GET_OBJECT_FOR_SEARCH_SPELL
{

  if(option == GSSOT_FIRST_OBJECT || option == GSSOT_LAST_OBJECT) {
    @call self::MSG_VIS_TEXT_GET_SELECTION_RANGE(&searchWrapRange);
    searchWrapObj = oself;
  }
  else
    searchWrapObj = NULL;
  return @callsuper();
}	/* End of MSG_META_GET_OBJECT_FOR_SEARCH_SPELL.	*/



/***********************************************************************
 *		MSG_VIS_TEXT_SELECT_RANGE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    To make the selected text in the document
 *                  stay selected when there is no more matched string
 *                  during the search process.
 * PARAMETERS:	    (@stack dword end, dword start)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/22/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SELECT_RANGE
{
  if (searchWrapObj == oself) {
    start = searchWrapRange.VTR_start;
    end = searchWrapRange.VTR_end;
  }
  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_SELECT_RANGE.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_DELETE_ALL for HTGenTextClass
 ***********************************************************************
