/***********************************************************************
 *		MSG_VIS_TEXT_SET_PARA_ATTRIBUTES for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set align attribute.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/23/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SET_PARA_ATTRIBUTES
{
  @callsuper();

  if ((bitsToSet >> VTPAA_JUSTIFICATION_OFFSET) == J_CENTER) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGT_align = J_CENTER;
  } else if ((bitsToSet >> VTPAA_JUSTIFICATION_OFFSET) == J_RIGHT) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGT_align = J_RIGHT;
  } else {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
      @self->HTGT_align = J_LEFT;
  }
  return;
}	/* End of MSG_VIS_TEXT_SET_PARA_ATTRIBUTES.	*/

@ifndef BROTHER_KERNEL
/***********************************************************************
 *		MSG_META_GRAB_FOCUS_EXCL for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Since the text object is not focusable, selectable
 *                  nor targetable, we let it's content object to gain
 *                  the focus.  This way we can force the focus's
 *                  previous owner to release the focus and navigation
 *                  focus drawing.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	9/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_META_GRAB_FOCUS_EXCL
{
    @send @genParent::MSG_META_GRAB_FOCUS_EXCL();
    return;
}     /* End of MSG_META_GRAB_FOCUS_EXCL.	*/
@endif

/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    VisTextInstance *vself;
/*
 * This was allocated using HTListNewWID.
 * 
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
 * if (@self->HTGT_anchorList) {
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself, word_offsetof(GenBase, Gen_offset));
@endif
 *	HTListDelete(@self->HTGT_anchorList);
 * }
 */

  vself = ObjDerefVis(oself);
  if (vself->VTI_gstate)
      GrDestroyState(vself->VTI_gstate);
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/

@ifdef BROTHER_KERNEL

/***********************************************************************
 *		UIGen_START_BODY_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Figure out the background color of the page.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	JB	9/30/97   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_BODY_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value;
  Color explicitBackColor = C_WHITE;
  ColorQuad backgroundColor ;
  byte redValue ;
  byte greenValue;
  byte blueValue;
  word greenBlueValue;
  char temp[3] ;
  word index = 0; 

    while (1) {
        if (!entity[index].SGMLE_value) return UI_GEN_NO_ERROR;	
	if (entity[index].SGMLE_token == HTML_ATTR_BGCOLOR) break ;
	index++ ;
    }

    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    if (!strncmp(value, "#", 1)) {
	/* We've got to interpret the next 6 chars as rrggbb*/
	value+=1 ;
	strncpy(temp, value, 2) ;
	temp[2] = '\0' ;
	redValue = hexatoi(temp) ;
	value+=2 ;
	strncpy(temp, value, 2);
	greenValue = hexatoi(temp) ;
	value+=2 ;
	strncpy(temp, value, 2) ;
	blueValue = hexatoi(temp) ;
	if ((redValue < 0x60) && (greenValue < 0x60) && (blueValue < 0x60)) {
		/* Too close to black */
		greenValue = 0x60 ;
		redValue = 0x60 ;
		blueValue = 0x60 ;
 	}
	backgroundColor.CQ_redOrIndex = redValue;
	backgroundColor.CQ_info = CF_RGB; 
	backgroundColor.CQ_green = greenValue;
	backgroundColor.CQ_blue = blueValue;
	greenBlueValue = (blueValue << 8) | greenValue;
	@send (uiMgr.UIM_currentDoc->HTUI_genView)::MSG_GEN_VIEW_SET_COLOR
		(redValue, CF_RGB, greenBlueValue) ;
	uiMgr.UIM_currentDoc->HTUI_backgroundColor = backgroundColor;

    } else {
	/* We got a literal.  If it's kosher, use it, o/w white */
	if (!strcasecmp(value, "blue")) {
		explicitBackColor = C_BLUE ;

	} else if (!strcasecmp(value, "white")) {
		explicitBackColor = C_WHITE ;

	} else if (!strcasecmp(value, "black")) {
		explicitBackColor = C_DARK_GRAY ;

	} else if (!strcasecmp(value, "red")) {
		explicitBackColor = C_RED ;

	} else if (!strcasecmp(value, "yellow")) {
		explicitBackColor = C_YELLOW ;

	} else if (!strcasecmp(value, "CYAN")) {
		explicitBackColor = C_CYAN ;

	} else if (!strcasecmp(value, "purple")) {
		explicitBackColor = C_VIOLET ;

	} else if (!strcasecmp(value, "gray")) {
		explicitBackColor = C_LIGHT_GRAY ;

	} else if (!strcasecmp(value, "grey")) {
		explicitBackColor = C_LIGHT_GRAY ;

	} else if (!strcasecmp(value, "green")) {
		backgroundColor.CQ_redOrIndex = 0;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 128;
		backgroundColor.CQ_blue = 0;

	} else if (!strcasecmp(value, "magenta")) {
		backgroundColor.CQ_redOrIndex = 255;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 0;
		backgroundColor.CQ_blue = 255;

	} else if (!strcasecmp(value, "lime")) {
		backgroundColor.CQ_redOrIndex = 0;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 255;
		backgroundColor.CQ_blue = 0;

	} else if (!strcasecmp(value, "maroon")) {
		backgroundColor.CQ_redOrIndex = 128;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 0;
		backgroundColor.CQ_blue = 64;

	} else if (!strcasecmp(value, "navy")) {
		backgroundColor.CQ_redOrIndex = 0;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 0;
		backgroundColor.CQ_blue = 64;

	} else if (!strcasecmp(value, "olive")) {
		backgroundColor.CQ_redOrIndex = 128;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 128;
		backgroundColor.CQ_blue = 0;

	} else if (!strcasecmp(value, "silver")) {
		backgroundColor.CQ_redOrIndex = 192;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 192;
		backgroundColor.CQ_blue = 192;

	} else if (!strcasecmp(value, "teal")) {
		backgroundColor.CQ_redOrIndex = 0;
		backgroundColor.CQ_info = CF_RGB; 
		backgroundColor.CQ_green = 128;
		backgroundColor.CQ_blue = 128;
	}
	if (backgroundColor.CQ_info == CF_RGB) {
		greenBlueValue = (backgroundColor.CQ_blue << 8) | 
				backgroundColor.CQ_green ;
		@send (uiMgr.UIM_currentDoc->HTUI_genView)::
			MSG_GEN_VIEW_SET_COLOR (backgroundColor.CQ_redOrIndex,
						 CF_RGB, greenBlueValue) ;
		uiMgr.UIM_currentDoc->HTUI_backgroundColor = backgroundColor;
	} else {

		@send (uiMgr.UIM_currentDoc->HTUI_genView)::
			MSG_GEN_VIEW_SET_COLOR (explicitBackColor, 
						CF_INDEX, 0) ;
		backgroundColor.CQ_redOrIndex = explicitBackColor; 
		backgroundColor.CQ_info = CF_INDEX;
		backgroundColor.CQ_green = 0;
		backgroundColor.CQ_blue = 0;
		uiMgr.UIM_currentDoc->HTUI_backgroundColor = backgroundColor;
    }
}		
  return UI_GEN_NO_ERROR;
}


/* Jeremyb 10/30/97					*/
/* Utility to convert a hex string to an integer	*/
/* DBCS me please 					*/
int hexatoi (char *input) 
{
	char *temp ;
	int length, i, value ;
	int ret = -1 ;
	
	length = strlen (input) ;
  	if (length >= 0) {
		ret = 0; 
	}
	temp = input ;
	for (i = 0 ; i < length ; i++) {
		ret *= 16 ;	
		/* Make the character into a number 0-15*/
		value = (int) temp[0] ;
		if ((value >= 0x30) && (value <= 0x39)) {
			value = temp[0] - '0' ;
		} else if ( (value >= 0x41) && (value <= 0x46) ) {
		/* Uppercased character */
			value = (temp[0] - 'A') + 10 ;
		} else if ( (value >= 0x61) && (value <= 0x66) ) {
		/* lowercased character */
			value = (temp[0] - 'a') + 10;
		} else {
			return (-1) ;
		}
		ret += value ;
		temp++ ; /* Next character*/
	}
	
	return (ret) ;
}
@endif
