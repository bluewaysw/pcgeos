/***********************************************************************
 *	UIGen_APPEND_TEXT_PTR_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	Append the character data in a text object.  If there is
 *		no text object available, a text object will be created.
 * PARAMETERS:	(char *ptr, int len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		- assume the data character has no entity references
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/16/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_APPEND_TEXT_PTR_Int(char *ptr, int len)
{
  char old;
  optr parent, content = UIGen_GET_CONTENT_Int();
  ClassStruct *class;

  if (!(uiMgr.UIM_currentDoc->HTUI_target.obj)) {
    if (len == 1 && ptr[0] == C_SPACE)
	return UI_GEN_NO_ERROR;  /* ignore the stupid white space */
    /* 
     *  No target.obj.  Thus, create a text object,
     *  initialize it, and store character data.
     */
    UIGen_CREATE_TEXT_OBJECT_Int(ptr, content, len);
  }
  else if(uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass ||
	  uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormTextClass) {
    if (len == 1 && ptr[0] == C_SPACE && 
	uiMgr.UIM_currentDoc->HTUI_target.class == 
	(ClassStruct *)&HTGenFormTextClass)
	return UI_GEN_NO_ERROR;  /* ignore the stupid white space */
    if ((@call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_GET_TEXT_SIZE() + len) 
	> 5000 || globalVarSumOfAccLen > 46000) {
      @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	 (uiMgr.UIM_currentDoc->HTUI_target.obj);
      UIGen_CREATE_TEXT_OBJECT_Int(ptr, content, len);
      EC_WARNING(UIG_TEXT_SPLITS_AT_5K_BYTES);
    }
    else 
      /*
       * The target is a text object, so we simply append the text to it.
       */
      @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(ptr, len);

  }  /* Added for HTTextAreaClass */

  else if( uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&TextAreaClass) {
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_TEXT_AREA_APPEND_TEXT_PTR(ptr, len);

  } else if(uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTMLSelectClass) {
    if (!(len == 1 && ptr[0] == ' ')) {
	old = ptr[len];
	ptr[len] = '\0';
	@call uiMgr.UIM_currentDoc->HTUI_target.obj::
	     MSG_HTML_SELECT_ADD_OPTION_TEXT(ptr);
	ptr[len] = old;
    }
  }
  else if(uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass ||
	  uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct*)&HTGenCaptionClass) {
    if (len == 1 && ptr[0] == C_SPACE)
	return UI_GEN_NO_ERROR;  /* ignore the stupid white space */
    /*
     *  Create a text object which will be inside the table cell.
     *  Note, the TCell object contains text formating contents.
     */
    @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
				(uiMgr.UIM_currentDoc->HTUI_target.obj);
    UIGen_CREATE_TEXT_OBJECT_Int
	(ptr, uiMgr.UIM_currentDoc->HTUI_target.obj, len);
  }
  else if(uiMgr.UIM_currentDoc->HTUI_target.class==(ClassStruct*)&PresentationManagerClass){
    /*
     * We're in the <TITLE>....</TITLE> content.  
     * Store the title of the document.
     */
      if (uiMgr.UIM_currentDoc->HTUI_title) {
	  uiMgr.UIM_currentDoc->HTUI_title = 
	      HTStrnAllocCatWID(uiMgr.UIM_currentDoc->HTUI_memID, 
				uiMgr.UIM_currentDoc->HTUI_title,	 
				ptr, len);
      } else {
	  uiMgr.UIM_currentDoc->HTUI_title = 
	      HTStrnAllocCopyWID(uiMgr.UIM_currentDoc->HTUI_memID, ptr, len);
      }
     @send (ConstructOptr(uiMgr.UIM_client, 0))::
	{MSG_FROM_UI_DOCUMENT}(uiMgr.UIM_message)(UI_TITLE, 0);
  }
  /*
   *  Add length to the estimated memory size needed for display.
   */
  UIDocAddMemory(len);
  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *	UIGen_CREATE_TEXT_OBJECT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a text object and initialize it
 * PARAMETERS:	    (char *text, optr cell, int len)
 *		    if cell is NULL, that means we don't do any text
 *		    formatting according to the global HTML contents.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		1) Instantiate a text object
 *		2) Add HINTs to the object
 *		3) Format it according to the current HTML content
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/10/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_TEXT_OBJECT_Int
		(char *text, optr cell, int len)
{
  GStateHandle gstate;
  optr obj;
  
  /*
   * Create a text object.
   */
  obj = UICreateObj(&HTGenTextClass);
  uiMgr.UIM_currentDoc->HTUI_target.obj = obj; 
  uiMgr.UIM_currentDoc->HTUI_target.class = (ClassStruct *)&HTGenTextClass;
  /*
   * Initialization:
   * 1) Create gstate, used to calculate the min width required for
   *	the text object.
   * 2) Create a text storage for the object.
   * 3) Mark text non-editable, non-scrollable, add HINTs
   */
  gstate = @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_GEN_TEXT_INITIALIZE(cell);
  /*
   *  Set text output object to be the PManager, which has all the HREF
   *  information.  Thus, when a hyperlink is clicked, the text object
   *  can send HREF token to the output object(PManager) to fetch.
   */
  @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_META_SET_OBJ_BLOCK_OUTPUT
     (uiMgr.UIM_currentDoc->HTUI_pmanager);
  /*
   * Do text formating stuff...
   *    Format the text object, i.g. bold, font size, alignment, 
   *	according to the current HTML content.  Note, the cell object 
   *	contains information about the current HTML content.
   */
  if (cell != NULL)
    @call cell::MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT
	(uiMgr.UIM_currentDoc->HTUI_target.obj, gstate);

  /*
   * Append the text.
   */
  if (text != NULL)
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(text, len);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_TEXT_OBJECT_Int.	*/



/***********************************************************************
 *	UIGen_GET_CONTENT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Get the current content object
 * PARAMETERS:	    optr ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
optr UIGen_GET_CONTENT_Int()
{
  optr obj;
  ClassStruct *class;

  /*
   *  Is target.obj a content object?  Note, HTGenTCellClass is a 
   *  content object.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass ||
      uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenCaptionClass)
	return uiMgr.UIM_currentDoc->HTUI_target.obj;
  /*
   * Get PManager's current recvObj, i.e the leaf child of the ui tree.
   */
  @call uiMgr.UIM_currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS(&obj, &class);
  /*
   * Trace up the tree to find a content object.
   */
  while(!@call obj::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass)) {
    if (@call obj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenHtmlContentClass)) {
	/* 
	 * add the new text format to the content object.
	 */
	return obj;
    }
    obj = @call obj::MSG_GEN_FIND_PARENT();
  }
  /*
   * Return the global content object.  If not exists, create one.
  if (!uiMgr.UIM_currentDoc->HTUI_pmContent)
    uiMgr.UIM_currentDoc->HTUI_pmContent = UICreateObj(&HTGenHtmlContentClass);

   */
  return uiMgr.UIM_currentDoc->HTUI_pmContent;
}	/* End of UIGen_GET_CONTENT_Int.	*/



/***********************************************************************
 *	UIGen_START_BOLD_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Mark the beginning of bold character rending
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		This method is intended to render the text in the
 *		contents of:  <B>, <STRONG>
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_BOLD_Int()
{
  optr content;

  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin the bold mode.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BOLD);
  /*
   * If the current target.obj is a text, do the bold rendering now.
   */
  if (uiMgr.UIM_currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass)
    @call uiMgr.UIM_currentDoc->HTUI_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_BOLD);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_BOLD_Int.	*/



