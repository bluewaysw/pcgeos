@include <stdapp.goh>
@include <WWW/htconv.goh>
@include <WWW/htgif.goh>

extern word GifToBitmap(word dataHandle);

/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTGIFClass;

/***********************************************************************
		Message Handlers
***********************************************************************/

@method HTGIFClass, MSG_HT_STREAM_SET_TARGET
{
    @callsuper();

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    ThreadCreate(PRIORITY_HIGH, @self->struct_handle,
		&GifToBitmap, 2560, GeodeGetProcessHandle());
}

