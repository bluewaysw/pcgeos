/***********************************************************************
 *		SGMLSearchTag
 ***********************************************************************
 *
 * SYNOPSIS:	Search for a tag in a taglist.
 * CALLED BY:	sgml.goc
 * RETURN:	-1 if not found, else valid index into 
 *              dtd->SGMLD_tagList.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Use a binary search algo. Table must be ordered 
 *              alphabetically.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/22/96   	Initial Revision
 *
 ***********************************************************************/
int  _pascal
SGMLSearchTag (SGMLTag *tptr, word numOfTags, char *thisWord)
{
    int result;
    int i, lower = 0;
    int upper = numOfTags - 1;

    while (upper >= lower) {
	i = (lower + upper) / 2;

	/* Case insensitive compare */
	result = strcasecmp(thisWord, tptr[i].SGMLT_name);

	if (result < 0)
	    upper = i - 1;

	else if (result > 0)
	    lower = i + 1;

	else
	    return i;
    }

    return -1;
} 	/* End of SGMLSearchTag.	*/



/***********************************************************************
 *		SGMLSearchAttr
 ***********************************************************************
 *
 * SYNOPSIS:	Search a list of attributes for an attribute name match.
 * CALLED BY:	SGMLParseElementAttr
 * RETURN:	> 0 if found and token contains a valid attr token.
 *              else -1.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 4/96   	Initial Revision
 *
 ***********************************************************************/
int  _pascal
SGMLSearchAttr (SGMLAttr *attrs, word numOfAttrs, char *thisWord)
{
    int result;
    int i, lower = 0;
    int upper = numOfAttrs - 1;

    while (upper >= lower) {
	i = (lower + upper) / 2;

	/* Case insensitive compare */
	result = strcasecmp(thisWord, attrs[i].SGMLA_name);

	if (result < 0)
	    upper = i - 1;

	else if (result > 0)
	    lower = i + 1;

	else
	    return i;
    }

    return -1;
}	/* End of SGMLSearchAttr.	*/


#if 0
