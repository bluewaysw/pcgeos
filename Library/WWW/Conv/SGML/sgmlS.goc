/***********************************************************************
 *	        IsDelimiter
 ***********************************************************************
 *
 * SYNOPSIS:	Returns TRUE if a character is a valid SGML delimiter.
 * CALLED BY:	SGMLScanGobbleSym
 * RETURN:	TRUE or FALSE
 * SIDE EFFECTS:
 *	
 * STRATEGY:    A SGML tag name is a letter followed by letters, digits,
 *              periods, or hyphens. So these should *not* be considered 
 *              as delimiters.
 *
 *              Should be implemented as a macro to improve speed.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/21/96   	Initial Revision
 *
 ***********************************************************************/
#define IsDelimiter(chr) \
    ((ISWHITE(chr) || (chr == '<')  || (chr == '>') ||  \
     (chr == '\"') || (chr == '\'') || (chr == '=')) ?  \
     TRUE : FALSE)
/* @@@
static Boolean _pascal
IsDelimiter (char chr)
{
    if (ISWHITE(chr) || (chr == '<')  || (chr == '>') ||
	(chr == '\"') || (chr == '\'') || (chr == '='))
	return TRUE;
    
    return FALSE;
}
@@@ */



/***********************************************************************
 *		SGMLScanWaitForData
 ***********************************************************************
 *
 * SYNOPSIS:	Wait for data.
 * CALLED BY:	SGMLScanGetChar.
 * RETURN:	TRUE if data has arrived. FALSE if there is no more data
 *              and we should not wait.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/13/96   	Initial Revision
 *
 ***********************************************************************/
static Boolean _pascal
SGMLScanWaitForData (SGMLScanner *sptr)
{
    /* 
     * We should NOT do ThreadPSem(sptr->SGMLS_get) here as this will
     * deadlock in case sptr->SGMLS_endOfFile is TRUE. Since if 
     * sptr->SGMLS_endOfFile is true, the parser would wait for the
     * scanner to terminate and we can't terminate if we do ThreadPSem.
     */
    while ((ThreadPTimedSem(sptr->SGMLS_get, 1) == SE_TIMEOUT) && 
	   (!sptr->SGMLS_endOfFile));

    sptr->SGMLS_haveData = TRUE;

    return !sptr->SGMLS_endOfFile;
}	/* End of SGMLScanWaitForData.	*/



/***********************************************************************
		Public Functions
***********************************************************************/



/***********************************************************************
 *		SGMLScanGetChar
 ***********************************************************************
 *
 * SYNOPSIS:	Remove a character from scanner's queue. This implements
 *              the "consumer" part of the SGML scanner. The "producer"
 *              is implemented by SGMLScanAppendData.  This should be 
 *              called from a different thread than the one that calls 
 *              SGMLScanAppendData. If sptr->SGMLS_endOfFile == TRUE,
 *              the returned character is invalid. Hence, you should 
 *              check sptr->SGMLS_endOfFile after calling this routine.
 * CALLED BY:	sgml.goc
 * RETURN:	char
 * SIDE EFFECTS:
 *	
 * STRATEGY:    
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/18/96   	Initial Revision
 *
 ***********************************************************************/
char  _pascal
SGMLScanGetChar (SGMLScanner *sptr)
{
    char chr;

    /* Check for ungotten chars first */
    if (sptr->SGMLS_numOfUngotten)
	return sptr->SGMLS_ungottenChar[--(sptr->SGMLS_numOfUngotten)];

    if (!sptr->SGMLS_haveData && !SGMLScanWaitForData(sptr)) 
	/* Meaning: there is no data and we should not wait */
	return ' ';
	    
    chr = sptr->SGMLS_data[sptr->SGMLS_dataIndex++];

    if (sptr->SGMLS_dataIndex == sptr->SGMLS_len) {
	sptr->SGMLS_haveData = FALSE;
	ThreadVSem(sptr->SGMLS_put);
	ThreadVSem(sptr->SGMLS_wait);
    }

    return chr;
}	/* End of SGMLScanGetChar.	*/



/***********************************************************************
 *		SGMLScanGetReduceWhiteChar
 ***********************************************************************
 *
 * SYNOPSIS:	Same as SGMLScanGetChar. Except that a string of white 
 *              characters is gobbled and returned as a space (' ')
 *              character. You should check sptr->SGMLS_endOfFile after 
 *              calling this routine.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Should be implemented as a macro to improve speed.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
char _pascal
SGMLScanGetReduceWhiteChar (SGMLScanner *sptr)
{
    char chr;

    chr = SGMLScanGetChar(sptr);

    if (ISWHITE(chr)) {

	/* Gobble all subsequent white spaces */
	do {
	    chr = SGMLScanGetChar(sptr);
	}
	while (ISWHITE(chr));

	/* We have read one character ahead, rewind */
	SGMLScanUngetChar(sptr, chr);
	return ' ';
    }

    return chr;
}	/* End of SGMLScanGetReduceWhiteChar<.	*/




/***********************************************************************
 *		SGMLScanGetNonWhiteChar
 ***********************************************************************
 *
 * SYNOPSIS:	Same as SGMLScanGetChar. Except that all white chars
 *              are skipped and the first nonwhite char is returned. 
 *              You should check sptr->SGMLS_endOfFile after calling 
 *              this routine.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Should be implemented as a macro to improve speed.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
char  _pascal
SGMLScanGetNonWhiteChar (SGMLScanner *sptr)
{
    char chr;

    do {
	chr = SGMLScanGetChar(sptr);
    } while (ISWHITE(chr) && (!sptr->SGMLS_endOfFile));

    return chr;
}	/* End of SGMLScanGetNonWhiteChar.	*/





/***********************************************************************
 *		SGMLScanUngetChar
 ***********************************************************************
 *
 * SYNOPSIS:	Unget a character. You cannot unget more than 
 *              SGML_MAX_NUMBER_UNGET_CHARS without consuming it using
 *              SGMLScanGetChar.
 * CALLED BY:	sgml.goc
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Should be implemented as a macro for speed. 
 *              See sgmlS.goh.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/22/96   	Initial Revision
 *
 ***********************************************************************/
/* @@@
void  _pascal
SGMLScanUngetChar (SGMLScanner *sptr, char chr)
{
    sptr->SGMLS_ungottenChar[sptr->SGMLS_numOfUngotten++] = chr;

#if ERROR_CHECK
    if (sptr->SGMLS_numOfUngotten == SGML_MAX_NUMBER_UNGET_CHARS)
	EC_ERROR(UNGET_CHAR_BUFFER_IS_FULL);
#endif	
}
@@@ */



/***********************************************************************
 *		SGMLScanGobbleSym
 ***********************************************************************
 *
 * SYNOPSIS:	Swallow a token. If you add new token, don't forget to 
 *              update the printing of token in SGMLPutTokenText in 
 *              sgml.goc.
 * CALLED BY:	SGMLParseElementAttrs
 * RETURN:	SGMLToken
 * SIDE EFFECTS:
 *	
 * STRATEGY:    After every call to SGMLScanGetChar(), don't forget 
 *              to see if (sptr->SGMLS_endOfFile == TRUE). If its TRUE,
 *              we are done parsing and the returned character from
 *              SGMLScanGetChar() must be ignored.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/16/96   	Initial Revision
 *
 ***********************************************************************/
void  _pascal
SGMLScanGobbleSym (SGMLScanner *sptr)
{
    char chr;
    word i;

    chr = SGMLScanGetChar(sptr);

    /* This is one big switch loop that builds a SGML token */
    sptr->SGMLS_thisWord[0] = '\0';
    while (1) {

	if (ISALNUM(chr) || (chr == '+') || (chr == '-')) {
	    /*
	     * Build up a string (a combination of alpha numerals)
	     */
	    i = 0;
	    do {
		if (i < MAX_SGML_NAME_LENGTH-1)
		    sptr->SGMLS_thisWord[i++] = chr;

/* @@@
#if ERROR_CHECK
if (i >= MAX_SGML_NAME_LENGTH)
    EC_WARNING(IDENTIFIER_LONGER_THAN_MAX_SGML_NAME_LENGTH);
#endif
@@@ */

		chr = SGMLScanGetChar(sptr);
		/* Check sptr->endOfFile after while loop */

	    } while ((!IsDelimiter(chr)) && (!sptr->SGMLS_endOfFile));

	    sptr->SGMLS_thisWord[i] = '\0';
	    
	    /* We have read one character ahead */
	    SGMLScanUngetChar(sptr, chr);

	    if (!sptr->SGMLS_endOfFile)
		sptr->SGMLS_thisSym = SGMLT_STRING;

	    else
		sptr->SGMLS_thisSym = SGMLT_XXX_EOF;
	
	    return;

	} else 

	    switch (chr) {
	    case '>':
		sptr->SGMLS_thisSym = SGMLT_CLOSE_BRACKET;
		return;

	    case '=':
		sptr->SGMLS_thisSym = SGMLT_EQUAL;
		return;

	    case '\"':
		sptr->SGMLS_thisSym = SGMLT_DOUBLE_QUOTE;
		return;

	    case '\'':
		sptr->SGMLS_thisSym = SGMLT_SINGLE_QUOTE;
		return;

	    default:
/* @@@
EC (            EC_WARNING(SCANNER_IGNORE_A_CHARACTER);                 )
@@@ */
                chr = SGMLScanGetChar(sptr);
		if (sptr->SGMLS_endOfFile) {
		    sptr->SGMLS_thisSym = SGMLT_XXX_EOF;
		    return;
		}
		break;

	    }
    }
}	/* End of SGMLScanGobbleSym.	*/



/***********************************************************************
 *		SGMLScanGobbleValue
 ***********************************************************************
 *
 * SYNOPSIS:	Gobble an attribute value. 
 * CALLED BY:	sgml.goc.
 * RETURN:	The value is gobbled into the passed in buffer. The 
 *              buffer is assumed to be of size MAX_SGML_NAME_LENGTH.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 6/96   	Initial Revision
 *
 ***********************************************************************/
void  _pascal
SGMLScanGobbleValue (SGMLScanner *sptr, char *buffer)
{
    char chr;
    word i;

    buffer[0] = '\0';
    i = 0;

    chr = SGMLScanGetChar(sptr);

    while (!ISWHITE(chr) && (chr != '>') && !sptr->SGMLS_endOfFile) {

	if (i < MAX_SGML_NAME_LENGTH-1)
	    buffer[i++] = chr;

/* @@@
#if ERROR_CHECK
if (i >= MAX_SGML_NAME_LENGTH)
    EC_WARNING(IDENTIFIER_LONGER_THAN_MAX_SGML_NAME_LENGTH);
#endif
@@@ */

	chr = SGMLScanGetChar(sptr);
	/* Check sptr->endOfFile after while loop */

    }

    buffer[i] = '\0';
	    
    /* We have read one character ahead */
    SGMLScanUngetChar(sptr, chr);

}	/* End of SGMLScanGobbleValue.	*/




/***********************************************************************
 *		SGMLScanGobbleQuotedValue
 ***********************************************************************
 *
 * SYNOPSIS:	Gobble an attribute value demarcated by a pair of quotes.
 *              When this routine is called, the opening quote has been
 *              gobbled. The quotes are not included in the value. 
 * CALLED BY:	sgml.goc.
 * RETURN:	The value is gobbled into the passed in buffer. The 
 *              buffer is assumed to be of size MAX_SGML_NAME_LENGTH.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 6/96   	Initial Revision
 *
 ***********************************************************************/
void  _pascal
SGMLScanGobbleQuotedValue (SGMLScanner *sptr, char *buffer, char quote)
{
    char chr, refChar, ct;
    word i;
    int result;

    buffer[0] = '\0';
    i = 0;

    chr = SGMLScanGetChar(sptr);

    while ((chr != quote) && !sptr->SGMLS_endOfFile) {

        if (chr == '&') {
            result = SGMLParseReference(sptr, &refChar);
            switch (result) {
		case PARSE_REF_ENTITY_REF:
                case PARSE_REF_CHAR_REF:
                     buffer[i++] = refChar;
                     break;
                case PARSE_REF_WHITE_SPACE:
                     buffer[i++] = '&';
                     buffer[i++] = ' ';
                     break;
                case PARSE_REF_LEFT_BRACKET:
                case PARSE_REF_NON_REFERENCE:
                     buffer[i++] = '&';
                     break;
                default:
		     break;    
            }
        } else {
              if (i < MAX_SGML_NAME_LENGTH-1)

                 if ((chr >= 0xA0) && (chr < 0x100)) {
                    ct = CHARACTERTRANSLATE[chr-0xA0][0];
                    if (ct > 0)
                       buffer[i++] = ct;
                    else
                       buffer[i++] = chr;
                 } else {
                    buffer[i++] = chr;
                 }
        }

	chr = SGMLScanGetChar(sptr);
	if ((chr == '<') || (chr == '>')) {
	    SGMLScanUngetChar(sptr, chr);
	    break;
	}

	/* Check sptr->endOfFile after while loop */

    } 

    buffer[i] = '\0';
	    
    /* We don't care to unget the double quote */

}	/* End of SGMLScanGobbleQuotedValue.	*/


