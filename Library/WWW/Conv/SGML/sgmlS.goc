/***********************************************************************
 *		SGMLSearchCharacter
 ***********************************************************************
 *
 * SYNOPSIS:	Search the DTD list of characters for a match.
 * CALLED BY:	sgml.goc
 * RETURN:	If a match is found returnn  > -1.
 *              If not found, then return is -1.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/18/97   	Initial Revision
 *	
 ***********************************************************************/
int _pascal
SGMLSearchCharacter (char **character, word numOfCharacters, int value)
{
    int i, lower = 0;
    int upper = numOfCharacters - 1;
    int ret = -1;

    while (upper >= lower) {
	i = (lower + upper) / 2;

	if (value < character[i][0])
	    upper = i - 1;

	else if (value > character[i][0])
	    lower = i + 1;

	else {
	    ret = i;
	    break;
	}
    }

    return ret;
}	/* End of SGMLSearchCharacter.	*/
#endif


/***********************************************************************
 *		SGMLSearchEntity
 ***********************************************************************
 *
 * SYNOPSIS:	Search the DTD list of entities for a match.
 * CALLED BY:	sgml.goc
 * RETURN:	If a match is found return is > -1.
 *              If not found, then return is -1.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 8/96   	Initial Revision
 *
 ***********************************************************************/
int  _pascal
SGMLSearchEntity (char **entity, word numOfEntities, char *thisWord)
{
    int result;
    int i, lower = 0;
    int upper = numOfEntities - 1;
    int ret = -1;

    while (upper >= lower) {
	i = (lower + upper) / 2;

	/* Case sensitive compare! */
	result = strcmp(thisWord, entity[i]);

	if (result < 0)
	    upper = i - 1;

	else if (result > 0)
	    lower = i + 1;

	else {
	    ret = i;
	    break;
	}
    }

    return ret;
}	/* End of SGMLSearchEntity.	*/




/***********************************************************************
 *		SGMLScanNew
 ***********************************************************************
 *
 * SYNOPSIS:	Create a new SGML scanner.
 * CALLED BY:	SGML parser
 * RETURN:	SGMLScannerHandle, NULL if cannot allocate.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/16/96   	Initial Revision
 *
 ***********************************************************************/
SGMLScannerHandle  _pascal
SGMLScanNew (SGMLDTD *dtd, HTStreamHandle target)
{
    SGMLScannerHandle scanner;
    SGMLScanner *sptr;
    word i;
    Boolean allocated = TRUE;

#if ERROR_CHECK
    if (!(OptrToHandle(dtd->SGMLD_tagList) == 
	  OptrToHandle(dtd->SGMLD_entityList)) ||
	!(OptrToHandle(dtd->SGMLD_tagList) == 
	  OptrToHandle(dtd->SGMLD_entityTranslate)))
	EC_ERROR(DTD_INFO_MUST_BE_IN_SAME_RESOURCE);
#endif

    /* Allocate and lock, thread safe */
    scanner = MemAlloc(sizeof(SGMLScanner), HF_SHARABLE | HF_SWAPABLE,
		       HAF_ZERO_INIT | HAF_LOCK);

    if (scanner) {
	sptr = (SGMLScanner *) MemDeref(scanner);
	
	sptr->SGMLS_put = ThreadAllocSem(1);
	sptr->SGMLS_get = ThreadAllocSem(0);
	sptr->SGMLS_wait = ThreadAllocSem(0);
	sptr->SGMLS_haveData = FALSE;

	sptr->SGMLS_numOfUngotten = 0;
	sptr->SGMLS_clientDTD = dtd;
	sptr->SGMLS_target = target;

	/* Semaphore to 'V' when the parser thread terminates */
	sptr->SGMLS_parserThreadIsRunning = ThreadAllocSem(0);

	sptr->SGMLS_endOfFile = FALSE;
	sptr->SGMLS_hasTrailingWhiteSpace = TRUE;

	sptr->SGMLS_stackPos = 0;
	sptr->SGMLS_content = SGMLC_MIXED;

	sptr->SGMLS_retCode = HT_OK;

	/*
	 * We use a block for storing parsed attributes.
	 */
	sptr->SGMLS_block = MemAllocLMem(LMEM_TYPE_GENERAL, 0);
	MemModifyFlags(sptr->SGMLS_block, HF_SHARABLE, 0);

	if (sptr->SGMLS_block) {

	    MemLock(sptr->SGMLS_block);

	    for (i=0; i<MAX_SGML_ATTRIBUTES; i++) {

		sptr->SGMLS_valueCopy[i] =
		    LMemAlloc(sptr->SGMLS_block, MAX_SGML_NAME_LENGTH);

		if (!sptr->SGMLS_valueCopy[i]) {
		    /* Failed to allocate */
		    allocated = FALSE;
		    break;
		}
	    }

	    sptr->SGMLS_attr =
		LMemAlloc(sptr->SGMLS_block,
			  sizeof(SGMLEntity) * MAX_SGML_ATTRIBUTES);

	    if (!sptr->SGMLS_attr)
		allocated = FALSE;

	    MemUnlock(sptr->SGMLS_block);
	}

	MemUnlock(scanner);
    }
    
    if (!allocated) {
	SGMLScanDelete(scanner);
	return NULL;
    }

    return scanner;
}	/* End of SGMLScanNew.	*/



/***********************************************************************
 *		SGMLScanDelete
 ***********************************************************************
 *
 * SYNOPSIS:	Deletes a SGML scanner.
 * CALLED BY:	SGML parser
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/16/96   	Initial Revision
 *
 ***********************************************************************/
void  _pascal
SGMLScanDelete (SGMLScannerHandle scanner)
{
    SGMLScanner *sptr;

    MemLock(scanner);
    sptr = (SGMLScanner *) MemDeref(scanner);

    ThreadFreeSem(sptr->SGMLS_get);
    ThreadFreeSem(sptr->SGMLS_put);
    ThreadFreeSem(sptr->SGMLS_wait);
    ThreadFreeSem(sptr->SGMLS_parserThreadIsRunning);

    MemFree(sptr->SGMLS_block);

    MemFree(scanner);  /* No need to unlock */
}	/* End of SGMLScanDelete.	*/



/***********************************************************************
 *		SGMLScanAppendData
 ***********************************************************************
 *
 * SYNOPSIS:	Add data to the scanner. This should be called from a
 *              different thread than SGMLScanGetChar. The calling 
 *              thread will block until all data is consumed using
 *              SGMLScanGetChar.
 * CALLED BY:	SGML parser
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    This implements the "producer" (of the producer and 
 *              consumer problem) part of the SGML scanner. The consumer
 *              is implemented in SGMLScanGetChar.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/16/96   	Initial Revision
 *
 ***********************************************************************/
int  _pascal
SGMLScanAppendData (SGMLScannerHandle scanner, char *data, word len)
{
    SGMLScanner *sptr;
    word i;
    int ret;

    MemLock(scanner);
    sptr = (SGMLScanner *) MemDeref(scanner);

    /* 
     * Hand over data to scanner. sptr->SGMLS_data, sptr->SGMLS_len,
     * and sptr->SGMLS_dataIndex are protected resources.
     */
    ThreadPSem(sptr->SGMLS_put);

    sptr->SGMLS_data = data,
    sptr->SGMLS_len = len;
    sptr->SGMLS_dataIndex = 0;

    ThreadVSem(sptr->SGMLS_get);
    ThreadPSem(sptr->SGMLS_wait);     /* wait for data to be consumed */

    ret = sptr->SGMLS_retCode;        /* final code after all waiting
					 is done */
    MemUnlock(scanner);

    return ret;   /* Final return code from target */
}	/* End of SGMLScanAppendData.	*/


/***********************************************************************
 *		SGMLParseReference
 ***********************************************************************
 *
 * SYNOPSIS:	We have seen '&'. Parse character or entity reference.
 * CALLED BY:	SGMLParserThread.
 * RETURN:	ParseRefType
 * SIDE EFFECTS:
 *		If returning PARSE_REF_ENTITY_REF or PARSE_REF_CHAR_REF,
 *              the reference character is passed back in *refChar.
 * STRATEGY:
 *              Example of a character reference is &#258;
 *              Example of an entity reference is &gt;
 *              (The terminating semicolon is optional as whitespace
 *               can also terminate a char or entity reference)
 *
 *              It seems most people write &ltxxx to mean <xxx with no
 *              space and semicolon. So I allow this.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 8/96   	Initial Revision
 *	grisco	11/10/97	Returns reference type & ref char
 *
 ***********************************************************************/
ParseRefType _pascal
SGMLParseReference (SGMLScanner *sptr, char *refChar)
{
    int i, value;
    char c, ct;

    i = 0;

    /* Character reference */
    if ((c = SGMLScanGetChar(sptr)) == '#') {

	c = SGMLScanGetChar(sptr);
	while (ISDIGIT(c) && i < MAX_SGML_NAME_LENGTH-1) {
	    sptr->SGMLS_thisWord[i++] = c;
	    c = SGMLScanGetChar(sptr);
	}

	sptr->SGMLS_thisWord[i] = '\0';

	if (c != ';')
	    SGMLScanUngetChar(sptr, c);

	/* Translate the character reference to native representiation */
	value = atoi(sptr->SGMLS_thisWord);

	if ((value >= 0xA0) && (value < 0x100)) {
            ct = CHARACTERTRANSLATE[value-0xA0][0];
            if (ct > 0)
                *refChar = ct;
            else
                *refChar = (char) value;
        } else {
            *refChar = (char) value;
        }

	return(PARSE_REF_CHAR_REF);
	
    } else if (ISWHITE(c)) {

	return(PARSE_REF_WHITE_SPACE);

    } else if (c == '<') {

	SGMLScanUngetChar(sptr, c);
	return(PARSE_REF_LEFT_BRACKET);
    }

    /* Entity reference */
    do {
	sptr->SGMLS_thisWord[i++] = c;
	sptr->SGMLS_thisWord[i] = 0;
	
	/* 
	 * Don't expect to get a space or semicolon that 
	 * terminates the reference as most people won't bother
	 * putting it there.
	 */
	if ((value = SGMLSearchEntity(ENTITYLIST,
				      NUMOFENTITIES,
				      sptr->SGMLS_thisWord)) >= 0) {

            *refChar = ENTITYTRANSLATE[value][0];

	    /* If next char is semicolon, we have to swallow it */
	    if ((c = SGMLScanGetChar(sptr)) != ';')
		SGMLScanUngetChar(sptr, c);

	    return(PARSE_REF_ENTITY_REF);
	}
	
	c = SGMLScanGetChar(sptr);
    } while ((ISALPHA(c) || ISDIGIT(c)) &&  i < MAX_SGML_NAME_LENGTH-1);
    
    /* 
     * Otherwise we put sptr->SGMLS_thisWord as text.
     */

    SGMLScanUngetChar(sptr, c);
    for (value=i-1; value>=0; value--) {
        SGMLScanUngetChar(sptr, sptr->SGMLS_thisWord[value]);
    }
    return (PARSE_REF_NON_REFERENCE);
}	/* End of SGMLParseReference.	*/



