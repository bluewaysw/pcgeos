#define SGML_THREAD_STACK_SIZE 1024   /* No ui stuff, 1K is enough. */

#define PUTBLOCK(target, data, len)  \
        @call target::MSG_HT_STREAM_PUT_BLOCK(data, len)


/*
 * ElementError for SGMLPushEndElement
 */
typedef enum {
    ELEMENT_ACCEPTED=0,
    ELEMENT_OUT_OF_SCOPE,
    ELEMENT_REJECTED
} ElementError;


