/***********************************************************************
 *		SGMLAppendChar
 ***********************************************************************
 *
 * SYNOPSIS:	Append a character to text buffer without reducing
 *              consecutive whitespaces. Make sure you put this call
 *              in braces as the macro expands into two statements.
 * CALLED BY:	SGMLParseText.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Define as a macro for efficiency. Linefeed is not needed
 *              by the UI Generator.
 *              Any control characters (between NULL and 0x1f) are
 *              filtered out.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 8/96   	Initial Revision
 *
 ***********************************************************************/
#define SGMLAppendAllChar(sptr, chr) \
    if (/*chr == C_CR ||*/ chr == C_LF) {\
        sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = '\r'; \
        if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) \
           SGMLHandleText(sptr); \
    } else if(chr > 0x1f) { \
        sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = chr; \
        if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) \
           SGMLHandleText(sptr); \
    }

#define SGMLAppendChar(sptr, chr) \
    if(sptr->SGMLS_content == SGMLC_PREFORMATTED) {\
        if (/*chr == C_CR ||*/ chr == C_LF) {\
            sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = '\r'; \
            if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) \
               SGMLHandleText(sptr); \
        } else if(chr > 0x1f) { \
            sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = chr; \
            if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) \
                SGMLHandleText(sptr); \
	} \
    } else if (chr > 0x1f) { \
	sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = chr; \
	if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) \
	    SGMLHandleText(sptr); \
    } 

/* @@@
static void _pascal SGMLAppendChar(SGMLScanner *sptr, char chr) {
    if (chr != C_LF && chr > 0x1f) { \
	sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = chr; 

	if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) 
	    SGMLHandleText(sptr);
    }
}
@@@ */



/***********************************************************************
 *		SGMLAppendReduceWhiteChar
 ***********************************************************************
 *
 * SYNOPSIS:	Append a character to text buffer. It reduces 
 *              consecutive white spaces into one white space. 
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Define as a macro for efficiency. Linefeed is not needed
 *              by the UI Generator.
 *              Any control characters (between NULL and 0x1f) are
 *              filtered out.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/30/96   	Initial Revision
 *
 ***********************************************************************/
#define SGMLAppendReduceWhiteChar(sptr, chr) \
    if (chr > 0x1f) { \
	if (!((chr == ' ') &&  \
	      (sptr->SGMLS_textBuffer[sptr->SGMLS_textLength-1] == ' '))) { \
	    sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = chr; \
	    if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) \
		SGMLHandleText(sptr); \
	} \
    } \
/* @@@
static void _pascal SGMLAppendReduceWhiteChar(SGMLScanner *sptr, char chr) {

    if (chr > 0x1f) { \
	if (!((chr == ' ') && 
	      (sptr->SGMLS_textBuffer[sptr->SGMLS_textLength-1] == ' '))) {
	    sptr->SGMLS_textBuffer[sptr->SGMLS_textLength++] = chr; 

	    if (sptr->SGMLS_textLength == SGML_TEXT_BUFFER_SIZE) 
		SGMLHandleText(sptr); 
	}
    }
}
@@@ */


/***********************************************************************
 *		SGMLPutTokenText
 ***********************************************************************
 *
 * SYNOPSIS:	Put the current token as text.
 * CALLED BY:	SGMLIgnoreStartElement
 * RETURN:	Nothing
 *	
 * STRATEGY:	This routine implements the opposite of SGMLGobbleSym.
 *              Here we convert the symbol into its text equivalent and
 *              put it to target.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
SGMLPutTokenText (SGMLScanner *sptr)
{
    switch (sptr->SGMLS_thisSym) {
    case SGMLT_STRING:
	{
	    int i;
	    int length = strlen(sptr->SGMLS_thisWord);
	    for (i=0; i<length; i++) {
		SGMLAppendChar(sptr, sptr->SGMLS_thisWord[i]);
	    }
	}
	break;
    case SGMLT_CLOSE_BRACKET:
	SGMLAppendChar(sptr, '>');
	break;
    case SGMLT_EQUAL:
	SGMLAppendChar(sptr, '=');
	break;
    case SGMLT_DOUBLE_QUOTE:
	SGMLAppendChar(sptr, '\"');
	break;
    case SGMLT_SINGLE_QUOTE:
	SGMLAppendChar(sptr, '\'');
	break;
    default:
	/* Ignore */
	break;
    }
}	/* End of SGMLPutTokenText.	*/



/***********************************************************************
 *		SGMLIgnoreElementCommon
 ***********************************************************************
 *
 * SYNOPSIS:	Ignore the common part of a start and end element and
 *              put it to target as text.
 * CALLED BY:	SGMLIgnoreStartElement, SGMLIgnoreEndElement
 * RETURN:	Nothing
 *	
 * STRATEGY:	Changed to not push the ignored element to target although
 *              QA thinks otherwise - 11/10/97 -kkee
 *              So I commented out code that calls SGMLAppendChar.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
SGMLIgnoreElementCommon (SGMLScanner *sptr)
{
    char c;
    /* SGMLPutTokenText(sptr); */

    /* Treat attrs (if any) as text */
    do {
	if (sptr->SGMLS_content == SGMLC_PREFORMATTED) { 
	    /* Accepts white spaces */
	    c = SGMLScanGetChar(sptr);
	} else {
	    c = SGMLScanGetReduceWhiteChar(sptr);
	}
	if (sptr->SGMLS_endOfFile) break; /* End of file */
	if (c=='>') {
	    /* SGMLAppendChar(sptr, c); */
	    break; /* Done */
	} else if (c=='<') {
	    /* Start of an element, unget it */
	    SGMLScanUngetChar(sptr, c);
	    break; /* Done */
	} else {
	    /* SGMLAppendChar(sptr, c); */
	}
    } while (1);
}	/* End of SGMLIgnoreElementCommon.	*/



/***********************************************************************
 *		SGMLIgnoreStartElement
 ***********************************************************************
 *
 * SYNOPSIS:	Skip an element and all its attributes. The skipped 
 *              text is treated as plain text.
 * CALLED BY:	SGMLParseStartElement
 * RETURN:	Nothing
 *	
 * STRATEGY:	Changed to not push the ignored element to target although
 *              QA thinks otherwise - 11/10/97 -kkee
 *              So I commented out code that calls SGMLAppendChar.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
SGMLIgnoreStartElement (SGMLScanner *sptr)
{
    /* Treat the element as text */
    /* SGMLAppendChar(sptr, '<'); */
    SGMLIgnoreElementCommon(sptr);
}	/* End of SGMLIgnoreStartElement.	*/



/***********************************************************************
 *		SGMLIgnoreEndElement
 ***********************************************************************
 *
 * SYNOPSIS:	Ignore an end element and put to target as plain text.
 * CALLED BY:	SGMLParseEndElement
 * RETURN:	Nothing
 *	
 * STRATEGY:	Changed to not push the ignored element to target although
 *              QA thinks otherwise - 11/10/97 -kkee
 *              So I commented out code that calls SGMLAppendChar.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
SGMLIgnoreEndElement (SGMLScanner *sptr)
{
    /* Treat the element as text */
    /* SGMLAppendChar(sptr, '<'); */
    /* SGMLAppendChar(sptr, '</'); */
    SGMLIgnoreElementCommon(sptr);
}	/* End of SGMLIgnoreEndElement.	*/



/***********************************************************************
 *		SGMLGarbageCollectStack
 ***********************************************************************
 *
 * SYNOPSIS:	Attempt to claim some room from the element stack.
 * CALLED BY:	SGMLHandleStartElement
 * RETURN:	Nothing
 *	
 * STRATEGY:	We garbage collect without breaking the integrity of 
 *              stack. This is done in the following order:
 *                  1. First throw away very trivial tags from the stack.
 *                  2. If step 1 did not make any room, then start popping
 *                     from the stack those elements that are less important
 *                     than tptr (that is, elements whose end scope is
 *                     greater than tptr end scope).
 *                  3. If step 2 fails, then don't garbage collect.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/25/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
SGMLGarbageCollectStack (SGMLScanner *sptr, SGMLTag *tptr)
{
    word claimed = 0;
    int i, j;

    /* Step 1: garbage collectable tags */
    for (i=sptr->SGMLS_stackPos-1; i>=0; i--) {
	if (sptr->SGMLS_elementStack[i]->SGMLT_endScope ==
	    SGMLT_GARBAGE_COLLECT) {
	    sptr->SGMLS_elementStack[i] = 0;  /* Throw away */
	    j = i;
	    claimed += 1;
	}
    }
    /* Compact the stack */
    if (claimed) {
	for (i=j+1; i<sptr->SGMLS_stackPos; i++) {
	    if (sptr->SGMLS_elementStack[i]) {
		sptr->SGMLS_elementStack[j] = sptr->SGMLS_elementStack[i];
		sptr->SGMLS_elementStack[i] = 0; /* For safety */
		j += 1;
	    }
	}
	sptr->SGMLS_stackPos -= claimed;
	/* If necessary, change current content model */
	/* @@@ */
	return;
    }

    /* Step 2: check priority */
    if (sptr->SGMLS_elementStack[sptr->SGMLS_stackPos-1]->
	SGMLT_endScope > tptr->SGMLT_endScope){
	SGMLHandleEndElement(sptr,
			     sptr->SGMLS_elementStack[sptr->SGMLS_stackPos-1]);
    }
}	/* End of SGMLGarbageCollectStack.	*/



/***********************************************************************
 *		SGMLHandleStartElement
 ***********************************************************************
 *
 * SYNOPSIS:	Push a token onto our element stack.
 * CALLED BY:	SGMLParseStartElement.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/13/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
SGMLHandleStartElement (SGMLScanner *sptr, SGMLTag *tptr)
{
    /* See if there is buffered text, push text first */
    if (sptr->SGMLS_textLength) SGMLHandleText(sptr);

    if (sptr->SGMLS_stackPos == SGML_MAX_ELEMENT_NESTING_LEVEL) {
	/* 
	 * If tptr is more important (has lower endScope) than
	 * those at the upper 1/2 (last 50) of the element stack.
	 * Remove as many of those items to make room for tptr and
	 * subsequent tags.
	 */
	EC_WARNING(EXCEED_MAX_ELEMENT_NESTING_LEVEL);
	SGMLGarbageCollectStack(sptr, tptr);
	if (sptr->SGMLS_stackPos == SGML_MAX_ELEMENT_NESTING_LEVEL) {
	    /* 
	     * Failed to claim space on the stack to accomodate tptr,
	     * so ignore tptr.
	     */
	    return HT_OK;
	}
    }
	
    /* Update our element stack */
    if (tptr->SGMLT_content != SGMLC_EMPTY) {
	sptr->SGMLS_elementStack[sptr->SGMLS_stackPos++] = tptr;

	if(tptr->SGMLT_content != SGMLC_MIXED) {
	    char chr;

	    sptr->SGMLS_content = tptr->SGMLT_content;
	    /*
	     * reduce the first RETURN character 
	     */
	    chr = SGMLScanGetChar(sptr);
	    if(chr != C_CR && chr != C_LF) SGMLScanUngetChar(sptr, chr);
	}
    }

    if(tptr->SGMLT_content != SGMLC_IGNORE) {
	/* Now push the element to target */
	return @call sptr->SGMLS_target::
	    MSG_HT_STRUCTURED_PUT_START_ELEMENT(tptr->SGMLT_token,
					    sptr->SGMLS_block,
					    sptr->SGMLS_attr);
    } else
	return HT_OK;
}	/* End of SGMLHandleStartElement.	*/



/***********************************************************************
 *		SGMLPushEndElement
 ***********************************************************************
 *
 * SYNOPSIS:	Attempt to push an element to target. 
 * CALLED BY:	SGMLHandleEndElement
 * RETURN:	END_ELEMENT_ACCPTED for element push to target.
 *              END_ELEMENT_OUT_OF_SCOPE for out of scope. Element should
 *                tried again later.
 *              END_ELEMENT_REJECTED for ignoring the element.
 *	
 * STRATEGY:    If we have a start element and end element mismatch,
 *              we try to recover using Maciej Puzio's approach 
 *              (puzio@laser.mimuw.edu.pl). See
 *          http://www.w3c.org/pub/WWW/Library/User/Patch/lib_4.0_1.fix.
 *              Basically, if end element does not match the last start 
 *              element, we use the following rules.
 *              1. If we are on the last level (i.e., only <HTML> is on
 *                 element stack), we ignore the bad element.
 *              2. If there are some other start elements, we assume the 
 *                 corresponding end tags (execpt <HTML>), free those
 *                 elements from the stack, and then repeat 1 and 2.
 *                 We stop when we find the matching start element or 
 *                 we are at the last level.
 *              3. Puzio's patch basically ignores the ill-nested 
 *                 end element if it does not have a corresponding
 *                 start element on the element stack.
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	7/13/97   	Initial Revision
 *	
 ***********************************************************************/
static ElementError _pascal
SGMLPushEndElement (SGMLScanner *sptr, SGMLTag *tptr)
{
    int i, index;

    if ((tptr->SGMLT_content == SGMLC_EMPTY) || 
	!sptr->SGMLS_stackPos) 
	return ELEMENT_REJECTED;

    /*
     * If the end element does not have a corresponding start element
     * on the stack, it is ignored.
     */
    index = -1;
    for (i=sptr->SGMLS_stackPos-1; i>=0; i--) {
	if (sptr->SGMLS_elementStack[i] == tptr) {
	    index = i;
	    break;  /* found */
	}
    }

    if (index == -1) return ELEMENT_REJECTED;  /* Ignored! */

    /* 
     * Start popping all the start elements on the stack until the 
     * the matching element.
     *
     * 7/13/97. I added scoping to prevent trivial elements (e.g, FONT)
     * from correcting important elements (e.g., FORM).
     */
    for(i=sptr->SGMLS_stackPos-1; i>=index; i--) {
	if (tptr->SGMLT_endScope > sptr->SGMLS_elementStack[i]->SGMLT_endScope) {
	    sptr->SGMLS_stackPos = i+1;
	    return ELEMENT_OUT_OF_SCOPE;

	} else {
	    @call sptr->SGMLS_target::
		MSG_HT_STRUCTURED_PUT_END_ELEMENT(
		  sptr->SGMLS_elementStack[i]->SGMLT_token);

	    /* End preformatted content? */
	    if(tptr->SGMLT_content == sptr->SGMLS_content)
		sptr->SGMLS_content = SGMLC_MIXED;
	}
    }

    sptr->SGMLS_stackPos = index;
    return ELEMENT_ACCEPTED;
}	/* End of SGMLPushEndElement.	*/




/***********************************************************************
 *		SGMLHandleEndElement
 ***********************************************************************
 *
 * SYNOPSIS:	Pop a tag from the element stack. 
 * CALLED BY:	SGMLParseEndElement.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:    If we have a start element and end element mismatch,
 *              we try to recover using Maciej Puzio's approach 
 *              (puzio@laser.mimuw.edu.pl). See
 *          http://www.w3c.org/pub/WWW/Library/User/Patch/lib_4.0_1.fix.
 *              Basically, if end element does not match the last start 
 *              element, we use the following rules.
 *              1. If we are on the last level (i.e., only <HTML> is on
 *                 element stack), we ignore the bad element.
 *              2. If there are some other start elements, we assume the 
 *                 corresponding end tags (execpt <HTML>), free those
 *                 elements from the stack, and then repeat 1 and 2.
 *                 We stop when we find the matching start element or 
 *                 we are at the last level.
 *              3. Puzio's patch basically ignores the ill-nested 
 *                 end element if it does not have a corresponding
 *                 start element on the element stack.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/13/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLHandleEndElement (SGMLScanner *sptr, SGMLTag *tptr)
{
    ElementError err;
    int i;

    /* 
     * Before we push the end element, we must flush all buffered
     * text, if any. 
     */
    if (sptr->SGMLS_textLength)	SGMLHandleText(sptr);

    err = SGMLPushEndElement(sptr, tptr);
    if (err == ELEMENT_REJECTED) return;
    if (err == ELEMENT_OUT_OF_SCOPE &&
	sptr->SGMLS_delayPos < SGML_MAX_ELEMENT_NESTING_LEVEL) {
	sptr->SGMLS_delayStack[sptr->SGMLS_delayPos++] = tptr;
	return;
    }
    /* We can only proceed to attempt to push delayed elements
     * when the current element gets ELEMENT_ACCEPTED.
     */
    for (i=sptr->SGMLS_delayPos-1; i>=0; i--) {
	err = SGMLPushEndElement(sptr, sptr->SGMLS_delayStack[i]);
	if (err == ELEMENT_OUT_OF_SCOPE) {
	    sptr->SGMLS_delayPos = i+1;
	    return;
	}	    
    }
    /* All delay elements accepted or rejected */
    sptr->SGMLS_delayPos = 0;
}	/* End of SGMLHandleEndElement.	*/




/***********************************************************************
 *		SGMLHandleText
 ***********************************************************************
 *
 * SYNOPSIS:	Push text to target.
 * CALLED BY:	SGMLParse... routines.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:       If we had previously pushed text with a trailing
 *                 whitespace AND the current text to push has a 
 *                 leading white space, we ignore the leading 
 *                 whitespace. Initially 
 *                 sptr->SGMLS_hasTrailingWhiteSpace is set to TRUE.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/15/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLHandleText (SGMLScanner *sptr)
{
EC( if (!sptr->SGMLS_textLength)                                        )
EC(    EC_ERROR(TEXT_BUFFER_IS_EMPTY);                                  )

    if(sptr->SGMLS_content == SGMLC_LITERAL 
       || sptr->SGMLS_content == SGMLC_PREFORMATTED) {
	PUTBLOCK(sptr->SGMLS_target,
		 sptr->SGMLS_textBuffer, 
		 sptr->SGMLS_textLength);

	sptr->SGMLS_textLength = 0;
	return;
    }
	

    /* Check for trailing and leading white spaces */
    if (sptr->SGMLS_hasTrailingWhiteSpace &&
	sptr->SGMLS_textBuffer[0] == ' ') {
	
	if (sptr->SGMLS_textLength > 1)
	    PUTBLOCK(sptr->SGMLS_target,
		     sptr->SGMLS_textBuffer+1, 
		     sptr->SGMLS_textLength-1);

    } else {

	PUTBLOCK(sptr->SGMLS_target,
		 sptr->SGMLS_textBuffer, 
		 sptr->SGMLS_textLength);

    }

    if (sptr->SGMLS_textBuffer[sptr->SGMLS_textLength-1] == ' ')
	sptr->SGMLS_hasTrailingWhiteSpace = TRUE;

    else
	sptr->SGMLS_hasTrailingWhiteSpace = FALSE;

    sptr->SGMLS_textLength = 0;
}	/* End of SGMLHandleText.	*/





/***********************************************************************
 *		SGMLParseStartElement
 ***********************************************************************
 *
 * SYNOPSIS:	We have seen "<?". So parse a start element.
 * CALLED BY:	SGMLParseOpenBracket
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:    
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 2/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
SGMLParseStartElement (SGMLScanner *sptr)
{
    int index = -1;
    SGMLEntity *alist;

    SGMLScanGobbleSym(sptr);

    if (sptr->SGMLS_thisSym == SGMLT_STRING)
	index = SGMLSearchTag(TAGLIST,
			      NUMOFTAGS,
			      sptr->SGMLS_thisWord);

    if (index > -1) {
	/* Found the tag in DTD! */

	if (TAGLIST[index].SGMLT_attrList)
	    SGMLParseElementAttrs(sptr, &TAGLIST[index]);

	else {
	    /* Element has no attrs, so ignore if there is any */
	    SGMLIGNOREATTR(sptr);

	    MemLock(sptr->SGMLS_block);

	    alist = (SGMLEntity *) LMemDerefHandles(sptr->SGMLS_block,
						    sptr->SGMLS_attr);
	    alist[0].SGMLE_token = 0;    /* Terminate attr list */
	    alist[0].SGMLE_value = NULL;  

	    MemUnlock(sptr->SGMLS_block);
	}    

	return SGMLHandleStartElement(sptr, &TAGLIST[index]);
	
    } else {
	/* Tag not found in DTD, treat as text */
	SGMLIgnoreStartElement(sptr);
/* @@@
EC(	EC_WARNING(UNKNOWN_START_ELEMENT);                            )
@@@ */
    }
    return HT_OK;

}	/* End of SGMLParseStartElement.	*/




/***********************************************************************
 *		SGMLParseElementAttrs
 ***********************************************************************
 *
 * SYNOPSIS:	Parse the attributes of an element. 
 * CALLED BY:	SGMLParserStartElement.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Attributes in the form of 
 *              name or
 *              name = value or 
 *              name = "value"
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLParseElementAttrs (SGMLScanner *sptr, SGMLTag *tptr)
{
    SGMLAttr *aptr;
    SGMLEntity *alist;
    char chr, *cptr;
    int i, index = 0, attrIndex = -1;

EC( ECCheckLMemOD(tptr->SGMLT_attrList);                                 )

    /* Initialize SGMLEntity list */
    MemLock(sptr->SGMLS_block);
    alist = (SGMLEntity *) LMemDerefHandles(sptr->SGMLS_block,
					    sptr->SGMLS_attr);
    
    alist[0].SGMLE_token = 0;      /* init list to null */
    alist[0].SGMLE_value = NULL;

    aptr = (SGMLAttr *) LMemDeref(tptr->SGMLT_attrList);

    SGMLScanGobbleSym(sptr);
    do {

	switch(sptr->SGMLS_thisSym) {

	case SGMLT_STRING:
	    /* We have gobbled an attribute name in sptr->SGMLS_thisWord */
	    if ((attrIndex = SGMLSearchAttr(aptr, 
					    tptr->SGMLT_numOfAttrs,
					    sptr->SGMLS_thisWord))
		> -1) {

		if (index < MAX_SGML_ATTRIBUTES) {

		    alist[index++].SGMLE_token = 
			aptr[attrIndex].SGMLA_token;
		    alist[index].SGMLE_value = NULL;

		    alist[index].SGMLE_token = 0;      /* end of list */
		    alist[index].SGMLE_value = NULL;   
		}
/* @@@
#if ERROR_CHECK
		else if (index >= MAX_SGML_ATTRIBUTES)
		    EC_WARNING(ATTRIBUTE_ARRAY_TOO_SMALL);
#endif
@@@ */
		SGMLScanGobbleSym(sptr);

		if (sptr->SGMLS_thisSym == SGMLT_EQUAL){
		    /* Attribute has a value */

		    alist[index-1].SGMLE_value =
			sptr->SGMLS_valueCopy[index-1];

		    cptr = (char *)
			LMemDerefHandles(sptr->SGMLS_block,
					 alist[index-1].SGMLE_value);
		    *cptr = 0; /* In case value is NULL */

		    /* Single or double quoted value */
		    if ((chr = SGMLScanGetNonWhiteChar(sptr)) == '\"')
			SGMLScanGobbleQuotedValue(sptr, cptr, '\"');
		    else if(chr == '\'')
			SGMLScanGobbleQuotedValue(sptr, cptr, '\'');
		    else {
			SGMLScanUngetChar(sptr, chr);
			SGMLScanGobbleValue(sptr, cptr);
		    }

		    SGMLScanGobbleSym(sptr);  /* go to next token */

		} 

	    } else {
/* @@@
EC(		EC_WARNING(UNKNOWN_ATTRIBUTE_NAME);                   )
@@@ */
                SGMLScanGobbleSym(sptr);

                if (sptr->SGMLS_thisSym == SGMLT_EQUAL) {
		    /* Throw away */
		    SGMLScanGobbleValue(sptr, sptr->SGMLS_thisWord);
		    SGMLScanGobbleSym(sptr);    /* go to next token */
		}
	    }

	    break;

	case SGMLT_CLOSE_BRACKET:
	case SGMLT_XXX_EOF:
	    break;  /* done */

	default:
	    /* Ignoring other SGML tokens */
	    SGMLScanGobbleSym(sptr);
	    break;
	}

    } while ((sptr->SGMLS_thisSym != SGMLT_CLOSE_BRACKET) &&
	     (sptr->SGMLS_thisSym != SGMLT_XXX_EOF));

    MemUnlock(sptr->SGMLS_block);
}	/* End of SGMLParseElementAttrs.	*/




/***********************************************************************
 *		SGMLParseEndElement
 ***********************************************************************
 *
 * SYNOPSIS:	We have seen "</". So parse an end element.
 * CALLED BY:	SGMLParseOpenBracket
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Although "</ " (with spaces) is not an end element, we
 *              treat it so. Both for speed and valid assumption.
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 2/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLParseEndElement (SGMLScanner *sptr)
{
    int index = -1;

    /* Now we gobble till '>' */
    SGMLScanGobbleSym(sptr);
    if (sptr->SGMLS_thisSym == SGMLT_STRING) {
	index = SGMLSearchTag(TAGLIST, 
			      NUMOFTAGS,
			      sptr->SGMLS_thisWord);
    }
    if (index != -1) {
	/* Valid end element */
	SGMLHandleEndElement(sptr, &TAGLIST[index]);
	/* Ignore till '>' */
	SGMLIGNOREATTR(sptr);
    } else {
	SGMLIgnoreEndElement(sptr);
    }
}	/* End of SGMLParseEndElement.	*/




/***********************************************************************
 *		SGMLParseOpenBracket
 ***********************************************************************
 *
 * SYNOPSIS:	We have seen an '<', parse the rest.
 * CALLED BY:	SGMLParserThread.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:    <tag               => a start element
 *              </tag              => an end element
 *              < tag              => treated as <tag
 *              <!--               => begin of comment
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 2/96   	Initial Revision
 *
 ***********************************************************************/
static int _pascal
SGMLParseOpenBracket (SGMLScanner *sptr)
{
    char c;

    c = SGMLScanGetChar(sptr);


    /* 
     * Although c may be a whitespace, but we don't care. We need to 
     * assume its a tag. We do this to improve performance.
     *
     * if (ISWHITE(c)) {
     *	SGMLAppendChar(sptr, c);
     *	SGMLParseText(sptr);
     * }
     */

    if (c == '/')
	SGMLParseEndElement(sptr);

    else if (c == '!')
	SGMLParseComment(sptr);

    else { 
	SGMLScanUngetChar(sptr, c);
	return SGMLParseStartElement(sptr);
    }
    return HT_OK;
}	/* End of SGMLParseOpenBracket.	*/




/***********************************************************************
 *		SGMLParseComment
 ***********************************************************************
 *
 * SYNOPSIS:	We have seen '<!'. Parse the rest of the comment.
 * CALLED BY:	SGMLParseOpenBracket.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:	Strip the following comments:
 *    
 *              <!-- Comment line 1 --  -- Comment line 2 -->
 *
 *              <!- Comment line 1 --  -- Comment line 2 ->
 *
 *              <! ... > This is also a comment.
 *
 *              <!- ... > Thiis a also a comment.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 4/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLParseComment (SGMLScanner *sptr)
{
    char chr;

    /* 
     * No need to check for sptr->SGMLS_endOfFile until the while 
     * statement. We do this to improve performance.
     */
    /* Comment without !-- */
    if (SGMLScanGetChar(sptr) != '-' || SGMLScanGetChar(sptr) != '-') {
	while ((SGMLScanGetChar(sptr) != '>') &&
	       !sptr->SGMLS_endOfFile);

	return;
    }

    /* Comment with !--  */
    do {

	while(SGMLScanGetChar(sptr) != '-' && !sptr->SGMLS_endOfFile);

	if(SGMLScanGetChar(sptr) == '-') {
	    if((chr = SGMLScanGetChar(sptr)) == '>') {
		break;
	    } else {
		SGMLScanUngetChar(sptr, '-');
		SGMLScanUngetChar(sptr, chr);
	    }
	} 

    } while(!sptr->SGMLS_endOfFile);

}	/* End of SGMLParseComment.	*/





/***********************************************************************
 *		SGMLParseText
 ***********************************************************************
 *
 * SYNOPSIS:	Parse text until we see a token.
 * CALLED BY:	SGMLParserThread.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Stop when we see '<' or '&'.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 2/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLParseText (SGMLScanner *sptr)
{
    char c, ct;

    if (sptr->SGMLS_content == SGMLC_PREFORMATTED)
	c = SGMLScanGetChar(sptr);
    else
	c = SGMLScanGetReduceWhiteChar(sptr);

    while ((c != '<') && (c != '&') && (!sptr->SGMLS_endOfFile)) {

        /*
         * Convert the character to local format if there is
         * a mapping for it in the translation table.
         */
        if ((c >= 0xA0) && (c < 0x100)) {
            ct = CHARACTERTRANSLATE[c-0xA0][0];
            if (ct > 0)
                c = ct;
        }

	SGMLAppendChar(sptr, c);

	/* 
	 * SGMLC_PREFORMATTED content model accepts all whitespaces.
	 */
	if (sptr->SGMLS_content == SGMLC_PREFORMATTED)

	    c = SGMLScanGetChar(sptr);

	else
	    /* SGMLC_MIXED */
	    c = SGMLScanGetReduceWhiteChar(sptr);
    }

    /* 
     * We have read one character ahead.
     */
    if (!sptr->SGMLS_endOfFile)
	SGMLScanUngetChar(sptr, c);

}	/* End of SGMLParseText.	*/



/***********************************************************************
 *		SGMLParseIgnore
 ***********************************************************************
 *
 * SYNOPSIS:	Start tag and anything up to the matching end tag are
 *              ignored (client will not the start tag, end tag, and
 *              all the contents in between).
 * CALLED BY:	SGMLParserThread.
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	9/22/97   	Initial Revision
 *	
 ***********************************************************************/
static void _pascal
SGMLParseIgnore (SGMLScanner *sptr)
{
    word i, length;
    int index;
    char chr;

#if ERROR_CHECK
    if (!sptr->SGMLS_stackPos)
	EC_ERROR(EXPECTED_START_ELEMENT_MISSING);
#endif

    /* 
     * Flush buffer if there is any text in it as we are going to 
     * use the buffer. 
     */
    if (sptr->SGMLS_textLength)
	SGMLHandleText(sptr);

    /* Ignore leading white spaces */
    chr = SGMLScanGetNonWhiteChar(sptr);

    do {
	
	if (chr == '<') {

	    if ((chr = SGMLScanGetChar(sptr)) == '/') {

		chr = SGMLScanGetChar(sptr);
		if (!ISWHITE(chr)) {

		    SGMLScanUngetChar(sptr, chr);
		    SGMLScanGobbleSym(sptr);

		    if (((index = 
			  SGMLSearchTag(TAGLIST,
					NUMOFTAGS,
					sptr->SGMLS_thisWord)) > -1) &&
			(TAGLIST[index].SGMLT_token == 
			 sptr->SGMLS_elementStack[sptr->SGMLS_stackPos-1]->SGMLT_token)) {

			SGMLIGNOREATTR(sptr);

			sptr->SGMLS_stackPos --;
			break;  /* done! exit the while loop */
		    }
		}
	    } else if (chr == '!')
		SGMLParseComment(sptr);
	}
	    
	chr = SGMLScanGetChar(sptr);

    } while (!sptr->SGMLS_endOfFile);

    sptr->SGMLS_content = SGMLC_MIXED;
}	/* End of SGMLParseIgnore.	*/





/***********************************************************************
 *		SGMLParseLiteral
 ***********************************************************************
 *
 * SYNOPSIS:	Parse literal text until the expected end element
 *              is encountered. 
 * CALLED BY:	SGMLParserThread
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:  
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 8/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
SGMLParseLiteral (SGMLScanner *sptr)
{
    word i, length;
    int index;
    char chr;

#if ERROR_CHECK
    if (!sptr->SGMLS_stackPos)
	EC_ERROR(EXPECTED_START_ELEMENT_MISSING);
#endif

    /* 
     * Flush buffer if there is any text in it as we are going to 
     * use the buffer. 
     */
    if (sptr->SGMLS_textLength)
	SGMLHandleText(sptr);

    /* Ignore leading white spaces */
    chr = SGMLScanGetChar(sptr);

    do {
	
	if (chr == '<') {

	    if ((chr = SGMLScanGetChar(sptr)) == '/') {

		chr = SGMLScanGetChar(sptr);
		if (!ISWHITE(chr)) {

		    SGMLScanUngetChar(sptr, chr);
		    SGMLScanGobbleSym(sptr);

		    if (((index = 
			  SGMLSearchTag(TAGLIST,
					NUMOFTAGS,
					sptr->SGMLS_thisWord)) > -1) &&
			(TAGLIST[index].SGMLT_token == 
			 sptr->SGMLS_elementStack[sptr->SGMLS_stackPos-1]->SGMLT_token)) {

			/* Found the element to end the literal content */
			/* Ignore attrs if any */
			SGMLIGNOREATTR(sptr);

			break;  /* done! exit the while loop */
		    }

		    SGMLAppendAllChar(sptr, '<');
		    SGMLAppendAllChar(sptr, '/');

		    length = strlen(sptr->SGMLS_thisWord);
		    for (i=0; i<length; i++) {
			SGMLAppendAllChar(sptr, sptr->SGMLS_thisWord[i]);
		    }

		} else { 
		    SGMLAppendAllChar(sptr, '<');
		    SGMLAppendAllChar(sptr, '/');
		    SGMLAppendAllChar(sptr, chr);
		}

	    } else {
		SGMLAppendAllChar(sptr, '<');
		SGMLAppendAllChar(sptr, chr);
	    }

	} else 
	    SGMLAppendAllChar(sptr, chr);
	    
	chr = SGMLScanGetChar(sptr);

    } while (!sptr->SGMLS_endOfFile);

    SGMLHandleEndElement(sptr, &TAGLIST[index]);
}	/* End of SGMLParseLiteral.	*/    




/***********************************************************************
 *		SGMLParserThread
 ***********************************************************************
 *
 * SYNOPSIS:	Parse an SGML document.
 * CALLED BY:	Kernel
 * RETURN:	0, required by kernel.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    We also lock down the whole DTD and we required that the
 *              whole DTD info must be in the same resource. We do this 
 *              for performance.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/18/96   	Initial Revision
 *
 ***********************************************************************/
word _pascal
SGMLParserThread (SGMLScannerHandle scanner)
{
    SGMLScanner *sptr;
    char chr, ct;
    int i;
    ParseRefType result;
    char refChar;

    MemLock(scanner);
    sptr = (SGMLScanner *) MemDeref(scanner);

    sptr->SGMLS_dtd.SGMLD_block = 
	OptrToHandle(sptr->SGMLS_clientDTD->SGMLD_tagList);

    MemLock(sptr->SGMLS_dtd.SGMLD_block);
    
    /* Now dereference all the DTD information we need for parsing */
    TAGLIST = (SGMLTag *) LMemDeref(sptr->SGMLS_clientDTD->SGMLD_tagList);

    NUMOFTAGS = sptr->SGMLS_clientDTD->SGMLD_numOfTags;

    ENTITYLIST = (char **) LMemDeref(sptr->SGMLS_clientDTD->SGMLD_entityList);

    ENTITYTRANSLATE = 
	(char **) LMemDeref(sptr->SGMLS_clientDTD->SGMLD_entityTranslate);

    CHARACTERTRANSLATE = 
	(char **) LMemDeref(sptr->SGMLS_clientDTD->SGMLD_characterTranslate);

    NUMOFENTITIES = sptr->SGMLS_clientDTD->SGMLD_numOfEntities;

    /* Enter main parsing loop ... */
    do {
	if (sptr->SGMLS_endOfFile)
	    break;  /* out of the while loop and exit */

	/*
	 * Parse according to current content model.
	 */
	if (sptr->SGMLS_content == SGMLC_LITERAL)
	    SGMLParseLiteral(sptr);

	else if (sptr->SGMLS_content == SGMLC_IGNORE)
	    SGMLParseIgnore(sptr);

	else {
	    if (sptr->SGMLS_content == SGMLC_PREFORMATTED)
		chr = SGMLScanGetChar(sptr);
	    else
		chr = SGMLScanGetReduceWhiteChar(sptr);

	    if (chr == '<') {
		sptr->SGMLS_retCode = SGMLParseOpenBracket(sptr);
		if (sptr->SGMLS_retCode != HT_OK) break;
	    } else if (chr == '&') {
		result = SGMLParseReference(sptr, &refChar);
                switch (result) {
                    case PARSE_REF_ENTITY_REF:
                    case PARSE_REF_CHAR_REF:
                        SGMLAppendChar(sptr, refChar);
                        break;
                    case PARSE_REF_WHITE_SPACE: {
                        SGMLAppendChar(sptr, '&');
                        SGMLAppendChar(sptr, ' ');
                        }
                        break;
                    case PARSE_REF_LEFT_BRACKET:
                    case PARSE_REF_NON_REFERENCE:
                        SGMLAppendChar(sptr, '&');
                        break;
                    default:
                        break;
                 }
	    } else {
		/* If it's an ISO character, convert to GEOS first */

                if ((chr >= 0xA0) && (chr < 0x100)) {
                    ct = CHARACTERTRANSLATE[chr-0xA0][0];
                    if (ct > 0)
                       chr = ct;
                }
                
		if (sptr->SGMLS_content == SGMLC_PREFORMATTED) {
		    SGMLAppendChar(sptr, chr); 
		} else {
		    SGMLAppendReduceWhiteChar(sptr, chr);
		}
		SGMLParseText(sptr);
	    }

	}

    } while (!sptr->SGMLS_endOfFile);

    if (sptr->SGMLS_retCode == HT_OK) {
	/* 
	 * If there is buffered data, flush it. We do not buffer elements.
	 */
	if (sptr->SGMLS_textLength) 
	    SGMLHandleText(sptr);

	/* If there is leftover start elements on element stack, push them
	 * all to the target 
	 */
	while (sptr->SGMLS_stackPos)
	    SGMLHandleEndElement(sptr, 
		sptr->SGMLS_elementStack[sptr->SGMLS_stackPos-1]);

    } else {
	ThreadVSem(sptr->SGMLS_wait);     /* don't wait for data anymore */
    }

    /* Unlock the DTD */
    MemUnlock(sptr->SGMLS_dtd.SGMLD_block);

    /* Inform SGML content handler that the parser thread is exiting. */
    ThreadVSem(sptr->SGMLS_parserThreadIsRunning);

    /* 
     * We should not unlock scanner since the scanner is being deleted
     * by the parser once we've encountered token SGMLT_XXX_EOF.
     */

    return 0;
}	/* End of SGMLParserThread.	*/



/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_HT_STREAM_SET_TARGET for SGMLClass
 ***********************************************************************
 *
 * SYNOPSIS:	    We need to get a DTD from the target.
 * PARAMETERS:	    void (HTStreamHandle target)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
@method SGMLClass, MSG_HT_STREAM_SET_TARGET
{
    @callsuper();

    @self->SGMLI_dtd = (SGMLDTD *) @call target::
	MSG_HT_STRUCTURED_GET_DTD();
}	/* End of MSG_HT_STREAM_SET_TARGET.	*/




/***********************************************************************
 *		MSG_HT_STREAM_ABORT for SGMLClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Delete scanner and abort self.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Wait for parser thread to terminate and then we can
 *                  safe free the scanner.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/15/96   	Initial Revision
 *
 ***********************************************************************/
@method SGMLClass, MSG_HT_STREAM_ABORT
{
    SGMLScanner *sptr;

    /* 
     * Becareful that we may not have created a scanner when we get 
     * the abort message. This happens when the stream is aborted
     * as soon as it gets created (like user stopping before we
     * load any data).
     */
    if (@self->SGMLI_scanner) {

	MemLock(@self->SGMLI_scanner);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	sptr = (SGMLScanner *) MemDeref(@self->SGMLI_scanner);

	/* Tell scanner there is no more data to scan */
	sptr->SGMLS_endOfFile = TRUE;

	/* Then we wait for scanner to terminate */
	ThreadPSem(sptr->SGMLS_parserThreadIsRunning);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	MemUnlock(@self->SGMLI_scanner);
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	SGMLScanDelete(@self->SGMLI_scanner);
    }

    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/




/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for SGMLClass
 ***********************************************************************
 *
 * SYNOPSIS:	    text/SGML parser.
 * PARAMETERS:	    int (byte *data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        We append the data to SGML content-handler (which
 *                  is actually appending to the SGML scanner), force
 *                  queue a message to ourself and return. We can do
 *                  this because all content handlers run in the client
 *                  content thread, while this API MSG_HT_STREAM_PUT_BLOCK
 *                  is called from the Library HTCore thread.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/15/96   	Initial Revision
 *
 ***********************************************************************/
static word (*const SGMLParserFunc)(word) = &SGMLParserThread;

@method SGMLClass, MSG_HT_STREAM_PUT_BLOCK
{

#if ERROR_CHECK
    if (!@self->SGMLI_dtd)
	EC_ERROR(SGML_CANNOT_PARSE_WITHOUT_A_DTD);
#endif

    /* Ignore empty data */
    if (!data || !len) return HT_OK;

    /* Create a SGML scanner and parser */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    if (!@self->SGMLI_scanner) {
	@self->SGMLI_scanner = SGMLScanNew(@self->SGMLI_dtd,
					   @self->HTSI_target);

@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	if (!@self->SGMLI_scanner) return HT_OUT_OF_MEMORY;

	/* Start the parsing process */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	if (!@self->SGMLI_parserThread)
	    @self->SGMLI_parserThread = 
		ThreadCreate(PRIORITY_HIGH,
			     @self->SGMLI_scanner,
			     SGMLParserFunc,
			     SGML_THREAD_STACK_SIZE,
			     GeodeGetCodeProcessHandle());
    }

    /* Produce data for scanner (data is consumed by SGMLScanGetChar) */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
    return SGMLScanAppendData(@self->SGMLI_scanner, (char *)data, len);
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/



