 * #####################################################################
 */

/***********************************************************************
 *		MSG_UI_GET_ROW_POSITION for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/17/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenFormTriggerClass, MSG_UI_GET_ROW_POSITION
{
