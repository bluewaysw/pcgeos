/***********************************************************************
 *		MSG_TEXT_AREA_APPEND_TEXT_PTR for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the initial text.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_APPEND_TEXT_PTR
{
    char *cptr;
    int length = len;

    if(!length) length = strlen(text);
    cptr = HTMemAllocAndLockWID(0, &(@self->TAI_text), length+1);

    strncpy(cptr, text, length);

    *(cptr + length) = 0;
    
    HTMemUnlock(@self->TAI_text);

}	/* End of MSG_TEXT_AREA_APPEND_TEXT_PTR.	*/


/***********************************************************************
 *		MSG_TEXT_AREA_SUBMIT for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    When user press submit button, copy the current text
 *                  from the text object to the query list.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_SUBMIT
{
    int len;
    HTMemHandle temp;
    char *value;

    if(@self->TAI_name) {
	len = @call @self->TAI_textObj::MSG_VIS_TEXT_GET_TEXT_SIZE();
	if (len <= 0) return;
	/*
	 *  Append the "name".
	 */
	temp = HTStrHTMemAllocCopyWID(0, @self->TAI_name);
	HTListAppend(query, &temp, sizeof(HTMemHandle));
	/*
	 *  Append the value
	 */
	value = (char *) HTMemAllocAndLockWID(0, &temp, sizeof(char) * (len+1));
	@call @self->TAI_textObj::MSG_VIS_TEXT_GET_ALL_PTR(value);
	HTMemUnlock(temp);
	HTListAppend(query, &temp, sizeof(HTMemHandle));
    }
    return;

}	/* End of MSG_TEXT_AREA_SUBMIT.	*/


/***********************************************************************
 *		MSG_TEXT_AREA_RESET for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    When user press reset button, reset the text object
 *                  to use the initial text.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_GEN_RESET
{
    char *ptr;

    @call @self->TAI_textObj::MSG_GEN_RESET();

    if(@self->TAI_text) {
	ptr = HTMemLock(@self->TAI_text);
	@call @self->TAI_textObj::MSG_VIS_TEXT_REPLACE_ALL_PTR(ptr, 0);
	HTMemUnlock(@self->TAI_text);
    } else 
	@call @self->TAI_textObj::MSG_VIS_TEXT_REPLACE_ALL_PTR("", 0);
}	/* End of MSG_TEXT_AREA_RESET.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Since the GenInteration doesn't take fixed size,
 *                  so we return our own size to overwrite the system
 *                  size for our TextArea.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_VIS_RECALC_SIZE
{
  VisCompInstance * vself;
  SizeAsDWord size;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    /* 
     * use our own size 
     */
    size = MAKE_SIZE_DWORD(@self->TAI_width, @self->TAI_length);

  /*
   *  Tell the Geometry Manager to send a messaeg instead of caling a
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  @call @self->TAI_textObj::MSG_TAT_SET_SIZE(DWORD_WIDTH(size), 
					     DWORD_HEIGHT(size)-2);

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/

/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

    if(@self->TAI_align == J_LEFT) {
	xOrigin = DWORD_X(xy) + @self->TAI_xPos;
    } else {
	lineWidth = @call @self->TAI_content::
	    MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->TAI_pageRow);
	pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
	if(@self->TAI_align == J_RIGHT) {
	    xOrigin = DWORD_X(xy) + 
		(pWidth - lineWidth + @self->TAI_xPos);
	} else {
	    xOrigin = DWORD_X(xy) + 
		(((pWidth - lineWidth)/2) + @self->TAI_xPos);
	}
    }
	
    yOrigin = DWORD_Y(xy) + 
	GetItsPotentialHeight(@self->TAI_content, @self->TAI_pageRow, oself)
	- 1;

  @call @self->TAI_textObj::MSG_TAT_SET_POSITION(xOrigin, yOrigin);

  @callsuper();

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


/***********************************************************************
 *		MSG_UI_GET_ROW_POSITION for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_UI_GET_ROW_POSITION
{
    return @self->TAI_pageRow;
}	/* End of MSG_UI_GET_ROW_POSITION.	*/


/***********************************************************************
 *		MSG_UI_SET_NEW_POSITION for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_UI_SET_NEW_POSITION
{
    @self->TAI_pageRow = row;
    @self->TAI_xPos = xPos;
}	/* End of MSG_UI_SET_NEW_POSITION.	*/


/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  /*
   *  Ask the text object's content object to figure out the size and
   *  position of the text object.
   */
  pos = UpdateItsPotentialPosition(oself,@self->TAI_content,&row,&size);

  /*
   *  Store the returned x position in the returned row number.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->TAI_xPos = pos; 
  @self->TAI_pageRow = row;
  @self->TAI_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
