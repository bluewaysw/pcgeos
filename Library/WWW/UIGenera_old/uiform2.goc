extern optr FinishCurrentObjectInForm (optr pmObj, ObjInfo *target);
void AddInputToForm(optr form, optr inputObj);


/***********************************************************************
 *		UIGen_START_FORM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	Create a ui object representing a fill-out form.
 *		Information about the form fields are expected to 
 *		be known as more incoming HTML elements are processed.
 *		    
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *	Supported Attr:	ACTION, METHOD
 *
 * INPUT, SELECT and TEXTAREA are only allowed within FORM elements.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_FORM_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr obj, content;
  int nextRow;

  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
   */
  if ((currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass) ||
      (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass) ) {
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);
    content = currentDoc->HTUI_target.obj;
  }
  else if (currentDoc->HTUI_target.obj) {
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);
    content = UIGen_GET_CONTENT_Int();
  }
  else
    content = currentDoc->HTUI_pmContent;

  /*
   *  Form always starts at a new line!
   */
  @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);

  /*
   * Now create a form object and store it in target.obj.  Next, process
   * the passed attribute list.
   */
  obj = UICreateObj(currentDoc, &HTGenFormClass);
  currentDoc->HTUI_target.obj = obj; 
  currentDoc->HTUI_target.class = (ClassStruct *)&HTGenFormClass;

  /*
   *  Process attributes
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_FORM_PROCESS_ATTRIBUTE
     (block, entity, content);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_FORM_Int.	*/


/***********************************************************************
 *		UIGen_END_FORM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the presentation manager that the form object
 *		    is ready to be displayed.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_FORM_Int()
{
  optr content;
  int nextRow;

  /* 
   * If there is some object in target.obj, we can assume the object 
   * is done.  Thus, give the object to the presentation manager for
   * rendering.
   */
  if (currentDoc->HTUI_target.obj)
	@call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
				(currentDoc->HTUI_target.obj);

  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenFormClass) {
    while (1) {
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));
      EC_ERROR_IF(currentDoc->HTUI_target.class == NULL || 
		currentDoc->HTUI_target.obj == NULL,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenSelectClass)
	@call currentDoc->HTUI_target.obj::
		MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
      else if (currentDoc->HTUI_target.class == 
				(ClassStruct *)&HTGenMultiLineSelectClass)
	@call currentDoc->HTUI_target.obj::
		MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT();
      
      if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormClass)
	  break;
    }
  }
  EC_ERROR_IF(currentDoc->HTUI_target.class != (ClassStruct *)&HTGenFormClass,
	UIG_INVALID_OPERATION_ON_UI_TREE);
  /*
   * Tell the receiving object(which must be a HTGenForm object) in 
   * the ui tree that there are no more children for it.  So the 
   * presentation manager can mark it usable and display it.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
	(&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));

  /*
   *  Objects following form always start at a new line!
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_FORM_Int.	*/

