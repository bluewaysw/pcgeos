/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenFormTriggerClass, MSG_SPEC_BUILD_BRANCH
{
  @callsuper();
  if (@self->HTGFT_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGFT_guessSize),
				 DWORD_HEIGHT(@self->HTGFT_guessSize));
  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *	UIGen_START_SELECT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a HTGenSelect object and process the 
 *		    attribute list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_SELECT_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value;
  int	index, size = 0;
  Boolean multiLine = FALSE;
  optr obj, content;

  /*
   *  Finish and append whatever ui object in the target to the ui tree.
   *  Return the form object that contains that ui object.
   */
  content=FinishCurrentObjectInForm(currentDoc->HTUI_pmanager, &(currentDoc->HTUI_target));

  /* 
   * Go to get the attributes first. Use the size to determine which 
   * kind selection object to create, either HTGenSelectClass or
   * HTGenMultiLineSelectClass.
   */

  for(index = 0; entity[index].SGMLE_token; index++) {
    if(entity[index].SGMLE_token == HTML_ATTR_MULTIPLE) {
	multiLine = TRUE;
	break;
    } else if (!entity[index].SGMLE_value)
      continue;

    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    if(entity[index].SGMLE_token == HTML_ATTR_SIZE) {
      size = atoi(value);
      if (size >= 4) {
	  multiLine = TRUE;
          break;
      }
    }
  }

  /*
   *  Now create a select object and store it in target.obj.
   *  Then, process the passed attribute list.
   */
  if(!multiLine) {
      /*
       *  Create a dummy container for the HTGenSelectClass.  This container
       *  is used to get the size of the GenItemGroup customized in the
       *  penelope SPUI.
       */
      obj = UICreateObj(currentDoc, (ClassStruct *)&HTGenOuterSelectClass);
      @call obj::MSG_GEN_OUTER_SELECT_STORE_CONTENT(content);
      currentDoc->HTUI_target.obj = obj;
      @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	 (currentDoc->HTUI_target.obj);
      /*
       *  Add the outer select object to the list of focusable objects
       */
      @call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(obj);
      /*
       *  Make the object to be able to grab focus exclusive.???
      @call obj::MSG_GEN_SET_ATTRS(GA_TARGETABLE,0);
       */
      obj = UICreateObj(currentDoc, (ClassStruct *)&HTGenSelectClass);

      currentDoc->HTUI_target.obj = obj;
      currentDoc->HTUI_target.class = (ClassStruct *)&HTGenSelectClass;
      @call currentDoc->HTUI_target.obj::MSG_GEN_SELECT_PROCESS_ATTRIBUTE
          (block, entity);

      @call currentDoc->HTUI_target.obj::MSG_META_ADD_VAR_DATA
	  (HINT_ORIENT_CHILDREN_HORIZONTALLY, 0, NULL);

      @call currentDoc->HTUI_target.obj::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED
	  (FALSE);
  } else {
      obj = UICreateObj(currentDoc, (ClassStruct *)&HTGenMultiLineSelectClass);
      @call obj::MSG_HTGMLS_STORE_CONTENT(content);

      currentDoc->HTUI_target.obj = obj;
      currentDoc->HTUI_target.class = (ClassStruct *)&HTGenMultiLineSelectClass;
      @call currentDoc->HTUI_target.obj::MSG_HTGMLS_PROCESS_ATTRIBUTE
          (block, entity);
      /*
       *  Add the Checkbox/Radio object to the list of focusable objects
       */
      @call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(obj);
  }


  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_SELECT_Int.	*/


/***********************************************************************
 *		UIGen_END_SELECT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Tell the presentation manager that the HTGenSelect
 *		    object is done.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_SELECT_Int()
{
  optr select;
  ClassStruct *class;

  /* 
   * If there is some object in target.obj (likely, it can be a 
   * HTGenOption object), we can assume the object is done.  Thus, give
   * the object to the presentation manager for rendering.
   */
  if (currentDoc->HTUI_target.obj &&
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenOptionClass) {
	@call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ \
				(currentDoc->HTUI_target.obj);
  } else if(currentDoc->HTUI_target.obj && (
     currentDoc->HTUI_target.class==(ClassStruct*)&HTGenMultiLineSelectClass ||
     currentDoc->HTUI_target.class==(ClassStruct*)&HTGenSelectClass)) {
	@call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
				(currentDoc->HTUI_target.obj);
  }

  @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&select, &class);
  EC_ERROR_IF(class != (ClassStruct *)&HTGenSelectClass &&
	class != (ClassStruct *)&HTGenMultiLineSelectClass,
	UIG_UI_TREE_OPERATION_FAILS);
  /*
   * Finalize the select object, like setting it exclusive or 
   * non-exclusive.
   */
  if(class == (ClassStruct *)&HTGenSelectClass) {
      @send select::MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
	 (&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));
  }
  else 
      @send select::MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT();
  /*
   * Tell the receiving object(which must be a HTGenSelect object) in 
   * the ui tree that there are no more children for it.  So the 
   * presentation manager can mark it usable and display it.
   */
  EC_ERROR_IF(!((@call currentDoc->HTUI_target.obj::MSG_META_IS_OBJECT_IN_CLASS
		 (&HTGenOuterSelectClass) ||
		 (@call currentDoc->HTUI_target.obj::MSG_META_IS_OBJECT_IN_CLASS
		 (&HTGenMultiLineSelectClass)))), 1);
  @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
	(&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_SELECT_Int.	*/




/***********************************************************************
 *	UIGen_CREATE_OPTION_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create HTGenOption object and process the attribute
 *		    list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_OPTION_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr select;
  ClassStruct *class;
  int id;
  char *value = NULL;
  int	index = 0;
  Boolean selected = FALSE;
  optr obj;

  if (currentDoc->HTUI_target.obj && 
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenMultiLineSelectClass){

      for(index = 0; entity[index].SGMLE_token; index++) {
          switch(entity[index].SGMLE_token) {
          case HTML_ATTR_VALUE:
              if (entity[index].SGMLE_value) 
                  value = (char *)LMemDerefHandles(block, 
				entity[index].SGMLE_value);
              break;
          case HTML_ATTR_SELECTED:
              selected = TRUE;
              break;
          }
      }

      @call (currentDoc->HTUI_target.obj)::MSG_HTGMLS_ADD_OPTION_VALUE(
			value, selected);

      return UI_GEN_NO_ERROR;
  }

  /*
   * add any existing ui object in target.obj to the ui tree.
   */
  if (currentDoc->HTUI_target.obj && 
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenOptionClass)
	@call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
				(currentDoc->HTUI_target.obj);
  else if (currentDoc->HTUI_target.obj) 
	@call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ \
				(currentDoc->HTUI_target.obj);

  @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS \
	(&select, &class);
  EC_ERROR_IF(class != (ClassStruct *)&HTGenSelectClass,
	UIG_UI_TREE_OPERATION_FAILS);

    obj = UICreateObj(currentDoc, (ClassStruct *)&HTGenOptionClass);
  /*
   * Now create a option object and store it in target.obj.  Then
   * process the passed attribute list.
   */
  currentDoc->HTUI_target.obj = obj;
  currentDoc->HTUI_target.class = (ClassStruct *)&HTGenOptionClass;

  /*
   * Assign a unique id to the option object.
   */
  id = @call select::MSG_GEN_SELECT_GET_AND_INCREMENT_OPTION_ID();
  @call currentDoc->HTUI_target.obj::MSG_GEN_ITEM_SET_IDENTIFIER(id);
  /*
   * Process attributes
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_OPTION_PROCESS_ATTRIBUTE
	(block, entity, select);

  @call currentDoc->HTUI_target.obj::MSG_META_ADD_VAR_DATA
	(HINT_EXPAND_WIDTH_TO_FIT_PARENT, 0, NULL);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_OPTION_Int.	*/


/***********************************************************************
 *		UIGen_CREATE_INPUT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Define user input field as part of the contents
 *		    in a FORM element.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: TYPE = TEXT | PASSWORD | CHECKBOX | 
 *				       RADIO | SUBMIT | RESET | HIDDEN |
 *				       IMAGE.
 *				NAME, VALUE, SRC, CHECKED, SIZE, 
 *				MAXLENGTH.
 *
 * INPUT elements are not containers and so the end tag is forbidden. 
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/18/96   	Initial Revision
 *	sean	7/25/97		Switch order or when set single-line
 *				text attribute.  Fixes 68542.
 *
 ***********************************************************************/
optr UIGen_CREATE_INPUT_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value, *cptr = NULL;
  int index, maxLen = 0, size = 13;	/* default SIZE attribute value */
  Boolean checked = FALSE;
  InputType Itype = INPUT_TEXT;		/* default input type */
  CompSizeHintArgs sizeArgs;
  optr container, dummy, image = NULL;
  ChunkHandle tmpChunk;
  HTMemHandle tmpOptr=NULL, nameOptr=NULL, valueOptr=NULL, srcOptr=NULL;
  WWFixed number;
  VisMonikerWithText *moniker;
  ClassStruct *class;

  if (currentDoc->HTUI_target.obj == NULL) {
    EC_WARNING(UIG_WRONG_ASSUMPTION);
    return NULL;
  }
  /*
   *  Finish whatever ui object in the target and append it to the ui tree.
   *  Travel up the ui tree and return the first container object(which
   *  can be a form object, or a HTGenTCell object) that is encountered.
   */
  container=FinishCurrentObjectInForm(currentDoc->HTUI_pmanager,&(currentDoc->HTUI_target));

  /*
   *  This FOR loop processes the attribute list, collecting attribute
   *  values that will be needed later on.
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_token == HTML_ATTR_CHECKED)
	checked = TRUE;
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
    case HTML_ATTR_VALUE:
    case HTML_ATTR_SRC:
      /* 
       *  Allocate a chunk to store the NAME, VALUE or SRC data.
       */
      tmpOptr = HTStrAllocCopyWID(0, value);
      /*
       * Decide which type(NAME/VALUE/SRC) of chunk we're creating.
       */
      if (entity[index].SGMLE_token == HTML_ATTR_NAME)	/* type = NAME */
	nameOptr  = tmpOptr;
      else if (entity[index].SGMLE_token==HTML_ATTR_VALUE)/* type = VALUE */
	valueOptr = tmpOptr;
      else				                /* type = SRC */
	srcOptr = tmpOptr;
      break;
    case HTML_ATTR_CHECKED:
      checked = TRUE;
      break;
    case HTML_ATTR_SIZE:
      size = atoi(value);
      if (size > 70)
	  size = 70;
      else if (size <= 2)
	  size = 3;
      break;
    case HTML_ATTR_MAXLENGTH:
      maxLen = atoi(value);
      break;
    case HTML_ATTR_TYPE:
      if (strcasecmp("text", value) == 0)
	Itype = INPUT_TEXT;
      else if (strcasecmp("password", value) == 0)
	Itype = INPUT_PASSWORD;
      else if (strcasecmp("checkbox", value) == 0)
	Itype = INPUT_CHECKBOX;
      else if (strcasecmp("radio", value) == 0)
	Itype = INPUT_RADIO;
      else if (strcasecmp("submit", value) == 0)
	Itype = INPUT_SUBMIT;
      else if (strcasecmp("reset", value) == 0)
	Itype = INPUT_RESET;
      else if (strcasecmp("hidden", value) == 0)
	Itype = INPUT_HIDDEN;
      else if (strcasecmp("image", value) == 0)
	Itype = INPUT_IMAGE;
      else if (strcasecmp("button", value) == 0) {
	currentDoc->HTUI_target.obj = container;
	currentDoc->HTUI_target.class=@call container::MSG_META_GET_CLASS();
	EC_WARNING(UIG_BUTTON_NOT_SUPPORTED);
	return NULL;
      }
EC(   else if (strcasecmp("file", value) == 0)
	/*	Itype = INPUT_FILE;				*/
	EC_WARNING(UIG_FILE_NOT_SUPPORTED); )
      break;
    }
  }

  switch (Itype) {
    case INPUT_TEXT:
    case INPUT_PASSWORD:
	/*
	 * Create a text input feild(text object) for user input.
	 */
	dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenFormTextClass);
	/*
	 * Single-line text attribute must be set first.  Fixes 68542.
         * Sean 7/25/97.
	 */
	@call dummy::MSG_GEN_TEXT_SET_ATTRS(GTA_SINGLE_LINE_TEXT, 0); 

	/*
	 * Store the attributes data.
	 */
	if (valueOptr != NULL) {
	  /*
	   *  The default VALUE for TYPE=TEXT is displayed right away.
	   */
	  cptr = (char *)HTMemLock(valueOptr);
	  @call dummy::MSG_VIS_TEXT_APPEND_PTR(cptr, 0);
	  HTMemUnlock(valueOptr);
	}
	@call dummy::MSG_GEN_FORM_TEXT_INITIALIZE(nameOptr,valueOptr,container);
	/*
	 * Set width of the object.
	 */
	sizeArgs.CSHA_width = SST_AVG_CHAR_WIDTHS | size;
	sizeArgs.CSHA_height = 0;
	sizeArgs.CSHA_count = 1;
	EC_ERROR_IF(size < 0, UIG_ERROR_NEGATIVE_WIDTH);
	@call dummy::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
	/*
	 *  Set MAXLENGTH if it is specified.
	 */
	if (maxLen > 0 && maxLen < 1000)	/* 1000 is a protection */
	  @call dummy::MSG_VIS_TEXT_SET_MAX_LENGTH(maxLen);
	/*
	 *  If it's a password type, set the BISON font size 13 so that
	 *  '*' is displayed for every char input.
	 */
	if (Itype == INPUT_PASSWORD) {
	  @send dummy::MSG_VIS_TEXT_SET_FONT_ID(
				FID_BISON,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);	
	  number.WWF_int = 13;
	  number.WWF_frac = 0;
	  @call dummy::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
	}
	/*
	 *  Add the FORM TEXT object to the list of focusable objects
	 */
	@call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);
	break;
    case INPUT_HIDDEN:
	/*
	 *  Create a text object for user input.
	 */
	dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenFormHiddenClass);
	/*
	 *  Store NAME and VALUE attributes.
	 */
	@call dummy::MSG_GEN_FORM_HIDDEN_INITIALIZE(nameOptr, valueOptr);
	break;
    case INPUT_CHECKBOX:
    case INPUT_RADIO:
      /*
       *  Create a Input object(GenItemGroup).
       */
      dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenInputClass);
      @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ(dummy);
      /*
       *  Initialize the Input object.
       */
      @call dummy::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(FALSE);
      @call dummy::MSG_GEN_INPUT_STORE_DATA(nameOptr, valueOptr, 
					    Itype, checked, container);
      /* 
       *  Add the INPUT object to the linked list under the FORM object.
       */
      AddInputToForm(container, dummy);
      /*
       *  Add the Checkbox/Radio object to the list of focusable objects
       */
      @call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);
      /*
       * Insert the Input(ItemGroup) to the ui tree.
       */
      @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ(dummy);
      /*
       * Create a genItem object 
       */
      dummy = UICreateObj(currentDoc, (ClassStruct *)&GenItemClass);
      @call dummy::MSG_GEN_ITEM_SET_IDENTIFIER(0);

      @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE(&dummy, &class);
      currentDoc->HTUI_target.obj = dummy;
      currentDoc->HTUI_target.class = class;
      break;
    case INPUT_RESET:
    case INPUT_SUBMIT:
	/*
	 * Create a text object for user input.
	 */
	dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenFormTriggerClass);
	@call dummy::MSG_GEN_FORM_TRIGGER_INITIALIZE(nameOptr,Itype,container);
	/*
	 *  Set up the the vis Moniker on the trigger.
	 */
	if (valueOptr) {
	  /*
	   *  Create a visMoniker, and copy the text moniker.
	   */
	  ObjLockObjBlock(HandleOf(dummy));
	  cptr = (char *)HTMemLock(valueOptr);
	  tmpChunk = LMemAlloc(HandleOf(dummy), 
			strlen(cptr) + 1 + sizeof(VisMonikerWithText));
	  moniker = LMemDerefHandles(HandleOf(dummy), tmpChunk);
	  moniker->VMWT_common.VM_type = 0;
	  moniker->VMWT_common.VM_width= 0;
	  moniker->VMWT_mnemonicOffset = -1;
	  strcpy((char *)moniker + VMWT_text, cptr);
	  HTMemUnlock(valueOptr);
	  HTMemFree(valueOptr);

	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_OPTR
		(ConstructOptr(HandleOf(dummy),tmpChunk), VUM_NOW);
	  LMemFreeHandles(HandleOf(dummy), tmpChunk);
	  MemUnlock(HandleOf(dummy));
	}
	else if (Itype == INPUT_SUBMIT)
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		("Submit", VUM_DELAYED_VIA_UI_QUEUE);
	else
	  @call dummy::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
		("Reset", VUM_DELAYED_VIA_APP_QUEUE);
	/*
	 *  Set the RESET action message and destination
	 */
	if (Itype == INPUT_RESET) {
	  @call dummy::MSG_GEN_TRIGGER_SET_ACTION_MSG(MSG_GEN_FORM_RESET);
	  while(!@call container::MSG_META_IS_OBJECT_IN_CLASS
	        (&HTGenFormClass)) {
	    container = @call container::MSG_GEN_FIND_PARENT();
	  }
	  @call dummy::MSG_GEN_TRIGGER_SET_DESTINATION(container);
	}
	else
	  @call dummy::MSG_META_SET_OBJ_BLOCK_OUTPUT(currentDoc->HTUI_pmanager);
	/*
	 *  Add the Reset/Submit object to the list of focusable objects
	 */
	@call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);
        break;
    case INPUT_IMAGE:
	image = dummy = UICreateObj(currentDoc, (ClassStruct *)&HTGenImageClass);
	@call dummy::MSG_GEN_IMAGE_REQUEST(srcOptr);
	@call dummy::MSG_GEN_IMAGE_MARK_INPUT(container, nameOptr);
	/*
	 *  Add the image object to the list of focusable objects
	 */
	@call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(dummy);
	break;
  }
  if (Itype != INPUT_CHECKBOX && Itype != INPUT_RADIO) {
    /*
     *  Done with the new object.  CHECKBOX and RADIO will get its
     *  visMoniker later.
     */
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(dummy);
    @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS \
		(&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));
  }
    
  return image;
}	/* End of UIGen_CREATE_INPUT_Int.	*/



/***********************************************************************
 *	UIGen_START_TEXTAREA_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Creates a multiple-line text entry control in
 *		    which the user can enter and edit text. 
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Supported Attr: COLS, NAME, ROWS
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_TEXTAREA_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr obj, content;

  /*
   *  Finish and append whatever ui object in the target to the ui tree.
   *  Travel up the tree and return the first container object(which
   *  can be a form object, or a HTGenTCell object) encountered.
   */
  content=FinishCurrentObjectInForm(currentDoc->HTUI_pmanager,&(currentDoc->HTUI_target));
  /*
   * Now create a select object and store it in target.obj.  
   * Then process the passed attribute list.
   */
  obj = UICreateObj(currentDoc, (ClassStruct *)&TextAreaClass);
  
  currentDoc->HTUI_target.obj = obj;
  currentDoc->HTUI_target.class = (ClassStruct *)&TextAreaClass; 
  @call currentDoc->HTUI_target.obj::MSG_TEXT_AREA_PROCESS_ATTRIBUTE
	(block, entity, content);
  /*
   *  Add the text area object to the list of focusable objects
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(obj);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_TEXTAREA_Int.	*/



/***********************************************************************
 *	UIGen_END_TEXTAREA_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Finish up the <TEXTAREA> object.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_TEXTAREA_Int()
{
  HTMemHandle tmpOptr;
  int	len;
  char	*cptr;

  /* 
   *  If there is some object in target.obj (It must be a GenFormText
   *  object), now we can mark it done.  Thus, pass the object to the 
   *  presentation manager for rendering.
   */
  if (currentDoc->HTUI_target.obj) {
    EC_ERROR_IF(currentDoc->HTUI_target.class != 
	(ClassStruct *)&TextAreaClass, UIG_UI_TREE_OPERATION_FAILS);
    /*
     *  If there is some text between <TEXTAREA> and </TEXTAREA>, 
     *  store a copy of the text in the HTGFT_value.  This copy is used
     *  to restore the TEXTAREA back to its initial state when the RESET
     *  trigger is pressed.
     */
    if((len = @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_GET_TEXT_SIZE())>0){
      tmpOptr = HTMemAllocWID(0, sizeof(char)* (len + 1));
      cptr = (char *)HTMemLock(tmpOptr);
      @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_GET_ALL_PTR(cptr);
      @call currentDoc->HTUI_target.obj::MSG_GEN_FORM_TEXT_INITIALIZE(0,tmpOptr,NULL);
      HTMemUnlock(tmpOptr);
    }

    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(currentDoc->HTUI_target.obj);

    @call currentDoc->HTUI_target.obj::MSG_TEXT_AREA_FINISH();
    
    @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	(&currentDoc->HTUI_target.obj, &currentDoc->HTUI_target.class);
    EC_ERROR_IF
	(currentDoc->HTUI_target.class != (ClassStruct *)&HTGenFormClass &&
	 currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTCellClass, 
	 UIG_UI_TREE_OPERATION_FAILS);
    return UI_GEN_NO_ERROR;
  }
  else
    return UI_GEN_ERROR;
}	/* End of UIGen_END_TEXTAREA_Int.	*/




/***********************************************************************
 *		AddInputToForm
 ***********************************************************************
 *
 * SYNOPSIS:	Add the input object to the linked list under the form.
 * CALLED BY:	(optr form, optr inputObj)
 * RETURN:	void 
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
void
AddInputToForm (optr form, optr inputObj)
{
  while(!@call form::MSG_META_IS_OBJECT_IN_CLASS(&HTGenFormClass)) {
    form = @call form::MSG_GEN_FIND_PARENT();
    if (@call form::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass)){
      EC_WARNING(UIG_INVALID_OPERATION);
      return;
    }
  }
  @send inputObj::MSG_GEN_ITEM_GROUP_SET_DESTINATION(form);
  @call form::MSG_GEN_FORM_ADD_INPUT(inputObj);
  return;
}	/* End of AddInputToForm.	*/


/***********************************************************************
  Code for TextAreaClass and TextAreaTextClass
***********************************************************************/
@classdecl	TextAreaClass; 
@classdecl	TextAreaTextClass; 

/***********************************************************************
 *	MSG_TEXT_AREA_PROCESS_ATTRIBUTE for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Process the <TEXTAREA> attribute list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Attributes processed:  NAME, COLS, ROWS.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, cols = 12, rows = 1;
  word br;

  @self->TAI_content = content;
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      @self->TAI_name = HTStrAllocCopyWID(0, value);
      break;
    case HTML_ATTR_COLS:
      cols = atoi(value);
      if (cols > 75)
	  cols = 75;
      else if (cols <= 0)
	  cols = 12;     /* get back to default */
      break;
    case HTML_ATTR_ROWS:
      rows = atoi(value);
      if (rows > 50)
	  rows = 50;
      else if (rows <= 0)
	  rows = 1;     /* get back to default */
      break;
    }
  }

  @self->TAI_width = cols * 6;  /* char width */
  @self->TAI_length = rows * 17 + 2; /* line of text */

  /*
   *  Make the object to be able to grab focus exclusive.
   */
  @call self::MSG_GEN_SET_ATTRS(GA_TARGETABLE,0);

  @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX, 0, NULL);
@ifdef TRUNK
    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED, 0, NULL);
@endif

    @self->TAI_align = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION
	(&br);
  @self->TAI_noBr = br;

  /* 
   * create the text object 
   */
  @self->TAI_textObj = UICreateObj(currentDoc, (ClassStruct *)&TextAreaTextClass);

  /*
   *  Let TAB to switch to different object, instead of inserting a tab.
   */
  @call @self->TAI_textObj::MSG_GEN_TEXT_SET_ATTRS
      (GTA_USE_TAB_FOR_NAVIGATION, 0);
  @call @self->TAI_textObj::MSG_GEN_SET_ATTRS
      (GA_TARGETABLE, 0);
  @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA
      (HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);

  @call @self->TAI_textObj::MSG_TAT_SET_ROWS(rows);
  @call @self->TAI_textObj::MSG_TAT_SET_COLUMNS(cols);

  @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA
      (HINT_TEXT_WHITE_WASH_COLOR, 0, NULL);

@ifdef TRUNK
    @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA(
			HINT_DRAW_STYLE_FLAT, 0, NULL);
@endif

    @call @self->TAI_textObj::MSG_META_ADD_VAR_DATA(
			HINT_TEXT_NO_FRAME, 0, NULL);

  @call self::MSG_GEN_ADD_CHILD(@self->TAI_textObj, CCF_MARK_DIRTY);

  return;
}	/* End of MSG_TEXT_AREA_PROCESS_ATTRIBUTE.	*/


/***********************************************************************
 *		MSG_TEXT_AREA_FINISH for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Copy the text to the text object and set it usable.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_TEXT_AREA_FINISH
{
    char *ptr;

    @call @self->TAI_textObj::MSG_GEN_SET_USABLE(VUM_NOW);

    if(@self->TAI_text) {
	ptr = HTMemLock(@self->TAI_text);
	@call @self->TAI_textObj::MSG_VIS_TEXT_APPEND_PTR(ptr, 0);
	HTMemUnlock(@self->TAI_text);
    } else 
	@call @self->TAI_textObj::MSG_VIS_TEXT_APPEND_PTR("", 0);

}	/* End of MSG_TEXT_AREA_FINISH.	*/


/***********************************************************************
 *		MSG_TEXT_AREA_SET_FOCUS for TextAreaClass
 ***********************************************************************
