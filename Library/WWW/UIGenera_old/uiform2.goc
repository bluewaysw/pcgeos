}	/* End of MSG_UI_GET_ROW_POSITION.	*/


/***********************************************************************
 *		MSG_UI_SET_NEW_POSITION for HTGenFormTriggerClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenFormTriggerClass, MSG_UI_SET_NEW_POSITION
{
