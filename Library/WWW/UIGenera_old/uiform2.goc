	HTMemFree(@self->TAI_text);

    @callsuper();
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /*
     * This is allocated by HTMemAllocWID.
     *
     * if(@self->TAI_text)
     *   HTMemFree(@self->TAI_text);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * UICreateObj.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/25/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_VIS_DRAW
{
  @callsuper();
  if (@self->TAI_focalBound.RD_right != @self->TAI_focalBound.RD_left) {
      RedrawFocus (gstate, &@self->TAI_focalBound);
  }
    return;
}	/* End of MSG_VIS_DRAW.	*/


/***********************************************************************
 *		MSG_META_START_SELECT for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/ 25/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_META_START_SELECT
{
  EventHandle msg;
  Rectangle box, rect;

  @call self::MSG_VIS_GET_BOUNDS(&rect);
  rect.R_left -= 2;
  rect.R_top -= 2;
  rect.R_right += 1;
  rect.R_bottom += 1;
  box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
  msg = @record PresentationManagerClass::MSG_PM_GRAB_NEW_FOCUS
      (oself, rect, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
  @send oself::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
  @callsuper();
  return;
}	/* End of MSG_META_START_SELECT.	*/

/***********************************************************************
 *		MSG_META_GRAB_FOCUS_EXCL for TextAreaClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaClass, MSG_META_GRAB_FOCUS_EXCL, MSG_META_GRAB_TARGET_EXCL
{
    /*
     *  Assuming TextArea has only one child.
     */
    if (message == MSG_META_GRAB_FOCUS_EXCL)
	@send @genChildren::MSG_META_GRAB_FOCUS_EXCL();
    else
	@send @genChildren::MSG_META_GRAB_TARGET_EXCL();
    return;
}	/* End of MSG_META_GRAB_FOCUS_EXCL.	*/



/***********************************************************************
 *		MSG_VIS_MARK_INVALID for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 8/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_MARK_INVALID
{
    VisCompInstance * vself;

    @callsuper();

    vself = ObjDerefVis(oself);
    vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID);
/*    @send self::MSG_VIS_UPDATE_GEOMETRY(); */

    return;
}	/* End of MSG_VIS_MARK_INVALID.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    This message has three purposes, 
 *                    1. set the size
 *                    2. set some flags
 *                    3. set notification
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_SPEC_BUILD_BRANCH
{
  VisCompInstance * vself;
  word t = 0;

  @callsuper();

  /*
   * set the reasonable size
   */
  @self->TATI_height = @call self::MSG_VIS_TEXT_CALC_HEIGHT
      (@self->TATI_width, FALSE);

  if(@self->TATI_height < @self->TATI_length) 
      @self->TATI_height = @self->TATI_length + 2;

  @call self::MSG_VIS_SET_SIZE(@self->TATI_width, @self->TATI_height+1); 


  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID);
/*  @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();*/

  /*
   * declare that we want to get all the notificatioin happened for 
   * this text object
   */
  @call self::MSG_META_ADD_VAR_DATA(ATTR_VIS_TEXT_NOTIFY_CURSOR_POSITION,
		sizeof(word), &t);

  @self->TATI_origin.P_x = @self->TATI_origin.P_y = 0;

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    We don't want to draw the text out of the textarea,
 *                  so we intercept this message and set the clipRect.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_DRAW
{
    VisCompInstance * vself;
    vself = ObjDerefVis(oself);
    vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID);

    GrSaveState(gstate); 

    GrSetWinClipRect(gstate, PCT_REPLACE,
		  @self->TATI_x, @self->TATI_y + 1, 
		  @self->TATI_x + @self->TATI_width, 
		  @self->TATI_y + @self->TATI_length);

    @callsuper();

    GrRestoreState(gstate);
}	/* End of MSG_VIS_DRAW.	*/


/***********************************************************************
 *		MSG_GEN_RESET for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Reset the position and size when user reset it.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_GEN_RESET
{
    @self->TATI_firstChar.P_x = @self->TATI_firstChar.P_y = 0;
    @self->TATI_origin.P_x = @self->TATI_origin.P_y = 0;

    @self->TATI_height = @call self::MSG_VIS_TEXT_CALC_HEIGHT
      (@self->TATI_width, FALSE);

    if(@self->TATI_height < @self->TATI_length) 
	@self->TATI_height = @self->TATI_length;

    @call self::MSG_VIS_SET_SIZE(@self->TATI_width, @self->TATI_height+1); 

    @call self::MSG_VIS_SET_POSITION
	(@self->TATI_origin.P_x, @self->TATI_origin.P_y);
    @call self::MSG_VIS_POSITION_BRANCH(0,0);

    @call self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION
	(0, VARF_NOT_IF_ALREADY_INVALID, 
	 @self->TATI_y + @self->TATI_length,
	 @self->TATI_x + @self->TATI_width - 1, 
	 @self->TATI_y + 1, @self->TATI_x + 1);

    return;
}	/* End of MSG_GEN_RESET.	*/


/***********************************************************************
 *		MSG_TAT_INITIALIZE for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_INITIALIZE
{
    VisTextGetLineInfoReturnValues retValue;
    VisTextGetLineInfoParameters vtglip;
    LineInfo lineInfo;

    @self->TATI_firstChar.P_x = @self->TATI_firstChar.P_y = 0;

    vtglip.VTGLIP_buffer = &lineInfo;
    vtglip.VTGLIP_bsize = sizeof(LineInfo);
    vtglip.VTGLIP_line = 0;
    @call self::MSG_VIS_TEXT_GET_LINE_INFO
	(&retValue, &vtglip);
    @self->TATI_lineHeight = lineInfo.LI_hgt.WBF_int;
}	/* End of MSG_TAT_INITIALIZE.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_GENERATE_NOTIFY for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    The main field for us to simulate the scrolling here.
 *                  We want to keep the cursor always inside the textarea,
 *                  so whenever the cursor position changed, we check if 
 *                  it's still inside the area. If so, return. If not, we
 *                  reposition the text object to keep the cursor still
 *                  visable. 
 *                  After that, we need to transform the gstate which is
 *                  used by the system to draw the cursor and new chars.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_TEXT_GENERATE_NOTIFY
{
    VisTextInstance * vself;
    int line;
    TransMatrix tm;

    /* 
     * check if it's a cursor notification, and if we get some thing to
     * display.
     */
    if((params->VTGNP_notificationTypes & VTNF_CURSOR_POSITION)
       && (@call self::MSG_VIS_TEXT_GET_TEXT_SIZE())>0) {

	vself = ObjDerefVis(oself);

	if(!vself->VTI_cursorPos.P_x && !vself->VTI_cursorPos.P_y
	   || !vself->VTI_gstate)   return;

	if(!@self->TATI_lineHeight) @call self::MSG_TAT_INITIALIZE();

	if( vself->VTI_selectStart == vself->VTI_selectEnd) {
	    if(!@self->TATI_lastGState) {
		line = vself->VTI_cursorPos.P_y / @self->TATI_lineHeight;
		if(line >= @self->TATI_firstChar.P_y + @self->TATI_rows){
		    vself->VTI_cursorPos.P_x = 0;
		    vself->VTI_cursorPos.P_y = 1;
		}

		@self->TATI_lastGState = vself->VTI_gstate;

		GrGetTransform(vself->VTI_gstate, &tm);
		@self->TATI_lastTMe32 = tm.TM_e32.DWF_int;
		GrSetTransform(vself->VTI_gstate, &tm);

		return;

	    } else if(@self->TATI_lastGState != vself->VTI_gstate) {
		@self->TATI_lastGState = vself->VTI_gstate;
		
		@call self::MSG_VIS_TEXT_FLASH_CURSOR_OFF();

		GrGetTransform(vself->VTI_gstate, &tm);
		tm.TM_e32.DWF_int = @self->TATI_lastTMe32;
		GrSetTransform(vself->VTI_gstate, &tm);

		@call self::MSG_VIS_TEXT_FLASH_CURSOR_ON();

		return;
	    }


	    line = vself->VTI_cursorPos.P_y / @self->TATI_lineHeight;

	} else {
	    line = @call self::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET
		(vself->VTI_lastOffset);
	}

	@call self::MSG_TAT_DISPLAY_POSITION(line);
    }
}	/* End of MSG_VIS_TEXT_GENERATE_NOTIFY.	*/


/***********************************************************************
 *		MSG_TAT_DISPLAY_POSITION for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_DISPLAY_POSITION
{
    VisTextInstance * vself;
    TransMatrix tm;

    if(line >= @self->TATI_firstChar.P_y + @self->TATI_rows)
	@self->TATI_firstChar.P_y = line - @self->TATI_rows + 1;
    else if(line < @self->TATI_firstChar.P_y) 
	@self->TATI_firstChar.P_y = line;
    else 
	return;

    @self->TATI_origin.P_y = @self->TATI_y - 
	@self->TATI_firstChar.P_y * @self->TATI_lineHeight;

    @call self::MSG_VIS_SET_POSITION
	(@self->TATI_origin.P_x, @self->TATI_origin.P_y);
    @call self::MSG_VIS_POSITION_BRANCH(0,0);

    @call self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION
	(0, VARF_NOT_IF_ALREADY_INVALID, 
	 @self->TATI_y + @self->TATI_length, 
	 @self->TATI_x + @self->TATI_width - 1, 
	 @self->TATI_y + 1, @self->TATI_x + 1);

    vself = ObjDerefVis(oself);

    GrGetTransform(vself->VTI_gstate, &tm);
    tm.TM_e32.DWF_int = @self->TATI_origin.P_y - 1;
    GrSetTransform(vself->VTI_gstate, &tm);
    @self->TATI_lastTMe32 = tm.TM_e32.DWF_int;
}	/* End of MSG_TAT_DISPLAY_POSITION.	*/



/***********************************************************************
 *		MSG_META_LARGE_PTR for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_META_LARGE_PTR
{
    word yPosition, line;

    yPosition = (word)largeMouseDataStruct->LMD_location.PDF_y.DWF_int;

    if(yPosition < @self->TATI_origin.P_y + @self->TATI_height - 5 &&
       yPosition > @self->TATI_origin.P_y + 5) {

	if(!@self->TATI_lineHeight) @call self::MSG_TAT_INITIALIZE();
	line = (yPosition - @self->TATI_origin.P_y)/ @self->TATI_lineHeight;

	@call self::MSG_TAT_DISPLAY_POSITION(line);
    }

    @callsuper();
    
}	/* End of MSG_META_LARGE_PTR.	*/


/***********************************************************************
 *		MSG_META_KBD_CHAR for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    set the clip rect for the VTI_gstate before callsuper.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_META_KBD_CHAR
{
    VisTextInstance * vself;

    vself = ObjDerefVis(oself);
    if(vself->VTI_gstate) 
	GrSetWinClipRect(vself->VTI_gstate, PCT_REPLACE,
			 @self->TATI_x + 1, @self->TATI_y + 1, 
			 @self->TATI_x + @self->TATI_width - 1, 
			 @self->TATI_y + @self->TATI_length);

    if( !(flags & CF_RELEASE) &&
	    (((flags >> 8) & SS_LCTRL) 
	    || ((flags >> 8) & SS_RCTRL) ))  {
	/* 
 	 * Short cut keys
	 */
	if(character == ((VC_ISANSI << 8) | 'A') ||
	   character == ((VC_ISANSI << 8) | 'a')) {
	    /*
	     * Select all
	     */
	    @send self::MSG_VIS_TEXT_SELECT_ALL();
	    return;

	} else if(character == ((VC_ISANSI << 8) | 'C') ||
	    character == ((VC_ISANSI << 8) | 'c')) {
	    /*
	     * Copy to clipboard
	     */
	    @send self::MSG_META_CLIPBOARD_COPY();
	    return;

	} else if(character == ((VC_ISANSI << 8) | 'V') ||
	    character == ((VC_ISANSI << 8) | 'v')) {
	    /* 
	     * Paste 
	     */
	    @send self::MSG_META_CLIPBOARD_PASTE();
	    return;

	} else if(character == ((VC_ISANSI << 8) | 'X') ||
	    character == ((VC_ISANSI << 8) | 'x')) {
	    /* 
	     * Cut
	     */
	    @send self::MSG_META_CLIPBOARD_CUT();
	    return;
	}
    }

    @callsuper();
}	/* End of MSG_META_KBD_CHAR.	*/



/***********************************************************************
 *		MSG_VIS_TEXT_HEIGHT_NOTIFY for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    if the height changed, we need to change the size
 *                  as well.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_TEXT_HEIGHT_NOTIFY
{
    if(newHeight != @self->TATI_height && newHeight > @self->TATI_length) { 
	@self->TATI_height = newHeight;
	@call self::MSG_VIS_SET_SIZE(@self->TATI_width, @self->TATI_height+1); 
    }

    @call self::MSG_VIS_INVALIDATE(); 
    @callsuper(); 
}	/* End of MSG_VIS_TEXT_HEIGHT_NOTIFY.	*/


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Use our own position.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_VIS_POSITION_BRANCH
{
    xOrigin = @self->TATI_origin.P_x;
    yOrigin = @self->TATI_origin.P_y - 2;

    @callsuper();

    return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_TAT_SET_SIZE for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_TAT_SET_SIZE
{
    @self->TATI_width = width;
    @self->TATI_length = length;
}	/* End of MSG_TAT_SET_SIZE.	*/

@method TextAreaTextClass, MSG_TAT_SET_POSITION
{
    @self->TATI_x = x;
    @self->TATI_y = y;
    @self->TATI_origin.P_x = x;
    @self->TATI_origin.P_y = y;
}

@method TextAreaTextClass, MSG_TAT_SET_ROWS
{
    @self->TATI_rows = rows;
}

@method TextAreaTextClass, MSG_TAT_SET_COLUMNS
{
    @self->TATI_columns = columns;
}


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for TextAreaTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method TextAreaTextClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    VisTextInstance * vself;
    /*
     * This is not allocated by TextAreaText, but by its superclass.
     * I have to find out all such handles and memory leaks and delete
     * them.... or send MSG_GEN_DESTROY to it.
     * 
     * if (@self->TATI_lastGState) 
     *  GrDestroyState(@self->TATI_lastGState);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * UICreateObj.
     */
    vself = ObjDerefVis(oself);
    if (vself->VTI_gstate)
	GrDestroyState(vself->VTI_gstate);
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/





/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method HTGenFormTextClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These are allocated using HTMemAllocWID and deleted using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGFT_name)
     * HTMemFree(@self->HTGFT_name);
     * if (@self->HTGFT_value)
     * HTMemFree(@self->HTGFT_value);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * UICreateObj.
     */
    VisTextInstance *vself;
    vself = ObjDerefVis(oself);
    if (vself->VTI_gstate)
      GrDestroyState(vself->VTI_gstate);
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/


