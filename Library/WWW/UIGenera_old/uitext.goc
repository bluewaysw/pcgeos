@method HTGenTextClass, MSG_UI_GET_ROW_POSITION
{
    return @self->HTGT_pageRow;
}	/* End of MSG_UI_GET_ROW_POSITION.	*/


/***********************************************************************
 *		MSG_UI_SET_NEW_POSITION for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
