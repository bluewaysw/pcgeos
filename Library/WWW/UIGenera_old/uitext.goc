/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear some instance data.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_DESTROY
{
  @call self::MSG_VIS_TEXT_FREE_STORAGE(TRUE);

  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  HTListDelete(@self->HTGT_anchorList);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGT_gstate)
      GrDestroyState(@self->HTGT_gstate);
  return;
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_SET_USABLE for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Set some states in the Vis part of the text.
 * PARAMETERS:	    (WindowHandle window = bp)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	7/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_SET_USABLE
{
  VisTextStates	visTextStateSet = 0, visTextStateClear = 0;
  char buffer[2];
  word len;
  /*
   *  I tried to add the following ATTR in my MSG_GEN_TEXT_INITIALIZE.
   *  Somehow this attr is deleted after setting the object usable... :(
   */
  @call self::MSG_META_ADD_VAR_DATA
	(ATTR_VIS_TEXT_DONT_SHOW_POSITION_ON_GAINED_TARGET_EXCL, 0, NULL);
  @call self::MSG_GEN_TEXT_SET_ATTRS(GTA_DONT_SCROLL_TO_CHANGES, 0);
  /*
   *  If the last character is C_RETURN, delete it because the next
   *  sibling object starts at the new line anyway.
   *  Note, we just finish appending text.  Thus, we assume the text
   *  cursor position is at the end.
   */
  @call self::MSG_VIS_TEXT_SELECT_RELATIVE(-1, 0);
  len = @call self::MSG_VIS_TEXT_GET_SELECTION_PTR(buffer);
  if (len == 1 && buffer[0] == C_ENTER)
      @call self::MSG_VIS_TEXT_DELETE_SELECTION();
  /*
   *  Its parent may not have been set usable, so the vis branch is not
   *  build and the all HINTs in text are not evaluated yet.  So now I
   *  need to force the text object to evaluate it.
   */
  @call self::MSG_SPEC_SCAN_GEOMETRY_HINTS();

  @callsuper();

  /*
   *  make modified states.
   *  If we'd like to support Search Feature or dragging in the browser,
   *  we may need to set the following bits differently.
   */
  visTextStateSet = /* VTS_SELECTABLE VTS_TARGETABLE */ 0;
  visTextStateClear = VTS_EDITABLE | VTS_SELECTABLE | VTS_TARGETABLE;
  @call self::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(visTextStateSet,
						      visTextStateClear);
  /*
   *  Dealloc gstate that won't be used anymore.  Save space.
   */
  if (@self->HTGT_gstate) {
      GrDestroyState(@self->HTGT_gstate);
      @self->HTGT_gstate = NULL;
  }

  return;
}	/* End of MSG_GEN_SET_USABLE.	*/



/***********************************************************************
 *		MSG_VIS_TEXT_SET_FONT_ID for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept the message and update its gstate.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	HTGT_gstate is used to calculate the width, in pixels,
 *		needed to draw the text.  That width will be used to
 *		set the width of text object.  Thus, the text won't 
 *		appear wider than necesary.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SET_FONT_ID
{
  GrSetFont(@self->HTGT_gstate, fid, 0);
  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_SET_FONT_ID.	*/


/***********************************************************************
 *		MSG_VIS_TEXT_APPEND_PTR for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Intercept this message and update the HTGT_accLen
 * PARAMETERS:	    (const char *text, word textLen)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	HTGT_accLen is used to accumulate the text  length, 
 *		in pixels to draw the current line of text.  This 
 *		length will be used to set the width of text object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_APPEND_PTR
{
  int len;

  if (text[0] == C_TAB)
    @self->HTGT_accLen += (textLen * TAB_POINT);
  else if (text[0] == C_LF)
    return;
  else if (text[0] == C_ENTER) {
      if (@self->HTGT_accLen > @self->HTGT_maxLen) {
	  @self->HTGT_maxLen = @self->HTGT_accLen;
      }
      EC_ERROR_IF(globalVarWidth <= 0 || globalVarWidth > 1000, 1);
      if (@self->HTGT_accLen < globalVarWidth)
	  globalVarSumOfAccLen+=((globalVarWidth-@self->HTGT_accLen)*textLen);
      else
	  globalVarSumOfAccLen += @self->HTGT_accLen;
      @self->HTGT_accLen = 0;
      @self->HTGT_multiline = TRUE;
  }
  else {
    len = strlen(text);
    if(len < textLen) textLen = len;
    len = GrTextWidth(@self->HTGT_gstate,text,textLen);
    @self->HTGT_accLen += len;
    globalVarSumOfAccLen += len;
  }
  @callsuper();
  return;
}	/* End of MSG_VIS_TEXT_APPEND_PTR.	*/



/***********************************************************************
 *		MSG_META_MOUSE_PTR for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Change Mouse pointer Image when it's over a link.
 * PARAMETERS:	    (word xPosition,word yPosition, word inputState)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_META_PTR
{
  int hrefToken;

  hrefToken = @call self::MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
    (xPosition, yPosition);

  @callsuper();

  if (hrefToken != -1) {
    retVal->ptrImage = @BoxCursor;
    /* this event processed */
    retVal->flags = MRF_PROCESSED | MRF_SET_POINTER_IMAGE;
  }

  return;
}	/* End of MSG_META_MOUSE_PTR.	*/


/***********************************************************************
 *		MSG_META_START_SELECT for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Detect hyperlink on the text object.
 * PARAMETERS:	    (MouseReturnParams *retVal,
 *			      sword xPosition,
 *			      sword yPosition,
 *			      word inputState) 
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_META_START_SELECT
{
  int hrefToken;

  @self->HTGT_selected = TRUE;
  @callsuper();

  if (!(GET_BUTTON_INFO(inputState) & BI_PRESS))
    return;

  hrefToken = @call self::MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
    (xPosition, yPosition);

  if (hrefToken != -1)
    @call currentDoc->HTUI_pmanager::MSG_PM_REFER_HYPERLINK(hrefToken);
  else {
    Rectangle box;
    EventHandle msg;
    @call currentDoc->HTUI_pmanager::MSG_PM_CLEAR_HREF_LINK();
    /*
     *  If the previous object in focus is not this text, clear the 
     *  focal bound.
     */
    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    msg = @record PresentationManagerClass::MSG_PM_GRAB_NEW_FOCUS
	(oself, box, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
    @send oself::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
  }
  return;
}	/* End of MSG_META_START_SELECT.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_RECALC_SIZE
{
  int neededLen;
  SizeAsDWord size;

  neededLen = (@self->HTGT_accLen < @self->HTGT_maxLen) ?
      @self->HTGT_maxLen : @self->HTGT_accLen;

  if (neededLen < width)
      width = neededLen;

  if (@self->HTGT_multiline==TRUE && width < 50)
      width = 50;
  else if(@self->HTGT_multiline==FALSE && width < 50 && neededLen > 50)
      width = 50;

  size = @callsuper();
  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Manually position the object.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;
  SizeAsDWord pSize, oSize;
  VisTextInstance  * vself;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGT_multiline == TRUE) {
    /*
     *  Because the text crosses multilines, its width must be the same
     *  as the parent.  The reaseon I resize here is because during the
     *  the MSG_VIS_RECALC_SIZE, the parent may not have been built
     *  yet.  However, here the parent size has been determined already.
     */
    pSize = @call @genParent::MSG_VIS_GET_SIZE();
    oSize = @call self::MSG_VIS_GET_SIZE();
    EC_ERROR_IF(DWORD_WIDTH(oSize) > DWORD_WIDTH(pSize), 1);
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(pSize)-MARGIN-MARGIN,
				 DWORD_HEIGHT(oSize));
    xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
  }
  else {
    if (@self->HTGT_align == J_LEFT) {
	xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
    }
    else {
	lineWidth = @call @self->HTGT_content::
	    MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGT_pageRow);
	pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
/*	EC_ERROR_IF(lineWidth > pWidth, 1); */
	if (lineWidth > pWidth)
	    xOrigin = DWORD_X(xy) + @self->HTGT_xPos;
	else if (@self->HTGT_align == J_RIGHT) {
	    xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGT_xPos);
	}
	else {
	    xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGT_xPos);
	}
    }
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
      (@self->HTGT_content, @self->HTGT_pageRow, oself);

  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
  @callsuper();
  vself = ObjDerefVis(oself);
  if (!vself->VTI_lines)
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Manually calculate the position of the object.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  VisTextInstance  * vself;
  SizeAsDWord size;

  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  /*
   *  Ask the text object's content object to figure out the size and
   *  position of the text object.
   */
  pos = UpdateItsPotentialPosition(oself, @self->HTGT_content, &row, &size);

  /*
   *  Store the returned x position in the returned row number.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_xPos = pos;
  @self->HTGT_pageRow = row;
  @self->HTGT_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_SPEC_BUILD_BRANCH
{
  VisTextInstance  * vself;

  @callsuper();
  
  if (@self->HTGT_guessSize)
      @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGT_guessSize),
				   DWORD_HEIGHT(@self->HTGT_guessSize));
  /*
   *  If the text object is in a form/table, the bit is set again when
   *  the vis part is built.  Thus, we clear it here again.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;
  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/


