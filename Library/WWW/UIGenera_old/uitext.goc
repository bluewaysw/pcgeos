/***********************************************************************
 *	UIGen_APPEND_TEXT_PTR_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	Append the character data in a text object.  If there is
 *		no text object available, a text object will be created.
 * PARAMETERS:	(char *ptr, int len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		- assume the data character has no entity references
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/16/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_APPEND_TEXT_PTR_Int(char *ptr, int len)
{
  char old;
  optr parent, content = UIGen_GET_CONTENT_Int();
  ClassStruct *class;

  if (!(currentDoc->HTUI_target.obj)) {
    if (len == 1 && ptr[0] == C_SPACE)
	return UI_GEN_NO_ERROR;  /* ignore the stupid white space */
    /* 
     *  No target.obj.  Thus, create a text object,
     *  initialize it, and store character data.
     */
    UIGen_CREATE_TEXT_OBJECT_Int(ptr, content, len);
  }
  else if(currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass ||
	  currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormTextClass) {
    if (len == 1 && ptr[0] == C_SPACE)
	return UI_GEN_NO_ERROR;  /* ignore the stupid white space */
    if ((@call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_GET_TEXT_SIZE() + len) 
	> 5000 || globalVarSumOfAccLen > 46000) {
      @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	 (currentDoc->HTUI_target.obj);
      UIGen_CREATE_TEXT_OBJECT_Int(ptr, content, len);
      EC_WARNING(UIG_TEXT_SPLITS_AT_5K_BYTES);
    }
    else 
      /*
       * The target is a text object, so we simply append the text to it.
       */
      @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(ptr, len);
  }
  /* Added for HTTextAreaClass */
  else if( currentDoc->HTUI_target.class == (ClassStruct *)&TextAreaClass) {
    @call currentDoc->HTUI_target.obj::MSG_TEXT_AREA_APPEND_TEXT_PTR(ptr, len);
  }
  else if(currentDoc->HTUI_target.class == (ClassStruct *)&HTGenOptionClass) {
    /*
     *  The target is an <option> obj in the <form>.  So the text
     *  is assumed to be the vis_moniker for the <option> object.
     */
    if (!(len == 1 && ptr[0] == ' ')) {
      ChunkHandle chunk;
      old = ptr[len];
      ptr[len] = '\0';
      @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
	  (&parent, &class);
      parent = @call parent::MSG_GEN_FIND_PARENT();
      if ((chunk=@call currentDoc->HTUI_target.obj::MSG_GEN_GET_VIS_MONIKER()) != 0){
	  /*
	   *  There already exists some string.  So we append the new string.
	   */
	  HTMemHandle mem;
	  char *org, *newBuf;
	  ObjLockObjBlock(HandleOf(currentDoc->HTUI_target.obj));
	  org = (char *)LMemDerefHandles(HandleOf(currentDoc->HTUI_target.obj),
					 chunk) + sizeof(VisMonikerWithText);
	  mem = HTMemAllocWID(0, strlen(org)+strlen(ptr)+1);
	  newBuf = (char *)HTMemLock(mem);
	  strcpy(newBuf, org);
	  strcat(newBuf, ptr);
	  @call currentDoc->HTUI_target.obj::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
	      (newBuf, VUM_DELAYED_VIA_UI_QUEUE);
	  @call parent::MSG_GEN_OUTER_SELECT_UPDATE_MAX_LENGTH(newBuf);
	  HTMemUnlockAndFree(mem);
	  MemUnlock(HandleOf(currentDoc->HTUI_target.obj));
      }
      else {
	  @call currentDoc->HTUI_target.obj::MSG_GEN_REPLACE_VIS_MONIKER_TEXT
	      (ptr, VUM_DELAYED_VIA_UI_QUEUE);
	  @call parent::MSG_GEN_OUTER_SELECT_UPDATE_MAX_LENGTH(ptr);
      }
      ptr[len] = old;
    }
  }
  /* Added for HTGenMultiLineSelectClass. */
  else if(currentDoc->HTUI_target.class == (ClassStruct *)&HTGenMultiLineSelectClass) {
    if (!(len == 1 && ptr[0] == ' ')) {
	old = ptr[len];
	ptr[len] = '\0';
	@call currentDoc->HTUI_target.obj::MSG_HTGMLS_ADD_OPTION_TEXT
	    (ptr);
	ptr[len] = old;
    }
  }
  else if(currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass ||
	  currentDoc->HTUI_target.class == (ClassStruct*)&HTGenCaptionClass ||
	  currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormClass) {
    if (len == 1 && ptr[0] == C_SPACE)
	return UI_GEN_NO_ERROR;  /* ignore the stupid white space */
    /*
     *  Create a text object which will be inside the table cell.
     *  Note, the TCell object contains text formating contents.
     */
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
				(currentDoc->HTUI_target.obj);
    UIGen_CREATE_TEXT_OBJECT_Int
	(ptr, currentDoc->HTUI_target.obj, len);
  }
  else if(currentDoc->HTUI_target.class==(ClassStruct*)&PresentationManagerClass){
    /*
     * We're in the <TITLE>....</TITLE> content.  Tell the PManager to
     * store the title of the document.
     */
    @call currentDoc->HTUI_target.obj::MSG_PM_SAVE_TITLE(ptr);
  }
  /*
   *  Add length to the estimated memory size needed for display.
   */
  UIDocAddMemory(len);
  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *	UIGen_CREATE_TEXT_OBJECT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a text object and initialize it
 * PARAMETERS:	    (char *text, optr cell, int len)
 *		    if cell is NULL, that means we don't do any text
 *		    formatting according to the global HTML contents.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		1) Instantiate a text object
 *		2) Add HINTs to the object
 *		3) Format it according to the current HTML content
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/10/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_TEXT_OBJECT_Int
		(char *text, optr cell, int len)
{
  GStateHandle gstate;
  optr obj;
@ifdef TRUNK
@ifndef	BROTHER_KERNEL
  ShortLongTouchParams touch;
@endif
@endif
  
  /*
   * Create a text object.
   */
  obj = UICreateObj(currentDoc, &HTGenTextClass);
  currentDoc->HTUI_target.obj = obj; 
  currentDoc->HTUI_target.class = (ClassStruct *)&HTGenTextClass;
  /*
   * Initialization:
   * 1) Create gstate, used to calculate the min width required for
   *	the text object.
   * 2) Create a text storage for the object.
   * 3) Mark text non-editable, non-scrollable, add HINTs
   */
  gstate = @call currentDoc->HTUI_target.obj::MSG_GEN_TEXT_INITIALIZE(cell);
  /*
   *  Initialize short/long touch.
   */
@ifdef TRUNK
@ifndef	BROTHER_KERNEL
  touch.SLTP_shortMessage = MSG_PM_SHORT_TOUCH_NOTIFY;
  touch.SLTP_shortDestination = currentDoc->HTUI_pmanager;
  touch.SLTP_longMessage = MSG_PM_LONG_TOUCH_NOTIFY;
  touch.SLTP_longDestination = currentDoc->HTUI_pmanager;
  @call obj::MSG_META_ADD_VAR_DATA(HINT_SHORT_LONG_TOUCH,
				   sizeof(ShortLongTouchParams),
				   &touch);
@endif
@endif
  /*
   *  Set text output object to be the PManager, which has all the HREF
   *  information.  Thus, when a hyperlink is clicked, the text object
   *  can send HREF token to the output object(PManager) to fetch.
   */
  @call currentDoc->HTUI_target.obj::MSG_META_SET_OBJ_BLOCK_OUTPUT
     (currentDoc->HTUI_pmanager);
  /*
   * Do text formating stuff...
   *    Format the text object, i.g. bold, font size, alignment, 
   *	according to the current HTML content.  Note, the cell object 
   *	contains information about the current HTML content.
   */
  if (cell != NULL)
    @call cell::MSG_GEN_HTML_CONTENT_FORMAT_TEXT_OBJECT
	(currentDoc->HTUI_target.obj, gstate);

  /*
   * Append the text.
   */
  if (text != NULL)
    @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(text, len);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_TEXT_OBJECT_Int.	*/



/***********************************************************************
 *	UIGen_START_BOLD_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Mark the beginning of bold character rending
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		This method is intended to render the text in the
 *		contents of:  <B>, <STRONG>
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_BOLD_Int()
{
  optr content;

  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin the bold mode.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BOLD);
  /*
   * If the current target.obj is a text, do the bold rendering now.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass)
    @call currentDoc->HTUI_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
				(ELEMENT_START, TS_BOLD);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_BOLD_Int.	*/



