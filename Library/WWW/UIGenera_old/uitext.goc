/***********************************************************************
 *		UIGen_CHANGE_SMALL_FONT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change font size smaller than the current one.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Get the current font size.  Change to the next smaller
 *		size.  This method is intended to handle <SMALL>.
 *		We treat <SMALL> as <FONT SIZE = -1>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 2/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CHANGE_SMALL_FONT_Int()
{
  int size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  /*
   * Get current font size
   */
  size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  /*
   * change to a smaller size than the current one.  i.e. SIZE = -1
   */
  switch(size) {
	case STYLE_FONT_0:
		number.WWF_int = STYLE_FONT_0;	/* can't be any smaller */
		break;
	case STYLE_FONT_1:
		number.WWF_int = STYLE_FONT_0;
		break;
	case STYLE_FONT_2:
		number.WWF_int = STYLE_FONT_1;
		break;
	case STYLE_FONT_3:
		number.WWF_int = STYLE_FONT_2;
		break;
	case STYLE_FONT_4:
		number.WWF_int = STYLE_FONT_3;
		break;
	case STYLE_FONT_5:
		number.WWF_int = STYLE_FONT_4;
		break;
	case STYLE_FONT_6:
		number.WWF_int = STYLE_FONT_5;
		break;
	case STYLE_FONT_7:
		number.WWF_int = STYLE_FONT_6;
		break;
	default:
		number.WWF_int = STYLE_FONT_3;	/* error checking */
		break;
  }
  number.WWF_frac= 0;
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
		(number.WWF_int);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
	@call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CHANGE_SMALL_FONT_Int.	*/



/***********************************************************************
 *		UIGen_CHANGE_BIG_FONT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Change font size smaller than the current one.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Get the current font size.  Change to the next larger
 *		size.  This method is intended to handle <LARGE>. 
 *		We treat <BIG> as <FONT SIZE = +1>.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 2/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CHANGE_BIG_FONT_Int()
{
  int size;
  WWFixed number;
  optr content;
  /*
   * Tell a HTML content object, which will be parent of this text 
   * object, to begin a new font size.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  /*
   * Get current font size
   */
  size = @call content::MSG_GEN_HTML_CONTENT_GET_FONT_SIZE();
  /*
   * change to a larger size than the current one.  i.e. SIZE = +1
   */
  switch(size) {
	case STYLE_FONT_1:
		number.WWF_int = STYLE_FONT_2;
		break;
	case STYLE_FONT_2:
		number.WWF_int = STYLE_FONT_3;
		break;
	case STYLE_FONT_3:
		number.WWF_int = STYLE_FONT_4;
		break;
	case STYLE_FONT_4:
		number.WWF_int = STYLE_FONT_5;
		break;
	case STYLE_FONT_5:
		number.WWF_int = STYLE_FONT_6;
		break;
	case STYLE_FONT_6:
		number.WWF_int = STYLE_FONT_7;
		break;
	case STYLE_FONT_7:
		number.WWF_int = STYLE_FONT_8;
		break;
	case STYLE_FONT_8:
		number.WWF_int = STYLE_FONT_8;	/* can't be any larger */
		break;
	default:
		number.WWF_int = STYLE_FONT_3;	/* error checking */
		break;
  }
  number.WWF_frac= 0;
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
		(number.WWF_int);
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
	@call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
		(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CHANGE_BIG_FONT_Int.	*/


/***********************************************************************
 *		UIGen_SET_BASEFONT_Int for UIGeneratorClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set the base font size.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/12/97   	Initial Revision
 *	
 ***********************************************************************/
ErrorCode UIGen_SET_BASEFONT_Int
		(MemHandle block, SGMLEntity *entity)
{
  char *value;
  int size, index;
  optr content;
  WWFixed number;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    if (entity[index].SGMLE_token == HTML_ATTR_SIZE) {
	size = atoi(value);
	if (size < 1)
	    size = 1;
	else if (size > 7)
	    size = 7;
	/*
	 *  Set the basefont in the content object.
	 */
	content = UIGen_GET_CONTENT_Int();
	@call content::MSG_GEN_HTML_CONTENT_SET_BASEFONT(size);
    }
  }
  /*
   * If the current target.obj is a text, change the font now.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
      /*
       * Map the attribute size to the actual font point size.
       */
      MapAttrSizeToPointSize(size, &number);
      @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
	  (number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
  }
  
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_SET_BASEFONT_Int.	*/



/***********************************************************************
 *		UIGen_START_HEADER_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Set header font
 * PARAMETERS:	    (int size, MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Assume the HTML parser will generate the size attribute
 *		like
 *		<H1 size=6>
 *		<H2 size=5>
 *		<H3 size=4>
 *		<H4 size=3>
 *		<H5 size=2>
 *		<H6 size=1>
 *		Supported attributes: ALIGN
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 3/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_HEADER_Int
		(int size, MemHandle block, SGMLEntity *entity)
{
  optr content;
  Justification	just;
  WWFixed number;

  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenOptionClass) {
    FinishCurrentObjectInForm(currentDoc->HTUI_pmanager,&(currentDoc->HTUI_target));
    @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS
       (&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));
  }
  /*
   * Push format token onto the format stack.
   * Note, here we're pushing three format tokens, so we'll pop four 
   * tokens all together later in the UIGen_END_FORMAT_Int.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_ALIGN);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_BOLD);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_FONT);
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_HEADER);
  /*
   * Add a blank line for the header.
   */
  AddNewLine(&(currentDoc->HTUI_target), 2, currentDoc, content);
  /*
   * Process the attribute list.
   */
  /*
   * Map the attribute size to the actual font point size.
   */
  MapAttrSizeToPointSize(size, &number);
  /* 
   * Store the font point size in the fontStack, so later we know
   * what font point size to return from.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_FONT_SIZE
      (number.WWF_int);
  /*
   *  set alignment.
   */
  just = ProcessDivParagraphAttr(block, entity);
  /*
   * Store this new align info, because later we may have another
   * nesting layer of aligment.
   */
  @send content::MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION(just);
  /*
   * If the current target.obj is a text, change the alignment 
   * and change the font now.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
    @call content::MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
	(currentDoc->HTUI_target.obj);
    @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_POINT_SIZE
	(number,TEXT_ADDRESS_PAST_END,TEXT_ADDRESS_PAST_END);
    @call currentDoc->HTUI_target.obj::MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
	(ELEMENT_START, TS_BOLD);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_HEADER_Int.	*/


/***********************************************************************
 *	UIGen_START_UNORDERED_LIST_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Draws lines of text as a bulleted list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <UL>, <MENU>, <DIR>
 *		Supported Attributes:
 *		<UL>	: TYPE = disk | circle | square
 *		<MENU>	: same as above
 *		<DIR>	: same as above
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_UNORDERED_LIST_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr content;
  StyleType groupType;
  int level;
  dword	counter;
  char	displayType;
  
  /*
   * Do some initializing work common to both <UL> and <OL>.
   * This function does:
   * 	1) Push format token onto the format stack.
   *	2) Add a line break before the first list item if we're in the
   *	   first list level.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_UL);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (level == -1)
    AddNewLine(&(currentDoc->HTUI_target), 2, currentDoc, content);
  /*
   * Process the attribute list, push the list info to the list stack.
   */
  ProcessUnorderedListAttr(block, entity, content);

  return UI_GEN_NO_ERROR;
 }	/* End of UIGen_START_UNORDERED_LIST_Int.	*/



/***********************************************************************
 *	UIGen_START_ORDERED_LIST_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Draws lines of text as an ordered list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <OL>
 *		Supported Attributes:
 *		<OL>	: START=n, TYPE= A | a | I| i | 1
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_ORDERED_LIST_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr content;
  StyleType groupType;
  int level;
  dword	counter;
  char	displayType;

  /*
   * Do some initializing work common to both <UL> and <OL>.
   * This function does:
   * 	1) Push format token onto the format stack.
   *	2) Add a line break before the first list item if we're in the
   *	   first list level.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_OL);
  /*
   * If it's a nested list, we don't need to insert a new-line.  <LI>
   * will add a new line.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (level == -1)
    AddNewLine(&(currentDoc->HTUI_target),2,currentDoc, content);
  /*
   * Process the attribute list, push the list info to the list stack.
   */
  ProcessOrderedListAttr(block, entity, content);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_ORDERED_LIST_Int.	*/



/***********************************************************************
 *		UIGen_END_LIST_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Mark the text object the end of a list group.
 * PARAMETERS:	    none, 
 * SIDE EFFECTS:    Called internally by UIGen_END_FORMAT_Int
 *
 * STRATEGY:	This method handles </UL>, </OL>, and </BQ>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 9/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_LIST_Int()
{
  StyleType groupType;
  int   level;
  dword	counter;
  char	displayType;
  Tab	nextTab;
  optr	content;

  /*
   * Pop format token onto the format stack.
   */
  content = UIGen_GET_CONTENT_Int();
  @call content::MSG_GEN_HTML_CONTENT_POP_LIST_GROUP();

  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  /*
   * Insert a line break to begin a new paragraph, whose left margin
   * will be set as followed.
   */
  if (groupType == (StyleType)-1)
    AddNewLine(&(currentDoc->HTUI_target),2,currentDoc, content);
  else
    AddNewLine(&(currentDoc->HTUI_target),3,currentDoc, content);
  /*
   * Mark the margin of the new paragraph.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTextClass) {
    @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_LEFT_MARGIN(
				TAB_SIZE * ( level + 1 ),
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
    /*
     * Restore the next tab which has been set an anchor from the
     * previous nested list group.
     */
    nextTab.T_position	= TAB_SIZE * (level + 2);	/* reset the */
    nextTab.T_attr	= TL_NONE | TT_LEFT;		/* next tab. */
    nextTab.T_lineWidth	= nextTab.T_lineSpacing	=
			  nextTab.T_grayScreen	= 0;
    @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_TAB(nextTab,		
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_LIST_Int.	*/



/***********************************************************************
 *		UIGen_START_LIST_ITEM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Denotes one item of a list.
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	This method is intended to handle <LI>.
 * 		- add a new line
 *		- tab to the right position
 *		- add a item header.  (message call)
 *		- set left margine for the item text.
 *
 *		If this is under <OL>,
 *
 *		If this is under <UL>, <MENU>, or <DIR>,
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_LIST_ITEM_Int
		(MemHandle block, SGMLEntity *entity)
{
  StyleType format, groupType;
  int level, i;
  dword counter;
  char displayType, tab[1] = { C_TAB };
  optr content;

  content = UIGen_GET_CONTENT_Int();
  format = @call content::MSG_GEN_HTML_CONTENT_GET_CONTENT_TYPE();
  if (format != STYLE_OL && format != STYLE_UL) {
	EC_WARNING(UIG_INVALID_LI_ITEM); 
	return UI_GEN_ERROR;
  }

  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTextClass) {
    /* No text object, so create and initialize one */
    @call currentDoc->HTUI_pmanager::
	MSG_PM_TAKE_UNFINISHED_UI_OBJ(currentDoc->HTUI_target.obj);
    UIGen_CREATE_TEXT_OBJECT_Int(NULL, content, 0);
  }
  /*
   * The new item starts on a new line.  If there has been a nested
   * list that just ended, then a new line has been added.  Thus
   * we don't need to add another new line here.
   */
/*  if (@call content::\
	MSG_HTGHC_MSG_GEN_HTML_CONTENT_GET_ANY_LAST_LIST_GROUP() == FALSE) */

    AddNewLine(&(currentDoc->HTUI_target),3,currentDoc, content);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  EC_WARNING_IF(format != groupType, UIG_UNBALANCED_LIST_STACK);
  /*
   * Process any passed attributes list.
   */
  ProcessLIAttr(block, entity, groupType, &counter, &displayType,
	content);
  /*
   * add a 'right' tab for the item header.
   */
  SetTabsForListGroup(level, currentDoc->HTUI_target.obj);
  /*
   * Since the new line break brought the cursor to position 1, we
   * need to tab to the right position for the list item.
   */
  for(i = 0; i <= level; i++)
      @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);

  if (format == STYLE_UL) {
	/* create an unordered list header */
	UIGen_CREATE_UNORDERED_LIST_ITEM_Int(displayType, level);
  }
  else {					/* STYLE_OL */
	/* create an ordered list header */
	UIGen_CREATE_ORDERED_LIST_ITEM_Int(
		counter, displayType, level);
  }
  /*
   * Set the left margin so the item text wraps around at the right place
   */
  @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_LEFT_MARGIN(
				(TAB_SIZE * ( level + 1 )) + 56,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_LIST_ITEM_Int.	*/


/***********************************************************************
 *	UIGen_CREATE_UNORDERED_LIST_ITEM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an item header for an unordered list item.
 * PARAMETERS:	    (char displayType, int level)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	- add a new line
 *		- tab to the right position
 *		- change to the symbol font
 *		- add a symbol representing a item header.
 *		- change the font back.
 *		- set left margine for the item text.
 *		  
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_UNORDERED_LIST_ITEM_Int
		(char displayType, int level)
{
  char	bullet[3] = { C_BULLET, C_TAB };
  optr	content;

  /*
   * Different nesting level has a different item header, unless the
   * attriute specifies otherwise.  This follows the Netscape style.
   */
@if 0
  if (displayType == 'c')
	bullet[0] = C_SMALL_O;
  else if (displayType == 's')
@ifdef PRODUCT_RESPONDER
	bullet[0] = 0x34;
@else
	bullet[0] = C_DBLDAGGER;
@endif
  else if (displayType == 'd')
@ifdef PRODUCT_RESPONDER
	bullet[0] = 0x12;
@else
	bullet[0] = C_U_SIGMA;
@endif
  else if (level == 0)
@ifdef PRODUCT_RESPONDER
	bullet[0] = 0x12;
@else
	bullet[0] = C_U_SIGMA;
@endif
  else if (level == 1)
	bullet[0] = C_SMALL_O;
  else if (level > 1)
	bullet[0] = C_DBLDAGGER;

  /* change font to get a nice looking bullet */
  @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_SYMBOLPS,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
@endif
  /* 
   * Add the item header 
   */
  @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(bullet, 2);
  /*
   * change back the font
   */
  content = UIGen_GET_CONTENT_Int();
  if (@call content::MSG_GEN_HTML_CONTENT_GET_STYLE_COUNT
	(STYLE_FW_FONT)) {
    @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_MONO,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }
  else {
    @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_FONT_ID(
				FID_DTC_URW_SANS,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  }

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_UNORDERED_LI_Int.	*/


/***********************************************************************
 *	UIGen_CREATE_ORDERED_LIST_ITEM_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create an item header for an ordered list item.
 * PARAMETERS:	    (dword counter, char displayType, int level)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 9/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_ORDERED_LIST_ITEM_Int
		(dword counter, char displayType, int level)
{
  int	i;
  char	temp[20];
  optr	content;

  /*
   * Different level has a different item header.  Unless the attriute 
   * of the list item specifies otherwise, we use the default item 
   * headers.  This follows the Netscape style.
   */
  if (displayType == 'A')
    MyVisTextFormatNumber(temp, counter, VTNT_LETTER_UPPER_A);
  else if (displayType == 'a')
    MyVisTextFormatNumber(temp, counter, VTNT_LETTER_LOWER_A);
  else if (displayType == 'I')
    VisTextFormatNumber(temp, counter, VTNT_ROMAN_NUMERAL_UPPER);
  else if (displayType == 'i')
    VisTextFormatNumber(temp, counter, VTNT_ROMAN_NUMERAL_LOWER);
  else 
    VisTextFormatNumber(temp, counter, VTNT_NUMBER);

  for (i=0; temp[i] != '\0'; i++)
	;
  temp[i++]	= C_PERIOD;
  temp[i++]	= C_TAB;
  temp[i]	= '\0';

  content = UIGen_GET_CONTENT_Int();
  @send content::MSG_GEN_HTML_CONTENT_INCREMENT_COUNTER();
  /* 
   * Add the item header 
   */
  @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(temp, 0);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_ORDERED_LIST_ITEM_Int.	*/



/***********************************************************************
 *		UIGen_START_PRE_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    render text in a separated multi-line group
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		Add a new line, change to fixed-width font.  This
 *		method is intended to handle <PRE>, <XMP> and <LISTING>
 *
 *		NOTE!!!!:
 *		This message assumes the parser will not strip off
 *		multiple spaces and line breaks in the source html file
 *		from now on until the end element is seen.
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 6/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_PRE_Int()
{
  optr content;
  content = UIGen_GET_CONTENT_Int();

  AddNewLine(&(currentDoc->HTUI_target), 2, currentDoc, content);
  UIGen_START_FIXED_WIDTH_FONT_Int();
  /*
   * Push format token onto the format stack. 
   */
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_PRE);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_PRE_Int.	*/



/***********************************************************************
 *	UIGen_START_DEFINITION_LIST_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_DEFINITION_LIST_Int()
{
  optr content;
  StyleType groupType;
  int level;
  dword counter;
  char displayType;

  content = UIGen_GET_CONTENT_Int();
  /*
   * Push format token onto the format stack.
   */
  @call content::MSG_GEN_HTML_CONTENT_SET_CONTENT(STYLE_DL);
  /*
   * Add a line break before the first list item if it's the first
   * level of list
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  if (level == -1)
    AddNewLine(&(currentDoc->HTUI_target),1,currentDoc, content);
  /*
   * Push the list group info
   */
  @call content::MSG_GEN_HTML_CONTENT_PUSH_LIST_GROUP(STYLE_DL, 0, 0);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_DEFINITION_LIST_Int.	*/



/***********************************************************************
 *	UIGen_CREATE_DEFINITION_DT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_DEFINITION_DT_Int()
{
  StyleType groupType;
  int level, i;
  dword counter;
  char displayType, tab[1] = { C_TAB }, null[] = { C_NULL };
  optr content = UIGen_GET_CONTENT_Int();
  Tab	nextTab;
 
  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTextClass) {
    /* No text object, so create and initialize one */
    UIGen_APPEND_TEXT_PTR_Int(null,0);
  }
  /*
   * the new item starts on a new line
   */
  AddNewLine(&(currentDoc->HTUI_target), 1, currentDoc, content);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  EC_WARNING_IF(groupType != STYLE_DL, UIG_UNBALANCED_LIST_STACK);

  nextTab.T_lineWidth	= nextTab.T_lineSpacing	=
			  nextTab.T_grayScreen	= 0;
  nextTab.T_position	= TAB_SIZE * level;
  nextTab.T_attr	= TL_NONE | TT_LEFT;
  @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_TAB(nextTab,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
  /*
   * Since the new line break brought the cursor to position 1, we
   * need to tab to the right position for the list item.
   */
  for(i = 0; i < level; i++)
      @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);

  /*
   * Set the left margin so the item text wraps around at the right place
   */
  @send currentDoc->HTUI_target.obj::MSG_VIS_TEXT_SET_LEFT_MARGIN(
				TAB_SIZE * level,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_DEFINITION_DT_Int.	*/



/***********************************************************************
 *	UIGen_CREATE_DEFINITION_DD_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_DEFINITION_DD_Int()
{
  StyleType groupType;
  int level, i;
  dword counter;
  char displayType, tab[1] = { C_TAB }, null[] = { C_NULL };
  optr content = UIGen_GET_CONTENT_Int();

  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTextClass) {
    /* No text object, so create and initialize one */
    UIGen_APPEND_TEXT_PTR_Int(null,0);
  }
  /*
   * the new item starts on a new line
   */
  AddNewLine(&(currentDoc->HTUI_target), 1, currentDoc, content);
  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
	(&groupType, &counter, &displayType, &level);
  EC_WARNING_IF(groupType != STYLE_DL, UIG_UNBALANCED_LIST_STACK);
  /*
   * Since the new line break brought the cursor to position 1, we
   * need to tab to the right position for the list item.
   */
  for(i = 0; i <= level; i++)
    @call currentDoc->HTUI_target.obj::MSG_VIS_TEXT_APPEND_PTR(tab, 1);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_CREATE_DEFINITION_DD_Int.	*/



/***********************************************************************
 *	UIGen_GET_CONTENT_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Get the current content object
 * PARAMETERS:	    optr ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
optr UIGen_GET_CONTENT_Int()
{
  optr obj;
  ClassStruct *class;

  /*
   *  Is target.obj a content object?  Note, HTGenTCellClass is a 
   *  content object.
   */
  if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass ||
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormClass ||
      currentDoc->HTUI_target.class == (ClassStruct *)&HTGenCaptionClass)
	return currentDoc->HTUI_target.obj;
  /*
   * Get PManager's current recvObj, i.e the leaf child of the ui tree.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS(&obj, &class);
  /*
   * Trace up the tree to find a content object.
   */
  while(!@call obj::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass)) {
    if (@call obj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenHtmlContentClass)) {
	/* 
	 * add the new text format to the content object.
	 */
	return obj;
    }
    obj = @call obj::MSG_GEN_FIND_PARENT();
  }
  /*
   * Return the global content object.  If not exists, create one.
  if (!currentDoc->HTUI_pmContent)
    currentDoc->HTUI_pmContent = UICreateObj(currentDoc, &HTGenHtmlContentClass);

   */
  return currentDoc->HTUI_pmContent;
}	/* End of UIGen_GET_CONTENT_Int.	*/


/***********************************************************************
 *	MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Change the simple text rendering.
 * PARAMETERS:	    (ElementType type, TextStyle style)
 *			type - ELEMENT_START	starting element
 *			       ELEMENT_END	ending element
 *			style - TS_BOLD, TS_ITALIC, TS_SUPERSCRIPT,
 *				TS_SUBSCRIPT, TS_STRIKE_THRU, 
 *                              TS_UNDERLINE
 * SIDE EFFECTS:    
 *
 * STRATEGY:  If the style is TS_UNDERLINE(which is the representation
 *            of a hyperlink), then we need to store the link's starting
 *            and ending positions of the text object.
 *            
 *		
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/30/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
{

  if (type == ELEMENT_START) {
    /* 
     * Start a new format
     */
    @call oself::MSG_VIS_TEXT_SET_TEXT_STYLE(0,0,0,style,
					TEXT_ADDRESS_PAST_END,
					TEXT_ADDRESS_PAST_END);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    GrSetTextStyle(@self->HTGT_gstate, style, 0);
  }
  else {
    /* 
     * Clear a format
     */
    @call oself::MSG_VIS_TEXT_SET_TEXT_STYLE(0,0,style,0,
					TEXT_ADDRESS_PAST_END,
					TEXT_ADDRESS_PAST_END);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    GrSetTextStyle(@self->HTGT_gstate, 0, style);
  }
  return;
}	/* End of MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING */



/***********************************************************************
 *		MSG_VIS_TEXT_SET_POINT_SIZE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	   Update the gstate about the change in point size.
 * PARAMETERS:     (WWFixed pointSize, dword rangeEnd, dword rangeStart)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 9/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_VIS_TEXT_SET_POINT_SIZE
{
  WWFixedAsDWord ptSize;
  FontID id;

  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  id = GrGetFont(@self->HTGT_gstate, &ptSize);
  ptSize = MAKE_SIZE_DWORD(pointSize.WWF_frac, pointSize.WWF_int);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  GrSetFont(@self->HTGT_gstate, id, ptSize);
  return;
}	/* End of MSG_VIS_TEXT_SET_POINT_SIZE.	*/



/***********************************************************************
 *		MSG_GEN_TEXT_RECORD_HREF for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Record the HREF segments on the text objects.
 * PARAMETERS:	    (ElementType type, int token)
 *                  type - ELEMENT_START, this is <A>
 *                         ELEMENT_END, this is </A>
 *                  token - HREF token, used to get HREF value.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_RECORD_HREF
{
  VisTextRange pos;
  AnchorElement elm;
  int cnt;
  char buffer[3];

  @call self::MSG_VIS_TEXT_GET_SELECTION_RANGE(&pos);

  if (type == ELEMENT_START) {
    @call currentDoc->HTUI_pmanager::MSG_PM_RECORD_ANCHOR_OBJECT(oself);
    /*
     *  Create an Anchor Element to store the current text position
     *  for the current <A HREF=token> content.
     */
    elm.AE_token = token;
    elm.AE_start = pos.VTR_start;
    elm.AE_end   = -1;
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTListAppend(@self->HTGT_anchorList, &elm, sizeof(AnchorElement));
  }
  else {
    /*
     *  </A> has been encountered.  Use the HREF token to retrieve the
     *  associated Anchor Element and record the current text position
     *  for the ending of the <A HREF=token> content.
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    cnt = HTListGetCount(@self->HTGT_anchorList) - 1;  /* 0 base */
    HTListGetItem(@self->HTGT_anchorList, cnt, &elm, sizeof(AnchorElement));
    EC_ERROR_IF(elm.AE_end != -1, 1);
    elm.AE_end = pos.VTR_start;
    /*
     *  If the last character is C_ENTER, don't count it for <A> content.
     */
    while (1) {
	@call self::MSG_VIS_TEXT_SELECT_RELATIVE(-1, 0);
	@call self::MSG_VIS_TEXT_GET_SELECTION_PTR(buffer);
	if (buffer[0] == C_ENTER && elm.AE_start < elm.AE_end) 
	    elm.AE_end--;
	else
	    break;
    }
    /*
     *  If the first few characters are new lines, don't count them for <A>.
     */
    while (1) {
	@call self::MSG_VIS_TEXT_SELECT_RANGE_SMALL
	    (elm.AE_start, elm.AE_start+1);
	@call self::MSG_VIS_TEXT_GET_SELECTION_PTR(buffer);
	if (buffer[0] == C_ENTER && elm.AE_start < elm.AE_end) 
	    elm.AE_start++;
	else {
	    @call self::MSG_VIS_TEXT_SELECT_END();
	    break;
	}
    }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTListReplaceItem(@self->HTGT_anchorList,cnt,&elm,sizeof(AnchorElement));
  }
}	/* End of MSG_GEN_TEXT_RECORD_HREF.	*/


/***********************************************************************
 *	MSG_GEN_TEXT_INITIALIZE for HTGenTextClass
 ***********************************************************************
 * SYNOPSIS:	    Initialize the text object
 * PARAMETERS:	    (optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_INITIALIZE
{
  WindowHandle win;
  ColorQuad color;
  /*
   * Initialize the list for hyperlink storagge.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_anchorList = HTListNewWID(0);
  /*
   * Set non-editable.
   * If we wants to support Search Feature or dragging, we may want to
   * set GA_TARGETABLE.
   */
  @call self::MSG_GEN_SET_ATTRS(GA_READ_ONLY,0);
  /*
   * Create storage and set multiple attributes
   */
  @call self::MSG_VIS_TEXT_CREATE_STORAGE(
	VTSF_MULTIPLE_CHAR_ATTRS | VTSF_MULTIPLE_PARA_ATTRS, 0);
  /*
   * Add ATTRs and HINTs
   */
  @call self::MSG_META_ADD_VAR_DATA
	(ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE, 0, NULL);
  @call self::MSG_META_ADD_VAR_DATA
	(HINT_EXPAND_WIDTH_TO_FIT_PARENT, 0, NULL);
  /*
   * Mark text selectable so it can be a target and receive hilit.
   * Needed if we'd like to support Search feature in the browser.
  @call self::MSG_META_ADD_VAR_DATA
        (ATTR_GEN_TEXT_SELECTABLE, 0, NULL);
   */
  /*
   * Add a hint to set light grey background.  This hint is needed
   * because it set on the TDSS_COLOR_SET flag, and the flag allow
   * me to make the white background for the print out.
   */
@ifdef	PRODUCT_NIKE
  color.CQ_redOrIndex = C_WHITE;
@else
  color.CQ_redOrIndex = C_LIGHT_GREY;
@endif
  color.CQ_info = CF_INDEX;
  color.CQ_green = 0;
  color.CQ_blue = 0;
  @call self::MSG_META_ADD_VAR_DATA
        (HINT_TEXT_WASH_COLOR, sizeof(ColorQuad), &color);

  /*
   *  Initially not in any row.
   */
  @self->HTGT_pageRow = -1;

  /*
   *  Used to indicate the current hyperlink index that is in focus.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_focalAnchor = -1;
  /*
   *  Store the text formating content object.
   */
  @self->HTGT_content = content;
  /*
   * create gstate, used to calculate min width to set the text width.
   */
  win = @call self::MSG_VIS_QUERY_WINDOW();
  @self->HTGT_gstate = GrCreateState(win);
  /*
   * Initialize the global variables used to check when to split the text obj.
   */
  globalVarWidth = @call pself->HTGT_content::
	  MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE()-MARGIN - MARGIN;
  globalVarSumOfAccLen = 0;

  return @self->HTGT_gstate;
}	/* End of MSG_GEN_TEXT_INITIALIZE.	*/



/***********************************************************************
 *		MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find a <A HREF> link under the given mouse coord.
 * PARAMETERS:	    int (word xPosition, word yPosition)
 *                  return: HREF token, or
 *                          -1 if no HREF is under the mouse.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
{
  PointDWFixed coord;
  dword offset;
  int i, hrefCnt, avg_w;
  AnchorElement elm;
  VisTextConvertOffsetParams params;
  VisTextInstance  * vself;

  coord.PDF_x.DWF_int = xPosition;
  coord.PDF_y.DWF_int = yPosition;
  coord.PDF_x.DWF_frac = coord.PDF_y.DWF_frac = 0;

  /*
   *  There can be a bug that VTI_line is deallocated for some reason.
   *  Thus, call notify_geometry_valid to have a valid VTI_line.
   */
  vself = ObjDerefVis(oself);
  if (!vself->VTI_lines) {
      vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			      VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();
  }
  offset = @call self::MSG_VIS_TEXT_GET_TEXT_POSITION_FROM_COORD(&coord);
  params.VTCOP_offset = offset;
  @call self::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE(&params);
  avg_w = @call self::MSG_VIS_TEXT_GET_AVERAGE_CHAR_WIDTH();
  if ((params.VTCOP_xPos + avg_w) < xPosition)
    return -1;    /* mouse is outside the right edge of this text line. */

  for(i = 0, hrefCnt = HTListGetCount(@self->HTGT_anchorList);
      i < hrefCnt;
      i++) {
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTListGetItem(@self->HTGT_anchorList, i, &elm, sizeof(AnchorElement));
    if (elm.AE_start <= offset && offset <= elm.AE_end) {
      /* Found it! */
      return elm.AE_token;
    }
    if (offset < elm.AE_end)
      break;
  }
  return -1;
}	/* End of MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE.	*/


/***********************************************************************
 *		GetDocumentCoordFromOffsets
 ***********************************************************************
 *
 * SYNOPSIS:	Give the text starting and ending offsets, return the
 *              document coordinates for drawing a box surrounding the
 *              text.
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/19/97   	Initial Revision
 *	
 ***********************************************************************/
Rectangle
GetDocumentCoordFromOffsets(optr text, dword start, dword end, 
			    sdword *left, sdword *top, 
			    sdword *right, sdword *bottom)
{
  VisTextConvertOffsetParams params;
  VisTextGetLineInfoReturnValues retValue;
  VisTextGetLineInfoParameters vtglip;
  LineInfo startLineInfo, lastLineInfo;
  int firstLine, firstLineHgt, secondLine;
  Rectangle bound;

  /*
   *  Get the (left, top) doc coordinate of the start text offset.
   */
  params.VTCOP_offset = start;
  @call text::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE(&params);
  *left = params.VTCOP_xPos;
  *top = params.VTCOP_yPos;

  /*
   *  Get the line height of the starting text offset, which may or may
   *  not be in the same line as the end offset.
   */
  vtglip.VTGLIP_buffer = &startLineInfo;
  vtglip.VTGLIP_bsize = sizeof(LineInfo);
  firstLine = vtglip.VTGLIP_line =
      @call text::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(start);
  @call text::MSG_VIS_TEXT_GET_LINE_INFO(&retValue, &vtglip);
  firstLineHgt = startLineInfo.LI_hgt.WBF_int;

  /*
   *  Get the line height of the end text offset, which may or may not
   *  be in the same line as the start offset.
   */
  vtglip.VTGLIP_buffer = &lastLineInfo;
  vtglip.VTGLIP_bsize = sizeof(LineInfo);
  secondLine = vtglip.VTGLIP_line =
      @call text::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(end);
  @call text::MSG_VIS_TEXT_GET_LINE_INFO(&retValue, &vtglip);
  /*
   *  Get the (right, bottom) doc coordinate of the end text offset.
   */
  params.VTCOP_offset = end;
  @call text::MSG_VIS_TEXT_CONVERT_OFFSET_TO_COORDINATE
      (&params);
  *right = params.VTCOP_xPos;
  *bottom = params.VTCOP_yPos + lastLineInfo.LI_hgt.WBF_int;

  if (firstLine != secondLine) {
    /*
     *  Oh no!  The link wraps to mutiple lines!
     */
    @call text::MSG_VIS_GET_BOUNDS(&bound);
    bound.R_top    = *top + firstLineHgt;
    bound.R_bottom = params.VTCOP_yPos + 2;
    bound.R_right  -= 3;
    bound.R_left   += 2;
  }
  else
      bound.R_right = bound.R_left = bound.R_top = bound.R_bottom = 0;

  return bound;
}	/* End of GetDocumentCoordFromOffsets.	*/


/***********************************************************************
 *		MSG_GEN_TEXT_DRAW_FOCUS for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw the next focusable link.
 * PARAMETERS:	    (in direction, Rectangle *obj, 
 *                   RectDWord *rect, Rectangle *box, RectDWord *ret)
 *                  Return the actual drawing region around the link.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_DRAW_FOCUS
{
  int i, hrefCnt;
  AnchorElement elm;
  EventHandle msg;
  VisTextInstance  *vself;

  /*
   *  Quickly test if the text object has any link or not
   */
  hrefCnt = HTListGetCount(@self->HTGT_anchorList);
  if (!hrefCnt ||
      (obj->R_top > rect->RD_bottom || obj->R_bottom < rect->RD_top)) {
    ret->RD_left = ret->RD_right = 0;   /* to indicate no draw region */
    return;
  }

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if ((i = @self->HTGT_focalAnchor) == -1) {
      if (direction == SEARCH_BACKWARD)
	  i = hrefCnt;
  }

  /*
   *  There can be a bug that VTI_lines is deallocated for some reason.
   *  Thus, call notify_geometry_valid to have a valid VTI_lines.
   */
  vself = ObjDerefVis(oself);
  if (!vself->VTI_lines) {
      vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			      VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();
  }

  while (1) {
    if (direction == SEARCH_FORWARD)
	i++;
    else
	i--;
    if (i < 0 || i >= hrefCnt)
      break;  /* no more hyperlink for this object */
    /*
     *  Find the bounds of the next hyperlink element.
     */
    HTListGetItem(@self->HTGT_anchorList, i, &elm, sizeof(AnchorElement));
    *box = GetDocumentCoordFromOffsets
	(oself, elm.AE_start, elm.AE_end, &(ret->RD_left),  &(ret->RD_top), 
	 &(ret->RD_right), &(ret->RD_bottom));
    /*
     *  Is the hyperlink within the visible region?
     */
    if (ret->RD_left >= rect->RD_left && ret->RD_top >= rect->RD_top &&
	(ret->RD_right)-1<=rect->RD_right && ret->RD_bottom<=rect->RD_bottom &&
	ret->RD_right != ret->RD_left) {
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	@self->HTGT_focalAnchor = i;
	@self->HTGT_focalBound = *ret;
	@self->HTGT_focalBox = *box;

	/*
	 *  Get the href token from the text object and pass to the PManager.
	 */
	msg = @record PresentationManagerClass::MSG_PM_DISPLAY_HREF_TARGET
	    (elm.AE_token, NULL);
	@send self::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
	return;
    }
    /*
     *  We've looped to a hyperlink that is beyond the visible range.
     */
    else if((direction == SEARCH_FORWARD && ret->RD_top > rect->RD_bottom) ||
	    (direction == SEARCH_BACKWARD&& ret->RD_bottom < rect->RD_top)) {
	break;
    }
  }
/*  @self->HTGT_focalAnchor = -1;  */
  /* To indicate no draw region: */
  ret->RD_left = ret->RD_right = ret->RD_top = ret->RD_bottom = 0;
  return;
}	/* End of MSG_GEN_TEXT_DRAW_FOCUS.	*/

/***********************************************************************
 *		MSG_GEN_TEXT_UNDRAW_FOCUS for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Erase the focus drawing.
 * PARAMETERS:	    (optr newLink)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/19/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_UNDRAW_FOCUS
{
  if (oself != newLink)
      /*
       *  The new link is not in the same text object, so mark the 
       *  text object not in focus.
       */
      @self->HTGT_focalAnchor = -1; 

  return;
}	/* End of MSG_GEN_TEXT_UNDRAW_FOCUS.	*/


/***********************************************************************
 *		MSG_GEN_TEXT_FIND_LINK_IN_RECT for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Given the rect, find the next focuable link.
 * PARAMETERS:	    (RectDWord rect)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTextClass, MSG_GEN_TEXT_FIND_LINK_IN_RECT
{
  int i, hrefCnt;
  AnchorElement elm;
  RectDWord ret;
  VisTextInstance  *vself;

  hrefCnt = HTListGetCount(@self->HTGT_anchorList);
  if (!hrefCnt) {
    return FALSE;
  }

  if (direction == SEARCH_BACKWARD)
      i = hrefCnt;
  else
      i = -1;

  /*
   *  There can be a bug that VTI_lines is deallocated for some reason.
   *  Thus, call notify_geometry_valid to have a valid VTI_lines.
   */
  vself = ObjDerefVis(oself);
  if (!vself->VTI_lines) {
      vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			      VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH);
      @call self::MSG_VIS_NOTIFY_GEOMETRY_VALID();
  }
  while (1) {
    if (direction == SEARCH_FORWARD)
	i++;
    else
	i--;
    if (i < 0 || i >= hrefCnt)
      break;  /* no more hyperlink for this object */
    /*
     *  Find the bounds of the next hyperlink element.
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTListGetItem(@self->HTGT_anchorList, i, &elm, sizeof(AnchorElement));
    GetDocumentCoordFromOffsets(oself, elm.AE_start, elm.AE_end, 
				&(ret.RD_left),  &(ret.RD_top), 
				&(ret.RD_right), &(ret.RD_bottom));
    /*
     *  Is the hyperlink within the visible region?
     */
    if (ret.RD_left > rect.RD_left && ret.RD_top > rect.RD_top &&
	ret.RD_right< rect.RD_right && ret.RD_bottom < rect.RD_bottom &&
	ret.RD_right != ret.RD_left) {
	return TRUE;
    }
    /*
     *  We've looped to a hyperlink that is beyond the visible range.
     */
    else if((direction == SEARCH_FORWARD && ret.RD_top > rect.RD_bottom) ||
	    (direction == SEARCH_BACKWARD&& ret.RD_bottom < rect.RD_top)) {
	break;
    }
  }
  return FALSE;
}	/* End of MSG_GEN_TEXT_FIND_LINK_IN_RECT.	*/


/***********************************************************************
 *		MSG_GEN_TEXT_IS_MULTILINE for HTGenTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
