/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenFormHiddenClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormHiddenClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These would be destroyed when we delete the blocks using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGFH_name)
     *   HTMemFree(@self->HTGFH_name);
     * if (@self->HTGFH_value)
     *   HTMemFree(@self->HTGFH_value);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_FORM_HIDDEN_SUBMIT for HTGenFormHiddlenClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate name=value pair and store it in the query.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Handle <INPUT TYPE=HIDDEN name=? value=?>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormHiddenClass, MSG_GEN_FORM_HIDDEN_SUBMIT
{
  HTMemHandle temp;

  if (@self->HTGFH_name && @self->HTGFH_value) {
    /*
     *  Append the "name".
     */
    temp = HTStrHTMemAllocCopyWID(0, @self->HTGFH_name);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
    /*
     *  Append the "value".
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    temp = HTStrHTMemAllocCopyWID(0, @self->HTGFH_value);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
  }
  return;
}	/* End of MSG_GEN_FORM_HIDDEN_SUBMIT.	*/



/***********************************************************************
 *		MSG_GEN_RESET for HTGenFormHiddenClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Reset the password field back to the default.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormHiddenClass, MSG_GEN_RESET
{
  char *cptr;

  if (@self->HTGFH_value) {
    /*
     *  Ok, there were some default text string.
     */
    cptr = HTMemLock(@self->HTGFH_value);
    @call self::MSG_VIS_TEXT_REPLACE_ALL_PTR(cptr, 0);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTMemUnlock(@self->HTGFH_value);
    @call self::MSG_VIS_TEXT_SCREEN_UPDATE();
  }
  else
    /*
     *  Cear any text in the input field.
     */
    @call self::MSG_VIS_TEXT_DELETE_ALL();

  return;
}	/* End of MSG_GEN_RESET.	*/


