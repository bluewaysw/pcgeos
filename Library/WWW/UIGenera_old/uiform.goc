/***********************************************************************
 *		MSG_META_START_SELECT for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_META_START_SELECT
{
  EventHandle msg;
  Rectangle box, rect;

  @call self::MSG_VIS_GET_BOUNDS(&rect);
  box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
  rect.R_left -= 1;
  @self->HTGI_focalBound.RD_left   = rect.R_left;
  rect.R_right += 1;
  @self->HTGI_focalBound.RD_right  = rect.R_right;
  rect.R_top -= 1;
  @self->HTGI_focalBound.RD_top    = rect.R_top;
  @self->HTGI_focalBound.RD_bottom = rect.R_bottom;
  msg = @record PresentationManagerClass::MSG_PM_GRAB_NEW_FOCUS
      (oself, rect, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
  @send oself::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
  @callsuper();
  return;
}	/* End of MSG_META_START_SELECT.	*/


