/* The code for MultiLineSelection. */

/***********************************************************************
 *	MSG_HTGMLS_PROCESS_ATTRIBUTE for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index = 0;
  ChunkHandle chunk;

  @self->HTGMLS_exclusive = TRUE;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if(entity[index].SGMLE_token == HTML_ATTR_MULTIPLE) {
      	@self->HTGMLS_exclusive = FALSE;
	continue;
    }

    if (!entity[index].SGMLE_value)
	continue;

    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      /* allocate a chunk to store the NAME data */
      chunk =  LMemAlloc(HandleOf(oself), strlen(value)+1);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      @self->HTGMLS_name = chunk;
      cptr = (char *)LMemDerefHandles(HandleOf(oself), @self->HTGMLS_name);
      strcpy(cptr,value);
      break;
    case HTML_ATTR_SIZE:
      @self->HTGMLS_size = atoi(value);
      /* the size must be greater than one! */
/*      EC_ERROR_IF(@self->HTGMLS_size <= 1, UIG_UI_TREE_OPERATION_FAILS); */
      break;
    }
  }

  /* the minmum size for multi-selection must be 4 */
  if(@self->HTGMLS_size < 2) @self->HTGMLS_size = 4;

  return;
}	/* End of MSG_HTGMLS_PROCESS_ATTRIBUTE.	*/



/***********************************************************************
 *	MSG_HTGMLS_ADD_ONE_OPTION_VALUE for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	 char *value, Boolean selected
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
typedef struct {
    Boolean OS_selected;
    Boolean OS_default;
    HTMemHandle OS_value;
    HTMemHandle OS_text;
} OptionStruct;

@method HTGenMultiLineSelectClass, MSG_HTGMLS_ADD_OPTION_VALUE
{
    OptionStruct option;

    /*
     * Check if there is a valid chunkarray. 
     */
    if(!@self->HTGMLS_optionsList) {
       @self->HTGMLS_optionsList = HTListNewWID(0);
       @self->HTGMLS_optionsNum = 0;
    }

    option.OS_selected = selected;
    option.OS_default = selected;
    option.OS_value = 0;
    option.OS_text = 0;

    if (value) {
	char *ptr;
	ptr = (char *)HTMemAllocAndLockWID(0, &(option.OS_value), strlen(value)+1);
	strcpy(ptr, value);
	HTMemUnlock(option.OS_value);
    }

    HTListAppend(@self->HTGMLS_optionsList, &option, sizeof(OptionStruct));

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  
    return;
}	/* End of MSG_HTGMLS_ADD_OPTION_VALUE.	*/



/***********************************************************************
 *	MSG_HTGMLS_ADD_OPTION_TEXT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    char *text
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_ADD_OPTION_TEXT
{
    OptionStruct *option, opt;
    int	last;
    word size;
    GStateHandle gstate;
    MemHandle mem;
    char *ptr;

    /*
     * Check if there is a valid chunkarray. 
     */
    if(!@self->HTGMLS_optionsList) {
       @self->HTGMLS_optionsList = HTListNewWID(0);
       @self->HTGMLS_optionsNum = 0;

       opt.OS_selected = FALSE;
       opt.OS_default = FALSE;
       opt.OS_value = 0;
       opt.OS_text = 0;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
       HTListAppend(@self->HTGMLS_optionsList, &opt, sizeof(OptionStruct));
    }


    last = HTListGetCount(@self->HTGMLS_optionsList) - 1;

    if(last < 0) return;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    option = HTListLockItem(@self->HTGMLS_optionsList, last, &mem);

    if (!option->OS_text) {
	ptr = (char *)HTMemAllocAndLockWID(0, &(option->OS_text), strlen(text)+1);
	strcpy(ptr, text);
	HTMemUnlock(option->OS_text);
    } else {
	/*
	 *  Append the new text to the old text.
	 */
	word len;
	ptr = (char *)HTMemLock(option->OS_text);
	len = strlen(ptr)+1;
	HTMemUnlock(option->OS_text);
	option->OS_text = HTMemReAllocWID(0, option->OS_text, len+strlen(text));
	ptr = (char *)HTMemLock(option->OS_text);
	strcat(ptr, text);
	HTMemUnlock(option->OS_text);
    }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

    HTListUnlock(mem);

    /* 
     * Find the longest text string. 
     */ 
    gstate = GrCreateState(0);
    size = GrTextWidth(gstate, text, strlen(text));
    if(size > @self->HTGMLS_len) @self->HTGMLS_len = size;
    GrDestroyState(gstate);

    return;
}	/* End of MSG_HTGMLS_ADD_OPTION_TEXT.	*/



/***********************************************************************
 *  MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT
{
    optr item;
    int i;
    SpecSizeSpec sizeSpec;
    CompSizeHintArgs sizeArgs;
    BackgroundColors bgColors;

    bgColors.BC_unselectedColor1 = C_WHITE;
    bgColors.BC_unselectedColor2 = C_WHITE;
    bgColors.BC_selectedColor1 = C_WHITE;
    bgColors.BC_selectedColor2 = C_WHITE;
  
    sizeSpec = SST_PIXELS | 0;
   
    sizeArgs.CSHA_width = SST_PIXELS | @self->HTGMLS_len;
    sizeArgs.CSHA_height = SST_LINES_OF_TEXT | 1;
    sizeArgs.CSHA_count = 1;

/*
    EC_ERROR_IF(sizeArgs.CSHA_width < 0, UIG_ERROR_NEGATIVE_WIDTH);
    @call self::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);
*/

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    if(!@self->HTGMLS_optionsList) return;

    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX, 0, NULL);
@ifdef TRUNK
    @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_3D_LOWERED, 0, NULL);
@endif
    @call self::MSG_META_ADD_VAR_DATA(
			HINT_ORIENT_CHILDREN_VERTICALLY, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA(
			HINT_NO_TALLER_THAN_CHILDREN_REQUIRE, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA(
			HINT_NO_WIDER_THAN_CHILDREN_REQUIRE, 0, NULL);
    @call self::MSG_META_ADD_VAR_DATA
		(HINT_CUSTOM_CHILD_SPACING, sizeof(SpecSizeSpec), 
		 &sizeSpec); 
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_GADGET_BACKGROUND_COLORS, 
	 sizeof(BackgroundColors), &bgColors);

    /* Create a chunkarray to hold the children. */
    @self->HTGMLS_itemList = HTListNewWID(0);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @self->HTGMLS_optionsNum = 
	HTListGetCount(@self->HTGMLS_optionsList);

    for(i=0; i<@self->HTGMLS_size && i<@self->HTGMLS_optionsNum; i++) {
	item = UICreateObj(currentDoc, (ClassStruct *)&HTOtherOptionClass);

@ifdef TRUNK
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_DRAW_STYLE_FLAT, 0, NULL);
@endif
	@call item::MSG_META_ADD_VAR_DATA(
			HINT_NO_BORDERS_ON_MONIKERS, 0, NULL);
	EC_ERROR_IF(@self->HTGMLS_len < 0, UIG_ERROR_NEGATIVE_WIDTH);
    	@call item::MSG_META_ADD_VAR_DATA
		(HINT_FIXED_SIZE, sizeof(sizeArgs), &sizeArgs);

	@call self::MSG_GEN_ADD_CHILD(item, CCF_MARK_DIRTY);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	@call item::MSG_HTOO_SET_ML(oself);
	@call item::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);

	HTListAppend(@self->HTGMLS_itemList, &item, sizeof(optr));
    }

    @call self::MSG_HTGMLS_SET_ALL_MONIKER();

}	/* End of MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT.	*/



/***********************************************************************
 *		MSG_HTGMLS_SET_ALL_MONIKER for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_SET_ALL_MONIKER
{
    OptionStruct *option;
    char  *text;
    int  i, realItem;
    optr *item;
    MemHandle imem, omem;

    EC_ERROR_IF(!@self->HTGMLS_optionsList, UIG_UI_TREE_OPERATION_FAILS);

    if(!@self->HTGMLS_optionsList) return;

    for(i=0; i<@self->HTGMLS_size && i<@self->HTGMLS_optionsNum; i++) {
    	realItem = i + @self->HTGMLS_currentFirst;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
        if(realItem < @self->HTGMLS_optionsNum) {
	    item = HTListLockItem
		(@self->HTGMLS_itemList,
		 min(@self->HTGMLS_size,@self->HTGMLS_optionsNum) - i - 1, 
		 &imem);

	    option = HTListLockItem
		(@self->HTGMLS_optionsList,
		 realItem, &omem);

	    @send (*item)::MSG_HTOO_SET_SEL(option->OS_selected);

	    if(option->OS_text) {
		text = HTMemLock(option->OS_text);
		@call (*item)::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			(char *)text, VUM_DELAYED_VIA_APP_QUEUE);
		HTMemUnlock(option->OS_text);
	    } else 
		@send (*item)::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
			"", VUM_DELAYED_VIA_APP_QUEUE);

	    HTListUnlock(imem);
	    HTListUnlock(omem);
	}
    }
}	/* End of MSG_HTGMLS_SET_ALL_MONIKER.	*/



/***********************************************************************
 *		MSG_HTGMLS_SCROLL_UP for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_SCROLL_UP,
				   MSG_HTGMLS_SCROLL_DOWN
{
    Rectangle rect;
    
    @call self::MSG_VIS_GET_BOUNDS(&rect);

    if(message == MSG_HTGMLS_SCROLL_UP && @self->HTGMLS_currentFirst) {
	@self->HTGMLS_currentFirst --;
	if(!@self->HTGMLS_currentFirst && @self->HTGMLS_timerHandle) {

	    TimerStop(@self->HTGMLS_timerHandle, @self->HTGMLS_timerId);
	    @self->HTGMLS_timerHandle = 0;
	    @self->HTGMLS_timerId = 0;
	    @self->HTGMLS_pressUpOrDown = 0;
	}
    } else if(message == MSG_HTGMLS_SCROLL_DOWN && 
	      ((@self->HTGMLS_optionsNum - @self->HTGMLS_currentFirst)
		> @self->HTGMLS_size)) {
	@self->HTGMLS_currentFirst ++;
	    
	if(((@self->HTGMLS_optionsNum - @self->HTGMLS_currentFirst)
	    == @self->HTGMLS_size) && @self->HTGMLS_timerHandle) {

	    TimerStop(@self->HTGMLS_timerHandle, @self->HTGMLS_timerId);
	    @self->HTGMLS_timerHandle = 0;
	    @self->HTGMLS_timerId = 0;
	    @self->HTGMLS_pressUpOrDown = 0;
	}
    }

    @call self::MSG_HTGMLS_SET_ALL_MONIKER();

    /* 
     * Redraw the arrows
     */
    @send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_top + 16, rect.R_right - 1,
		rect.R_top + 1, rect.R_right - 16);

    @send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_bottom - 1, rect.R_right - 1,
		rect.R_bottom - 16, rect.R_right - 16);

}	/* End of MSG_HTGMLS_SCROLL_UP.	*/



/***********************************************************************
 *		MSG_HTGMLS_CHANGE_SELECT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    optr item
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_CHANGE_SELECT
{
    word i, current;
    optr *tmp;
    OptionStruct *option;
    MemHandle imem, omem;

    if(!@self->HTGMLS_optionsList) return;

    if(@self->HTGMLS_exclusive) {
	for(i=0; i<@self->HTGMLS_size; i++) {
	    tmp = HTListLockItem(@self->HTGMLS_itemList, i, &imem);
	    if(*tmp != item) {
		if (@call (*tmp)::MSG_HTOO_GET_SEL()) {
		    @call (*tmp)::MSG_HTOO_SET_SEL(FALSE);
		    @send (*tmp)::MSG_VIS_INVALIDATE();
	 	}
	    } else
		current = i;

	    HTListUnlock(imem);
	}

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
	current = @self->HTGMLS_size - current - 1 
			+ @self->HTGMLS_currentFirst;

	for(i=0; i<@self->HTGMLS_optionsNum; i++) {
	    option = HTListLockItem(@self->HTGMLS_optionsList, i, &omem);
	    if(i == current) 
		option->OS_selected = !option->OS_selected;
	    else if(option->OS_selected) 
		option->OS_selected = FALSE;

	    HTListUnlock(omem);
	}		

    } else {

	for(i=0; i<@self->HTGMLS_size; i++) {
	    tmp = HTListLockItem(@self->HTGMLS_itemList, i, &imem);
	    if(*tmp == item) current = i;
	    HTListUnlock(imem);
	}

	current = @self->HTGMLS_size - current - 1 
			+ @self->HTGMLS_currentFirst;

	option = HTListLockItem(@self->HTGMLS_optionsList, current, &omem);
	option->OS_selected = !option->OS_selected;
	HTListUnlock(omem);
    }

}	/* End of MSG_HTGMLS_CHANGE_SELECT.	*/


/***********************************************************************
 *		MSG_META_START_SELECT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    MouseReturnParams *retVal = bpaxdxcx,
 *		    sword xPosition = cx,
 *	       	    sword yPosition = dx,
 *		    word inputState = bp
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *            what we want to do here is to check if the user click on 
 *            the up-down arrows areas. if it is, we need send up/down 
 *            message to ourself and mark the event processed, otherwise, 
 *            we callsuper and let the event go down to the option items.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_META_START_SELECT
{
    Rectangle rect, box;
    EventHandle msg;
    
    @call self::MSG_VIS_GET_BOUNDS(&rect);

    @self->HTGMLS_pressUpOrDown = 0;
    if(xPosition < rect.R_right - 15 || 
       (yPosition > rect.R_top + 15 && yPosition < rect.R_bottom - 15)) { 
	@callsuper();
    }
    else {
      if(yPosition < rect.R_top + 15) {
	/* up arrow */
	if(@self->HTGMLS_currentFirst) {
	    @self->HTGMLS_pressUpOrDown = 1;
	    @send self::MSG_HTGMLS_SCROLL_UP(); 

	    @self->HTGMLS_timerHandle = TimerStart(
			TIMER_EVENT_CONTINUAL, oself, 10, 
			MSG_HTGMLS_SCROLL_UP, 10, 
		        &(@self->HTGMLS_timerId));
	}
      } else {
	if(@self->HTGMLS_optionsNum - @self->HTGMLS_currentFirst 
		> @self->HTGMLS_size) {
	    @self->HTGMLS_pressUpOrDown = 2;
	    @send self::MSG_HTGMLS_SCROLL_DOWN(); 

	    @self->HTGMLS_timerHandle = TimerStart(
			TIMER_EVENT_CONTINUAL, oself, 10, 
			MSG_HTGMLS_SCROLL_DOWN, 10,
		        &(@self->HTGMLS_timerId));
	}
      }
    }
    rect.R_bottom = rect.R_bottom + 2;
    rect.R_right = rect.R_right + 1;
    rect.R_left = rect.R_left - 2;
    rect.R_top = rect.R_top - 2;
    box.R_right = box.R_left = box.R_top = box.R_bottom = 0;
    msg = @record PresentationManagerClass::MSG_PM_GRAB_NEW_FOCUS
	(oself, rect, box, &HTGenTextClass, &HTGenImageClass, &HTGenInputClass);
    @send oself::MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS(msg);
/*    @call @visParent::MSG_VIS_TAKE_GADGET_EXCL(oself); */

    retVal->flags = MRF_PROCESSED;
    return;
}	/* End of MSG_META_START_SELECT.	*/


/***********************************************************************
 *		MSG_META_END_SELECT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/23/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_META_END_SELECT
{
    Rectangle rect;
    
    @call self::MSG_VIS_GET_BOUNDS(&rect);

    @call self::MSG_VIS_RELEASE_MOUSE();
/*    @call @visParent::MSG_VIS_RELEASE_GADGET_EXCL(oself);*/

    if(@self->HTGMLS_timerHandle) {
	TimerStop(@self->HTGMLS_timerHandle, @self->HTGMLS_timerId);
	@self->HTGMLS_timerHandle = 0;
	@self->HTGMLS_timerId = 0;
    }

    if(@self->HTGMLS_pressUpOrDown == 1) {
	@send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_top + 16, rect.R_right - 1,
		rect.R_top + 1, rect.R_right - 16);
    } else if(@self->HTGMLS_pressUpOrDown == 2) {
	@send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
		rect.R_bottom - 1, rect.R_right - 1,
		rect.R_bottom - 16, rect.R_right - 16);
    }

    @self->HTGMLS_pressUpOrDown = 0;
	
    retVal->flags = MRF_REPLAY;
    return;
}	/* End of MSG_META_END_SELECT.	*/


