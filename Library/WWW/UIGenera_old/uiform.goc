  return;
}	/* End of MSG_GEN_INPUT_ADD_SIBLING.	*/



/***********************************************************************
 *		MSG_GEN_INPUT_CLEAR_SELECTIONS for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Unselect the INPUT objects if it has the same NAME
 *                  but not the selectedObj.  Return the next INPUT 
 *                  object in the linked list if it exists.
 * PARAMETERS:	    (HTMemHandle name, optr selectedObj)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_CLEAR_SELECTIONS
{
  char *source, *target;

  if (@self->GIGI_behaviorType == GIGBT_EXCLUSIVE && oself != selectedObj
      && @self->HTGI_name){
    /*  It's a exclusive selection */
    /*  Compare the strings. */
    source = (char *)HTMemLock(name);
    target = (char *)HTMemLock(@self->HTGI_name);
    if (strcasecmp(target, source) == 0)
      /* This INPUT is under the same selection group.  Unselect it */
      @call self::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(FALSE);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTMemUnlock(@self->HTGI_name);
    HTMemUnlock(name);
  }

  return @self->HTGI_next;
}	/* End of MSG_GEN_INPUT_CLEAR_SELECTIONS.	*/



/***********************************************************************
 *		MSG_GEN_INPUT_SUBMIT for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate a name=value pair for the form submission.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_SUBMIT
{
  HTMemHandle temp;
  word selection = @call self::MSG_GEN_ITEM_GROUP_GET_SELECTION();

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (selection != GIGS_NONE && @self->HTGI_name) {
    /*
     *  Append the "name".
     */
    temp = HTStrHTMemAllocCopyWID(0, @self->HTGI_name);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
    /*
     *  Append the "value".
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    if (!@self->HTGI_value) {
      temp = HTStrAllocCopyWID(0, "on");
    }
    else {
      temp = HTStrHTMemAllocCopyWID(0, @self->HTGI_value);
    }
    HTListAppend(query, &temp, sizeof(HTMemHandle));
  }
  return;
}	/* End of MSG_GEN_INPUT_SUBMIT.	*/



/***********************************************************************
 *		MSG_GEN_RESET for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Reset the GenItem group back to its default
 *		    selection(s)
