/***********************************************************************
 *		MSG_GEN_INPUT_STORE_DATA for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the identity of the INPUT object.  Some of
 *                  data will be submitted to a remote server.
 * PARAMETERS:	    (HTMemHandle name, HTMemHandle value, 
 *                   Boolean checked, InputType type, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 8/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_INPUT_STORE_DATA
{
  word br;
  @self->HTGI_name  = name;
  @self->HTGI_value = value;
  @self->HTGI_content = content;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGI_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGI_noBr = br;

  if (type == INPUT_CHECKBOX)
    @self->GIGI_behaviorType = GIGBT_NON_EXCLUSIVE;

  if (checked == TRUE) {
    @call oself::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0, FALSE);
    @self->HTGI_select = TRUE;
  }

  return;
}	/* End of MSG_GEN_INPUT_STORE_DATA.	*/


/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Free the allocated instance data.
 * PARAMETERS:	    (VisUpdateMode updateMode, CompChildFlags flags)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_DESTROY
{
  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGI_name)
    HTMemFree(@self->HTGI_name);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGI_value)
    HTMemFree(@self->HTGI_value);

  return;
}	/* End of MSG_GEN_DESTROY.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenInputClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These are allocated using HTMemAllocWID and deleted using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGI_name)
     * HTMemFree(@self->HTGI_name);
     * if (@self->HTGI_value)
     * HTMemFree(@self->HTGI_value);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



