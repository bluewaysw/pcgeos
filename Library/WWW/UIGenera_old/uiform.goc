/***********************************************************************
 *		MSG_META_FUP_KBD_CHAR for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word character = cx,
 *			word flags = dx,
 *			word state = bp
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_META_FUP_KBD_CHAR
{
    if( ! ((flags & CF_RELEASE)
	    || ((flags >> 8) & SS_LCTRL) 
	    || ((flags >> 8) & SS_RCTRL) )) {
	if(character == (VC_ISCTRL << 8 | VC_UP)) {
	    if(@self->HTGMLS_currentFirst) {
		@send self::MSG_HTGMLS_SCROLL_UP();
		return TRUE;
	    }
	} else if(character == (VC_ISCTRL << 8 | VC_DOWN)) {
	    if( @self->HTGMLS_optionsNum - @self->HTGMLS_currentFirst 
		> @self->HTGMLS_size) {
		@send self::MSG_HTGMLS_SCROLL_DOWN();
		return TRUE;
	    }
	}
    }
    return @callsuper();
}	/* End of MSG_META_FUP_KBD_CHAR.	*/



/***********************************************************************
 *		MSG_VIS_DRAW for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	5/22/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_VIS_DRAW
{
    Rectangle rect;
    
    @call self::MSG_VIS_GET_BOUNDS(&rect);

    if (drawFlags & DF_PRINT) {
	/*
	 *  Draw the bound.
	 */
	GrSaveState(gstate);
	GrSetLineColor(gstate, CF_INDEX, C_DARK_GREY, 0, 0);
	GrDrawRect(gstate, rect.R_left, rect.R_top,
		   rect.R_right, rect.R_bottom);
	GrRestoreState(gstate);
    }

    @callsuper();

    if(@self->HTGMLS_currentFirst) {
	@callsuper();
	if(@self->HTGMLS_pressUpOrDown != 1) {
	    GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	    GrDrawRect(gstate, rect.R_right - 15, rect.R_top + 2, 
		   rect.R_right - 2 , rect.R_top + 15);
	} else {
	    GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	    GrFillRect(gstate, rect.R_right - 15, rect.R_top + 2, 
		   rect.R_right - 2 , rect.R_top + 15);
	}
    } 

    if( @self->HTGMLS_optionsNum - @self->HTGMLS_currentFirst 
		> @self->HTGMLS_size) {
	if(@self->HTGMLS_pressUpOrDown != 2) {
	    GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	    GrDrawRect(gstate, rect.R_right - 15, rect.R_bottom - 15, 
		   rect.R_right - 2, rect.R_bottom - 2);
	} else {
	    GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
	    GrFillRect(gstate, rect.R_right - 15, rect.R_bottom - 15, 
		   rect.R_right - 2, rect.R_bottom - 2);
	}
    }

    if (@self->HTGMLS_focalBound.RD_right != 
	@self->HTGMLS_focalBound.RD_left) {
	RedrawFocus (gstate, &@self->HTGMLS_focalBound);
    }
    return;
}	/* End of MSG_VIS_DRAW.	*/



/***********************************************************************
 *		MSG_HTGMLS_SUBMIT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    HTListHandle query
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_SUBMIT
{
    char *cptr, *name;
    word i;
    OptionStruct *option;
    HTMemHandle htmh;
    MemHandle mem;

    if(!@self->HTGMLS_name) return;

    name = LMemDerefHandles(OptrToHandle(oself), @self->HTGMLS_name);

    for(i=0; i<@self->HTGMLS_optionsNum; i++) {
	option = HTListLockItem(@self->HTGMLS_optionsList, i, &mem);
 	if(option->OS_selected) {
	    if(option->OS_value) 
		cptr = HTMemLock(option->OS_value);
	    else 
		cptr = HTMemLock(option->OS_text);

	    htmh = HTStrAllocCopyWID(0, name);
	    HTListAppend(query, &htmh, sizeof(HTMemHandle));
	    htmh = HTStrAllocCopyWID(0, cptr);
	    HTListAppend(query, &htmh, sizeof(HTMemHandle));

	    if(option->OS_value)
		HTMemUnlock(option->OS_value);
	    else 
		HTMemUnlock(option->OS_text);
	}
	HTListUnlock(mem);
    }

  return;
}	/* End of MSG_HTGMLS_SUBMIT.	*/


/***********************************************************************
 *	MSG_HTGMLS_STORE_CONTENT for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_HTGMLS_STORE_CONTENT
{
  word br;
  @self->HTGMLS_content = content;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGMLS_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGMLS_noBr = br;

  return;
}	/* End of MSG_HTGMLS_STORE_CONTENT.	*/


/***********************************************************************
 *		MSG_HTGMLS_SET_FOCUS for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/26/97   	Initial Revision
 *	
