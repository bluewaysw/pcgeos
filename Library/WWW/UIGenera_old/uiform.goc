 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormClass, MSG_SPEC_BUILD_BRANCH
{
  @callsuper();
  if (@self->HTGF_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGF_guessSize),
				 DWORD_HEIGHT(@self->HTGF_guessSize));
  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormClass, MSG_VIS_RECALC_SIZE
{
  VisCompInstance * vself;

  /*
   *  Get the sum of heights in this cell's height array.
   *  Get the width of the widest row in this cell.
   */

  @call self::MSG_GEN_HTML_CONTENT_GET_DIMENSION(&width, &height);
  /*
   *  Form object doesn't need the right margin.  The object in the 
   *  form already reserve a right margin already.
   */
  width -= MARGIN;

@if 0
  @callsuper();   /* don't brother.  Each child calc its size already */
@endif
  /*
   *  Clear the bits.  We don't rely on system to do updates anymore.
   */
  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID);

  return MAKE_SIZE_DWORD(width, height);
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set its new X and Y position
 * PARAMETERS:	    (int xOrigin = cx, int yOrigin)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 1/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  SizeAsDWord pSize = @call @genParent::MSG_VIS_GET_SIZE(),
              oSize = @call self::MSG_VIS_GET_SIZE();

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

@if 0
  if (@self->HTGF_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGF_xPos;
  }
  else {
    lineWidth = @call @self->HTGF_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGF_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTGF_xPos;
    else if (@self->HTGF_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGF_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGF_xPos);
  }
@endif

  /*
   *  Because FORM always starts and ends with a new line, its width must 
   *  be the same as the parent.  The reaseon I resize here is because
   *  during the MSG_VIS_RECALC_SIZE, the parent may not have been built
   *  yet.  However, here the parent size has been determine already.
   */
  if(DWORD_WIDTH(pSize) > DWORD_WIDTH(oSize))
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(pSize), DWORD_HEIGHT(oSize));

  xOrigin = DWORD_X(xy) ;
  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
	(@self->HTGF_content, @self->HTGF_pageRow, oself);

@if 0
  @callsuper();
@endif

  @call self::MSG_VIS_SET_POSITION(xOrigin, yOrigin);
  /*
   *  Because all TCell objects have VA_MANAGED bit cleared, we have to
   *  manually broadcast this message.
   */
  @send @genChildren::MSG_VIS_POSITION_BRANCH(0,0);

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


