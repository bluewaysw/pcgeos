/***********************************************************************
 *		MSG_GEN_OPTION_SUBMIT for HTGenOptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate a name=value pair for the form submission.
 *                  and store it in the passed query list.
 * PARAMETERS:	    (HTMemHandle chunk, HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:     Handles <INPUT TYPE=CHECKBOX value=? name=?> 
 *                       Or
 *                       <SELECT name=?>
 *                         <OPTION value=?>
 *                       </SELECT>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/21/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenOptionClass, MSG_GEN_OPTION_SUBMIT
{
  HTMemHandle temp;

  if (chunk && @self->HTGO_value) {
    /*
     *  Append the "name".
     */
    temp = HTStrHTMemAllocCopyWID(0, chunk);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
    /*
     *  Append the "value".
     */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    temp = HTStrHTMemAllocCopyWID(0, @self->HTGO_value);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
  }
  return;
}	/* End of MSG_GEN_OPTION_SUBMIT.	*/


