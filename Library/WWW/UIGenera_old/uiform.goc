  return;
}	/* End of MSG_HTGMLS_SET_FOCUS.	*/




/***********************************************************************
 *		MSG_GEN_RESET for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	mzhu	10/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_GEN_RESET
{
    word i;
    OptionStruct *option;
    MemHandle mem;

    if(!@self->HTGMLS_optionsList) return;

    for(i=0; i<@self->HTGMLS_optionsNum; i++) {
	option = HTListLockItem(@self->HTGMLS_optionsList, i, &mem);
	option->OS_selected = option->OS_default;
	HTListUnlock(mem);
    }

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

    @self->HTGMLS_currentFirst = 0;
    @send self::MSG_HTGMLS_SET_ALL_MONIKER();

    return;
}	/* End of MSG_GEN_RESET.	*/


/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	8/ 4/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_GEN_DESTROY
{
    word i;
    OptionStruct *option;
    MemHandle mem;

    if(@self->HTGMLS_optionsList) {
	for(i=0; i<@self->HTGMLS_optionsNum; i++) {
	    option = HTListLockItem(@self->HTGMLS_optionsList, i, &mem);
	    if(option->OS_value) HTMemFree(option->OS_value);
	    if(option->OS_text) HTMemFree(option->OS_text);
	    HTListUnlock(mem);
	}
	HTListDeleteAllItems(@self->HTGMLS_optionsList);
    } 

    if(@self->HTGMLS_itemList) {
	HTListDeleteAllItems(@self->HTGMLS_itemList);
    } 

    if (@self->HTGMLS_name)
	LMemFreeHandles(HandleOf(oself), @self->HTGMLS_name);
    
    if (@self->HTGMLS_timerHandle)
	TimerStop(@self->HTGMLS_timerHandle, @self->HTGMLS_timerId);

    @callsuper();
}	/* End of MSG_GEN_DESTROY.	*/



/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/16/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * All these stuff is allocated using HTListNewWID, HTMemAllocWID,
     * etc. Hence will be destroyed using HTListDeleteAllWID and 
     * HTMemFreeAllWID.
     */
    /*
     * word i;
     * OptionStruct *option;
     * MemHandle mem;
     *
     * if(@self->HTGMLS_optionsList) {
     *   for(i=0; i<@self->HTGMLS_optionsNum; i++) {
     *	    option = HTListLockItem(@self->HTGMLS_optionsList, i, &mem);
     *	    if(option->OS_value) HTMemFree(option->OS_value);
     *	    if(option->OS_text) HTMemFree(option->OS_text);
     *	    HTListUnlock(mem);
     *	}
     *	HTListDeleteAllItems(@self->HTGMLS_optionsList);
     * } 
     *
     * if(@self->HTGMLS_itemList) {
     *   HTListDeleteAllItems(@self->HTGMLS_itemList);
     * } 
     * 
     * if (@self->HTGMLS_name)
     *   LMemFreeHandles(HandleOf(oself), @self->HTGMLS_name);
     *
     */

    if (@self->HTGMLS_timerHandle)
	TimerStop(@self->HTGMLS_timerHandle, @self->HTGMLS_timerId);

    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/



/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_SPEC_BUILD_BRANCH
{
/*  VisCompInstance * vself; */

  @callsuper();
  if (@self->HTGMLS_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGMLS_guessSize),
				 DWORD_HEIGHT(@self->HTGMLS_guessSize));
  /*
   *  Clear the bits.  We don't rely on system to do updates anymore.
  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID);
   */

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *	MSG_UI_CALC_SIZE_POSITION for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  /*
   *  Get an estimate position of the object
   */
  pos = UpdateItsPotentialPosition(oself,@self->HTGMLS_content,&row,&size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGMLS_xPos = pos;
  @self->HTGMLS_pageRow = row;
  @self->HTGMLS_guessSize = size;
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/12/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;
  word oheight=0;

  size = @callsuper();

  if (size == 0) {
    /*
     *  Vis tree is not build up yet, so the system doesn't know how
     *  big this vis composite object should be.  Well, I manually pass
     *  MSG_VIS_RECALC_SIZE to its children to calculate and store its
     *  size.  When they're SPEC_BUILD, then I set the stored size.
     */
    @send @genChildren::MSG_VIS_RECALC_SIZE(RSA_CHOOSE_OWN_SIZE, 
					    RSA_CHOOSE_OWN_SIZE);
    /*
     *  Hey, I can make an educated guess about the size!
     *  14 is the left+right margin, same for top+bottom margin.
     *  17 is the default height of the single-line selection gadge in
     *  Penelope.
     */
    oheight = @self->HTGMLS_size * 17 + 14;
    return MAKE_SIZE_DWORD(@self->HTGMLS_len + 14, oheight);
  }
  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenMultiLineSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenMultiLineSelectClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGMLS_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGMLS_xPos;
  }
  else {
    lineWidth = @call @self->HTGMLS_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGMLS_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTGMLS_xPos;
    else if (@self->HTGMLS_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGMLS_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGMLS_xPos);
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
	(@self->HTGMLS_content, @self->HTGMLS_pageRow, oself);

  @callsuper();
  
  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


