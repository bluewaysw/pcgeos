/***********************************************************************
 *		MSG_GEN_FORM_TEXT_INITIALIZE for HTGenFormTextClass
 ***********************************************************************
 * SYNOPSIS:	    Store the NAME attribute for the user-input field
 *		    under the FORM.
 * PARAMETERS:	    (HTMemHandle name, HTMemHandle value, oprt content)
 *			name - a chunk handle storing the symbolic 
 *			       name used to return to server on 
 *			       submision.
 *			value - a chunk storing the default text string.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/23/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_FORM_TEXT_INITIALIZE
{
  word br;

  @self->HTGFT_name = name;
  @self->HTGFT_value= value;

  if (content)
      @self->HTGFT_content = content;
  /*
   *  Let's get the default alignment.
   */
  @self->HTGFT_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGFT_noBr = br;
  /*
   *  Let TAB to switch to different object, instead of inserting a tab.
   */
  @call self::MSG_GEN_TEXT_SET_ATTRS(GTA_USE_TAB_FOR_NAVIGATION, 0);
  /*
   *  Make the object to be able to grab focus exclusive.
   */
  @call self::MSG_GEN_SET_ATTRS(GA_TARGETABLE,0);

  /*
   * set the default max length for it.
   */
  @call self::MSG_VIS_TEXT_SET_MAX_LENGTH(DEFAULT_TEXT_MAX_LENGTH);
  return;
}	/* End of MSG_GEN_FORM_TEXT_INITIALIZE.	*/



/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Free the allocated instance data.
 * PARAMETERS:	    (VisUpdateMode updateMode, CompChildFlags flags)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/ 7/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_DESTROY
{
  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGFT_name)
    HTMemFree(@self->HTGFT_name);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGFT_value)
    HTMemFree(@self->HTGFT_value);

  return;
}	/* End of MSG_GEN_DESTROY.	*/




/***********************************************************************
 *		MSG_GEN_FORM_TEXT_SUBMIT for HTGenFormTextClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate the name=value pair and store in the query
 *                  list.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:        Handle <INPUT type=TEXT | PASSWORD name=? value=?>
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_FORM_TEXT_SUBMIT
{
  char *value;
  int len;
  HTMemHandle temp;

  if (@self->HTGFT_name) {
    /*
     *  If there is no entered text nor any default text, 
     *  Don't generate a pair.
     */
    len = @call self::MSG_VIS_TEXT_GET_TEXT_SIZE();
    if (len <= 0) return;
    /*
     *  Append the "name".
     */
    temp = HTStrHTMemAllocCopyWID(0, @self->HTGFT_name);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
    /*
     *  Append the value
     */
    value = (char *) HTMemAllocAndLockWID(0, &temp, sizeof(char) * (len+1));
    @call self::MSG_VIS_TEXT_GET_ALL_PTR(value);
    HTMemUnlock(temp);
    HTListAppend(query, &temp, sizeof(HTMemHandle));
  }
  return;
}	/* End of MSG_GEN_FORM_TEXT_SUBMIT.	*/



/***********************************************************************
 *		MSG_GEN_RESET for HTGenFormTextClass
 ***********************************************************************
 * SYNOPSIS:	    Reset the text object back to its default value, if
 *		    there was any.
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormTextClass, MSG_GEN_RESET
{
  char *cptr;

  if (@self->HTGFT_value) {
    /*
     *  Ok, there were some default text string.
     */
    cptr = HTMemLock(@self->HTGFT_value);
    @call self::MSG_VIS_TEXT_REPLACE_ALL_PTR(cptr, 0);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    HTMemUnlock(@self->HTGFT_value);
    @call self::MSG_VIS_TEXT_SCREEN_UPDATE();
  }
  else
    /*
     *  Cear any text in the input field.
     */
    @call self::MSG_VIS_TEXT_DELETE_ALL();

  return;
}	/* End of MSG_GEN_RESET.	*/


