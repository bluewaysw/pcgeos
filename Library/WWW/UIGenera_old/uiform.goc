 *	edwin   	6/10/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenOuterSelectClass, MSG_GEN_OUTER_SELECT_STORE_CONTENT
{
  word br;
  @self->HTGOS_content = content;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   */
  @self->HTGOS_align=@call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);
  @self->HTGOS_noBr = br;
  return;
}	/* End of MSG_GEN_OUTER_SELECT_STORE_CONTENT.	*/


/***********************************************************************
 *	MSG_GEN_SELECT_UPDATE_MAX_LENGTH for HTGenOuterSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenOuterSelectClass, MSG_GEN_OUTER_SELECT_UPDATE_MAX_LENGTH
{
  GStateHandle gstate;
  word size;

  /* 
   *  Update the longest text string. 
   */ 
  gstate = GrCreateState(0);
  size = GrTextWidth(gstate, text, strlen(text));
  if(size > @self->HTGOS_maxLen) 
      @self->HTGOS_maxLen = size;
  GrDestroyState(gstate);

  return;
}	/* End of MSG_GEN_OUTER_SELECT_UPDATE_MAX_LENGTH.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenOuterSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenOuterSelectClass, MSG_SPEC_BUILD_BRANCH
{
  VisCompInstance * vself;

  @callsuper();

  /*
   *  HTGenSelectClass is special in that it is OLMenuButtonClass
   *  in Penelope.
   *  When its parent receives MSG_VIS_RECALC_SIZE, this object's vis part
   *  is not built up yet.  Thus it miss the chance to recalculating its
   *  size.
   */
  @call self::MSG_VIS_RECALC_SIZE(RSA_CHOOSE_OWN_SIZE,
				  RSA_CHOOSE_OWN_SIZE);

  if (@self->HTGOS_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGOS_guessSize),
				 DWORD_HEIGHT(@self->HTGOS_guessSize));
  /*
   *  Clear the bits.  We don't rely on system to do updates anymore.
   */
  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID);

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenOuterSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row position and X coordinate in that row.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:        THIS IS AN EXCEPTION!
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenOuterSelectClass, MSG_UI_CALC_SIZE_POSITION
{
  int row;
  SizeAsDWord size;
  int pos;
  /*
   *  Get an estimate position of the object
   */
  pos = UpdateItsPotentialPosition(oself, @self->HTGOS_content, &row, &size);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGOS_xPos = pos;
  @self->HTGOS_pageRow = row;
  @self->HTGOS_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenOuterSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/11/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenOuterSelectClass, MSG_VIS_RECALC_SIZE
{
  SizeAsDWord size;

  size = @callsuper();
  if (size == NULL)
      size = MAKE_SIZE_DWORD(@self->HTGOS_maxLen+63, 30);
      /* 63 is the size of the left and right arrow in Penelope 
	 selection box.  */

  return size;
}	/* End of MSG_VIS_RECALC_SIZE.	*/



/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenOuterSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenOuterSelectClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGOS_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGOS_xPos;
  }
  else {
    lineWidth = @call @self->HTGOS_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGOS_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTGOS_xPos;
    else if (@self->HTGOS_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGOS_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGOS_xPos);
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
	(@self->HTGOS_content, @self->HTGOS_pageRow, oself);

  @callsuper();

  return;
}	/* End of MSG_VIS_POSITION_BRANCH.	*/


