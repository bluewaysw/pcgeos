/***********************************************************************
 *		FinishCurrentObjectInForm
 ***********************************************************************
 *
 * SYNOPSIS:	Finish the object in target and append it to the ui
 *		tree.  Return the parent object of the subtree(either
 *              a form or table cell).  This parent object is the type
 *              of a GenInteractin subclass.
 * CALLED BY:	(optr pmObj, ObjInfo *target);
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
optr
FinishCurrentObjectInForm (optr pmObj, ObjInfo *target)
{
  ClassStruct *class;
  optr	container;

  /*
   * Add whatever object in UIG_target to the leaf of the ui-tree, and
   * travel up the tree branch to find the first FORM or HTGenTCell
   * object that can take more children objects.
   */
  @call pmObj::MSG_PM_TAKE_UNFINISHED_UI_OBJ(target->obj);
  if (target->class != (ClassStruct *)&HTGenFormClass &&
      target->class != (ClassStruct *)&HTGenTCellClass) {
    while (1) {
	@call pmObj::MSG_PM_MARK_RECV_OBJECT_DONE(&container, &class);
	EC_ERROR_IF(class == NULL || container == NULL ||
	  class == (ClassStruct *)&HTGenTextClass,
	  UIG_INVALID_OPERATION_ON_UI_TREE);
	if (class == (ClassStruct *)&HTGenFormClass ||
	    class == (ClassStruct *)&HTGenTCellClass)
	  break;
	else if (class == (ClassStruct *)&HTGenSelectClass)
	  @call container::MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT();
/*	else if (class == (ClassStruct *)&HTGenMultiLineSelectClass)
	  @call container::MSG_HTGMLS_COMPLETE_SELECT_CONSTRUCT();
	*/  /* edwin's observation */
    }
  }
  else 
    container = target->obj;

  /*
   *  Note, container may contain a FORM object or a HTGenTCell object.
   */
  return container;
}	/* End of FinishCurrentObjectInForm.	*/


/***********************************************************************
 *		FormGeneratorNameValuePairs
 ***********************************************************************
 *
 * SYNOPSIS:	Generate Name/Value pair for each form items.
 * CALLED BY:	
 * RETURN:	none
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/26/97   	Initial Revision
 *	
 ***********************************************************************/
void
FormGeneratorNameValuePairs (optr object, HTListHandle query, optr button)
{
  optr child;
  int i, cnt;
  ClassStruct *class;

  if ((cnt = @call object::MSG_GEN_COUNT_CHILDREN()) == 0)
    return;

  for (i = 0; i < cnt; i++) {
    child = @call object::MSG_GEN_FIND_CHILD_AT_POSITION(i);
    class = @call child::MSG_META_GET_CLASS();
    if (class == (ClassStruct *)&HTGenFormTextClass)
      @call child::MSG_GEN_FORM_TEXT_SUBMIT(query);
    else if (class == (ClassStruct *)&TextAreaClass)
      @call child::MSG_TEXT_AREA_SUBMIT(query);

    else if (class == (ClassStruct *)&HTGenFormHiddenClass)
      @call child::MSG_GEN_FORM_HIDDEN_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenFormTriggerClass) {
	if(child == button) 
	    @call child::MSG_GEN_FORM_TRIGGER_SUBMIT(query);
    } else if (class == (ClassStruct *)&HTGenOuterSelectClass) {
      /* HTGenSelect is the child of HTGenOuterSelect */
      child = @call child::MSG_GEN_FIND_CHILD_AT_POSITION(0);
      @call child::MSG_GEN_SELECT_SUBMIT(query);
    }
    else if (class == (ClassStruct *)&HTGenMultiLineSelectClass)
      @call child::MSG_HTGMLS_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenInputClass)
      @call child::MSG_GEN_INPUT_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenImageClass)
      @call child::MSG_GEN_IMAGE_SUBMIT(query);
    else if (class == (ClassStruct *)&HTGenTextClass)
      	;
    else if (@call child::MSG_GEN_COUNT_CHILDREN() > 0) {
      FormGeneratorNameValuePairs(child, query, button);
    }
  }
  return;
}	/* End of FormGeneratorNameValuePairs.	*/



