/***********************************************************************
 *		MSG_GEN_SELECT_PROCESS_ATTRIBUTE for HTGenSelectClass
 ***********************************************************************
 * SYNOPSIS:	    Process attributes in <SELECT>
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:  Attributes processed:
 *		NAME: symbolic name of the field returned to the server
 *		      on submission.
 *		SIZE: determines the number of OPTIONS physically
 *		      visible when the browser display the FORM.
 *		MULTIPLE: if present, allow mutiple selections, and
 *		      cause no OPTION to be the default.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	4/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenSelectClass, MSG_GEN_SELECT_PROCESS_ATTRIBUTE
{
  char *value, *cptr;
  int	index = 0;
  HTMemHandle htmh;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_NAME:
      /* allocate a chunk to store the NAME data */
      htmh = HTMemAllocWID(0, sizeof(char) * (strlen(value)+1));
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      @self->HTGS_name = htmh;
      cptr = (char *)HTMemLock(@self->HTGS_name);
      strcpy(cptr,value);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      HTMemUnlock(@self->HTGS_name);
      break;
    case HTML_ATTR_SIZE:
/*      @self->HTGS_size = atoi(value); */
      /* the size must be one! */
      @self->HTGS_size = 1;
      break;
    case HTML_ATTR_MULTIPLE:
      @self->GIGI_behaviorType = GIGBT_NON_EXCLUSIVE;
      break;
    }
  }
  /*
   *  Make the object to be able to grab focus exclusive.
  @call self::MSG_GEN_SET_ATTRS(GA_TARGETABLE,0);
   */
  return;
}	/* End of MSG_GEN_SELECT_PROCESS_ATTRIBUTE.	*/


/***********************************************************************
 *	MSG_GEN_SELECT_GET_AND_INCREMENT_OPTION_ID for HTGenSelectClass
 ***********************************************************************
 * SYNOPSIS:	    Return next available id, used to assign an OPTION
 *		    object(GenItem object).
 * PARAMETERS:	    int ();
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/21/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenSelectClass, MSG_GEN_SELECT_GET_AND_INCREMENT_OPTION_ID
{
  int id = @self->HTGS_idCounter;
  @self->HTGS_idCounter++;
  return id;
}	/* End of MSG_GEN_SELECT_GET_AND_INCREMENT_OPTION_ID.	*/


/***********************************************************************
 *	MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT for HTGenSelectClass
 ***********************************************************************
 * SYNOPSIS:	    Finalize the visual form of the select object.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenSelectClass, MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT
{
  CompSizeHintArgs sizeArgs;
  /*
   * Is it a exclusive selection?
   */
  if (@self->GIGI_behaviorType == GIGBT_NON_EXCLUSIVE) {
    /*
     * Set non-exclusive selection, and hilite all the selected 
     * OPTIONs.
     */
    @call self::MSG_GEN_SELECT_SET_MULTIPLE_SELECTION();
  }
  else
    @send self::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION
	(@self->HTGS_select,0);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGS_size <= 1 && @self->HTGS_type == INPUT_NONE &&
	@self->GIGI_behaviorType == GIGBT_EXCLUSIVE) {
    /*
     *  SIZE is 0 or 1, set the display to be the pull-down menu style.
     */
    @call self::MSG_META_ADD_VAR_DATA(HINT_ITEM_GROUP_MINIMIZE_SIZE,0,NULL);
    @call self::MSG_META_ADD_VAR_DATA
		(HINT_ITEM_GROUP_DISPLAY_CURRENT_SELECTION,0,NULL);
    /*
     *  Minimize size of the pull-down trigger.
     */
    sizeArgs.CSHA_width = 0;
    sizeArgs.CSHA_height = SST_LINES_OF_TEXT | 1;
    sizeArgs.CSHA_count = 0;
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_FIXED_SIZE,sizeof(sizeArgs), &sizeArgs);
  }
  else if (@self->HTGS_type == INPUT_NONE)
    /*
     *  Set the display to be a tool box like.
     */
    @call self::MSG_META_ADD_VAR_DATA
	(HINT_ITEM_GROUP_TOOLBOX_STYLE, 0, NULL);

  return;
}	/* End of MSG_GEN_SELECT_COMPLETE_SELECT_CONSTRUCT.	*/


