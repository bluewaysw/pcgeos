 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row position and X coordinate in that row.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:        THIS IS AN EXCEPTION!
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  SizeAsDWord size;
  pos = UpdateItsPotentialPosition(oself, @self->HTGI_content, &row, &size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  /*
   *  Get an estimate position of the object
   */
  @self->HTGI_xPos = pos; 
  @self->HTGI_pageRow = row;
  @self->HTGI_guessSize = size;

  return;
}	/* End of MSG_META_UIG_CALC_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenInputClass
 ***********************************************************************
 *
