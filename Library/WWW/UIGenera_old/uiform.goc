 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenInputClass, MSG_GEN_RESET
{
  if (@self->HTGI_select)
    @send self::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(0, FALSE);
  else
    @call self::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(FALSE);

  return;
}	/* End of MSG_GEN_RESET.	*/


