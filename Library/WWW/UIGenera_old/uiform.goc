/***********************************************************************
 *		MSG_VIS_MARK_INVALID for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Forget about this routine.  It will slow down system
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/28/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormClass, MSG_VIS_MARK_INVALID
{
  VisCompInstance *vself;
  
  vself = ObjDerefVis(oself);
  if (!(vself->VI_attrs & VA_REALIZED))
    /*
     *  Avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
     */
    @call self::MSG_VIS_OPEN(0);

    return;
}	/* End of MSG_VIS_MARK_INVALID.	*/



/***********************************************************************
 *		MSG_GEN_DESTROY for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Free the allocated instance data.
 * PARAMETERS:	    (VisUpdateMode updateMode, CompChildFlags flags)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	2/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_DESTROY
{
  @callsuper();
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGF_action)
    HTMemFree(@self->HTGF_action);
  return;
}	/* End of MSG_GEN_DESTROY.	*/


/***********************************************************************
 *		MSG_GEN_PREPARE_FOR_DESTROY for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Prepare the object for HTObjDestroyAllWID. All we
 *                  need to do is delete instance data. This message 
 *                  replaces MSG_GEN_DESTROY as we won't be sending 
 *                  MSG_GEN_DESTROY to objects. Instance data allocated
 *                  using ...WID APIs (like HTListNewWID, HTMemAllocWID)
 *                  need not freed to save time.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	9/15/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_PREPARE_FOR_DESTROY
{
    /* 
     * These would be destroyed when we delete the blocks using
     * HTMemFreeAllWID.
     *
     * if (@self->HTGF_action)
     * HTMemFree(@self->HTGF_action);
     */
    /* 
     * If we delete something here, make sure to add to list in 
     * PresentationManager::MSG_PM_OBJECT_INSTANTIATE.
     */
    return;
}	/* End of MSG_GEN_PREPARE_FOR_DESTROY.	*/




/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION for HTGenFormClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION
{
  *br = @self->HTGHC_noBr;
  if(@self->HTGHC_alignIndex == 0)
	return @self->HTGF_align;

  return @self->HTGHC_alignStack[@self->HTGHC_alignIndex - 1];
}	/* End of MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION. */



/***********************************************************************
 *   MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT for HTGenHtmlContentClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    (optr text);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT
{
  VisTextParaAttrAttributes new_attr = 0;
  Justification	new_just;
  /*
   * Get the last align token off the stack.
   */
  if(@self->HTGHC_alignIndex == 0)
	new_just = @self->HTGF_align;
  else
	new_just = @self->HTGHC_alignStack[(@self->HTGHC_alignIndex)-1];
  
  /*
   * Set the alignment.
   */
  new_attr = new_just << VTPAA_JUSTIFICATION_OFFSET;
  @call text::MSG_VIS_TEXT_SET_PARA_ATTRIBUTES(
		0, new_attr, 
		TEXT_ADDRESS_PAST_END,
		TEXT_ADDRESS_PAST_END);
  return;
}	/* End of MSG_GEN_HTML_CONTENT_SET_TEXT_ALIGNMENT.	*/


