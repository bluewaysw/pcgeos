/***********************************************************************
 *	MSG_GEN_SELECT_SET_MULTIPLE_SELECTION for HTGenSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    According to its children(OPTION objects), set the
 *		    selection list of the GenItemGroup to reflect the
 *		    selections.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	NOTE, this object must be non-exclusive selection.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	8/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenSelectClass, MSG_GEN_SELECT_SET_MULTIPLE_SELECTION
{
  word num, i, j, *buffer;
  ChunkHandle chunk;
  optr child;

  if (@self->GIGI_behaviorType == GIGBT_EXCLUSIVE) {
    /*
     *  <SELECT SIZE=1>
     */
    @send self::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION
	(@self->HTGS_select, FALSE);
    return;
  }
  /*
   *  <SELECT SIZE=n> where n > 1
   */
  num = @call self::MSG_GEN_COUNT_CHILDREN();
  chunk = LMemAlloc(OptrToHandle(oself), (num+1) * sizeof(word));
  buffer = LMemDerefHandles(OptrToHandle(oself), chunk);
  for (i = 0, j = 0; i < num; i++) {
	child = @call self::MSG_GEN_FIND_CHILD_AT_POSITION(i);
	if ((@call child::MSG_GEN_OPTION_IS_SELECTED()) == TRUE)
	  buffer[j++] = i;
  }
  @send self::MSG_GEN_ITEM_GROUP_SET_MULTIPLE_SELECTIONS(buffer,j);
  LMemFreeHandles(OptrToHandle(oself), chunk);
  return;
}	/* End of MSG_GEN_SELECT_SET_MULTIPLE_SELECTION.	*/



/***********************************************************************
 *		MSG_GEN_SELECT_SUBMIT for HTGenSelectClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Generate a name=value pair for the form submission.
 * PARAMETERS:	    (HTListHandle query)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/20/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenSelectClass, MSG_GEN_SELECT_SUBMIT
{
  word num, i;
  optr child;

  num = @call self::MSG_GEN_COUNT_CHILDREN();
  for (i = 0 ; i < num ; i++) {
    if (@call self::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(i)) {
      child = @call self::MSG_GEN_ITEM_GROUP_GET_ITEM_OPTR(i);
      @call child::MSG_GEN_OPTION_SUBMIT(@self->HTGS_name, query);
    }
  }
  return;
}	/* End of MSG_GEN_SELECT_SUBMIT.	*/


