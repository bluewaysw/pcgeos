/***********************************************************************
 *		MSG_GEN_FORM_SUBMIT for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Tell the items under the form to generate the
 *                  name=value pairs for the form submission.  The
 *                  information will be stored in a HTList like:
 *                     index 0  - URL of server specified in ACTION
 *                           1  - Either FORM_GET or FORM_POST
 *                           2  - Name of item  1
 *                           3  - Value of item 1
 *                           4  - Name of item  2
 *                           5  - Value of item 2
 *                           .....
 * PARAMETERS:	    optr button
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_FORM_SUBMIT
{
  HTListHandle query;
  HTMemHandle base, temp;

  if (@call self::MSG_GEN_COUNT_CHILDREN() == 0)
    return;
  /*
   *  Assemble a query string to be sent to the server specified in 
   *  ACTION attribute.
   */
  query = HTListNewWID(0);
  /*
   *  Append the Action URL.  If there is no HTGF_action, use the base 
   *  URL of the document.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGF_action) {
    temp = HTStrHTMemAllocCopyWID(0, @self->HTGF_action);
  }
  else {
    if((base = @call currentDoc->HTUI_pmanager::MSG_PM_GET_BASE_OPTR()) == NULL)
	temp = HTStrAllocCopyWID(0, "");
    else
	temp = HTStrHTMemAllocCopyWID(0, base);
  }
  HTListAppend(query, &temp, sizeof(HTMemHandle));
  /*
   *  Append the Method type.
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  HTListAppend(query, &@self->HTGF_method, sizeof(HTMethod));
  /*
   *  Assemble the pairs of "name=value" for each objects in the form.
   */
  FormGeneratorNameValuePairs(oself, query, button);

  @call currentDoc->HTUI_pmanager::MSG_PM_SET_FORM_QUERY(query);
  return;
}	/* End of MSG_GEN_FORM_SUBMIT.	*/



/***********************************************************************
 *		MSG_GEN_FORM_ADD_INPUT for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Add an input object to the linked list under this 
 *                  form object.
 * PARAMETERS:	    (optr inputObj);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_FORM_ADD_INPUT
{
  EC_ERROR_IF(!@call inputObj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenInputClass),
              UIG_UI_TREE_OPERATION_FAILS);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (@self->HTGF_first == NULL) {
    @self->HTGF_first = @self->HTGF_last = inputObj;
  }
  else {
    @call @self->HTGF_last::MSG_GEN_INPUT_ADD_SIBLING(inputObj);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    @self->HTGF_last = inputObj;
  }
  return;
}	/* End of MSG_GEN_FORM_ADD_INPUT.	*/



/***********************************************************************
 *	MSG_GEN_FORM_SET_EXCLUSIVE_SELECTION for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    (HTMemeHandle name, optr selectedObj)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	1/ 9/97   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_GEN_FORM_SET_EXCLUSIVE_SELECTION
{
  optr next;
  EC_ERROR_IF(!@self->HTGF_first, UIG_INVALID_OPERATION_ON_UI_TREE);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  next = @call @self->HTGF_first::MSG_GEN_INPUT_CLEAR_SELECTIONS
           (name, selectedObj);
  /*
   *  While there is a next object, send the message to reset the
   *  state if the next object have the same "name" group.
   */
  while(next) {
      next = @call next::MSG_GEN_INPUT_CLEAR_SELECTIONS(name, selectedObj);
  }
  
  return;
}	/* End of MSG_GEN_FORM_SET_EXCLUSIVE_SELECTION.	*/



/***********************************************************************
 *		MSG_UIG_CALC_SIZE_POSITION for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find its row number and X position.
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/31/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenFormClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos, nextRow;
  SizeAsDWord size;

  /*
   *  Finish the last row info.
   */
  @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);

  /*
   *  Get an estimate position of the object
   */
  pos = UpdateItsPotentialPosition(oself, @self->HTGF_content, &row, &size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGF_xPos = pos; 
  @self->HTGF_pageRow = row;
  @self->HTGF_guessSize = size;

  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenFormClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
