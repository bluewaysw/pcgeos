/*
 *  defined in pmanager.goc
 */
extern const DrawMask customMask;
/*
 *  defined in uitext.goc
 */
extern dword globalVarSumOfAccLen;

int  sum_of_widths_of_previous_siblings = 0;
int  width_of_current_oject = 0;
int  height_of_current_oject = 0;
int  max_height;
optr current_object;


/***********************************************************************
 *		MapAttrSizeToPointSize
 ***********************************************************************
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 5/96   	Initial Revision
 *
 ***********************************************************************/
void MapAttrSizeToPointSize (int size, WWFixed *number)
{
  /*
   *  Make sure the size is within the limit: 1 <= n <= 7
   */
  if ( size < 1 )
    size = 1;
  else if ( size > 7 )
    size = 7;

  switch(size) {
    case 1:
	number->WWF_int = STYLE_FONT_1;
	break;
    case 2:
	number->WWF_int = STYLE_FONT_2;
	break;
    case 3:
	number->WWF_int = STYLE_FONT_3;
	break;
    case 4:
	number->WWF_int = STYLE_FONT_4;
	break;
    case 5:
	number->WWF_int = STYLE_FONT_5;
	break;
    case 6:
	number->WWF_int = STYLE_FONT_6;
	break;
    case 7:
	number->WWF_int = STYLE_FONT_7;
	break;
    }
    number->WWF_frac= 0;
}	/* End of MapAttrSizeToPointSize.	*/


/***********************************************************************
 *		MapPointSizeToAttrSize
 ***********************************************************************
 *
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/ 3/96   	Initial Revision
 *
 ***********************************************************************/
int
MapPointSizeToAttrSize (int number)
{
  /*
   *  Make sure the size is within the limit: 1 <= n <= 7
   */
  if ( number < STYLE_FONT_1 )
    return 1;
  else if ( number > STYLE_FONT_7 )
    return 7;

  switch(number) {
    case STYLE_FONT_1:
	return 1;
    case STYLE_FONT_2:
	return 2;
    case STYLE_FONT_3:
	return 3;
    case STYLE_FONT_4:
	return 4;
    case STYLE_FONT_5:
	return 5;
    case STYLE_FONT_6:
	return 6;
    case STYLE_FONT_7:
	return 7;
  }
  return 3;
}	/* End of MapPointSizeToAttrSize.	*/



/***********************************************************************
 *		AddNewLine
 ***********************************************************************
 * SYNOPSIS:    Add a new line.
 *              If the current object is not a text, we simply increment
 *              the row count anf finish the previous row in the content
 *              object.
 *              If the current object is a text,
 *                 if numLine == 1, always append a C_ENTER.
 *                 if numLine == 2, make sure the text object have two
 *                    consecutive C_ENTER appended.
 *                 if numLine == 3, make sure the text object has only
 *                    one C_ENTER appended.
 *                 if numLine == 4, it's <BR>.
 * CALLED BY:	Internal, so numLine MUST be within the limit.
 * RETURN:	
 * SIDE EFFECTS:
 *		No protection if numLine is negative
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/ 7/96   	Initial Revision
 *
 ***********************************************************************/
void
AddNewLine(ObjInfo *Obj, int numLine, HTUIDoc *uiDoc, optr content)
{
  char ptr[] = { C_ENTER, C_ENTER }, buffer[3];
  int len;
  GStateHandle gstate;
  
  if (Obj->obj && Obj->class == (ClassStruct *)&HTGenTextClass) {
    /* Add a new line */
    if (@call Obj->obj::MSG_VIS_TEXT_GET_TEXT_SIZE() >= 4000 ||
	globalVarSumOfAccLen > 45000) {
      EC_WARNING(UIG_TEXT_SPLITS_AT_4K_BYTES);
      @call uiDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ(Obj->obj);
      Obj->obj   = NULL;
      Obj->class = NULL;
    }
    else if (numLine == 1 || numLine == 4) /* always add a new line */
	@call Obj->obj::MSG_VIS_TEXT_APPEND_PTR(ptr, 1);
    else {
	@call Obj->obj::MSG_VIS_TEXT_SELECT_RELATIVE(-2, 0);
	len = @call Obj->obj::MSG_VIS_TEXT_GET_SELECTION_PTR(buffer);
	EC_ERROR_IF(len > 2, 1);
	while(len>0) {
	  if (buffer[len-1] == C_TAB) {
	    if (len == 2)
		@call Obj->obj::MSG_VIS_TEXT_SELECT_RELATIVE(1, 0);
	    @call Obj->obj::MSG_VIS_TEXT_DELETE_SELECTION();
	    @call Obj->obj::MSG_VIS_TEXT_SELECT_RELATIVE(-2, 0);
	    len = @call Obj->obj::MSG_VIS_TEXT_GET_SELECTION_PTR(buffer);
	  }
	  else
	    break;
	}	
	EC_ERROR_IF(len > 2, 1);
	@call Obj->obj::MSG_VIS_TEXT_SELECT_END();
	if (len > 0 && buffer[0] == C_ENTER && buffer[1] == C_ENTER)
	    ;  /* already has two consecutive C_ENTER, so do nothing */
	else if (len > 0 && buffer[0] != C_ENTER && buffer[1] == C_ENTER) {
	  if (numLine == 2)
	    @call Obj->obj::MSG_VIS_TEXT_APPEND_PTR(ptr, 1);
	 /*
	  * if numLine == 3, and since there is one C_ENTER already, so
	  * do nothing.  if numLine == 2, simply add one more.
	  */
	}
	else if (numLine == 3) /* the last char is not C_ENTER, so add one */
	    @call Obj->obj::MSG_VIS_TEXT_APPEND_PTR(ptr, 1);
	else /* doesn't exit 2 C_ENTER's yet, so add now */
	    @call Obj->obj::MSG_VIS_TEXT_APPEND_PTR(ptr, 2);
    }
  }
  else {
    SizeAsDWord size = 0;
    if (numLine == 4)
	size = MAKE_SIZE_DWORD(0, 9);        /* height of <BR> */
    @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(size, &len, NULL);
  }

  return;
}	/* End of AddNewLine.	*/



/***********************************************************************
 *		SetTabsForListGroup
 ***********************************************************************
 * SYNOPSIS:	Set an anchor tab for the list headers so all the list
 *		headers are right aligned.
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:	After setting an anchor tab, reset the next tab to be
 *		left-aligned.  This is necessary because any previous
 *		ended list may have set this position to be the anchor 
 *		tab.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
void
SetTabsForListGroup (int level, optr obj)
{
  Tab	nextTab;

  nextTab.T_position	= TAB_SIZE * (level + 1);
  nextTab.T_attr	= TL_NONE | TT_ANCHORED;
  nextTab.T_lineWidth	= nextTab.T_lineSpacing	=
			  nextTab.T_grayScreen	= 0;
  nextTab.T_anchor = C_TAB;			/* anchor char */
  @send obj::MSG_VIS_TEXT_SET_TAB(nextTab,
				TEXT_ADDRESS_PAST_END,
				TEXT_ADDRESS_PAST_END);
/*  nextTab.T_position	= TAB_SIZE * (level + 2);	* reset the *
  nextTab.T_attr	= TL_NONE | TT_LEFT;		    * next tab. *
  @call obj::MSG_VIS_TEXT_SET_TAB(nextTab,		
				TEXT_ADDRESS_PAST_END,	
				TEXT_ADDRESS_PAST_END); */

}	/* End of SetTabsForListGroup.	*/


/***********************************************************************
 *		MyVisTextFormatNumber
 ***********************************************************************
 * SYNOPSIS:	
 * CALLED BY:	MSG_UI_GENERATOR_CREATE_ORDERED_LIST_ITEM
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/10/96   	Initial Revision
 *
 ***********************************************************************/
void reverse(char s[])
{
  int c, i, j;
  for (i = 0, j = strlen(s)-1; i < j; i++, j--) {
	c = s[i];
	s[i] = s[j];
	s[j] = c;
  }
} 
void MyVisTextFormatNumber(char *temp, dword counter, VisTextNumberType type)
{
  char	base;
  int	i = 0;

  if (type == VTNT_LETTER_UPPER_A)
	base = 'A';
  else
	base = 'a';
  do {
	temp[i++] = (counter-1) % 26 + base;
  } while ((counter = ((counter-1) / 26)) > 0);

  temp[i] = '\0';
  reverse(temp);

  return;
}	/* End of MyVisTextFormatNumber.	*/


/***********************************************************************
 *		FormatSetTextBQ
 ***********************************************************************
 * SYNOPSIS:	
 * CALLED BY:	
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/21/96   	Initial Revision
 *
 ***********************************************************************/
void
FormatSetTextBQ (optr text, optr content)
{
  StyleType groupType;
  int level, i;
  dword counter;
  char displayType, tab[1] = { C_TAB };

  /*
   * Get the list group info before creating the list item.
   */
  @call content::MSG_GEN_HTML_CONTENT_GET_LIST_GROUP
     (&groupType, &counter, &displayType, &level);
  EC_WARNING_IF(groupType != STYLE_DL, UIG_UNBALANCED_LIST_STACK);
  /*
   * Set the left margin so the item text wraps around at the right place
   */
  @send text::MSG_VIS_TEXT_SET_LEFT_MARGIN(
				TAB_SIZE * ( level + 1 ),
				VIS_TEXT_RANGE_SELECTION,
				VIS_TEXT_RANGE_SELECTION);
  /*
   * Since the new line break brought the cursor to position 1, we
   * need to tab to the right position for the list item.
   */
  for(i = 0; i <= level; i++)
      @call text::MSG_VIS_TEXT_APPEND_PTR(tab, 1);

  return;
}	/* End of FormatSetTextBQ	*/



/***********************************************************************
 *		UpdateItsPotentialPosition
 ***********************************************************************
 *
 * SYNOPSIS:	Figure out the object's new x pos in the current row.
 * CALLED BY:	internal
 * RETURN:	int - position of the object in the *row.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
int
UpdateItsPotentialPosition 
(optr obj, optr content, int *row, SizeAsDWord *osize)
{
  int prevREdge;
  optr prevObj;
  RecalcSizeArgs pWidth;
  word br;
  /*
   *  Ask the content parent for the size of allowable space.
   */
  pWidth = @call content::MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE();

  /*
   *  Figure out the object's size.
   */
  *osize = @call obj::MSG_VIS_RECALC_SIZE(pWidth, RSA_CHOOSE_OWN_SIZE);

  /*
   *  Here we set the obj's size.  If the obj's parent is not usable yet,
   *  the vis tree brach is not built.  Thus, setting the size right now
   *  will not have any effect.  The size will be zero out the spec_branch
   *  is built.  However, if the parent is already usable.  We need to
   *  set the size right now.
   */
  @call obj::MSG_VIS_SET_SIZE(DWORD_WIDTH(*osize), DWORD_HEIGHT(*osize));

  /*
   *  Get the right edge coordinate of the previous sibling object.
   *  prevObj contains the previous object if the current obj is
   *  encountered here for the first time.
   */
  prevREdge = @call content::MSG_GEN_HTML_CONTENT_GET_PREV_SIBLING_R_EDGE
    (obj, *osize, row, &prevObj, &br);

  /*
   *  If adding the current object to the current line would exceed the
   *  width of the parent, then we add the object to the next line.
   */
  if (br && !(@call obj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTextClass) &&
	      @call obj::MSG_GEN_TEXT_IS_MULTILINE()))
      @call content::MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT();
  else if (prevREdge > MARGIN && prevREdge + DWORD_WIDTH(*osize) > pWidth){
    prevREdge = @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW
      (*osize, row, obj);
  }
  else if (prevREdge > MARGIN &&
	   @call obj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTextClass) &&
	   @call obj::MSG_GEN_TEXT_IS_MULTILINE())
    prevREdge = @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW
      (*osize, row, obj);
  else if (prevObj &&
	   @call prevObj::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTextClass)&&
	   @call prevObj::MSG_GEN_TEXT_IS_MULTILINE())
    prevREdge = @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW
      (*osize, row, obj);
  else {
    @call content::MSG_GEN_HTML_CONTENT_UPDATE_MAX_HEIGHT();
  }

  return prevREdge;
}	/* End of UpdateItsPotentialPosition.	*/


/***********************************************************************
 *		GetItsPotentialHeight
 ***********************************************************************
 *
 * SYNOPSIS:	Calculate the top coordinate of the row in question.
 * CALLED BY:	internal
 * RETURN:	int - y document coordinate of the top edge of the row.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/25/96   	Initial Revision
 *
 ***********************************************************************/
int
GetItsPotentialHeight (optr content, int row, optr obj)
{
  int rowHeight;
  SizeAsDWord size;

  EC_ERROR_IF(!(@call content::MSG_META_IS_OBJECT_IN_CLASS
		(&HTGenHtmlContentClass) ||
		@call content::MSG_META_IS_OBJECT_IN_CLASS
		(&HTGenHtmlContentClass)), 1);

  rowHeight = @call content::MSG_GEN_HTML_CONTENT_GET_ROW_HEIGHT(row);
  if (rowHeight == 0)
    return 0;
  size = @call obj::MSG_VIS_GET_SIZE();

  return rowHeight - DWORD_HEIGHT(size) - MARGIN;
}	/* End of GetItsPotentialHeight.	*/



/***********************************************************************
 *		ResetSiblingAbsoluteWidth
 ***********************************************************************
 *
 * SYNOPSIS:	Reset this file's global variables used to calculate
 *              objects' position in document coordinates.
 * CALLED BY:	internal
 * RETURN:	none
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/24/96   	Initial Revision
 *
 ***********************************************************************/
void
ResetSiblingAbsoluteWidth (optr content)
{
  sum_of_widths_of_previous_siblings = 0;
  width_of_current_oject = 0;
  height_of_current_oject = 0;
  current_object = NULL;
  /*  @call content::MSG_CONTENT_UPDATE_HEIGHT_IN_ROW(max_height); */
  max_height = 0;
  return;
}	/* End of ResetSiblingAbsoluteWidth.	*/


/***********************************************************************
 *		RedrawFocus
 ***********************************************************************
 *
 * SYNOPSIS:	Redrawing the outline for showing the navigation focus.
 * CALLED BY:	
 * RETURN:	
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	4/16/97   	Initial Revision
 *	
 ***********************************************************************/
void
RedrawFocus (GStateHandle gstate, RectDWord *bound)
{
    /*
     *  Draw the focus outline if it currently has the navigation focus
     */
    GrSaveState(gstate);
    GrSetLineMaskCustom(gstate, (const unsigned char (*)[8])customMask);
    GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
    GrDrawRect(gstate, 
	       bound->RD_left, 
	       bound->RD_top, 
	       bound->RD_right, 
	       bound->RD_bottom);
    GrRestoreState(gstate);
    return;
}	/* End of RedrawFocus.	*/


dword myatoi(const TCHAR *__s)
{
    int i;
    dword n=0;

    for (i=0; __s[i] >= _TEXT('0') && __s[i] <= _TEXT('9'); ++i)
	n = 10 * n + (__s[i] - _TEXT('0'));


    return  n;
}
