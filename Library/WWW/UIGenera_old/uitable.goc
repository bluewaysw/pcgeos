/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	10/31/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, pos;
  VisCompInstance * vself;
  SizeAsDWord size;
  
  /*
   *  Ask the system to send MSG_VIS_POSITION_BRANCH instead of calling
   *  a routine.
   */
  vself = ObjDerefVis(oself);
  vself->VI_geoAttrs &= ~VGA_USE_VIS_SET_POSITION;

  pos = UpdateItsPotentialPosition(oself, @self->HTGT_content, &row, &size);

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_xPos = pos;
  @self->HTGT_pageRow = row;
  @self->HTGT_guessSize = size;
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_RECALC_SIZE
{
  int *array, i;
  /*
   *  All the children under the table cell have calculate its size.
   *  Thus, HTGT_rowHeight and HTGT_colWidth contain the updated 
   *  infomation, which we can use to shrink the table cell tight to 
   *  contain all the children objects.
   */
  array = (int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  for (i=0, height = 0; array[i] != 0 && i < @self->HTGT_rowSize; i++){
	height += (array[i] + @self->HTGT_cellspacing);
  }
  array = (int *)LMemDerefHandles(HandleOf(oself),@self->HTGT_colWidth);
  for (i=0, width = 0; array[i] != 0 && i < @self->HTGT_columnSize; i++) {
	width += (array[i] + @self->HTGT_cellspacing);
  }

  return MAKE_SIZE_DWORD(width + @self->HTGT_cellspacing,
			 height+ @self->HTGT_cellspacing);
}	/* End of MSG_VIS_RECALC_SIZE.	*/


/***********************************************************************
 *		MSG_SPEC_BUILD_BRANCH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/27/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_SPEC_BUILD_BRANCH
{
  @callsuper();
  if (@self->HTGT_guessSize)
    @call self::MSG_VIS_SET_SIZE(DWORD_WIDTH(@self->HTGT_guessSize),
				 DWORD_HEIGHT(@self->HTGT_guessSize));

  if(@self->HTGT_bitmap) {
      HTMemFree(@self->HTGT_bitmap);
      @self->HTGT_bitmap = NULL;
  }

  return;
}	/* End of MSG_SPEC_BUILD_BRANCH.	*/



