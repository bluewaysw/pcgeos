/***********************************************************************
 *		MSG_UI_CALC_SIZE_POSITION for HTGenCaptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/13/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenCaptionClass, MSG_UI_CALC_SIZE_POSITION
{
  int row, nextRow;
  SizeAsDWord size;

  /*
   *  Finish the last row info.
   */
  @call self::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);

  /*
   *  Get an estimate position of the object
   */
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGC_xPos = UpdateItsPotentialPosition(oself, @self->HTGC_content,
						&row, &size);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGC_pageRow = row;
  @self->HTGC_guessSize = size;
  return;
}	/* End of MSG_UI_CALC_SIZE_POSITION.	*/


/***********************************************************************
 *		MSG_VIS_POSITION_BRANCH for HTGenCaptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/13/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenCaptionClass, MSG_VIS_POSITION_BRANCH
{
  XYValueAsDWord xy = @call @genParent::MSG_VIS_GET_POSITION();
  word lineWidth, pWidth;

@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif

  if (@self->HTGC_align == J_LEFT) {
    xOrigin = DWORD_X(xy) + @self->HTGC_xPos;
  }
  else {
    lineWidth = @call @self->HTGC_content::
	MSG_GEN_HTML_CONTENT_GET_ROW_WIDTH(@self->HTGC_pageRow);
    pWidth = DWORD_WIDTH(@call @genParent::MSG_VIS_GET_SIZE());
    if (lineWidth > pWidth)
	xOrigin = DWORD_X(xy) + @self->HTGC_xPos;
    else if (@self->HTGC_align == J_RIGHT)
	xOrigin = DWORD_X(xy) + (pWidth-lineWidth+@self->HTGC_xPos);
    else
	xOrigin = DWORD_X(xy) + (((pWidth-lineWidth)/2)+@self->HTGC_xPos);
  }

  yOrigin = DWORD_Y(xy) + GetItsPotentialHeight
      (@self->HTGC_content, @self->HTGC_pageRow, oself);

  @callsuper();
  return;
}	/* End of MSG_GEN_POSITION_BRANCH.	*/


/***********************************************************************
 *		MSG_VIS_RECALC_SIZE for HTGenCaptionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	3/13/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenCaptionClass, MSG_VIS_RECALC_SIZE
{
  VisCompInstance * vself;

  /*
   *  Get the sum of heights in this cell's height array.
   *  Get the width of the widest row in this cell.
   */
  @call self::MSG_GEN_HTML_CONTENT_GET_DIMENSION(&width, &height);

  /*
   *  Clear the bits.  We don't rely on system to do updates anymore.
   */
  vself = ObjDerefVis(oself);
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID);

  return MAKE_SIZE_DWORD(width, height);
}	/* End of MSG_VIS_RECALC_SIZE.	*/


