/***********************************************************************
 *		MSG_GEN_TCELL_PROCESS_ATTRIBUTE for HTGenTCellClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the TR element
 * PARAMETERS:	    int (MemHandle block, SGMLEntity *entity, int type, 
 *                       int *rowSpan, *colSpan, int width)
 *		    if type is non-zero, it's <TH>, else it's <TD> cell.
 *		    return colspan number
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *		Supported Attr:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTCellClass, MSG_GEN_TCELL_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j, valign = 1, span;
  Boolean percent = FALSE;
  Justification just = J_LEFT;

  @self->HTGTC_rowSpan = @self->HTGTC_colSpan = 1;
  *width = 0;

  if (type)
    @self->HTGTC_cellType = CELL_HEADER;

  for(index = 0; entity[index].SGMLE_token; index++) {
    if (!entity[index].SGMLE_value)
      continue;
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_ALIGN:                                  /* ALIGN */
      if (strcasecmp(value, "left") == 0)
	;
      else if (strcasecmp(value, "center") == 0)
	just = J_CENTER;
      else if (strcasecmp(value, "right") == 0)
	just = J_RIGHT;
      break;
    case HTML_ATTR_VALIGN:                                 /* VALIGN */
      if (strcasecmp(value, "top") == 0)
	valign = 0;
      else if (strcasecmp(value, "middle") == 0)
	valign = 1;
      else if (strcasecmp(value, "bottom") == 0)
	valign = 2;
      break;
    case HTML_ATTR_ROWSPAN:                                /* ROWSPAN */
      span = atoi(value);
      if (span > 0 && span < BITMAP_X * BITS_N_DWORD)
	  @self->HTGTC_rowSpan = span;
      break;
    case HTML_ATTR_COLSPAN:                                /* COLSPAN */
      span = atoi(value);
      if (span > 0 && span < BITMAP_X * BITS_N_DWORD)
	  @self->HTGTC_colSpan = span;
      break;
    case HTML_ATTR_WIDTH:                                  /* WIDTH */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE)
	  *width = @self->HTGTC_width = atoi(value);
      else
	  *width = -atoi(value);
      /* negative value means % */
      break;
    }
  }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  if (just == J_RIGHT || just == J_CENTER)
      @send self::MSG_GEN_HTML_CONTENT_PUSH_JUSTIFICATION(just);      

  switch (valign) {
    case 0:		/* top align */
      @send self::MSG_META_ADD_VAR_DATA
	(HINT_TOP_JUSTIFY_CHILDREN,0,NULL);
      break;
    case 1:		/* center align */
      @send self::MSG_META_ADD_VAR_DATA
	(HINT_CENTER_CHILDREN_VERTICALLY, 0, NULL);
      break;
    case 2:		/* bottom align */
      @send self::MSG_META_ADD_VAR_DATA
	(HINT_BOTTOM_JUSTIFY_CHILDREN, 0, NULL);
      break;
  }
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  /*
   *  Initialize the height array.
   */
  @send self::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();

  *rowSpan = @self->HTGTC_rowSpan;
  *colSpan = @self->HTGTC_colSpan;

  return;
}


/***********************************************************************
 *		MSG_VIS_OPEN for HTGenTCellClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the VA_MANAGER bit, so the MSG_VIS_RECALC_SIZE
 *                  and MSG_VIS_POSITION_BRANCH will not be sent to
 *                  its children.  I'll do it manually at the right time
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTCellClass, MSG_VIS_OPEN
{
  VisCompInstance *vself;

  @callsuper();

  /*
   *  Manage the geometry messagings ourselves.
   */
  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_MANAGED;
  /*
   *  Clear the invalid bits to avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
   */
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH |
			  VOF_IMAGE_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH);
  return;
}	/* End of MSG_VIS_OPEN.	*/



