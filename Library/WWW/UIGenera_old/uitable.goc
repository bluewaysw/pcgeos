@include <stdapp.goh>
@include <WWW/pmanager.goh>
@include <WWW/uigenera.goh>
@include "uifatals.goh"
#include <Ansi/string.h>
#include <Ansi/stdlib.h>        	/* atoi() defined */
@include "uifact.goh"
@include "utility.goh"


@classdecl	HTGenTableClass;	/* <TABLE>	*/
@classdecl	HTGenTCellClass;	/* <TH> + <TD>	*/
@classdecl	HTGenCaptionClass;	/* <CAPTION>	*/


@extern method HTGenTableClass, MSG_UI_CALC_SIZE_POSITION;
@extern method HTGenTableClass, MSG_UI_GET_ROW_POSITION;
@extern method HTGenTableClass, MSG_UI_SET_NEW_POSITION;
@extern method HTGenTableClass, MSG_GEN_PREPARE_FOR_DESTROY;
@extern method HTGenTCellClass,   MSG_UI_CALC_SIZE_POSITION;
@extern method HTGenTCellClass,   MSG_GEN_PREPARE_FOR_DESTROY;
@extern method HTGenCaptionClass, MSG_UI_CALC_SIZE_POSITION;
@extern method HTGenCaptionClass, MSG_UI_GET_ROW_POSITION;
@extern method HTGenCaptionClass, MSG_UI_SET_NEW_POSITION;
@extern method HTGenCaptionClass, MSG_GEN_PREPARE_FOR_DESTROY;

typedef dword tableArray[BITMAP_X][BITMAP_Y*BITS_N_DWORD];

dword ShiftBitArray[32] = { 0x1, 0x2, 0x4, 0x8, 0x10, 0x20, 0x40, 
                            0x80,  0x100, 0x200, 0x400, 0x800, 0x1000,
                            0x2000, 0x4000, 0x8000, 0x10000,
                            0x20000, 0x40000, 0x80000, 0x100000, 0x200000,
                            0x400000, 0x800000, 0x1000000, 0x2000000, 
                            0x4000000, 0x8000000, 0x10000000, 0x20000000,
                            0x40000000, 0x80000000 };

optr InitializeTableCellCommon (HTUIDoc *doc, ObjInfo *target);

Boolean	TrMode = FALSE;



/***********************************************************************
 *		UIGen_START_TABLE_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a ui object representing a table.
 *
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/27/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_TABLE_Int
		(MemHandle block, SGMLEntity *entity)
{	
  optr obj, content;
  int nextRow;

  /* 
   *  If there is some object in UIG_target, insert it to the ui tree.
   */
  if ((currentDoc->HTUI_target.class == (ClassStruct *)&HTGenFormClass)  ||
      (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass) ||
      (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTCellClass) ){
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);
    content = currentDoc->HTUI_target.obj;
  }
  else if (currentDoc->HTUI_target.obj) {
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_FINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);
    content = UIGen_GET_CONTENT_Int();
  }
  else
    content = currentDoc->HTUI_pmContent;

  /*
   *  Table always starts at a new line!
   */
  @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);

  /*
   *  Now create and store a table object in target.obj.
   */
  obj = UICreateObj(currentDoc, &HTGenTableClass);
  currentDoc->HTUI_target.obj = obj;
  currentDoc->HTUI_target.class = (ClassStruct *)&HTGenTableClass;

  /*
   *  Process the attributes.
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_TABLE_PROCESS_ATTRIBUTE
     (block, entity, content);

  TrMode = FALSE;
  return UI_GEN_NO_ERROR;
}	/* End of UIGen_START_TABLE_Int.	*/


/***********************************************************************
 *		UIGen_END_TABLE_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Finish up the table object and ask PManager 
 *		    to render it.
 *		    
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_TABLE_Int()
{
  optr content, caption;
  int nextRow;

  if (!currentDoc->HTUI_target.obj)
    return UI_GEN_ERROR;
  /*
   *  Travel up the ui tree till a table is seen,  and mark all the 
   *  objects usable along the way.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);

  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTableClass) {
    while (1) {
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(currentDoc->HTUI_target.obj),&(currentDoc->HTUI_target.class));
      EC_ERROR_IF(currentDoc->HTUI_target.obj == NULL ||
		currentDoc->HTUI_target.class==(ClassStruct*)&HTGenTextClass,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass) {
        break;
      }
    }
  }
  EC_ERROR_IF(currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTableClass,
	UIG_INVALID_OPERATION_ON_UI_TREE);
  /*
   *  Tell the receiving object (which should be HTGenTable object)
   *  that there are no more children for the table.  So the 
   *  presentation manager can mark the table usable.
   */
  caption = @call currentDoc->HTUI_target.obj::MSG_GEN_TABLE_GET_CAPTION();
  content = UIGen_GET_CONTENT_Int();
  if (caption) {
    if(@call caption::MSG_GEN_CAPTION_GET_ALIGN() == 0) {
      /*
       *  Top-aligned.
       */
      @call caption::MSG_GEN_SET_USABLE(VUM_NOW);
      @call caption::MSG_UI_CALC_SIZE_POSITION();
      @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
	  (&(currentDoc->HTUI_target.obj),&(currentDoc->HTUI_target.class));
    }
    else {
      /*
       *  Bottom-aligned.
       */
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
	  (&(currentDoc->HTUI_target.obj),&(currentDoc->HTUI_target.class));
      @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);
      @call caption::MSG_GEN_SET_USABLE(VUM_NOW);
      @call caption::MSG_UI_CALC_SIZE_POSITION();
    }
  }
  else
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
	  (&(currentDoc->HTUI_target.obj),&(currentDoc->HTUI_target.class));

  /*
   *  Objects following table always start at a new line!
   */
  @call content::MSG_GEN_HTML_CONTENT_START_NEW_ROW(0, &nextRow, NULL);

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_TABLE_Int.	*/


/***********************************************************************
 *		UIGen_START_CAPTION_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a ui representing the caption for a table.
 *	
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/28/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_CAPTION_Int
		(MemHandle block, SGMLEntity *entity)
{
  int index;
  char *value, align = 0;
  optr caption, content;

  /*
   *  Process its attribute list.
   */
  for(index = 0; entity[index].SGMLE_token; index++) {
    if (entity[index].SGMLE_token == HTML_ATTR_ALIGN) {
      if (entity[index].SGMLE_value) {
	value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
	if (strcasecmp(value, "top") == 0)
	    align = 0;
	else if (strcasecmp(value, "bottom") == 0)
	    align = 1;
      }
    }
  }
  /*
   *  Finished whatever object is there.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
      (currentDoc->HTUI_target.obj);
  /*
   *  Create a caption object and switch PM's PM_receiving object.
   */
  caption = UICreateObj(currentDoc, &HTGenCaptionClass);

  content = UIGen_GET_CONTENT_Int();
  /*
   *  If content is table cell, it's not the right object I want to put
   *  caption under.  In this case, I'm looking for the content object of
   *  table.
   */
  if (@call content::MSG_META_IS_OBJECT_IN_CLASS(&HTGenTCellClass)) {
    content = @call content::MSG_GEN_FIND_PARENT();
    while(!@call content::MSG_META_IS_OBJECT_IN_CLASS
	  (&PresentationManagerClass)){
	if (@call content::MSG_META_IS_OBJECT_IN_CLASS
	    (&HTGenHtmlContentClass)) {
	    /* 
	     * add the new text format to the content object.
	     */
	    break;
	}
	content = @call content::MSG_GEN_FIND_PARENT();
    }
    if (@call content::MSG_META_IS_OBJECT_IN_CLASS(&PresentationManagerClass))
	content = currentDoc->HTUI_pmContent;
  }
  /*
   *  Tell the PM to save the current receiving object, and back 
   *  up the ui tree to the same level as the table, and add the
   *  caption object before or after(depending align) the table 
   *  object.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_ENTER_CAPTION_MODE
      (&HTGenTableClass, align, caption);
  @call caption::MSG_GEN_CAPTION_SAVE_UIG_STATE
      (currentDoc->HTUI_target.obj, currentDoc->HTUI_target.class, content, align);
  /*
   *  Initialize the height array in the caption.
   */
  @send caption::MSG_GEN_HTML_CONTENT_RESET_ROW_COUNTER();

  currentDoc->HTUI_target.obj = caption;
  currentDoc->HTUI_target.class = &HTGenCaptionClass;

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		UIGen_END_CAPTION_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	8/ 7/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_END_CAPTION_Int()
{
  optr dummy;
  ClassStruct *class;

  if (!currentDoc->HTUI_target.obj)
    return UI_GEN_ERROR;
  /*
   *  Finish whatever current object.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);
  /*
   *  Traverse up the ui tree to the caption level.
   */
  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenCaptionClass) {
    while (1) {
      @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(currentDoc->HTUI_target.obj),&(currentDoc->HTUI_target.class));
      EC_ERROR_IF(currentDoc->HTUI_target.obj == NULL ||
		currentDoc->HTUI_target.class==(ClassStruct*)&HTGenTextClass,
		UIG_INVALID_OPERATION_ON_UI_TREE);
      if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenCaptionClass){
        break;
      }
    }
  }

  EC_ERROR_IF(currentDoc->HTUI_target.class!=(ClassStruct*)&HTGenCaptionClass,
	      UIG_INVALID_OPERATION_ON_UI_TREE);
  /*
   *  And make the caption subtree usable.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_NOT_DONE(&dummy, &class);

  /*
   *  Tell the PM to restore the receiving object to what it was 
   *  before the caption object was created.
   */
  @call currentDoc->HTUI_pmanager::MSG_PM_EXIT_CAPTION_MODE();
  @call currentDoc->HTUI_target.obj::MSG_GEN_CAPTION_RESTORE_UIG_STATE
	(&dummy,&class);

  currentDoc->HTUI_target.obj   = dummy;
  currentDoc->HTUI_target.class = class;

  return UI_GEN_NO_ERROR;
}	/* End of UIGen_END_CAPTION_Int.	*/



/***********************************************************************
 *		UIGen_START_TR_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	End the modication of the ui objects in the previous 
 *		table cell if there is any.
 *		
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *		If target.obj has any object from the previous
 *		modification, insert it to the ui tree and traverse up
 *		the tree to find the first table object.  We mark all
 *		the encouting objects usable while traversing up the
 *		tree.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_START_TR_Int
		(MemHandle block, SGMLEntity *entity)
{
  if (!currentDoc->HTUI_target.obj)
	return UI_GEN_ERROR;

  if (currentDoc->HTUI_target.class != (ClassStruct *)&HTGenTableClass) {
    /*
     *  No matter what's in the current target.obj, insert that object 
     *  to the bottom leaf of the ui tree.
     */
    @call currentDoc->HTUI_pmanager::MSG_PM_TAKE_UNFINISHED_UI_OBJ
	(currentDoc->HTUI_target.obj);
    /*
     * Traverse up the ui tree from the leaf to find the first table 
     * object.  Any future table cell objects will be added to the
     * children list of this table object.  In other word, we tell the
     * PManager to travel up the ui tree until a table object becomes
     * its recvObj.
     */
    while (1) {
	@call currentDoc->HTUI_pmanager::MSG_PM_MARK_RECV_OBJECT_DONE
		(&(currentDoc->HTUI_target.obj), &(currentDoc->HTUI_target.class));
	/*
	 * Now currentDoc->HTUI_target.obj contains PManager's recvObj.
	 */
	EC_ERROR_IF(currentDoc->HTUI_target.class == NULL || 
		    currentDoc->HTUI_target.obj == NULL ||
		    currentDoc->HTUI_target.class==(ClassStruct *)&HTGenTextClass,
		    UIG_INVALID_OPERATION_ON_UI_TREE);
	if (currentDoc->HTUI_target.class == (ClassStruct *)&HTGenTableClass)
		break;	/* found the table object */
    }
  }
  if (TrMode == FALSE) {
      /*
       * Reset the suggested rowNo and colNo to the next new row of cells.
       */
      @call currentDoc->HTUI_target.obj::MSG_GEN_TABLE_INCREMENT_ROW_COUNT();
      TrMode = TRUE;
  }

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		UIGen_CREATE_TH_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a header cell <TH> for the TABLE construct.
 *
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_TH_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr table;
  int row, col, colSpan, rowSpan, width;

  /*
   *  Do some work common both for <TH> header cells and <TD> data cells.
   */
  table = InitializeTableCellCommon(currentDoc,&(currentDoc->HTUI_target));

  /*
   *  By default, the text is bold for <TH>.
   */
  UIGen_START_BOLD_Int();

  /*
   *  Process the attribute list.
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_TCELL_PROCESS_ATTRIBUTE
      (block, entity, 1, &rowSpan, &colSpan, &width);

  /*
   *  Ask the table ui object for the cell position for this new
   *  table cell object.  Table object will use the suggested
   *  column count and take into account any nearby cells that span 
   *  over rows or columns to calculate the actual cell position.
   */
  @call table::MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION
      (&row, &col, rowSpan, colSpan, width);

  /*
   * Set its cell position.
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_TCELL_SET_CELL_POSITION(row, col);

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		UIGen_CREATE_TD_Int for UIGeneratorClass
 ***********************************************************************
 * SYNOPSIS:	    Create a data cell <TD> for the TABLE construct
 *		    
 * PARAMETERS:	    (MemHandle dataBlock, SGMLEntity *entity)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/29/96   	Initial Revision
 *
 ***********************************************************************/
ErrorCode UIGen_CREATE_TD_Int
		(MemHandle block, SGMLEntity *entity)
{
  optr table;
  int row, col, colSpan, rowSpan, width;

  /*
   *  Do some comon work for both <TH> header cells and <TD> data cells.
   */
  table = InitializeTableCellCommon(currentDoc,&(currentDoc->HTUI_target));

  /*
   *  Process the attribute list.
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_TCELL_PROCESS_ATTRIBUTE
      (block, entity, 0, &rowSpan, &colSpan, &width);

  /*
   *  Ask the table ui object for the cell position for this new
   *  table cell object.  Table object will use the suggested
   *  column count and take into account any nearby cells that span 
   *  over rows or columns to calculate the actual cell position.
   */
  @call table::MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION
      (&row, &col, rowSpan, colSpan, width);

  /*
   * Set its cell position.
   */
  @call currentDoc->HTUI_target.obj::MSG_GEN_TCELL_SET_CELL_POSITION(row, col);

  return UI_GEN_NO_ERROR;
}


/***********************************************************************
 *		MSG_GEN_TABLE_PROCESS_ATTRIBUTE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Process the attribute list of the the TABLE element
 * PARAMETERS:	    (MemHandle block, SGMLEntity *entity, optr content)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	
 *	Supported Attr:
 *		BORDER
 *		CELLPADDING = n
 *		CELLSPACING = n
 *		WIDTH = n | n%
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	5/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_PROCESS_ATTRIBUTE
{
  char *value;
  int	index, j, *array, i;
  float per;
  Boolean percent;
  ChunkHandle chunk;
  Justification just;
  word br;
  /*
   *  Let's get the default alignment.  If the TABLE has ALIGN attribute,
   *  the attribute overwrites the content alignment.
   *  Table doesn't care about <NOBR> because it always starts at a new line.
   */
  just = @call content::MSG_GEN_HTML_CONTENT_GET_JUSTIFICATION(&br);

  for(index = 0; entity[index].SGMLE_token; index++) {
    /*
     *  Border can have no value.  It's a special case.
     */
    if (!entity[index].SGMLE_value) {
      if (entity[index].SGMLE_token == HTML_ATTR_BORDER) {
	@self->HTGT_showBorder = TRUE;
	@send self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
      }
      continue;
    }
    value = (char *)LMemDerefHandles(block, entity[index].SGMLE_value);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    switch(entity[index].SGMLE_token) {
    case HTML_ATTR_BORDER:                       /* BORDER */
      if (*value != '0') {
	@self->HTGT_showBorder = TRUE;
	@send self::MSG_META_ADD_VAR_DATA(HINT_DRAW_IN_BOX,0,NULL);
      }
      break;
    case HTML_ATTR_WIDTH:                        /* WIDTH */
      /*
       *  Checking for % sign.
       */
      for (j = 0, percent = FALSE; value[j] != NULL; j++)
	if (value[j] == '%')
	  percent = TRUE;
      if (percent == FALSE)
	@self->HTGT_width = atoi(value);         /* No percent sign */
      else {
	  if ((per = atoi(value)) > 100)
	    per = 100;
	@self->HTGT_width = (per / 100.00) * 
	DWORD_WIDTH(@call content::MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE());
      }
      break;
    case HTML_ATTR_CELLPADDING:                  /* CELLPADDING */
      @self->HTGT_cellpadding = atoi(value);
      break;
    case HTML_ATTR_CELLSPACING:                  /* CELLSPACING */
      @self->HTGT_cellspacing = atoi(value);
      break;
    case HTML_ATTR_ALIGN:
      /*
       *  Overwrite the default alignment of the content.
       */
      if (strcasecmp(value, "center") == 0)
	  just = J_CENTER;
      else if (strcasecmp(value, "right") == 0)
	  just = J_RIGHT;
      else
	  just = J_LEFT;
      break;
    }
  }
  @self->HTGT_align = just;

  /*
   *  No 3-D look.
  @call self::MSG_META_ADD_VAR_DATA(HINT_DRAW_STYLE_FLAT,0,NULL);
   */
  /*
   *  Initialize the row and column array.
   */
  chunk = LMemAlloc(HandleOf(oself), sizeof(int)*ROW_SIZE);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_rowHeight = chunk;
  array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  @self->HTGT_rowSize = ROW_SIZE;
  for (i=0; i < ROW_SIZE; i++) array[i] = 0;

  chunk = LMemAlloc(HandleOf(oself), sizeof(int)*COLUMN_SIZE);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
  @self->HTGT_colWidth = chunk;
  array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
  @self->HTGT_columnSize = COLUMN_SIZE;
  for (i=0; i < COLUMN_SIZE; i++) array[i] = 0;

  @self->HTGT_content = content;
  /*
   *  Initially not in any row.
   */
  @self->HTGT_pageRow = -1;

  @self->HTGT_bitmap =
      HTMemAllocWID(0, sizeof(dword)*BITMAP_X*BITMAP_Y*BITS_N_DWORD);

  return;
}	/* End of MSG_GEN_TABLE_PROCESS_ATTRIBUTE.	*/


/***********************************************************************
 *		MSG_VIS_OPEN for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Clear the VA_MANAGER bit, so the MSG_VIS_RECALC_SIZE
 *                  and MSG_VIS_POSITION_BRANCH will not be sent to
 *                  its children.  I'll do it manually at the right time
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/26/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_VIS_OPEN
{
  VisCompInstance *vself;

  @callsuper();
  /*
   *  Manage the geometry messagings ourselves.
   */
  vself = ObjDerefVis(oself);
  vself->VI_attrs &= ~VA_MANAGED;
  /*
   *  Clear the invalid bits to avoid MSG_VIS_UPDATE_WINDOWS_AND_IMAGE.
   */
  vself->VI_optFlags &= ~(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID | 
			  VOF_WINDOW_INVALID | VOF_GEO_UPDATE_PATH |
			  VOF_IMAGE_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH);

  return;
}	/* End of MSG_VIS_OPEN.	*/


/***********************************************************************
 *	MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Find the virtual cell position for the new cell obj.
 *                  (Note, the cell position here is not not the
 *                   absolute screen position, but the cell's
 *                   (row number, column number) position in the table.)
 * PARAMETERS:	    (int *row, int *col, int rowSpan, int colSpan, int width)
 *                  width - the WIDTH attribute of <TH> or <TD>
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    Re-write the previous routine, now use the bitmap.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	5/29/97   	Initial Revision
 *	
 ***********************************************************************/
dword GetBit(dword cell, int bit)
{
    EC_ERROR_IF(bit > 32, 1);
    return cell & ShiftBitArray[bit - 1];
}
void SetBits(dword *cell, int bit, int colSpan)
{
    EC_ERROR_IF(bit < 0 || colSpan <= 0 || bit+colSpan > 33 , 1);
    *cell |= ShiftBitArray[bit+colSpan-2];
    return;
}

@method HTGenTableClass, MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION
{
  word index_col, bit_pos, dword_span, dword_pos, i;
  int j, *array;
  tableArray *bitmap;

  index_col = @self->HTGT_colNo / BITS_N_DWORD;

  bitmap = (tableArray *)HTMemLock(@self->HTGT_bitmap);
  while (GetBit((*bitmap)[index_col][@self->HTGT_rowNo - 1],
		@self->HTGT_colNo - 
		((@self->HTGT_colNo / BITS_N_DWORD)*BITS_N_DWORD))) {
      /*
       *  The cell is occupied, keep search for the next column.
       */
      @self->HTGT_colNo++;
      index_col = @self->HTGT_colNo / BITS_N_DWORD;
      /*
       *  If this cell spans over the array limit, realloc the array.
       */
      if (@self->HTGT_colNo > @self->HTGT_columnSize) {
	/*
	 *  Realloc the array.
	 */
	EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
	j = @self->HTGT_columnSize;
	@self->HTGT_columnSize += (COLUMN_SIZE + @self->HTGT_colNo - j);
	LMemReAllocHandles(HandleOf(oself),
			   @self->HTGT_colWidth, 
			   sizeof(int) * @self->HTGT_columnSize);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
        array=(int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
	for (; j < @self->HTGT_columnSize; j++) array[j] = 0;
      }
      index_col = @self->HTGT_colNo / BITS_N_DWORD;
  }
  /*
   *  Now the suggested (self->HTGT_rowNo, @self->HTGT_colNo) cell
   *  position is available for the assignment.
   */
  *row = @self->HTGT_rowNo;
  *col = @self->HTGT_colNo;
  EC_ERROR_IF(*col > @self->HTGT_columnSize, 1);
  EC_ERROR_IF(*row > @self->HTGT_rowSize, 1);
  /*
   *  Mark the new cell space occupied.
   */
  index_col = @self->HTGT_colNo / BITS_N_DWORD;
  bit_pos = @self->HTGT_colNo - 
      ((@self->HTGT_colNo / BITS_N_DWORD)*BITS_N_DWORD);
  dword_span = (colSpan+((int)bit_pos)-1) / ((int)BITS_N_DWORD);
  dword_pos = (colSpan + @self->HTGT_colNo - 1) - 
      (((colSpan + @self->HTGT_colNo -1) / ((int)BITS_N_DWORD))*BITS_N_DWORD);

  if (!dword_span) {
    /*  Colspan doesn't cross the dword cell */
    for (; rowSpan > 0; ) {
      SetBits(&((*bitmap)[index_col][@self->HTGT_rowNo-1+rowSpan-1]),
	      bit_pos, colSpan);
      rowSpan--;
    }
  }
  else {
    /*  Colspan  crosses the dword cell */
    for (; rowSpan > 0; ) {
      for(i = index_col, j = bit_pos; i < dword_span; i++, j = 1) {
	  EC_WARNING(1);
	  SetBits(&((*bitmap)[i][@self->HTGT_rowNo-1+rowSpan-1]),
		  j, BITS_N_DWORD );
      }
      SetBits(&((*bitmap)[index_col][@self->HTGT_rowNo-1+rowSpan-1]),
	      1, dword_pos);
      rowSpan--;
    }
  }
  /*
   *  Increment the HTGT_colNo for the future cell, if in the same row.
   *  If the future cell is not in the same row, HTGT_colNo will be reset
   *  to 1 by MSG_GEN_TABLE_INCREMENT_ROW_COUNT.
   */
  @self->HTGT_colNo += colSpan;
  /*
   *  If this cell spans over the array limit, realloc the array.
   */
  if (@self->HTGT_colNo > @self->HTGT_columnSize) {
      /*
       *  Realloc the array.
       */
      EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
      j = @self->HTGT_columnSize;
      @self->HTGT_columnSize += (COLUMN_SIZE + @self->HTGT_colNo - j);
      LMemReAllocHandles(HandleOf(oself),
			 @self->HTGT_colWidth, 
			 sizeof(int) * @self->HTGT_columnSize);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
      array=(int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
      for (; j < @self->HTGT_columnSize; j++) array[j] = 0;
  }

  HTMemUnlock(@self->HTGT_bitmap);
  if (!width)
      return;
  /*
   *  Now we know the cell's position.  Record the cell's WIDTH attribute
   *  in the table object.
   */
  array=(int*)LMemDerefHandles(HandleOf(oself),@self->HTGT_colWidth);
  if (width < 0 && colSpan == 1) {
      word tmpWidth;
      if (@self->HTGT_width > 0)
	  tmpWidth = @self->HTGT_width;
      else	
	  tmpWidth = @call pself->HTGT_content::
	      MSG_GEN_HTML_CONTENT_GET_SUGGESTED_SIZE();
      EC_ERROR_IF(tmpWidth <= 0, 1);
      i = ((-(float)width)/100.00) * tmpWidth;
      if (i > array[*col-1]) {
	  array[*col-1] = i;
	  SetBits(&(@self->HTGT_widthAttr[index_col]), bit_pos, colSpan);
      }
  }
  else if (width > 0 && colSpan==1 && width > array[*col-1]) {
      array[*col-1] = width;
      SetBits(&(@self->HTGT_widthAttr[index_col]), bit_pos, colSpan);
  }
  EC_ERROR_IF(array[*col-1] < 0, 1);


  return;
}	/* End of MSG_GEN_TABLE_GET_NEXT_TABLE_CELL_POSITION.	*/



/***********************************************************************
 *	MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Keep track the maxinum size of the biggest table
 *		    cell.
 * PARAMETERS:	    (int row, int height, int rowSpan);
 *		    row - row number of the table cell.
 *		    height - height of the table cell.
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT
{
  int *array;
  word i, sumHeight, disHeight;

  EC_ERROR_IF(row > @self->HTGT_rowNo, UIG_ERROR_IN_TABLE);
  array = (int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);

  if (rowSpan == 1) {
    if (height > array[row - 1])
	array[row - 1] = height;
  }
  else if (rowSpan > 1) {
    /*
     *  Distribute the height if the cell is longer than the rows
     *  spanned.
     */
    for (i=row-1, sumHeight=0; i<(row-1+rowSpan) && @self->HTGT_rowNo; i++)
	sumHeight += array[i];
    if (sumHeight && sumHeight < height) {
	/*
	 *  Oh oh...  We need to distribute the height to make spanned
	 *  rows taller.
	 */
	disHeight = (height - sumHeight) / rowSpan;
	for (i=row - 1; i < (row-1+rowSpan) && i < @self->HTGT_rowNo; i++)
	    array[i] += disHeight;
    }
  }
  return;
}	/* End of MSG_GEN_TABLE_UPDATE_MAX_CELL_HEIGHT. */


/***********************************************************************
 *	MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Given the row and column number, calculate the
 *		    position of that cell, in pixels, relative to (0,0).
 *
 * PARAMETERS:	     (int row, int col, int *xPixel, int *yPixel)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION
{
  int i, *array;

  *xPixel = *yPixel = 0;

  /*
   *  Add up row heights and the cellspace.
   */
  array = (int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
  for (i=0; i < (row-1) && i < @self->HTGT_rowSize; i++) {
	*yPixel += (array[i] + @self->HTGT_cellspacing);
  }
  *yPixel += @self->HTGT_cellspacing;

  /*
   *  Add up column widths and the cellspace.
   */
  array =(int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);
  for (i=0; i < (col-1) && i < @self->HTGT_columnSize; i++) {
	*xPixel += (array[i] + @self->HTGT_cellspacing);
  }
  *xPixel += @self->HTGT_cellspacing;

  return;
}	/* End of MSG_GEN_TABLE_GET_FINAL_CELL_PIXEL_POSITION.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_INCREMENT_ROW_COUNT for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Increment the row count whenever <TR> is seen
 * PARAMETERS:	    none
 * SIDE EFFECTS:    
 *
 * STRATEGY:	Increment the row count.
 *		Reset the column count to 1.
 *		This (row count, column count) will be the table
 *		 position of the next table cell object.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/ 5/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_INCREMENT_ROW_COUNT
{
  int i, *array;
  /*
   *  Reset the position count for the next new table cell.
   */
  @self->HTGT_rowNo++;
  if (@self->HTGT_rowNo > @self->HTGT_rowSize) {
    /*
     *  Realloc the array.
     */
    EC_WARNING(UIG_TABLE_ARRAY_SIZE_REALLOC);
    i = @self->HTGT_rowSize;
    @self->HTGT_rowSize += (ROW_SIZE + @self->HTGT_rowNo - i);
    LMemReAllocHandles(HandleOf(oself), 
		       @self->HTGT_rowHeight, 
		       sizeof(int) * @self->HTGT_rowSize);
@ifdef PRODUCT_RESPONDER
    pself = ObjDerefGen(oself);
@endif
    array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);
    for (; i < @self->HTGT_rowSize; i++) array[i] = 0;
  }

  @self->HTGT_colNo = 1;	/* reset to 1 */
}	/* End of MSG_GEN_TABLE_INCREMENT_ROW_COUNT.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_GET_ROWSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	   Given the starting row number and ROWSPAN, accumulate
 *		   the heights of the rows that the cell spans.
 * PARAMETERS:	   (int rowNo, int rowSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_ROWSPAN_SIZE
{
  int height, *array;

  EC_ERROR_IF(rowNo < 1, UIG_ERROR_IN_TABLE);
  array = (int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);

  for(height = 0, --rowNo; rowSpan > 0 && rowNo < @self->HTGT_rowNo; 
      rowSpan--, rowNo++) {
    height += array[rowNo];
  }
  EC_ERROR_IF(height < 0, 1);
  return height;
}	/* End of MSG_GEN_TABLE_GET_ROWSPAN_SIZE.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_GET_COLSPAN_SIZE for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	  Given the starting column number and COLSPAN, 
 *		  accumlate the widths of the columns that the cell spans.
 * PARAMETERS:	  int (int colNo, int colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/12/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_GET_COLSPAN_SIZE
{
  int width, *array, index_col;

  EC_ERROR_IF(colNo < 1, UIG_ERROR_IN_TABLE);

  index_col = colNo / BITS_N_DWORD;

  if (colSpan > 1 && (!(@self->GI_states & GS_USABLE)) && 
      !GetBit(@self->HTGT_widthAttr[index_col], 
	      colNo-((colNo/BITS_N_DWORD))*BITS_N_DWORD))
      return @self->HTGT_width; /* table may not have WIDTH value either */
 
  array = (int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);

  for(width = 0, --colNo; colSpan > 0 && colNo < @self->HTGT_columnSize;
      colSpan--, colNo++) {
    width += array[colNo];  /* accumulate spaned column widths */
  }
  if (width == 0) {
    if (@self->HTGT_width > X_SCREEN_SIZE)
      return (X_SCREEN_SIZE - MARGIN - MARGIN) / 2;
    else
      return @self->HTGT_width/2; /* table may not have WIDTH value either */
  }
  EC_ERROR_IF(width < 0, 1);
  return width;
}	/* End of MSG_GEN_TABLE_GET_COLSPAN_SIZE.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_SHOW_BORDER for HTGenTableClass
 ***********************************************************************
 * SYNOPSIS:	    Does the table have BORDER attribute?
 * PARAMETERS:	    Boolean ()
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	EY	6/13/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SHOW_BORDER
{
  return @self->HTGT_showBorder;
}	/* End of MSG_GEN_TABLE_SHOW_BORDER.	*/



/***********************************************************************
 *		MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Store the width of the column at colPos.  This width
 *		    is the calculated value from the Geometry Manager
 *		    after all its children sizes have been resized.
 *                  Return the maximun width seen so far for this column
 *                  Or the width adjusted for the colSpan.
 * PARAMETERS:	    int (int colPos, int width, word colSpan);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	9/25/96   	Initial Revision
 *
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH
{
  int *array;
  int i, sumWidth, disWidth;

  EC_ERROR_IF(colPos < 1, UIG_ERROR_IN_TABLE);
  EC_ERROR_IF(width < 0, UIG_ERROR_IN_TABLE);

  array = (int *)LMemDerefHandles(HandleOf(oself), @self->HTGT_colWidth);

  if (colSpan == 1) {
    if (array[colPos-1] < width)
      array[colPos-1] = width;
    EC_ERROR_IF(array[colPos-1] < 0, 1);
  }
  else {
    /*
     *  Distribute the width if the cell is wider than the columns
     *  spanned.
     */
    for (i=colPos-1, sumWidth=0; 
	 i < (colPos-1+colSpan) && i < @self->HTGT_colNo;
	 i++)
	sumWidth += array[i];
    if (sumWidth && sumWidth < width) {
	/*
	 *  Oh oh...  We need to distribute the width to make spanned
	 *  columns wider.
	 */
	disWidth = (width - sumWidth) / colSpan;
    }
    else if (!sumWidth)
	disWidth = width / colSpan;
    else
	return;

    if (disWidth) {
      /*
       *  There is enough disWidth to distribute to all spanning columns.
       */
      for (i=colPos-1;
	   i < (colPos - 1 + colSpan) && i < @self->HTGT_colNo;
	   i++) {
	  EC_ERROR_IF(array[i] < 0, 1);
	  EC_ERROR_IF(disWidth < 0, 1);
	  array[i] += disWidth;
      }
    }
    else {
      /*
       *  Not enough distribute pixels to distribute to all spanning 
       *  columns.  So distribute one pixel to each spanning column until
       *  it's running out of distributed width.
       */
      disWidth = width - sumWidth;
      EC_ERROR_IF(disWidth >= colSpan || disWidth <= 0, 1);
      for (i=colPos-1; disWidth && 
	   i < (colPos - 1 + colSpan) && i < @self->HTGT_colNo;
	   i++) {
	  EC_ERROR_IF(array[i] < 0, 1);
	  EC_ERROR_IF(disWidth < 0, 1);
	  array[i] += 1;
	  disWidth--;
      }
      EC_ERROR_IF(i == @self->HTGT_colNo && disWidth, 1);
    }
  }
  
  return;
}	/* End of MSG_GEN_TABLE_SET_FINAL_CELL_WIDTH.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_RECALC_POSITIONS for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Re-position table cells because the passed cell
 *                  changed the size.
 * PARAMETERS:	    (optr cell, SizeAsDWord newSize, 
 *                   word rowSpan, word colSpan)
 *                  cell - the table cell whose size changed
 *                  newSize - new size of the passed table cell.
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/ 5/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_RECALC_POSITIONS
{
  int row, col, *colArray, *rowArray;
  word i, width, height, sum, rowSpan, colSpan;

  @call cell::MSG_GEN_TCELL_GET_CELL_POSITION(&row, &col);
  @call cell::MSG_GEN_TCELL_GET_SPAN(&rowSpan, &colSpan);

  /*
   *  (row, col) of the table cell whose size changes.
   */
  colArray = (int *)LMemDerefHandles(HandleOf(oself),@self->HTGT_colWidth);
  rowArray = (int *)LMemDerefHandles(HandleOf(oself),@self->HTGT_rowHeight);

  if (colArray[col-1] < DWORD_WIDTH(newSize) && colSpan == 1) {
      EC_ERROR_IF(DWORD_WIDTH(newSize) < 0, 1);
      colArray[col-1] = DWORD_WIDTH(newSize);
  }
  else if (colArray[col-1] < DWORD_WIDTH(newSize) && colSpan > 1) {
    for (i = col-1, sum=0; i < (col-1+colSpan) && i<@self->HTGT_colNo; i++)
	sum += colArray[i];
    EC_ERROR_IF(sum > DWORD_WIDTH(newSize), 1);
    colArray[i-1] += (DWORD_WIDTH(newSize) - sum);
  }

  if (rowArray[row-1] < DWORD_HEIGHT(newSize) && rowSpan == 1)
      rowArray[row-1] = DWORD_HEIGHT(newSize);
  else if (rowArray[row-1] < DWORD_HEIGHT(newSize) && rowSpan > 1) {
    for (i = row-1, sum=0; i < (row-1+rowSpan) && i<@self->HTGT_rowNo; i++)
	sum += rowArray[i];
    if (sum < DWORD_HEIGHT(newSize))
	rowArray[i-1] += (DWORD_HEIGHT(newSize) - sum);
  }

  for (i=0, height = 0; rowArray[i] != 0 && i < @self->HTGT_rowSize; i++){
	height += (rowArray[i] + @self->HTGT_cellspacing);
  }
  for (i=0, width = 0; colArray[i] != 0 && i < @self->HTGT_columnSize; i++) {
	width += (colArray[i] + @self->HTGT_cellspacing);
  }

  @call self::MSG_VIS_SET_SIZE(width + @self->HTGT_cellspacing,
			  height+ @self->HTGT_cellspacing);

  return;
}	/* End of MSG_GEN_TABLE_RECALC_POSITIONS.	*/


/***********************************************************************
 *		MSG_GEN_TABLE_EXPAND_ROW_HEIGHTS for HTGenTableClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    (word row, word span, word hgt)
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	6/18/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTGenTableClass, MSG_GEN_TABLE_EXPAND_ROW_HEIGHT
{
  int *array;
  word i, sum;

  array = (int*)LMemDerefHandles(HandleOf(oself), @self->HTGT_rowHeight);

  for (i = row-1, sum=0; i < (row-1+span) && i < @self->HTGT_rowNo; i++)
    sum += array[i];

  EC_ERROR_IF(sum > hgt, 1);

  array[i-1] += (hgt - sum);
  return;
}	/* End of MSG_GEN_TABLE_EXPAND_ROW_HEIGHTS.	*/


