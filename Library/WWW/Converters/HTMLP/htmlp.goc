#define SearchContentOptr(content, elementToken) \
    SearchContentPtr((HTMLAtom *) LMemDeref(content), elementToken)

static int _pascal
    SearchContentPtr(HTMLAtom *atom, word elementToken);

static void _pascal
    AddAllowedContentModel (HTMLParser *parser, word elementToken);

static void _pascal
    AddMinusContentModel (HTMLParser *parser, word elementToken);

static void _pascal
    CheckRightToLeftGrammar (HTMLParser *parser, HTMLAtom *atom, int index);

static Boolean _pascal
    CheckStartElementGrammar (HTMLParser *parser, HTMLAtom *atom, int index);

static int _pascal
    HTMLParseStartElement (HTMLParser *parser, word elementToken);

static int _pascal
    HTMLAllowed (HTMLParser *parser, int index, word elementToken);

