@ifndef __HT_ENTRY_GOH
@define __HT_ENTRY_GOH


/*
 * In HTReq/htreq.goc. Request Manager entry.
 */
extern int _far _pascal
	HTRequestLibraryEntry(LibraryCallType ty, GeodeHandle client);

/*
 * In HTNet/htnet.goc. Net Manager entry.
 */
extern int _far _pascal
	HTNetLibraryEntry(LibraryCallType ty, GeodeHandle client);

/* 
 * In HTSockMan/htsockMan.goc. Socket Manager Library entry.
 */
extern int _far _pascal
	HTSockManLibraryEntry(LibraryCallType ty, GeodeHandle client);

/*
 * In HTPolicy/htpolicy.goc. Policy Manager Library entry.
 */
extern int _far _pascal
	HTPolicyLibraryEntry(LibraryCallType ty, GeodeHandle client);

/*
 * In HTString/htstring.goc. 
 */
extern int _far _pascal
	HTStringLibraryEntry(LibraryCallType ty, GeodeHandle client);

/*
 * In HTAA/htaabrow.goc.
 */
extern int _far _pascal
	HTAALibraryEntry(LibraryCallType ty, GeodeHandle client);


/*
 * In HTAnchor/htanchor.goc
 */
extern int _far _pascal
	HTAnchorLibraryEntry(LibraryCallType ty, GeodeHandle client);

@endif /* __HT_ENTRY_GOH */
