@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htfwrite.goh>
@include <WWW/HTCore/htobj.goh>
@include "htfatals.goh"

/***********************************************************************
 *		HTFWRITENEW
 ***********************************************************************
 *
 * SYNOPSIS:	Create a new file writer stream.
 * CALLED BY:	Client.
 * RETURN:	HTStreamHandle or NULL.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
HTStreamHandle _far _pascal
HTFWRITENEW (const char *filename, ThreadHandle thread)
{
    FileHandle fhandle;
    HTStreamHandle stream;

EC( if (thread) ECCheckThreadHandle(thread);                            )

    FileDelete(filename);       /* So that FileCreate would work */
    fhandle = FileCreate(filename, FCF_NATIVE | FILE_CREATE_TRUNCATE |
			 FILE_DENY_W | FILE_ACCESS_RW, FILE_ATTR_NORMAL);
    if (!fhandle) return 0;
    PUSHDS;
    SET_DS_LIB_DGROUP;       /* To use HTFWriteClass */
    stream = HTObjInstantiateForThread(thread, &HTFWriteClass);
    POPDS;
    if (!stream) return 0;
    @call stream::MSG_HT_STREAM_SET_TARGET((optr)fhandle);
    return stream;
}	/* End of HTFWRITENEW.	*/



/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTFWriteClass;

/***********************************************************************
		Message Handlers
***********************************************************************/



/***********************************************************************
 *		MSG_HT_STREAM_SET_TARGET for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Instead of setting stream as a target, we set a
 *                  FileHandle.
 * PARAMETERS:	    void (FileHandle fhandle); this will have to be 
 *                  cast into a FileHandle.
 * SIDE EFFECTS:    Make sure that sizeof(FileHandle) <= sizeof(optr).
 *
 * STRATEGY:	    Don't call super.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_SET_TARGET
{
     if (!target) return;

EC(  if (sizeof(FileHandle) > sizeof(optr))                             )
EC(      EC_ERROR(INVALID_DATA_AND_LENGTH);                             )

EC(  ECCheckFileHandle((FileHandle)target);                             )

     @self->HTFWI_fileHandle = (FileHandle) target;
}	/* End of MSG_HT_STREAM_SET_TARGET.	*/




/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Done writing.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_ABORT
{
    if (@self->HTFWI_fileHandle) {
	FileClose(@self->HTFWI_fileHandle, FALSE);
        @self->HTFWI_fileHandle = 0;
    }

    return @callsuper();
}	/* End of MSG_HT_STREAM_ABORT.	*/




/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Flush data in file to disk.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_FLUSH
{
    if (@self->HTFWI_fileHandle) {
	FileCommit(@self->HTFWI_fileHandle, FALSE);
    }

    return @callsuper();
}	/* End of MSG_HT_STREAM_FLUSH.	*/



/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTFWriteClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Save data to a disk file.
 * PARAMETERS:	    int (const byte *data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTFWriteClass, MSG_HT_STREAM_PUT_BLOCK
{
    if (!len || !data) return HT_OK;

    if (FileWrite(@self->HTFWI_fileHandle, 
		  (void *) data, len, FALSE) == -1) {
	
	/* Failed to write */
@ifdef PRODUCT_RESPONDER
	pself = ObjDeref(oself,0);
@endif
	FileClose(@self->HTFWI_fileHandle, FALSE);
	
	return HT_CANNOT_WRITE_FILE;
    }

    return HT_OK;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/

