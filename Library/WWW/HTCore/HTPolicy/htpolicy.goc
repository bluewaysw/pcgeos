/*
 * Library won't compile unless there is a dgroup, this dummy does the job! :)
 */
byte htPolicyDummy;

/* --------------------------------------------------------------------------
 * 		PRIVATE DATATYPES
 * --------------------------------------------------------------------------*/

/*
 * Structure for maintaining registered protocols.
 * Here comes Geos intricacy. If dynamicLoad is TRUE, then the first 
 * export in the "gp" file must be the protocol class. If dynamicLoad is
 * FALSE, then fileName is no use, instead we need the class name.
 */
typedef struct {
    Boolean HTP_dynamicLoad;           /* TRUE if to be dynamically loaded */
    HTStringHandle HTP_name;           /* e.g., "http" */
    HTStringHandle HTP_library;        /* e.g., "WWW HTTP Library Protocol */
    ClassStruct _far * HTP_class;      /* e.g., HTTPClass */
} HTProtocol;



/* --------------------------------------------------------------------------
 * 		PRIVATE FUNCTIONS
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTPolicyThread
 ***********************************************************************
 *
 * SYNOPSIS:	Get policy thread.
 * CALLED BY:	Internal
 * RETURN:	ThreadHandle.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/10/97   	Initial Revision
 *	
 ***********************************************************************/
static ThreadHandle _pascal
HTPolicyThread (HTRequestHandle request)
{
    ThreadHandle ret;
    HTRequest *rptr = (HTRequest*) MemThreadGrab(request);
    ret = rptr->HTR_scheduler;
EC( ECCheckThreadHandle(ret);                                           )
    MemThreadRelease(request);
    return ret;
}	/* End of HTPolicyThread.	*/




/***********************************************************************
 *		HTPolicyGetDefaultProtocolHandler
 ***********************************************************************
 *
 * SYNOPSIS:	Create a Library default protocol handler if one exists.
 * CALLED BY:	HTPolicyGetProtocolHandler
 * RETURN:	HTStreamHandle, a protocol handler if found, else 
 *              NUllOptr.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    All default protocol Libraries are loaded dynamically.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/ 9/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyGetDefaultProtocolHandler (HTRequestHandle request, 
				   HTStringHandle protocol)
{
    GeodeLoadError loadError;
    GeodeHandle libHandle;
    ClassStruct *classPtr;
    MemHandle block;
    word dataSize;
    char *name, *key;
    HTStreamHandle handler = NullOptr;

EC( ECCheckHTString(protocol);                                        )

    /* All default content handlers are specified in the ini file */
    key = (char *) HTStringLock(protocol);
    if (key && !InitFileReadStringBlock("wwwLibrary",
					key,
					&block,
					IFRF_READ_ALL,
					&dataSize) && dataSize) {

	name = (char *) MemLock(block);
	while(ISWHITE(*name)) name++;

	/* We've got the protocol library name */
	FilePushDir();
	FileSetStandardPath(SP_SYSTEM);
	libHandle = GeodeUseLibrary(name, 0, 0, &loadError);
	FilePopDir();

	if (libHandle) {
	    /* Protocol lib must export converter class first */
	    classPtr = (ClassStruct *) ProcGetLibraryEntry(libHandle, 0);
	    handler = HTObjInstantiateForThread(HTPolicyThread(request), 
						classPtr);
	    if (handler) @call handler::
		MSG_HT_STREAM_SET_DYNAMICALLY_LOADED(libHandle);
	    else
		GeodeFreeLibrary(libHandle);
	}
	    
	MemFree(block);
    }

    HTStringUnlock(protocol);

    return handler;
}	/* End of HTPolicyGetDefaultProtocolHandler.	*/



/***********************************************************************
 *		HTPolicyGetDefaultContentHandler
 ***********************************************************************
 *
 * SYNOPSIS:	Create a Library default content handler if one exists.
 * CALLED BY:	HTPolicyGetContentHandler.
 * RETURN:	- HTStreamHandler, NullOptr if not found.
 *              - outputType, if a stream is returned, outputType 
 *                indicates MIME content-type is generated by this
 *                content handler.
 *              
 * SIDE EFFECTS:
 *	
 * STRATEGY:    All default content handlers are loaded dynamically.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyGetDefaultContentHandler (HTRequestHandle request,
				  HTStringHandle inputType, 
				  HTStringHandle *outputType)
{
    GeodeLoadError loadError;
    GeodeHandle libHandle;
    ClassStruct *classPtr;
    MemHandle block;
    word dataSize;
    char *name, *key, *outType;
    HTStreamHandle handler = NullOptr;


EC( ECCheckHTString(inputType);                                        )

    /* All default content handlers are specified in the ini file */
    PUSHDS;
    SET_DS_LIB_DGROUP;        /* To use "wwwLibrary" and other strings */

    key = (char *) HTStringLock(inputType);
    if (key && !InitFileReadStringBlock("wwwLibrary",
					key,
					&block,
					IFRF_READ_ALL,
					&dataSize) && dataSize) {
	HTStringUnlock(inputType);

	name = (char *) MemLock(block);
	while(ISWHITE(*name)) name++;
	outType = strchr(name, ' ');
	if (outType) {
	    *outType = 0; outType++;
	    while(ISWHITE(*outType)) outType++;
	}


	if (!strcasecmp(name, "HTMIMEClass")) {
	    /* We've got the converter class name */
	    handler = 
		HTObjInstantiateForThread(HTPolicyThread(request),	
					  (ClassStruct *) &HTMIMEClass);

	} else if (!strcasecmp(name, "HTGuessClass")) {
	    /* We've got the converter class name */
	    handler = 
		HTObjInstantiateForThread(HTPolicyThread(request),	
					  (ClassStruct *) &HTGuessClass);

	} else {
	    /* We've got the converter library name */
	    FilePushDir();
	    FileSetStandardPath(SP_SYSTEM);
	    libHandle = GeodeUseLibrary(name, 0, 0, &loadError);
	    FilePopDir();

	    if (libHandle) {
		/* Converter lib must export converter class first */
		classPtr = (ClassStruct *) ProcGetLibraryEntry(libHandle, 0);
		handler = HTObjInstantiateForThread(HTPolicyThread(request), 
						    classPtr);
		if (handler) @call handler::
		    MSG_HT_STREAM_SET_DYNAMICALLY_LOADED(libHandle);
		else
		    GeodeFreeLibrary(libHandle);
	    }
	}
	    
	/* We've got the converter output type */
	if (outType) 
	    *outputType = HTStringFor(outType);
	else
	    *outputType = NULL;
	
	MemFree(block);

	} else
	    HTStringUnlock(inputType);

    POPDS;
    return handler;
}	/* End of HTPolicyGetDefaultContentHandler.	*/




/***********************************************************************
 *		HTPolicyGetClientContentHandler
 ***********************************************************************
 * SYNOPSIS:	Get a content handler from a client's director. The 
 *              should have been registered with the Request Manager
 *              (API HTRegister) and Policy Manager (API 
 *              HTPolicyAddClient). inputType indicates what input data
 *              format of the handler. output is what the handler will
 *              generate.
 * CALLED BY:	Library
 * RETURN:	- HTStreamHandle, a content object inherited from 
 *                HTStreamClass.
 *              - outputType, the content object output format.
 *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/15/96   	Initial Revision
 *
 ***********************************************************************/
HTStreamHandle _far _pascal
HTPolicyGetClientContentHandler (HTRequestHandle request, 
				 HTStringHandle inputType,
				 HTStringHandle *outputType)
{
    HTMemHandle s, htmh = 0;
    HTLibEnv *e;
    HTContentHandler *content;
    HTStreamHandle handler = NullOptr;

EC( ECCheckRequest(request);                                            )
EC( ECCheckHTString(inputType);                                         )

    s = HTSessionLookupRequest(request);

EC( if (!s) EC_ERROR(INVALID_WWW_CLIENT);                               )

    if (s) {
	e = (HTLibEnv *) HTMemLock(s);
	if (e->HTLE_contentCbf) {
EC(         ECCheckRequestNotLocked(request);                           )
	    htmh = ProcCallFixedOrMovable_pascal(request, inputType,
						 e->HTLE_contentCbf);
EC(         ECCheckRequestNotLocked(request);                           )
	}
	HTMemUnlock(s);

    }

    if (htmh) {

EC(     ECCheckHTMemHandle(htmh);                                       )

	content = (HTContentHandler *) HTMemLock(htmh);
	
	*outputType = content->HTCH_outputType;
	handler = content->HTCH_handler;

	HTMemUnlockAndFree(htmh);

EC(     ECCheckOD(handler);                                             )
EC(     ECCheckHTString(*outputType);                                   )

    }
    
    return handler;
}	/* End of HTPolicyGetClientContentHandler.	*/




/***********************************************************************
 *		HTPolicyGetClientContentStreamStack
 ***********************************************************************
 *
 * SYNOPSIS:	Request a stream stack from cleint to handle a content
 *              type. Return NullOptr if client does not provide a 
 *              complete stack that ends with outputType.
 * CALLED BY:	HTPolicyGetClientContentStreamStack.
 * RETURN:	head of the stream stack or NullOptr.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/22/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyGetClientContentStreamStack (HTRequestHandle request, 
				     HTStringHandle inputType,
				     HTStringHandle outputType)
{
    HTStreamHandle stream, head = NullOptr, tail = NullOptr;
    HTStringHandle outputFormat = NULL, inputFormat = inputType;

    do {
	stream = HTPolicyGetClientContentHandler(request, 
						 inputFormat, 
						 &outputFormat);
	if (stream) {
	    @call stream::MSG_HT_STREAM_SET_REQUEST(request);
	    if (!head)
		head = stream;
	    if (tail)
		@call tail::MSG_HT_STREAM_SET_TARGET(stream);
	    tail = stream;
	    inputFormat = outputFormat;
	}

	if (outputFormat == outputType) 
	    break;

    } while (stream);

    if ((outputFormat != outputType) && head) {
	@call head::MSG_HT_STREAM_ABORT(HT_OK);
	return NullOptr;
    }

    return head;
}	/* End of HTPolicyGetClientContentStreamStack.	*/




/***********************************************************************
 *		HTPolicyErrorStream
 ***********************************************************************
 *
 * SYNOPSIS:	Creates an error stream.
 * CALLED BY:	HTPolicyStreamStack
 * RETURN:	HTStreamHandle, NULL currently.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/13/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyErrorStream (HTStringHandle format, HTRequestHandle request)
{
    HTMemHandle s, htmh = 0;
    HTContentHandler *content;
    HTLibEnv *e;
    HTStreamHandle handler = NullOptr;

    s = HTSessionLookupRequest(request);

EC( if (!s) EC_ERROR(INVALID_WWW_CLIENT);                               )

    if (s) {
	e = (HTLibEnv *) HTMemLock(s);
	if (e->HTLE_errorStreamCbf) {
EC(         ECCheckRequestNotLocked(request);                           )
	    htmh = ProcCallFixedOrMovable_pascal(request, format,
						 e->HTLE_errorStreamCbf);
EC(         ECCheckRequestNotLocked(request);                           )
	}
	HTMemUnlock(s);

    }

    if (htmh) {

EC(     ECCheckHTMemHandle(htmh);                                       )

        content = (HTContentHandler *) HTMemLock(htmh);
	handler = content->HTCH_handler;
	HTMemUnlockAndFree(htmh);

EC(     ECCheckOD(handler);                                             )

    }

    return handler;
}	/* End of HTPolicyErrorStream.	*/



/* -----------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * -----------------------------------------------------------------------*/


/***********************************************************************
 *		HTPOLICYADDPROTOCOLHANDLER
 ***********************************************************************
 * SYNOPSIS:	Add a protocol class to a list and bind it to a specific 
 *		access scheme. The protocol library will be loaded by the 
 *              Library to instantiate protocol objects. The protocol class
 *              must be the first exported item (indicated in the gp file).
 *              You need to bind list to a specific request for the Library
 *              to use it. 
 * CALLED BY:	Client.
 * PASS:	list = list to register a protocol.
 *              name = name of access scheme (e.g, "http").
 *              library = library name.
 * RETURN:	HT_OK if registration is accepted, else HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/21/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTPOLICYADDPROTOCOLHANDLER (HTListHandle list, 
			    HTStringHandle name, HTStringHandle library)
{	
    HTProtocol protocol;

EC( ECCheckHTList(list);                                                )
EC( ECCheckHTString(name);                                              )
EC( ECCheckHTString(library);                                           )

    protocol.HTP_dynamicLoad = TRUE;
    protocol.HTP_name = name;
    protocol.HTP_library = library;

    HTListAppend(list, &protocol, sizeof(HTProtocol));

    return HT_OK;
}	/* End of HTPOLICYADDPROTOCOLHANDLER.	*/



/***********************************************************************
 *		HTPolicyGetProtocolHandler
 ***********************************************************************
 * SYNOPSIS:	Search registered protocols to find a suitable access 
 *		method. A new protocol object is created. The protocol
 *		class must have been registered earlier using 
 *		HTPOLICYADDPROTOCOLHANDLER.
 * CALLED BY:	Library.
 * PASS:	request = the request.
 *              list = list to obtain a protocol, NULL to use Library default.
 *              name = access method name, e.g. http.
 * RETURN:	HTStreamHandle = the protocol object. NullOptr if not found.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:	
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/21/96   	Initial Revision
 *
 ***********************************************************************/
HTStreamHandle _far _pascal
HTPolicyGetProtocolHandler (HTRequestHandle request,
			    HTListHandle list, HTStringHandle name)
{
    word count, i, size;
    HTProtocol protocol;
    HTStreamHandle handler = NullOptr;

EC( ECCheckRequest(request);                                           )
EC( ECCheckHTList(list);                                               )
EC( ECCheckHTString(name);                                             )

    if (!name) return NullOptr;

    count = HTListGetCount(list);
    size = sizeof(HTProtocol);

    for (i=0; i<count; i++) {
	HTListGetItem(list, i, &protocol, size);
	
	if (protocol.HTP_name == name) {
	    handler =  HTObjInstantiateForThread(HTPolicyThread(request), 
						 protocol.HTP_class);
	    break;
	}
    }

    if (!handler) {
	/* Use Library default if there is one. */
	handler = HTPolicyGetDefaultProtocolHandler(request, name);
    }

    if (handler)
	@call handler::MSG_HT_STREAM_SET_REQUEST(request);

    return handler;
}	/* End of HTPolicyGetProtocolHandler.	*/



/***********************************************************************
 *		HTPOLICYSTREAMSTACK
 ***********************************************************************
 *
 * SYNOPSIS:	Create a filter stream stack and append to outputStream.
 *              Caveat: Request must not be locked (using MemThreadGrab)
 *              when calling this routine. We may cross over to a client
 *              thread which may lock the request, thus causing a deadlock.
 * CALLED BY:	Client.
 * RETURN:	HTStreamHandle, NULL if not created.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Currently, outputFormat not used.
 *                         guess not used.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/13/96   	Initial Revision
 *
 ***********************************************************************/
HTStreamHandle _far _pascal
HTPOLICYSTREAMSTACK (HTStringHandle inputFormat, 
		     HTStringHandle outputFormat,
		     HTStreamHandle outputStream,
		     HTRequestHandle request,
		     Boolean guess)
{
    HTStreamHandle head, stream, tail;
    HTStringHandle inputType = inputFormat;
    HTStringHandle outputType = NULL;

EC( ECCheckHTString(inputFormat);                                       )
EC( ECCheckHTString(outputFormat);                                      )
EC( ECCheckOD(outputStream);                                            )
EC( ECCheckRequest(request);                                            )

    if (inputFormat == outputFormat)
	if (outputStream) 
	    return outputStream;
	else {
	    return HTPolicyErrorStream(inputFormat, request);
	}

    /* First see if client wants to handle it completely.
     * Once the client provide a handler, we *must* not overlap
     * that with library default content handlers as we will 
     * deadlock since they run in different threads. 
     */
    head = HTPolicyGetClientContentStreamStack(
                    request, 
		    inputType, 
		    NULL);

    if (head) {
	if (outputStream) {
	    @call outputStream::MSG_HT_STREAM_SET_TARGET(head);
	    return outputStream;
	}
	return head; /* Client will handle data completely */
    }

    /* Ok to create library part of the stream stack */
    tail = head;
    do {
	stream = HTPolicyGetDefaultContentHandler(request, 
						  inputType, 
						  &outputType);
	if (stream) {
	    @call stream::MSG_HT_STREAM_SET_REQUEST(request);
	    if (!head)
		head = stream;
	    if (tail)
		@call tail::MSG_HT_STREAM_SET_TARGET(stream);
	    tail = stream;
	    inputType = outputType;
	}

    } while (stream);

    /* 
     * See if client wants to process the outputType.
     */
    stream = HTPolicyGetClientContentStreamStack(
                      request, 
		      inputType, 
		      NULL);

    if (stream) {
	@call tail::MSG_HT_STREAM_SET_TARGET(stream);
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);

    } else if (inputType != NULL) {
	/*
	 * If we don't get outputType NULL, the
	 * client *must* provide a stream stack to handle the outputType 
	 * from the Library. The final outputType from the client must 
	 * be NULL. Otherwise the whole stream is 
	 * aborted. Well...we should prompt the user to save it.
	 */
	if (head)
	    @call head::MSG_HT_STREAM_ABORT(HT_OK);
	/* 
	 * No content handler to display/process data. We might want 
	 * to prompt user if he/she wants to save the file on disk or 
	 * something. To do that, we provide a save-to-file stream and
	 * return that stream.
	 */
	return HTPolicyErrorStream(inputFormat, request);
    }

    /* Link the stream stack we've just created to outputStream */
    if (outputStream) {
	@call outputStream::MSG_HT_STREAM_SET_TARGET(head);
	return outputStream;
    }

    return head;
}	/* End of HTPOLICYSTREAMSTACK.	*/



/***********************************************************************
 *		HTPOLICYCONTENTTYPETOFILEEXT
 ***********************************************************************
 *
 * SYNOPSIS:	Map a content type to file ext.
 * CALLED BY:	Client
 * RETURN:	file extension without the period. E.g., "jpg", "htm",
 *              else NULL.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	11/17/97   	Initial Revision
 *	
 ***********************************************************************/
const char * _pascal
HTPOLICYCONTENTTYPETOFILEEXT (HTStringHandle contentType)
{
    const char *ret = 0;
    PUSHDS;
    SET_DS_LIB_DGROUP;
    if (contentType == HT_CONTENT_TYPE_TEXT_HTML) {
	ret = "htm";
    } else if (contentType == HT_CONTENT_TYPE_IMAGE_GIF) {
	ret = "gif";
    } else if (contentType == HT_CONTENT_TYPE_IMAGE_JPEG) {
	ret = "jpg";
    }
    POPDS;
    return ret;
}	/* End of HTPOLICYCONTENTTYPETOFILEEXT.	*/
