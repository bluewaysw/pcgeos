 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/13/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyErrorStream (void)
{
    return NULL;
}	/* End of HTPolicyErrorStream.	*/



/* -----------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * -----------------------------------------------------------------------*/


/***********************************************************************
 *		HTPOLICYADDPROTOCOLHANDLER
 ***********************************************************************
 * SYNOPSIS:	Add a protocol class to a list and bind it to a specific 
 *		access scheme. The protocol library will be loaded by the 
 *              Library to instantiate protocol objects. The protocol class
 *              must be the first exported item (indicated in the gp file).
 *              You need to bind list to a specific request for the Library
 *              to use it. 
 * CALLED BY:	Client.
 * PASS:	list = list to register a protocol.
 *              name = name of access scheme (e.g, "http").
 *              library = library name.
 * RETURN:	HT_OK if registration is accepted, else HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/21/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTPOLICYADDPROTOCOLHANDLER (HTListHandle list, 
			    HTStringHandle name, HTStringHandle library)
{	
    HTProtocol protocol;

EC( ECCheckHTList(list);                                                )
EC( ECCheckHTString(name);                                              )
EC( ECCheckHTString(library);                                           )

    protocol.HTP_dynamicLoad = TRUE;
    protocol.HTP_name = name;
    protocol.HTP_library = library;

    HTListAppend(list, &protocol, sizeof(HTProtocol));

    return HT_OK;
}	/* End of HTPOLICYADDPROTOCOLHANDLER.	*/



/***********************************************************************
 *		HTPolicySetThread
 ***********************************************************************
 * SYNOPSIS:	Set the thread that runs all objects created by the 
 *		policy manager.
 *      
 * CALLED BY:	Library.
 * RETURN:	Nothing
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/ 3/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTPolicySetThread (ThreadHandle thread)
{
EC( ECCheckThreadHandle(thread);                                        )

    PUSHDS;
    SET_DS_LIB_DGROUP;

    ThreadPSem(policySynchSem);
    policyThread = thread;
    ThreadVSem(policySynchSem);

    POPDS;
}	/* End of HTPolicySetThread.	*/




/***********************************************************************
 *		HTPolicyLibraryEntry
 ***********************************************************************
 * SYNOPSIS:	Delete a client policy manager from the Library policy
 *              manager when a client detaches from the Library.
 *              Create a default protocol list.
 * CALLED BY:	HTCoreLibraryEntry
 * RETURN:	Must return 0 to indicate ok to Geos.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/17/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTPolicyLibraryEntry (LibraryCallType ty, GeodeHandle client)
{
    if (ty == LCT_ATTACH) {
	/* Initialize policy stuff */
	PUSHDS;
	SET_DS_LIB_DGROUP;
	policyClientList = HTListNew();

	policySynchSem = ThreadAllocSem(1);
	HandleModifyOwner(policySynchSem, GeodeGetCodeProcessHandle());

	POPDS;

    } else if (ty == LCT_CLIENT_EXIT) 
	HTPolicyDeleteClient(client);

    else if (ty == LCT_DETACH) {
	PUSHDS;
	SET_DS_LIB_DGROUP;
	
	HTListDelete(policyClientList);
	policyClientList = NULL;	

	ThreadFreeSem(policySynchSem);
	policySynchSem = NULL;

	policyThread = NULL;
	POPDS;
    }

    return 0;
}	/* End of HTPolicyLibraryEntry.	*/



/***********************************************************************
 *		HTPOLICYADDCLIENT
 ***********************************************************************
 * SYNOPSIS:	Register a client-specific director to the policy manager.
 *              The director will be called by the Library when it needs
 *              a content handler or presenter. If your director does not
 *              provide a content handler when requested, the Library uses
 *              its default (unless there is no default). However, your
 *              director must provide a presenter if you want to display 
 *              data. In the case where no handler (content or presenter)
 *              is found, the Library will prompt the user to save it.
 * CALLED BY:	Client.
 * RETURN:	HT_OK if ok, or HT_ERROR if cannot add client.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/15/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTPOLICYADDCLIENT (GeodeHandle clientHandle, 
		   HTPolicyContentCallback contentCbf)
{
    HTPolicyClient policyClient;

EC( ECCheckGeodeHandle(clientHandle);                                   )
EC(   if (!contentCbf)                                                  )
EC(      EC_ERROR(CONTENT_CALLBACK_NOT_PROVIDED);                       )

    PUSHDS;
    SET_DS_LIB_DGROUP;

    ThreadPSem(policySynchSem);

    policyClient.HTPC_clientHandle = clientHandle;
    policyClient.HTPC_contentCbf = contentCbf;

    HTListAppend(policyClientList, (void *)&policyClient, 
		 sizeof(HTPolicyClient));
    
    ThreadVSem(policySynchSem);

    POPDS;
    return HT_OK;
}	/* End of HTPOLICYADDCLIENT.	*/



/***********************************************************************
 *		HTPOLICYDELETECLIENT
 ***********************************************************************
 * SYNOPSIS:	Remove a client from the policy manager. Should be called
 *              when a client exits. This is usually called by the 
 *              Library entry point when it receives LCT_DETACH of a 
 *              client.
 * CALLED BY:	Client and Library.
 * RETURN:	HT_OK if ok, or HT_ERROR if client not found.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/15/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTPOLICYDELETECLIENT (GeodeHandle clientHandle)
{
    word count, i, size;
    HTPolicyClient policyClient;
    int index = -1;

EC( ECCheckGeodeHandle(clientHandle);                                  )

    PUSHDS;
    SET_DS_LIB_DGROUP;

    ThreadPSem(policySynchSem);

    if (policyClientList != NULL) {
	count = HTListGetCount(policyClientList);
	size = sizeof(HTPolicyClient);
	for (i=0; i<count; i++) {
	    HTListGetItem(policyClientList, i, (void *)&policyClient, size);
	    if (policyClient.HTPC_clientHandle == clientHandle) {
		index = i;
		break;
	    }
	}
    }

    if (index != -1) 
	HTListRemoveItem(policyClientList, index, 
			 (void *)&policyClient, size);

    ThreadVSem(policySynchSem);
    POPDS;
    return HT_OK;
}	/* End of HTPOLICYDELETECLIENT.	*/




/***********************************************************************
 *		HTPolicyGetProtocolHandler
 ***********************************************************************
 * SYNOPSIS:	Search registered protocols to find a suitable access 
 *		method. A new protocol object is created. The protocol
 *		class must have been registered earlier using 
 *		HTPOLICYADDPROTOCOLHANDLER.
 * CALLED BY:	Library.
 * PASS:	request
 *              list = list to obtain a protocol.
 *              name = access method name, e.g. http.
 *		request = the request.
 * RETURN:	HTStreamHandle = the protocol object. NullOptr if not found.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:	
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/21/96   	Initial Revision
 *
 ***********************************************************************/
HTStreamHandle _far _pascal
HTPolicyGetProtocolHandler (HTRequestHandle request,
			    HTListHandle list, HTStringHandle name)
{
    word count, i, size;
    HTProtocol protocol;
    HTStreamHandle handler = NullOptr;

EC( ECCheckRequest(request);                                           )
EC( ECCheckHTList(list);                                               )
EC( ECCheckHTString(name);                                             )

    if (!name) return NullOptr;

    count = HTListGetCount(list);
    size = sizeof(HTProtocol);

    /* policyThread lives in our dgroup. */
    PUSHDS;
    SET_DS_LIB_DGROUP;

    for (i=0; i<count; i++) {
	HTListGetItem(list, i, &protocol, size);

	if (protocol.HTP_name == name) {
	    if (protocol.HTP_dynamicLoad) {
		/*
		 * Registered by HTPOLICYADDPROTOCOLHANDLER: HTP_library holds
		 * the name of the protocol library to load (HTP_class is
		 * not set in this case).
		 */
		char *libName = (char *) HTStringLock(protocol.HTP_library);
		if (libName) {
		    handler = HTPolicyInstantiateFromLibrary(libName);
		}
		HTStringUnlock(protocol.HTP_library);
	    } else {
		handler = ObjInstantiateForThread(policyThread,
						  protocol.HTP_class);
	    }
	    break;
	}
    }

    if (!handler) {
	/* Use Library default if there is one. */
	handler = HTPolicyGetDefaultProtocolHandler(name);
    }

    POPDS;

    if (handler)
	@call handler::MSG_HT_STREAM_SET_REQUEST(request);

    return handler;
}	/* End of HTPolicyGetProtocolHandler.	*/



/***********************************************************************
 *		HTPOLICYSTREAMSTACK
 ***********************************************************************
 *
 * SYNOPSIS:	Create a filter stream stack.
 * CALLED BY:	Client.
 * RETURN:	HTStreamHandle, NULL if not created.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Currently, outputFormat not used.
 *                         guess not used.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/13/96   	Initial Revision
 *
 ***********************************************************************/
HTStreamHandle _far _pascal
HTPOLICYSTREAMSTACK (HTStringHandle inputFormat, 
		     HTStringHandle outputFormat,
		     HTStreamHandle outputStream,
		     HTRequestHandle request,
		     Boolean guess)
{
    HTStreamHandle head, stream, tail;
    HTStringHandle inputType = inputFormat;
    HTStringHandle outputType = NULL;

EC( ECCheckHTString(inputFormat);                                       )
EC( ECCheckHTString(outputFormat);                                      )
EC( ECCheckOD(outputStream);                                            )
EC( ECCheckRequest(request);                                            )

    if (inputFormat == outputFormat)
	return outputStream ? outputStream : HTPolicyErrorStream();

    /* First see if client wants to handle it completely.
     * Once the client provide a handler, we *must* not overlap
     * that with library default content handlers as we will 
     * deadlock since they run in different threads. 
     */
    PUSHDS;
    SET_DS_LIB_DGROUP;   

    head = HTPolicyGetClientContentStreamStack(
                    request, 
		    inputType, 
		    NULL);

    if (head) {
	POPDS;
	if (outputStream) {
	    @call outputStream::MSG_HT_STREAM_SET_TARGET(head);
	    return outputStream;
	}
	return head; /* Client will handle data completely */
    }

    /* Ok to create library part of the stream stack */
    tail = head;
    do {
	stream = HTPolicyGetDefaultContentHandler(inputType, 
						  &outputType);
	if (stream) {
	    @call stream::MSG_HT_STREAM_SET_REQUEST(request);
	    if (!head)
		head = stream;
	    if (tail)
		@call tail::MSG_HT_STREAM_SET_TARGET(stream);
	    tail = stream;
	    inputType = outputType;
	}

    } while (stream);

    /* 
     * See if client wants to process the outputType.
     */
    stream = HTPolicyGetClientContentStreamStack(
                      request, 
		      inputType, 
		      NULL);

    if (stream) {
	@call tail::MSG_HT_STREAM_SET_TARGET(stream);
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);

    } else if (inputType != NULL) {
	/*
	 * If we don't get outputType NULL, the
	 * client *must* provide a stream stack to handle the outputType 
	 * from the Library. The final outputType from the client must 
	 * be NULL. Otherwise the whole stream is 
	 * aborted. Well...we should prompt the user to save it.
	 */
	if (head)
	    @call head::MSG_HT_STREAM_ABORT();
	/* 
	 * No content handler to display/process data. We might want 
	 * to prompt user if he/she wants to save the file on disk or 
	 * something. To do that, we provide a save-to-file stream and
	 * return that stream.
	 */
	POPDS;
	return outputStream;
    }

    POPDS;

    /* Link the stream stack we've just created to outputStream */
    if (outputStream) {
	@call outputStream::MSG_HT_STREAM_SET_TARGET(head);
	return outputStream;
    }

    return head;
}	/* End of HTPOLICYSTREAMSTACK.	*/
