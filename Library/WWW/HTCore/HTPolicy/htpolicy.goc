/* ----------------------------------------------------------------------
 * 		PRIVATE DATA
 * ----------------------------------------------------------------------*/

/*
 * Library won't compile unless there is a dgroup, this dummy does the job! :)
 */
byte htPolicyDummy;

/* 
 * The thread for running all protocol objects.
 */
static ThreadHandle policyThread = NULL;
/* 
 * List of registered client policy managers.
 */
static HTListHandle policyClientList = NULL;
/*
 * For synchronous access to policyClientList.
 */
static SemaphoreHandle policySynchSem = NULL;

/* --------------------------------------------------------------------------
 * 		PRIVATE DATATYPES
 * --------------------------------------------------------------------------*/

/*
 * Structure for maintaining registered protocols.
 * Here comes Geos intricacy. If dynamicLoad is TRUE, then the first 
 * export in the "gp" file must be the protocol class. If dynamicLoad is
 * FALSE, then fileName is no use, instead we need the class name.
 */
typedef struct {
    Boolean HTP_dynamicLoad;           /* TRUE if to be dynamically loaded */
    HTStringHandle HTP_name;           /* e.g., "http" */
    HTStringHandle HTP_library;        /* e.g., "WWW HTTP Library Protocol */
    ClassStruct _far * HTP_class;      /* e.g., HTTPClass */
} HTProtocol;

/*
 * Client policy manager. 
 */
typedef struct {
    GeodeHandle HTPC_clientHandle;
    HTPolicyContentCallback HTPC_contentCbf;
} HTPolicyClient;



/* --------------------------------------------------------------------------
 * 		PRIVATE FUNCTIONS
 * --------------------------------------------------------------------------*/



/***********************************************************************
 *		HTPolicyInstantiateFromLibrary
 ***********************************************************************
 *
 * SYNOPSIS:	Load a protocol/converter library by file name and create
 *		an object of the class it exports first.
 * CALLED BY:	HTPolicyGetDefaultProtocolHandler, HTPolicyGetProtocolHandler
 * PASS:	name = library file name (in SP_SYSTEM), leading white
 *		       space is skipped.
 * RETURN:	HTStreamHandle, NullOptr if the library could not be loaded
 *		or the object could not be created.
 * SIDE EFFECTS:The library stays loaded until the stream object frees
 *		it (MSG_HT_STREAM_SET_DYNAMICALLY_LOADED).
 *		Caller must have set ds to the library dgroup.
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyInstantiateFromLibrary (char *name)
{
    GeodeLoadError loadError;
    GeodeHandle libHandle;
    ClassStruct *classPtr;
    HTStreamHandle handler = NullOptr;

    while(isspace(*name)) name++;

    FilePushDir();
    FileSetStandardPath(SP_SYSTEM);
    libHandle = GeodeUseLibrary(name, 0, 0, &loadError);
    FilePopDir();

    if (libHandle) {
	/* Protocol lib must export converter class first */
	classPtr = (ClassStruct *) ProcGetLibraryEntry(libHandle, 0);
	handler = ObjInstantiateForThread(policyThread, classPtr);
	if (handler) {
	    @call handler::MSG_HT_STREAM_SET_DYNAMICALLY_LOADED(libHandle);
	} else {
	    GeodeFreeLibrary(libHandle);
	}
    }

    return handler;
}	/* End of HTPolicyInstantiateFromLibrary.	*/



/***********************************************************************
 *		HTPolicyGetDefaultProtocolHandler
 ***********************************************************************
 *
 * SYNOPSIS:	Create a Library default protocol handler if one exists.
 * CALLED BY:	HTPolicyGetProtocolHandler
 * RETURN:	HTStreamHandle, a protocol handler if found, else 
 *              NUllOptr.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    All default protocol Libraries are loaded dynamically.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/ 9/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyGetDefaultProtocolHandler (HTStringHandle protocol)
{
    MemHandle block;
    word dataSize;
    char *key;
    HTStreamHandle handler = NullOptr;

EC( ECCheckHTString(protocol);                                        )

    /* All default content handlers are specified in the ini file */
    key = (char *) HTStringLock(protocol);
    if (key && !InitFileReadStringBlock("wwwLibrary",
					key,
					&block,
					IFRF_READ_ALL,
					&dataSize) && dataSize) {

	/* We've got the protocol library name */
	handler = HTPolicyInstantiateFromLibrary((char *) MemLock(block));

	MemFree(block);
    }

    HTStringUnlock(protocol);

    return handler;
}	/* End of HTPolicyGetDefaultProtocolHandler.	*/



/***********************************************************************
 *		HTPolicyGetDefaultContentHandler
 ***********************************************************************
 *
 * SYNOPSIS:	Create a Library default content handler if one exists.
 * CALLED BY:	HTPolicyGetContentHandler.
 * RETURN:	- HTStreamHandler, NullOptr if not found.
 *              - outputType, if a stream is returned, outputType 
 *                indicates MIME content-type is generated by this
 *                content handler.
 *              
 * SIDE EFFECTS:
 *	
 * STRATEGY:    All default content handlers are loaded dynamically.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyGetDefaultContentHandler (HTStringHandle inputType, 
				  HTStringHandle *outputType)
{
    GeodeLoadError loadError;
    GeodeHandle libHandle;
    ClassStruct *classPtr;
    MemHandle block;
    word dataSize;
    char *name, *key, *outType;
    HTStreamHandle handler = NullOptr;


EC( ECCheckHTString(inputType);                                        )

    /* All default content handlers are specified in the ini file */
    key = (char *) HTStringLock(inputType);
    if (key && !InitFileReadStringBlock("wwwLibrary",
					key,
					&block,
					IFRF_READ_ALL,
					&dataSize) && dataSize) {
	HTStringUnlock(inputType);

	name = (char *) MemLock(block);
	while(isspace(*name)) name++;
	outType = strchr(name, ' ');
	if (outType) {
	    *outType = 0; outType++;
	    while(isspace(*outType)) outType++;
	}


	if (!strcasecmp(name, "HTMIMEClass")) {
	    /* We've got the converter class name */
	    handler = 
		ObjInstantiateForThread(policyThread,	
					(ClassStruct *) &HTMIMEClass);

	} else if (!strcasecmp(name, "HTGuessClass")) {
	    /* We've got the converter class name */
	    handler = 
		ObjInstantiateForThread(policyThread,	
					(ClassStruct *) &HTGuessClass);

	} else {
	    /* We've got the converter library name */
	    FilePushDir();
	    FileSetStandardPath(SP_SYSTEM);
	    libHandle = GeodeUseLibrary(name, 0, 0, &loadError);
	    FilePopDir();

	    if (libHandle) {
		/* Converter lib must export converter class first */
		classPtr = (ClassStruct *) ProcGetLibraryEntry(libHandle, 0);
		handler = ObjInstantiateForThread(policyThread, classPtr);
		if (handler) @call handler::
		    MSG_HT_STREAM_SET_DYNAMICALLY_LOADED(libHandle);
	    }
	}
	    
	/* We've got the converter output type */
	if (outType) 
	    *outputType = HTStringFor(outType);
	else
	    *outputType = NULL;
	
	MemFree(block);

	} else
	    HTStringUnlock(inputType);

    return handler;
}	/* End of HTPolicyGetDefaultContentHandler.	*/




/***********************************************************************
 *		HTPolicyGetClientContentHandler
 ***********************************************************************
 * SYNOPSIS:	Get a content handler from a client's director. The 
 *              should have been registered with the Request Manager
 *              (API HTRegister) and Policy Manager (API 
 *              HTPolicyAddClient). inputType indicates what input data
 *              format of the handler. output is what the handler will
 *              generate.
 * CALLED BY:	Library
 * RETURN:	- HTStreamHandle, a content object inherited from 
 *                HTStreamClass.
 *              - outputType, the content object output format.
 *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/15/96   	Initial Revision
 *
 ***********************************************************************/
HTStreamHandle _far _pascal
HTPolicyGetClientContentHandler (HTRequestHandle request, 
				 HTStringHandle inputType,
				 HTStringHandle *outputType)
{
    word count, i, size;
    HTPolicyClient policyClient;
    GeodeHandle clientHandle;
    HTRequest *rptr;
    Boolean found = FALSE;
    HTMemHandle htmh;
    HTContentHandler *content;
    HTStreamHandle handler = NullOptr;

EC( ECCheckRequest(request);                                            )
EC( ECCheckHTString(inputType);                                         )

    rptr = (HTRequest *) MemThreadGrab(request);
    clientHandle = rptr->HTR_clientGeodeHandle;
    MemThreadRelease(request);

EC( ECCheckGeodeHandle(clientHandle);                                   )

    ThreadPSem(policySynchSem);

    if (policyClientList != NULL) {
	count = HTListGetCount(policyClientList);
	size = sizeof(HTPolicyClient);
	for (i=0; i<count; i++) {
	    HTListGetItem(policyClientList, i, (void *)&policyClient, size);
	    if (policyClient.HTPC_clientHandle == clientHandle) {
		found = TRUE;
		break;
	    }
	}
    }

    ThreadVSem(policySynchSem);

EC( if (!found)                                                         )
EC(    EC_ERROR(INVALID_POLICY_CLIENT);                                 )

    if (found)
	htmh = ProcCallFixedOrMovable_pascal(request, inputType,
			policyClient.HTPC_contentCbf);
    else 
	htmh = NullOptr;

    if (htmh) {

EC(     ECCheckHTMemHandle(htmh);                                       )

	content = (HTContentHandler *) HTMemLock(htmh);
	
	*outputType = content->HTCH_outputType;
	handler = content->HTCH_handler;

	HTMemUnlockAndFree(htmh);

EC(     ECCheckOD(handler);                                             )
EC(     ECCheckHTString(*outputType);                                   )

    }
    
    return handler;
}	/* End of HTPolicyGetClientContentHandler.	*/






/***********************************************************************
 *		HTPolicyGetClientContentStreamStack
 ***********************************************************************
 *
 * SYNOPSIS:	Request a stream stack from cleint to handle a content
 *              type. Return NullOptr if client does not provide a 
 *              complete stack that ends with outputType.
 * CALLED BY:	HTPolicyGetClientContentStreamStack.
 * RETURN:	head of the stream stack or NullOptr.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/22/96   	Initial Revision
 *
 ***********************************************************************/
static HTStreamHandle _pascal
HTPolicyGetClientContentStreamStack (HTRequestHandle request, 
				     HTStringHandle inputType,
				     HTStringHandle outputType)
{
    HTStreamHandle stream, head = NullOptr, tail = NullOptr;
    HTStringHandle outputFormat = NULL, inputFormat = inputType;

    do {
	stream = HTPolicyGetClientContentHandler(request, 
						 inputFormat, 
						 &outputFormat);
	if (stream) {
	    @call stream::MSG_HT_STREAM_SET_REQUEST(request);
	    if (!head)
		head = stream;
	    if (tail)
		@call tail::MSG_HT_STREAM_SET_TARGET(stream);
	    tail = stream;
	    inputFormat = outputFormat;
	}

	if (outputFormat == outputType) 
	    break;

    } while (stream);

    if ((outputFormat != outputType) && head) {
	@call head::MSG_HT_STREAM_ABORT();
	return NullOptr;
    }

    return head;
}	/* End of HTPolicyGetClientContentStreamStack.	*/




/***********************************************************************
 *		HTPolicyErrorStream
 ***********************************************************************
 *
 * SYNOPSIS:	Creates an error stream.
 * CALLED BY:	
 * RETURN:	HTStreamHandle, NULL currently.
