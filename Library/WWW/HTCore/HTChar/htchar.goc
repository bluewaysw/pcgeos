@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htchar.goh>
@include <WWW/HTCore/htobj.goh>
@include "htfatals.goh"

/***********************************************************************
 *		HTCHARNEW
 ***********************************************************************
 *
 * SYNOPSIS:	Create a char converter stream.
 * CALLED BY:	Client.
 * RETURN:	HTStreamHandle or NULL.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
HTStreamHandle _far _pascal
HTCHARNEW (HTRequestHandle request, HTStreamHandle target, 
		   CharConverterCallback cbf)
{
    HTStreamHandle stream;

    PUSHDS;
    SET_DS_LIB_DGROUP;       /* To use HTCharClass */
    stream = HTObjInstantiateForThread(0, &HTCharClass);
    POPDS;
    if (!stream) return 0;
	@call stream::MSG_HT_STREAM_SET_REQUEST(request);
	@call stream::MSG_HT_STREAM_SET_TARGET(target);
    @call stream::MSG_HTCHAR_SET_CALLBACK(cbf);
    return stream;
}	/* End of HTFWRITENEW.	*/



/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTCharClass;

/***********************************************************************
		Message Handlers
***********************************************************************/


/***********************************************************************
 *		MSG_HTCHAR_SET_CALLBACK for HTCharClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Set the callback function for converting chars.
 * PARAMETERS:	    void (CharConverterCallback cbf)
 * SIDE EFFECTS:    None
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	6/ 9/97   	Initial Revision
 *	
 ***********************************************************************/
@method HTCharClass, MSG_HTCHAR_SET_CALLBACK
{
     @self->HTLTI_cbf = cbf;
}	/* End of MSG_HTCHAR_SET_CALLBACK.	*/



/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTCharClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Convert data for target.
 * PARAMETERS:	    int (const byte *data, word len)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTCharClass, MSG_HT_STREAM_PUT_BLOCK
{
    if (!len || !data) return HT_OK;

	ProcCallFixedOrMovable_pascal((char *)data, len, @self->HTLTI_cbf);

	return @call @self->HTSI_target::MSG_HT_STREAM_PUT_BLOCK(data, len);
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/

