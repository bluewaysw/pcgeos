/***********************************************************************
 *		HTUTILCHANGECLASS
 ***********************************************************************
 * SYNOPSIS:	Change the class of an object in preparation for removing
 *              a reference to a geode that may cause the object's current
 *              class to go away.
 * CALLED BY:	Client.
 * PASS:        obj = object to change.
 *              class = ancester class to change to
 * RETURN:	Nothing
 * SIDE EFFECTS:object may shrink as data for the subclass are deleted.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/11/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTUTILCHANGECLASS (optr obj, ClassStruct _far *class)
{
    word masterOffset, newSize, oldSize;
    MetaBase *mptr;

EC( ObjLockObjBlock(OptrToHandle(obj));                                 )
EC( if (!ObjIsObjectInClass(obj, class))                                )
EC(    EC_ERROR(CANNOT_CHANGE_TO_NON_ANCESTOR_CLASS);                   )
EC( MemUnlock(OptrToHandle(obj));                                       )

    newSize = class->Class_instanceSize;
    masterOffset = class->Class_masterOffset;
    
    ObjLockObjBlock(OptrToHandle(obj));

    mptr = (MetaBase *) LMemDeref(obj);
    oldSize = mptr->MB_class->Class_instanceSize;

    if (masterOffset)
	ObjResizeMaster(obj, masterOffset, newSize);
    else 
	LMemDeleteAt(obj, newSize, oldSize-newSize);

    mptr = (MetaBase *) LMemDeref(obj);
    mptr->MB_class = class;

    MemUnlock(OptrToHandle(obj));
}	/* End of HTUTILCHANGECLASS.	*/


/* --------------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTUTILCHANGECLASSTOHTSTREAMCLASS
 ***********************************************************************
 *
 * SYNOPSIS:	Change the class of a stream object to HTStreamClass in 
 *              preparation for the geode of the original class reference
 *              to go away, which could leave us with no valid to execute.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/13/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTUTILCHANGECLASSTOHTSTREAMCLASS (optr obj)
{
    PUSHDS;
    SET_DS_LIB_DGROUP;
    HTUtilChangeClass(obj, &HTStreamClass);
    POPDS;
}	/* End of HTUTILCHANGECLASSTOHTSTREAMCLASS.	*/



/***********************************************************************
		Default Message Handlers
***********************************************************************/

/***********************************************************************
		HTStreamClass
***********************************************************************/



/***********************************************************************
 *		MSG_HT_STREAM_SET_REQUEST for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Set request to be serviced by a stream.
 * PARAMETERS:	    void (HTRequestHandle request)
 * SIDE EFFECTS:    Nothing
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/15/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_REQUEST
{

EC( ECCheckRequest(request);                                            )

    @self->HTSI_request = request;
}	/* End of MSG_HT_STREAM_SET_REQUEST.	*/



/***********************************************************************
 *		MSG_HT_STREAM_GET_REQUEST for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Get the request being serviced by a stream.
 * PARAMETERS:      HTRequestHandle (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/24/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_GET_REQUEST
{
    return @self->HTSI_request;
}	/* End of MSG_HT_STREAM_GET_REQUEST.	*/




/***********************************************************************
 *		MSG_HT_STREAM_SET_TARGET for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Set the target for pushing data.
 * PARAMETERS:	    void (optr target)
 * SIDE EFFECTS:    None
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_TARGET
{

EC( ECCheckOD(target);                                                  )

    @self->HTSI_target = target;
}	/* End of MSG_HT_STREAM_SET_TARGET.	*/



/***********************************************************************
 *		MSG_HT_STREAM_GET_TARGET for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Get the target for pushing data.
 * PARAMETERS:	    optr (void)
 * SIDE EFFECTS:    None
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/16/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_GET_TARGET
{
    return (@self->HTSI_target);
}	/* End of MSG_HT_STREAM_GET_TARGET.	*/



/***********************************************************************
 *		MSG_HT_STREAM_SET_TRANSPARENT for HTStreamClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Make a stream transparent.
 * PARAMETERS:	    void (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/28/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_TRANSPARENT
{
    @self->HTSI_transparent = TRUE;
}	/* End of MSG_HT_STREAM_SET_TRANSPARENT.	*/




/***********************************************************************
 *		MSG_HT_STREAM_IS_TRANSPARENT for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Check if a stream is transparent. Transparent
 *                  streams do nothing with data passed in via
 *                  MSG_HT_STREAM_PUT_BLOCK except passing it to 
 *                  their targets.
 * PARAMETERS:	    byte (void) 
 *                  return TRUE if stream is transparent, else FALSE.
 * SIDE EFFECTS:    
 *
 * STRATEGY:        
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/ 9/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_IS_TRANSPARENT
{
    return @self->HTSI_transparent;
}	/* End of MSG_HT_STREAM_IS_TRANSPARENT.	*/




/***********************************************************************
 *		MSG_HT_STREAM_SET_DYNAMICALLY_LOADED for HTStreamClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Indicate to the stream it has been loaded 
 *                  dyncamically.
 * PARAMETERS:	    void (Geodehandle libraryHandle)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/26/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_SET_DYNAMICALLY_LOADED
{

EC ( ECCheckLibraryHandle(libraryHandle);                               )

    @self->HTSI_libraryHandle = libraryHandle;

}	/* End of MSG_HT_STREAM_SET_DYNAMICALLY_LOADED.	*/




/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Flush any buffered data down the target stream.
 *                  The default is to just return HT_OK by assuming that
 *                  the stream object is not buffering data.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/19/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_FLUSH
{
    if (@self->HTSI_target) 
	return @call @self->HTSI_target::MSG_HT_STREAM_FLUSH();

    return HT_OK;
}	/* End of MSG_HT_STREAM_FLUSH.	*/



/***********************************************************************
 *		MSG_HT_STREAM_ABORT for HTStreamClass
 ***********************************************************************
 * SYNOPSIS:	    Abort the current stream and the target stream 
 * 		    object.
 * PARAMETERS:	    int (void)
 * SIDE EFFECTS:    Nothing.
 *
 * STRATEGY:	    Flush all input to target, abort the target, and
 *                  then free oself. For this to work, a stream object
 *                  must not be the target of multiple stream objects.
 *                  If it is, it must be able to handle multiple abort
 *                  messages. Must use @call as we must abort the 
 *                  stream pipes before returning. The client depends
 *                  on it as the request may be changed/deleted.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/ 3/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_ABORT
{
    @call oself::MSG_HT_STREAM_FLUSH();

    if (@self->HTSI_target != NullOptr) {
	@call @self->HTSI_target::MSG_HT_STREAM_ABORT();
	@self->HTSI_target = NullOptr;
    }

    /*
     * Now we are safe to unload the Library of this stream.
     */
    if (@self->HTSI_libraryHandle)
	@send,forceQueue oself::
	    MSG_HT_STREAM_UNLOAD_LIBRARY(@self->HTSI_libraryHandle);

    /*
     * Since the object class may go away before we get a chance
     * to execute the following forcequeued message, we need to 
     * change it's class pointer to its base class.
     */
    HTUtilChangeClass(oself, &HTStreamClass);

    /* Finally free the object */
    ObjIncInUseCount(OptrToHandle(oself));
    @send, forceQueue oself::MSG_META_FINAL_OBJ_FREE();
    return HT_OK;
}	/* End of MSG_HT_STREAM_ABORT.	*/



/***********************************************************************
 *		MSG_HT_STREAM_UNLOAD_LIBRARY for HTStreamClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Unload the Library associated with this stream.
 * PARAMETERS:	    void (GeodeHandle libraryHandle) 
 *                      - must pass libraryHandle, can't use 
 *                         @self->HTSI_libraryHandle as this is 
 *                         invalidated by MSG_HT_STREAM_ABORT when it
 *                         calls HTUtilChangeClass.
 * SIDE EFFECTS:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	9/27/96   	Initial Revision
 *
 ***********************************************************************/
@method HTStreamClass, MSG_HT_STREAM_UNLOAD_LIBRARY
{
    GeodeFreeLibrary(libraryHandle);
}	/* End of MSG_HT_STREAM_UNLOAD_LIBRARY.	*/



