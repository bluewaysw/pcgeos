/* No default methods for HTProtocolClass */



/***********************************************************************
 *		HTSTREAMGROWINPUTSTREAMSTACK
 ***********************************************************************
 * SYNOPSIS:	Append a stream to the head of the input stream stack 
 *              of a request (an input stream stack is used to pump
 *              data from the client to the server). Head is the first
 *              stream object facing the client (or furthest away from
 *              the server).
 *              
 * CALLED BY:	Client.
 * RETURN:	HT_OK if added, else HT_NO.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:    Grow the input stream stack just like appending to 
 *              a single linked list; the head of the list is maintained
 *              by HTRequest.HTR_inputStream.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/17/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTSTREAMGROWINPUTSTREAMSTACK (HTRequestHandle request, 
			      HTStreamHandle stream)
{
    HTRequest *rptr;
    
EC( ECCheckRequest(request);                                            )
EC( ECCheckOD(stream);                                                  )

    rptr = (HTRequest *) MemThreadGrab(request);

    if (rptr->HTR_inputStream)
	@call stream::MSG_HT_STREAM_SET_TARGET(rptr->HTR_inputStream);
    rptr->HTR_inputStream = stream; /* Point to the head of the 
				       input stream */

    MemThreadRelease(request);

    return HT_OK;
}	/* End of HTSTREAMGROWINPUTSTREAMSTACK.	*/




/***********************************************************************
 *		HTSTREAMSHRINKSTREAMSTACK
 ***********************************************************************
 * SYNOPSIS:	Remove a stream object from a stream stack.
 *              Does not flush data down the stream stack before 
 *              aborting the stream object. This is done by severing 
 *              the target of the stream object to abort. And then call
 *              the stream object to abort using MSG_HT_STREAM_ABORT.
 *              The concept of stream stacks prevents us from removing
 *              the first and last stream objects.
 * CALLED BY:	Client.
 * RETURN:	HT_OK if ok, else HT_ERROR.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Head points to the first stream object. We traverse the
 *              stream stack via each stream's target. 
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/12/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTSTREAMSHRINKSTREAMSTACK (HTStreamHandle *head, HTStreamHandle *tail,
			   HTStreamHandle stream)
{

    HTStreamHandle next, prev, current;

EC( ECCheckStream(*head);                                               )
EC( ECCheckStream(stream);                                              )
EC( ECCheckOD(*tail);                                                   )

#ifdef ERROR_CHECK
    if (*tail == stream) 
	EC_ERROR(CANNOT_REMOVE_FIRST_STREAM_OBJECT_IN_STREAM_STACK);
    if (*head == stream)
	EC_ERROR(CANNOT_REMOVE_LAST_STREAM_OBJECT_IN_STREAM_STACK);
#endif

    prev = NullOptr;
    current = *head;
    if (current)
	next = @call current::MSG_HT_STREAM_GET_TARGET();
    else 
	next = NullOptr;

    /* Traverse the stream stack */
    while (current) {

	if (current == stream) {
	    /* Found the stream to remove */

	    /* 
	     * We have EC code that prevents these two statements
	     * from being executed...because you simply cannot remove
	     * the first and last stream objects in a stream pipe!
	     * as you would have no stream to input data and no
	     * stream to output data!
	     */
	    if (current == *head) *head = next;

	    if (current == *tail) *tail = prev;

	    /* Remove current from the stream stack. */
	    if (prev) @call prev::MSG_HT_STREAM_SET_TARGET(next);
	    @call current::MSG_HT_STREAM_SET_TARGET(NullOptr);
	    @call current::MSG_HT_STREAM_ABORT();

	    return HT_OK;  /* The only place to return HT_OK */
	}

	/* Move to the next stream object */
	prev = current;
	current = next;
	if (current)
	    next = @call current::MSG_HT_STREAM_GET_TARGET();
	else 
	    next = NullOptr;
    }

    return HT_NO;  /* Stream not found! */
}	/* End of HTSTREAMSHRINKSTREAMSTACK.	*/




/***********************************************************************
 *		ECCHECKSTREAM
 ***********************************************************************
 * SYNOPSIS:	Check for a valid stream object. Object needs not be 
 *              locked.
 * CALLED BY:	Client.
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/21/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
ECCHECKSTREAM (HTStreamHandle stream)
{
#if ERROR_CHECK
    MemHandle mh = OptrToHandle(stream);
    ObjLockObjBlock(mh);
    ECCheckObject(stream);  /* Does not lock the object. */
    MemUnlock(mh);
#endif
}	/* End of ECCHECKSTREAM.	*/

