/***********************************************************************
 *		HTANCHORSETDOCUMENT
 ***********************************************************************
 *
 * SYNOPSIS:	Bind a document to a anchor. Depending the HTTP method of 
 *              request which this anchor is bound to, the document will
 *              interpreted accordingly. Document will be deleted after 
 *              it has been sent to the server.
 *              If POST:
 *                 . List items appear in pairs. First item is name and 
 *                   second is value.
 *                 . Hence, the number of items must be even.
 *              If any other method:
 *                 . I have not decided how to process them.
 *
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTANCHORSETDOCUMENT (HTAnchorHandle parent, HTDocument document)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )
EC( ECCheckHTList(document);                                            )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    if (anchor->HTPA_document) HTListDelete(anchor->HTPA_document);
    anchor->HTPA_document = document;
    HTMemUnlock(parent);
}	/* End of HTANCHORSETDOCUMENT.	*/
