@include <WWW/HTCore/htancMan.goh>
@include <WWW/HTCore/htstring.goh>
@include "htfatals.goh"
#include <Ansi/string.h>		/* memcpy(), memcmp() */



/***********************************************************************
 *		HTANCHORCONTENTTYPE
 ***********************************************************************
 *
 * SYNOPSIS:	Get the media type (Content-Type). The passed in anchor
 *              must be a parent anchor (cannot be a child anchor).
 * CALLED BY:	Client.
 * RETURN:	HTStringHandle, in MIME content-type format or NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 3/96   	Initial Revision
 *
 ***********************************************************************/
HTStringHandle _far _pascal
HTANCHORCONTENTTYPE (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;
    HTStringHandle ret;

EC( ECCheckHTAnchor(parent);                                            )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    ret = anchor->HTPA_content_type;
    HTMemUnlock(parent);

    return ret;
}	/* End of HTANCHORCONTENTTYPE.	*/





/***********************************************************************
 *		HTANCHORSETCONTENTTYPE
 ***********************************************************************
 *
 * SYNOPSIS:	Set the content-type of an anchor object.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 4/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTANCHORSETCONTENTTYPE (HTAnchorHandle parent, HTStringHandle contentType)
{
    HTParentAnchor *anchor;


EC( ECCheckHTAnchor(parent);                                             )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    anchor->HTPA_content_type = contentType;
    HTMemUnlock(parent);
}	/* End of HTANCHORSETCONTENTTYPE.	*/





/***********************************************************************
 *		HTANCHORCONTENTLENGTH
 ***********************************************************************
 *
 * SYNOPSIS:	Get the content-length of a parent anchor object.
 * CALLED BY:	Client.
 * RETURN:	dword, or 0 for no length.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 4/96   	Initial Revision
 *
 ***********************************************************************/
dword _far _pascal
HTANCHORCONTENTLENGTH (HTAnchorHandle parent)
{
    HTParentAnchor *anchor;
    dword ret;

    if (!parent) return 0;

EC( ECCheckHTAnchor(parent);                                           )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    ret = anchor->HTPA_content_length;
    HTMemUnlock(parent);

    return ret;
}	/* End of HTANCHORCONTENTLENGTH.	*/




/***********************************************************************
 *		HTANCHORSETCONTENTLENGTH
 ***********************************************************************
 *
 * SYNOPSIS:	Set the content-length of an anchor data object.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 5/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTANCHORSETCONTENTLENGTH (HTAnchorHandle parent, dword contentLength)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    anchor->HTPA_content_length = contentLength;
    HTMemUnlock(parent);
}	/* End of HTANCHORSETCONTENTLENGTH.	*/




/***********************************************************************
 *		HTANCHORLASTMODIFIED
 ***********************************************************************
 *
 * SYNOPSIS:	Get last-modified data and time.
 * CALLED BY:	Client.
 * RETURN:	TimerDateAndTime.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 5/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTANCHORLASTMODIFIED (HTAnchorHandle parent, TimerDateAndTime *dateTime)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    memcpy(dateTime, &(anchor->HTPA_lastModified), sizeof(TimerDateAndTime));
    HTMemUnlock(parent);
}	/* End of HTANCHORLASTMODIFIED.	*/





/***********************************************************************
 *		HTANCHORSETLASTMODIFIED
 ***********************************************************************
 *
 * SYNOPSIS:	Set the last-modified date and time.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/ 5/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTANCHORSETLASTMODIFIED (HTAnchorHandle parent, 
			 const TimerDateAndTime *dateTime)
{
    HTParentAnchor *anchor;

EC( ECCheckHTAnchor(parent);                                            )

    anchor = (HTParentAnchor *) HTMemLock(parent);
    memcpy(&(anchor->HTPA_lastModified), dateTime, sizeof(TimerDateAndTime));
    HTMemUnlock(parent);
}	/* End of HTANCHORSETLASTMODIFIED.	*/





