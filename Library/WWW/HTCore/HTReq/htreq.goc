extern void _pascal HTAnchorDelete(HTAnchorHandle parent);

/* --------------------------------------------------------------------------
 * 		PRIVATE DATA
 * --------------------------------------------------------------------------*/

/*
 * Library won't compile unless there is a dgroup, this dummy does the job! :)
 */
byte htRequestDummy;

/* 
 * List of registered WWW Library client. Access to it must be synchronized
 * using a semaphore.
 */
static HTListHandle wwwClientList = NULL;
static SemaphoreHandle wwwClientListSem = NULL;


/* --------------------------------------------------------------------------
 * 		PRIVATE ROUTINES
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTRequestLibraryEntry
 ***********************************************************************
 * SYNOPSIS:	Initialize static vars. 
 * CALLED BY:	HTCoreLibraryEntry
 * RETURN:	Must return 0 to indicate all ok to Geos.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    Allocated semaphore must be made owner of HTCore
 *              Library other it will go away when the creator exits.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/10/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTRequestLibraryEntry (LibraryCallType ty, GeodeHandle client)
{
    /* 
     * The following two lines are *NOT* redundant. They are needed to
     * first bring the resource into memory as MemThreadGrab used
     * throughout the Library does not bring the resource into memory.
     */
    if (ty == LCT_ATTACH) {
	wwwClientList = HTListNew();
	wwwClientListSem = ThreadAllocSem(1);  /* Only one thread can grab */	
	HandleModifyOwner(wwwClientListSem, GeodeGetCodeProcessHandle());

    } else if (ty == LCT_DETACH) {
	HTListDelete(wwwClientList);
	wwwClientList = 0;   /* Lazarus protection. */

	ThreadFreeSem(wwwClientListSem);
	wwwClientListSem = 0;
    }

    return 0; /* Return value required by Geos */
}	/* End of HTRequestLibraryEntry.	*/




/***********************************************************************
 *		HTRequestResetRequest
 ***********************************************************************
 * SYNOPSIS:	Reset all internal values of a used request by the 
 *              Library to that of a new request.
 * CALLED BY:	Library (HTRequestSubmit).
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/22/96   	Initial Revision
 *
 ***********************************************************************/
static void _pascal
HTRequestResetRequest (HTRequest *rptr)
{

EC( if (rptr->HTR_protocol)                                             )
EC(      EC_ERROR(ATTEMPTING_TO_RESUBMIT_AN_IN_USE_REQUEST);            )

    rptr->HTR_bytesRead = 0;
    rptr->HTR_bytesPushed = 0;
    rptr->HTR_inputStream = NullOptr;
    rptr->HTR_sockfd = 0;
    rptr->HTR_protocol = NullOptr;
    rptr->HTR_anchor = 0;
    rptr->HTR_responseStatusCode = 0;
}	/* End of HTRequestResetRequest.	*/




/***********************************************************************
 *		HTCheckValidRequest
 ***********************************************************************
 * SYNOPSIS:	Checks to make sure that a request is valid before 
 *              being serviced by the Library.
 * CALLED BY:	HTRequestSubmit
 * RETURN:	TRUE if request is valid, else FALSE.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/26/96   	Initial Revision
 *
 ***********************************************************************/
static Boolean _pascal
HTCheckValidRequest (HTRequestHandle request)
{
    HTRequest *rptr;
    Boolean ret = TRUE;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);
    /* 
     * Make sure that the required values are set. Don't
     * need to check default values.
     */
    if ((!rptr->HTR_method) || (!rptr->HTR_uriString) ||
	(!rptr->HTR_accessPoint) || (rptr->HTR_protocol) ||
	(rptr->HTR_sockfd) || (rptr->HTR_bytesRead) ||
	(rptr->HTR_responseStatusCode) || (!rptr->HTR_anchor))
	ret = FALSE;

#if ERROR_CHECK
    if ((rptr->HTR_type == HTTPT_REQUEST) &&                            
	(rptr->HTR_version == HTTPV_0_9)  &&                            
	(rptr->HTR_postCallback))                                       
	EC_ERROR(POSTCALLBACK_NOT_ALLOWED_IN_HTTP_0_9);               
#endif
    
EC( if (!ret) EC_ERROR(INVALID_REQUEST);                                )

    MemThreadRelease(request);

    return ret;
}	/* End of HTCheckValidRequest.	*/



/* --------------------------------------------------------------------------
 * 		PUBLIC ROUTINES
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTREGISTER
 ***********************************************************************
 * SYNOPSIS:	Initialize the Library by registering the client 
 * 	        application.
 * CALLED BY:	Client. Must be called!
 * PASS:	geodeHandle = application GeodeHandle.
 *              accessPoint = the application access point as 
 *              defined in the "ini" file.
 * RETURN:	HT_OK = initialization ok, application can proceed.
 *		HT_NO = not ok, application should not proceed.
 * SIDE EFFECTS:Uses MemThreadGrab on HTRequestData. 
 *	
 * STRATEGY:	MemThreadGrab HTRequestData to allocate a HTLibEnv for a 
 *		new client. Other than the converter thread, info here
 *		is used mainly for debugging purposes. We first allocate
 *		all the necessary chunks before doing any dereferencing.
 * 		Otherwise, some of the dereferenced pointers may be 
 *		invalid.
 *
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/22/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREGISTER (GeodeHandle geodeHandle, word accessPoint)
{
    int ret = HT_OK;
    HTLibEnv libEnv;

EC( ECCheckProcessHandle(geodeHandle);                                  )

    libEnv.HTLE_geodeHandle = geodeHandle;
    libEnv.HTLE_accessPoint = accessPoint;
    
    PUSHDS;
    SET_DS_LIB_DGROUP;

    ThreadPSem(wwwClientListSem);
    HTListAppend(wwwClientList, (void *)&libEnv, sizeof(HTLibEnv));
    ThreadVSem(wwwClientListSem);

    POPDS;

    return ret;
}	/* End of HTREGISTER.	*/




/***********************************************************************
 *		HTUNREGISTER
 ***********************************************************************
 * SYNOPSIS:	Unregister a client by perrforming the necessary garbage
 *              collection.
 * CALLED BY:	Client. Must be called!
 * PASS		client - client ID.
 * RETURN:	HT_OK - termination ok.
 *		HT_NO - termination not ok.
 * SIDE EFFECTS:None
 *	
 * STRATEGY:	MemThreadGrab to free the client environment in the 
 *		library.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/22/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTUNREGISTER (GeodeHandle geodeHandle)
{
    HTLibEnv libEnv;
    word i, count, index, size;
    Boolean found = FALSE;

EC( ECCheckProcessHandle(geodeHandle);                                  )

    PUSHDS;
    SET_DS_LIB_DGROUP;               /* To use wwwClientList{Sem} */

    ThreadPSem(wwwClientListSem);

    count = HTListGetCount(wwwClientList);
    size = sizeof(HTLibEnv);

    for (i=0; i<count; i++) {
	HTListGetItem(wwwClientList, i, (void *)&libEnv, size);
	if (libEnv.HTLE_geodeHandle == geodeHandle) {
	    found = TRUE;
	    index = i;
	    break;
	}
    }

    if (found)
	HTListRemoveItem(wwwClientList, index, (void *)&libEnv, size);

    ThreadVSem(wwwClientListSem);

    POPDS;

    return HT_OK;
}	/* End of HTUNREGISTER.	*/




/***********************************************************************
 *		HTREQUESTCREATE
 ***********************************************************************
 * SYNOPSIS:	Create a request with default options. To
 *		destroy a request, use HTRequestDelete.
 * CALLED BY:	Client.
 * PASS:	HTTPType ty = whether its a HTTPT_REQUEST or 
 *              HTTPT_RESPONSE.
 * RETURN:	Handle of new request.
 * SIDE EFFECTS:None
 *	
 * STRATEGY:	MemThreadGrab HTRequestData to allocate a new request.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/30/96   	Initial Revision
 *
 ***********************************************************************/
HTRequestHandle _far _pascal 
HTREQUESTCREATE (HTTPType ty)
{
    HTRequestHandle request;
    HTRequest *rptr;

EC( if ((ty <= HTTPT_INVALID) || (ty >= HTTPT_NULL))                    )
EC(	EC_ERROR(INVALID_HTTP_TYPE);                                    )

EC( if (ty == HTTPT_RESPONSE)                                           )
EC(        EC_ERROR(NOT_IMPLEMENTED);                                   )

    request = MemAlloc(sizeof(HTRequest), HF_SHARABLE | HF_SWAPABLE,
		       HAF_ZERO_INIT | HAF_LOCK);

    if (request) {

	rptr = (HTRequest *) MemDeref(request);

	/* 
	 * Default options for a request. We only
	 * need to set non-zero data items.
	 */
	rptr->HTR_type = ty;
	rptr->HTR_version = HTTPV_1_1;
	rptr->HTR_genHdMask = DEFAULT_GENERAL_HEADERS;
	rptr->HTR_reqHdMask = DEFAULT_REQUEST_HEADERS;
	rptr->HTR_entityHdMask = DEFAULT_ENTITY_HEADERS;
	rptr->HTR_proxy = FALSE;
	rptr->HTR_requestHandle = request;

	/* Access Authentication stuff, the rest are NULL */
	rptr->HTR_aa.HTA_wwwScheme = HTAA_NONE;
	rptr->HTR_aa.HTA_scheme = HTAA_NONE;

	/* 
	 * Cache reload mode. Default is to always force reload from
	 * network, bypassing local memory cache and file cache.
	 */
	rptr->HTR_reloadMode = HTRELOAD_FORCE_RELOAD;

	MemUnlock(request);
    }

    return request;
}	/* End of HTREQUESTCREATE.	*/




/***********************************************************************
 *		HTREQUESTDELETE
 ***********************************************************************
 * SYNOPSIS:	Delete a request. Note that this is not the same as 
 *              killing a request. If you want to stop a request, use 
 *              API HTRequestKill.
 * CALLED BY:	Client.
 * PASS:	request = request to delete.
 * RETURN:	HT_OK or HT_NO.
 * SIDE EFFECTS:None.
 *	
 * STRATEGY:	Remember to free all the data items inside a HTRequest 
 *              structure before freeing HTRequest itself. There is no
 *              need to MemThreadRelease(request) since we are freeing 
 *              it.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	4/30/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTDELETE (HTRequestHandle request)
{	
    HTRequest *rptr;

    if (!request) return HT_NO;
EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    if (rptr->HTR_uriString) 
	MemFree(rptr->HTR_uriString);
    if (rptr->HTR_source)
	HTAnchorDelete(rptr->HTR_source);
    if (rptr->HTR_aa.HTA_authorization)
	HTMemFree(rptr->HTR_aa.HTA_authorization);
    if (rptr->HTR_errorList)
	HTListDelete(rptr->HTR_errorList);

    MemFree(request);
    return HT_OK;
}	/* End of HTREQUESTDELETE.	*/



/***********************************************************************
 *		HTREQUESTKILL
 ***********************************************************************
 * SYNOPSIS:	Kill a request so that it stops being serviced by the
 *              Library. This does not delete the request. To delete a 
 *              request, see API HTRequestDelete. This is a blocking 
 *              call to kill a request.
 * CALLED BY:   Client.	
 * RETURN:	HT_OK or HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/ 5/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTKILL (HTRequestHandle request)
{
    if (!request) return HT_NO;
EC( ECCheckRequest(request);                                            )

    return HTNetKill(request, HT_INTERRUPTED);
}	/* End of HTREQUESTKILL.	*/




/***********************************************************************
 *		HTREQUESTKILLALL
 ***********************************************************************
 *
 * SYNOPSIS:	Kill all requests for a client. Pass the same GeodeHandle
 *              as in HTRequestSubmit and HTRegister. 
 * CALLED BY:	GLOBAL
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:    
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/12/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTREQUESTKILLALL (GeodeHandle client)
{

EC( ECCheckGeodeHandle(client);                                         )

    HTNetKillAll(client, HT_INTERRUPTED);
}	/* End of HTREQUESTKILLALL.	*/



/***********************************************************************
 *		HTREQUESTSHUTDOWN
 ***********************************************************************
 *
 * SYNOPSIS:	Shutdown all connections currently alive in the HTCore
 *              library. All requests will be terminated.
 * CALLED BY:	GLOBAL
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/21/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTREQUESTSHUTDOWN (void)
{
    HTShutDown();                     /* In htsockMan.goc */
}	/* End of HTREQUESTSHUTDOWN.	*/



/***********************************************************************
 *		HTREQUESTSETREQUESTLINE
 ***********************************************************************
 *
 * SYNOPSIS:	Set the request line of a request.
 * CALLED BY:	Client
 * RETURN:	HT_OK or HT_NO
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/19/97   	Initial Revision
 *	
 ***********************************************************************/
int _far _pascal
HTREQUESTSETREQUESTLINE (HTRequestHandle request, HTMethod method,
			 const char *uri, HTTPVersion version)
{
    
    HTRequest *rptr;
    MemHandle mh;
    char *cptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                           )
EC( if ((method <= HTM_INVALID) || (method >= HTM_NULL))               )
EC(	EC_ERROR(INVALID_HTTP_METHOD);                                 )
EC( if ((version <= HTTPV_INVALID) || (version >= HTTPV_NULL))          )
EC(     EC_ERROR(INVALID_HTTP_VERSION);                                 )

    rptr = (HTRequest *) MemThreadGrab(request);

    /* Copy method */
    rptr->HTR_method = method;
    
    /* Copy URI */
    if (rptr->HTR_uriString) {
	MemFree(rptr->HTR_uriString);
	rptr->HTR_uriString = NULL;
    }

    mh = MemAlloc(strlen(uri)+1, HF_SHARABLE | HF_SWAPABLE,
		  HAF_ZERO_INIT | HAF_LOCK);
    if (!mh) {
	MemThreadRelease(request);
	return HT_NO;
    }

    else {
	cptr = (char *) MemDeref(mh);
	strcpy(cptr, uri);
	rptr->HTR_uriString = mh;
	MemUnlock(mh);
    }

    /* Copy version */
    rptr->HTR_version = version;

    MemThreadRelease(request);
   
    return HT_OK;
}	/* End of HTREQUESTSETREQUESTLINE.	*/




/***********************************************************************
 *		HTREQUESTSETMETHOD
 ***********************************************************************
 * SYNOPSIS:	Set the method of a request.
 * CALLED BY:	Client.
 * RETURN:	HT_OK or HT_NO.
