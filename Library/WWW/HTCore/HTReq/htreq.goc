 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/10/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTREQUESTSETCACHEHIT (HTRequestHandle request, Boolean hit)
{
    HTRequest *rptr;
EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);
    rptr->HTR_cacheHit = hit;
    HTAnchorSetCacheHit(rptr->HTR_anchor, hit);
    MemThreadRelease(request);
}	/* End of HTREQUESTSETCACHEHIT.	*/



