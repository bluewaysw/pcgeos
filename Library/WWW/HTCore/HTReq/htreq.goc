/***********************************************************************
 *		HTREQUESTSETRELOADMODE
 ***********************************************************************
 *
 * SYNOPSIS:	When loading a document, this flag can be set in order
 *              to define who can give a response to the request. IMS
 *              means that a "If-Modified-Since" header is used in a 
 *              HTTP request.
 * CALLED BY:	Client
 * RETURN:	HT_OK or HT_NO.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	1/30/97   	Initial Revision
 *	
 ***********************************************************************/
int _far _pascal
HTREQUESTSETRELOADMODE (HTRequestHandle request, HTReload mode)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( if ((mode <= HTRELOAD_INVALID) || (mode >= HTRELOAD_NULL))          )
EC(     EC_ERROR(INVALID_HTRELOAD_MODE);                                )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_reloadMode = mode;

    MemThreadRelease(request);
    return HT_OK;
}	/* End of HTREQUESTSETRELOADMODE.	*/





