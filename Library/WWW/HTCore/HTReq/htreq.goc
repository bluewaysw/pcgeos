 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/25/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETMETHOD (HTRequestHandle request, HTMethod method)
{
    
    HTRequest *rptr;

    if (!request) return HT_NO;
EC( ECCheckRequest(request);                                           )

EC( if ((method <= HTM_INVALID) || (method >= HTM_NULL))               )
EC(	EC_ERROR(INVALID_HTTP_METHOD);                                 )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_method = method;

    MemThreadRelease(request);
   
    return HT_OK;
}	/* End of HTREQUESTSETMETHOD.	*/



/***********************************************************************
 *		HTREQUESTSETURI
 ***********************************************************************
 * SYNOPSIS:	Set the URI of a request, e.g., 
 *		http://www.geoworks.com/somefile#anchor. The URI can be
 *		character based (www.geoworks.com) or numerical-based
 *		(128.230.28.38).
 * CALLED BY:	Client.
 * PASS:	request = request to set URI.
 *		uri = null-terminated URI string.
 * RETURN:	HT_OK or HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/22/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETURI (HTRequestHandle request, const char *uri)
{
    HTRequest *rptr;
    MemHandle mh;
    char *cptr;
    int ret = HT_OK;

    if (!request) return HT_NO;
EC( ECCheckRequest(request);                                           )

    rptr = (HTRequest *) MemThreadGrab(request);

    /* 
     * Free the old URI.
     */
    if (rptr->HTR_uriString != NULL) {
	MemFree(rptr->HTR_uriString);
	rptr->HTR_uriString = NULL;
    }

    /*
     * Allocate memory to hold the new uri.
     */
    mh = MemAlloc(strlen(uri)+1, HF_SHARABLE | HF_SWAPABLE,
		  HAF_ZERO_INIT);
    if (!mh) 
	ret = HT_NO;

    else {
	cptr = (char *) MemLock(mh);

	strcpy(cptr, uri);
	rptr->HTR_uriString = mh;

	MemUnlock(mh);
    }

    MemThreadRelease(request);
   
    return ret;
}	/* End of HTREQUESTSETURI.	*/



/***********************************************************************
 *		HTREQUESTGETURI
 ***********************************************************************
 *
 * SYNOPSIS:	Get the URI. This often needed if there is some sort of
 *              redirection being done by the Library. In that case, the 
 *              URI would changed. You need to get this new URI before
 *              combining them with other relative URLs in following 
 *              links within the document.
 * CALLED BY:	Client.
 * RETURN:	HTMemHandle else NULL.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/24/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTREQUESTGETURI (HTRequestHandle request)
{
    HTMemHandle ret = NULL;
    char *cptr;
    HTRequest *rptr;

    if (!request) return HT_NO;
EC( ECCheckRequest(request);                                            )
    
    rptr = (HTRequest *) MemThreadGrab(request);

    if (rptr->HTR_uriString) {
	cptr = (char *) MemLock(rptr->HTR_uriString);
	ret = HTStrAllocCopy(cptr);
	MemUnlock(rptr->HTR_uriString);
    }

    MemThreadRelease(request);
   
    return ret;
}	/* End of HTREQUESTGETURI.	*/





