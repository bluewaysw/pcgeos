/***********************************************************************
 *		HTREQUESTSETPROXY
 ***********************************************************************
 * SYNOPSIS:	Set the proxy to use instead of the host provided in 
 *              HTRequestSetURI. If no proxy is provided, we use the 
 *              the host provided in HTRequestSetURI.
 * CALLED BY:	Client.
 * RETURN:	HT_OK or HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/17/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETPROXY (HTRequestHandle request, const char *proxyName,
		   word portNumber, const char *username, 
		   const char *password)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )

EC( if (proxyName && strlen((char *) proxyName) >= MAX_HOST_NAME_LENGTH))
EC(     EC_ERROR(PROGRAM_ERROR_HOST_NAME_EXCEEDS_MAX_HOST_NAME_LENGTH); )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_proxy = TRUE;
    if (proxyName) strcpy((char *)rptr->HTR_proxyName, proxyName);
    if (portNumber) rptr->HTR_proxyPortNumber = portNumber;

    if (username && password) {
	HTMemHandle cleartext;
	char *result;
	int len = strlen(username) + strlen(password) + 3;
	char *c = HTMemAllocAndLock(&cleartext, len);
	strcpy(c, username);
	c[strlen(username)] = ':';
	strcat(c, password);
	
	/* Delete old proxyAuth if client is retrying */
	if (rptr->HTR_proxyAuth) HTMemFree(rptr->HTR_proxyAuth);
	result = HTMemAllocAndLock(&(rptr->HTR_proxyAuth), 
				   (4*((len+2)/3+1)));
	HTUUEncodePtr((byte*)c, strlen(c), (byte*)result);
	HTMemUnlockAndFree(cleartext);
	HTMemUnlock(rptr->HTR_proxyAuth);
    }

    MemThreadRelease(request);
    
    return HT_OK;
}	/* End of HTREQUESTSETPROXY.	*/


/***********************************************************************
 *		HTREQUESTSENDDATA
 ***********************************************************************
 *
 * SYNOPSIS:	Send data with the request.
 * CALLED BY:	Client
 * RETURN:	HT_OK or HT_NO
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/20/97   	Initial Revision
 *	
 ***********************************************************************/
int _far _pascal
HTREQUESTSENDDATA (HTRequestHandle request, HTMemHandle data)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )
EC( ECCheckHTMemHandle(data);                                           )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_data = data;

    MemThreadRelease(request);
    
    return HT_OK;
}	/* End of HTREQUESTSENDDATA.	*/


/***********************************************************************
 *		HTREQUESTADDHEADER
 ***********************************************************************
 *
 * SYNOPSIS:	Add a header to the request. Header is passed to server
 *              as 
 *                        name: value <CRLF>
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	10/20/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTREQUESTADDHEADER (HTRequestHandle request, const char *name,
		    const char *value)
{
    HTRequest *rptr;
    HTMemHandle ext;
    if (!request || !name || !value) return;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);
    if (!rptr->HTR_extraHeaders) {
	rptr->HTR_extraHeaders = HTListNew();
    }
    ext = HTStrAllocCopy(name),
    HTListAppend(rptr->HTR_extraHeaders, (void*)&ext, sizeof(HTMemHandle));
    ext = HTStrAllocCopy(value);
    HTListAppend(rptr->HTR_extraHeaders, (void*)&ext, sizeof(HTMemHandle));
    MemThreadRelease(request);
}	/* End of HTREQUESTADDHEADER.	*/




/***********************************************************************
 *		HTREQUESTSUBMIT
 ***********************************************************************
 * SYNOPSIS:	Submit a request to the Library. This is a nonblocking
 *		call. To receive data asynchronously, see the Policy 
 *              Manager (HTPolicy/htpolicy.goc) and/or API
 *              HTRequestSetResponseParser. Note that there is no API
 *              for receiving data synchronously.
 * CALLED BY:	Client.
 * RETURN:	HT_OK is request is accepted, else HT_NO, or 
 *              HT_OUT_OF_MEMORY.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:	1. Parse URI for the access method (e.g., http).
 *		   For now, we simply assume the access method is http.
 *              2. Create a new Net object in the Net Manager to run this 
 *                 request.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/22/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSUBMIT (HTRequestHandle request, GeodeHandle client)
{
    HTMemHandle htmh;
    HTLibEnv *eptr;
    HTRequest *rptr;
    word i, count, size;
    char *url;
    int ret = HT_OK;
    Boolean found = FALSE;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )
EC( ECCheckProcessHandle(client);                                       )

    /* 
     * Since a request maybe reused, we need to reset internal
     * values used by the Library in the previous request.
     */
    rptr = (HTRequest *) MemThreadGrab(request);

    HTRequestResetRequest(rptr);

    /*
     * This request is own by a client.
     */
    if ((htmh = HTSessionLookup(client)) != 0) {
	eptr = (HTLibEnv *) HTMemLock(htmh);

	rptr->HTR_client = eptr->HTLE_client;
	rptr->HTR_accessPoint = eptr->HTLE_accessPoint;

	HTMemUnlock(htmh);

	url = (char *) MemLock(rptr->HTR_uriString);
	rptr->HTR_anchor = HTAnchorFind(url);
	MemUnlock(rptr->HTR_uriString);

    } else 
	ret = HT_NO;

    MemThreadRelease(request);

    /* Have to make sure its a valid request before we service it. */
    if (!(HTCheckValidRequest(request))) return HT_NO;

    if (ret == HT_OK)
	return HTNetNewClient(request);  /* HT_OK or HT_OUT_OF_MEMORY */
    else 
	return ret;
}	/* End of HTREQUESTSUBMIT.	*/




/***********************************************************************
 *		HTREQUESTGETBYTES
 ***********************************************************************
 * SYNOPSIS:	Query number of bytes by a request.
 * CALLED BY:	Client.
 * RETURN:	Number of bytes read that belong to the data object, the
 *              complete length of which is the Content-length.
 *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/22/96   	Initial Revision
 *
 ***********************************************************************/
dword _far _pascal
HTREQUESTGETBYTES (HTRequestHandle request, HTBytesStream kind)
{
    dword ret=0;
    HTRequest *rptr;

    if (!request) return 0;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    switch (kind) {
    case HTBS_CONTENT:
	ret = rptr->HTR_bytesRead;
	break;
    case HTBS_PUT_TO_SERVER:
	ret = rptr->HTR_bytesPut;
	break;
    case HTBS_PUSHED_TO_CLIENT:
	ret = rptr->HTR_bytesPushed;
	break;
    }

    MemThreadRelease(request);

    return ret;
}	/* End of HTREQUESTGETBYTESREAD.	*/




/***********************************************************************
 *		HTREQUESTGETRESPONSESTATUSCODE
 ***********************************************************************
 * SYNOPSIS:	Get the request response status code.
 * CALLED BY:	Client.
 * RETURN:	If response code is not yet parsed, you get 0.
 *              The only way to be sure that the response code is
 *              parsed (if the response has a response code) is to
 *              call this API in your "after" callbacks after you have
 *              received HT_LOADING_DATA.
 *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	8/ 4/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTREQUESTGETRESPONSESTATUSCODE (HTRequestHandle request)
{
    word statusCode;
    HTRequest *rptr;

    if (!request) return 0;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    statusCode = rptr->HTR_responseStatusCode;

    MemThreadRelease(request);

    return statusCode;
}	/* End of HTREQUESTGETRESPONSESTATUSCODE.	*/




/***********************************************************************
 *		HTREQUESTGETRESPONSECONTENTLENGTH
 ***********************************************************************
 * SYNOPSIS:	Get the content-length of the request response.
 * CALLED BY:	Client.
 * RETURN:	Content-length parsed from the response. If content-
 *              length is NOT available or yet parsed , you get 0.
 *              The only way to be sure that the response code is
 *              parsed (if the response has a response code) is to
 *              call this API in your "after" callbacks after you have
 *              received HT_LOADING_DATA.
 *
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/25/96   	Initial Revision
 *
 ***********************************************************************/
dword _far _pascal
HTREQUESTGETRESPONSECONTENTLENGTH (HTRequestHandle request)
{
    dword contentLength;
    HTRequest *rptr;

    if (!request) return 0;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    contentLength = HTAnchorContentLength(rptr->HTR_anchor);

    MemThreadRelease(request);

    return contentLength;
}	/* End of HTREQUESTGETRESPONSECONTENTLENGTH.	*/



/***********************************************************************
 *		HTREQUESTGETRESPONSELASTMODIFIED
 ***********************************************************************
 *
 * SYNOPSIS:	Get the last modified date of the response. Client must
 *              delete the return HTMemHandle.
 * CALLED BY:	Client
 * RETURN:	Last modified date as HTMemHandle which caller must 
 *              delete after use. 0 if no date available.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/20/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTREQUESTGETRESPONSELASTMODIFIED (HTRequestHandle request)
{
    HTRequest *rptr;
    HTMemHandle ret = 0;

    if (!request) return FALSE;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    ret = HTAnchorLastModified(rptr->HTR_anchor);

    MemThreadRelease(request);

    return ret;
}	/* End of HTREQUESTGETRESPONSELASTMODIFIED.	*/


/***********************************************************************
 *		HTREQUESTGETRESPONSEHEADER
 ***********************************************************************
 *
 * SYNOPSIS:	Get the a response header. If you are looking for common 
 *              headers, you MUST use other APIs, like 
 *              HTRequestGetResponderLastModified, etc.
 * CALLED BY:	Client
 * RETURN:	HTMemHandle or NULL, caller must delete after use.
