/***********************************************************************
 *		HTREQUESTSETRESPONSEPARSER
 ***********************************************************************
 * SYNOPSIS:	Register a header parser for HTTP response. Your parser
 *              will be called to handle the response for this request.
 *              If no response parser is registered, the Library 
 *              default is used. The parser must be inherited from 
 *  	        HTStreamClass.
 * CALLED BY:   Client.	
 * RETURN:      HT_OK or HT_NO.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:    The parser must be a subclass of HTStreamClass 
 *              (htstream.goh{goc}). The header parser is the 
 *              first stream to receive data via MSG_HT_STREAM_PUT_BLOCK,
 *              so you need to take care processing all data that are 
 *              pushed to your parser.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/10/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETRESPONSEPARSER (HTRequestHandle request, 
			    ClassStruct _far *class)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )
EC( ECCheckClass(class);                                                )

#if ERROR_CHECK
    PUSHDS;
    SET_DS_LIB_DGROUP;   /* To use HTStreamClass */
    if (!ObjIsClassADescendant(class, &HTStreamClass))
	EC_ERROR(NOT_A_SUBCLASS_OF_HTSTREAMCLASS);
    POPDS;
#endif

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_responseParserClass = class;

    MemThreadRelease(request);

    return HT_OK;
}	/* End of HTREQUESTSETRESPONSEPARSER.	*/




/***********************************************************************
 *		HTREQUESTSETPOSTCALLBACK
 ***********************************************************************
 * SYNOPSIS:	Set the post callback function of a request. This function
 *              is called to push extra headers and data down the input
 *              stream pipe (to the network). The callback MUST at least
 *              put a CRLF to terminate the request header (Although the
 *              Library does not enforce it.) If the request is using
 *              HTTPV_0_9, the postcallback will not be used as HTTP/0.9
 *              does not have extra headers other than the request line.
 * CALLED BY:   Client.
 * RETURN:	HT_OK or HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/23/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETPOSTCALLBACK (HTRequestHandle request, HTPostCallback cbf)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_postCallback = cbf;

    MemThreadRelease(request);

    return HT_OK;
}	/* End of HTREQUESTSETPOSTCALLBACK.	*/



/***********************************************************************
 *		HTREQUESTSETPROXY
 ***********************************************************************
 * SYNOPSIS:	Set the proxy to use instead of the host provided in 
 *              HTRequestSetURI. If no proxy is provided, we use the 
 *              the host provided in HTRequestSetURI.
 * CALLED BY:	Client.
 * RETURN:	HT_OK or HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/17/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETPROXY (HTRequestHandle request, const char *proxyName,
		   word portNumber)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )

EC( if (strlen((char *) proxyName) >= MAX_HOST_NAME_LENGTH)             )
EC(     EC_ERROR(PROGRAM_ERROR_HOST_NAME_EXCEEDS_MAX_HOST_NAME_LENGTH); )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_proxy = TRUE;
    strcpy((char *)rptr->HTR_proxyName, proxyName);
    rptr->HTR_proxyPortNumber = portNumber;

    MemThreadRelease(request);
    
    return HT_OK;
}	/* End of HTREQUESTSETPROXY.	*/


/***********************************************************************
 *		HTREQUESTSETDATASOURCE
 ***********************************************************************
 *
 * SYNOPSIS:	Set the data source of a request. The data is sent to
 *              the server along with the request. This API is used to
 *              submit data to the server. Mostly used for post.
 *              The passed in anchor *must* be created using HTAnchorNew
 *              and not HTAnchorFind. The source anchor will be 
 *              deleted when the source document (provided using API
 *              HTAnchorSetDocument) has been sent.
 * CALLED BY:	Client
 * RETURN:	HT_OK or HT_NO
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	3/20/97   	Initial Revision
 *	
 ***********************************************************************/
int _far _pascal
HTREQUESTSETDATASOURCE (HTRequestHandle request, HTAnchorHandle source)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )
EC( ECCheckHTAnchor(source);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_source = source;

    MemThreadRelease(request);
    
    return HT_OK;
}	/* End of HTREQUESTSETDATASOURCE.	*/





