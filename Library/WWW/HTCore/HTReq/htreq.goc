 *	kkee    	10/22/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTREQUESTGETRESPONSEHEADER (HTRequestHandle request, const char *name)
{
    HTRequest *rptr;
    HTMemHandle ret = 0;

    if (!request) return FALSE;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);

    ret = HTAnchorGetHeader(rptr->HTR_anchor, name);

    MemThreadRelease(request);

    return ret;
}	/* End of HTREQUESTGETRESPONSEHEADER.	*/




/***********************************************************************
 *		HTREQUESTSETCACHEHIT
 ***********************************************************************
 *
 * SYNOPSIS:	Indicate whether we have a cache hit or not.
 * CALLED BY:	Internal
 * RETURN:	Nothing
