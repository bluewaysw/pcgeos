/***********************************************************************
 *		HTREQUESTSETAFTERCALLBACKLIST
 ***********************************************************************
 * SYNOPSIS:	Set the "after" callback list of a request.
 * CALLED BY:	Client.
 * RETURN:	HT_OK if ok, else HT_NO.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    BUG: Your callback functions must be able to
 *              receive the same request more than once. So if you 
 *              delete the request, make sure you don't delete it again.
 *              Here is the only scenario we know of that can cause this
 *              to happen (see also HTNetKill). 
 *
 *              SOLVED BY: This problem is solved by HTList/slist.goc.
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/15/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTSETAFTERCALLBACKLIST (HTRequestHandle request, HTListHandle list)
{
    HTRequest *rptr;

    if (!request) return HT_NO;

EC( ECCheckRequest(request);                                            )
EC( ECCheckHTList(list);                                                )

    rptr = (HTRequest *) MemThreadGrab(request);

    rptr->HTR_afterList = list;

    MemThreadRelease(request);
    return HT_OK;
}	/* End of HTREQUESTSETAFTERCALLBACKLIST.	*/




