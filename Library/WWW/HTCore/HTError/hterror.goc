@include <WWW/HTCore/hterror.goh>

/* --------------------------------------------------------------------------
 * 		PRIVATE DATA
 * --------------------------------------------------------------------------*/

/*
 * Library won't compile unless there is a dgroup, this dummy does the job! :)
 */
byte htErrorDummy;

/* --------------------------------------------------------------------------
 * 		PUBLIC ROUTINES
 * --------------------------------------------------------------------------*/


/***********************************************************************
 *		HTREQUESTADDERROR
 ***********************************************************************
 * SYNOPSIS:	Add an error message to a request.
 * CALLED BY:	Library.
 * RETURN:	HT_OK if ok, else HT_NO.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:    For debugging purposes, you should set a break point here
 *              and trap the error codes. In swat, simply do
 *                 pstring *message
 *                 pstring *source 
 *              to find out the error and its source.
 *
 *              Later on we will code this routine to save these messages
 *              and provide and API for the client to query the error
 *              messages.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	6/11/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTREQUESTADDERROR (HTRequestHandle request, HTErrorSeverity severity,
		   HTErrorElement element, Boolean ignore, char *message, 
		   int length, char *source)
{
    HTRequest *rptr;

EC( ECCheckRequest(request);                                            )

    rptr = (HTRequest *) MemThreadGrab(request);
    /* Log the error here */
    
    MemThreadRelease(request);
    return HT_OK;
}	/* End of HTREQUESTADDERROR.	*/



