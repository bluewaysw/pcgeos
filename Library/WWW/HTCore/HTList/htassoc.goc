@include <WWW/HTCore/htassoc.goh>
@include <WWW/HTCore/htstring.goh>
#include <WWW/htmem.h>
#include <Ansi/string.h>

/*
 * Association between a name and its value for null-terminated strings.
 */
typedef struct {
    HTMemHandle HTA_name;           /* deref into char* */
    HTMemHandle HTA_value;          /* deref into char* */
} HTAssoc;


/*
 * Association between a name and its value for dwords.
 */
typedef struct {
    dword HTAD_name;
    dword HTAD_value;
} HTAssocDword;



/***********************************************************************
 *		HTASSOCLISTNEW
 ***********************************************************************
 *
 * SYNOPSIS:	Create a new associative list.
 * CALLED BY:	Client
 * RETURN:	HTAssocList.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/29/96   	Initial Revision
 *
 ***********************************************************************/
HTAssocList _far _pascal
HTASSOCLISTNEW (void)
{
    return HTListNew();
}	/* End of HTASSOCLISTNEW.	*/




/***********************************************************************
 *		HTASSOCLISTDELETE
 ***********************************************************************
 *
 * SYNOPSIS:	Delete an associative list.
 * CALLED BY:	Client
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/29/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTASSOCLISTDELETE (HTAssocList alist)
{
    if (alist) {
	int i,count,size;
	HTAssoc assoc;
	
	count = HTListGetCount(alist);
	size = sizeof(HTAssoc);
	
	for (i=0; i<count; i++) {
	    HTListRemoveItem(alist, 0, (void *)&assoc, size);
	    if (assoc.HTA_name) HTMemFree(assoc.HTA_name);
	    if (assoc.HTA_value) HTMemFree(assoc.HTA_value);
	}
	
	HTListDelete(alist);
    }
}	/* End of HTASSOCLISTDELETE.	*/





/***********************************************************************
 *		HTASSOCLISTADD
 ***********************************************************************
 *
 * SYNOPSIS:	Add an associative to list.
 * CALLED BY:	Client
 * PASS:        name and client. These are consumed by this routine and
 *                 must *NOT* be deleted by caller.
 *                 name must be valid but value is optional.
 *
 * RETURN:	TRUE if added, else FALSE.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/29/96   	Initial Revision
 *
 ***********************************************************************/
Boolean _far _pascal
HTASSOCLISTADD (HTAssocList alist, HTMemHandle name, HTMemHandle value)
{
    HTAssoc assoc;

    if (!name) return FALSE;                /* Must have a name, though
					       value is optional */
    if (alist) {
	assoc.HTA_name = name;
	assoc.HTA_value = value;
	HTListAppend(alist, &assoc, sizeof(HTAssoc));
	return TRUE;
    }

    return FALSE;
}	/* End of HTASSOCLISTADD.	*/





/***********************************************************************
 *		HTASSOCLISTLOOKUP
 ***********************************************************************
 *
 * SYNOPSIS:	Lookup the value of a name. Name comparison in lookup
 *              is case insensitive.
 *
 * CALLED BY:	Client.
 * RETURN:	HTMemHandle of value (which caller must *NOT* delete), 
 *              else NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/ 5/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTASSOCLISTLOOKUP (HTAssocList alist, HTMemHandle name)
{
    HTMemHandle ret;
    char *n;

    if (!name) return NULL;

    n = (char *) HTMemLock(name);
    ret = HTAssocListLookupPtr(alist, n);
    HTMemUnlock(name);

    return ret;
}	/* End of HTASSOCLISTLOOKUP.	*/





/***********************************************************************
 *		HTASSOCLISTLOOKUPPTR
 ***********************************************************************
 *
 * SYNOPSIS:	Same as HTAssocListLookup but pass a character pointer.
 * CALLED BY:	Client.
 * RETURN:	HTMemHandle (which client must *NOT* delete) or NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/ 5/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTASSOCLISTLOOKUPPTR (HTAssocList alist, const char *name)
{
    HTMemHandle ret = NULL;

    if (!name) return NULL;

    if (alist) { 
	HTAssoc assoc;
	char *p;
	int i, count, size;
	
	count = HTListGetCount(alist);
	size = sizeof(HTAssoc);

	for (i=0; i<count; i++) {

	    HTListGetItem(alist, i, &assoc, size);
	    p = (char *) HTMemLock(assoc.HTA_name);

	    if (!strncasecmp(p, name, strlen(name)))
		ret = assoc.HTA_value;

	    HTMemUnlock(assoc.HTA_name);
	    if (ret) break;
	}

    }

    return ret;
}	/* End of HTASSOCLISTLOOKUPPTR.	*/



/***********************************************************************
 *		HTASSOCDWORDLISTADD
 ***********************************************************************
 *
 * SYNOPSIS:	Add a associated dword name and value pair.
 * CALLED BY:	Client
 * RETURN:	TRUE if added, else FALSE.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean _far _pascal
HTASSOCDWORDLISTADD (HTAssocList alist, dword name, dword value)
{
    HTAssocDword assoc;

    if (alist) {
	assoc.HTAD_name = name;
	assoc.HTAD_value = value;
	HTListAppend(alist, &assoc, sizeof(HTAssocDword));
	return TRUE;
    }

    return FALSE;
}	/* End of HTASSOCDWORDLISTADD.	*/



/***********************************************************************
 *		HTASSOCDWORDLISTLOOKUP
 ***********************************************************************
 *
 * SYNOPSIS:	Lookup up the value of a name. Returns the first one 
 *              that match. Value not returned if passed in value is NULL.
 * CALLED BY:	Client
 * RETURN:	TRUE if found, else FALSE and value is undefined.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean _far _pascal
HTASSOCDWORDLISTLOOKUP (HTAssocList alist, dword name, dword *value)
{
    if (alist) { 
	HTAssocDword assoc;
	int i, count, size;
	
	count = HTListGetCount(alist);
	size = sizeof(HTAssocDword);

	for (i=0; i<count; i++) {

	    HTListGetItem(alist, i, &assoc, size);
	    if (assoc.HTAD_name == name) {
		if (value) *value = assoc.HTAD_value;
		return TRUE;
	    }
	}

    }

    return FALSE;
}	/* End of HTASSOCDWORDLISTLOOKUP.	*/


/***********************************************************************
 *		HTASSOCDWORDLISTREMOVE
 ***********************************************************************
 *
 * SYNOPSIS:	Lookup and remove the first item that match name. Value
 *              not returned if passed in value is NULL.
 * CALLED BY:	Client
 * RETURN:	TRUE if found, else FALSE and value undefined.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
Boolean _far _pascal
HTASSOCDWORDLISTREMOVE (HTAssocList alist, dword name, dword *value)
{
    if (alist) { 
	HTAssocDword assoc;
	int i, count, size;
	
	count = HTListGetCount(alist);
	size = sizeof(HTAssocDword);

	for (i=0; i<count; i++) {


	    HTListGetItem(alist, i, &assoc, size);
	    if (assoc.HTAD_name == name) {
		if (value) *value = assoc.HTAD_value;
		HTListRemoveItem(alist, i, &assoc, size);
		return TRUE;
	    }
	}

    }

    return FALSE;
}	/* End of HTASSOCDWORDLISTREMOVE.	*/



/***********************************************************************
 *		HTASSOCDWORDLISTDELETE
 ***********************************************************************
 *
 * SYNOPSIS:	Delete an associative list.
 * CALLED BY:	Client
 * RETURN:	Nothing
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	4/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
void _far _pascal
HTASSOCDWORDLISTDELETE (HTAssocList alist)
{
    HTListDelete(alist);
}	/* End of HTASSOCDWORDLISTDELETE.	*/



/***********************************************************************
 *		HTASSOCDWORDLISTGETVALUE
 ***********************************************************************
 *
 * SYNOPSIS:	Get a value from an item in HTAssocDWord list.
 * CALLED BY:	Client
 * RETURN:	Value (not name)
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	7/24/97   	Initial Revision
 *	
 ***********************************************************************/
dword _far _pascal
HTASSOCDWORDLISTGETVALUE (HTAssocList alist, word index)
{
    HTAssocDword item;

    HTListGetItem(alist, index, &item, sizeof(HTAssocDword));
    return item.HTAD_value;
}	/* End of HTASSOCDWORDLISTGETVALUE.	*/


