@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htutils.goh>
@include <chunkarr.h>
#include <Ansi/string.h>		/* memcpy(), memcmp() */
#include <ec.h>

@include "htfatals.goh"

/* ---------------------------------------------------------------------
 * 		PRIVATE DATA
 * --------------------------------------------------------------------*/

/* 
 * We create a chunkarray in a block if it has less than 10 
 * chunkarrays.
 */
#define HTLIST_MAX_CHUNKARRAYS_PER_BLOCK           10

/*
 * Information about a block for creating chunkarrays.
 */
typedef struct {
    MemHandle HTB_mh;
    word HTB_numOfArrays;      /* number of chunkarrays in this block */
} HTListBlock;

/*
 * Library won't compile unless there is a dgroup, this dummy does 
 * the job! :)
 */
byte htListDummy;

@start HTListData, data;

/*
 * List of memory blocks for creating chunkarrays.
 */
@chunk HTListHandle htlistMemoryBlocks = NULL;

@end   HTListData;


/* ---------------------------------------------------------------------
 * 		PRIVATE FUNCTIONS
 * --------------------------------------------------------------------*/

/* @@@ */


/* ---------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * --------------------------------------------------------------------*/



/***********************************************************************
 *		ECCHECKHTLIST
 ***********************************************************************
 *
 * SYNOPSIS:	Check that a HTList is valid.
 * CALLED BY:	Client.
 * RETURN:	
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 1/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
ECCHECKHTLIST (HTListHandle list)
{
#if ERROR_CHECK
    MemHandle mh = OptrToHandle(list);

    if (!list) return;

    MemPLock(mh);
    ECLMemExists(list);
    MemUnlockV(mh);

#endif
}	/* End of ECCHECKHTLIST.	*/




/***********************************************************************
 *		HTLISTNEW
 ***********************************************************************
 * SYNOPSIS:	Create a new list.
 * CALLED BY:	Client
 * PASS:	Nothing
 * RETURN:	HTListHandle	
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:	We maintain a list of blocks. Each block contains at 
 *              most HTLIST_MAX_CHUNKARRAYS_PER_BLOCK number of 
 *              chunk arrays. Or should I use memory usage per block?
 *              (which is the same concept used in HTMemory).
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/24/96   	Initial Revision
 *
 ***********************************************************************/
HTListHandle _far _pascal
HTLISTNEW (void)
{	
    HTListHandle *lptr, blockList, list = NullOptr;
    HTListBlock htblock, *bptr;
    ChunkHandle chunk;
    word count, i, size = sizeof(HTListBlock);
    MemHandle mh = OptrToHandle(@htlistMemoryBlocks);
	
    MemPLock(mh);

    lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);

    if (!(*lptr)) {
	/* 
	 * Create a list for maintaining memory blocks.
	 * lptr invalidated!
	 */
	chunk = ChunkArrayCreate(mh, 0, 0, 0);
	lptr = (HTListHandle *) LMemDeref(@htlistMemoryBlocks);
	*lptr = ConstructOptr(mh, chunk); /* save it */
	blockList = *lptr;
	
	/* 
	 * Make HTListData the first block for creating chunkarrays 
	 */
	htblock.HTB_mh = mh;
	htblock.HTB_numOfArrays = 0;

	bptr = ChunkArrayAppend(blockList, size);
	memcpy(bptr, &htblock, size);

    }  else
	blockList = *lptr;

    /*
     * Search the list of blocks to create a chunkarray.
     */
    count = ChunkArrayGetCount(blockList);

    for (i=0; i<count; i++) {
	bptr = (HTListBlock *) ChunkArrayElementToPtr(blockList,
						      i, &size);

	htblock.HTB_mh = bptr->HTB_mh;
	htblock.HTB_numOfArrays = bptr->HTB_numOfArrays + 1;
	    
	if (htblock.HTB_numOfArrays <=
	    HTLIST_MAX_CHUNKARRAYS_PER_BLOCK) {

	    if (htblock.HTB_mh != mh) MemPLock(htblock.HTB_mh);

	    chunk = ChunkArrayCreate(htblock.HTB_mh, 0, 0, 0);

	    if (htblock.HTB_mh != mh) MemUnlockV(htblock.HTB_mh);

	    if (chunk) {
		/* 
		 * Update the list of memory blocks,
		 * bptr could have invalidated.
		 */
		bptr = (HTListBlock *) ChunkArrayElementToPtr(blockList,
							      i, &size);
		ChunkArrayDelete(blockList, bptr);
		bptr = ChunkArrayAppend(blockList, size);
		memcpy(bptr, &htblock, size);

		list = ConstructOptr(htblock.HTB_mh, chunk);

#if ERROR_CHECK
		if (htblock.HTB_mh != mh) MemPLock(htblock.HTB_mh);
		ECCheckChunkArray(list);
		if (htblock.HTB_mh != mh) MemUnlockV(htblock.HTB_mh);
#endif

	    }

	    break;
	}
    }

    /* 
     * If we did not find a block that fits, create one.
     */
    if (!list) {
	htblock.HTB_mh = MemAllocLMem(LMEM_TYPE_GENERAL, 0);
	htblock.HTB_numOfArrays = 1;

	/* We need to make the Library own the block as it
	 * are shared by all other Library clients.
	 */
	HandleModifyOwner(htblock.HTB_mh, GeodeGetCodeProcessHandle());
	MemModifyFlags(htblock.HTB_mh, HF_SHARABLE, 0);

	if (htblock.HTB_mh) {

	    MemPLock(htblock.HTB_mh);
	    chunk = ChunkArrayCreate(htblock.HTB_mh, 0, 0, 0);
	    
	    /* Update the list of memory blocks */
	    bptr = ChunkArrayAppend(blockList, size);
	    memcpy(bptr, &htblock, size);

	    list = ConstructOptr(htblock.HTB_mh, chunk);

EC(         ECCheckChunkArray(list);                                  )

	    MemUnlockV(htblock.HTB_mh);
	}
    }

    MemUnlockV(mh);
	
    return list;
}	/* End of HTLISTNEW.	*/



/***********************************************************************
 *		HTLISTDELETEALLITEMS
 ***********************************************************************
 *
 * SYNOPSIS:	Delete all items from a HTList. Does not delete the 
 *              list itself. To delete the HTList, use HTListDelete.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/23/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTDELETEALLITEMS (HTListHandle list)
{
    MemHandle mh = OptrToHandle(list);

    if (list == NULL) return;
    
    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )

    /* All the items */
    ChunkArrayDeleteRange(list, 0, ChunkArrayGetCount(list));

    MemUnlockV(mh);
}	/* End of HTLISTDELETEALLITEMS.	*/



/***********************************************************************
 *		HTLISTDELETERANGE
 ***********************************************************************
 *
 * SYNOPSIS:	Delete a range of items. Pass index as the first item to
 *              to delete and count as the number of items to delete.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/23/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTDELETERANGE (HTListHandle list, word index, word count) {

    MemHandle mh = OptrToHandle(list);

    if (list == NULL) return;
    
    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )
EC( if (ChunkArrayGetCount(list) < (index + count))                     )
EC(     EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    ChunkArrayDeleteRange(list, index, count);

    MemUnlockV(mh);
}	/* End of HTLISTDELETERANGE.	*/




/***********************************************************************
 *		HTLISTDELETE
 ***********************************************************************
 * SYNOPSIS:	Delete a HTList. All the items in the list will be 
 *              deleted as well.
 * CALLED BY:	Client.
 * PASS:	list = list to delete.
 * RETURN:	Nothing
 * SIDE EFFECTS:Do nothing if the passed in list is NULL.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/24/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTDELETE (HTListHandle list)
{
    HTListHandle blockList;
    HTListBlock *bptr, htblock;
    word count, i, size = sizeof(HTListBlock);
    MemHandle mh = OptrToHandle(list);

    /* 
     * First, free the chunkarray itself.
     */
    if (list == NULL) return;
    
    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )

    count = ChunkArrayGetCount(list);
    ChunkArrayDeleteRange(list, 0, count);  /* All the items */
    LMemFree(list);

    MemUnlockV(mh);

    /* 
     * Second, we may need to free the block as well.
     * Except if the block is the first block since that 
     * is the same block as the htlistMemoryBlocks.
     */
    htblock.HTB_mh = mh;
    mh = OptrToHandle(@htlistMemoryBlocks);
    MemPLock(mh);

    blockList = *(HTListHandle *) LMemDeref(@htlistMemoryBlocks);
    
	count = ChunkArrayGetCount(blockList);
	for (i=0; i<count; i++) {
	    bptr = (HTListBlock *) ChunkArrayElementToPtr(blockList,
							  i, &size);
	    
	    if (bptr->HTB_mh == htblock.HTB_mh) {

		htblock.HTB_numOfArrays = bptr->HTB_numOfArrays - 1;
		ChunkArrayDelete(blockList, bptr);

		/* 
		 * We cannot free the block used by htlistMemoryBlocks.
		 */
		if ((htblock.HTB_mh != mh) && 
		    (!htblock.HTB_numOfArrays)) 
		    MemFree(htblock.HTB_mh);

		else {
		    bptr = ChunkArrayAppend(blockList, size);
		    memcpy(bptr, &htblock, size);
		}

		break;
	    }
	}
    
    MemUnlockV(mh);
}	/* End of HTLISTDELETE.	*/




/***********************************************************************
 *		HTLISTAPPEND
 ***********************************************************************
 * SYNOPSIS:	Append an item to the end of a HTList.
 * CALLED BY:	Client.	
 * PASS:	list = list to append.
 *		item = data to append.
 *		size = size of item.
 * RETURN:	word, the index of the appended item, 0th-based.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/24/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTLISTAPPEND (HTListHandle list, const void *item, word size)
{
    void *element;	
    word index;
    MemHandle mh = OptrToHandle(list);

    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )
	
    element = ChunkArrayAppend(list, size);
    memcpy(element, item, size);

    index = ChunkArrayGetCount(list) - 1;

    MemUnlockV(mh);

    return index;
}	/* End of HTLISTAPPEND.	*/




/***********************************************************************
 *		HTLISTPREPEND
 ***********************************************************************
 *
 * SYNOPSIS:	Add an item to the front (position 0) of the list.
 * CALLED BY:	Client.
 * RETURN:	Nothing.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/12/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTPREPEND (HTListHandle list, const void *item, word size)
{
    void *element;
    word elementSize;
    MemHandle mh = OptrToHandle(list);

    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )
	
    if (!ChunkArrayGetCount(list))
	/* list is empty */
	element = ChunkArrayAppend(list, size);

    else
	element = ChunkArrayInsertAt(list, 
				     ChunkArrayElementToPtr(list, 
							    0, 
							    &elementSize), 
				     size);

    memcpy(element, item, size);

    MemUnlockV(mh);
}	/* End of HTLISTPREPEND.	*/




/***********************************************************************
 *		HTLISTREPLACEITEM
 ***********************************************************************
 *
 * SYNOPSIS:	Replace an item in the list. The item passed in must be
 *              the same size of being replaced if size > 0. If you 
 *              give size = 0, the size does not matter.
 * CALLED BY:	Client.
 * RETURN:	Nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:	First, get the element to replace. Then insert item 
 *              before this element, making sure the sizes are right.
 *              Finally remove the element to replace.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 9/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTREPLACEITEM (HTListHandle list, word index, const void *item, 
		   word size)
{
    void *element, *newElement;
    word elementSize;	
    MemHandle mh = OptrToHandle(list);

    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )
	
EC( if (ChunkArrayGetCount(list) <= index)                              )
EC(	EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    element = ChunkArrayElementToPtr(list, index, &elementSize);

EC( if (size && (elementSize != size))                                  )
EC( 	EC_WARNING(HTLIST_REPLACE_ITEM_NOT_THE_SAME_SIZE);              )

    newElement = ChunkArrayInsertAt(list, element, size);
    memcpy(newElement, item, size);

    /* Remove old item */
    ChunkArrayDeleteRange(list, index+1, 1);

    MemUnlockV(mh);

}	/* End of HTLISTREPLACEITEM.	*/





/***********************************************************************
 *		HTLISTFINDITEM
 ***********************************************************************
 * SYNOPSIS:	Find the first index of an item.
 * CALLED BY:	Client.
 * RETURN:	-1 if not found, else valid index.
 * SIDE EFFECTS:Nothing.
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/31/96   	Initial Revision
 *
 ***********************************************************************/
int _far _pascal
HTLISTFINDITEM (HTListHandle list, const void *item, word size)
{
    void *element;
    word count, len;
    int i, found = -1;

    MemHandle mh = OptrToHandle(list);

    MemPLock(mh);
EC( ECCheckChunkArray(list);                                           )
	
    count = ChunkArrayGetCount(list);
    for (i=0; i<count; i++) {
	element = ChunkArrayElementToPtr(list, i, &len);
	if (!memcmp(item, element, len) && len == size) {
	    found = i;
	    break;
	}
    }

    MemUnlockV(mh);

    return found;
}	/* End of HTLISTFINDITEM.	*/




/***********************************************************************
 *		HTLISTGETITEM
 ***********************************************************************
 * SYNOPSIS:	Fetch an item given its index in a list.
 * CALLED BY:	Client.
 * PASS:	list.
 *              index = index of element to get.
 *		item = buffer for copying the element to return.
 *		size = size of item. If the element gotten exceeds size of
 *                     item, then only the first "size" bytes of element
 *                     are copied.
 * RETURN:	Nothing
 * SIDE EFFECTS:Index must be valid, otherwise FatalError.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/25/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTGETITEM (HTListHandle list, word index, void *item, word size)
{
    void *element;
    word elementSize;
    MemHandle mh = OptrToHandle(list);
		
    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )

EC( if (ChunkArrayGetCount(list) <= index)                              )
EC(	EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    element = ChunkArrayElementToPtr(list, index, &elementSize);

EC( if (elementSize > size)                                             )
EC( 	EC_WARNING(HTLIST_ELEMENT_SIZE_EXCEEDS_PASSED_IN_SIZE);         )

    item = memcpy(item, element, size);

    MemUnlockV(mh);
}	/* End of HTLISTGETITEM.	*/



/***********************************************************************
 *		HTLISTGETITEMSIZE
 ***********************************************************************
 *
 * SYNOPSIS:	Get the size of an item.
 * CALLED BY:	Client.
 * RETURN:	word, size in bytes.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/ 7/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTLISTGETITEMSIZE (HTListHandle list, word index)
{
    word size;
    MemHandle mh = OptrToHandle(list);

    if (list == NULL) return 0;
		
    MemPLock(mh);

EC( ECCheckChunkArray(list);                                           )

    ChunkArrayElementToPtr(list, index, &size);

    MemUnlockV(mh);

    return size;
}	/* End of HTLISTGETITEMSIZE.	*/




/***********************************************************************
 *		HTLISTGETCOUNT
 ***********************************************************************
 * SYNOPSIS:	Get the number of items in a list.
 * CALLED BY:	Client.
 * PASS:        list.
 * RETURN:	number of items.
 * SIDE EFFECTS:Nothing
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/26/96   	Initial Revision
 *
 ***********************************************************************/
word _far _pascal
HTLISTGETCOUNT (HTListHandle list)
{
    word count;
    MemHandle mh = OptrToHandle(list);

    if (list == NULL) return 0;
		
    MemPLock(mh);
EC( ECCheckChunkArray(list);                                           )

    count = ChunkArrayGetCount(list);

    MemUnlockV(mh);

    return count;
}	/* End of HTLISTGETCOUNT.	*/




/***********************************************************************
 *		HTListRemoveItem
 ***********************************************************************
 * SYNOPSIS:	Remove an item from a list.
 * CALLED BY:	Client	
 * PASS:        list.
 *              index = index of element to remove.
 *		item = buffer for copying the element to return. Null
 *                     if you do not want a copy back.
 *		size = size of item. If the element gotten exceeds size of
 *                     item, then only the first "size" bytes of element
 *                     are copied.
 * RETURN:	Nothing
 * SIDE EFFECTS:Beware that the list length is reduced by 1. If you want to 
 *              remove all items for inspection, do:
 *
 *                count = HTListGetCount(list);
 *                for (i=0; i<count; i++) {
 *                  HTLISTREMOVEITEM(list, 0, item, size); ...index = 0...
 *                   ...do something with item...
 *                }
 *
 *              Index must be valid, otherwise FatalError.
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	5/29/96   	Initial Revision
 *
 ***********************************************************************/
void _far _pascal
HTLISTREMOVEITEM (HTListHandle list, word index, void *item, word size)
{
    void *element;
    word elementSize;
    MemHandle mh = OptrToHandle(list);
		
    MemPLock(mh);
EC( ECCheckChunkArray(list);                                            )

EC( if (ChunkArrayGetCount(list) <= index)                              )
EC(     EC_ERROR(HTLIST_INDEX_OUT_OF_RANGE);                            )

    element = ChunkArrayElementToPtr(list, index, &elementSize);

EC( if (elementSize > size)                                             )
EC(     EC_WARNING(HTLIST_ELEMENT_SIZE_EXCEEDS_PASSED_IN_SIZE);         )

    if (item)
	item = memcpy(item, element, size);

    ChunkArrayDelete(list, element);

    MemUnlockV(mh);
}	/* End of HTLISTREMOVEITEM.	*/
