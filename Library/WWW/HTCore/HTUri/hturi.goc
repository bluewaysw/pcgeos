  		PUBLIC FUNCTIONS
***********************************************************************/


/***********************************************************************
 *		HTENCODEFORURI
 ***********************************************************************
 *
 * SYNOPSIS:	Encode data so it is safe to be combined into a URI. Note
 *              that this API must not be called on a URI as that would
 *              encode reserved chars in the URI not meant to be encoded.
 * CALLED BY:	- data, to be encoded for inclusion in a URI.
 * RETURN:	HTMemHandle of encoded data, must be freed by caller.
 *              NULL if there is no data to encode.
 *	
 * STRATEGY:	Encoding is done according to RFC1738 which recommends
 *              encoding the following octets in their hex values preceded
 *              by %. 
 *               - No corresponding graphics US-ASCII.
 *                     octets 0x80-0xFF, 00-0x1F, and 0x7F.
 *               - Unsafe.
 *                     octets 0x20, "<", ">", """, "#", "%",
 *                     "{", "}", "|", "\", "^", "~", "[", "]", "`".
 *               - Reserved.
 *                     octets ";", "/", "?", ":", "@", "=", "&", "+".
 *               - What I think should also be encoded.
 *                     octets CRLF (or \n).
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
HTMemHandle _far _pascal
HTENCODEFORURI (const char *data)
{
    char *p;
    word len=0;
    HTMemHandle htmh;
    
    if (data && *data) 
	/* Big enough if we were to encode all chars in data */
	/* Content initialized to zero */
	p = (char *) HTMemAllocAndLock(&htmh, strlen(data)*3+1);
    else return NULL;
    
    PUSHDS;
    SET_DS_LIB_DGROUP;

    while (*data) {

	if ((*data >= 0x80   && *data <= 0xFF)  || 
	    (*data <= 0x20)  || (*data == 0x7F) ||
	    (*data == '<')   || (*data == '>')  ||
	    (*data == '\"')  || (*data == '#')  ||
	    (*data == '%')   || (*data == '{')  ||
	    (*data == '}')   || (*data == '|')  ||
	    (*data == '\\')  || (*data == '^')  ||
	    (*data == '~')   || (*data == '[')  ||
	    (*data == ']')   || (*data == '`')  ||
	    (*data == ';')   || (*data == '/')  ||
	    (*data == '?')   || (*data == ':')  ||
	    (*data == '@')   || (*data == '=')  ||
	    (*data == '&')   || (*data == '+')  ||
	    (*data == C_CR)  || (*data == C_LF)) {
	    *p++ = '%';
	    *p++ = uriEncodeTable[(byte)((*data & 0xF0) >> 4)];
	    *p++ = uriEncodeTable[(byte)(*data & 0x0F)];
	    len += 3;

	} else {
	    *p++ = *data;
	    len++;
	}

	data++;
    }

    *p = 0;  /* Null-terminate encoded data. Actually *p is already NULL
		from HTMemAllocAndLock which inits memory to 0 */

    POPDS;

    /* Resize to the exact length to save unused space */
    HTMemUnlock(htmh);
    return HTMemReAlloc(htmh, len+1);
}	/* End of HTENCODEFORURI.	*/



/***********************************************************************
 *		HTDECODEHEX
 ***********************************************************************
 *
 * SYNOPSIS:	Decode hex encoded data to octet.
 * CALLED BY:
 * RETURN:	Modifies and returns the passed in data. We can do that
 *              since hex decoded data is always shorter than hex encoded
 *              data. 
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/ 2/97   	Initial Revision
 *	
 ***********************************************************************/
char * _far _pascal
HTDECODEHEX (char *data)
{
    char b;
    char *p = data;        /* p points to data to decode */
    char *q = data;        /* q points to decoded data */
    
    if (!data || !*data) return data;

    while (*p) {
	if (*p == '%') {
	    if (*(p+1) && *(p+2)) {
		b = TOUPPER(*(p+1));
		if (b>='A' && b<='F')
		    *q = ((b-'A')+10)*16;
		else if (b>='0' && b<='9')
		    *q = (b-'0')*16;
		else return data; /* Error */

		b = TOUPPER(*(p+2));
		if (b>='A' && b<='F')
		    *q += (b-'A')+10;
		else if (b>='0' && b<='9')
		    *q += (b-'0');
		else return data; /* Error */
		*q++; *q=0;       /* Null-terminate the result */
		p += 3;

	    } else {
		*q = *p;
		if (*(p+1)) {
		    *(q+1) = *(p+1);
		    *(q+2) = 0;  /* *(p+2) must be 0, see if condition */
		} else {
		    *(q+1) = 0;
		}
		break;
	    }
		
	} else {
	    *q++ = *p++;
	    if (q != p) *q=0;
	}
    }

    return data;
}	/* End of HTDECODEHEX.	*/




/***********************************************************************
 *		HTSIMPLIFYURI
 ***********************************************************************
 *
 * SYNOPSIS:	Simplify a URL.
 * CALLED BY:	Client.
 * RETURN:	The simplified passed in URL.
 * SIDE EFFECTS:
 *	
 * STRATEGY: Ported from W3C HTSimplify in HTParse.c.
 *
 * A URI is allowed to contain the seqeunce xxx/../ which may be
 * replaced by "" , and the seqeunce "/./" which may be replaced by "/".
 * Simplification helps us recognize duplicate URIs. 
 *
 *	Thus, 	/etc/junk/../fred 	becomes	/etc/fred
 *		/etc/junk/./fred	becomes	/etc/junk/fred
 *
 *      but we should NOT change
 *		http://fred.xxx.edu/../..
 *
 *	or	../../albert.html
 *
 * In order to avoid empty URLs the following URLs become:
 *
 *		/fred/..		becomes /fred/..
 *		/fred/././..		becomes /fred/..
 *		/fred/.././junk/.././	becomes /fred/..
 *
 * If more than one set of `://' is found (several proxies in cascade) then
 * only the part after the last `://' is simplified.
 *
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/31/96   	Initial Revision
 *
 ***********************************************************************/
char* _far _pascal
HTSIMPLIFYURI (char **url)
{
    char *path, *p;

    if (!url || !*url) return *url;

    PUSHDS;
    SET_DS_LIB_DGROUP;

    /* Find any scheme name */
    if ((path = strstr(*url, "://")) != NULL) {		   /* Find host name */

	char *newptr;
	char *access = *url;
	while (access<path && (*access=TOLOWER(*access)) != NULL) access++;
	path += 3;

	while ((newptr = strstr(path, "://")) != NULL)        /* For proxies */
	    path = newptr+3;
	path = HTCanonURI(url, path);       	      /* We have a host name */

    } else if ((path = strstr(*url, ":/")) != NULL) {
	path += 2;

    } else
	path = *url;

    if (*path == '/' && *(path+1)=='/') {	  /* Some URLs start //<foo> */
	path += 1;

    } else if (!strncmp(path, "news:", 5)) {
	char *ptr = strchr(path+5, '@');
	if (!ptr) ptr = path+5;

	while (*ptr) {			    /* Make group or host lower case */
	    *ptr = TOLOWER(*ptr);
	    ptr++;
	}

	POPDS;
	return *url;		      /* Doesn't need to do any more */
    }

    if ((p = path)!=NULL) {

	char *end;
	if (!((end = strchr(path, ';')) != NULL || 
	      (end = strchr(path, '?')) != NULL ||
	      (end = strchr(path, '#')) != NULL))
	    end = path+strlen(path);

	/* Parse string second time to simplify */
	p = path;
	while(p<end) {

	    if (*p=='/') {
		if (p>*url && *(p+1)=='.' && (*(p+2)=='/' || !*(p+2))) {

		    char *orig = p+1;
		    char *dest = (*(p+2)!='/') ? p+2 : p+3;

		    /* Remove a slash and a dot */
		    while ((*orig++ = *dest++) != NULL); 
		    end = orig-1;

		} else if (*(p+1)=='.' && *(p+2)=='.' && (*(p+3)=='/' || !*(p+3))) {
		    char *q = p;

		    while (q>path && *--q!='/');	       /* prev slash */

		    if (strncmp(q, "/../", 4)) {
			char *orig = q+1;
			char *dest = (*(p+3)!='/') ? p+3 : p+4;
			/* Remove /xxx/.. */
			while ((*orig++ = *dest++) != NULL);
			end = orig-1;
			p = q;		      /* Start again with prev slash */

		    } else
			p++;

		} else if (*(p+1)=='/') {

		    while (*(p+1)=='/') {
			char *orig=p, *dest=p+1;
			/* Remove multiple /'s */
			while ((*orig++ = *dest++) != NULL);
			end = orig-1;
		    }

		} else
		    p++;

	    } else
		p++;
	}
    }

    POPDS;
    return *url;
}	/* End of HTSIMPLIFYURI.	*/




/***********************************************************************
 *		HTPARSEURI
 ***********************************************************************
 *
 * SYNOPSIS:	Return those parts of a name which are given and 
 *              requested. We substitute parts from the related name 
 *              where necessary. The HTMemory returned must be *freed*.
 *
 * CALLED BY:	Client.
 * PASS:        aName
 *                 - absolute URL or filename given relatedName.
 *                 - related name to aName. Pass NULL if aName is absolute.
 *              wanted
 *                 - a mask for the parts which are wanted.
 * RETURN:	HTMemory, must be freed be caller or NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    This routine will replace HTParseURI. 
 *              Ported from W3C HTParse HTParse.c. and extended by kkee.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	10/31/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTPARSEURI (const char *aName, const char *relatedName, word wanted)
{
    HTMemHandle memName, memRel, memResult;
    HTMemHandle memReturn = NULL;
    char * ret;
    char * result = 0;
    int len;
    char * name = 0;
    char * rel = 0;
    char * p;
    char * access;
    HTURI given, related;
    
    PUSHDS;
    SET_DS_LIB_DGROUP;

    if (!relatedName)        /* HWL 23/8/94: dont dump due to NULL */
        relatedName = "";
    
    /* Make working copies of input strings to cut up */
    len = strlen(aName)+strlen(relatedName)+10;

    memName = HTMemAlloc(strlen(aName)+1);
    memRel = HTMemAlloc(strlen(relatedName)+1);
    /* Lots of space: more than enough */
    memResult = HTMemAlloc(len);

    if (!memName || !memRel || !memResult) {
	if (memName) HTMemFree(memName);
	if (memRel) HTMemFree(memRel);
	if (memResult) HTMemFree(memResult);
	POPDS;
	return NULL;
    }

    name = (char *) HTMemLock(memName);
    rel = (char *) HTMemLock(memRel);
    result = (char *) HTMemLock(memResult);

    strcpy(name, aName);
    p = name;
    while ((p=strchr(name, '\\'))!=NULL) 
	*p = '/';                      /* DOS style */
    strcpy(rel, relatedName);
    p = rel;
    while ((p=strchr(rel, '\\'))!=NULL) 
	*p = '/';                      /* DOS style */

    /* Modifies name and rel */
    HTScanURI(name, &given);
    HTScanURI(rel,  &related); 
    result[0]=0;		/* Clear string  */
    access = given.access ? given.access : related.access;

    if (wanted & HTURI_PARSE_ACCESS)
        if (access) {
	    strcat(result, access);
	    if(wanted & HTURI_PARSE_PUNCTUATION) strcat(result, "://");
	}
	
    if (given.access && related.access)	/* If diff access, inherit nothing. */
        if (strcmp(given.access, related.access)!=0) {
	    related.host=0;
	    related.port=0;
	    related.absolute=0;
	    related.relative=0;
	    related.anchor=0;
	}
	
    if (wanted & HTURI_PARSE_HOST)
        if(given.host || related.host) {
	    strcat(result, given.host ? given.host : related.host);
	}
	
    if ((given.host && related.host)) /* If diff hosts, inherit no path. */
        if ((strcmp(given.host, related.host)!=0)) {
	    related.port=0;
	    related.absolute=0;
	    related.relative=0;
	    related.anchor=0;
	}

    if ((given.port && related.port)) /* If diff ports, inherit no path. */
        if ((strcmp(given.port, related.port)!=0)) {
	    related.absolute=0;
	    related.relative=0;
	    related.anchor=0;
	}

    if (wanted & HTURI_PARSE_PORT)
	if (given.port || related.port) {
	    if(wanted & HTURI_PARSE_PUNCTUATION) strcat(result, ":");
	    strcat(result, given.port ? given.port : related.port);
	}

    if (wanted & HTURI_PARSE_PATH) {
        if(given.absolute) {				/* All is given */
	    if(wanted & HTURI_PARSE_PUNCTUATION) strcat(result, "/");
	    strcat(result, given.absolute);
	} else if(related.absolute) {	/* Adopt path not name */
	    strcat(result, "/");
	    strcat(result, related.absolute);
	    if (given.relative) {
		p = strchr(result, '?');	/* Search part? */
		if (!p) p=result+strlen(result)-1;
		for (; *p!='/'; p--);	/* last / */
		p[1]=0;					/* Remove filename */
		strcat(result, given.relative);		/* Add given one */
	    }
	} else if(given.relative) {
	    strcat(result, given.relative);		/* what we've got */
	} else if(related.relative) {
	    strcat(result, related.relative);
	} else {  /* No inheritance */
	    strcat(result, "/");
	}
    }
		
    if (wanted & HTURI_PARSE_ANCHOR)
	if(given.anchor) {
	    if(given.absolute && given.anchor) {   /*Fixes for relURLs...*/
		if(wanted & HTURI_PARSE_PUNCTUATION) strcat(result, "#");
		strcat(result, given.anchor); 
	    } else if (!(given.absolute) && !(given.anchor)) {
		strcat(result, "");
	    } else {
		if(wanted & HTURI_PARSE_PUNCTUATION) strcat(result, "#");
		strcat(result, given.anchor);
	    }
	}

    HTMemUnlockAndFree(memName);  
    HTMemUnlockAndFree(memRel);
    
    ret = (char *) HTMemAllocAndLock(&memReturn, strlen(result)+1);
    strcpy(ret, result);
    HTMemUnlockAndFree(memResult);
    
    HTMemUnlock(memReturn);           /* Must unlock */

    POPDS;
    return memReturn;	        /* exactly the right length */
}	/* End of HTPARSEURI.	*/




/***********************************************************************
 *		HTPARSEHTMEMHANDLEURI
 ***********************************************************************
 *
 * SYNOPSIS:	Same as HTParseURI, but take HTMemHandle.
 *
 * CALLED BY:	Client.
 * RETURN:	HTMemHandle or NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/29/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTPARSEHTMEMHANDLEURI (const HTMemHandle aName,
		       const HTMemHandle relatedName, word wanted)
{
    HTMemHandle ret;
    char *a = NULL, *r = NULL;

    if (aName) a = (char *) HTMemLock(aName);
    if (relatedName) r = (char *) HTMemLock(relatedName);

    ret = HTParseURI(a, r, wanted);

    if (aName) HTMemUnlock(aName);
    if (relatedName) HTMemUnlock(relatedName);

    return ret;
}	/* End of HTPARSEHTMEMHANDLEURI.	*/




/***********************************************************************
 *		HTDEFAULTPORT
 ***********************************************************************
 *
 * SYNOPSIS:	Assign default port to a URL.
 * CALLED BY:	Client
 * RETURN:	Port number or -1 if there is no default.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	5/21/97   	Initial Revision
 *	
 ***********************************************************************/
int _far _pascal
HTDEFAULTPORT (const char *url)
{
    char *p;
    int ret;

    if (!url) return -1;
    p = strchr(url, ':');
    if (!p) return -1;
    *p = 0;

    PUSHDS;
    SET_DS_LIB_DGROUP;
    if (!strncasecmp(url, "http", 4))
	ret = 80;
    else if (!strncasecmp(url, "smtp", 4))
	ret = 25;
    else if (!strncasecmp(url, "imap", 4))
	ret = 143;
    else 
	ret = -1;
    POPDS;

    *p = ':';         /* Must restore! */
    return ret;
}	/* End of HTDEFAULTPORT.	*/



/***********************************************************************
 *		HTFILEURIOPEN
 ***********************************************************************
 *
 * SYNOPSIS:	Open a file URL.
 * CALLED BY:	Client
 * RETURN:	FileHandle if open, else NULL.
 *	
 * STRATEGY:	
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	kkee    	8/15/97   	Initial Revision
 *	
 ***********************************************************************/
FileHandle _far _pascal
HTFILEURIOPEN (const char *url)
{
    char *cptr;
    FileHandle fileHandle = NULL;
    HTMemHandle temp;
    int maxlen = 2*strlen(url);
    char *buffer = HTMemAllocAndLock(&temp, maxlen);

    PUSHDS;
    SET_DS_LIB_DGROUP;

    /* 
     * Get fullpath filename & try to open it.
     */
    cptr = strcasestr(url, "file://");

    if (cptr && cptr+7) 
	strncpy(buffer, cptr+7, maxlen);
    else 
	*buffer = 0;

    while ((cptr=strchr(buffer, '/'))!=NULL) 
	*cptr = '\\';                      /* DOS style */

    /* 
     * Attempt to open file. We try the following options.
     * if "/f:/pene.ec/file.htm", try "f:/pene.ec/file.htm".
     * if "SP_PRIVATE_DATA/dir/filename, try dir/filename
     *    relative to SP_PRIVATE directory.
     * if "f:/pene.ec/file.htm" try as is.
     * if "/document/file.htm" try "document/file.htm" 
     *                  relative to SP_TOP.
     * if "document/file.htm" try relative to SP_TOP.
     */

    /* Always assume relative to SP_TOP directory */
    FilePushDir();
    FileSetStandardPath(SP_TOP);

    if (buffer[0] == '\\') {
	/* Absolute directory */
	fileHandle = FileOpen(buffer+1, FILE_DENY_W | FILE_ACCESS_R);

	/* 
	 * If failed, check for Geos std directories, such
	 * as file:///SP_PRIVATE_DATA/dir/filename
	 */
	if (!fileHandle && ((cptr = strchr(buffer+1, '\\')) != NULL)) {
	    StandardPath ret;
	    *cptr = 0;
	    ret = GeosStandardPathMap(buffer+1);
	    if (ret != SP_NOT_STANDARD_PATH) {
		FilePushDir();
		FileSetStandardPath(ret);
		fileHandle = FileOpen(cptr+1, FILE_DENY_W | FILE_ACCESS_R);
		FilePopDir();
	    }
	    *cptr = '\\'; /* Restore */
	}
	
	/* 
	 * If failed, see if we have a file://localhost/ as 
	 * specified by RFC1738.
	 */
	if (!fileHandle && !strncasecmp(buffer, "\\localhost\\", 11)) {
	    fileHandle = FileOpen(buffer+11, FILE_DENY_W | FILE_ACCESS_R);
	}
		
    } else {
	fileHandle = FileOpen(buffer, FILE_DENY_W | FILE_ACCESS_R);

	/* If failed, try "f/filename" with "f:/filename" */
	if (!fileHandle && buffer[1]=='\\') {
	    HTMemHandle abs;
	    char *c = (char *) HTMemAllocAndLock(&abs, strlen(buffer)+2);
	    *c = buffer[0];
	    *(c+1) = ':';
	    strcpy(c+2, buffer+1);
	    fileHandle = FileOpen(c, FILE_DENY_W | FILE_ACCESS_R);
	    HTMemUnlockAndFree(abs);
	}

	/* If failed, try Geos std directories, such as 
	 * file://SP_TOP/dir/filename.
	 */
	if (!fileHandle && ((cptr = strchr(buffer, '\\')) != NULL)) {
	    StandardPath ret;
	    *cptr = 0;
	    ret = GeosStandardPathMap(buffer);
	    if (ret != SP_NOT_STANDARD_PATH) {
		FilePushDir();
		FileSetStandardPath(ret);
		fileHandle = FileOpen(cptr+1, FILE_DENY_W | FILE_ACCESS_R);
		FilePopDir();
	    }
	    *cptr = '\\';  /* Restore */
	}
    }

    FilePopDir();
    HTMemUnlockAndFree(temp);
    POPDS;
    return fileHandle;
}	/* End of HTFILEURIOPEN.	*/
