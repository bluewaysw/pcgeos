@include <stdapp.goh>
#include <WWW/htmem.h>
@include <WWW/HTCore/htaautil.goh>
@include <WWW/HTCore/htutils.goh>
@include <WWW/HTCore/htstring.goh>
#include <Ansi/string.h>


/***********************************************************************
 *		HTAATemplateMatch
 ***********************************************************************
 *
 * SYNOPSIS:	Uses a template string to match the filename against, 
 *              may contain a single wildcard char '*' which matches 
 *              zero or more arbitrary characters.
 * CALLED BY:	HTAA
 * RETURN:	TRUE if filename matches the template, else FALSE.
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	11/27/96   	Initial Revision
 *
 ***********************************************************************/
Boolean _far _pascal 
HTAATemplateMatch (const char *template, const char *filename)
{
    const char *p = template;
    const char *q = filename;
    int m;

    if (!template || !filename) 
	return FALSE;

    for(; *p && *q && *p == *q; p++, q++)	/* Find first mismatch */
	; /* do nothing else */

    if (!*p && !*q)
	return TRUE;            	/* Equally long equal strings */
    else if ('*' == *p) {		/* Wildcard */
	p++;				/* Skip wildcard character */
	m = strlen(q) - strlen(p);	/* Amount to match to wildcard */
	if (m < 0) return FALSE;	/* No match, filename too short */
	else {			/* Skip the matched characters and compare */
	    if (strcmp(p, q+m))	return FALSE;	/* Tail mismatch */
	    else                return TRUE;	/* Tail match */
	}
    }	/* if wildcard */

    return FALSE;	/* Length or character mismatch */
}	/* End of HTAATemplateMatch.	*/




/***********************************************************************
 *		HTAAMakeProtectionTemplate
 ***********************************************************************
 *
 * SYNOPSIS:	Create a protection template for the files in the same 
 *              directory as the given file. (Used by client if server
 *              does not provide WWW-ProtectionTemplate: field).
 *
 *              Uses HTMemeory. So all stored pointers to HTMemory
 *              may be invalidated!!
 *
 * CALLED BY:	Client
 * RETURN:	HTMemHandle, must be freed by caller. Else NULL.
 * SIDE EFFECTS:
 *	
 * STRATEGY:    A template is created that matches docname and other 
 *              files in that directory.
 *
 *               e.g., /foo/bar/x.html  => foo/bar/ *
 *                                                 ^
 *                         We put a space here to prevent it from being
 *                         a C langugage start comment marker, there 
 *                         really isn't any space.
 *	
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	12/10/96   	Initial Revision
 *
 ***********************************************************************/
HTMemHandle _far _pascal
HTAAMakeProtectionTemplate (const HTMemHandle docname)
{
    HTMemHandle ret = NULL;
    
    if (docname) {
	char *p, *slash;

	ret = HTStrHTMemAllocCopy(docname);
	if (!ret) return NULL;
	p = (char *) HTMemLock(ret);
	slash = strrchr(p, '/');
	if (slash) slash++;
	else slash = p;
	*slash = (char)0;
	HTMemUnlock(ret);
	PUSHDS;
	SET_DS_LIB_DGROUP;  /* To use "*" */
	HTStrAllocCat(ret, "*");
	POPDS;
    }

    return ret;
}	/* End of HTAAMakeProtectionTemplate.	*/
