@ifndef __HT_NETMAN_GOH
@define __HT_NETMAN_GOH

@include <stdapp.goh>
@include <socket.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htnet.goh>
@include <WWW/HTCore/htpolicy.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htlist.goh>

/* --------------------------------------------------------------------------
 * 		I. CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/

/*
 * Maintains registered "before" and "after" callback functions.
 */
typedef struct {
    HTNetCallback     HTNC_cbf;         /* vitual fptr to callback function */
    int               HTNC_status;
} HTNetCall;


/* --------------------------------------------------------------------------
 * 		Inter-Library Routines
 * --------------------------------------------------------------------------*/

/* XXX */
/*
 * extern int _far _pascal
 *	HTNetExecuteIntermediateCallback(HTListHandle callbackList,
 *				HTRequestHandle request, int status);
 */
#define HTNetExecuteIntermediateCallback HTNetExecuteCallback

extern int _far _pascal
	HTNetExecuteCallback (HTListHandle callbackList, 
				HTRequestHandle request, int status);

extern int _far _pascal
	HTNetNewClient(HTRequestHandle request);

extern int _far _pascal
	HTNetKill(HTRequestHandle request, int status);

extern int _far _pascal
	HTNetKillAll(GeodeHandle client, int status);

@endif /* __HT_NETMAN_GOH */



