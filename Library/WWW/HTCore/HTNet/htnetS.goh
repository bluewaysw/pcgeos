@ifndef __HT_NETS_GOH
@define __HT_NETS_GOH

@include <stdapp.goh>
@include <socket.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htnet.goh>
@include <WWW/HTCore/htpolicy.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htlist.goh>

@include "HTNet/htnetMan.goh"
#include <sem.h>


/* --------------------------------------------------------------------------
 * 		Data types
 * --------------------------------------------------------------------------*/

/* 
 * Currently, a HTNet thread consists a protocol and its Library
 * information. I anticipate we will add more info later on...
 */
typedef struct {
    GeodeHandle HTNT_owner;                  /* owner of this thread */
    HTRequestHandle HTNT_request;            /* the request being served */
    HTStreamHandle HTNT_protocolHandler;     /* protocol object itself */
    int HTNT_status;                         /* the previous status being
						scheduled by the scheduler */
} HTNetThread;


/* --------------------------------------------------------------------------
 * 		HTNetSchedulerClass
 * --------------------------------------------------------------------------*/

@class HTNetSchedulerClass, ProcessClass;

/*
 * Create a new protocol client and add that to scheduler thread. 
 *
 * You should *NOT* create a protocol yourself as that would certainly
 * cause deadlock if you are using ObjInstantiateForThread to instantiate
 * a protocol object for the policyThread and add it using 
 * MSG_HTNS_ENQUEUE_THREAD.
 *
 * Context:	Cooperative multitasking
 * Source:	HTNetNewClient.
 * Destination:	Anyone.
 * Interception:Not necessary.
 */
@message void MSG_HTNS_NEW_CLIENT(HTRequestHandle request);


/*
 * Use this method to inform the scheduler everytime a new thread has 
 * been enqueue. You should send the message using forceQueue, 
 * checkDuplicate, and replace options.
 *
 * Context:	Cooperative Multitasking
 * Source:	self.
 * Destination:	self.
 * Interception:Not recommended as you need not inherit this class.
 * Pass:        Nothing
 * Return:      Nothing
 */
@message void MSG_HTNS_SCHEDULE_ROUND_ROBIN();


/*
 * Schedule a Net thread by entering it in the round robin queue.
 *
 * Context:	Cooperative Multitasking
 * Source:	Anyone.
 * Destination: Anyone.	
 * Interception:Not recommended as you need not inherit this class.
 * Pass:        net = the Net thread to schedule.
 * Return:      Nothing.
 * 
 */
@message void MSG_HTNS_ENQUEUE_THREAD(HTNetThread netThread);


/*
 * Unschedule a Net thread by removing it from the round robin queue.
 * The Net object is deleted.
 *
 * Context:	Cooperative Multitasking
 * Source:	Anyone
 * Destination:	Anyone
 * Interception:Not recommended as you need not inherit this class.
 * Pass:        protocol = the Network protocol thread to dequeue.
 *              status = the condition on why the protocol is dequeued.
 * Return:      Nothing.
 */
@message void MSG_HTNS_DEQUEUE_THREAD(HTStreamHandle protocol,	
					 int status);

/*
 * Unschedule all Net threads for a particular client. 
 *
 * Context:	Cooperative Multitasking
 * Source:	Anyone
 * Destination:	Anyone
 * Interception:Not recommended.
 * Pass:        client = a WWW library client.
 *              status = status to pass to "after" callbacks after killing
 *                       each request.
 * Return:      Nothing
 */
@message void MSG_HTNS_DEQUEUE_THREADS_FOR(GeodeHandle client, int status);

@endc

@endif /* __HT_NETS_GOH */

