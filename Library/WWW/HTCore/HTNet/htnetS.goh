@ifndef __HT_NETS_GOH
@define __HT_NETS_GOH

@include <stdapp.goh>
@include <socket.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htnet.goh>
@include <WWW/HTCore/htpolicy.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htsock.goh>

@include "HTNet/htnetMan.goh"
#include <sem.h>


/* --------------------------------------------------------------------------
 * 		Data types
 * --------------------------------------------------------------------------*/
#define MAX_HTNET_THREADS 3


/* --------------------------------------------------------------------------
 * 		HTNetSchedulerClass
 * --------------------------------------------------------------------------*/

@class HTNetSchedulerClass, ProcessClass;

/*
 * Create a new net client. It has to be done here instead of in HTNetNewClient
 * because all "after" callbacks must be executed here.
 *
 * Context:	Cooperative Multitasking
 * Source:	HTNetNewClient
 * Destination:	self.
 * Interception:self.
 */
@message void MSG_HTNS_NEW_CLIENT(HTRequestHandle request);


/*
 * Use this method to inform the scheduler everytime a new thread has 
 * been enqueue. You should send the message using forceQueue, 
 * checkDuplicate, and replace options.
 *
 * Context:	Cooperative Multitasking
 * Source:	self.
 * Destination:	self.
 * Interception:Not recommended as you need not inherit this class.
 * Pass:        Nothing
 * Return:      Nothing
 */
@message void MSG_HTNS_SCHEDULE_ROUND_ROBIN();


/*
 * Network has disconnected. So our Net scheduler must terminate all
 * pending Net threads, including ones with persistent connections.
 *
 * Context:	Cooperative Multitasking
 * Source:	self
 * Destination:	self
 * Interception:No.
 * Pass:        Nothing
 * Return:      Nothing
 */
@message void MSG_HTNS_NETWORK_DISCONNECTED();

@endc

@endif /* __HT_NETS_GOH */

