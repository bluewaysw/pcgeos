@ifndef __LOCAL_CACHE_GOH__
@define __LOCAL_CACHE_GOH__

@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htreqMan.goh>
@include <WWW/htcache.goh>


/*  
**  HTCacheItem maintains a cacheable data object. Its our internal
**  database item of a cache.
*/
typedef struct {
    HTMemHandle       HTCI_url;
    HTCacheType       HTCI_ctype;            /* Persistent or not */
    char              HTCI_filename[13];     /* string equivalent of 
						filenumber + file extension */
    dword             HTCI_filesize;         /* filesize in bytes */
    HTMemHandle       HTCI_expires;          /* Time the cache file expires 
					        in GMT */
} HTCacheItem;


#define HTCACHE_HASH_TABLE_SIZE   51   /* Tunable to any prime number */
extern word fileNumber;                /* 1 to 65535 */
extern dword totalSize;                /* Current total cache size used */
extern HTListHandle htCacheHashTable[];/* List of cached items */



/****************************************************************************

  The HTCacheWriterClass and HTCacheReaderClass are inherited from HTStream 
  defined in htstream.goh{goc}.  

 ****************************************************************************/

@class HTCacheWriterClass, HTStreamClass;


/*
 * Set cache file info.
 *
 * Context:	Record keeping of a cached file.
 * Source:	HTCacheWriterCreate
 * Destination:	Cache objects.
 * Interception:Not necessary.
 * Pass:        HTCacheItem.
 * Return:      TRUE if ok, else FALSE.
 */
@message Boolean MSG_HT_CACHE_SET_INFO(HTCacheItem *cache);


/* --------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------*/

/*
 * Cached item.
 */
@instance HTCacheItem HTCI_cache;
@instance FileHandle HTCI_fileHandle;

@endc;

void _pascal HTCacheInitItem (HTRequest *rptr, HTCacheItem *cache, 
			      const char *fileType, HTCacheType ctype);
void _pascal HTCacheAppendItem(HTCacheItem *item);
void _pascal HTCacheDeleteItem(HTCacheItem *cache);

@endif /* @ifndef __LOCAL_CACHE_GOH__ */
