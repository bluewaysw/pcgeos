@ifndef __HT_FATALS_GOH__
@define __HT_FATALS_GOH__

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    BUFFER_SIZE_NOT_BIG_ENOUGH,
    HTCACHE_CANNOT_DELETE_LOCKED_ITEM,
    HTCACHE_ATTEMPT_TO_ADD_GARBAGE_COLLECTED_ITEM
} FatalErrors;
#endif /* ERROR_CHECK */

/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    CORRUPTED_HTCACHE_INDEX_FILE,
    HTCACHE_QUEUE_CORRUPTED,
    HTCACHE_QUEUE_EMPTY,
    HTCACHE_QUEUE_FULL,
    UNABLE_TO_CREATE_HTCACHE_INDEX_FILE
} Warnings;
#endif

#if ERROR_CHECK
extern FatalErrors htcacheFatalErrors;
extern Warnings    htcacheWarnings;
#endif 

@endif
