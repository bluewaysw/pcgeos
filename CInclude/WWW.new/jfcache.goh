DESCRIPTION:

	The Hypertext Cache. HTCache manages temporary disk files 
	which contain the contents of remote cacheable data objects.
	
	I have not yet thought about a memory cache as we don't need
	one for the RAM-limited devices. Memory cache would store
	parsed tokens that are ready for display.

	$Id: jfcache.goh,v 1.1.4.1 97/09/05 10:11:11 jeremyb Exp $

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/

@ifndef __JF_CACHE_GOH__
@define __JF_CACHE_GOH__

@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htanchor.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htreq.goh>
#include <WWW/htmem.h>
#include <Ansi/stdio.h>                /* FILE & operations */

/*
**         Handling the "Expires" Header
**         -----------------------------
**
**  There are three ways to handling the "Expires" header when met in 
**  the history.
** 
**  1. It can be ignored all together. 
**  2. The user can be notified with a warning.
**  3. The document can be reloaded automatically.
** 
**  This flag decides what action to be taken. The default action is 
**  HT_EXPIRES_IGNORE. In HT_EXPIRES_NOTIFY mode, you can specify a 
**  message to tell the user. 
**
**  THESE OPTIONS ARE NOT IMPLEMENTED -kkee 2/3/97
*/
typedef enum {
    HT_EXPIRES_IGNORE,                /* ignore file */
    HT_EXPIRES_NOTIFY,                /* notify user */ 
    HT_EXPIRES_AUTO                   /* auto load */
} HTExpiresMode;


/*
**        Memory Cache Management
**        -----------------------
** There are two kinds of local cache: a file cache and a memory cache.
** The memory cache is handled by the client and the file cache is 
** handled by the Library. Often the format of a data object cache in
** memory is a parsed hypertext data object ready to be displayed. 
** However, memory cache is optional. And for now, I don't plan on 
** implementing it.
**
*/
/* @@@ */


/*
**        Disk Cache Management
**        ---------------------
** Only one disk cache. All clients same the same disk cache. There is no
** good reason to have multiple disk caches as the Web network is all 
** connected and disk cache is a subweb!
**
*/

/*
**     HTCACHE_INDEX file uses the following format
**     --------------------------------------------
**
**     URL Filename TimerDateAndTime 
**
**     where,
**
**       URL               = canonical URL
**
**       Filename          = numeric value + input format (e.g,
**                           "7324.mim" for MIME formatted file,
**                           "9024.gif" for gif formatter file).
**
**       TimerDateAndTime  = cached file expiration    *** NOT USED ***
*/

typedef struct {
    int               HTCI_inUse;            /* 1 to lock a cache file */
    HTMemHandle       HTCI_url;
    char              HTCI_filename[13];     /* string equivalent of 
						filenumber + file extension */
    char              HTCI_fileext[4];       /* File extension, determined
					        from inputFormat */
    dword             HTCI_filesize;         /* filesize in bytes */
    Boolean           HTCI_garbageCollect;   /* TRUE if to be garbage 
						collected */
 /* TimerDateAndTime  HTCI_expires; */       /* Time the cache file expires 
					        in GMT. NOT USED */

    HTMemHandle       HTCI_next;             /* Implements a double linked */
    HTMemHandle       HTCI_prev;	     /* list */
} HTCacheItem;


/****************************************************************************

  The HTCacheWriterClass and HTCacheReaderClass are inherited from HTStream 
  defined in htstream.goh{goc}.  

 ****************************************************************************/

@class HTCacheWriterClass, HTStreamClass;


/*
 * Set cache file info.
 *
 * Context:	Record keeping of a cached file.
 * Source:	HTCacheWriterCreate
 * Destination:	Cache objects.
 * Interception:Not necessary.
 * Pass:        HTCacheItem.
 * Return:      TRUE if ok, else FALSE.
 */
@message Boolean MSG_HT_CACHE_SET_INFO(HTMemHandle cache);


/* --------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------*/

/*
 * Cached item.
 */
@instance HTMemHandle HTCI_cache;
@instance FileHandle HTCI_fileHandle;

@endc;


extern void _far _pascal HTCacheEnable(void);

extern void _far _pascal HTCacheDisable(void);

extern Boolean _far _pascal HTCacheIsEnabled(void);

extern HTMemHandle _far _pascal HTCacheGetReference(HTMemHandle url);

extern void _far _pascal HTCacheSetLimit(dword limit);

extern void _far _pascal HTCacheClear(void);

extern HTStreamHandle _far _pascal
	HTCacheWriterCreate(HTStringHandle inputFormat,
			    HTStreamHandle outputStream,
			    HTRequestHandle request);

#ifdef __HIGHC__
pragma Alias(HTCacheEnable, "HTCACHEENABLE");
pragma Alias(HTCacheDisable, "HTCACHEDISABLE");
pragma Alias(HTCacheIsEnabled, "HTCACHEISENABLED");
pragma Alias(HTCacheGetReference, "HTCACHEGETREFERENCE");
pragma Alias(HTCacheSetLimit, "HTCACHESETLIMIT");
pragma Alias(HTCacheClear, "HTCACHECLEAR");
pragma Alias(HTCacheWriterCreate, "HTCACHEWRITERCREATE");
#endif
@endif
