@ifndef __UIGENERA_GOH__
@define __UIGENERA_GOH__

@deflib uigenera

@include <stdapp.goh>
#include <ec.h>
@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/sgml.goh>
@include <WWW/htmlDTD.goh>

#define TAB_SIZE		168	/* tab point size * 8 */
#define TAB_POINT		TAB_SIZE / 8
@ifdef PRODUCT_NIKE
#define X_SCREEN_SIZE		620	/* screen width for ensdemo */
#define Y_SCREEN_SIZE		460	/* screen height for ensdemo */
@else
#define X_SCREEN_SIZE		386	/* screen width for penelope */
#define Y_SCREEN_SIZE		165	/* screen height for penelope */
@endif
#define HR_HEIGHT_Y		5	/* default height for <HR> */
#define ROW_SIZE		25      /* table's intial number of rows */
#define COLUMN_SIZE		5       /* table's inital number of columns */
#define BITMAP_X                4       /* x 32 = num of table columns */
#define BITMAP_Y                8       /* x 32 = num of table rows */
#define BITS_N_DWORD            (sizeof(dword)*8)   /* 8 bits in a byte */
#define NESTED_MARGIN		14
#define MARGIN                  3       /* space between ui objects */
#define IMAGE_DEFAULT_SIZE	28	/* default wdth & hgt of image icon */
#define MEMORY_THRESHOLD	75000

#define DEFAULT_TEXT_MAX_LENGTH 2048

typedef ByteEnum ErrorCode;
#define UI_GEN_NO_ERROR 	0
#define UI_GEN_ERROR		1

typedef ByteEnum StyleType;
#define STYLE_STRIKE		40
#define STYLE_FONT		41
#define STYLE_ITALIC		42
#define STYLE_BOLD		43
#define STYLE_ANCHOR		44
#define STYLE_SUPERSCRIPT	45
#define STYLE_SUBSCRIPT		46
#define STYLE_HEADER		47
#define STYLE_FW_FONT		48
#define STYLE_PRE		49
#define STYLE_UL		50
#define STYLE_OL		51
#define STYLE_DL		52
#define STYLE_BQ		53
#define STYLE_ALIGN		54
#define STYLE_PARAGRAPH		55
#define STYLE_NOBR		56

typedef ByteEnum FontType;
#define STYLE_FONT_0		9
#define STYLE_FONT_1		11
#define STYLE_FONT_2		12
#define STYLE_FONT_3		14	/* default font size */
#define STYLE_FONT_4		18
#define STYLE_FONT_5		20
#define STYLE_FONT_6		22
#define STYLE_FONT_7		24
#define STYLE_FONT_8		30


typedef ByteEnum ElementType;
#define	ELEMENT_START		0
#define	ELEMENT_END		1

typedef ByteEnum CellType;
#define	CELL_DATA		0
#define	CELL_HEADER		1

typedef ByteEnum InputType;
#define INPUT_NONE		0
#define INPUT_TEXT		1
#define INPUT_PASSWORD		2
#define INPUT_CHECKBOX		3
#define INPUT_RADIO		4
#define INPUT_SUBMIT		5
#define INPUT_RESET		6
#define INPUT_HIDDEN		7
#define INPUT_IMAGE		8

typedef ByteEnum AlignType;
#define ALIGN_TOP		0
#define ALIGN_MIDDLE		1
#define ALIGN_BOTTOM		2

typedef ByteEnum AreaType;
#define AREA_RECT		0
#define AREA_CIRC		1
#define AREA_POLY		2
#define AREA_DEFAULT		3

typedef ByteEnum TriggerType;
#define	TRIGGER_RESET		INPUT_RESET
#define	TRIGGER_SUBMIT		INPUT_SUBMIT


#define DEFAULT_STYLE_FONT	STYLE_FONT_3
#define DEFAULT_BASEFONT	3
#define DEFAULT_ALIGNMENT	J_LEFT


/*
 * listGroup defines a stack element.  It stores information about the list
 * groups like <UL> and <OL>.
 */
typedef struct {
	StyleType	LG_groupType;	/* <OL> or <UL>			*/
	dword		LG_counter;	/* keep track the number for the 
					   next ordered list item.	*/
	char		LG_displayType;	/* style of items:
					   A = use large letters
					   a = use small letters
					   I = use large Roman numerials
					   i = use small Roman numerials
					   1 = use numbers		*/
} ListGroup;

/* ************************************************************************
	Class definitions and Messages
************************************************************************ */

@importMessage MetaApplicationMessages, void MSG_META_UIG_SELECT_ALL();
@importMessage MetaApplicationMessages, void MSG_META_UIG_SELECT_NONE();
@importMessage MetaApplicationMessages, void MSG_META_UIG_CALC_POSITION();


/************************************************************************
 *  HTGenTextClass represent the text on the page.
 */
@class HTGenTextClass, GenTextClass;
 @message void MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
	(ElementType type, TextStyle style);
 @message GStateHandle MSG_GEN_TEXT_INITIALIZE(optr content);
 @message void MSG_GEN_TEXT_RECORD_HREF
	(ElementType type, int token);
 @message int MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
	(word xPosition, word yPosition);
 @message void MSG_GEN_TEXT_DRAW_FOCUS
	(int direction, Rectangle *obj, RectDWord *rect, 
	RectDWord *ret, Rectangle *box);
 @message void MSG_GEN_TEXT_UNDRAW_FOCUS(optr newLink);
 @message Boolean MSG_GEN_TEXT_FIND_LINK_IN_RECT
	(RectDWord rect, int direction);
 @message Boolean MSG_GEN_TEXT_IS_MULTILINE();
	/*
	 *  gstate used to calculate the min width requre to draw
	 *  the text. Not allocated by HTGenTextClass, but reuse
	 *  VTI_gstate. So no need to free.
	 */
	@instance GStateHandle HTGT_gstate;
	/*
	 *  Accumulate the length of the text, used to set the width
	 *  of the text object.  MaxLen keeps the max length seen so
	 *  so far.
	 */
	@instance int	HTGT_maxLen;
	@instance int	HTGT_accLen;
	/*
	 *  Is this object being selected?
	 */
	@instance Boolean HTGT_selected;
        /*
	 *  Store the hyperlink segments in the text body.
	 */
	@instance HTListHandle HTGT_anchorList;
	/*
	 *  Anchor index of the link in focus.  Used to do quick search.
	 *  -1 if the text object doesn't have the focus.
	 */
	@instance int	HTGT_focalAnchor;
	/*
	 *  if HTGT_focalAnchor != -1, HTGT_focalBound has the bound.
	 */
	@instance RectDWord	HTGT_focalBound;
        @instance Rectangle     HTGT_focalBox;
	/*
	 *  HTGT_content contains all the formating info and the page
	 *  height array information.
	 */
	@instance optr   HTGT_content;
	/*
	 *  Suggested x Postion in a row.
	 */
	@instance int   HTGT_xPos;
	/*
	 *  Suggested row position.
	 */
	@instance int   HTGT_pageRow = -1;
	/*
	 *  the calculated size before the object vis part is built.
	 */
	@instance SizeAsDWord   HTGT_guessSize;
	/*
	 *  Alignment.
	 */
	@instance Justification HTGT_align = J_LEFT;
	/*
	 *  Is the text object has more than one line?  This bit saves
	 *  me the effort of calculating the line positions of first and
	 *  last text offsets.
	 */
	@instance Boolean	HTGT_multiline = FALSE;

@endc;


/************************************************************************
 *  HTGenFormTextClass represents <INPUT TYPE = "TEXT" or "PASSWORD">
 */
@class HTGenFormTextClass, GenTextClass;
 @message void MSG_GEN_FORM_TEXT_PROCESS_ATTRIBUTE
	(ChunkHandle block, SGMLEntity *entity, optr content);
 @message void MSG_GEN_FORM_TEXT_INITIALIZE
	(HTMemHandle name, HTMemHandle value, optr content);
 @message void MSG_GEN_FORM_TEXT_SUBMIT(HTListHandle query);
 @message void MSG_GEN_FORM_TEXT_SET_FOCUS(RectDWord *ret);
 @message void MSG_GEN_FORM_TEXT_CLEAR_FOCUS();
	/*
	 *  HTGFT_name is the symbolic name of the field returned
	 *  to the server on submission.
	 */
	@instance HTMemHandle	HTGFT_name = 0;
	/*
	 *  HTGFT_value is the default text string returned to the server
	 *  on submission, if nothing entered in the user input field.
	 */
	@instance HTMemHandle	HTGFT_value= 0;
	 /*
	  *  HTGT_content contains all the formating info and the page
	  *  height array information.
	  */
	@instance optr	        HTGFT_content;
	 /*
	  *  HTGFT_xPos is the suggested x postion (in pixels) for the
	  *  object to appear in the row.
	  */
	@instance int	        HTGFT_xPos = 0;
	 /*
	  *  Suggested row position.
	  */
	@instance int	        HTGFT_pageRow= 0;
	/*
	 *  the calculated size before the object vis part is built.
	 */
	@instance SizeAsDWord   HTGFT_guessSize;
	 /*
	  *  The drawing bound for showing the navigation focus.
	  *  If RD_right != RD_left, it means this object is currently
	  *  having the navigation focus.
	  */
	@instance RectDWord	HTGFT_focalBound;
	/*
	 *  Alignment.
	 */
	@instance Justification HTGFT_align = J_LEFT;
	/*
	 *  Keep track of being in <NOBR> or not.
	 */
	@instance word		HTGFT_noBr;
@endc;


@class TextAreaClass, GenInteractionClass;
 @message void MSG_TEXT_AREA_PROCESS_ATTRIBUTE
	(ChunkHandle block, SGMLEntity *entity, optr content);
 @message void MSG_TEXT_AREA_INITIALIZE
	(HTMemHandle name, HTMemHandle value, optr content);
 @message void MSG_TEXT_AREA_SUBMIT(HTListHandle query);

 @message void MSG_TEXT_AREA_APPEND_TEXT_PTR(char *text, word len);

 @message void MSG_TEXT_AREA_FINISH();
 @message void MSG_TEXT_AREA_SET_FOCUS(RectDWord *rect);
 @message void MSG_TEXT_AREA_CLEAR_FOCUS();

	@instance HTMemHandle	TAI_name = 0;
	@instance HTMemHandle	TAI_value= 0;
	@instance optr	        TAI_content;
	@instance int	        TAI_xPos = 0;
	@instance int	        TAI_pageRow= 0;
	@instance SizeAsDWord   TAI_guessSize;
	@instance optr 		TAI_textObj;
	@instance HTMemHandle 	TAI_text;
	@instance Justification TAI_align = J_LEFT;
	@instance word		TAI_noBr;
	@instance word 		TAI_width;
	@instance word 		TAI_length;
	@instance RectDWord	TAI_focalBound;
@endc;


@class TextAreaTextClass, GenTextClass;
@message void MSG_TAT_SET_SIZE(word width, word length);
@message void MSG_TAT_SET_POSITION(word x, word y);
@message void MSG_TAT_SET_ROWS(word rows);
@message void MSG_TAT_SET_COLUMNS(word columns);
@message void MSG_TAT_INITIALIZE();
@message void MSG_TAT_DISPLAY_POSITION(word line);

/* the display window size */
@instance word TATI_width;
@instance word TATI_length;

/* the display window's position */
@instance word TATI_x;
@instance word TATI_y;

@instance word TATI_height; 

@instance Point TATI_origin;
@instance word TATI_rows;
@instance word TATI_columns;
@instance Point TATI_firstChar;
@instance word TATI_lineHeight;
@instance word TATI_charWidth;

@instance GStateHandle TATI_lastGState;
@instance word TATI_lastTMe32;

@endc;


/************************************************************************
 *  HTGenFormHiddenClass represent <INPUT TYPE = "HIDDEN">
 */
@class HTGenFormHiddenClass, GenInteractionClass;
 @message void MSG_GEN_FORM_HIDDEN_INITIALIZE
	(HTMemHandle name, HTMemHandle value);
 @message void MSG_GEN_FORM_HIDDEN_SUBMIT(HTListHandle query);
	/*
	 * HTGFH_name is the symbolic name of the field returned to
	 * the server on submission.
