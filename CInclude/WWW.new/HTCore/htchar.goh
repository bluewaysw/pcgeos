@ifndef __HT_CHAR_GOH__
@define __HT_CHAR_GOH_

@include <WWW/HTCore/htcbf.goh>
@include <WWW/HTCore/htstream.goh>

/****************************************************************************

  The HTCharClass is inherited from HTStreamClass defined in 
  htstream.goh{goc}.

 ****************************************************************************/

@class HTCharClass, HTStreamClass;

/*
 * Provide the character callback routine to convert the chars.
 *
 * Context:	Data conversion.
 * Source:	Protocols and converters wishing to use stream
 *          instead of callback.
 * Destination:	HTCharClass
 * Interception:No.
 */
@message void MSG_HTCHAR_SET_CALLBACK(CharConverterCallback cbf);

/*
 * The char converter callback routine.
 */
@instance CharConverterCallback HTLTI_cbf;

@endc

extern HTStreamHandle _far _pascal HTCharNew (HTRequestHandle request,
											  HTStreamHandle target,
 											  CharConverterCallback cbf);

#ifdef __HIGHC__
pragma Alias(HTCharNew, "HTCHARNEW");
#endif


@endif
