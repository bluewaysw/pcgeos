@ifndef __HT_FWRITE_GOH__
@define __HT_FWRITE_GOH_


@include <WWW/HTCore/htstream.goh>

/****************************************************************************

  The HTFWriteClass is inherited from HTStreamClass defined in 
  htstream.goh{goc}.

 ****************************************************************************/

@class HTFWriteClass, HTStreamClass;

/* --------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------*/

/*
 * Output file.
 */
@instance FileHandle HTFWI_fileHandle;

@endc

extern HTStreamHandle _far _pascal HTFWriteNew (const char *filename,
						ThreadHandle thread);

#ifdef __HIGHC__
pragma Alias(HTFWriteNew, "HTFWRITENEW");
#endif


@endif
