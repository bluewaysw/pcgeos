@ifndef __HT_TEE_GOH__
@define __HT_TEE_GOH__

@include <stdapp.goh>
@include <WWW/HTCore/htstream.goh>

/*
 * The resolver function prototype. The resolver function is used to 
 * resolve the return values from two target streams. retValue1 is
 * from target1 and retValue2 is from target2 in call to HTTeeCreate.
 * Data is first pushed to target1 and then target2. These return
 * values are then passed to HTTeeResolver. retValue3 is returned
 * to the prior stream.
 */
typedef int _far _pascal (*HTTeeResolver)(int retValue1, int retValue2,
					  int *retValue3);


/****************************************************************************

  The HTTeeClass is inherited from HTStreamClass defined in htstream.goh{goc}.

 ****************************************************************************/

@class HTTeeClass, HTStructuredClass;

/*
 * Set the targets and resolver function for resolving the return values
 * from the two target streams. The resolved value will be returned when
 * used to push, flush, and abort.
 *
 * Context:	Push Data.
 * Source:	Client.
 * Destination:	Unrestricted.
 * Interception:No.
 */
@message void MSG_HT_TEE_SET_TARGETS(HTStreamHandle target1, 
				     HTStreamHandle target2,
				     HTTeeResolver cbf);


/* -------------------------------------------------------------------------
 * 		Instance Data.
 * ------------------------------------------------------------------------*/

@instance HTStreamHandle HTTI_secondTarget;  /* First target is HTSI_target 
						of HTStreamClass */

@instance HTTeeResolver HTTI_resolverCbf;    /* Callback function for 
						resolving two return values 
						from the two targets */

@endc;

extern HTStreamHandle _far _pascal
	HTTeeCreate(HTRequestHandle request, HTStreamHandle target1,
		    HTStreamHandle target2, HTTeeResolver cbf, 
		    ThreadHandle burden);

#ifdef __HIGHC__
pragma Alias(HTTeeCreate, "HTTEECREATE");
#endif
@endif




