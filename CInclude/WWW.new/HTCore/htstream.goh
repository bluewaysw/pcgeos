@ifndef __HT_STREAM_GOH__
@define __HT_STREAM_GOH__

@include <WWW/HTCore/htutils.goh>
@include <WWW/HTCore/htconst.goh>
#include <WWW/htmem.h>
@include <stdapp.goh>

/* --------------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. STREAM STACK CONTAINER CLASSES
 * --------------------------------------------------------------------------*/

/****************************************************************************

  The HTStream Library defines a set of stream container classes.
  To use them, you need to define new subclasses from the container classes 
  here and intercept most (usually all) of the messages.

  All stream class methods must return HT_ERROR or HT_OK, an integer value.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		B. WHICH STREAM CONTAINER CLASS TO USE?
 * --------------------------------------------------------------------------*/

/****************************************************************************

  So, which stream container class do I subclass from? There are many 
  "standard" library subclasses that can help you decide. They are:

  HTTPClass		subclass of	HTProtocolClass
  SGMLClass		subclass of 	HTStreamClass
  HTMLClass		subclass of 	HTStructuredClass
  UIGeneratorClass	subclass of 	HTStreamClass
  
  All content-type handlers are usually inherited from HTStreamClass.

 ****************************************************************************/


/* --------------------------------------------------------------------------
 * 		C. CREATING A STREAM STACK
 * --------------------------------------------------------------------------*/

/****************************************************************************

  A Stream Stack is created by cascading the output of one stream 
  object into the input of another stream object and so on. Each stream 
  object has a target stream object that it sends formatted output to. A 
  stream object can be a sink which does not have a target, like a blackhole.

  You need to use a routine in the Format Manager to set up a stream stack. 
  See routine

  	HTStreamGrowInputStreamStack and HTStreamGrowOutput stream stack.


 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		D. RUNNING A STREAM STACK
 * --------------------------------------------------------------------------*/

/****************************************************************************

  To simplify messaging between two directly connected stream objects, a 
  stream stack is run in a Geos thread, called the Converter Thread. 
  Problems that might arise from running a stream stack in multiple
  threads are:
    o  asynch vs. synch messaging. This could cause deadlocks.
    o  difficulties in intercepting or clearing a stream stack.

  To avoid deadlock, you should setup a new event thread (call it content
  thread) that runs all you content-type handlers (the Library thread runs 
  all protocol handlers).  In your application content thread, you should 
  not make blocking call to the Library, e.g., HTRequestKill). What you 
  should do it use the application process thread to manipulate requests 
  using the Library and use the additional content handler thread to 
  receive data from the Library.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		II. CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/

/*  
 * Maximum string length of a resolved IP address.
 */
#define MAX_RESOLVED_ADDRESS_LENGTH 32

/* 
 * This is a scheduler HTNetThread. It maintains the execution state 
 * of HTProtocolClass.
 */
typedef enum {
    HTNET_BLOCKED,                 /* Net thread is ready to be run*/
    HTNET_RUNNING,                 /* Is executing */
    HTNET_DEAD                     /* No longer alive */
} HTNetState;

typedef struct {
    /* Schedule information about a Net thread */
    HTStreamHandle HTNT_scheduler;           /* The scheduler running this */
    GeodeHandle HTNT_owner;                  /* owner of this thread */
    HTRequestHandle HTNT_request;            /* the request being served */
    HTSocketHandle HTNT_socket;              /* the socket */
    HTStreamHandle HTNT_protocol;            /* protocol object itself */

    /* Allocated or not */
    Boolean HTNT_free;                       /* TRUE if not allocated */

    /* Shared data between the HTNetThread running thread (htcore:0) and
     * client's thread. Used for intercepting a running HTNetThread.
     */
    int HTNT_sharedCmd;                      /* HT_INTERRUPTED or HT_OK */

    /* The Net thread state */
    SemaphoreHandle HTNT_changeState;        /* Semaphore to change state */
    HTNetState HTNT_state;                   /* Initially is HTNET_DEAD */

    /* For uniquely identifying a persistent connection */
    Boolean HTNT_persistent;
    HTStringHandle HTNT_scheme;              /* Scheme, e.g., http, smtp */
    word HTNT_port;                          /* TCP port number */
    byte HTNT_server[MAX_RESOLVED_ADDRESS_LENGTH]; /* Resolved address */
    int HTNT_serverLength;                   /* Length of resolved address */
    Boolean HTNT_garbageCollectable;         /* TRUE if a persistent
					      * connection can be garbage 
					      * collected if HTNT_free is
					      * TRUE. Else the protocol
					      * will set it free.
					      */

    /* 
     * Protocol specific information that also persists across multiple 
     * requests. Its up to the protocol to use as it wish.
     */
    int HTNT_status;                        /* Last return code from 
					       MSG_HT_PROTOCOL_LOAD */
    dword HTNT_data;                        /* Protocol specific data 
					     * that persists across request
					     */
    dword HTNT_data2;
    dword HTNT_data3;                       /* As many as 3 data items
					     * used up the discretion of
					     * the protocol 
					     */
} HTNetThread;


/* --------------------------------------------------------------------------
 * 		III. CONTAINER CLASSES DEFINITION
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. HTStreamClass
 * --------------------------------------------------------------------------*/

@class	HTStreamClass, MetaClass;

/* --------------------------------------------------------------------------
 * 		IV. Public Methods
 * --------------------------------------------------------------------------*/

/*
 * The flush method is used to push any buffered data down a stream stack.
 * The stream must decide whether it has any data to flush. It also reserves
 * the right not to flush any data that are relevant to this stream only.
 * The default handler does nothing, it simply returns HT_OK by assuming
 * the stream object is not buffering any data.
 *
 * Context:	Clear Stream (same as Push Data, but no buffering).
 * Source:	Anyone.
 * Destination: Unrestricted.
 * Interception:Must be intercepted by stream subclasses that buffer data.
 * Pass:	Nothing.
 * Return:	HT_ERROR or HT_OK.
 */
@message int MSG_HT_STREAM_FLUSH();

/*
 * The abort method should only be used if a stream is interrupted. For 
 * example, by the user or an error has occurred. Once this message 
 * has been sent, one should not refer to the object internal
 * data instances as these will be removed in this method using 
 * HTUtilChangeClass.
 *
 * Context:	Intercept Stream.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:If necessary, intercept and callsuper.
 * Pass:	status. The status which the abort takes place.
 * Return:	HT_OK or HT_ERROR.
 */
@message int MSG_HT_STREAM_ABORT(int status);

/*
 * Unload the Library of this stream. VERY IMPORTANT: this message
 * must be forcequeued from MSG_HT_STREAM_ABORT after calling
 * HTUtilChangeClass. If not, you will have no code to execute which
 * results in a mysterious crash (executing int3 or cch).
 *
 * Context:	Exit.
 * Source:	MSG_HT_STREAM_ABORT (after calling 
 *                                   HTUtilChangeClassToHTStreamClass)
 * Destination:	Unrestricted.
 * Interception:No!
 */
@message void MSG_HT_STREAM_UNLOAD_LIBRARY(GeodeHandle libraryHandle);

/*
 * Put a block of data down a stream. The data being pushed has the highest
 * granularity in the put methods.  Usually the most efficient. This is a
 * blocking call!
 * 
 * WARNING: Because this is a blocking call, in intercepting this message 
 * to implement your content-type handlers, make sure the content handler's 
 * thread does not make a blocking call to the Library as that would cause
 * a deadlock.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	All stream objects.
 * Interception:Must be intercepted by all stream subclasses. No need to call
 *		super.
 * Pass:	data - block of data to push down, non-Null terminated. 
 *              Data can be NULL.
 *		len - number of bytes in block. len can be 0.
 * Return:	HT_ERROR or HT_OK.
 *
 * Note that since data can be NULL (i.e., len = 0), the intercepted 
 * handler must be able to handle this appropriately. If you are not going
 * do anything if you get data == NULL, you must still pass it along 
 * to your target as you cannot assume your target does not need it.
 */
@message int MSG_HT_STREAM_PUT_BLOCK(const byte *data, word len);

/*
 * Set the request to be serviced by a stream.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:	HTRequestHandle
 * Return:	Nothing.
 */
@message void MSG_HT_STREAM_SET_REQUEST(HTRequestHandle request);

/*
 * Get the request being serviced by a stream. 
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing
 * Return:      HTRequestHandle.
 */
@message HTRequestHandle MSG_HT_STREAM_GET_REQUEST();

/*
 * Sets the target stream object.
 *
 * Context:	Push Data.
 * Source:	Anyone, usually by Format Manager using HTStreamStack(...).
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:	optr
 * Return:	Nothing.
 */
@message void MSG_HT_STREAM_SET_TARGET(optr target);

/*
 * Gets the target stream object. IMPORTANT! If your target is not
 * a decendent of a HTStreamClass, you must intercept to return
 * NullOptr.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:MUST for stream whose target is not inherited from
 *              HTStreamClass.
 * Pass:	Nothing.
 * Return	optr - HTSI_target.
 */
@message optr MSG_HT_STREAM_GET_TARGET();

/*
 * Make a stream transparent. Normally you would not make a stream
 * transparent from the outside since a stream would set itself
 * transparent when it know it is suppose to become transparent.
 * This method should be used by streams which create a background
 * thread for processing data and unable to make itself transparent 
 * unless it is sent a message from the background thread.
 * 
 * A transparent stream does not process input data and simply 
 * forward all the data to its target.
 *
 * Context:	Push Data.
 * Source:	Anyone
 * Destination:	Unrestricted.
 * Interception:Only for streams unable to set its own transparent
 *              mode and has to be done from outside.
 */
@message void MSG_HT_STREAM_SET_TRANSPARENT(Boolean mode);

/*
 * Returns TRUE if the stream is transparent, else FALSE.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing.
 * Return:      TRUE if transparent, else FALSE.
 */
@message Boolean MSG_HT_STREAM_IS_TRANSPARENT();

/*
 * Indicate to the stream that is it dynamically loaded so it
 * knows to unloaded its Library when aborted.
 *
 * Context:	Exit
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary. You need to act on whether your stream
 *              object is dynamically loaded or not.
 */
@message void MSG_HT_STREAM_SET_DYNAMICALLY_LOADED(GeodeHandle libraryHandle);


/* --------------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------------*/

/*
 * The target points to a stream object for pushing data
 * down a stream stack. A null target indicates that this
 * stream object is a sink.
 * 
 *  ----   target   ----   target        ----   
 * | S1 | -------->| S2 | --------> ....| Sn | -----> NULL
 *  ----            ----                 ----
 * 
 * In this diagram, Sn is a sink.
 */
@instance optr HTSI_target;

/* 
 * A stream can be in two operational modes: tranparent and 
 * non-transparent. Depending on its role in a stream pipe,
 * it may decide to become tranparent and simply pipe data 
 * through, otherwise it may process the input data before 
 * piping it through.
 */
@instance Boolean HTSI_transparent;

/* 
 * The request serviced by this stream
 */
@instance HTRequestHandle HTSI_request;
 
/* 
 * If dynamically loaded, this is the geodeHandle of the Library 
 * which must be freed. A stream is responsible for freeing its Library.
 * To be safe, you must use HTUtilChangeClassToHTStreamClass before
 * freeing the Library and destroying your stream object.
 */
@instance GeodeHandle HTSI_libraryHandle;

@endc


/* --------------------------------------------------------------------------
 * 		B. HTStructuredClass
 * --------------------------------------------------------------------------*/

@class	HTStructuredClass, HTStreamClass;

/* --------------------------------------------------------------------------
 * 		Public Methods
 * --------------------------------------------------------------------------*/

/*
 * Get the DTD defined in this structured stream. The DTD is used by
 * SGML to generate tokens.
 *
 * Context:	Structured stream.
 * Source:	SGMLClass.
 * Destination:	Any structured stream that has a DTD.
 * Interception:Necessary.
 */
@message void * MSG_HT_STRUCTURED_GET_DTD();

/*
 * Push a start element to a structured stream. The data passed has a 
 * "structured" that only the receiver would know how to interpret.
 *
 * Context:	Push Structured Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Must be intercepted by all structured stream subclasses.
 *              No need to call super as there is no default handler.
 * Pass:        elementToken - the element token number.
 *              block and chunk combined to define stream specific data
 *              type. It is up to the communicating streams to define 
 *              what the data type is.
 * Return:      HT_OK or HT_ERROR.             
 */
@message int MSG_HT_STRUCTURED_PUT_START_ELEMENT(word elementToken,
						 MemHandle block,
						 ChunkHandle chunk);

/*
 * Push an end element to a structured stream. 
 *
 * Context:	Push structured Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Must be intercepted by all structured stream subclasses.
 *              No need to callsuper as there is no default handler.
 * Pass:        element - the element number.
 * Return:      HT_OK or HT_ERROR.
 */
@message int MSG_HT_STRUCTURED_PUT_END_ELEMENT(word elementToken);

@endc


/* --------------------------------------------------------------------------
 * 		C. HTProtocolClass
 * --------------------------------------------------------------------------*/

@class	HTProtocolClass, HTStreamClass;

/* --------------------------------------------------------------------------
 * 		Public Methods
 * --------------------------------------------------------------------------*/

/*
 * The load handler of a protocol access scheme. It must be 
 * intercepted by all subclasses. This is the protocol thread that 
 * gets scheduled by the Net Manager. Hence it must be reentrant.
 *
 * Context:	Load Data Object.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Must be intercepted by all protocol subclasses. No need to 
 *		call super.
 * Pass:        net. Information about a schedulable Net thread. A Net thread
 *              runs a protocol object.
 * Return:	HT_OK or any code. If not HT_OK, the Net Manager terminates
 *              the thread (and call any "after" callbacks registered to be
 *              called based on the return code).
 */
@message int MSG_HT_PROTOCOL_LOAD(HTNetThread *net);

/*
 * Stop a protocol. Since this is a synchronous call (the protocol could
 * be doing something and not able to handle this message), you need to 
 * intercept this message if your protocol is doing something in the 
 * background, like using htsocket to resolve and connect. You *should*
 * stop all these operations before you return. Notice we don't say
 * *must* stop because eventually your protocol will get 
 * MSG_HT_STREAM_ABORT. However, if you don't, you could slow down the 
 * response time for interrupting a request.
 *
 * So how do we stop a protocol in the midst of handling a method (reading
 * and writing a htsocket)? We call socketInterrupt from outside of the 
 * protocol since HTRequest associated with the protocol has a copy of the
 * Geos socket descriptor (see field HTRequest.HTR_sockfd in htreqMan.goh).
 *
 * Context:	Stop loading.
 * Source:	Anyone
 * Destination:	Unrestricted
 * Interception:Optional
 */
@message void MSG_HT_PROTOCOL_STOP();


/* --------------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------------*/

@instance HTStreamHandle  HTPI_streamSocket;

@endc

/* --------------------------------------------------------------------------
 * 		V. Public Functions
 * --------------------------------------------------------------------------*/

extern void _far _pascal
	HTUtilChangeClassToHTStreamClass(optr obj);

extern void _far _pascal
	HTUtilChangeClass(optr obj, ClassStruct _far *class);

extern int _far _pascal
	HTStreamGrowInputStreamStack(HTRequestHandle request, 
		HTStreamHandle stream);

EC(	
extern void _far _pascal	
	ECCheckStream(HTStreamHandle stream); 
)

#ifdef __HIGHC__
pragma Alias(HTUtilChangeClass, "HTUTILCHANGECLASS");
pragma Alias(HTUtilChangeClassToHTStreamClass, "HTUTILCHANGECLASSTOHTSTREAMCLASS");
pragma Alias(HTStreamGrowInputStreamStack, "HTSTREAMGROWINPUTSTREAMSTACK");

#if ERROR_CHECK
pragma Alias(ECCheckStream, "ECCHECKSTREAM");
#endif

#endif

@endif /* __HT_STREAM_CLASS_GOH */







