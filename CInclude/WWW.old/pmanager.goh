@ifndef __PMANAGER_GOH__
@define __PMANAGER_GOH__

@deflib pmanager

@include <Objects/Text/tCtrlC.goh>  /* SearchReplaceControlClass */
@include <WWW/HTCore/htlist.goh>
@include <WWW/htmem.h>              /* memory allocation routines */

typedef ByteEnum ErrorMsg;
#define PM_NO_ERROR 	0
#define PM_ERROR	1
/*
 *  Define constants for searching backward and forward.
 */
#define SEARCH_BACKWARD 0
#define SEARCH_FORWARD 1

typedef struct {
  optr         NE_object;
  int          NE_offset;
} NameElement;

@class PresentationManagerClass, GenInteractionClass;
@message void MSG_PM_INITIALIZE();
@message void MSG_PM_SET_LOADING_OPTION(Boolean load);
@message ErrorMsg MSG_PM_TAKE_UNFINISHED_UI_OBJ(optr newObj);
@message ErrorMsg MSG_PM_TAKE_FINISHED_UI_OBJ(optr newObj);
@message ErrorMsg MSG_PM_MARK_RECV_OBJECT_DONE(optr* parent,
					       ClassStruct **class);
@message void MSG_PM_GET_RECV_OBJ_OPTR_AND_CLASS(optr *recvObj,
						 ClassStruct **class);
@message void MSG_PM_ONE_LEVEL_DOWN_UI_TREE(optr child);
@message void MSG_PM_CREATE_HORIZONTAL_DUMMY_CONTAINER();
@message optr MSG_PM_OBJECT_INSTANTIATE(ClassStruct *objClass);
@message void MSG_PM_COPY_SELECTED_OBJECTS();
@message void MSG_PM_PRINT_UI_TREE(GStateHandle gstate);
@message void MSG_PM_SAVE_TITLE(char *ptr);
@message void MSG_PM_SAVE_BASE(char *ptr);
@message int  MSG_PM_SAVE_HREF(char *href);
@message void MSG_PM_SAVE_ANCHOR_NAME
         (char *name, optr object, dword offset);
@message void MSG_PM_REFER_HYPERLINK(int hrefToken);
@message void MSG_PM_REFER_MAPLINK(int rel_x, int rel_y, HTMemHandle src);
@message void MSG_PM_CLEAR_HREF_LINK();
@message void MSG_PM_CLEAR_UI_TREE();
@message HTMemHandle MSG_PM_GET_TITLE();
@message void MSG_PM_SET_FORM_QUERY(HTListHandle query);
@message void MSG_PM_SET_CONTENT_OBJECT(optr content);
@message optr MSG_PM_GET_CONTENT_OBJECT();
@message void MSG_PM_SEARCH_FOUND(int direction);
@message void MSG_PM_SEARCH_NOT_FOUND();
@message void MSG_PM_SEARCH_NO_MORE_FOUND(int direction);
@message HTMemHandle MSG_PM_GET_BASE_OPTR();
@message void MSG_PM_ENTER_CAPTION_MODE
         (ClassStruct *table, char align, optr caption);
@message void MSG_PM_EXIT_CAPTION_MODE();
@message void MSG_PM_SHOW_FOCUS_IN_VISIBLE_RECT
	 (RectDWord rect, int direction, ClassStruct *imageClass);
@message void MSG_PM_SHOW_FOCUS(int direction, ClassStruct *imageClass);
@message void MSG_PM_DISPLAY_HREF_TARGET(int hrefToken);
	/*
	 * PM_recvObj stores the optr of an object which take any 
	 * incoming new objects as its children.
	 */
	@instance optr PM_recvObj = NULL;
	/*
	 * PM_recvObjBackup keeps a copy of the recvObj before
	 * entering the <CAPTION> mode.
	 */
	@instance optr PM_recvObjBackup = NULL;
	/*
	 * PM_title store the <TITLE> of the document.
	 */
	@instance HTMemHandle PM_title = NULL;
	/*
	 * PM_base store the base URL of <BASE HREF="">
	 */
	@instance HTMemHandle PM_base = NULL;
        /*
	 *  PM_anchor stores the list of HREFs in all <A>'s on a
	 *  web page.
	 */
	@instance HTListHandle	PM_hrefs;
        /*
	 *  PM_anchor stores the the NAMEs in all <A>'s.
	 *  PM_nameElment store information about each NAME.
	 *    PM_anchor and PM_nameElment has one-to-one relation.
	 *    That means, the first elment in PM_anchor contains the
	 *    NAME value for the first element in PM_nameElement.
	 */
	@instance HTListHandle	PM_anchorName;
	@instance HTListHandle	PM_nameElement;
        /*
	 *  PM_linkUnderMouse stores the current hyperlink url under
	 *  the mouse.
	 */
	@instance MemHandle	PM_linkUnderMouse;
        /*
	 *  PM_query stores a form query when a submit trigger in a form
	 *  is pressed.
	 *  The 0th index store the URL of the server in <FORM ACTION=?>
	 *  The 1st index store the Method type:  FORM_GET or FORM_POST.
	 *  Then, the even index stores the name and the odd index stores
	 *  the value:
	 *     index 2 = name_1
	 *     index 3 = value_1
	 *     index 4 = name_2
	 *     index 5 = value_2
	 *     ....
	 */
	@instance HTListHandle	PM_query;
	/*
	 *  Record the ismap information;
	 */
	@instance int	        PM_x;
	@instance int	        PM_y;
	@instance HTMemHandle	PM_src;
	/*
	 *  Load the image while building a Image object?
	 *  0 - FALSE;
	 *  non-zero - TRUE;
	 */
	@instance Boolean	PM_loadImage;
	 /*
	  *  Store the content object for the global formating element.
	  */
	@instance optr          PM_content;
	 /*
	  *  focalObj stores the current object that has hyperlink in
	  *  the visible screen region.  The hyperlink's bound is stored
	  *  in PM_drawBound.  When there is no link in focus, i.e 
	  *  focalObj = NULL, then PM_referenceObj stores the last
	  *  object that has hyperlink in focus.  The purpose is to 
	  *  know where in the ui tree to resume the search process.
	  */
	@instance optr          PM_focalObj;
	@instance RectDWord	PM_drawBound;
	@instance Rectangle	PM_drawbox;
	@instance optr          PM_referenceObj;

@endc

@class HTMLContentClass, GenContentClass;
@message void MSG_HTML_CONTENT_VIEW_OBJECT(sword left, sword bottom);
@message void MSG_HTML_CONTENT_SET_VIEW_DOC_BOUNDS(SizeAsDWord size);
@endc

@endlib

@class PMSearchCtrClass, SearchReplaceControlClass;
@endc

@endif /* __PMANAGER_GOH__ */
