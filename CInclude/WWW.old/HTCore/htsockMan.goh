@ifndef __HTSOCKMAN_GOH
@define __HTSOCKMAN_GOH

@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htutils.goh>

 /* 
  * A client is only allowed a certain max number of persistent 
  * connections to a server/proxy.
  */
#define MAX_PERSISTENT_CONNECTIONS_PER_SERVER 2  /* Recommended by HTTP/1.1 */

/* --------------------------------------------------------------------------
 * 		PUBLIC FUNCTIONS
 * --------------------------------------------------------------------------*/

extern int _far _pascal
	HTSocketCreate(HTRequestHandle request, HTStreamHandle *socket);

extern void _far _pascal
        HTSocketDelete(HTStreamHandle socket, HTRequestHandle request);

extern void _far _pascal	
	HTShutDown();

#ifdef __HIGHC__
pragma Alias(HTSocketCreate, "HTSOCKETCREATE");
pragma Alias(HTSocketDelete, "HTSOCKETDELETE");
pragma Alias(HTShutDown, "HTSHUTDOWN");
#endif


@endif /* __HT_SOCKMAN_GOH */
