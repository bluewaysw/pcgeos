@ifndef __HT_URI_GOH
@define __HT_URI_GOH

@include <WWW/HTCore/htreqMan.goh>
#include <WWW/htmem.h>

/* 
 * Indicate what components you to parse of in a URI. They
 * are mutually exclusive so each can be set independently.
 * The format of the URI is as follows:
 *
 */
/* For http protocol */
#define HTURI_PARSE_PORT               0x20
#define HTURI_PARSE_ACCESS             0x10
#define HTURI_PARSE_HOST               0x8
#define HTURI_PARSE_PATH               0x4
#define HTURI_PARSE_ANCHOR             0x2
#define HTURI_PARSE_PUNCTUATION        0x1
#define HTURI_PARSE_ALL                (HTURI_PARSE_PORT                | \
					HTURI_PARSE_ACCESS              | \
					HTURI_PARSE_HOST                | \
					HTURI_PARSE_PATH                | \
					HTURI_PARSE_ANCHOR              | \
					HTURI_PARSE_PUNCTUATION)

/* --------------------------------------------------------------------------
 * 		Private Functions
 * --------------------------------------------------------------------------*/

extern HTMemHandle _far _pascal
	HTParseURI(const char *aName, const char *relatedName, word wanted);

extern HTMemHandle _far _pascal
	HTParseHTMemHandleURI(const HTMemHandle aName, 
			      const HTMemHandle relatedName,
			      word wanted);

extern char* _far _pascal
	HTSimplifyURI(char **url);

#ifdef __HIGHC__
pragma Alias(HTParseURI, "HTPARSEURI");
pragma Alias(HTParseHTMemHandleURI, "HTPARSEHTMEMHANDLEURI");
pragma Alias(HTSimplifyURI, "HTSIMPLIFYURI");
#endif

@endif


