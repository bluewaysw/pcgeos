/* --------------------------------------------------------------------------
 * 		COMPILE OPTIONS
 * HTSocket is written to implement both stream socket (pushing data) and 
 * non-stream socket (read data). STNC is using non-stream socket. To enable
 * stream socket, we need to define __HT_STREAM_SOCKET__.
 * 
 * Stream socket is included in Library htcore. 
 *
 * Stand-alone library called htsock.
 * --------------------------------------------------------------------------*/
/*
 * Define __HT_STREAM_SOCKET__ for HTCore Library. Do not define to implement 
 * standalone htsock Library.
 */
/* @define __STNC__ */ /* Shipping to STNC... */

@ifndef __STNC__
@define __HT_STREAM_SOCKET__
@endif

/*
 * Define __TEST_HT_SOCKET__ to test HTSocket without connecting server
 * and to simulate various socket behaviour.
 */
/* @define __TEST_HT_SOCKET__ */


@ifndef __HT_SOCK_GOH__
@define __HT_SOCK_GOH__

@ifndef __HT_STREAM_SOCKET__

@deflib htsock

@endif

@include <stdapp.goh>
@include <socket.goh>
@include <sockmisc.h>
#include <library.h>                           /* LibraryCallType */
@include <WWW/HTCore/htutils.goh>
@include <WWW/HTCore/htreq.goh>

@ifdef __HT_STREAM_SOCKET__

@include <WWW/HTCore/htstream.goh>

@endif


@ifdef __TEST_HT_SOCKET__

@include <WWW/HTCore/htreqMan.goh>

@endif


/* --------------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. HTSOCKET CLASS
 * --------------------------------------------------------------------------*/

/****************************************************************************
 
  The HTSocketClass is inherited from HTStreamClass defined in 
  htstream.goh{goc}. We compile for both stream socket and non-stream
  socket. Stream socket is inherited from HTStreamClass while non-stream
  socket is inherited from MetaClass
 
  For stream socket, we intercept all the methods in the class to implement 
  a stream socket.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		B. Register HTSocket CLASS? NOPE!
 * --------------------------------------------------------------------------*/

/****************************************************************************
 
  HTSocket is an internal class used by all other protocols that uses
  TCP/IP socket.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		II. CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/
#ifndef HT_OK
#define	HT_OK 			0	/* Generic success */
#endif

#ifndef HT_NO
#define	HT_NO 			1	/* Operation denied, not an error */
#endif

/* 
 * Maximum string length of an IP address.
 */
#define MAX_IP_ADDRESS_LENGTH 256 /* Guaranteed to hold any IP name. See
				     Section 2.1 of RFC 1123. */

/*  
 * Maximum string length of a resolved IP address.
 */
#define MAX_RESOLVED_ADDRESS_LENGTH 32

/*
 * HTSocket callback function prototype socket asynchronous operation
 * notification. State is one of the HT_? values defined in htreq.goh.
 */
typedef void _far _pascal (*HTSocketCallback) (HTStreamHandle stream, 
					       int htstate);

/* 
 * TCP address structure to pass to HTSocket MSG_HT_SOCKET_RESOLVE.
 */
typedef struct {
    char HTSA_ipAddress[MAX_IP_ADDRESS_LENGTH];     /* Unresolved address */
    word HTSA_port;                                 /* TCP/IP port number */
    word HTSA_accessPoint;                          /* AccessPoint number
						       in your "ini" file */
} HTSocketAddress;

/*
 * TCP address structure to pass to Geos SocketResolve.
 */
typedef struct {
    word       HTLA_size;             /* size of link data */
    LinkType   HTLA_type;             /* type of link data */
    word       HTLA_id;               /* access point id */ 
} HTLinkAddress;

typedef struct {
    HTLinkAddress   HA_linkAddress;
    char            HA_ipAddress[MAX_IP_ADDRESS_LENGTH];
} HTTCPAddress;


/* 
 * The input buffer size is a compromise between speed and memory. 
 */
#define HTSOCKET_BUFFER_SIZE     512    /* SocketRecv in chunks of 512 */
#define SOCKET_THREAD_STACK_SIZE 1024   /* No ui stuff, 1K is enough. */

/*
 * Information of a socket shared by multiple threads. We can't
 * put them in HTSocket (see below) as we need to read these
 * data very often. Trust me, we want quick access to socket
 * state so that HTNetScheduler can multitask faster. We still 
 * have to use MemLockShared to read this data.
 */
typedef struct {
    /* WWW socket state information. */
    int HTSI_state;                     /* One of HT_SOCKET_? in htreq.goh */
    dword HTSI_connectionTime;          /* The estimated round-trip delay (in 
					   ticks) to server based on the 
					   time it took to establish the 
					   connection. */
} HTSocketInfo;

/*
 * HTSocket structure. Each structure is allocated to be swappable.
 * NOTE: Geos SocketConnect requires that the resolved address field,
 * HTS_resolvedAddress, falls immediately after the SocketAddress
 * field HTS_sockAddress; this is used implicitly in SocketConnect. 
 *
 * For this stream, the request structure is optional. It can be NULL.
 * This is so that we can make use of this Library independently of
 * all other stream Libraries.
 */
typedef struct {
    /* Geos socket information. */
    Socket HTS_sockfd;
    SocketAddress HTS_sockAddress;
    byte HTS_resolvedAddress[MAX_RESOLVED_ADDRESS_LENGTH];
    HTTCPAddress HTS_tcpAddress;

    /* WWW socket information */
    HTStreamHandle HTS_htsocket;        /* The owner htsocket object of this 
					   HTSocket structure. */

    MemHandle HTS_htSockInfo;           /* Containing HTSocketInfo */

    /* Callback information */
    HTSocketCallback HTS_connectCbf;    /* Connection callback */
    HTSocketCallback HTS_receiveCbf;    /* Receive data callback */    

    /* 'V' this sem when we are exiting background thread. */
    SemaphoreHandle HTS_threadIsRunning;
    /*
     * P and V this semaphore before pushing data asynchronously to
     * target. If failed to P, we should receive loop.
     */
    SemaphoreHandle HTS_stop;

    /* 
     * Input buffer not needed if we are using non-stream socket as we 
     * won't be pushing data. 
     */
@ifdef __HT_STREAM_SOCKET__
    HTStreamHandle HTS_target;            /* For pushing data */
    byte HTS_buffer[HTSOCKET_BUFFER_SIZE]; /* Buffer space for input */
@endif

    /* If we are testing, we read data from a file using the 
     * request URL */
@ifdef __TEST_HT_SOCKET__
    HTRequestHandle HTS_request;
    FileHandle HTS_fileHandle;
@endif

} HTSocket;

typedef word HTSocketHandle;    /* 16-bit asynchronous socket handle */

@ifndef __HT_STREAM_SOCKET__

@class HTStreamClass, MetaClass;
@endc;

@endif

@class HTSocketClass, HTStreamClass;

/* --------------------------------------------------------------------------
 * 		Public Methods
 * --------------------------------------------------------------------------*/

/*
 * Initialize HTSocket internal data structures. Should be called once
 * before using HTSocket. If called more than once, previous connection 
 * will be closed. You will then have to re-resolve and re-connect again.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing.
 * Return:      HT_OK if initialization ok, else HT_SOCKET_ERROR.
 */
@message int MSG_HT_SOCKET_INITIALIZE();

/*
 * Get Geos socket descriptor so you use the descriptor directly
 * with Geos socket functions. This function is provided because
 * htsocket will not be implementing all Geos socket functions. 
 * Also, from a software engineering point of view, you should
 * use htsocket APIs, and interrupt MSG_HT_SOCKET_READ{_PTR}, 
 * MSG_HT_SOCKET_WRITE, MSG_HT_SOCKET_CONNECT, MSG_HT_SOCKET_RESOLVE, 
 * and MSG_HT_SOCKET_RESOLVE_AND_CONNECT using Geos SocketInterrupt 
 * passing the socket descriptor returned by this API.
 *
 * Context:	Geos socket.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing.
 * Return:      Geos socket descriptor of HTSocket.
 */
@message Socket MSG_HT_SOCKET_GET_DESCRIPTOR();

/*
 * Get the state of HTSocket.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing.
 * Return:      int
 */
@message int MSG_HT_SOCKET_GET_STATE();

/*
 * Get the last socketConnect time in seconds. The time indicates
 * how many seconds it took to complete an either a sucessful or
 * failed socketConnect. If no socketConnect was performed earlier,
 * return 0.
 *
 * Context:	Persistent Connection.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing.
 * Return:      dword - time in ticks (60 ticks per second).
 */
@message dword MSG_HT_SOCKET_GET_CONNECT_TIME();

/*
 * Get the resolved hostname of a HTSocket. If the name was 
 * not resolved earlier using MSG_HT_SOCKET_RESOLVE, the resolved 
 * address is undefined; i.e., you will get garbage.
 *
 * Context:	Persistent Connection.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        resolvedAddress - buffer to store the resolved name.
 *              length - length of the resolvedAddress buffer.
 * Return:      The actual length of the resolved address copied to
 *              resolvedAddress. If the actual length is greater than
 *              the passed in length, we return 0 and resolvedAddress
 *              is undefined.
 */
@message word MSG_HT_SOCKET_GET_RESOLVED_ADDRESS(byte *resolvedAddress,
						 word length);

/*
 * Nonblocking resolve and connect of a HTSocket. You should check socket 
 * state using MSG_HT_SOCKET_GET_STATE before reading or writing to socket. 
 * Also, you can use MSG_HT_SOCKET_SET_CONNECT_CALLBACK to receive
 * notification after socket connect has completed. See also 
 * MSG_HT_SOCKET_RESOLVE and MSG_HT_SOCKET_CONNECT.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        htAddress - HTSocketAddress for resolve and connect.
 *              client - GeodeHandle for creating a thread for nonblocking
 *              resolve and connect.
 *              cbf - for connection callback. Will be called after 
 *              socket is done connecting and passing the HTSocket
 *              stream handle (i.e., oself) and its status.
 * Return:      HT_OK if resolve and connect are proceeding in the 
 *              background, else HT_SOCKET_ERROR.
 */
@message int MSG_HT_SOCKET_RESOLVE_AND_CONNECT(HTSocketAddress *htAddress,
					       GeodeHandle client,
					       HTSocketCallback cbf);

/*
 * Stop all background operation. Since this is a synchronous call, you
 * can only stop backgroud operation run by a different thread like 
 * socketResolve and socketConnect. If you want to stop synchrnounous 
 * operations like htsocket reading and writing, you need to get a copy
 * of the Geos soceket descriptor using MSG_HT_SOCKET_GET_DESCRIPTOR
 * and use socketInterrupt to stop it.
 *
 * Context:	Push data.
 * Source:	Client.
 * Destination:	Anyone.
 * Interception:Not necessary
 */
@message void MSG_HT_SOCKET_STOP();

/*
 * Close a HTSocket. This socket is no longer valid for reading and 
 * writing. If you wish to reuse this socket, you must reinitialize it
 * using MSG_HT_SOCKET_INITIALIZE and call resolve and connect again.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        Nothing.
 * Return:      Nothing.
 */
@message void MSG_HT_SOCKET_CLOSE();


@ifdef __HT_STREAM_SOCKET__

/*
 * Asynch read and push data to target. Pass cbf as the receive data 
 * callback. cbf will be called when there is no more data to 
 * push.
 *
 * Context:	Push Data 
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        cbf, will be called passing HTSocket's target and 
 *              HTSocket status. 
 *              stop, attempt to grab this sem before pushing data
 *              and release after pushing data. If failed to grab,
 *              asynch receive loop is exited.
 * Return:      Return code from target.
 */
@message int MSG_HT_SOCKET_PUSH_ASYNCH(HTSocketCallback cbf, 
				       SemaphoreHandle stop);

@endif


@ifdef __HT_STREAM_SOCKET__

/*
 * Synch read and push data to target. This is a synchronous call
 * to read a chunk of data from socket and push to target. There
 * may still be data socket to be read after we return.
 *
 * Context:	Push Data.
 * Source:	Anyone
 * Destination:	Unrestricted.
 * Interception:No.
 * Pass:        Nothing
 * Return:      int.
 */
@message int MSG_HT_SOCKET_PUSH();

@endif



/*
 * Read data into buffer.
 *
 * Context:	Get Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necessary.
 * Pass:        buffer - buffer for storing data.
 *              length - length of data buffer.
 *              timeOut - timeout value, use SOCKET_NO_TIMEOUT for no
 *                       timeout, 0 is the minimum.
 * Return:      0 if no data is read, else the number of bytes read.
 *              If you failed to get data, you may want to query
 *              socket state using MSG_HT_SOCKET_GET_STATE.
 */
@message word MSG_HT_SOCKET_READ_PTR(void *buffer, word length, int timeOut);

/*
 * Write data to HTSocket. This is a non-stream version. For stream 
 * version, see MSG_HT_STREAM_PUT_BLOCK.
 *
 * Context:	Push Data.
 * Source:	Anyone.
 * Destination:	Unrestricted.
 * Interception:Not necesary.
 * Pass:        data - buffer containing the data.
 *              length - number of bytes of data.
 * Return:      HT_OK if ok, else HT_SOCKET_ERROR. You may want to query the 
 *              socket state using MSG_HT_SOCKET_GET_STATE if you get 
 *              HT_SOCKET_ERROR.
 */
@message int MSG_HT_SOCKET_WRITE_PTR(void *data, word length);

/* --------------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------------*/

/*
 * HTSocket information grouped in a structure for organization and 
 * convenience.
 */
@instance HTSocketHandle HTSI_socket;

/*
 * To indicate there is an internal thread running. Used to synch
 * termination of socket. If HTSI_runningThread == NULL, then we
 * know there is no running thread. The semaphore is used to 
 * synchronize termination.
 */
@instance ThreadHandle HTSI_runningThread;
@instance SemaphoreHandle HTSI_threadIsRunning;

/*
 * HTSocket information indicating what the socket is doing etc. 
 * The copy is kept in HTSocket.HTS_htSockInfo so we can write
 * in one thread and read from the other. This is *VERY IMPORTANT*
 * to fast cooperative multitasking by HTNetScheduler.
 */
@instance MemHandle HTSI_htSockInfo;

@endc

@ifndef __HT_STREAM_SOCKET__

@endlib

@endif

@endif /* __HT_SOCK_GOH */












