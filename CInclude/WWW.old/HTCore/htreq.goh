		HTListHandle list);

extern int _far _pascal
	HTRequestSetAfterCallbackList(HTRequestHandle request,
		HTListHandle list);

extern int _far _pascal
	HTRequestSetProtocolList(HTRequestHandle request,
		HTListHandle list);

extern int _far _pascal
	HTRequestSetResponseParser(HTRequestHandle request,
