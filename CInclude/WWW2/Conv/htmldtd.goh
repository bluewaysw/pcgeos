	,HTML_ATTR_CHECKED
	,HTML_ATTR_CLASSID
	,HTML_ATTR_CLEAR
	,HTML_ATTR_CODE
	,HTML_ATTR_CODEBASE
	,HTML_ATTR_CODETYPE
	,HTML_ATTR_COLOR
	,HTML_ATTR_COLS
	,HTML_ATTR_COLSPAN
	,HTML_ATTR_COMPACT
	,HTML_ATTR_CONTENT
	,HTML_ATTR_COORDS
	,HTML_ATTR_CONTROLS
	,HTML_ATTR_DATA
	,HTML_ATTR_DECLARE
	,HTML_ATTR_DIRECTION
	,HTML_ATTR_DISABLED
	,HTML_ATTR_DYNSRC
	,HTML_ATTR_EFFECT
	,HTML_ATTR_ERROR
	,HTML_ATTR_FACE
	,HTML_ATTR_FRAME
	,HTML_ATTR_HEIGHT
	,HTML_ATTR_HREF
	,HTML_ATTR_HSPACE
