	,HTML_ATTR_MIN
	,HTML_ATTR_MULTIPLE
	,HTML_ATTR_N
	,HTML_ATTR_NAME
	,HTML_ATTR_NOHREF
	,HTML_ATTR_NOSHADE
	,HTML_ATTR_NOWRAP
    ,HTML_ATTR_OBJECT
	,HTML_ATTR_ONCLICK
