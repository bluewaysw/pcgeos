/*
 * Attributes. The numbering system must meet the following requirements:
 * 
 * 1. Fit in one uint16.
 * 2. Attrs in the same HTML tag must not have the same number (to make
 *    life easier, we assign a unique number to each attr. Hence we use
 *    enum).
 * 3. > 0.
 */
    
typedef enum {
	 HTML_ATTR_XXX_INVALID        = 0x0  /* For range checking */
	,HTML_ATTR_ACTION
	,HTML_ATTR_ALIGN
	,HTML_ATTR_ALT
    ,HTML_ATTR_ARCHIVE
	,HTML_ATTR_AREA
	,HTML_ATTR_AT
	,HTML_ATTR_BACKGROUND
