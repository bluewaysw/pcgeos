@ifndef _CTLIST_H_
@define _CTLIST_H_

// #include <www/wwcore/wwlist.h>
// #include <www/conv/htmldtd.h>   // HTMLToken

@include "WWW2/WW2Core/ww2list.goh"
@include "WWW2/Conv/htmldtd.goh"

/*
class HTFrame;
class HTComposite;
class HTGlyph;
class CompositeTargetList;   In this same file
*/


/***************************************************************************
CLASS
    CompositeTargetElement

    Elements of CompositeTargetList. Must not delete _target as it
    does not belong to us.

KEYWORDS
    

CLASS TREE
<pre>
    WWListElement
       |
       +---CompositeTargetElement
</pre>
****************************************************************************/
@class CompositeTargetElementClass, WWListElementClass;

// private:
//    friend CompositeTargetList;

    @message void CompositeTargetElement(optr /* HTComposite * */target); // : _target(target)
//    {
//        PARAM_ASSERT(target);
//    }

//    virtual ~CompositeTargetElement() {}
    @message optr CompositeTargetGetTarget();
    
    @instance optr /* HTComposite * */ __target;

@endc;


/***************************************************************************
CLASS
    CompositeTargetList

    List of composite targets. 

KEYWORDS
    

CLASS TREE
<pre>
    CompositeTargetList
</pre>
****************************************************************************/
@class CompositeTargetListClass, MetaClass; 

// public:    
    //////////
    //
    // Constructor.
    //
    // Status_ Functional
    //
    @message void CompositeTargetList(optr /* HTFrame * */ frame); // : _frame(frame)
//    {
//        PARAM_ASSERT(frame);
//    }
    
    //////////
    //
    // Destructor.
    //
    // Status_ Functional
    //
//    ~CompositeTargetList();

    //////////
    //
    // Set current composite target. 
    //
    // Parameters_
    //
    // [in]  target   The current composite target.
    //
    // Return_value_ TRUE if ok, FALSE if out of memory.
    //
    // Status_ Functional
    //
    @message Boolean SetCurrentCompositeTarget(optr /* HTComposite * */target);

    //////////
    //
    // Get current composite target. Does not remove it from the 
    // the composite target list.
    //
    // Return_value_ HTComposite* or NULL
    //
    // Status_ Functional
    //
    @message optr /* HTComposite * */ GetCurrentCompositeTarget();

    //////////
    //
    // Move current composite target to a composite given its token
    // identity.
    //
    // Parameters_
    //
    // [in]  compositeToken   The target identity.
    //
    // See_also_ MoveCurrentCompositeTargetToBefore()
    //
    // Status_ Functional
    //
    @message void MoveCurrentCompositeTargetTo(HTMLToken compositeToken);

    //////////
    //
    // Move current composite target to before a composite.
    //
    // Parameters_
    //
    // [in]  compositeToken
    //
    // See_also_ MoveCurrentCompositeTargetTo()
    //
    // Status_ Functional
    //
    @message void MoveCurrentCompositeTargetToBefore(HTMLToken compositeToken);

    //////////
    //
    // Find a composite by moving down the list from head to tail.
    //
    // Parameters_
    //
    // [in]  compositeToken  The composite to find.
    //
    // Return_value_ NULL if not found.
    //
    // See_also_ FindCompositeTarget()
    //
    // Status_ Functional
    //
    @message optr /* HTComposite * */ FindCompositeTarget
	(HTMLToken compositeToken);

    //////////
    //
    // Find a composite by moving down the list from head to tail.
    //
    // Parameters_
    //
    // [in]  compositeToken   The composite to find.
    // [in]  searchUntilToken Stop looking when we reach this token.
    //
    // Return_value_ NULL if not found.
    //
    // See_also_ FindCompositeTarget()
    //
    // Status_ Functional
    //
    @message optr /* HTComposite * */ FindCompositeTargetWithToken
	(HTMLToken compositeToken, HTMLToken searchUntilToken);

    //////////
    //
    // Append to current composite target. 
    //
    // Parameters_
    //
    // [in]  glyph  Glyph to append
    //
    // Return_value_ TRUE if ok, FALSE if out of memory
    //
    // Status_ Functional
    //
    @message Boolean AppendToCurrentCompositeTarget(optr /* HTGlyph * */ glyph);

// private:
    //
    // Append to before table.
    //
    // Parameters_
    //
    // [in]  glyph  Glyph to append
    //
    // Return_value_ TRUE if ok, FALSE if out of memory
    //
    // Status_ Functional
    //
    @message Boolean AppendToBeforeTable(optr /* HTGlyph * */ glyph);

    // Use Prepend() and Get() to implement LIFO list.
    @instance optr /* HTFrame * */ __frame;
    @instance optr /* WWList */    __list;

@endc;



@endif /* _CTLIST_H_ */
