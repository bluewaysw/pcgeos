/***************************************************************************
CLASS
    Callback for authentication.    

 KEYWORDS

 CLASS TREE
 <pre>
  CommandArg
    |
    +--- AuthCommand
 </pre>
 ****************************************************************************/
class AuthCommand : public CommandArg
{
 public:
    AuthCommand(AppBase *appbase) : _appbase(appbase)
    {PARAM_ASSERT(appbase);}
    ~AuthCommand() {};

    //////////
    //
    // Execute a command object that takes arguments. 
    //
    // Parameters_
    //
    // [in]  cmd    Command to be executed.
    // [in]  argc   Number of arguments in argv.
    // [in]  argv   Array of void pointers.
    // [in]  argr   Number of arguments in argrv expected from callee.
    // [out] argrv  Array of char pointers. If the return code is non-zero,
    //              The pointers will be freed by caller of this routine via 
    //              "delete []...".
    //
    // Return_value_ 0 if argrv[] data is provided, which can be NULL.
    //               non-zero, argrv[] data is not provided.
    //
    // See_also_ Command
    //
    // Overrides_
    //
    // Status_ Functional
    //
    int Execute(int arg, const char *argv[], int argr, char *argrv[]);

 private:
    AppBase *_appbase;
};


/***************************************************************************
CLASS
    AuthListener

    Decide whether <OK> or <CANCEL> was pressed during authentication.

KEYWORDS
    

CLASS TREE
<pre>
   ActionListenerInterface
      |
      +--- AuthListener
</pre>
****************************************************************************/

class AuthListener : public ActionListenerInterface 
{
 public:
    AuthListener() : _ok(FALSE) {};
    ~AuthListener() {};
    Boolean IsOK() {return _ok;};
    virtual void ActionPerformed(ActionEvent& event);

 private:
    Boolean _ok;
};


@endif


/***************************************************************************
CLASS
    RequestResponse

    The request response for receiving 

KEYWORDS
    

CLASS TREE
<pre>
   RequestResponse
</pre>
****************************************************************************/
@class RequestResponseClass, MetaClass;

/* public: */
/*    virtual ~RequestResponse() {}; */
    
    /*////////
    //
    // Request stream callback. This method is called from a request
    // we've submitted. The request data is provided in the stream.
    //
    // Parameters_
    //
    // [in]  stream   Pointer to a wwstream for reading only. Does not
    //                allow writing to it. Must NOT be deleted.
    //
    // Status_ Functional
    */
    @message /* virtual */ void AcceptStream(optr /* WWStream * */stream); /* = 0; */

    /*////////
    //
    // Request error message callback. 
    //
    // Parameters_
    //
    // [in]  msg    The error message if we care to print it. This is
    //              non-NULL.
    //
    // Status_ Functional
    */
    @message /* virtual */ void AcceptError(StatusInfo  msg); /*  {}; */

    /*////////
    //
    // Terminate request callback. The request id is provided.
    // The method must be thread safe.
    //
    // Status_ Functional
    */
    @message /* virtual */ void AcceptDone(); /*  {}; */

/* protected: */
    @message void RequestResponse(); /* {}; */

@endc;

typedef enum {
    REQUEST_UNKNOWN,
    REQUEST_GET,
    REQUEST_POST
} RequestType;

typedef enum {
    REQUEST_INT_OK,
    REQUEST_INT_NOT_MODIFIED,
    REQUEST_INT_RETRY,
    REQUEST_INT_ABORT
} RequestInternalCode;


/***************************************************************************
CLASS
    Request command.

    A request is a command object. It is created by HTRequestManager
    and submitted to a command scheduler (see
    CommandSchedulerClass in sched.h). The command scheduler deletes
    the command after it has finished using it.

    A request is executed by the scheduler via the
    HTRequest::Run() method, preempted by the scheduler via the 
    HTRequest::Preempt() method. Before the scheduler deletes the
    requests, it calls the HTRequest::Done() method. After which,
    the request is deleted.

    A request serves as a callback to HTRequestManager. It calls HTRequestManager
    back when there is a data object. However, if an error occurs 
    with the request (e.g., data object cannot be loaded), it calls
    HTRequestManager::AcceptError() method. Regardless of
    whether AcceptStream() or AcceptError() was called, the request
    will always call HTRequestManager::Done() before it is deleted.

 KEYWORDS

 CLASS TREE

<pre>
  Command
    |
    +--- HTRequest

  WWListElement
     |
     +---HTRequest
</pre>
****************************************************************************/
@if 0 // HTRequest is now a struct.
@class HTRequestClass, WWListElementClass;

/* public: */

    /*////////
    //
    // Constructor.
    //
    // Parameters_
    //
    // [in]  reqManager
    // [in]  target    The target for the response stream.
    // [in]  status    For reporting status, NULL if status report is
    //                 not desired.
    //
    // Status_ Functional
    */
    @message void HTRequest
          (optr /* HTRequestManager * */ reqManager, 
	   optr /* RequestResponse *  */ target, 
	   optr /* WWStatus *  */ status /* = NULL */);

    /*////////
    //
    // Destructor.
    //
    // Status_ Functional
    //

    ~HTRequest();

    */

     /*////////
     //
     // Initialize a Get request.
     //
     // Parameters_
     //
     // [in]  url     URL of data object to get.
     // [in]  proxyName
     // [in]  proxyPort
     //
     // Return_value_ REQUEST_OK
     //               REQUEST_OUT_OF_MEMORY
     //
     // See_also_ InitializePost()
     //
     // Status_ Functional
     */
     @message RequestResultCode InitializeGet(const char *url,
                                     const char *proxyName /* = NULL */,
                                     dword proxyPort /* = 80 */,
                                     LoadMode loadMode /* =
                                     HTMLViewer::LOAD_ANY_VERSION */);

     /*////////
     //
     // Initialize a Post request.
     //
     // Parameters_
     //
     // [in] url
     // [in] buffer     
     // [in] len
     // [in] file
     // [in] proxyName
     // [in] proxyPort
     //
     //
     // Return_value_ REQUEST_OK
     //               REQUEST_OUT_OF_MEMORY
     //
     // See_also_ InitializeGet()
     //
     // Status_ Functional
     */
     @message RequestResultCode InitializePost(const char *url,
					       const byte *buffer,
					       const dword len,
					       Boolean file /* = FALSE */,
					       const char *proxyName /* = NULL */,
					       dword proxyPort /* = 80 */);

    /*////////
    //
    // Get the request target
    //
    // Parameters_
    //
    // Return_value_ target
    //
    // Status_ Functional
    */
    @message optr /* RequestResponse* */ GetTarget(); /*  const */
    

    /*////////
    //
    // Get url. Null if no url.
    //
    // Return_value_ const char* or NULL
    //
    // Status_ Functional
    */
    @message const char *GetStrURL(); /* const  */


     /*////////
     //
     // Execute the request. Run to completion or until preempted by
     // Preempt().
     //
     // Parameters_
     //
     // [out] 
     // [in]  
     //
     // Return_value_ 
     //
     // See_also_ Preempt()
     //
     // Overrides_ Command::Execute()
     //
     // Status_ Functional
     */
     @message void Execute();

     /*////////
     //
     // Preempt Execute() method.
     //
     // Parameters_
     //
     // [out] 
     // [in]  
     //
     // Return_value_ 
     //
     // See_also_ 
     //
     // Overrides_ Command::Preempt()
     //
     // Status_ Functional
     */
     @message void Preempt();

     /*////////
     //
     // This method is called to tell us that the request is about to
     // be deleted. It must not be called while the object is still
     // be used; i.e., Execute() or Preempt() is running.
     //
     // Parameters_
     //
     // [out] 
     // [in]  
     //
     // Return_value_ 
     //
     // See_also_ 
     //
     // Overrides_ Command::Done()
     //
     // Status_ Functional
     */
     @message void Done();

 /*===========================================================================
 //
 //                       W A R N I N G 
