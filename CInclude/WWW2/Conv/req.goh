/*  private: */
    /*
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    */
/*
    HTRequest(const HTRequest&);
    const HTRequest& operator=(const HTRequest&);
*/

     /* Set stream and make it preemptable. */
     @message void SetStreamPreemptable(optr /* WWStream * */ stream);

     /* Delete stream synchronously.        */
     @message void DeleteStream();

#ifdef ERROR_CHECK
     /* Remove stream without deleting it   */
     @message optr /* WWStream* */ RemoveStream();
#endif

     /*
     // Create the appropriate protocol based on URL scheme.
     // Uses instance data _url and _stream.
     //
     // Parameters_
     //
     // [out] 
     // [in]  
     //
     // Return_value_ Protocol stream or NULL.
     //
     // See_also_ 
     //
     // Overrides_
     //
     // Status_ Functional
     */
     @message optr /* WWStream * */ LaunchEmail();
     @message optr /* WWStream * */ GetProtocol();
     @message optr /* WWStream * */ GetCache();
     @message optr /* WWStream * */ GetHTTP();
     @message optr /* WWStream * */ GetFile();
     @message optr /* WWStream * */ CacheHTTP
              (optr /* HTTP * */ http, optr /* HTResponse * */ resp);
     @message RequestInternalCode GenHTTPHeaders
              (optr /* HTTP * */ http, Boolean endHeader);
     @message RequestInternalCode GenHTTPPostData(optr /* HTTP * */ http);
     @message RequestInternalCode ParseHTTPResponse
              (optr /* HTTP * */ http, optr /* HTResponse * */ resp);
     @message char* GetLastModifiedDate();
     /* If URL has no scheme, default it to http:  */
     @message char* DuplicateURL(const char* url);

     @instance optr /* HTRequestManager * */ __reqManager;
     @instance optr /* RequestResponse *  */ __target;
     @instance optr /* WWStatus *         */ __status;

     /* Get or Post request */
     @instance RequestType                   __reqType;
     /* Where to load data from  */
     @instance LoadMode                      __loadMode;

     /* Data common to both Get and Post */
     @instance char *                        __url;
     @instance char *                        __proxyName;
     @instance dword                         __proxyPort;

     /* Data for Post only  */
     @instance byte *                        __postBuffer;
     @instance dword                         __postLen;
     @instance Boolean                       __postFile;

     /* The response stream.  If nonNUL, it can be preempted. */
     @instance optr /* WWStream * */         __stream;
                                            
                                /* This must be P() to change      */
                                /* _stream. Initially it is P()    */
                                /* by the constructor as value 0.  */
     @instance SemaphoreHandle /* Semaphore */__preemptStream;
                                /* Wait for Execute() to end.      */
     @instance SemaphoreHandle /* Semaphore */__waitForExecute; 

     /* Verify cache copy with server using GMT last-modified date. */
     @instance char *                        __lastModified;

     /* Authentication prompt for username and password             */
/*     AuthCommand _authReq; */
@endc;

@endif // @if 0

typedef struct {
    Command                       __meta;
    optr /* HTRequestManager * */ __reqManager;
    optr /* RequestResponse *  */ __target;
    optr /* WWStatus *         */ __status;

    /* Get or Post request */
    RequestType                   __reqType;
    /* Where to load data from  */
    LoadMode                      __loadMode;

    /* Data common to both Get and Post */
    char *                        __url;
    char *                        __proxyName;
    dword                         __proxyPort;

    /* Data for Post only  */
    byte *                        __postBuffer;
    dword                         __postLen;
    Boolean                       __postFile;

    /* The response stream.  If nonNUL, it can be preempted. */
    optr /* WWStream * */         __stream;
                                            
                                /* This must be P() to change      */
                                /* _stream. Initially it is P()    */
                                /* by the constructor as value 0.  */
    SemaphoreHandle /* Semaphore */__preemptStream;
                                /* Wait for Execute() to end.      */
    SemaphoreHandle /* Semaphore */__waitForExecute; 

    /* Verify cache copy with server using GMT last-modified date. */
    char *                        __lastModified;
    /* Authentication prompt for username and password             */
/*     AuthCommand _authReq; */
} HTRequest;

