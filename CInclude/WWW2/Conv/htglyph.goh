/***************************************************************************
CLASS
    HTComposite

    Composite glyphs contain children, so we need two child pointers;
    firstChild and lastChild.

    Memory Usage
    ------------
    * HTBoundedGlyph = 18 bytes
    * _firstChild    = 4 bytes
    * _lastChild     = 4 bytes
    Total            = 26 bytes

KEYWORDS


CLASS TREE
<pre>
    HTGlyph
       |
       +---HTBoundedGlyph
              |
              +---HTComposite
</pre>
****************************************************************************/
@class HTCompositeClass, HTBoundedGlyphClass;

// public:
//    virtual ~HTComposite();

    //////////
    //
    // Draw a composite. Normally, you would not intercept Draw(), 
    // you should intercept DrawSelf().
    //
    // Parameters_
    //
    // [out] panel      Physical window to draw the glyph. Window
    //                  coordinates is assumed to go from
    //                  (0,0) to window size.
    // [in]  exposed    Offset and size of the virtual window exposed.
    //                  exposed->offset is the offset from the drawing
    //                  window upper-left corner. A glyph must add
    //                  this offset to its _coord. The new coordinates
    //                  must fall into the rectangle
    //                     (0,0) to
    //                     (exposed->size.width, exposed->size.height)
    //                  in order for a glyph to draw.
    // [in]  context    The glyph context that maintains extrinsic
    //                  attributes of the glyph.  If NULL, no
    //                  extrinsic states.
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Draw()
    //
    // Status_ Functional
    //
    // virtual void Draw
    //		(FlexPanel *panel, HTOffsetAndSize exposed,
    //           HTGlyphContext *context = NULL);

    //////////
    //
    // Append a child glyph to a composite.
    //
    // Parameters_
    //
    // [in]  glyph   A child glyph to Append.
    //
    // Return_value_ TRUE ok, FALSE if out of memory.
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Append()
    //
    // Status_ Functional
    //
    // virtual Boolean Append(HTGlyph *glyph);

    //////////
    //
    // Remove the first child in the child list of a composite.
    //
    // Parameters_
    //
    // Return_value_ glyph or NULL if no child to remove
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Get()
    //
    // Status_ Functional
    //
    // virtual HTGlyph* GlyphGet();

    //////////
    //
    // Remove a child glyph from a composite.
    //
    // Parameters_
    //
    // [in] glyph   The child glyph to remove
    //
    // Return_value_ The removed glyph, NULL if the glyph
    //               is not a child of this composite.
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Remove()
    //
    // Status_ Functional
    //
    // virtual HTGlyph* GlyphRemove(HTGlyph *glyph);

    //////////
    //
    // Get the natural minimum and maximum widths of a composite by
    // getting the minmax of all its children glyphs.
    //
    // Parameters_
    //
    // [in] minmax  The min max accumulator
    //
    // Return_value_ TRUE if ok, FALSE otherwise.
    //
    // See_also_
    //
    // Overrides_ HTGlyph::GetMinMaxWidth()
    //
    // Status_ Functional
    //
    // virtual Boolean GetMinMaxWidth(MinMaxAccumulator *minmax);

    //////////
    //
    // Get the first child. Should be used with HTIterators so that
    // you don't access the pointer directly.
    //
    // Parameters_
    //
    // Return_value_ Point to the first child.
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message optr /* HTGlyph* */ FirstChild(); // const;

    //////////
    //
    // Get the last child. Should be used with care so that
    // you don't modify the pointer directly.
    //
    // Parameters_
    //
    // Return_value_ Point to the last child
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message optr /* HTGlyph* */ LastChild(); // const;

    //////////
    //
    // Pass the mouse event down to the children glyphs.
    //
    // Parameters_
    //
    // [in]  event      Mouse event.
    // [in]  point      Where the mouse pointer is.
    // [in]  frame      The top HTFrame object of the glyph.
    //
    // Return_value_ TRUE if the event is handled, else FALSE.
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
//    virtual Boolean HandleMouseEvent(MouseEvent& event, HTPoint point,
//                                     HTFrame *frame);

    //////////
    //
    // Check if a glyph is a direct or indirect child of this composite.
    //
    // Parameters_
    //
    // [in]  glyph
    //
    // Return_value_ TRUE/FALSE
    //
    // Status_ Functional
    //
    // virtual Boolean IsChild(HTGlyph *glyph);

#ifdef ERROR_CHECK
    //////////
    //
    // ECCheck self. Make sure that the composite object is
    // of the right type.
    //
    // Parameters_
    //
    // [in]  HTMLToken token
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message /* virtual */ void ECCheckSelf(HTMLToken token) ;
//    {
//    };
#endif

//===========================================================================
//
//                       W A R N I N G
//
// THE LIBERTY EXTERNAL API IS FOUND ABOVE THIS BARRIER. ANYTHING BELOW
// THIS NOTICE IS IMPLEMENTATION DEPENDENT AND SUBJECT TO CHANGE.
//
//
//===========================================================================
// protected:
    // Prevents direct instantiation of abstract class.
    @message void HTComposite();

    //
    // For composite to draw itself, arguments same as Draw().
    //
    @message /* virtual */ void DrawSelf
		(optr /* FlexPanel * */ panel, 
		 HTOffsetAndSize exposed,
        	 optr /* HTGlyphContext * */ context /* = NULL*/) ;
//    {
//    };

    //
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    //
//    HTComposite(const HTComposite&);
//    const HTComposite& operator=(const HTComposite&);

    // The child pointer. Children are linked together via their
    // _sibling pointer defined in HTGlyph. The last _sibling pointer
    // points to the parent.
    @instance optr /* HTGlyph * */ __firstChild;
    @instance optr /* HTGlyph * */ __lastChild;

@endc;



/***************************************************************************
