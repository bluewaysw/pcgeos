@importMessage MetaApplicationMessages, HTMLToken GetIdentity();
@importMessage MetaApplicationMessages, Boolean Format(optr formatter);
@importMessage MetaApplicationMessages, Boolean ParseAttrs(const SGMLEntity entity[]);

    //////////
    //
    // Rectangle of an area, where (x0, y0) represents the uppper left
    // corner and (x1, y1) represents the lower right corner coordinates.
    //
    //      (x0,y0) --------------
    //             |             |
    //             |             |
    //             |             |
    //             |             |
    //             --------------- (x1,y1)
    //
typedef struct 
{
    sword  x0;
    sdword y0;
    sword  x1;
    sdword y1;
} HTCoord;

    //////////
    //
    // A point on an area, where (x,y) represents the point.
    //
typedef struct 
{
    sword  x;
    sdword y;
} HTPoint;

    //////////
    //
    // A rectangle area size.
    //
typedef struct htSize
{
    sword  width;
    sdword height;
} HTSize;

    //////////
    //
    // Offset, could have negative values.
    //
typedef struct htOffset
{
    sword  x;
    sdword y;
} HTOffset;

    //////////
    //
    // Offset and size.
    //
typedef struct htOffsetAndSize
{
    HTOffset offset;
    HTSize   size;
} HTOffsetAndSize;

    //////////
    //
    // Intersection and overlapping of bounds states.
    //
    // [] HTGLYPH_ABOVE_BOUNDS  The whole glyph is above the bounds.
    // [] HTGLYPH_IN_BOUNDS     The glyph overlaps/intersects the bounds.
    // [] HTGLYPH_BELOW_BOUNDS  The whole glyph is below the bounds.
    // [] HTGLYPH_OUT_BOUNDS    Not inbound but can't determine
    //                          whether is above or below bounds.
    //
typedef enum {
    HTGLYPH_ABOVE_BOUNDS = 0,
    HTGLYPH_IN_BOUNDS,
    HTGLYPH_BELOW_BOUNDS,
    HTGLYPH_OUT_BOUNDS
} HTGlyphBoundsCheck;

    //////////
    //
    // HTML glyph alignment.
    //
    // [] HTALIGN_TOP      Top of the glyph aligns with the tallest
    //                     glyph on the line containing the image.
    // [] HTALIGN_MIDDLE   Center of the glyph aligns with the
    //                     baseline of the line containing the glyph.
    // [] HTALIGN_BOTTOM   Bottom of the glypg aligns with the baseline
    //                     of the line containing the glyph.
    // [] HTALIGN_LEFT     Float the glyph to the left margin, subsequent
    //                     text flows along the glyph's right side.
    // [] HTALIGN_RIGHT    Float the glyph to the right margin, subsequent
    //                     text flows along the glyph's left side.
    // [] HTALIGN_CENTER   Center all following rows.
    //
typedef enum {
    HTALIGN_TOP,
    HTALIGN_MIDDLE,
    HTALIGN_BOTTOM,
    HTALIGN_LEFT,
    HTALIGN_RIGHT,
    HTALIGN_CENTER
} HTAlignment;


    // Various flags to save memory
    //
    // [] pointToParent         This is 1 if the _sibling pointer
    //                          points to parent.
    // [] geometryValid         This is 1 if the geometry is valid. Geometry
    //                          is with respect to the position, not size.
    //                          For size, we use sizeValid flag.
    // [] sizeValid             1 if glyph size is not valid.
    // [] unused                Align the structure to 8-bit boundary.
    //
typedef struct glyphFlags
{
    unsigned  pointToParent : 1;    
    unsigned  geometryValid : 1;
    unsigned  sizeValid     : 1;
    unsigned  unused        : 5;
} GlyphFlags;


