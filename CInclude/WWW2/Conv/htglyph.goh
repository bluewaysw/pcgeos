/***************************************************************************
CLASS
    MinMaxAccumulator

    Used to accumulate the minimum and maximum widths of glyphs.

KEYWORDS
    

CLASS TREE
<pre>
    MinMaxAccumulator
</pre>
****************************************************************************/
@class MinMaxAccumulatorClass, MetaClass; 

// public:
    @message void MinMaxAccumulator();
//    virtual ~MinMaxAccumulator() {};

    // For a glyph to tell it needs to be on row by itself.
    @message void NewRow();

    // For a glyph to provide its min and max values.
    @message void AcceptMyMin(sword width);
    @message void AcceptMyMax(sword width);

    // Obtain the final computed min anx max values.
    @message sword GetMin();
    @message sword GetMax();

    // Add and subtract indent levels
    @message void IncrementIndent();
    @message void DecrementIndent();
    
// protected:
    // The final min and max values.
    @instance sword __min;
    @instance sword __max;

    // The running min and max values being computed.
    @instance sword __runningMin;
    @instance sword __runningMax;

    // Indent levels
    @instance word __indentLevel;

@endc;


@endif /* _HTGLYPH_H_ */
