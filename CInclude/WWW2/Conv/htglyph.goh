/***************************************************************************
CLASS
    HTGlyph

    The abstract class for all objects that can appear in a HTML
    document. These objects are divided into two categories; visible
    elements (such as characters and images) and structural elements
    (such as table, rows, and columns).

    The glyph methods are divided into three responsibilities.

    Responsibilities       Operations
    ----------------       ----------
       appearance          virtual void Draw(...)
                           virtual void SetBounds(...)

       hit detection       virtual HTGlyphBoundsCheck Intersects(...)
                           virtual HTGlyphBoundsCheck Overlap(...)

       structure           virtual Boolean Append(...)
                           virtual void Get(...)
                           virtual void Remove(...)
                           virtual HTGlyph* GetParent(...)

     Memory usage
     ------------
     * _sibling  = 4 bytes.
     * _flags    = 2 bytes
     Total       = 6 bytes.

KEYWORDS


CLASS TREE
<pre>
    HTGlyph
</pre>
****************************************************************************/
@class HTGlyphClass, MetaClass;

/* public: */
    //////////
    //
    // Destructor. Virtual for inheritance.
    //
    // Status_ Functional
    //

    // virtual ~HTGlyph() {};

    //////////
    //
    // Ask the glyph to draw itself to a window.
    //
    // Parameters_
    //
    // [out] panel      Physical window to draw the glyph. Window
    //                  coordinates is assumed to go from
    //                  (0,0) to window size.
    // [in]  exposed    Offset and size of the virtual window exposed.
    //                  exposed->offset is the offset from the drawing
    //                  window upper-left corner. A glyph must add
    //                  this offset to its _coord. The new coordinates
    //                  must fall into the rectangle
    //                     (0,0) to
    //                     (exposed->size.width, exposed->size.height)
    //                  in order for a glyph to draw.
    // [in]  context    The glyph context that maintains extrinsic
    //                  attributes of the glyph.  If NULL, no
    //                  extrinsic states.
    //
    // See_also_ RequestDraw()
    //
    // Status_ Functional
    //
    @message /* virtual */ void Draw(optr /* FlexPanel* */ panel,
                      HTOffsetAndSize exposed,
                      optr /* HTGlyphContext* */ context /* = NULL */ ); /* = 0; */

    //////////
    //
    // For a glyph to request to be drawn. 
    // If the glyph is in the drawing bounds, it will be called to 
    // draw sometime in the future. 
    //
    // Warning: There could be synchronization problem if the 
    //          glyph is being formatted while it makes a request to
    //          draw itself. To avoid this problem, the glyph should
    //          inherit HTGlyph::Format() such that it locks a semaphore
    //          before calling the formatter. The glyph should also
    //          lock the semaphore before calling RequestDraw() on
    //          itself.
    //
    // Parameters_
    //
    // [in]     child   NULL if the child is the glyph itself.
    //                  If not NULL, it must be the child of this
    //                  glyph.
    // [in]     coord   The absolute coords of child. NULL if child is
    //                  NULL to indicate the glyph itself.
    //
    // See_also_ Draw(), Format(), RequestDrawFromChild()
    //
    // Status_ Functional
    //
    @message /* virtual */ void RequestDraw(); /*  {}; */

    //////////
    //
    // Accept a request draw from child.
    //
    // Parameters_
    //
    // [in]     child   Must be a child of this composite.
    // [in]     coord   Absolute coords of the child.
    //
    // See_also_ Draw(), RequestDraw()
    //
    // Status_ Functional
    //
    @message /* virtual */ void RequestDrawFromChild
                                     (optr /* HTGlyph * */ child, 
                                      HTCoord coord); 
//    {
//    }

    //////////
    //
    // Accept a request to resize.
    // This is an up-call to the uitree to cause it to reformat, 
    // whereas SetSize() is a down-call. THis call also set size
    // invalid via SetSizeValid(FALSE).
    //
    // See_also_ SetSize()
    //
    // Status_ Functional
    //
    @message /* virtual */ void RequestSize();

    //////////
    //
    // Ask the glyph to handle the mouse event. If the event is
    // handled, the event will not be passed to other glyphs.
    //
    // Parameters_
    //
    // [in]  event      Mouse event.
    // [in]  point      Where the mouse pointer is.
    // [in]  frame      The top HTFrame object of the glyph.
    //
    // Return_value_ TRUE if the event is handled, else FALSE.
    //
    // Status_ Functional
    //
/*
    @message * virtual * Boolean HandleMouseEvent(MouseEvent& event,
                                     HTPoint point,
                                     HTFrame * frame); */

    //////////
    //
    // Format the glyph. 
    //
    // Warning: See the warning in RequestDraw().
    //
    // Parameters_
    //
    // [in]  formatter   This is the formatter that is used to
    //                   format this glyph.
    //
    // Return_value_     TRUE if ok, FALSE if out of memory.
    //
    // See_also_ RequestDraw()
    //
    // Status_ Functional
    //
//    @message virtual Boolean Format(HTFormat * formatter); // = 0;

    //////////
    //
    // Get composite identity. The identity of a composite is
    // the HTML token that generated the composite.
    //
    // Return_value_ HTMLToken
    //
    // Status_ Functional
    //
//    @message virtual HTMLToken GetIdentity(); // = 0;

    //////////
    //
    // Set the geometry of a glyph. A glyph with invalid geometry will
    // not be drawn.  A glyph with invalid geometry will be formatted.
    //
    // Parameters_
    //
    // [in]  flag   TRUE to set it valid, FALSE to set it invalid.
    //
    // Return_value_ Nothing
    //
    // Status_ Functional
    //
    @message void SetGeometryValid(Boolean flag);

    //////////
    //
    // Get the geometry state. Returns TRUE if geometry valid,
    // FALSE otherwise. Geometry is used to decide the position
    // of the glyph on screen.
    //
    // Return_value_ TRUE if geometry valid, FALSE otherwise.
    //
    // See_also_ SetGeometryValid()
    //
    // Status_ Functional
    //
    @message Boolean IsGeometryValid();

    //////////
    //
    // Get the resize state. Returns TRUE if a glyph has been
    // resize. Its geometry may still be valid.
    //
    // Return_value_ TRUE if glyph is resized and needs to 
    //               reformatted.
    //
    // See_also_ IsGeometryValid()
    //
    // Status_ Functional
    //
    @message Boolean IsSizeValid(); // const;

    // SetSize() also automatically calls SetSizeValid(TRUE).
    @message void SetSizeValid(Boolean flag);

    //////////
    //
    // Set the anchor of this glyph. A glyph does not necessarily
    // have an anchor. Only those that falls under <A> .. </A> do.
    //
    // Parameters_
    //
    // [in]  anchor
    //
    // Status_ Functional
    //
    @message /* virtual */ void SetAnchor(optr /* HTMLAnchorItem * */anchor);

    //////////
    //
    // Get the anchor of this glyph.
    //
    // Return_value_ anchor or NULL
    //
    // Status_ Functional
    //
    @message optr /* virtual HTMLAnchorItem* */ GetAnchor(); // const;

    //////////
    //
    // Get the natural minimum and maximum widths of the glyph.
    //
    // Parameters_
    //
    // [in] minmax  The min max accumulator
    //
    // Return_value_ TRUE if ok, FALSE otherwise.
    //
    // Status_ Functional
    //
    @message /* virtual */ Boolean GetMinMaxWidth(optr /* MinMaxAccumulator * */minmax); //  = 0;

    //////////
    //
    // Ask the glyph for its boundary.
    //
    // Parameters_
    //
    // [out] bounds  The bounds of the glyph, which contains
    //               coordinates relative to the parent.
    //
    // See_also_ SetBounds()
    //
    // Status_ Functional
    //
    @message /* virtual */ void GlyphGetBounds(HTCoord *bounds); // const = 0;

    //////////
    //
    // Ask the glyph for its absolute boundary, i.e. its
    // document coordinate
    //
    // Parameters_
    //
    // [out] bounds  The bounds of the glyph, which contains
    //               coordinates in document.
    //
    // Status_ Functional
    //
    @message /* virtual */ void GetAbsoluteBounds(HTCoord* rect); // = 0;

    //////////
    //
    // Set the bounds of a glyph.
    //
    // Parameters_
    //
    // [in]  bounds  The bounds of the glyph, which contains
    //               coordinates relative to the parent.
    //
    // See_also_ GetBounds()
    //
    // Status_ Functional
    //
    @message /* virtual */ void SetBounds(const HTCoord *bounds); // = 0;

    //////////
    //
    // Get the size of the glyph.
    //
    // Parameters_
    //
    // [out]   Size as the width and height of the bounds.
    //
    // Status_ Functional
    //
    @message /* virtual */ void GetSize(HTSize *size); // const = 0;
    @message /* virtual */ sword GetWidth(); // const = 0;
    @message /* virtual */ sdword GetHeight(); // const = 0;
    @message /* virtual */ Boolean HasSize(); // const = 0;

    //////////
    //
    // Set the size of the glyph by changing the bounds
    // from (0,0) to (width, height). This will also invalidate the
    // glyph's geometry causing it to be reformatted. So before you
    // set the size values, make sure they are different to avoid 
    // unnecessary reformat. This also calls SetSizeValid(TRUE).
    //
    // Parameters_
    //
    // [in] width  >= 0  Pixels
    // [in] heigth >= 0  Pixels
    //
    // See_also_ RequestSize()
    //
    // Status_ Functional
    //
    @message /* virtual */ void SetSize(sword width, sword height); // = 0;

    //////////
    //
    // Check to see if the glyph intersects a point.
    //
    // Parameters_
    //
    // [in]  point    Virtual document point to check for intersection.
    //
    // Return_value_ HTGLYPH_ABOVE_BOUNDS Glyph is above point.
    //               HTGLYPH_IN_BOUNDS    Glyph overlaps with point.
    //               HTGLYPH_BELOW_BOUNDS Glyph is below point.
    //               HTGLYPH_OUT_BOUNDS   None of the above.
    //
    // See_also_ Overlap()
    //
    // Status_ Funcional
    //
    @message /* virtual */ HTGlyphBoundsCheck Intersects(const HTPoint *point); // = 0;

    //////////
    //
    // Check to see a window overlaps the glyph.
    //
    // Parameters_
    //
    // [in]  exposed  The exposed region.
    //
    // Return_value_ HTGLYPH_ABOVE_BOUNDS Glyph is above exposed.
    //               HTGLYPH_IN_BOUNDS    Glyph overlaps with exposed.
    //               HTGLYPH_BELOW_BOUNDS Glyph is below exposed.
    //               HTGLYPH_OUT_BOUNDS   Not inbound but can't determine
    //                                    whether is above or below bounds.
    //
    // See_also_  Intersects()
    //
    // Status_ Functional
    //
    @message /* virtual */ HTGlyphBoundsCheck Overlap
                        (const HTOffsetAndSize *exposed); // = 0;

    //////////
    //
    // Get the glyph alignment.
    //
    // Return_value_ HTALIGN_BOTTOM, the default alignment of any glpyh.
    //
    // Status_ Functional
    //
    @message /* virtual */ HTAlignment GetAlignment(); // const 
/*    {
        return HTALIGN_BOTTOM;
    };
*/
    //////////
    //
    // Get the parent of the current glyph. If current glyph has no
    // parent, this method returns NULL.
    //
    // Return_value_ Parent glyph.
    //
    // See_also_ Get()
    //
    // Status_ Functional
    //
    @message optr /* HTGlyph* */ GetParent(); // const;

    //////////
    //
    // Append a child glyph.
    //
    // Parameters_
    //
    // [in]  glyph   A child glyph to Append.
    //
    // Return_value_ TRUE ok, FALSE if out of memory.
    //
    // See_also_ Get(), Remove()
    //
    // Status_ Functional
    //
    @message /* virtual */ Boolean Append(optr /* HTGlyph * */ glyph); // = 0;

    //////////
    //
    // Remove the first child in the child list.
    //
    // Parameters_
    //
    // Return_value_ glyph or NULL if no child to remove
    //
    // See_also_ GetParent(), Remove()
    //
    // Status_ Functional
    //
    @message optr /* virtual HTGlyph* */ GlyphGet(); // = 0;

    //////////
    //
    // Remove a child glyph.
    //
    // Parameters_
    //
    // [in] glyph   The child glyph to remove
    //
    // Return_value_ The removed glyph, NULL if the glyph
    //               is not a child of this composite.
    //
    // See_also_ Get()
    //
    // Status_ Functional
    //
    @message optr /* virtual HTGlyph* */ GlyphRemove(optr /* HTGlyph * */glyph); // = 0;

    //////////
    //
    // Insert a sibling. Note that a sibling is not a child.
    // This method append a sibling which is at the same
    // level as this glyph having the same parent.
    //
    // Parameters_
    //
    // [in]  sibling  The glyph to insert.
    // [in]  glyph    The new sibling will be inserted
    //                after this glyph and so both will
    //                have the same parent. If this is NULL,
    //                it will inserted to callee glyph.
    //
    // See_also_ Append(), GetSibling()
    //
    // Status_ Functional
    //
    @message void InsertSibling(optr /* HTGlyph * */ sibling, 
                                optr /* HTGlyph * */ glyph /* =NULL */);

    //////////
    //
    // Get the sibling pointer. This should be used with care as we
    // return the sibling pointer.
    //
    // Parameters_
    //
    // Return_value_ Sibling pointer, NULL if no sibling.
    //
    // See_also_ InsertSibling()
    //
    // Status_ Functional
    //
    @message optr /* HTGlyph* */ GetSibling(); // const;

    //////////
    //
    // Check if a glyph is a direct or indirect child of this glyph.
    //
    // Parameters_
    //
    // [in]  glyph
    //
    // Return_value_ TRUE/FALSE
    //
    // Status_ Functional
    //
    @message /* virtual */ Boolean IsChild(optr /* HTGlyph * */ glyph);

    @message Boolean DoesPointToParent();
    @message void SetPointToParent(unsigned state);
    @message void SetSiblingGlyph(optr glyph);
    @message optr GetSiblingGlyph();

#if ERROR_CHECK
    //////////
    //
    // This is a debugging tool for a glyph to print itself to a
    // file. The normal format for print self is as follows:
    //
    // [ MyIdentity MyInfo ] newline
    //
    // For example:
    //
    // [
    //   Bounds=(x0,y0),(x1,y1)
    //   Indentity=HTMLGLYPH_TEXT
    //   _textH="This is the string"
    //   _origLength=20
    //   _length=10
    // ]
    //
    // Parameters_
    //
    // [in] fp    File pointer to write stuff to.
    // [in] level Each glyph must print this preamble which
    //            identities the depth of the tree at each
    //            glyph. It has the format ".1.2.1.3" meaning
    //            Column 1, row 2, column 1, and row 3.
    //
    // Return_value_ Nothing
    //
    // Status_ Functional
    //
//    @message  virtual  void ECPrintSelf(File *fp, char *preamble); // = 0;

    // Print glyph bounds.
//    @message  virtual  void ECPrintBounds(File *fp); // = 0;
#endif

