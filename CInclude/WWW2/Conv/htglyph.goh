/* protected:
    friend class HTBoundedGlyph;
    friend class HTLeaf;
    friend class HTAnchoredLeaf;
    friend class HTComposite;
    friend class HTToken;
*/

    // Prevents direct instantiation of an abstract class.
    @message void HTGlyph(optr /* HTGlyph * */ parent /* = NULL */);

    //
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    //
//    HTGlyph(const HTGlyph&);
//    const HTGlyph& operator=(const HTGlyph&);

    // Various flags
    @instance GlyphFlags __flags;

    // Points to parent or self if no parent.
    // See note for _sibling why this is commented.
    // HTGlyph *_parent;

    // Points to the right sibling of the same parent.
    // All siblings of the same parent are linked together as a singly
    // link list using this pointer.
    //
    // Note: We make the last sibling point to the parent to save on
    //       _parent pointer using the _flags.
    //
    //       _sibling points to a parent _flags.pointToParent is 1.
    //
    @instance optr /* HTGlyph * */ __sibling;

@endc;



/***************************************************************************
CLASS
    HTBoundedGlyph

    Glyph with a bound.

    Memory usage
    ------------
    * HTGlyph  = 6  bytes
    * _coord   = 12 bytes
    Total      = 18 bytes

KEYWORDS
    

CLASS TREE
<pre>
    HTGlyph
       |
       +---HTBoundedGlyph
</pre>
****************************************************************************/
@class HTBoundedGlyphClass, HTGlyphClass;

/* public: */
    /* virtual ~HTBoundedGlyph() {}; */

    //////////
    //
    // For a glyph to request to be drawn. 
    // If the glyph is in the drawing bounds, it will be called to 
    // draw sometime in the future. 
    //
    // Warning: There could be synchronization problem if the 
    //          glyph is being formatted while it makes a request to
    //          draw itself. To avoid this problem, the glyph should
    //          inherit HTGlyph::Format() such that it locks a semaphore
    //          before calling the formatter. The glyph should also
    //          lock the semaphore before calling RequestDraw() on
    //          itself.
    //
    // Parameters_
    //
    // [in]     child   NULL if the child is the glyph itself.
    //                  If not NULL, it must be the child of this
    //                  glyph.
    // [in]     coord   The absolute coords of child. NULL if child is
    //                  NULL to indicate the glyph itself.
    //
    // See_also_ Draw(), Format(), RequestDrawFromChild()
    //
    // Overrides_ HTGlyph::RequestDraw()
    //
    // Status_ Functional
    //
    // @message  virtual void RequestDraw();

    //////////
    //
    // Accept a request draw from child.
    //
    // Parameters_
    //
    // [in]     child   Must be a child of this composite.
    // [in]     coord   Absolute coords of the child.
    //
    // See_also_ Draw(), RequestDraw()
    //
    // Overrides_ HTGlyph::RequestDrawFromChild()
    //
    // Status_ Functional
    //
    // @message virtual void RequestDrawFromChild
    //			(HTGlyph * child, HTCoord absCoord);

    //////////
    //
    // Ask the glyph for its boundary.
    //
    // Parameters_
    //
    // [out] bounds  The bounds of the glyph, which contains
    //               coordinates relative to the parent.
    //
    // Return_value_
    //
    // See_also_ SetBounds()
    //
    // Overrides_ HTGlyph::SetBounds()
    //
    // Status_ Functional
    //
    // @message virtual void GlyphGetBounds(HTCoord *bounds); /* const; */

    //////////
    //
    // Ask the glyph for its absolute boundary, i.e. its
    // document coordinate
    //
    // Parameters_
    //
    // [out] bounds  The bounds of the glyph, which contains
    //               coordinates in document.
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_ HTGlyph::GetAbsoluteBounds()
    //
    // Status_ Functional
    //
    // @message virtual void GetAbsoluteBounds(HTCoord* rect);

    //////////
    //
    // Set the bounds of a glyph.
    //
    // Parameters_
    //
    // [in]  bounds  The bounds of the glyph, which contains
    //               coordinates relative to the parent.
    //
    // Return_value_
    //
    // See_also_ GetBounds()
    //
    // Overrides_ HTGlyph::SetBounds()
    //
    // Status_ Functional
    //
    // @message virtual void SetBounds(const HTCoord *bounds);

    //////////
    //
    // Get the size of the glyph.
    //
    // Parameters_
    //
    // [out]   Size as the width and height of the bounds.
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_ HTGlyph::GetSize()
    //
    // Status_ Functional
    //
    // @message virtual void GetSize(HTSize *size) const;
    // @message virtual sword GetWidth() const;
    // @message virtual sdword GetHeight() const;
    // @message virtual Boolean HasSize() const;

    //////////
    //
    // Set the size of the glyph by changing the bounds
    // from (0,0) to (width, height). Also invalidates	
    // the geometry of the glyph by SetGeometryValid(FALSE).
    // But set size valid using SetSizeValid(TRUE);
    //
    // Parameters_
    //
    // [in] width  In pixels
    // [in] heigth In pixles
    //
    // Return_value_
    //
    // See_also_ GetSize(), SetGeometryValid()
    //
    // Overrides_ HTGlyph::SetSize()
    //
    // Status_ Functional
    //
    // @message virtual void SetSize(sword width, sword height);

    //////////
    //
    // Check to see if the glyph intersects a point.
    //
    // Parameters_
    //
    // [in]  point    Virtual document point to check for intersection.
    //
    // Return_value_ HTGLYPH_ABOVE_BOUNDS Glyph is above point.
    //               HTGLYPH_IN_BOUNDS    Glyph overlaps with point.
    //               HTGLYPH_BELOW_BOUNDS Glyph is below point.
    //               HTGLYPH_OUT_BOUNDS   None of the above.
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Intersects()
    //
    // Status_ Funcional
    //
    // @message virtual HTGlyphBoundsCheck Intersects(const HTPoint *point);

    //////////
    //
    // Check to see a window overlaps the glyph.
    //
    // Parameters_
    //
    // [in]  exposed  The exposed region.
    //
    // Return_value_ HTGLYPH_ABOVE_BOUNDS Glyph is above exposed.
    //               HTGLYPH_IN_BOUNDS    Glyph overlaps with exposed.
    //               HTGLYPH_BELOW_BOUNDS Glyph is below exposed.
    //               HTGLYPH_OUT_BOUNDS   Not inbound but can't determine
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Overlap()
    //
    // Status_ Functional
    //
    // @message virtual HTGlyphBoundsCheck Overlap(const HTOffsetAndSize *exposed);

#if ERROR_CHECK
    // Print glyph bounds.
    // @message virtual void ECPrintBounds(File *fp);
#endif

//===========================================================================
//
//                       W A R N I N G
//
// THE LIBERTY EXTERNAL API IS FOUND ABOVE THIS BARRIER. ANYTHING BELOW
// THIS NOTICE IS IMPLEMENTATION DEPENDENT AND SUBJECT TO CHANGE.
//
//
//===========================================================================
/* protected:
    friend class HTLeaf;
    friend class HTComposite;
*/    
    // Prevents direct instantiation
    @message void HTBoundedGlyph();
    
    //
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    //
/*
    HTBoundedGlyph(const HTBoundedGlyph&);
    const HTBoundedGlyph& operator=(const HTBoundedGlyph&);
*/
    //
    // Bounds of the glyph in the virtual window relative to the parent.
    //
    @instance HTCoord __coord;

@endc;



/***************************************************************************
CLASS
    HTLeaf

    Leaf glyphs do not contain children, so we save on the child
    pointer. HTLeaf provides default handlers for most of the 
    methods from HTGlyph.

    Memory usage
    ------------
    * HTBoundedGlyph  = 18 bytes
    Total             = 18 bytes

KEYWORDS


CLASS TREE
<pre>
    HTGlyph
       |
       +---HTBoundedGlyph
              |
              +---HTLeaf
</pre>
****************************************************************************/
@class HTLeafClass, HTBoundedGlyphClass;

// public:
//    virtual ~HTLeaf() {};

    //////////
    //
    // Append a child glyph.
    // This method is not allowed for Leaf and will EC crash if called.
    //
    // Parameters_
    //
    // [in]  glyph   A child glyph to Append.
    //
    // Return_value_ TRUE ok, FALSE if out of memory.
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Append()
    //
    // Status_ Functional
    //
    // virtual Boolean Append(HTGlyph *glyph);

    //////////
    //
    // Remove the first child in the child list.
    // This method is not allowed for Leaf and will EC crash if called.
    //
    // Parameters_
    //
    // Return_value_ glyph or NULL if no child to remove
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Get()
    //
    // Status_ Functional
    //
    // virtual HTGlyph* Get();

    //////////
    //
    // Remove a child glyph.
    // This method is not allowed for Leaf and will EC crash if called.
    //
    // Parameters_
    //
    // [in] glyph   The child glyph to remove
    //
    // Return_value_ The removed glyph, NULL if the glyph
    //               is not a child of this composite.
    //
    // See_also_
    //
    // Overrides_ HTGlyph::Remove()
    //
    // Status_ Functional
    //
    // virtual HTGlyph* Remove(HTGlyph *glyph);

//===========================================================================
//
//                       W A R N I N G
//
// THE LIBERTY EXTERNAL API IS FOUND ABOVE THIS BARRIER. ANYTHING BELOW
// THIS NOTICE IS IMPLEMENTATION DEPENDENT AND SUBJECT TO CHANGE.
//
//
//===========================================================================
// protected:
    // Prevents direct instantiation of abstract class.
    @message void HTLeaf();

    //
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    //
//    HTLeaf(const HTLeaf&);
//    const HTLeaf& operator=(const HTLeaf&);

@endc;


