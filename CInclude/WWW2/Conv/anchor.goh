@ifndef _ANCHOR_H_
@define _ANCHOR_H_

@include <stdapp.goh>
@include "WWW2/WW2Core/ww2string.goh"
@include "WWW2/WW2Core/ww2mlist.goh"
@include "WWW2/Conv/htmldtd.goh"
@include "WWW2/Conv/htglyph.goh"
@include "WWW2/ww2mem.h"


/***************************************************************************
CLASS
    HTMLAnchorItem

    HTML anchor item, corresponding to HTML <A> tag.

KEYWORDS
    hyperlink, anchor, hypertext.

CLASS TREE
<pre>
    HTGlyph
       |
       +---WWListElement
              |
              +---HTComposite
                     |
                     +---HTMLAnchorItem
    WWWListElement
       |
       +---HTMLAnchorItem
</pre>
****************************************************************************/
@class HTMLAnchorItemClass, HTCompositeClass; // , public WWListElement

// public:
    //////////
    //
    // Constructor.  Create an anchor item to store the attributes of <A>
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void HTMLAnchorItem();

    //////////
    //
    // Destructor.
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
//    ~HTMLAnchorItem();

    //////////
    //
    // Parse the attributes of <A>.
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
//    @message Boolean ParseAttrs(const SGMLEntity entity[]);

    //////////
    //
    // Get HREF attribute of the anchor
    //
    // Parameters_
    //
    // Return_value_ WWMemHandle
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message WWMemHandle GetHref(); //  { return _href; };

    //////////
    //
    // Get NAME attribute of the anchor
    //
    // Parameters_
    //
    // Return_value_ WWMemHandle
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message WWMemHandle GetName(); // { return _name; };

    //////////
    //
    // Get TARGET attribute of the anchor
    //
    // Parameters_
    //
    // Return_value_ WWMemHandle
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message WWMemHandle AnchorGetTarget(); // { return _target; };

    //////////
    //
    // Get TITLE attribute of the anchor
    //
    // Parameters_
    //
    // Return_value_ WWMemHandle
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message WWMemHandle GetTitle(); // { return _title; };

    //////////
    //
    // Store the first chlid.
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void SetFirstChild(optr /* HTGlyph * */ child); // { _firstChild = child; };

    //////////
    //
    // Get TITLE attribute of the anchor
    //
    // Parameters_
    //
    // Return_value_ WWMemHandle
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message optr /* HTGlyph* */ GetFirstChild(); // { return _firstChild; };

    // Inherited methods from HTGlyph and HTComposite
//    @message virtual HTMLToken GetIdentity(); //  { return HTMLT_A; };
//    @message virtual Boolean Format(HTFormat * formatter);
//    virtual void RequestBounds(HTGlyph *child, HTSize *newSize) 
//    {
//        USE_IT(child);
//        USE_IT(newSize);
//    };
#ifdef ERROR_CHECK
//    virtual void ECCheckSelf(HTMLToken token);
//    virtual void ECPrintSelf(File *fp, char *preamble) 
//    {
//        USE_IT(fp);
//        USE_IT(preamble);
//    };
#endif

// private:
    // store HREF attribute in <A>
    @instance WWMemHandle                         __href;
    // store NAME attribute in <A>
    @instance WWMemHandle                         __name;
    // store TARGET attribute in <A>
    @instance WWMemHandle                         __target;
    // store TITLE attribute in <A>
    @instance WWMemHandle                         __title;
    // store the first child.
    @instance optr /* HTGlyph * */                ___firstChild;

@endc;


/***************************************************************************
CLASS
    HTMLAnchorList

    Define a list to keep track of all anchor items. And also to
    manipulate these anchors efficiently. 

KEYWORDS
    Anchor

CLASS TREE
<pre>
    WWList
       |
       +---HTMLAnchorList
</pre>
****************************************************************************/
@class HTMLAnchorListClass, WWListClass;

// public:
    //////////
    //
    // Constructor
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void HTMLAnchorList();

    //////////
    //
    // Destructor
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
//    virtual ~HTMLAnchorList();

    //////////
    //
    // Find a anchor object that has the matching NAME attribute.
    //
    // Parameters_ name - NAME attribute.
    //
    // Return_value_  HTMLAnchorItem if found.  NULL otherwise.
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message optr /* HTMLAnchorItem* */ FindNameAnchor(char *name);

    //////////
    //
    // Store the anchor name.
    //
    // Parameters_ anchorName - #name
    //
    // Return_value_  
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void SetAnchorToBeViewed(WWMemHandle anchorName);

    //////////
    //
    // Append an HTMLAnchorItem, also check if we need to find
    // a matching anchor object and bring it up on the screen.
    //
    // Parameters_ HTMLAnchorItem object.
    //
    // Return_value_  
    //
    // See_also_ WWList::Append
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void AnchorAppend(optr /* WWListElement * */ element);

    //////////
    //
    // Set the Frame.
    //
    // Parameters_ htframe
    //
    // Return_value_  
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void SetFrame(optr /* HTFrame * */ frame); // { _frame = frame; } ;

// protected:
    // Store the anchor name that all the appended HTMLAnchor item
    // should compare.
    @instance WWMemHandle             __anchorNameToBeViewed;
    // htframe.
    @instance optr /*  HTFrame * */   __frame;

@endc;

@endif /* _ANCHOR_H_ */
