/* protected: */
/*    friend class HTRequest; */

    /*
    // Request stream callback. This method is called from a request
    // we've submitted. The request data is provided in the stream.
    // If there is no stream, this method will not be called.
    //
    // Parameters_
    //
    // [in]  stream   Pointer to a wwstream for reading only.
    // [in]  request  The request that created this stream.
    //
    // Return_value_ 
    //
    // See_also_ AcceptDone()
    //
    // Status_ Functional
    */
    @message void ViewerAcceptStream(optr /* WWStream * */ stream, 
				     HTRequest *req);

    /*
    // Terminate request callback. The method must be thread safe. 
    // The request will be deleted when the call returns.
    // This method will always be called even if AcceptStream() was
    // not called.
    //
    // Parameters_
    //
    // [in]  request  Request submitted earlier.
    //
    // See_also_ AcceptStream()
    //
    // Status_ Functional
    */
    @message void ViewerAcceptDone(HTRequest *request);

    /*
    // Main HTML parsing routine.
    //
    // Status_ Functional
    */
    @message void ParseHTML(optr /* WWStream * */ stream, 
			    HTRequest *req); 

    /*
    // Main image parsing routine.
    //
    // Status_ Functional
    */
    @message void ParseImage(optr /* WWStream * */ stream, 
			     HTRequest *req);

/* protected: */
/*    friend class HTRequestManager; */

    /*
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    */
/*
    HTMLViewer(const HTMLViewer&);
    const HTMLViewer& operator=(const HTMLViewer&);
*/

/*    AppBase             *_appbase;          // For attaching UI and */
    @instance optr                             __appHandle;
    @instance optr /* FlexFrame           * */ __flexframe;
    /* Request manager */
    @instance optr /* HTRequestManager    * */ __reqManager;

    /* WWList _frameList;
    // Testing with one frame and one url only
    // Need a semaphore to protect frame or framelist
    */
    @instance SemaphoreHandle /* Semaphore  */ __frameSem;
    @instance optr            /* WWFrame *  */ __wwFrame;

    //the position and size used to display html pages
    @instance word                             __xPos;
    @instance word                             __yPos;
    @instance word                             __width;
    @instance word                             __height;

@endc;


@endif // #ifndef _WWW_CONV_HTML_H_
