/***************************************************************************
CLASS
    HTChildrenIterator

    HTComposite children iterator.

KEYWORDS
    

CLASS TREE
<pre>
    HTChildrenIterator
</pre>
****************************************************************************/
@class HTChildrenIteratorClass, MetaClass;

// public:
    @message void HTChildrenIterator(optr /* HTComposite * */ parent /* = NULL */);
//    ~HTChildrenIterator() {};
    @message void HTCIInitialize(optr /* HTComposite * */ parent);
    @message void HTCIFirst();
    @message void HTCINext();
    @message Boolean HTCIIsDone(); // const;
    @message optr /* HTGlyph* */ CurrentGlyph (); // const;

// private:
    //
    // Don't let users call copy the object in any way.  These methods
