    // Mapping of functions
//    typedef Boolean (HTFrame::*StartFunc) (const SGMLEntity[]);
//    typedef Boolean (HTFrame::*EndFunc) ();

    typedef Boolean (*StartFunc) (const SGMLEntity[]);
    typedef Boolean (*EndFunc) ();

    typedef struct {
        HTMLToken   token;
        StartFunc   startFunc;
        EndFunc     endFunc;
    } UIFunctionMap;

    typedef struct {
        sbyte nestingLevel; // If zero, won't accept table related tags
    } HTTableCorrection;

/***************************************************************************
CLASS
    HTFrame

    HTML frame, corresponding to HTML <FRAME> tag. A document can have
    multiple frames.

KEYWORDS


CLASS TREE
<pre>
    WWFrame
       |
       +---HTFrame

    Target
       |
       +---HTFrame

    WWListElement
       |
       +---HTFrame
</pre>
****************************************************************************/
@class HTFrameClass, WWFrameClass;
//                public Target,
//                public WWListElement,
//                public MouseAdapter,
//                public MouseMotionAdapter,
//                public KeyAdapter,
//                public AdjustmentListenerInterface

// public:
    //////////
    //
    // Constructor
    //
    // Parameters_
    //
    // [in]  requestManager
    // [in]  urlH      This will be deleted by HTFrame later.
    // [in]  coordX    Position of screen at x coordinate
    // [in]  coordY    Position of screen at y coordinate
    // [in]  width     Width of screen
    // [in]  height    Height of screen
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void HTFrame(optr /* HTRequestManager * */ reqManager,
			  WWMemHandle urlH,
			  word coordX, word coordY,
			  word width, word height);

    //////////
    //
    // Destructor.
    //
    // Parameters_
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
//    ~HTFrame();

    //////////
    //
    // Initialize a frame. This method must be called before other
    // methods can be used.
    //
    // Parameters_
    //
    // Return_value_ TRUE if initialized
    //               FALSE if failed to initialize due to lack of memory.
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message Boolean FrameInitialize();

    //////////
    //
    // Set the bounds of a HTFrame.
    //
    // Parameters_
    //
    // [out] 
    // [in]  
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void HTFrameSetBounds(const HTCoord *bounds);

    //////////
    //
    // Draw a frame
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void DrawFrame();
    @message void DrawText();

    //////////
    //
    // Draw a htglyph under a frame. The glyph must be in the uitree
    // of the frame for it to be drawn.
    //
    // Parameters_
    //
    // [in]  glyph           The glyph to draw.
    // [in]  absCoord        The absolute coords of the glyph.
    //
    // See_also_ Draw()
    //
    // Status_ Functional
    //
    @message void DrawGlyph(optr /* HTGlyph * */ glyph, const HTCoord *absCoord);

    //////////
    //
    // Accept a request to draw from a glyph in the uitree.
    //
    // Parameters_
    //
    // [in]  glyph     The glyph that needs to draw
    // [in]  absCoord  The absolute coords of the glyph.
    //
    // Status_ Functional
    //
    @message /* virtual */ void HTFrameRequestDraw
                (optr /* HTGlyph * */ glyph, const HTCoord *absCoord);

    @message Boolean IsProgressiveDisplay(); // const 
//    {
//        return _progressiveDisplay;
//    }

    //////////
    //
    // We are done getting all the tokens and data. This allows
    // HTFrame to cleanup data allocated during formatting.
    //
    // Parameters_
    //
    // Return_value_ Nothing
    //
    // See_also_
    //
    // Overrides_ WWFrame::Done()
    //
    // Status_ Functional
    //
    @message /* virtual */ void HTFrameDone();


    //////////
    //
    // Local version of GetURL.
    //
    // Parameters_
    // 
    // [in]  url
    // [in]  loadMode
    // [in]  target            For receiving response stream.
    //
    // Return_value_ TRUE if ok, FALSE if out of memory.
    //
    // See_also_ PostURL()
    //
    // Status_ Functional
    //
    @message void HTFrameGetURL(const char *url,
                      LoadMode loadMode /* = LOAD_ANY_VERSION */,
                      optr /* RequestResponse * */ target /* = NULL */);

    // Get URL and notify the viewer.
    @message void HTFrameGetURLNotify(const char *url,
			       LoadMode loadMode /* = LOAD_ANY_VERSION */,
			       optr /* RequestResponse * */ target /* =NULL*/);

    //////////
    //
    // Local version of PostURL().
    //
    // Parameters_
    // 
    // [in]  url          Valid url as per RFC1738. If the URL has no
    //                    scheme, the default scheme is http://.
    // [in]  buffer       Form data to send. Must be encoded for 
    //                    content-type application/x-www-form-urlencoded.
    //                    Or path to local temporary filename.
    // [in]  len          Length of the buffer.
    // [in]  file         Whether to post a file. Values:
    //                    * TRUE: Post the file whose path is specified 
    //                      in buffer, then delete the file. 
    //                      This is not implemented.
    //                    * FALSE: Post the raw data in buffer.
    //
    // Return_value_ TRUE if ok, FALSE if out of memory.
    //
    // See_also_ PostURL()
    //
    // Status_ Functional
    //
    @message void HTFramePostURL(const char *url,
			  const byte *buffer,
			  const dword len,
			  Boolean file /* = FALSE */);

    // Post URL and notify viewer.
    @message void PostURLNotify(const char *url,
                    const byte *buffer,
                    const dword len,
                    Boolean file /* = FALSE */ );

    //////////
    //
    // Get request manager.
    //
    // Return_value_ request manager.
    //
    // Status_ Functional
    //
    @message optr /* HTRequestManager* */ HTFrameGetRequestManager(); // const {return _reqManager;}

    //////////
    //
    // Get base URL.
    //
    // Parameters_
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message WWMemHandle GetBaseUrlH(); // {return _baseUrlH;};

    //////////
    //
    // Get URL.
    //
    // Parameters_
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message WWMemHandle GetUrlH(); // {return _urlH;};

    //////////
    //
    // Get Anchor List
    //
    // Parameters_
    //
    // Return_value_
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message optr /* HTMLAnchorList * */ GetAnchorList(); // {return &_anchorList;};

    //////////
    //
    // Ask the frame to find the matching anchor object.
    //
    // Parameters_ char* name.
    //
    // Return_value_ TRUE if Found, FALSE otherwise.
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message optr /* HTMLAnchorItem* */ HTFrameFindNameAnchor(char *name);

    //////////
    //
    // Scroll the document to bring the passed coordinate onto the screen.
    //
    // Parameters_ HTCoord
    //
    // Return_value_ 
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void DisplayPosition(HTCoord *rect);

    //////////
    //
    // Append a message to the ui message queue to scroll the document to 
    // bring the passed coordinate onto the screen.
    //
    // Parameters_ HTCoord
    //
    // Return_value_ 
    //
    // See_also_  DisplayAnchorPosition, which is the callback function.
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void DisplayPositionOnUIThread(HTCoord *rect);

    //////////
    //
    // Setting the frame's visibility.
    //
    // Parameters_ visible: TRUE/FALSE
    //
    // Return_value_ 
    //
    // See_also_  
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message void HTFrameSetVisible(Boolean visible);

    @message WWMemHandle GetUseMapHrefAt(const char *name, HTPoint point);
//    {
//        return _mapList.GetHrefFromMapAt(name, point);
//    };

@if 0
