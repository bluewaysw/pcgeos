    void LogBlock(const uint8 *data, uint32 length);

    File *_logFile;
#endif

@endc;


@if 0
/***************************************************************************
CLASS
    HTUITree

    The root our HTML ui tree.

KEYWORDS
    

CLASS TREE
<pre>
    HTColumn
       |
       +---HTUITree
</pre>
****************************************************************************/
@class HTUITreeClass, HTColumnClass

// public:
    HTUITree(HTFrame *frame) : _frame(frame) 
        {PARAM_ASSERT(frame);};

    virtual ~HTUITree() {};

    // Inherited methods from HTGlyph & HTComposite. We use this tell 
    // HTFrame we are changing bounds.
    virtual void SetBounds(const HTCoord *bounds);
    // Accept a request draw from child and pass it on to the frame
    virtual void RequestDrawFromChild(HTGlyph *child, 
                                      HTCoord absCoord) 
    {
        PARAM_ASSERT(child);
        _frame->RequestDraw(child, &absCoord);
    };
    // Accept a request for new size from child. We use this info
    // to reformat the uitree.
    virtual void RequestSize() 
    {
        _frame->Reformat();
    }

// protected:
    // The frame where this UI tree sits.
    HTFrame *_frame;

@endc;


/***************************************************************************
CLASS
    DummyUI

    This class defines a dummy ui object, which will be added to the ui
    tree under HTFrame::_panel. All this class does is that receiving a
    paint() message when we add a new FlexComponent to the _panel, and
    send draw message to HTFrame.

KEYWORDS
    

CLASS TREE
<pre>
    FlexComponent
       |
       +---DummyUI
</pre>
****************************************************************************/
class DummyUI : public FlexComponent
{
public:
    DummyUI(HTFrame *frame) : _frame(frame) 
        {PARAM_ASSERT(frame);};

    //
    // This is override the system method, so we can ask the frame to
    // redraw the screen.
    void Paint(void)
    {
        _frame->DrawText();
    };

private:
    HTFrame	*_frame;
};

@endif // if 0

@endif /* _HTFRAME_H_ */


