    //
    // Check if the _composition is the current composite target.
    //
    // Parameters_
    //
    // Return_value_ TRUE if _composition is the current composite
    //               target, FALSE otherwise.
    //
    // See_also_
    //
    // Overrides_
    //
    // Status_ Functional
    //
    @message Boolean IsCompositionTarget();

// private:
    @instance optr /* HTRequestManager  * */ __reqManager;
    // The root of our UI tree.
    @instance optr /* HTUITree * */          __uitree;

    // Targets for text and tokens
    //
    // Text target list is a FIFO list; mirroring the way
    // SGML and HTML parsers spit out tokens to us.
    // Must use WWList.Prepend() on _textTargetList, DO NOT
    // use WWList.Append() as it is a FIFO list.
    @instance optr /* WWList      */         __textTargetList;

    // FIFO order of composite targets for append glyphs to.
    @instance optr /* CompositeTargetList * */ __compositeTargetList;

    // Compositor that does the actual formatting
    @instance optr /* HTFormat    * */         __compositor;
    @instance optr /* HTFormatContext * */     __formatContext;
    @instance optr /* HTPreformatContext * */  __preformatContext;
    @instance Boolean                          __finishFormat;
    @instance Boolean                          __needToReformat;
    @instance SemaphoreHandle                  __formatSem;

    // To allow us to wait for glyphs with no size to be loaded
    // before we format them.
    @instance sword                            __noSizeGlyph;
    @instance SemaphoreHandle                  __noSizeGlyphSem;

    // The composition, the glyhps to be formatted by
    // the _compositor.
    @instance optr /* HTComposition */         __composition;

    // Stores all the anchors of the page.
    @instance optr /* HTMLAnchorList */        __anchorList;

    // stores all the maps
    @instance optr /* HTMapList */             __mapList;

    // the list of all the forms inside this page.
    @instance optr /* WWList    */             __formList;
    @instance optr /* HTForm      * */         __currentForm;

    // The drawing context
    @instance optr /* HTGlyphContext   * */    __glyphContext;
    // The progressive display flag, which tells us to draw when 
    // we update our bounds.
    @instance Boolean                          __progressiveDisplay;

    // Frame document information
    @instance TCHAR * __title;   // Has to be fixed memory as Goes UI 
                                 // expects it to avoid garbage title
    @instance WWMemHandle                      __urlH;
    @instance WWMemHandle                      __baseUrlH;

    // The exposed part of the virtual document that is
    // currently visible on screen.
    // _exposed.offset is negated from the scollbar positions.
    // _exposed.size is the size of the window starting from (0,0).
    @instance HTOffsetAndSize                  __exposed;

    // This is the physical window for drawing everything.
    // Its drawing coordinates go from (0,0) to its (width, height).
    @instance optr /* FlexPanel * */           __panel;
    @instance optr /* DummyUI   * */           __dummy;
    @instance optr /* FlexPanel * */           __outerPanel;
    @instance optr /* FlexScrollbar * */       __vScrollbar;
    @instance optr /* FlexScrollbar * */       __hScrollbar;

    // Ignore leading LWS
    @instance Boolean                          __ignoreLWS;

    // Table correction to fit our UI tree and formatting algorithm.
    // Table nesting level. If this is zero, we won't allow
    // TR, TD, THEAD, etc.
    @instance HTTableCorrection                __tableCorrection;

@if NOT_DEFINED_YET
    // Info generated from body level tags; <basefont>, <body>
    @instance HTTextState                      __baseTextState;
@endif


#ifdef GR_NATIVE16
    HTBGImage   *_backgroundImage;
    Colorant _bgColor;
    Colorant _linkColor;
#endif


#ifdef ERROR_CHECK
    @instance Boolean                          __initialized;
