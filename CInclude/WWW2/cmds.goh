@ifndef __CMDS_GOH
@define __CMDS_GOH

/***************************************************************************
CLASS
    SchedulerCommand

KEYWORDS
    

CLASS TREE
<pre>
Command
   |
   +--- SchedulerCommand
</pre>
****************************************************************************/
typedef struct {
  Command __meta;
  optr /* CommandScheduler * */ __sched;
} SchedulerCommand;



/***************************************************************************
CLASS
    CommandElement

KEYWORDS

CLASS TREE
<pre>
   WWListElement
       |
       +--- CommandElement
</pre>
****************************************************************************/
@class CommandElementClass, WWListElementClass;
/* public:*/

    @message void CommandElement(Command *cmd) /* : _cmd(cmd), _preempted(FALSE) {} */ ;
    /* ~CommandElement() {};*/
    @message Command* CommandGet() /* {return _cmd;} */ ;
    @message void SetPreempted() /* {_preempted = TRUE;} */ ;
    @message Boolean IsPreempted() /* {return _preempted;} */ ;

/* private: */
/*
    //
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    //
    CommandElement(const CommandElement&);
    const CommandElement& operator=(const CommandElement&);
*/

    @instance Command *__cmd;
    @instance Boolean __preempted;          // To make sure preempt once only
@endc;

@endif /* __CMDS_GOH */
