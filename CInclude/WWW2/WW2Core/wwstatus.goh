@ifndef _WWSTATUS_H_
@define _WWSTATUS_H_

/***************************************************************************
CLASS
    WWStatus

    WW Status Manager

KEYWORDS
    

CLASS TREE
<pre>
    WWStatus
</pre>
****************************************************************************/

typedef enum {
    /* Loading messages */
    WWSTATUS_LOADING_MAIN_DOC,
    WWSTATUS_DONE,

    /* HTTP protocol messages */
    WWSTATUS_CONNECTING_HOST,
    WWSTATUS_CANNOT_RESOLVE_HOST,
    WWSTATUS_CANNOT_RESOLVE_PROXY,
    WWSTATUS_CANNOT_CONNECT_HOST,
    WWSTATUS_CANNOT_CONNECT_PROXY,
    WWSTATUS_CANNOT_CREATE_HTTP_PROTOCOL,
    WWSTATUS_HTTP_PROTOCOL_OUT_OF_MEMORY,
    WWSTATUS_HTTP_REQUEST_ERROR,

    /* File protocol messages */
    WWSTATUS_CANNOT_CREATE_FILE_PROTOCOL,
    WWSTATUS_READING_FILE,
    WWSTATUS_FILE_PROTOCOL_OUT_OF_MEMORY,
    WWSTATUS_FILE_PROTOCOL_CANNOT_OPEN_FILE,
    WWSTATUS_REMOVING_CACHE_FILES
} StatusInfo;

@class WWStatusClass, MetaClass;

/* public: */

    /*////////
    //
    // Destructor
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    //

    virtual ~WWStatus() {};

    */

    /*////////
    //
    // Accept a string status message.
    //
    // Parameters_
    //
    // [in]  msg    Null-terminated message.
    //
    // Return_value_ Nothing.
    //
    // See_also_ Report(uint32, uint32)
    //
    // Overrides_
    //
    // Status_ Functional
    */
    @message /* virtual */ void Report(StatusInfo msg); /* = 0; */
    
    /*////////
    //
    // Accept a numerical status message.
    //
    // Parameters_
    //
    // [in]  loaded       Number of bytes loaded.
    // [in]  totalLength  > 0. The length of the data to load.
    //                    So (loaded/totalLength * 100) is the 
    //                    percentage of data loaded. 
    //  
    //                    = 0. The totalLength unknown.
    //
    // Return_value_ Nothing.
    //
    // See_also_ Report(WWStatus::StatusInfo)
    //
    // Overrides_
    //
    // Status_ Functional
    */
    @message /* virtual */ void ReportDWord(dword loaded, dword totalLength); /* = 0; */

    /*////////
    //
    // Accept a text message.
    //
    // Parameters_
    //
    // [in]  text messages
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    */
    @message /* virtual */ void ReportTCHAR(const TCHAR* msg); /* = 0; */
    
/* protected: */

    /*////////
    //
    // Constructor. To prevent direct instantiation.
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    */
    @message void WWStatus(); /* {}; */
@endc;


@endif /* _WWSTATUS_H_ */
