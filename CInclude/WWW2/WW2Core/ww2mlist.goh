@ifndef _WWMLIST_H_
@define _WWMLIST_H_

@include <stdapp.goh>

/* 
 *                 W A R N I N G
 *
 * This typedef is NOT public and subject to change. 
 */
typedef optr WWListHandle;


    /**
     *
     * Create a movable WWList where all items have the same
     * size.
     *
     * [in]  itemSize   WWListHandle to delete.
     *
     * Return_value_ WWListHandle or NULL if not created.
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional.
     */
WWListHandle _far _pascal WWListNew(word itemSize);

    /**
     *
     * Delete a movable WWList. All the items in the list will be 
     * deleted as well. It is illegal to have any locks on the list
     * when WWListDelete() is called.
     *
     * [out] 
     * [in]  list   WWListHandle to delete.
     *
     * Return_value_ 
     *
     * See_also_ WWListDeleteAll
     *
     * Overrides_
     *
     * Status_ Functional.
     */
void _far _pascal WWListDelete(WWListHandle list);

    /**
     *
     * Delete all items in a WWListHandle.  The list itself is not 
     * deleted and remain usable. It is illegal to have any locks on the
     * list when WWListDeleteAllItems() is called.
     *
     * [out] 
     * [in]  list   WWListHandle to delete all items.
     *
     * Return_value_ 
     *
     * See_also_ WWListDelete
     *
     * Overrides_
     *
     * Status_ Functional
     */
void _far _pascal WWListDeleteAllItems(WWListHandle list);

    /**
     *
     * Delete a range of items. It is illegal to have any locks on the list
     * when WWListDeleteRange() is called.
     *
     * [out] 
     * [in]  list  WWListHandle to delete range of items.
     * [in]  index Index to start deleting, including the indexed item.
     * [in]  count Number of items to delete.
     *
     * Return_value_ 
     *
     * See_also_ WWListDeleteAllItems, WWListDelete
     *
     * Overrides_
     *
     * Status_ Functional
     */
void _far _pascal WWListDeleteRange(WWListHandle list, word index, word count);

    /**
     *
     * Append an item to list. It is illegal to have any locks on the list
     * when WWListAppend() is called.
     *
     * [out] index Index of the appended item. If not interested, pass NULL.
     * [in]  list  WWListHandle to append.
     * [in]  item  Item to append
     *
     * Return_value_ TRUE if appended, else FALSE.
     *
     * See_also_ 
     *
     * Overrides_ WWListLockItem()
     *
     * Status_ Functional
     */
Boolean _far _pascal WWListAppend(WWListHandle list, const void *item,
				  word *index);

    /**
     *
     * Replace an item in the list. It is illegal to have any locks on 
     * the list when WWListReplaceItem() is called. 
     *
     * [out] 
     * [in]  list
     * [in]  index
     * [in]  item
     *
     * Return_value_ 
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
void _far _pascal WWListReplaceItem(WWListHandle list, word index, const void *item);

    /**
     *
     * Find an item in the list. 
     *
     * [out] index Index of first item that matches.
     * [in]  list  WWListHandle to search.
     * [in]  item  Item to search.
     *
     * Return_value_ TRUE if found, else FALSE.
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
Boolean _far _pascal WWListFindItem(WWListHandle list, const void *item,
				    word *index);

    /**
     *
     * Get an item without removing it from the list. 
     *
     * [out] 
     * [in]  list
     * [in]  index   Index of item to get, must be valid.
     * [in]  item    Buffer to copy item to.
     *
     * Return_value_ 
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
void _far _pascal WWListGetItem(WWListHandle list, word index, void *item);

    /**
     *
     *  Get the size items.
     *
     * [out] 
     * [in]  list
     *
     * Return_value_ Size of items.
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
word _far _pascal WWListGetItemSize(WWListHandle list);

    /**
     *
     * Remove an item from list. It is illegal to have any locks on the 
     * list when WWListRemoveItem() is called.
     *
     * [out] 
     * [in]  list
     * [in]  index  Index of item to remove.
     * [in]  item   Buffer to copy to item. Pass NULL if you do not want
     *              a copy of the item.
     *
     * Return_value_ 
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
void _far _pascal WWListRemoveItem(WWListHandle list, word index,
				   void *item);

    /**
     *
     * Lock an item. Items must not be locked when calling 
     * WWListAppend().
     *
     * [out] 
     * [in]  list
     * [in]  index
     *
     * Return_value_ Pointer to locked item, NULL if failed to lock.
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
void* _far _pascal WWListLockItem(WWListHandle list, word index);

    /**
     *
     * Unlock an item. Items must not be locked when calling
     * WWListAppend().
     *
     * [out] 
     * [in]  list
     * [in]  index
     *
     * Return_value_ 
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
void _far _pascal WWListUnlockItem(WWListHandle list, word index);

    /**
     *
     * Get length of list. 
     *
     * [out] 
     * [in]  list
     *
     * Return_value_ uint16  Number of items in the list.
     *
     * See_also_ 
     *
     * Overrides_
     *
     * Status_ Functional
     */
word _far _pascal WWListGetCount(WWListHandle list);

@endif /* _WWMLIST_H_ */
