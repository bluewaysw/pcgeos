    // Parameters_
    //
    // [in]  pString   The null-terminated time in one of the
    //                 above formats.
    // [out] dateTime  The internal New Sokoto time format (allocated
    //                 before calling this function).
    //
    // Return_value_   TRUE if convesion was successful. FALSE otherwise.
    //
    // See_also_   WWTime::ParseTime
    //
    // Status_  Functional
    //
inline Boolean WWParseTime(const char *pString, DateTime *dateTime)
{
    return WWTime::ParseTime(pString, dateTime);
}

    //////////
    //
    // WWCreateTime is equivalent to WWTime::CreateTime
    //
    // Parameters_
    //
    // [in] dateTime  The internal New Sokoto time format to be converted.
    //
    // Return_value_  A WWMemHandle to the DateTime of the resulting conversion
    //                or NULL if allocation failed. Memory must be freed by the
    //                caller.
    //
    // See_also_   WWTime::CreateTime
    //
    // Status_ Functional
    //
inline WWMemHandle WWCreateTime(DateTime *dateTime)
{
    return WWTime::CreateTime(dateTime);
}

