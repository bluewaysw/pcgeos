@ifndef __WW_LIST_H__
@define __WW_LIST_H__

@include <stdapp.goh>

/***************************************************************************
CLASS
    WWListElement

    Elements of fixed memory WWList. 

KEYWORDS
    

CLASS TREE
<pre>
    WWListElement
</pre>
****************************************************************************/
@class WWListElementClass, MetaClass;

/* public: */
/*  virtual ~WWListElement() {}; */      /* Essential for inheritance      */
    @instance optr __next;	         /* Easy to inherit from           */
                                         /* WWList as there is no need     */
                                         /* for "friend class WWList" etc. */
    @message void SetNext(optr next);
    @message optr GetNext();

/* protected: */
    @message void WWListElement(); /* : _next(0) {}; */

@endc;

/***************************************************************************
CLASS
    WWList

    Fixed memory list. WWList can be used as a FIFO or LIFO list.
    To use a FIFO list, use Append() and Get(). 
    To use a LIFO list, use Prepend() and Get().

KEYWORDS
    List

CLASS TREE
<pre>
    WWList
</pre>
****************************************************************************/
@class WWListClass, MetaClass;

/* public: */

    /*////////
    //
    // Constructor.
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional

    WWList() : _count(0), _firstElement(NULL), _lastElement(NULL) {};

    */
    @message void WWList();

    /*////////
    //
    // Destructor.
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional

    virtual ~WWList();

    */

    /*////////
    //
    // Prepend an element to head of list.
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ 
    */
    @message void PrependElt(optr /* WWListElement */ element);

    /*////////
    //
    // Append an element to tail of list.
    //
    // Parameters_
    //
    // Return_value_ 
    //
    // See_also_ 
    //
    // Overrides_ List::Put()
    //
    // Status_ Functional.
    */
    @message void AppendElt(optr /* WWListElement */ element);
    
    /*////////
    //
    // Remove an element from head of list.
    //
    // Parameters_
    //
    // Return_value_ WWListElement that was removed, or NULL if the list
    //               was empty.
    //
    // See_also_ 
    //
    // Overrides_ List::Get()
    //
    // Status_ Functional
    */
    @message optr /* WWListElement */ Get();

    /*////////
    //
    // Remove an element from the list given a pointer to the element.
    //
    // Parameters_
    //
    // [in]  element  Pointer to element to remove from the list.
    //
    // Return_value_ Pointer to removed element, or NULL if it wasn't
    //               found in the list.
    //
    // Overrides_ List::Remove()
    //
    // Status_ Functional
    */
    @message optr /* WWListElement */ Remove(optr /* WWListElement */ element);

    /*////////
    //
    // Get length of list.
    //
    // Parameters_
    //
    // Return_value_ uint32  Length of the list.
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Funcitonal
    */
    @message dword Size();

    /*////////
    //
    // Get the head pointer. This should be used with care and
    // is added to efficiently implement list iterations.
    //
    // Parameters_
    //
    // Return_value_ WWListElement* or NULL.
    //
    // See_also_ 
    //
    // Overrides_
    //
    // Status_ Functional
    */
    @message optr /* WWListElement */ Head();

    /*////////
    //
    // Insert a new element after an element in the list. 
    //
    // Parameters_
    //
    // [in]  newElement     New element to insert.
    // [in]  afterThis      newElement will be inserted after this element.
    //                      This element must already exist in the list.
    //
    // Return_value_ 
    //
    // See_also_ Append(), Prepend()
    //
    // Overrides_
    //
    // Status_ Functional
    */
    @message void InsertAfter(optr /* WWListElement */ newElement, 
			      optr /* WWListElement */ afterThis);

/*===========================================================================
//
//                       W A R N I N G 
// 
// THE LIBERTY EXTERNAL API IS FOUND ABOVE THIS BARRIER. ANYTHING BELOW
// THIS NOTICE IS IMPLEMENTATION DEPENDENT AND SUBJECT TO CHANGE.
//
//
//=========================================================================*/

/* protected: */
    /*
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    */
/*
    WWList(const WWList&);
    const WWList& operator=(const WWList&);
*/

    @instance dword __count;
    @instance optr /* WWListElement */ __firstElement;
    @instance optr /* WWListElement */ __lastElement;

@endc;

@endif /* __WW_LIST_H__ */

