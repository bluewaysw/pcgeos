@ifndef _WWLITER_H_
@define _WWLITER_H_

/* #include <www/wwcore/wwiter.h> */
/* class WWList;         // In wwlist.h */

@include <WWW2/WW2Core/ww2list.goh>

@class WWListIteratorClass, MetaClass;

/* public: */
    @message void WWListIterator(optr wwlist);
    /* virtual ~WWListIterator() {}; */
    @message void LiterInitialize(optr wwlist);
    @message void First();
    @message void Next();
    @message Boolean IsDone();
    @message optr /* WWListElement */ CurrentElement();

/* private: */
    /*
    // Don't let users call copy the object in any way.  These methods
    // aren't actually defined since they should never be called, but
    // declaring them private should catch anyone who tries to call
    // them.
    */
/*
    WWListIterator(const WWListIterator&);
    const WWListIterator& operator=(const WWListIterator&);
*/
    @instance optr __wwlist;
    @instance optr /* WWListElement */__current;

@endc;

@endif /* _WWLITER_H_ */
