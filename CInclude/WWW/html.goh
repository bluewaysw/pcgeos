@ifndef __HTMLCONVERTER_GOH__
@define __HTMLCONVERTER_GOH__

@deflib html

@include <stdapp.goh>
#include <ec.h>
@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/sgml.goh>
@include <WWW/htmlDTD.goh>
@include <Objects/Text/tCtrlC.goh>  /* SearchReplaceControlClass */
@include <WWW/htmem.h>              /* memory allocation routines */



/*
 * Feature compile-time constants.  Add your new feature constants to each
 * product entry here.  (Use "0" and "!0", not "FALSE" and "TRUE".)
 */
@ifdef PRODUCT_RESPONDER

@define SHORT_LONG_TOUCH 0

@elifdef BROTHER_KERNEL

@define SHORT_LONG_TOUCH 0

@else /* generic version */

/* SHORT_LONG_TOUCH: Unfortunately, for now we need to keep the source	*/
/* files on the trunk and on the Responder and Brother branches		*/
/* identical, so that those folks can do cmpgeo on generic versions on	*/
/* those branches.  Since short/long-touch API doesn't exist on those	*/
/* branches, we need to disable SHORT_LONG_TOUCH on branches so that	*/
/* generic versions compile without error.				*/
@ifdef (TRUNK)
@define SHORT_LONG_TOUCH (!0)
@else
@define SHORT_LONG_TOUCH 0
@endif

@endif


/*** UIGENERATOR PART ***/

#define TAB_SIZE		168	/* tab point size * 8 */
#define TAB_POINT		TAB_SIZE / 8
@ifdef BROTHER_KERNEL
#define X_SCREEN_SIZE		620	/* screen width for ensdemo */
#define Y_SCREEN_SIZE		460	/* screen height for ensdemo */
@else
#define X_SCREEN_SIZE		383	/* screen width for penelope */
#define Y_SCREEN_SIZE		165	/* screen height for penelope */
@endif
#define HR_HEIGHT_Y		5	/* default height for <HR> */
#define ROW_SIZE		25      /* table's intial number of rows */
#define COLUMN_SIZE		5       /* table's inital number of columns */
#define BITMAP_X                4       /* x 32 = num of table columns */
#define BITMAP_Y                8       /* x 32 = num of table rows */
#define BITS_N_DWORD            (sizeof(dword)*8)   /* 8 bits in a byte */
#define NESTED_MARGIN		14
#define MARGIN                  3       /* space between ui objects */
#define IMAGE_DEFAULT_SIZE	28	/* default wdth & hgt of image icon */
#define MEMORY_THRESHOLD	75000

#define DEFAULT_TEXT_MAX_LENGTH 2048

typedef ByteEnum ErrorCode;
#define UI_GEN_NO_ERROR 	0
#define UI_GEN_ERROR		1

typedef ByteEnum StyleType;
#define STYLE_STRIKE		40
#define STYLE_FONT		41
#define STYLE_ITALIC		42
#define STYLE_BOLD		43
#define STYLE_ANCHOR		44
#define STYLE_SUPERSCRIPT	45
#define STYLE_SUBSCRIPT		46
#define STYLE_HEADER		47
#define STYLE_FW_FONT		48
#define STYLE_PRE		49
#define STYLE_UL		50
#define STYLE_OL		51
#define STYLE_DL		52
#define STYLE_BQ		53
#define STYLE_ALIGN		54
#define STYLE_PARAGRAPH		55
#define STYLE_NOBR		56

typedef ByteEnum FontType;
#define STYLE_FONT_0		9
#define STYLE_FONT_1		11
#define STYLE_FONT_2		12
#define STYLE_FONT_3		14	/* default font size */
#define STYLE_FONT_4		18
#define STYLE_FONT_5		20
#define STYLE_FONT_6		22
#define STYLE_FONT_7		24
#define STYLE_FONT_8		30


typedef ByteEnum ElementType;
#define	ELEMENT_START		0
#define	ELEMENT_END		1

typedef ByteEnum CellType;
#define	CELL_DATA		0
#define	CELL_HEADER		1

typedef enum {
    ILS_UNLOAD = 0,
    ILS_LOADED = 1,
    ILS_BROKEN,
    ILS_NO_ACCESS
} ImageLoadStatus;

typedef enum {
    FE_TEXT,
    FE_PASSWORD,
    FE_CHECKBOX,
    FE_RADIO,
    FE_SUBMIT,
    FE_RESET,
    FE_HIDDEN,
    FE_IMAGE,
    FE_TEXTAREA,
    FE_SELECTION
} FormElementType;

typedef ByteEnum AlignType;
#define ALIGN_TOP		0
#define ALIGN_MIDDLE		1
#define ALIGN_BOTTOM		2

typedef ByteEnum AreaType;
#define AREA_RECT		0
#define AREA_CIRC		1
#define AREA_POLY		2
#define AREA_DEFAULT		3

typedef ByteEnum TriggerType;
#define	TRIGGER_RESET		FE_RESET
#define	TRIGGER_SUBMIT		FE_SUBMIT


#define DEFAULT_STYLE_FONT	STYLE_FONT_3
#define DEFAULT_BASEFONT	3
#define DEFAULT_ALIGNMENT	J_LEFT


/*
 * listGroup defines a stack element.  It stores information about the list
 * groups like <UL> and <OL>.
 */
typedef struct {
	StyleType	LG_groupType;	/* <OL> or <UL>			*/
	dword		LG_counter;	/* keep track the number for the 
					   next ordered list item.	*/
	char		LG_displayType;	/* style of items:
					   A = use large letters
					   a = use small letters
					   I = use large Roman numerials
					   i = use small Roman numerials
					   1 = use numbers		*/
} ListGroup;

