/************************************************************************
 *  HTGenTextClass represent the text on the page.
 */
@class HTGenTextClass, GenTextClass;
 @message void MSG_GEN_TEXT_CHANGE_SIMPLE_RENDERING
	(ElementType type, TextStyle style);
 @message GStateHandle MSG_GEN_TEXT_INITIALIZE(optr content);
 @message void MSG_GEN_TEXT_RECORD_HREF
	(ElementType type, int token);
 @message int MSG_GEN_TEXT_FIND_LINK_UNDER_MOUSE
	(word xPosition, word yPosition, dword *start, dword *end,
	int *anchor);
 @message void MSG_GEN_TEXT_DRAW_FOCUS
	(int direction, Rectangle *obj, RectDWord *rect, 
	RectDWord *ret, Rectangle *box);
 @message void MSG_GEN_TEXT_UNDRAW_FOCUS(optr newLink);
 @message Boolean MSG_GEN_TEXT_FIND_LINK_IN_RECT
	(RectDWord rect, int direction);
 @message Boolean MSG_GEN_TEXT_IS_MULTILINE();
	/*
	 *  gstate used to calculate the min width requre to draw
	 *  the text. Not allocated by HTGenTextClass, but reuse
	 *  VTI_gstate. So no need to free.
	 */
	@instance GStateHandle HTGT_gstate;
	/*
	 *  Accumulate the length of the text, used to set the width
	 *  of the text object.  MaxLen keeps the max length seen so
	 *  so far.
	 */
	@instance int	HTGT_maxLen;
	@instance int	HTGT_accLen;
	/*
	 *  Is this object being selected?
	 */
	@instance Boolean HTGT_selected;
        /*
	 *  Store the hyperlink segments in the text body.
	 */
	@instance HTListHandle HTGT_anchorList;
	/*
	 *  Anchor index of the link in focus.  Used to do quick search.
	 *  -1 if the text object doesn't have the focus.
	 */
	@instance int	HTGT_focalAnchor;
	/*
	 *  if HTGT_focalAnchor != -1, HTGT_focalBound has the bound.
	 */
	@instance RectDWord	HTGT_focalBound;
        @instance Rectangle     HTGT_focalBox;
	/*
	 *  HTGT_content contains all the formating info and the page
	 *  height array information.
	 */
	@instance optr   HTGT_content;
	/*
	 *  Suggested x Postion in a row.
	 */
	@instance int   HTGT_xPos;
	/*
	 *  Suggested row position.
	 */
	@instance int   HTGT_pageRow = -1;
	/*
	 *  the calculated size before the object vis part is built.
	 */
	@instance SizeAsDWord   HTGT_guessSize;
	/*
	 *  Alignment.
	 */
	@instance Justification HTGT_align = J_LEFT;
	/*
	 *  Is the text object has more than one line?  This bit saves
	 *  me the effort of calculating the line positions of first and
	 *  last text offsets.
	 */
	@instance Boolean	HTGT_multiline = FALSE;
@if @SHORT_LONG_TOUCH
	/*
	 *  Mouse co-ordinates recorded during MSG_META_END_SELECT.  This is
	 *  needed when short/long touch notifications is processed.
	 */
	@instance Point HTGT_rawMouseCoord;
@endif /* SHORT_LONG_TOUCH */
	/*
	 *  Stores the drawing width(in pixels) of the longest word
	 *  in this text object.  This is used to determine the 
	 *  minimun width the text object can be without wrapping words.
	 */
        @instance int           HTGT_maxWordWidth = 0;

@endc;


/************************************************************************
 *  HTGenFormTextClass represents <INPUT TYPE = "TEXT" or "PASSWORD">
 */
@class HTGenFormTextClass, GenTextClass;
 @message void MSG_GEN_FORM_TEXT_INITIALIZE(optr content);
 @message void MSG_GEN_FORM_TEXT_SET_FOCUS(RectDWord *ret);
 @message void MSG_GEN_FORM_TEXT_CLEAR_FOCUS();
	 /*
	  *  HTGT_content contains all the formating info and the page
	  *  height array information.
	  */
	@instance optr	        HTGFT_content;
	 /*
	  *  HTGFT_xPos is the suggested x postion (in pixels) for the
	  *  object to appear in the row.
	  */
	@instance int	        HTGFT_xPos = 0;
	 /*
	  *  Suggested row position.
	  */
	@instance int	        HTGFT_pageRow= 0;
	/*
	 *  the calculated size before the object vis part is built.
	 */
	@instance SizeAsDWord   HTGFT_guessSize;
	 /*
	  *  The drawing bound for showing the navigation focus.
	  *  If RD_right != RD_left, it means this object is currently
	  *  having the navigation focus.
	  */
	@instance RectDWord	HTGFT_focalBound;
	/*
	 *  Alignment.
	 */
	@instance Justification HTGFT_align = J_LEFT;
	/*
	 *  Keep track of being in <NOBR> or not.
	 */
	@instance word		HTGFT_noBr;
@endc;


@class TextAreaClass, GenInteractionClass;
 @message void MSG_TEXT_AREA_APPEND_TEXT_PTR(char *text, word len);
 @message HTMemHandle MSG_TEXT_AREA_GET_TEXT_HANDLE();
 @message void MSG_TEXT_AREA_INITIAL(word cols, word rows, optr content);
 @message void MSG_TEXT_AREA_FINISH();
 @message void MSG_TEXT_AREA_SET_FOCUS(RectDWord *rect);
