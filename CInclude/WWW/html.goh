@instance word TATI_height; 

@instance Point TATI_origin;
@instance word TATI_rows;
@instance word TATI_columns;
@instance Point TATI_firstChar;
@instance word TATI_lineHeight;
@instance word TATI_charWidth;

@instance GStateHandle TATI_lastGState;
