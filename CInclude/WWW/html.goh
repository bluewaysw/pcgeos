@importMessage MetaApplicationMessages, int MSG_UI_GET_ROW_POSITION();
@importMessage MetaApplicationMessages, void MSG_UI_SET_NEW_POSITION(int xPos, int row);
@importMessage MetaApplicationMessages, void MSG_GEN_PREPARE_FOR_DESTROY();

/************************************************************************
 *  HTGenViewClass represent the view of the UI doc.
 */
@class HTGenViewClass, GenViewClass;
 @message void MSG_HT_GEN_VIEW_ALLOW_DESTROY
    	(SemaphoreHandle waitToFree, optr genContent);
 @message void MSG_HT_GEN_VIEW_IGNORE_INPUT();
 @message void MSG_HT_GEN_VIEW_ACCEPT_INPUT();
 
@instance Boolean HTGV_ignore;
@instance Boolean HTGV_ignoreMouse;
@instance Boolean HTGV_ignoreKbd;
