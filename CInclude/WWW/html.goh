@endc;


/************************************************************************
 *  HTMLSelectClass represents <SELECT>
 */
@class HTMLSelectClass, GenInteractionClass;
 @message void MSG_HTML_SELECT_PROCESS_ATTRIBUTE
        (MemHandle block, SGMLEntity *entity);
 @message void MSG_HTML_SELECT_ADD_OPTION_VALUE(char *value, Boolean selected);
 @message void MSG_HTML_SELECT_ADD_OPTION_TEXT(char *text);
 @message void MSG_HTML_SELECT_COMPLETE_SELECT_CONSTRUCT();
 @message void MSG_HTML_SELECT_SET_ALL_MONIKER();
 @message void MSG_HTML_SELECT_SCROLL_UP();
 @message void MSG_HTML_SELECT_SCROLL_DOWN();

 @message void MSG_HTML_SELECT_CHANGE_SELECT(optr item);
 @message void MSG_HTML_SELECT_STORE_CONTENT(optr content);
 @message void MSG_HTML_SELECT_SET_FOCUS(RectDWord *rect);
 @message void MSG_HTML_SELECT_CLEAR_FOCUS();
 @message void MSG_HTML_SELECT_SUBMIT(HTListHandle query);
	/*
	 * HTGS_size determines the number of OPTIONS physically 
	 * visible when the browser displays the FORM.
	 */
	@instance int		HTMLS_size = 0;
	@instance int		HTMLS_len = 0; /* pixels */
	@instance Boolean	HTMLS_exclusive = TRUE;
	@instance HTMemHandle	HTMLS_name = 0;

        @instance optr          HTMLS_itemGroup = 0;

	@instance int	 	HTMLS_pressUpOrDown = 0;

   	@instance word		HTMLS_currentFirst = 0;
	@instance int 		HTMLS_optionsNum = 0;

	@instance HTListHandle 	HTMLS_optionsList = 0;
	@instance HTListHandle  HTMLS_itemList = 0;

	@instance TimerHandle	HTMLS_timerHandle = NullHandle;
	@instance word		HTMLS_timerId = 0;

	 /*
	  *  HTGS_xPos is the suggested x position for the object to
	  *  appear in the HTGS_pageRow.
	  */
	@instance int	        HTMLS_xPos;
	 /*
	  *  The object is in this row position.
	  */
	@instance int    	HTMLS_pageRow;
	/*
	 *  Content object that stores row heights and formatting info.
	 */
	@instance optr    	HTMLS_content;
	/*
	 *  the calculated size before the object vis part is built.
	 */
	@instance SizeAsDWord   HTMLS_guessSize;
	/*
	 *  Alignment
	 */
	@instance SizeAsDWord   HTMLS_align = J_LEFT;
	/*
	 *  Keep track of being in <NOBR> content or not.
	 */
	@instance word		HTMLS_noBr;
	/*
	 *  focalBound stores the focal bound.
	 */
	@instance RectDWord	HTMLS_focalBound;
        /*
	 * the form's id which we belong to 
	 */
        @instance int          HTMLS_formId;  
@endc;


