	@instance HTMemHandle 	TAI_text;
	@instance Justification TAI_align = J_LEFT;
	@instance word		TAI_noBr;
	@instance word 		TAI_width;
	@instance word 		TAI_length;
	@instance RectDWord	TAI_focalBound;
  	@instance word          TAI_rows;
	@instance word          TAI_columns;
        /*
	 * the form's id which we belong to 
	 */
        @instance int          TAI_formId;  
@endc;


@class TextAreaTextClass, GenTextClass;
@message void MSG_TAT_SET_SIZE(word width, word length);
