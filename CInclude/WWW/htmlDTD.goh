@ifndef __HTMLDTD_GOH__
@define __HTMLDTD_GOH__

/*
**            HTML tokens table
**            -----------------
**     *MUST* in alphabetical order!!
**
*/

typedef enum {
    /* 
     * HTML Tokens. Except for HTMLT_XXX_..., all the tokens *MUST*
     * be in alphabetical order! 
     */

     HTMLT_XXX_INVALID = 0x0 /* Must be the first for range checking */
    ,HTMLT_A
    ,HTMLT_ABBREV
    ,HTMLT_ABSTRACT
    ,HTMLT_ACRONYM
    ,HTMLT_ADDED
    ,HTMLT_ADDRESS
    ,HTMLT_APPLET
    ,HTMLT_AREA
    ,HTMLT_ARG
    ,HTMLT_B
    ,HTMLT_BASE
    ,HTMLT_BASEFONT
    ,HTMLT_BDO
    ,HTMLT_BGSOUND
    ,HTMLT_BIG
    ,HTMLT_BLOCKQUOTE
    ,HTMLT_BODY
    ,HTMLT_BR
    ,HTMLT_CAPTION
    ,HTMLT_CENTER
    ,HTMLT_CHANGED
    ,HTMLT_CITE
    ,HTMLT_CODE
    ,HTMLT_COL
    ,HTMLT_COLGROUP
    ,HTMLT_COMMENT
    ,HTMLT_DD
    ,HTMLT_DFN
    ,HTMLT_DIR
    ,HTMLT_DIV
    ,HTMLT_DL
    ,HTMLT_DOCTYPE
    ,HTMLT_DT
    ,HTMLT_EM
    ,HTMLT_EMBED
    ,HTMLT_FIELDSET
    ,HTMLT_FIG
    ,HTMLT_FONT
    ,HTMLT_FORM
    ,HTMLT_FRAME
    ,HTMLT_FRAMESET
    ,HTMLT_H1
    ,HTMLT_H2
    ,HTMLT_H3
    ,HTMLT_H4
    ,HTMLT_H5
    ,HTMLT_H6
    ,HTMLT_HEAD
    ,HTMLT_HR
    ,HTMLT_HTML
    ,HTMLT_I
    ,HTMLT_IMAGE
    ,HTMLT_IMG
    ,HTMLT_INPUT
    ,HTMLT_ISINDEX
    ,HTMLT_KBD
    ,HTMLT_L
    ,HTMLT_LABEL
    ,HTMLT_LI
    ,HTMLT_LINK
    ,HTMLT_LISTING
    ,HTMLT_LIT
    ,HTMLT_MAP
    ,HTMLT_MARGIN
    ,HTMLT_MARQUEE
    ,HTMLT_MATH
    ,HTMLT_MENU
    ,HTMLT_META
    ,HTMLT_NEXTID
    ,HTMLT_NOBR
    ,HTMLT_NOFRAMES
    ,HTMLT_NOTE
    ,HTMLT_OBJECT
    ,HTMLT_OL
    ,HTMLT_OPTION
    ,HTMLT_OVER
    ,HTMLT_P
    ,HTMLT_PARAM
    ,HTMLT_PERSON
    ,HTMLT_PLAINTEXT
    ,HTMLT_PRE
    ,HTMLT_Q
    ,HTMLT_QUOTE
    ,HTMLT_REMOVED
    ,HTMLT_RENDER
    ,HTMLT_S
    ,HTMLT_SAMP
    ,HTMLT_SCRIPT
    ,HTMLT_SELECT
    ,HTMLT_SMALL
    ,HTMLT_SPAN
    ,HTMLT_STRIKE
    ,HTMLT_STRONG
    ,HTMLT_STYLE
    ,HTMLT_SUB
    ,HTMLT_SUP
    ,HTMLT_TAB
    ,HTMLT_TABLE
    ,HTMLT_TBODY
    ,HTMLT_TD
    ,HTMLT_TEXTAREA
    ,HTMLT_TEXTFLOW
    ,HTMLT_TFOOT
    ,HTMLT_TH
    ,HTMLT_THEAD
    ,HTMLT_TITLE
    ,HTMLT_TR
    ,HTMLT_TT
    ,HTMLT_U
    ,HTMLT_UL
    ,HTMLT_VAR
    ,HTMLT_WBR
    ,HTMLT_XMP
    ,HTMLT_XXX_NULL  /* Must be the last for range checking */
} HTMLToken;

/*
 * Attributes. The numbering system must meet the following requirements:
 * 
 * 1. Fit in one word.
 * 2. Attrs in the same HTML tag must not have the same number (to make
 *    life easier, we assign a unique number to each attr. Hence we use
 *    enum).
 * 3. > 0.
 */
typedef enum {
	 HTML_ATTR_XXX_INVALID        = 0x0  /* For range checking */
	,HTML_ATTR_ACTION
	,HTML_ATTR_ALIGN
	,HTML_ATTR_ALT
	,HTML_ATTR_AREA
	,HTML_ATTR_AT
	,HTML_ATTR_BACKGROUND
	,HTML_ATTR_BEHAVIOR
	,HTML_ATTR_BGCOLOR
	,HTML_ATTR_BORDER
	,HTML_ATTR_BORDERCOLOR
	,HTML_ATTR_BORDERCOLORDARK
	,HTML_ATTR_BORDERCOLORLIGHT
	,HTML_ATTR_CELLPADDING
	,HTML_ATTR_CELLSPACING
	,HTML_ATTR_CHECKED
	,HTML_ATTR_CLASSID
	,HTML_ATTR_CLEAR
	,HTML_ATTR_CODEBASE
	,HTML_ATTR_CODETYPE
	,HTML_ATTR_COLOR
	,HTML_ATTR_COLS
	,HTML_ATTR_COLSPAN
	,HTML_ATTR_COMPACT
	,HTML_ATTR_CONTENT
	,HTML_ATTR_COORDS
	,HTML_ATTR_CONTROLS
	,HTML_ATTR_DATA
	,HTML_ATTR_DECLARE
	,HTML_ATTR_DIRECTION
	,HTML_ATTR_DISABLED
	,HTML_ATTR_DYNSRC
	,HTML_ATTR_EFFECT
	,HTML_ATTR_ERROR
	,HTML_ATTR_FACE
	,HTML_ATTR_FRAME
	,HTML_ATTR_HEIGHT
	,HTML_ATTR_HREF
	,HTML_ATTR_HSPACE
	,HTML_ATTR_HTTP_EQUIV
	,HTML_ATTR_ID
	,HTML_ATTR_IDREF
	,HTML_ATTR_INDEX
	,HTML_ATTR_ISMAP
	,HTML_ATTR_LANG
	,HTML_ATTR_LANGUAGE
	,HTML_ATTR_LINK
	,HTML_ATTR_LOOP
	,HTML_ATTR_MAXLENGTH
	,HTML_ATTR_METHOD
	,HTML_ATTR_METHODS
	,HTML_ATTR_MIN
	,HTML_ATTR_MULTIPLE
	,HTML_ATTR_N
	,HTML_ATTR_NAME
	,HTML_ATTR_NOHREF
	,HTML_ATTR_NOSHADE
	,HTML_ATTR_NOWRAP
	,HTML_ATTR_ONCLICK
	,HTML_ATTR_PLAIN
	,HTML_ATTR_PRINT
	,HTML_ATTR_REL
	,HTML_ATTR_REV
	,HTML_ATTR_ROLE
	,HTML_ATTR_ROWS
	,HTML_ATTR_ROWSPAN
	,HTML_ATTR_RULES
	,HTML_ATTR_SCROLLAMOUNT
	,HTML_ATTR_SCROLLDELAY
	,HTML_ATTR_SEETHRU
	,HTML_ATTR_SELECTED
	,HTML_ATTR_SHAPE
	,HTML_ATTR_SHAPES
	,HTML_ATTR_SIZE
	,HTML_ATTR_SRC
	,HTML_ATTR_STANDBY
	,HTML_ATTR_START
	,HTML_ATTR_STYLE
	,HTML_ATTR_TAG
	,HTML_ATTR_TARGET
	,HTML_ATTR_TEXT
	,HTML_ATTR_TITLE
	,HTML_ATTR_TYPE
	,HTML_ATTR_URL
	,HTML_ATTR_USEMAP
	,HTML_ATTR_VALIGN
	,HTML_ATTR_VALUE
	,HTML_ATTR_VALUETYPE
	,HTML_ATTR_VSPACE
	,HTML_ATTR_WIDTH
	,HTML_ATTR_WRAP
	,HTML_ATTR_XXX_NULL   /* Must be the last for range checking */
} HTMLAttr;

void _pascal _far unmapGeosChars(char *str);

@endif






