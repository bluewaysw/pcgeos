@ifndef __HT_UU_GOH__
@define __HT_UU_GOH__

@include <stdapp.goh>
#include <WWW/htmem.h>

int _far _pascal
    HTUUEncode(HTMemHandle bufToCode, int nbytes, HTMemHandle bufCoded);

int _far _pascal
    HTUUDecode(HTMemHandle bufferCoded, HTMemHandle bufferPlain, 
	int outbufsize);

#ifdef __HIGHC__
pragma Alias(HTUUEncode, "HTUUENCODE");
pragma Alias(HTUUDecode, "HTUUDECODE");
#endif

@endif
