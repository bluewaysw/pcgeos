@ifndef __HT_UU_GOH__
@define __HT_UU_GOH__

@include <stdapp.goh>
#include <WWW/htmem.h>
@include <WWW/HTCore/htconst.goh>

HTStreamHandle _far _pascal
    HTDecodeNew(const char *str, HTStreamHandle target);

int _far _pascal
    HTUUEncode(HTMemHandle bufToCode, int nbytes, HTMemHandle bufCoded);

int _far _pascal
    HTUUDecode(HTMemHandle bufferCoded, int inbufsize,
	HTMemHandle bufferPlain, int outbufsize);

int _far _pascal
    HTUUEncodePtr(byte *bufToCode, int nbytes, byte *bufCoded);

int _far _pascal
    HTUUDecodePtr(byte *bufferCoded, int inbufsize,
	byte *bufferPlain, int outbufsize);

#ifdef __HIGHC__
pragma Alias(HTDecodeNew, "HTDECODENEW");
pragma Alias(HTUUEncode, "HTUUENCODE");
pragma Alias(HTUUDecode, "HTUUDECODE");
pragma Alias(HTUUEncodePtr, "HTUUENCODEPTR");
pragma Alias(HTUUDecodePtr, "HTUUDECODEPTR");
#endif

@endif
