@ifndef __HT_REQ_GOH
@define __HT_REQ_GOH

@include <stdapp.goh>
@include <WWW/HTCore/htconst.goh>
@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htstring.goh>
