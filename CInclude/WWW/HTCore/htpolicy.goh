@ifndef __HT_POLICY_GOH
@define __HT_POLICY_GOH

@include <stdapp.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htlist.goh>
@include <WWW/HTCore/htstring.goh>
@include <WWW/HTCore/htcbf.goh>
#include <WWW/htmem.h>


/* --------------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. POLICY MANAGER
 * --------------------------------------------------------------------------*/

/****************************************************************************

  The Policy Manager is used by the application to register protocol 
  classes and bind them to specific access methods. For example, HTTPClass
  is bound to http protocol. Protocol Manager is also used by the 
  Library to access a document not found in the local cache.

  The Format Manager is used by the application to register content-type
  classes and bind them to MIME content-types. For example, HTMLClass
  is bound to text/html content-type. 

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		B. USE OF POLICY MANAGER
 * --------------------------------------------------------------------------*/

/****************************************************************************
  
  The best place to learn about using the Policy Manager is in GeoBrowser.
  Usually an application like GeoBrowser uses the Policy Manager to 
  register protocol classes. A protocol is sometimes referred to as 
  an access method. Registered protocols are used by the Library, in 
  particular the Request Manager to load a document when a cache copy is not
  found. All protocol classes are subclasses of HTProtocolClass described 
  in htstream.goh{goc}.

  Usually an application like GeoBrowser also uses the Policy Manager to 
  register content-type handlers.  Registered content-type handlers 
  are used by the Library (MIME etc streams) to process a data object.
  All content-type classes are subclasses of HTStreamClass described 
  in htstream.goh{goc}.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		II. CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/

/* 
 * This is returned by client's director. The stream stack ends if the client
 * returns a handler whose output type is HT_CONTENT_TYPE_STAR_STAR.
 */
typedef struct {
   HTStreamHandle HTCH_handler;       /* The content handler or NullOptr */
   HTStringHandle HTCH_outputType;    /* The handler output type */
} HTContentHandler;


/*
 * A content-type is in MIME format. You should use these constants
 * whenever possible. Any type begining with "xgw" is type that
 * has been converted to fit Geoworks clients. So, normally you would
 * register a content-handler in your director to handle "text/xgw-html"
 * rather than "text/html" because you want parsed tokens rather than
 * raw html text.
 *
 *  HT_CONTENT_TYPE_TEXT_XGW_HTML
 *    This is parsed HTML tags from SGML, may have illegal nested tags.
 *    
 *  HT_CONTENT_TYPE_TEXT_XGWP_HTML
 *    This is parsed HTML tags from HTMLP, sticks to HTML DTD 3.2 
 *    context free grammar 
 *
 *  HT_CONTENT_TYPE_STAR_STAR
 *    This is a sink content type. The library will stop building
 *    stream handlers when a stream that outputs STAR_STAR is encountered.
 *    This is also a content type that can take anything. Becareful! 
 *    If you register a content-type take STAR_START, you must handle
 *    all the raw data.
 *
 *  HT_CONTENT_TYPE_UNKNOWN
 *    This is not the same application/octet-stream. TYPE_UNKNOWN means
 *    that we have not parsed any headers/data to determine its content
 *    type.
 *
 *  HT_WWW_MIME
 *    This is a Geoworks (indicated by xgw) MIME converter. 
 *
 *  HT_WWW_DEBUG
 *    This is a Geoworks (indicated by xgw) Debugging stream.
 *
 *  HT_WWW_GUESS
 *    This is a Geoworks (indicated by xgw) Guess stream.
 *
 *  HT_WWW_FILE_CACHE
 *    This is a Geoworks (indicated by xgw) File Cache stream.
 *
 */
#define HT_CONTENT_TYPE_APPLICATION_OCTET_STREAM  \
					HTStringFor("application/octet-stream")
#define HT_CONTENT_TYPE_MULTIPART_MIXED HTStringFor("multipart/mixed")
#define HT_CONTENT_TYPE_TEXT_PLAIN      HTStringFor("text/plain")
#define HT_CONTENT_TYPE_TEXT_HTML       HTStringFor("text/html")
#define HT_CONTENT_TYPE_TEXT_XGW_HTML   HTStringFor("text/xgw-html")
#define HT_CONTENT_TYPE_TEXT_XGWP_HTML  HTStringFor("text/xgwp-html")
#define HT_CONTENT_TYPE_IMAGE_GIF       HTStringFor("image/gif")
#define HT_CONTENT_TYPE_IMAGE_JPEG      HTStringFor("image/jpeg")
#define HT_CONTENT_TYPE_IMAGE_XGNF      HTStringFor("image/x-gnf")
#define HT_CONTENT_TYPE_STAR_STAR       HTStringFor("*/*")
#define HT_CONTENT_TYPE_X_WWW_FORM_URLENCODED \
	HTStringFor("application/x-www-form-urlencoded")
#define HT_CONTENT_TYPE_UNKNOWN         HTStringFor("www/unknown")
#define HT_WWW_MIME                     HTStringFor("text/xgw-MIME")
#define HT_WWW_DEBUG                    HTStringFor("text/xgw-debug")
#define HT_WWW_GUESS                    HTStringFor("text/xgw-guess")


/* --------------------------------------------------------------------------
 * 		III. Policy Manager APIs.
 * --------------------------------------------------------------------------*/

extern int _far _pascal
	HTPolicyAddProtocolHandler(HTListHandle list, HTStringHandle name,
				   HTStringHandle library);

extern HTStreamHandle _far _pascal
	HTPolicyGetProtocolHandler(HTRequestHandle request,
				HTListHandle list, HTStringHandle name);

extern HTStreamHandle _far _pascal
	HTPolicyStreamStack(HTStringHandle inputFormat,
			    HTStringHandle outputFormat,
			    HTStreamHandle outputStream,
			    HTRequestHandle request,
			    Boolean guess);

extern const char * _far _pascal
	HTPolicyContentTypeToFileExt(HTStringHandle contentType);

#ifdef __HIGHC__
pragma Alias(HTPolicyAddProtocolHandler, "HTPOLICYADDPROTOCOLHANDLER");
pragma Alias(HTPolicyStreamStack, "HTPOLICYSTREAMSTACK");
pragma Alias(HTPolicyContentTypeToFileExt, "HTPOLICYCONTENTTYPETOFILEEXT");
#endif

@endif /* __HT_POLICY_GOH */


