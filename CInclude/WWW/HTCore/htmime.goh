@ifndef __HT_MIME_GOH
@define __HT_MIME_GOH

@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htreqMan.goh>
@include <WWW/HTCore/htstring.goh>
#include <WWW/htmem.h>


@include <WWW/HTCore/htscan.goh>

/* ---------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------*/

/* ---------------------------------------------------------------------
 * 		A. HTMIME CLASS (MIME PARSER)
 * ---------------------------------------------------------------------*/

/****************************************************************************

  The HTMIMEClass is inherited from HTStream defined in htstream.goh{goc}.

 ****************************************************************************/

@class HTMIMEClass, HTStreamClass;

/* --------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------*/

/*
 * MIME scanner handle and pointer. We lock the scanner as long as we
 * are parsing and unlock & delete when we are done parsing MIME headers.
 */
@instance HTScannerHandle HTMI_scannerHandle;
@instance HTScanner *HTMI_scanner;

/*
 * Current content type. There is no need to save this information in a
 * HTRequest as it is not used by the client.
 */
@instance HTStringHandle HTMI_contentType;

@endc

/* --------------------------------------------------------------------------
 * 		B. HTMIMERQ CLASS (MIME GENERATOR)
 * --------------------------------------------------------------------------*/

@class HTMIMERqClass, HTStreamClass;


/*
 * Indicates whether HTMIMERq stream is going to end header by putting an
 * empty line consisting only of CRLF.
 *
 * Context:	Push data to server.
 * Source:	self
 * Destination:	HTMIMERq objects.
 * Interception:No.
 */
@message void MSG_HTMIME_RQ_END_HEADER(Boolean endHeader);


/* 
 * Indicates whether headers are to end here. If so, put an empty line
 * containing only CRLF.
 */
@instance Boolean HTMRI_endHeader;
@endc

/* --------------------------------------------------------------------------
 * 		C. PUBLIC FUNCTIONS
 * --------------------------------------------------------------------------*/

extern HTStreamHandle _far _pascal
	HTMIMERqNew(HTRequestHandle request, Boolean endHeader);

@endif /* __HT_MIME_GOH */

