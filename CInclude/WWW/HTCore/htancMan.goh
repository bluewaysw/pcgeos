@ifndef __HT_ANCMAN_GOH__
@define __HT_ANCMAN_GOH__

@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htlist.goh>
#include <WWW/htmem.h>
@include <WWW/HTCore/htanchor.goh>
@include <WWW/HTCore/htstring.goh>
#include <timedate.h>


/*
 * Anchor for a parent object. 
 * Parent anchors point to the whole content of a data object. The parent
 * anchor of a parent anchor is itself. The parent anchor contains all 
 * meta information about the data object. This is largely the entity
 * headers in the HTTP specification. 
 *
 * HTDocument is the most problematic. A document belongs to a client
 * and so is the MemHandle of the document. If the Library keeps a copy
 * of the MemHandle, it will crash if client deleted the document
 * before the Library is done with it. Who is responsible for deleting
 * a HTDocument? For now, let's ignore HTDocument since it is a 
 * memory cache problem, not disk cache.
 */
typedef struct {
    HTDocument HTPA_document;    /* The document within this anchor */

    HTMemHandle HTPA_url;        /* URL address of this node */
    HTMemHandle HTPA_physical;   /* Physical URL address after going through
				    cache */
    Boolean HTPA_cacheHit;       /* TRUE if found in cache */

    /* Entity header fields */
    HTMemHandle HTPA_title;      /* Document title */
    HTMethod HTPA_allowedMethods; /* A mask of bit flags */
    
    HTStringHandle HTPA_content_transfer_encoding;
    HTStringHandle HTPA_content_encoding;
    HTStringHandle HTPA_content_language;   /* @@@ SHOULD BE A LIST? @@@ */
    HTStringHandle HTPA_content_type;
    HTStringHandle HTPA_charset;           /* Parameter to content type */
    HTStringHandle HTPA_level;             /* Parameter to content type */
    dword HTPA_content_length;

    TimerDateAndTime HTPA_date;  /* When was the request issued */
    TimerDateAndTime HTPA_expires; /* When does the copy expire */
    TimerDateAndTime HTPA_lastModified; 

    HTListHandle HTPA_extraHeaders; /* Unknown headers coming in from OR
				       going out to (depending on whether
				       this is a source or target anchor)
				       the network. Useful for testing and
				       extending headers to tailor to 
				       our partners */
} HTParentAnchor;

@endif

