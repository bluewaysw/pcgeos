@ifndef __HT_QP_GOH__
@define __HT_QP_GOH__

@include <stdapp.goh>
#include <WWW/htmem.h>

int _far _pascal
    HTQPEncode(HTMemHandle bufToCode, int nbytes, HTMemHandle bufCoded);

int _far _pascal
    HTQPDecode(HTMemHandle bufferCoded, int nbytes, HTMemHandle bufferPlain); 

int _far _pascal
    HTQPEncodePtr(const byte *bufToCode, int nbytes, byte *bufCoded);

int _far _pascal
    HTQPDecodePtr(const byte *bufferCoded, int nbytes, byte *bufferPlain);

#ifdef __HIGHC__
pragma Alias(HTQPEncode, "HTQPENCODE");
pragma Alias(HTQPDecode, "HTQPDECODE");
pragma Alias(HTQPEncodePtr, "HTQPENCODEPTR");
pragma Alias(HTQPDecodePtr, "HTQPDECODEPTR");
#endif

@endif

