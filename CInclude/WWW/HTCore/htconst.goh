@ifndef __WWW_HTCONST_GOH__
@define __WWW_HTCONST_GOH__

/* --------------------------------------------------------------------------
 * 		COMMON CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/

#define HTRequestHandle MemHandle	 /* 16-bit Request object descriptor */
#define HTSocketHandle MemHandle         /* 16-bit asynchronous socket handle */
#define HTNetHandle  HTMemHandle
#define HTStringHandle ChunkHandle       /* A 16-bit HTString descriptor. */
#define HTLibHandle word	 	 /* Client env in the Library */

/*
 * In the true  spirit of object-oriented programming, HTStreamHandle is a 
 * superclass object handle that can be used to point to any objects of
 * subclasses of HTStreamClass. This is so that we need not introduce
 * HTProtocolHandle, HTStructuredHandle etc.
 */
#define HTStreamHandle optr

/* 
 * Local equivalents of CR and LF.
 */
#ifndef CR
#define CR	C_CR
#endif

#ifndef LF
#define LF	C_LF
#endif

/*
 * Macros to error checking.
 */
#define ECCheckRequest(request) ECCheckMemHandle(request)

@endif

