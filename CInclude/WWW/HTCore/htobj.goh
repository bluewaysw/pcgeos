@ifndef __WWW_HTOBJ_GOH__
@define __WWW_HTOBJ_GOH__

@include <WWW/HTCore/htlist.goh>

extern Boolean _far _pascal
	HTObjAttach(ThreadHandle thread);

extern optr _far _pascal
	HTObjInstantiateForThread(ThreadHandle thread, ClassStruct *class);

extern void _far _pascal
	HTObjDetach(ThreadHandle thread);

extern optr _far _pascal
	HTObjInstantiateForThreadWID (word id, ThreadHandle thread, 
				      ClassStruct *class);

extern void _far _pascal
	HTObjDestroyAllWID (word id);

dword _far _pascal
    HTObjUsedSpaceWID (word id);

#ifdef __HIGHC__
pragma Alias(HTObjAttach, "HTOBJATTACH");
pragma Alias(HTObjInstantiateForThread, "HTOBJINSTANTIATEFORTHREAD");
pragma Alias(HTObjDetach, "HTOBJDETACH");
pragma Alias(HTObjInstantiateForThreadWID, "HTOBJINSTANTIATEFORTHREADWID");
pragma Alias(HTObjDestroyAllWID, "HTOBJDESTROYALLWID");
pragma Alias(HTObjUsedSpaceWID, "HTOBJUSEDSPACEWID");
#endif

@endif
