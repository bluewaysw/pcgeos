@ifndef __HT_NET_GOH
@define __HT_NET_GOH

@include <stdapp.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htutils.goh>
@include <WWW/HTCore/htreqMan.goh>
#include <library.h>                           /* LibraryCallType */

/* --------------------------------------------------------------------------
 * 		I. FREQUENTLY ASKED QUESTIONS - FAQ
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. THE NET MANAGER
 * --------------------------------------------------------------------------*/

/****************************************************************************

  The Net Manager implements a platform independent scheduler.
  You use the manager using API HTNetNewClient. This API creates 
  a new fiber (cooperative multitasking thread independent of 
  Geos thread) and run it in a state-based manner. The fiber is used to run 
  a protocol (e.g., HTTP) and must run in a cooperative manner. That means 
  the protocol must exit at certain point to let other protocols a chance to 
  run.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		B. WHY NET MANAGER?
 * --------------------------------------------------------------------------*/

/****************************************************************************

  Why? For two reasons. Number one, we want to port this to Liberty. Number
  two, it conforms to CERN code. Reason one seems reasoble. Reason two needs
  clarification. We want to conform to CERN code so that any future code
  from CERN can be ported to our Library easily. Spyglass code also uses the 
  same thread model from CERN.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		II. CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/

/*
 * Function prototype that you use to create callback functions and
 * register them to Net Manager. Must return HT_OK or any of your
 * return code.
 */
typedef int _far _pascal (*HTNetCallback)(HTRequestHandle request, 
					  int status);

/* --------------------------------------------------------------------------
 * 		III. Client Public Function Prototypes
 * --------------------------------------------------------------------------*/

/* XXX */
/*
 * extern int _far _pascal
 * HTNetAddBeforeCallback(HTListHandle list, HTNetCallback cbf, int state);
 */
#define HTNetAddBeforeCallback HTNetAddCallbackCommon

/* XXX */
/*
 * extern int _far _pascal
 *	HTNetAddAfterCallback(HTListHandle list, HTNetCallback cbf, int state);
 */
#define HTNetAddAfterCallback HTNetAddCallbackCommon

/* XXX */
/* extern int _far _pascal
 *	HTNetAddRequestCallback(HTListHandle list, HTNetCallback cbf, int state);
 */
#define HTNetAddRequestCallback HTNetAddCallbackCommon

extern int _far _pascal
	HTNetAddCallbackCommon(HTListHandle list, HTNetCallback cbf, int state);

extern int _far _pascal
	HTNetReportProgress(HTRequestHandle, int status);

#ifdef __HIGHC__
pragma Alias(HTNetReportProgress, "HTNETREPORTPROGRESS");
#endif

@endif /* __HT_NET_GOH */

