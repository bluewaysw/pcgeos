@ifndef __HT_SUFFIX_GOH__
@define __HT_SUFFIX_GOH__

@include <stdapp.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htstring.goh>

/* 
 *  Support suffixes
 */
#define HTSUFFIX_MIM          HTStringFor("mim")
#define HTSUFFIX_MIME         HTStringFor("mime")
#define HTSUFFIX_HTM          HTStringFor("htm")
#define HTSUFFIX_HTML         HTStringFor("html")
#define HTSUFFIX_GIF          HTStringFor("gif")
#define HTSUFFIX_JPG          HTStringFor("jpg")
#define HTSUFFIX_JPEG         HTStringFor("jpeg")
#define HTSUFFIX_TXT          HTStringFor("txt")
#define HTSUFFIX_TEXT         HTStringFor("text")

extern HTStreamHandle _far _pascal
	HTSuffixCreate(const char *suffix, HTRequestHandle request);

#ifdef __HIGHC__
pragma Alias(HTSuffixCreate, "HTSUFFIXCREATE");
#endif

@endif

