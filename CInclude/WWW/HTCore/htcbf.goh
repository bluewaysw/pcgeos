@ifndef __WWW_HTCBF_GOH__
@define __WWW_HTCBF_GOH__

@include <WWW/HTCore/htconst.goh>

/*
 * Notifications callback for socket connect and disconnect. This is
 * lame as SysHookNotification cannot accept more than one callback
 * functions for socket notifications. So HTCore takes the notification
 * and pass it on to clients.
 */
typedef void _far _pascal (*HTNotificationCallback) (int status);


/*
 * Content name has the form "text/html", "image/gif" (MIME format).
 * The callback returns a HTMemHandle which contains a HTContentHandler.
 * The Library will free the allocated HTMemHandle.
 * Return NullOptr if no content handler.
 */
typedef HTMemHandle _far (*HTPolicyContentCallback) 
     (HTRequestHandle request, HTStringHandle contentName);


/*
 * Function prototype that you use to create post callback functions and
 * register them to Request Manager. Must return HT_OK or code from 
 * pushing data using MSG_HT_PUT_BLOCK. Postcallbacks are used to push 
 * extra data to the network. Must NOT modify the request.
 *
 * Possible return codes from using MSG_HT_STREAM_PUT_BLOCK are:
 *  - HT_WOULD_BLOCK, meaning the next call to MSG_HT_STREAM_PUT_BLOCK.
 *        Client *MUST* return immediately from this callback without
 *	  calling anymore MSG_HT_STREAM_PUT_BLOCK. The library will call
 *	  this callback again when it is ready to receive more data.
 * 
 *  - HT_OK, all is OK. Continue to call MSG_HT_STREAM_PUT_BLOCK.
 *
 *  - Other codes, means some error has occurred. You *MUST* return
 *        the error code to the Library.
 */
typedef int _far _pascal (*HTPostCallback)(HTRequestHandle request, 
					   HTStreamHandle stream);	

/*
 * Callback prototype for converting native characters to standard chars
 * and vice versa. For example, before sending an email or attachment, 
 * we convert Geos characters to ISO standard characters. Also when 
 * saving a downloaded email or attachment, we also convert from ISO
 * standard chars to native chars. FYI, Geos uses a different char set
 * than ISO. I am sure other platforms that we port do the same thing.
 */
typedef char* _far _pascal (*CharConverterCallback)(char *bufToConvert, 
						    word len);

@endif
