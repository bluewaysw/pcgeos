@ifndef __HT_ASSOC_GOH__
@define __HT_ASSOC_GOH__

@include <WWW/HTCore/htlist.goh>
#include <WWW/htmem.h>

typedef HTListHandle HTAssocList; /* Just a different kind of list */

/*
 * Association between a name and its value.
 */
typedef struct {
    HTMemHandle HTA_name;           /* deref into char* */
    HTMemHandle HTA_value;          /* deref into char* */
} HTAssoc;

extern HTAssocList _far _pascal HTAssocListNew(void);

extern void _far _pascal HTAssocListDelete(HTAssocList alist);

extern Boolean _far _pascal HTAssocListAdd(HTAssocList alist,
					   HTMemHandle name, 
					   HTMemHandle value);

extern HTMemHandle _far _pascal HTAssocListLookup(HTAssocList alist, 
						  HTMemHandle name);

extern HTMemHandle _far _pascal HTAssocListLookupPtr(HTAssocList alist,
						     const char *name);

#ifdef __HIGHC__
pragma Alias(HTAssocListNew, "HTASSOCLISTNEW");
pragma Alias(HTAssocListDelete, "HTASSOCLISTDELETE");
pragma Alias(HTAssocListAdd, "HTASSOCLISTADD");
pragma Alias(HTAssocListLookup, "HTASSOCLISTLOOKUP");
pragma Alias(HTAssocListLookupPtr, "HTASSOCLISTLOOKUPPTR");
#endif

@endif
