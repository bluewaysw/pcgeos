@ifndef __HT_ASSOC_GOH__
@define __HT_ASSOC_GOH__

@include <WWW/HTCore/htlist.goh>
#include <WWW/htmem.h>

#define HTAssocList HTListHandle /* Just a different kind of list */

/* XXX */
/* Creation and deletion of any type of associative list */
extern HTAssocList _far _pascal HTAssocListNew(void);

extern void _far _pascal HTAssocListDelete(HTAssocList alist);

/* XXX */
/* Associative list for dwords */
extern Boolean _far _pascal 
    HTAssocDwordListAdd(HTAssocList alist, dword name, dword value);

extern Boolean _far _pascal 
    HTAssocDwordListLookup(HTAssocList alist, dword name, dword *value);

extern Boolean _far _pascal
    HTAssocDwordListRemove(HTAssocList alist, dword name, dword *value);

/* XXX */
/* Associative list for null-terminated strings */
extern Boolean _far _pascal 
    HTAssocListAdd(HTAssocList alist, HTMemHandle name, HTMemHandle value);

extern Boolean _far _pascal 
    HTAssocListAddPtr(HTAssocList alist, const char *name, const char *value);

extern HTMemHandle _far _pascal 
    HTAssocListLookup(HTAssocList alist, HTMemHandle name);

extern HTMemHandle _far _pascal 
    HTAssocListLookupPtr(HTAssocList alist, const char *name);

extern void _far _pascal
    HTAssocListDelete(HTAssocList alist);

extern void _far _pascal
    HTAssocDwordListDelete(HTAssocList alist);

extern dword _far _pascal
    HTAssocDwordListGetValue(HTAssocList alist, word index);

#ifdef __HIGHC__
pragma Alias(HTAssocListNew, "HTASSOCLISTNEW");
pragma Alias(HTAssocListDelete, "HTASSOCLISTDELETE");
pragma Alias(HTAssocDwordListAdd, "HTASSOCDWORDLISTADD");
pragma Alias(HTAssocDwordListLookup, "HTASSOCDWORDLISTLOOKUP");
pragma Alias(HTAssocDwordListRemove, "HTASSOCDWORDLISTREMOVE");
pragma Alias(HTAssocListAdd, "HTASSOCLISTADD");
pragma Alias(HTAssocListAddPtr, "HTASSOCLISTADDPTR");
pragma Alias(HTAssocListLookup, "HTASSOCLISTLOOKUP");
pragma Alias(HTAssocListLookupPtr, "HTASSOCLISTLOOKUPPTR");
pragma Alias(HTAssocListDelete, "HTASSOCLISTDELETE");
pragma Alias(HTAssocDwordListDelete, "HTASSOCDWORDLISTDELETE");
pragma Alias(HTAssocDwordListGetValue, "HTASSOCDWORDLISTGETVALUE");
#endif

@endif

