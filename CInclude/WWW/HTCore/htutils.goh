@ifndef __HT_UTILS_GOH
@define __HT_UTILS_GOH

@include <stdapp.goh>

/* --------------------------------------------------------------------------
 * 		I. COMMON CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*/

typedef word HTRequestHandle;		 /* 16-bit Request object descriptor */
typedef word HTLibHandle; 	/* References a client env in the Library */
/*
 * In the true  spirit of object-oriented programming, HTStreamHandle is a 
 * superclass object handle that can be used to point to any objects of
 * subclasses of HTStreamClass. This is so that we need not introduce
 * HTProtocolHandle, HTStructuredHandle etc.
 */
typedef optr HTStreamHandle;

/* 
 * Local equivalents of CR and LF.
 */
#ifndef CR
#define CR	C_CR
#endif

#ifndef LF
#define LF	C_LF
#endif


/* --------------------------------------------------------------------------
 * 		II. MACROS
 * --------------------------------------------------------------------------*/

/*
 * Macros to use Libary dgroup.
 */
#ifdef __HIGHC__

#ifndef PUSHDS
#define PUSHDS	_inline(0x1e)	/* push	ds */
#endif

#ifndef POPDS
#define POPDS	_inline(0x1f)	/* pop	ds */
#endif

#endif

#ifdef __BORLANDC__

#ifndef PUSHDS
#define PUSHDS  asm{push ds}
#endif

#ifndef POPDS
#define POPDS   asm{pop  ds}
#endif

#endif

#ifdef __WATCOMC__

#ifndef PUSHDS
void _PUSHDS(void);
#pragma aux _PUSHDS = "push ds";
#define PUSHDS  _PUSHDS()
#endif

#ifndef POPDS
void _POPDS(void);
#pragma aux _POPDS = "pop ds";
#define POPDS   _POPDS()
#endif

#endif

#ifndef SET_DS_LIB_DGROUP
#define SET_DS_LIB_DGROUP GeodeLoadDGroup (GeodeGetCodeProcessHandle())
                                /* destroys ds! */
#endif


/*
 * Macros to error checking.
 */
#if ERROR_CHECK
#define ECCheckRequest(request) ECCheckMemHandle(request)
#endif

@endif /* __HT_UTILS_GOH */

