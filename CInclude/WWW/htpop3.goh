@ifndef __HT_POP3_GOH__
@define __HT_POP3_GOH__

@deflib htpop3

@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htreq.goh>
@include <WWW/HTCore/htsock.goh>
@include <WWW/HTCore/htlist.goh>

@class HTPOP3Class, HTProtocolClass;

/* --------------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------------*/

/*
 * Protocol current and next states. These decide the execution of the FSM.
 */
@instance word HTPOP3I_command;
@instance word HTPOP3I_currentState;
@instance word HTPOP3I_nextState;

/*
 * Parser state.
 */
@instance word HTPOP3I_state;

/*
 * URL Parameters 
 */
@instance HTMemHandle HTPOP3I_params;

@endc

@endlib

@endif  /* __HT_IMAP_GOH__ */



