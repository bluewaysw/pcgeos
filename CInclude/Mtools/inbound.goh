#ifndef INCLUDED_INBOUND_GOH
#define INCLUDED_INBOUND_GOH

@include <mtools/pop3.goh>
@include <mtools/imap4.goh>
@include <mtools/message.goh>
@include <mtools/memutils.goh>


	/* Error code type. */
#define MailinError short

	/* MailInState - Records the state of any mailin command. */
typedef enum {
	MIS_NORMAL,					/* Nothing doing. Done. */
	MIS_P3_OPEN,				/* Doing the POP3_Open function. */
	MIS_P3_GET_RESP,			/* Doing a generic POP3_GetResp function. */
	MIS_P3_GET_FILE,			/* File capture. */

	MIS_P3_UIDL,
	MIS_P3_UIDL_GMC,
	MIS_P3_UID_NORMAL,

   MIS_I4_GET_UID,

	MIS_I4_OPEN,				/* Doing the IMAP4_Open command. */
	MIS_I4_GET_RESP,			/* Doing a generic IMAP4_GetResp command. */
	MIS_I4_LIST_BOX,			/* Waiting for an untagged list response. */
	MIS_I4_WAIT_SELECT		/* Waiting for the response to the select command after a create. */
} MailInState;

	/* InboxStruct - The structure behind the INBOX type. */
typedef struct {
	byte protocol;					/* INB_PROTOCOL_POP3 or INB_PROTOCOL_IMAP4 */
	MailinError ecode;			/* Last error code. */
	MailInState state;			/* Current status. */
	Socket i;						/* Socket handle. */

			/* ----- POP3 data. ----- */

	HTHANDLE POState;			/* Used by POP3_Open P3OpenState */
	HTHANDLE Presp;					/* Current POP3 response. NULL if not in use. P3Resp */
	P3RespType rtype;				/* Response type to use. */
	HTHANDLE uids;				/* Array of Uids. HTHANDLE[] */
	short numuids;				/* Number of uids. */


			/* ------ IMAP4 data ------ */

	HTHANDLE IOState;			/* Used by IMAP4_Open  I4Open*/
	HTHANDLE Iresp;						/* Current response. NULL if not in use. I4Resp */
	char tag[TAG_LENGTH];   /* Tag we are waiting for. */

	unsigned short int exists;		/* Last exists response. Number of messages. */
	long int msize;					/* Message size, to return when we are finished. */
	HTHANDLE muid;						/* UID of message, to return when we are finished. */

} InboxStruct;


			/* ----------------   OBSOLETE ---------------------------- */


typedef struct {
	LMemBlockHeader lmbh;		/* LMem heap header. Do not use. */
	ChunkHandle head;				/* Head node chunk handle. */
	ChunkHandle body;				/* handle for the first line of the message body. */

	MemHandle next;				/* Next LMem head. */
} MessageHead;

typedef struct {
	ChunkHandle mtext;			/* The string itself. */
	ChunkHandle next;				/* Next line. */
} MessageLineNode;

			/* --------------- END OBSOLETE ---------------------- */


	/* Mailbox type. */
#define INBOX HTHANDLE


	/* Mailin_ErrorCode - Returns the error code for the last Malin_ function on the stated INBOX.
				Since all Mailin_ functions now return error codes, this function is obsolete. It may
				only be used after _Open, _GetMessageCount and _GetMessageSize.
			box - Mailbox handle.
	*/
extern MailinError Mailin_ErrorCode(INBOX box);

	/* Mailin_Open - Opens an Inbound session.
			host - Name of the mail server.
			protocol - INB_PROTOCOL_POP3 or INB_PROTOCOL_IMAP4.
			user - User name.
			pass - Pass word.
			mbox - Name of mailbox to open. "INBOX", "" or NULL may be used to specify "INBOX".
			box - Pointer to INBOX handle. Must be zero the first time it is called.
		Returns error code.
	*/
extern MailinError Mailin_Open(char *host, byte protocol, char *user, char *pass, char *mbox, INBOX *box);

	/* Mailin_Close - Closes a session.
			box - Mailbox handle.
		Returns error code.
	*/
extern MailinError Mailin_Close(INBOX box);

	/* Mailin_GetMessageCount - Returns number of messages in mailbox. Message identifiers will
				range from one to the result of this function.
			box - Mailbox handle.
			count - Pointer to varibale to store result.
		Returns error code.
	*/
extern MailinError Mailin_GetMessageCount(INBOX box, unsigned short int *count);

	/* Mailin_GetMessageSize - Returns the size of a message in octets, including attachments in
				encoded form.
			box - Mailbox handle.
			MessageId - Message identifier.
			msize - Pointer to return message size.
		Returns error code.
	*/
extern MailinError Mailin_GetMessageSize(INBOX box, word MessageId, unsigned long int *msize);

	/* Mailin_GetMessage - Retrieves an entire message from the server.
			box - Mailbox handle.
			MessageId - Message identifier.
			m - Pointer to MailMessage structure.
		Returns error code.
	*/
extern MailinError Mailin_GetMessage(INBOX box, word MessageId, MailMessage *m);

	/* Mailin_DeleteMessage - Deletes a message from the server. The message identifier will remain
				vacant during this session, but not during the next session.
			box - Mailbox handle.
			MessageId - Message identifier.
		Returns error code.
	*/
extern MailinError Mailin_DeleteMessage(INBOX box, word MessageId);

	/* Mailin_Get822MessageHeader - Retrieves the message header in 822 form. The message library
				functions may be used to examine the contents.
			box - Mailbox handle.
			MessageId - Messgage Identifier.
			m - MailMessage structure to place contents.
		Returns error code.
	*/
extern MailinError Mailin_Get822MessageHeader(INBOX box, word MessageId, MailMessage *m);

				/********** IMAP4 only. **************/

	/* Mailin_CreateNew - Creates a new mailbox.
			box - Mailbox handle.
			mbox - Name of new mailbox.
		Returns error code.
	*/
extern MailinError Mailin_CreateNew(INBOX box, char *mbox);

	/* Mailin_Switch - Changes to a different mailbox on the same server. Use "INBOX", "" or NULL
				to specify "INBOX".
			box - Mailbox handle.
			mbox - Name of mailbox to switch to.
		Returns error code.
	*/
extern MailinError Mailin_Switch(INBOX box, char *mbox);

	/* Mailin_DeleteBox - Deletes a mailbox from the server, must not be the one currently active.
				"INBOX" may not be deleted.
			box - Mailbox handle.
			mbox - Name of mailbox to delete.
		Returns error code.
	*/
extern MailinError Mailin_DeleteBox(INBOX box, char *mbox);

	/* Mailin_ListFirstBox - Starts the Mailbox listing process and returns the name of the first
				mailbox.
			box - Mailbox handle.
			wcard - Search pattern. A star sign ("*") refers to any number of any character.
			mbox - Pointer to an allocated buffer to store the mailbox name.
		Returns error code or ERR_END_OF_LIST to signify that there are no mailboxes matching that
				pattern.
	*/
extern MailinError Mailin_ListFirstBox(INBOX box, char *wcard, char *mbox);

	/* Mailin_ListNextBox - Repeats the listing.
			box - Mailbox handle.
			mbox - Pointer to buffer to store string.
		Returns error code or ERR_END_OF_LIST to signify that there are no more mailboxes.
	*/
extern MailinError Mailin_ListNextBox(INBOX box, char *mbox);

	/* Mailin_CopyMessage - Copies a range of messages to another mailbox on the same server.
			box - Mailbox handle.
			firstm - First message identfier.
			lastm - Last message identifier, or zero if only one message is to be copied.
			mbox - Name of destination mailbox.
		Returns error code.
	*/
extern MailinError Mailin_CopyMessage(INBOX box, short int firstm, short int lastm, char *mbox);

	/* Mailin_Append - Adds a loaded message to a mailbox.
			box - Mailbox handle.
			mbox - Destination mailbox.
			m - MailMessage structure.
		Returns error code.
	*/
extern MailinError Mailin_Append(INBOX box, char *mbox, MailMessage *m);

	/* Mailin_SetAttach - Sets the directory (excluding '\' char on the end) for
				attachments, relative to disk or StandardPath.
			disk - Disk or StandardPath
			dir - Directory.
		Returns error code.
	*/
extern MailinError Mailin_SetAttach(DiskHandle disk, char *dir);

			/******* UID function. ********/


	/* Fetches the UID string for the given message number.
			box - Mailbox handle.
			mid - Message id.
			uid - Pointer to store string handle.
		 Returns error code. */
extern MailinError Mailin_Uid_GetUid(INBOX box, short mid, HTHANDLE *uid);

	/* Mailin_Uid_Resolve - Converts a UID string back into a message id.
			box - Mailbox handle. May have been closed and re-opened.
			uid - Uid string to resolve.
			mid - Pointer to store resulting message id.
		 Returns error code. */
extern MailinError Mailin_Uid_Resolve(INBOX box, char *uid, short *mid);

	/* Mailin_Uid_GetMessageSize - Returns the size of a message in octets, including attachments in
				encoded form.
			box - Mailbox handle.
			uid - Message uid string.
			msize - Pointer to return message size.
		Returns error code. */
extern MailinError Mailin_Uid_GetMessageSize(INBOX box, char *uid, unsigned long int *msize);

	/* Mailin_Uid_GetMessage - Retrieves an entire message from the server.
			box - Mailbox handle.
			uid - Message uid string.
			m - Pointer to MailMessage structure.
		Returns error code. */
extern MailinError Mailin_Uid_GetMessage(INBOX box, char *uid, MailMessage *m);

	/* Mailin_Uid_DeleteMessage - Deletes a message from the server. The message identifier will remain
				vacant during this session, but not during the next session.
			box - Mailbox handle.
			uid - Message uid string.
		Returns error code. */
extern MailinError Mailin_Uid_DeleteMessage(INBOX box, char *uid);

	/* Mailin_Uid_Get822MessageHeader - Retrieves the message header in 822 form. The message library
				functions may be used to examine the contents.
			box - Mailbox handle.
			uid - Messgage uid string.
			m - MailMessage structure to place contents.
		Returns error code. */
extern MailinError Mailin_Uid_Get822MessageHeader(INBOX box, char *uid, MailMessage *m);



#endif


