#ifndef INCLUDE_IFILE_GOH
#define INCLUDE_IFILE_GOH

@include <stdapp.goh>
@include <socket.goh>
@include <sockmisc.h>
#include <ansi/string.h>
@include <mtools/memutils.goh>
@include <mtools/mterror.goh>

#define MAX_BUFFER_SIZE 1024

	/* iopen - Opens a TCP/IP socket, including resolving an address.
			host    - Name of server.
			iport   - Port number on host.
			accPnt  - Access Point number.
			timeOut - How long to wait for connection in 1/60 seconds.

		Returns;
			Zero     - Error. Check variable iECode.
			Non-zero - Socket handle.
	*/
Socket iopen(char *host, int iport, int accPnt, int timeOut);

	/* iclose - Closes a socket opened with iopen.
			ih	- Socket handle.
		Returns;
			SocketError code.
	*/
int iclose(Socket ih);

	/* iputs - Sends some text down a socket, replacing all \n characters with a \r\n pair.
			s   - The text to send.
			ih	 - Socket handle.
		Returns;
			Number of characters sent.
			If IEOF, iECode contains error value.
	*/
int iputs(char *s,Socket ih);

	/* igets - Get a single line of text from a socket, ending in \r\n. String with end with a
					\n character just before the \0 terminator, unless the line is too big to fit in
					buffer.
			s 	     - Buffer for string.
			n       - Size of buffer.
			ih      - Socket handle.
			timeout - Time to wait for response in 1/60 seconds.
		Returns;
			Null     - Error. iECode contains error code.
			Non-Null - Copy of s parameter.
	*/
char* igets(char *s, int n, Socket ih, int timeout);

	/* migets - As igets, but allocates memory for buffer using malloc. Must be freed using free()
			s       - Pointer to a character pointer to store the text buffer in.
			ih      - Socket handle.
			timeout - Time to wait in 1/60 seconds.
		Returns;
			Null		- Error. iECode contains error code.
			Non-Null - Copy of buffer location.
	*/
char* migets(char **s, Socket ih, int timeout);

	/* htigets - As migets, but memory is allocated using ht_alloc. Must be freed using ht_free()
			s       - Pointer to HTHANDLE to store text buffer in.
			ih      - Socket handle.
			timeout - Time to wait in 1/60 seconds.
		Returns;
			Null     - Error. iECode contains error code.
			Non-Null - Copy of handle.
	*/
HTHANDLE htigets(HTHANDLE *s, Socket ih, int timeout);

	/* GetSocket - Obsolete function. Returns parameter.
			ih - Socket handle.
		Returns;
			The value of ih.
	*/
#define GetSocket(ih) (ih*1)


	/* Error indicator for iputs return value. */
#define IEOF (-1)
	/* Obsolete identifier to indicate infinite timeout. */
#define IFILE_NO_TIMEOUT SOCKET_NO_TIMEOUT


	/* Generic error code for above functions. Can contain SocketError or IfileError values. */
extern IfileError f_iECode(void);
#define iECode f_iECode()

#endif
