#ifndef INCLUDE_ISOCK_GOH
#define INCLUDE_ISOCK_GOH

@include <stdapp.goh>
#include <mtools/dspatch.h>

	/* Declare a function with the name fn, which will be called after every 512 octets have
			been sent/recieved through a socket.
		 Parameter n will be the number of octets transfered. (Which may not be 512)
		 Paramerer last will be TRUE if this is the last call for this inparticular message. */
#define DECL_PCB_SOCKET_ACTIVITY(fn) extern void (fn) (unsigned short n, Boolean last)

	/* Declare a function with the name fn, which will be called after every 512 octets have been
			written to/read from an attachment file.
		 Parameter n will be the number of octets transfered. (Which may not be 512)
		 Parameter last will be true if this is the last call for this file. */
#define DECL_PCB_FILE_ACTIVITY(fn) extern void (fn) (unsigned short n, Boolean last)

	/* Declare a function with the name fn, which will be called when an attachmnet file has been
			opened or created.
		 Parameter f will point to the full path filename. */
#define DECL_PCB_FILE_OPEN(fn) extern void (fn) (char *f)

	/* Called by ifile functions to report socket activity and generate callbacks. */
extern void isocket(char *s, short int n);

	/* Specifies GenTextClass object to echo socket actrivity, or NULL to stop. */
extern void GenTextEcho(optr gt);

	/* Specifies call back functions to handle events.
			sockact - Called after every 512 octets is sent/received through a socket.
			fileact - Called after every 512 octets is written to/read from an attachment file.
			fileopen - Called after an attachment file is opened or created. */
extern void SetProgressCallBack(void (*sockact), void (*fileact), void (*fileopen) );

	/* Resets the Socket Activity counter. Called by Mail Tools before message transfer. */
extern void StartSA(void);

	/* Does a final (for this message) pcb_sa and resets. */
extern void FinishSA(void);

	/* Informs that an attachmnet file is about to be opened or created. */
extern void InformFileOpen(char *fname);

	/* Informs that n octets have been written/read. */
extern void InformFileActivity(short n);

	/* Informs that the attachment file is about to close. */
extern void InformFileClose(void);


#endif
