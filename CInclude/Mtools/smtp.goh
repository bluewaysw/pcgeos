#ifndef INCLUDED_SMTP_GOH
#define INCLUDED_SMTP_GOH

@include <mtools/ifile.goh>
@include <mtools/message.goh>
@include <mtools/memutils.goh>
@include <mtools/mterror.goh>

#define MAX_LINE_LENGTH 2048

	/* RespNode - A single line in an SMTP response linked list. */
struct SMTP_RespNode {
	HTHANDLE rtext;	/* Response text, including number. char */
	HTHANDLE next;	/* Next in list. SMTP_RespNode */
} ;
typedef struct SMTP_RespNode SMTP_RespNode;
#define ht_SMTP_RespNode(h) ((SMTP_RespNode*)ht_lock(h))


	/* SMTP_RespState - Records the state of a response capture. */
typedef enum {
	SRS_EMPTY = 0,		/* Response structure is empty. */
	SRS_WAITING,		/* Response is incomplete. */
	SRS_FULL				/* Response is complete. */
} SMTP_RespState;

	/* SMTP_Resp - Structure holds a full response. */
typedef struct {
	SMTP_RespState status; 	/* Response status. */

	short int code; 			/* SMTP response code. 1000 if invalid. */
	short int lines;			/* Number of response lines. */
	HTHANDLE head;				/* First line in response list. SMTP_RespNode */
} SMTP_Resp;
#define ht_SMTP_Resp(h) ((SMTP_Resp*)ht_lock(h))

	/* SMTP_Open - Opens an SMTP session including handshaking and ESMTP negotation.
			host 	    - Name of SMTP server.
			esmtp     - TRUE to negotiate ESMTP. FALSE to not.
			accPnt    - Access point to use.
			localhost - Name of user's computer.
			resp      - Pointer to store full response to HELO/EHLO command.
			sk        - Socket handle. Must be zero the first time it is called.
		Returns error code.
	*/
extern SmtpError SMTP_Open(char *host, Boolean esmtp, int accPnt, char *localhost, SMTP_Resp *resp, Socket *sk);

	/* SMTP_SendCommand - Writes string to socket, followed by \r\n.
			sk      - Socket handle.
			command - SMTP command.
		Returns error code.
	*/
extern SmtpError SMTP_SendCommand(Socket sk, char *command);

	/*	SMTP_SendMsg - Writes the contents of a MailMessage structure to a socket, ecoding
								attachments and optionally adding in dots where appropiate.
			sk - Socket handle.
			msg - Pointer to MailMessage structure.
			stuffdots - True to add dots to socket stream. False to not do so.
			sent - Pointer to return number of octets sent.
		Returns error code.
	*/
extern SmtpError SMTP_SendMsg(Socket sk, MailMessage *msg, Boolean stuffdots, unsigned long *sent);

	/* SMTP_GetResp - Retrives an SMTP response.
			sk - Socket handle.
			resp - Pointer to response structure.
			fullResp - TRUE to store all of the response. FALSE if only the response code is wanted.
		Returns error code.
	*/
extern SmtpError SMTP_GetResp(Socket sk, SMTP_Resp *resp, Boolean fullResp);

	/* SMTP_Close - Closes an SMTP session.
			sk - Socket Handle.
		Returns error code.
	*/
extern SmtpError SMTP_Close(Socket sk);

	/* SMTP_DelRespList - Frees any resources used in a response structure. Need only be used when
					SMTP_GetResp is called with fullResp as TRUE.
			resp - Response structure to free.
	*/
extern void SMTP_DelRespList(SMTP_Resp *resp);

	/* SMTP_InitResp - Initialises a response structure to null values.
			resp - Response structure to initialise. */
extern void SMTP_InitResp(SMTP_Resp *resp);

#endif



