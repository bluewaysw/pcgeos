#ifndef ATTACH_H
#define ATTACH_H

@include <mtools/mterror.goh>

//extern int attachcount; // how many attachments there are left to encode

#define attachcount f_attachcount()
extern int f_attachcount(void);

/*
 * attach_reset
 *
 * reset the statics ready for a new attachment
 */
extern void CODEC_Reset(void);

/*
 * attach_setoutputdir
 *
 * All attachments will be placed in <dir>
 */
extern int CODEC_SetOutputDir(char *dir);

/*
 * attach_whereisit
 *
 * returns the full path of the last decoded attachment
 */
extern char *attach_whereisit(void);

/*
 * attach_decode
 *
 * Check to see if the line is the start/end of an encoded segment, or if
 * decoding is currently active, if the line forms part of the attachment
 */
extern int attach_decode(char **line);

/*
 * attach_encode
 *
 * writes data, line by line into a buffer, until the EOF occours in the input file
 */
extern int attach_encode(char *line);

#define AttachHeader f_AttachHeader()

extern char *f_AttachHeader(void);

/*
 * attach_addattachment
 *
 * An 'X-Mail-Tools-Attachment' header was found, add the file to the list of attachments
 */
extern int attach_addattachment(char **line);

/*
 * attach_nextattachment
 *
 * uses the boundary to make a new header, <spec> should be 1 for the message header, or
 * 0 for each of the attachments, and finally -1 for the trailing boundary
 */
extern int attach_nextattachment(char **line, int spec);

/*
 * attach_convert
 *
 * Takes the string pointed to by <*pline> and converts it into quoted-printable form
 * the pointer <*pline> is then updated to point to the new string.
 */
extern int attach_convert(char **pline);

#endif
