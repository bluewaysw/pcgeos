@include <stdapp.goh>
#include <input.h>
#include <Ansi/stdio.h>
#include <Ansi/string.h>
@include <WWW/uigenera.goh>
@include <WWW/pmanager.goh>

/* Data structure define	*/

#define MAX_TITLE_LEN		100

/* For displaying items */
#define ITEM_TEXT_LENGTH	50
#define NUM_TEXT_GUESS		12
#define ITEM_LENGTH		165
#define LOCK_POS		155

#define MONIKER_SIZE		20
#define TEXT_START		(MONIKER_SIZE + 8)

/* For displaying title bar */
#define TITLE_BAR_LEN		350
#define TITLE_ST_URL_START	150
#define TITLE_LT_URL_START	200

#define	MAX_HISTORY		20

#define max(a,b)		(((a)>(b))?(a):(b))
#define min(a,b)		(((a)<(b))?(a):(b))

typedef	enum {
    ISTU_SECOND	= 1,
    ISTU_MINUTE	= 2
} ISTimeUnit;

typedef ByteFlags ISPreferenceStateType;
#define	ISPST_AUTO_LOAD_IMAGE	0x80
#define	ISPST_CONFIRM_DELETE	0x40
#define ISPST_CONFIRM_CANCEL	0x20
#define	ISPST_HOLD_CONNECTION	0x10

typedef enum {
    LP_AUTO_LOAD	= 1,
    LP_CONFIRM_DELETE	= 2,
    LP_CONFIRM_CANCEL	= 3,
    LP_HOLD_CONNECTION	= 4
} ISLPItemType;

typedef enum {
    LP_FIRST_VIEW	= 0,
    LP_SECOND_VIEW	= 1,
    LP_THIRD_VIEW	= 2
} ISLPViewType;

typedef struct {
    ISPreferenceStateType	ISPS_states;
    int				ISPS_time;
    ISTimeUnit			ISPS_timeUnit;
    int				ISPS_cacheSize;
} ISPreferenceStruct;

/* Define URL structure for history */
typedef struct {
    word	ISHS_titleOffset;	/* offset of title */
    word 	ISHS_urlOffset;		/* offset of url */
} ISHistoryStruct;

/*
 ***************************************************************************
 *		Class & Message Definitions
 ***************************************************************************
 */

@class	ISProcessClass, GenProcessClass;

/* Messages for the local icons */
@message (GEN_TRIGGER_ACTION)MSG_ISP_LOCAL_ICONS;

@message void MSG_ISP_DISPLAY_DOCUMENT();
@message void MSG_ISP_FIND();
@message void MSG_ISP_COPY();
@message void MSG_ISP_LOAD_IMAGE();
@message void MSG_ISP_LOAD_ALL_IMAGE();
@message void MSG_ISP_RELOAD();
@message void MSG_ISP_PRINT();

@message void MSG_ISP_OPEN_URL(MemHandle urlBlock, optr target);
@message void MSG_ISP_STOP();
@message void MSG_ISP_AFTER_CALLBACK(HTRequestHandle request, int status);
@message void MSG_ISP_DELETE_REQUEST(HTRequestHandle request);
@endc;


@class	ISAppClass, GenApplicationClass;

@message void MSG_ISA_ADD_TO_HISTORY(MemHandle tit_url);
@message Boolean MSG_ISA_CAN_BACK();
@message Boolean MSG_ISA_CAN_FORWARD();
@message Boolean MSG_ISA_HAS_DOCUMENT();
@message MemHandle MSG_ISA_GET_HISTORY_HANDLE();
@message void MSG_ISA_OPEN_LOCATION();
@message void MSG_ISA_HISTORY();
@message void MSG_ISA_BACK();
@message void MSG_ISA_FORWARD();
@message void MSG_ISA_DOCUMENT_INFORMATION();
@message void MSG_ISA_LOCAL_PREFERENCE();

@message (GEN_DYNAMIC_LIST_QUERY_MSG) MSG_ISA_HISTORY_LIST_MONIKER_QUERY;

@message void* MSG_ISA_GET_CURRENT_DOCUMENT();
@message void MSG_ISA_SET_CURRENT_TITLE_AND_DISPLAY(optr titleOptr);

/* messages for Local Preference */
@message (GEN_ITEM_GROUP_APPLY_MSG)MSG_ISA_LP_CHANGE_HOLD;
@message (GEN_VALUE_APPLY_MSG)MSG_ISA_LP_SPACE_VALUE;
@message void MSG_ISA_LP_PREV();
@message void MSG_ISA_LP_NEXT();

/* The data for the local preference .*/
@instance	ISPreferenceStruct	ISAC_preference = {
			ISPST_CONFIRM_DELETE | ISPST_CONFIRM_CANCEL,
			15, ISTU_SECOND, 100};
@instance 	ISLPViewType		ISAC_preferenceView = LP_FIRST_VIEW;

/* History list will be in a different data block. */
@instance	MemHandle		ISAC_historyHandle = NullHandle;
@instance	ChunkHandle		ISAC_historyChunk = NullChunk;
@instance	word			ISAC_currentHistory = GIGS_NONE;
@instance	word			ISAC_historySize = 0;

@endc;

@class	ISPresentationManagerClass, PresentationManagerClass;
@endc;








