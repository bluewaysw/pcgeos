@ifndef __REQ_LIST_GOH
@define __REQ_LIST_GOH

/* --------------------------------------------------------------------------
 * 		CONSTANTS and DATA TYPES
 * --------------------------------------------------------------------------*//*
 */
typedef struct {
    HTRequestHandle SR_request;
    Boolean         SR_killed;
    optr	    SR_target;
} SRequest;

typedef struct {
    MemHandle	    SRL_memHandle;
    ChunkHandle     SRL_chunkHandle;
    ChunkHandle     SRL_titleChunk;
    ChunkHandle	    SRL_urlChunk;
} SReqList;

extern void _far _pascal SReqListNew(SReqList *list);

extern void _far _pascal SReqListFree(SReqList *list);

extern void _far _pascal SReqListAddRequest(SReqList list, 
			HTRequestHandle request,
			optr target);

extern void _far _pascal SReqListDeleteRequest(SReqList list, 
			HTRequestHandle request);

extern void _far _pascal SReqListKillRequest(SReqList list,
			HTRequestHandle request);

extern void _far _pascal SReqListKillAllRequests(SReqList *list);

extern optr _far _pascal SReqListGetRequestTarget(SReqList list,
			HTRequestHandle request);

extern int _far _pascal SReqListGetRequestCount(SReqList list);

extern void _far _pascal SReqListSetTitle(SReqList *list, char *title);

extern word _far _pascal SReqListGetTitle(SReqList list, char *title, word size);

extern void _far _pascal SReqListSetURL(SReqList *list, char *url);

extern word _far _pascal SReqListGetURL(SReqList list, char *url, word size);

@endif
			
			





