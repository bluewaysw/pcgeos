@ifndef __HT_PLAIN_GOH
@define __HT_PLAIN_GOH

@include <stdapp.goh>

@include <WWW/HTCore/htstream.goh>

/****************************************************************************

  The PlainClass is inherited from HTStreamClass defined in htstream.goh{goc}.

 ****************************************************************************/

@class HTPlainClass, HTStreamClass;



/* --------------------------------------------------------------------------
 * 		Instance Data.
 * --------------------------------------------------------------------------*/

/*
 * The part of canvas that a text/plain object is displaying to.
 * In the from-sratch approach, we would keep the same object
 * point to a global canvas shared by all content-type handlers.
 * BUT....
 * Since we are using a UI-tree approach, the object here will be 
 * different.
 *
 * The display object is pointed by HTSI_target (see htstream.goh), so 
 * there is no need for a new instance data like HTPI_displayCanvas.
 *
 * We also need additional information about the display canvas...
 */	

@instance dword HTPI_bytesReceived;

@endc


@endif
