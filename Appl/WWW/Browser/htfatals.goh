@ifndef __HT_FATALS_GOH__
@define __HT_FATALS_GOH__

@include <stdapp.goh>

/*
 * FatalErrors
 */
#if ERROR_CHECK
typedef enum {
    GOBBLE_TILL_SYMBOL_NOT_IMPLEMENTED,
    IDENTIFIER_LONGER_THAN_MAX_HTML_TAG_NAME_LENGTH,
    INVALID_ACCESS_METHOD_NAME,
    INVALID_CONTENT_TYPE_NAME,
    INVALID_HTML_ELEMENT_TOKEN,
    SCANNER_BUFFER_FULL,
    SCANNER_BUFFER_EMPTY
} FatalErrors;
#endif /* ERROR_CHECK */


/*
 * Warnings
 */
#if ERROR_CHECK
typedef enum {
    HTML_PARSER_IGNORE_A_TOKEN,
    HTML_SCANNER_IGNORE_A_CHARACTER
} Warnings;

#endif


#if ERROR_CHECK
extern FatalErrors geoBrowserFatalErrors;
extern Warnings    geoBrowserWarnings;
#endif 

@endif
