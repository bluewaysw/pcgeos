@include <stdapp.goh>

/* --------------------------------------------------------------------------
 * 		CLASS DEFINITION
 * --------------------------------------------------------------------------*/

/* --------------------------------------------------------------------------
 * 		A. GBProcessClass
 * --------------------------------------------------------------------------*/
@class	GBProcessClass, GenProcessClass;

/*
 * Open a URL.
 *
 * Context:	Load data object.
 * Source:	@GBOpenLocOpenTrigger
 * Destination:	process
 * Interception:Not necessary
 */
@message void MSG_GBP_OPEN_URL();

/*
 * The requested data object has moved to a new location. And we
 * have the new URL address in the request.
 *
 * Context:	Load data object.
 * Source:	GBTerminateRequest.
 * Destination:	process
 * Interception:Not necessary
 */
@message void MSG_GBP_DOCUMENT_MOVED(HTRequestHandle request);

/*
 * The requested data object is protected, and it needs to be authorized.
 *
 * Context:	Load data object.
 * Source:	GBTerminateRequest.
 * Destination:	process
 * Interception:Not necessary
 */
@message void MSG_GBP_UNAUTHORIZED(HTRequestHandle request);

/*
 * Reload the current document.
 *
 * Context:	Load data object.
 * Source:	@GBReloadTrigger
 * Destination:	process
 * Interception:Not necessary
 */
@message void MSG_GBP_RELOAD();

/*
 * Stop the loading of current document.
 *
 * Context:	Load data object.
 * Source:	@GBStopTrigger
 * Destination:	process
 * Interception:Not necessary
 */
@message void MSG_GBP_STOP();

/*
 * Delete a request.
 *
 * Context:	Sync access to requestList.
 * Source:	oself.
 * Destination:	process
 * Interception:Not necessary.
 */
@message void MSG_GBP_DELETE_REQUEST(HTRequestHandle request);


@endc;









