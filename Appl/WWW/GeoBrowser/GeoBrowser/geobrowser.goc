FatalErrors geoBrowserFatalErrors;
Warnings    geoBrowserWarnings;
#endif

/*--------------------------------------------------------------------------
 *		Local Constants and Variables
 *-------------------------------------------------------------------------*/

/* 
 * Geoworks now uses a new proxy with firewall etc. We have to go thru 
 * this proxy.
 */
static char geoworksHTTPProxyName[] = "192.168.70.1";
static word geoworksHTTPProxyPort = 80;

/*
 * List of "before" callbacks.
 */
static HTListHandle beforeCbfList = NULL;
/*
 * List of "after" callbacks.
 */
static HTListHandle afterCbfList = NULL;
/*
 * List of "request" callbacks.
 */
static HTListHandle requestCbfList = NULL;
/* 
 * List of protocol methods used to service requests.
 */
static HTListHandle protocolList = NULL;
/*
 * Synchronized list of requests.
 */
static optr sRequestList = NullOptr;
static SemaphoreHandle isStopping = NULL;
static Boolean processDetaching = FALSE;


/*--------------------------------------------------------------------------
 *		Application Object
 *-------------------------------------------------------------------------*/
@start	AppResource;

@object GenApplicationClass GBApp = {
    GI_visMoniker = list { @GBMoniker }
    GI_comp = @GBPrimary;
    gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_WINDOWS) = @GBPrimary;
}

@visMoniker GBMoniker = "C GeoBrowser";

@end	AppResource;


/*--------------------------------------------------------------------------
 *		Interface
 *-------------------------------------------------------------------------*/
@start	Interface;

@object GenPrimaryClass GBPrimary  = {
	GI_comp = @GBFileMenu,
		  @GBGoMenu,
	          @GBReloadTrigger,
		  @GBStopTrigger,
	          @GBTextView,
       		  @GBStatus;
	HINT_DISPLAY_MAXIMIZED_ON_STARTUP;
	HINT_DISPLAY_NOT_RESIZABLE;
	HINT_PRIMARY_NO_FILE_MENU;
}

/*
 * GBPrimary window is further decomposed into 3 sub windows (a),
 * (b), and (c) where
 * (a1) through (a2) are menus are count as one sub window.
 *
 * (a) (a1) GBFileMenu, (a2) GBGoMenu, 
 *     (a3) GBReloadTrigger, (a4) GBStopTrigger
 * (b) GBView.
 * (c) GBStatus
 */

/*
 * (a1) GBFileMenu
 */
@object GenInteractionClass GBFileMenu = {
	GI_visMoniker = 'F', "File";
	GII_visibility = GIV_POPUP;
	GI_comp = @GBOpenLocation;
	ATTR_GEN_INTERACTION_GROUP_TYPE = GIGT_FILE_MENU;
}

/*
 * (a1)(i) GBOpenLocation
 */
@object GenInteractionClass GBOpenLocation = {
	GI_visMoniker = 'O', "Open Location...";
	GII_visibility = GIV_DIALOG;
	GII_type = GIT_MULTIPLE_RESPONSE;
	GI_comp = @GBOpenLocEntry,
		  @GBOpenLocOpenTrigger,
		  @GBOpenLocClearTrigger,
 		  @GBOpenLocCancelTrigger;
}

/*
 * (a1)(ii) GBOpenLocEntry
 */
@object GenTextClass GBOpenLocEntry = {
	GTXI_text = "http://www.geoworks.com/index.html";
/*	GTXI_text = "file://test.txt"; */
	GTXI_attrs = @default | GTA_SINGLE_LINE_TEXT;
	HINT_DRAW_IN_BOX;
	HINT_PLACE_MONIKER_TO_LEFT;
	ATTR_GEN_TEXT_NO_SPACES;
}

/*
 * (a1)(iii) GBOpenLocOpenTrigger
 */
@object GenTriggerClass GBOpenLocOpenTrigger = {
	GI_visMoniker = "Open";
	GI_attrs = GA_SIGNAL_INTERACTION_COMPLETE;
	GTI_destination = process;
	GTI_actionMsg = MSG_GBP_OPEN_URL;
	HINT_SEEK_REPLY_BAR;
	HINT_DEFAULT_DEFAULT_ACTION;
}

/*
 * (a1)(iv) GBOpenLocClearTrigger
 */
@object GenTriggerClass GBOpenLocClearTrigger = {
	GI_visMoniker = "Clear";
	GTI_destination = @GBOpenLocEntry;
	GTI_actionMsg = MSG_VIS_TEXT_DELETE_ALL;
	HINT_SEEK_REPLY_BAR;
}

/*
 * (a1)(v) GBOpenLocCancelTrigger
 */
@object GenTriggerClass GBOpenLocCancelTrigger = {
	GI_visMoniker = "Cancel";
	GI_attrs = GA_SIGNAL_INTERACTION_COMPLETE;
	HINT_SEEK_REPLY_BAR;
}

/*
 * (a2) GBGoMenu
 */
@object GenInteractionClass GBGoMenu = {
	GI_visMoniker = 'G', "Go";
	GII_visibility = GIV_POPUP;
	GI_comp = @GBChooseLocList;
	ATTR_GEN_INTERACTION_GROUP_TYPE = GIGT_OPTIONS_MENU;
}

/*
 * (a2)(i) GBChooseLocList
 */
@object GenDynamicListClass GBChooseLocList = {
/*
	GIGI_destination = process;
	GIGI_applyMsg = MSG_GBP_GO_LOCATION;
	GDLI_queryMsg = MSG_GBP_UPDATE_GO_LIST; 
*/
	HINT_DRAW_IN_BOX;
	HINT_ITEM_GROUP_SCROLLABLE;
}

/*
 * (a3) GBReloadTrigger
 */
@object GenTriggerClass GBReloadTrigger = {
	GI_visMoniker = 'R', "Reload";
	GTI_destination = process;
	GTI_actionMsg = MSG_GBP_RELOAD;
	HINT_SEEK_MENU_BAR;
}

/*
 * (a4) GBStopTrigger
 */
@object GenTriggerClass GBStopTrigger = {
	GI_visMoniker = 'S', "Stop";
	GTI_destination = process;
