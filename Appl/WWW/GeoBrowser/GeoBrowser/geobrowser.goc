}

/*
 * (b) GBTextView (text only browser view)
 */
@object GenTextClass GBTextView = {
	GTXI_attrs = @default | GTA_INIT_SCROLLING | 
	    GTA_DONT_SCROLL_TO_CHANGES;
	HINT_DRAW_IN_BOX;
	HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
}

/*
 * OR (b) Saves to a file.
 */
