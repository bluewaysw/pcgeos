@ifndef __HTML_GOH__
@define __HTML_GOH__

#define HTML_BUFFER_LENGTH 256

@include <stdapp.goh>
@include <WWW/HTCore/htstream.goh>
@include <WWW/HTCore/htlist.goh>
@include <WWW/htmlDTD.goh>


/* 
 * For mapping a HTML token to string for testing purposes.
 */
typedef struct {
    char *HTMLIO_string;
} HTMLInputOutput;


/****************************************************************************

  The HTMLClass is inherited from HTStreamClass defined in htstream.goh{goc}.

 ****************************************************************************/

@class HTMLClass, HTStructuredClass;


/*
 * Print start element to screen for test.
 *
 * Context:	Test
 * Source:	Internal
 * Destination:	self
 * Interception:No
 */
@message void MSG_HTML_PRINT_START_ELEMENT(word elementToken,
					   MemHandle block,
					   ChunkHandle chunk);


/*
 * Print end element to screen for test.
 *
 * Context:	Test
 * Source:	Internal
 * Destination:	self
 * Interception:No
 */
@message void MSG_HTML_PRINT_END_ELEMENT(word elementToken);


/*
 * Print data.
 *
 * Context:	Test
 * Source:	Internal
 * Destination:	self
 * Interception:No
 */
@message void MSG_HTML_PRINT_DATA(const byte *data, word len);


/* -------------------------------------------------------------------------
 * 		Instance Data.
 * ------------------------------------------------------------------------*/

@endc;

@endif
