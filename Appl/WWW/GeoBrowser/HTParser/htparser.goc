@include "HTParser/htparser.goh"
@include <WWW/HTCore/htreq.goh>


/***********************************************************************
		Class Declaration
***********************************************************************/

@classdecl	HTParserClass;


/***********************************************************************
		Message Handlers
***********************************************************************/



/***********************************************************************
 *		MSG_HT_STREAM_FLUSH for HTParserClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTParserClass, MSG_HT_STREAM_FLUSH
{
    return HT_OK;  /* As we do not buffer data. */
}	/* End of MSG_HT_STREAM_FLUSH.	*/



/***********************************************************************
 *		MSG_HT_STREAM_PUT_BLOCK for HTParserClass
 ***********************************************************************
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	kkee	7/11/96   	Initial Revision
 *
 ***********************************************************************/
@method HTParserClass, MSG_HT_STREAM_PUT_BLOCK
{
    while (len-- > 0) {
    }
    return HT_OK;
}	/* End of MSG_HT_STREAM_PUT_BLOCK.	*/



