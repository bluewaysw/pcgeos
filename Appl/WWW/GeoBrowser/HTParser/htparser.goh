@ifndef __HTPARSER_GOH
@define __HTPARSER_GOH

@include <stdapp.goh>
@include <WWW/HTCore/htstream.goh>


/****************************************************************************

  Our HTParserClass must be inherited from HTStreamClass. We intercept the 
  stream messages to parse a HTTP response message.

 ****************************************************************************/

/* --------------------------------------------------------------------------
 * 		A. HTPARSER CLASS (My HTTP response parser)
 * --------------------------------------------------------------------------*/

@class HTParserClass, HTStreamClass;
@endc;

@endif  /* __HTPARSER_GOH */

