/*--------------------- MSG_META_INITIALIZE ---------------------
 *  Purpose:
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_META_INITIALIZE {
    @callsuper();

    ToolInitializeDrawAttrs(&(pself->FBI_lineAttrs), &(pself->FBI_areaAttrs));

    pself->FBI_currentTool = 	BTF_INITIAL_TOOL;
    pself->FBI_startSelectMsg = INITIAL_START_SELECT_MSG;
    pself->FBI_metaPtrMsg = 	INITIAL_META_PTR_MSG;
    pself->FBI_endSelectMsg = 	INITIAL_END_SELECT_MSG;
}


/*--------------------- MSG_VIS_RECALC_SIZE ---------------------
 *  Purpose:	Return the size of the Content object
 *  Context:	Geometry management
 *  Strategy:
 	- if no bitmap existes, return default values
 	- if there is an bitmap, return bitmap size mutplied with FBI_pixelSize
 *  Parameters:  SizeAsDWord (RecalcSizeArgs width; RecalcSizeArgs height9;
 *  Return:	SizeAsDWord
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_VIS_RECALC_SIZE {
int w, h;

    if ( !pself->FBI_bitmap ) {
    	w = 48;
    	h = 30;
    } else {
    	BTGetMoreBitmapInfos(global.tempFile, pself->FBI_bitmap, &w, &h, 0);
    }

    w *= pself->FBI_pixelSize;
    h *= pself->FBI_pixelSize;
    return( MAKE_SIZE_DWORD(w , h) );
}


/*--------------------- MSG_META_CLIPBOARD_COPY ---------------------
 * Purpose:     Copy current bitmap to clipboard
 * Startegy:
 *	- if there is a part of the image selected (ants are running), copy selection
 *	- if not, copy whole image;
 * Parameters:	void(void)
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_META_CLIPBOARD_COPY {
VMBlockHandle bmp;

    if ( pself->FBI_ants.antState != ANT_STATE_NO_ANTS ) {
    	bmp = BTClipBitmap(global.tempFile, pself->FBI_bitmap, global.tempFile,
    		pself->FBI_drag.x0, pself->FBI_drag.y0, pself->FBI_drag.x1, pself->FBI_drag.y1);
    	BTCopyBitmapToClipboard(global.tempFile, bmp, BT_CLIP_COPY_ADD_GSTRING);
    	HugeArrayDestroy(global.tempFile, bmp);
    } else {
	BTCopyBitmapToClipboard(global.tempFile, pself->FBI_bitmap, BT_CLIP_COPY_ADD_GSTRING);
    }
}


/*--------------------- MSG_FATBITS_SET_FLAGS ---------------------
 *  Purpose:	Set or clear common flags
 *  Startegy:
 *  Parameters:	flagsToSet
 *		flagsToClear
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_SET_FLAGS {

     pself->FBI_flags |= flagsToSet;
     pself->FBI_flags &= ~flagsToClear;
}

/*--------------------- MSG_FATBITS_GET_FLAGS ---------------------
 *  Purpose:	Retrive common flags
 *  Startegy:
 *  Parameters:	-
 *  Return:	FBI_flags value
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_GET_FLAGS {
     return pself->FBI_flags;
}


/*--------------------- MSG_FATBITS_SET_PIXEL_SIZE ---------------------
 *  Purpose:	Set pixel size for FatbitsView.
 *		Update Zoom-Trigger
 *  Startegy:
 *  Parameters:	size: New pixel size
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_SET_PIXEL_SIZE {

     if ( size < 2 ) { @send FatbitsZoomOutTrigger::MSG_GEN_SET_NOT_ENABLED(VUM_NOW); }
     		else { @send FatbitsZoomOutTrigger::MSG_GEN_SET_ENABLED(VUM_NOW); }
     if ( size > 14 ) { @send FatbitsZoomInTrigger::MSG_GEN_SET_NOT_ENABLED(VUM_NOW); }
     		else { @send FatbitsZoomInTrigger::MSG_GEN_SET_ENABLED(VUM_NOW); }

     pself->FBI_pixelSize = size;
     @call oself::MSG_FATBITS_RESIZE_AND_REDRAW(FALSE);
}

/*--------------------- MSG_FATBITS_GET_PIXEL_SIZE ---------------------
 *  Purpose:	Return the Fatbits pixel size
 *  Parameters:
 *  Return:	object
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_GET_PIXEL_SIZE {
     return pself->FBI_pixelSize;
}

/*--------------------- MSG_FATBITS_RESIZE_AND_REDRAW ---------------------
 *  Purpose:	Resize Fatbits object and view
 *  Context:	This message is called for a simple redraw as well as
 *	        for a redraw after the size has been changed, e.g. after
 *		a rotate operation.
 *  Startegy:
 	- kill running ants - this is the simplest and saved way to handle ants
 	- get bitmap's size
 	- update FBI_bmFormat (bitmap colors and more informations)
 	  as well as the size information.
 	- if necessary:
 	  re-build shadow bitmaps (copy of the mask and working bmp for drag tools)
 	- send invalidate messages to Fatbits object and it's view
 	- send redraw message
 *  Parameters:	forceRebuild: force to re-build the shadow bitmaps
 *			      pass FALSE only if you are sure that the
 *			      image has not been modified
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_RESIZE_AND_REDRAW {
optr viewObj;
int w, h;

    if ( 0 == pself->FBI_bitmap) return;	/* may occur during start-up */
    viewObj = pself->VCNI_view;

    @call oself::MSG_FATBITS_KILL_ANTS();

    /*
     * update information about the current bitmap
     */
    w = pself->FBI_xSize;
    h = pself->FBI_ySize;
    pself->FBI_bmFormat = BTGetMoreBitmapInfos(global.tempFile, pself->FBI_bitmap,
    			  &pself->FBI_xSize, &pself->FBI_ySize, 0);

    /*
     * if the size has been changed or on request: update shadow bitmaps
     */
    if ( w != pself->FBI_xSize ) forceRebuild = TRUE;
    if ( h != pself->FBI_ySize ) forceRebuild = TRUE;

    if ( forceRebuild ) {
	if ( pself->FBI_maskBmp ) {
	    HugeArrayDestroy(global.tempFile, pself->FBI_maskBmp);
	    pself->FBI_maskBmp = 0;
	}
	if ( pself->FBI_drag.bmp ) {
	    HugeArrayDestroy(global.tempFile, pself->FBI_drag.bmp);
	    pself->FBI_drag.bmp = 0;
	}
	pself->FBI_maskBmp = BTExtractTransparencyMask(global.tempFile, pself->FBI_bitmap, global.tempFile, 0);
	pself->FBI_drag.bmp = BTCreateOffscreenBitmap(global.tempFile, BMF_24BIT, pself->FBI_xSize, pself->FBI_ySize, NULL);
    }


    /*
     * update ourself
     */
    @call oself::MSG_VIS_SET_SIZE(pself->FBI_xSize, pself->FBI_ySize);
    @call oself::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID, VUM_NOW);

    @call viewObj::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID, VUM_NOW);
    @call viewObj::MSG_GEN_VIEW_REDRAW_CONTENT();

}

/*--------------------- MSG_FATBITS_DUPLICATE_AND_USE_BITMAP ---------------------
 *  Purpose:	Duplicate the passed bitmap and use it
 *  Parameters:	void (VMFileHandle vmFile, VMBlockHandle bmpHandle);
 *  Strategy:
 	- destroy currently used bitmap
 	- duplicate the passed bitmap and use it
 	- resize and redraw the fatbist object
 	  this also updates the shadow bitmaps
 	- inform 'imageObject' that the bitmap has been changed
 *  Return:	object
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_DUPLICATE_AND_USE_BITMAP {

    EC( if ( !bmpHandle ) { ProgError("FATBITS_DUPLICATE_BITMAP: invalid bitmap"); return; } )
    EC( if ( !vmFile ) { ProgError("FATBITS_DUPLICATE_BITMAP: invalid vmFile"); return; } )

    if ( !global.tempFile ) return;	/* we are about to shut down - do nothing */

    /*
     * Store new bitmap. MSG_FATBITS_RESIZE_AND_REDRAW does the rest of the job,
     * e.g. update size informatiion, store the mask as monochrome imgae separately
     * or create a 24 bit bitmap for buffering, used by some tools.
     */
    if ( pself->FBI_bitmap ) HugeArrayDestroy(global.tempFile, pself->FBI_bitmap);
    pself->FBI_bitmap = BTCopyBitmap(vmFile, global.tempFile, bmpHandle);

    @call oself::MSG_FATBITS_RESIZE_AND_REDRAW(TRUE);
    pself = ObjDerefVis(oself);

    /*
     * Update live preview
     */
    EC( if ( !pself->FBI_imageObj) { ProgError("Fatbits has no image object (use bitmap)"); return; } )
    @send pself->FBI_imageObj::MSG_OTHER_CONTENT_USE_IMAGE(pself->FBI_bitmap);
}

/*--------------------- MSG_FATBITS_UPDATE_MASK_BMP ---------------------
 *  Purpose:	After some operations (like shifting the image) the
 *		copy of the bitmap's mask needs an update
 *  Parameters:	void ();
 *  Strategy:
 	- destroy currently used copy of the mask
 	- extract the current mask
 *  Return:
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_UPDATE_MASK_BMP {

    if ( pself->FBI_maskBmp ) HugeArrayDestroy(global.tempFile, pself->FBI_maskBmp);
    pself->FBI_maskBmp = BTExtractTransparencyMask(global.tempFile, pself->FBI_bitmap, global.tempFile, 0);

}

/*--------------------- MSG_FATBITS_FREE_BITMAP ---------------------
 *  Purpose:	Free the current bitmap so that the fatbits object will show nothings
 *  Parameters:	void ();
 *  Strategy:
 	- destroy currently used bitmap
 	  we don't destroy the sahdow bitmaps (FBI_maskBmp, FBI_drag.bmp). This is
 	  done when they are re-used.
 	- redraw itself
 	- inform 'imageObject' (live preview) that the bitmap has been changed
 	- clear out FatBitsInfoText
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_FREE_BITMAP {
optr obj;

    if ( pself->FBI_bitmap ) {
     	HugeArrayDestroy(global.tempFile, pself->FBI_bitmap);
     	pself->FBI_bitmap = 0;
     	}

    @call oself::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID, VUM_NOW);

    EC( if ( !pself->FBI_imageObj) { ProgError("Fatbits has no image object (free bitmap)"); return; } )
    @send pself->FBI_imageObj::MSG_OTHER_CONTENT_USE_IMAGE(0);

    obj = ConstructOptr(OptrToHandle(oself),OptrToChunk(@FatBitsInfoText));
    @send obj::MSG_VIS_TEXT_DELETE_ALL();

}
/*--------------------- MSG_FATBITS_GET_BITMAP ---------------------
 *  Purpose:	Return the current bitmap handle
 *  Parameters:	-
 *  Strategy:
 *  Return:	VMBlockHandle of the bitmap (whic is stored on global.tempFile)
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_GET_BITMAP {
    return pself->FBI_bitmap;
}

/*--------------------- MSG_FATBITS_USE_ICON ---------------------
 *  Purpose:	Load all required data from an icon to edit it
 *  Parameters:	void (VMFileHandle vmFile, int iSet, int icon);
 *  Strategy:
 	- find out icon's bitmap and use it
 	- update drawing attributes according to the icon to use
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_USE_ICON {
VMBlockHandle bmp;


    if (iSet == NO_CURRENT_ISET) { return; /* may occur if the database is empty */ }
    if (icon == NO_CURRENT_ICON) { EC( ProgError("MSG_FATBITS_USE_ICON no icon");) return; }

    bmp = IdGetEntryBitmap(vmFile, iSet, icon);
    EC( if (!bmp) { ProgError("MSG_FATBITS_USE_ICON no icon bitmp"); return; } )
    @call oself::MSG_FATBITS_DUPLICATE_AND_USE_BITMAP(vmFile, bmp);

    /*
     * Update colors and draw attributes from icon
     * Verify colors for savety
     */
    IdGetLineOrAreaAttrs(vmFile, iSet, icon, &(pself->FBI_lineAttrs), &(pself->FBI_areaAttrs));
    @call oself::MSG_FATBITS_VERIFY_COLORS();

}

/*--------------------- MSG_FATBITS_SAVE_ICON ---------------------
 *  Purpose:	Copy the changes in the currently editied icon back to the database
 *  Parameters:	void (VMFileHandle vmFile, int iSet, int icon);
 *  Strategy:
 *	- replace the bitmap
 *	- redraw the cuirrent icon
 *	- redraw icon set in dbViewer if required
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_SAVE_ICON {
VMBlockHandle bmp;
optr visISet, dbViewer, visIcon, viewObj;

    /*
     * Replace Bitmap
     * Ensure that all transparent pixels are set to white. This is required
     * for compatibility with the older version of the icon editor.
     */
    bmp =  BTCopyBitmap(global.tempFile, vmFile, pself->FBI_bitmap);
    IconSetHiddenPixelsToWhite(vmFile, bmp);
    IdClearAndSetEntryBitmap(vmFile, iSet, icon, bmp);

    /*
     * There is no need to copy the draw attributes (colors etc.) back
     * to the icon, because they are updated every time when they
     * changes (see MSG_GO_-xxx)
     *     IdSetLineAttrs(vmFile, iSet, icon, &(pself->FBI_lineAttrs));
     *	   IdSetAreaAttrs(vmFile, iSet, icon, &(pself->FBI_areaAttrs));
     */

    /*
     * The VisIcon needs new bounds to draw the bitmap, because there
     * is a new bitmap.
     * Query for the optr of the visIcon and let MSG_VIS_ICON_INITIALIZE do the job.
     */
    visIcon = @call ConstructOptr(OptrToHandle(oself), OptrToChunk(@IconListContent))::MSG_VIS_FIND_CHILD_AT_POSITION(icon);
    @send visIcon::MSG_VIS_ICON_INITIALIZE(icon);

    if ( global.flags & GF_ICON_SIZE_HAS_BEEN_CHANGED) {

	/*
	 * Update icon list to remove artifacts
	 */
	viewObj = CombineOselfWith(@IconListView);
    	@send viewObj::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID, VUM_NOW);
    	@send viewObj::MSG_GEN_VIEW_REDRAW_CONTENT();

	global.flags &= ~GF_ICON_SIZE_HAS_BEEN_CHANGED;
    }

    /*
     *  If the saved icon was the first one, the current VisISet also needs
     *  new bounds that fits to the new bitmap.
     */
    dbViewer = ConstructOptr(OptrToHandle(oself), ChunkOf(@DBViewerContent));
    if (icon == 0) {
        /*
         * Query the database viewer for the optr of the icon set. And let
         * MSG_VIS_ISET_INITIALIZE do the job. Then redraw the database viewer.
         */
    	visISet = @call dbViewer::MSG_VIS_FIND_CHILD_AT_POSITION(iSet);
    	@send visISet::MSG_VIS_ISET_INITIALIZE(iSet);
    	@send dbViewer::MSG_VIS_INVALIDATE();
    }


    /*
     * Update all non-modal dialogs, if they are open
     */
    @send dbViewer::MSG_DB_VIEWER_UPDATE_DIALOGS();
}


/*--------------------- MSG_VIS_DRAW ---------------------
 *  Purpose:
 *	Draw method for FatbitsClass.
 *  Context:
 *  Strategy:
 	- set scale factor to pixelSize
 	- Draw bitmap scaled
 	- Draw grid, if appropriate
 	- Draw selection frame, if appropriate
 *  Parameters:	void (DrawFlags drawFlags, GStateHandle gstate);
 *  Return:
 ---------------------------------------------------------------------------*/
// stop in FatbitsVIS_DRAW
@method FatbitsClass, MSG_VIS_DRAW {
int width, height, grid;

    if ( !pself->FBI_bitmap) return;
    /*
     * draw bitmap scaled with FBI_pixelSize
     * if global.useBackgroundPattern is set, draw background pattern
     */
    BTGetMoreBitmapInfos(global.tempFile, pself->FBI_bitmap, &width, &height, 0);
    grid = pself->FBI_pixelSize;
    width *= grid;
    height *= grid;

@if @ENABLE_BACKGROUND_PATTERN
    if (global.useBackgroundPattern) {
	GrSaveState(gstate);
	GrSetAreaMaskSys(gstate, 17);
	GrSetAreaColor(gstate, CF_INDEX, 23, 0, 0 );
	GrFillRect(gstate, 0, 0, width, height);
	GrRestoreState(gstate);
    }
@endif


    GrSaveState(gstate);
    GrApplyScale(gstate, MakeWWFixed(grid), MakeWWFixed(grid) );
    if (pself->FBI_currentTool == BTF_EDIT_MASK) {
    	GrDrawHugeBitmap(gstate, 0, 0, global.tempFile, pself->FBI_maskBmp);
    } else {
    	GrDrawHugeBitmap(gstate, 0, 0, global.tempFile, pself->FBI_bitmap);
    }
    GrRestoreState(gstate);

    FatbitsDrawGrid(gstate, pself->FBI_currentTool, grid, width, height);

    /*
     * If a selection frame is active, we must restore it
     */
    if ( pself->FBI_ants.antState != ANT_STATE_NO_ANTS ) {
        GrSaveState(gstate);
        @call oself::MSG_FATBITS_DRAW_ANTS_OR_OUTLINE_INTERNAL(pself->FBI_ants.antState, FALSE, gstate);
        @call oself::MSG_FATBITS_DRAW_ANTS_OR_OUTLINE_INTERNAL(LS_SOLID, TRUE, gstate);
        GrRestoreState(gstate);
    }

    /*
     * if we are in "edit-pointer-image" mode, we must draw the hotspot
     */
    if ( @call oself::MSG_FATBITS_TEST_IF_PTR_IMAGE() ) {
    	int xHot, yHot, iSet, icon, opt;
    	optr dbViewer;
    	VMFileHandle	vmFile;

	opt = @call PointerImageShowHotspotChooser::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();
	if ( opt & PIO_SHOW_HOTSPOT ) {
	    dbViewer = CombineOselfWith(@DBViewerContent);
	    vmFile = @call dbViewer::MSG_DB_VIEWER_GET_DATABASE();
	    iSet = @call dbViewer::MSG_DB_VIEWER_GET_CURRENT_ISET();
	    icon = @call dbViewer::MSG_DB_VIEWER_GET_CURRENT_ICON();
    	    IdGetHotspot(vmFile, iSet, icon, &xHot, &yHot);

    	    GrSaveState(gstate);
	    GrSetAreaColor(gstate, CF_INDEX, C_LIGHT_RED, 0, 0 );
	    GrFillRect(gstate, xHot*grid, yHot*grid, (xHot+1)*grid, (yHot+1)*grid);
    	    GrRestoreState(gstate);
    	}
    }
}

/*--------------------- FatbitsDrawGrid ---------------------
 *  Purpose:	Draw the grid for fatbits object
 *  Strategy:
 *	- see code
 *  Return:	-
 ---------------------------------------------------------------------------*/
void FatbitsDrawGrid(GStateHandle gstate, int curTool, int grid, int width, int height) {
int x, y;

    /*
     * draw grid only if the FBI_pixelSize is not too small
     */
    if ( grid < 3 ) return;

    GrSaveState(gstate);
    /*
     * If the mask bitmap is shown, draw all grid lines inverse (or light gray) and then return.
     */
    if (curTool == BTF_EDIT_MASK) {
    	GrSaveState(gstate);
	GrSetLineColor(gstate, CF_INDEX, C_LIGHT_GRAY, 0, 0);

	for (x = grid; x < width; x += grid) GrDrawVLine(gstate, x, 0, height);
	for (y = grid; y < height; y += grid) GrDrawHLine(gstate, 0, y, width);

	GrRestoreState(gstate);
	return;
   }

    GrSetLineColor(gstate, CF_INDEX, C_DARK_GRAY, 0, 0);
    for (x = grid; x < width; x += grid) GrDrawVLine(gstate, x, 0, height);
    for (y = grid; y < height; y += grid) GrDrawHLine(gstate, 0, y, width);

    /*
     * draw every 5th grid line in black or mark it with an extra dotted black line
     */
    GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
    grid *= 5;
    if ( grid < 7*5 ) {
    	// too small for an extra dotted line, draw grid lines in black
	for (x = grid; x < width; x += grid) GrDrawVLine(gstate, x, 0, height);
	for (y = grid; y < height; y += grid) GrDrawHLine(gstate, 0, y, width);

    } else {
    	// mark grid lines with an extra dotted line
    	// Strange, LineMaskSys does not seem to be saved by GrSaveState.
	GrSetLineMaskSys(gstate, SDM_50);
	for (x = grid+1; x < width; x += grid) GrDrawVLine(gstate, x, 0, height);
	for (y = grid+1; y < height; y += grid) GrDrawHLine(gstate, 0, y, width);
	GrSetLineMaskSys(gstate, SDM_100);
    }

    GrRestoreState(gstate);
}

/*--------------------- FatbitsSendNotificationLow ---------------------
 *  Purpose:	Send a pre-allocated data block to the controllers via GCN list
 *  Return:	-
 ---------------------------------------------------------------------------*/
void FatbitsSendNotificationLow(int listType, int notificationType, MemHandle dataBlock) {
EventHandle	notifyEvent;

    /* Record the event with notificationType to send it to:
     * MANUFACTURER_ID_GEOWORKS::listType
     * Then send it
     */
    notifyEvent = @record null::MSG_META_NOTIFY_WITH_DATA_BLOCK(
		   MANUFACTURER_ID_GEOWORKS, notificationType, dataBlock);

    @call application::MSG_META_GCN_LIST_SEND(
		GCNLSF_SET_STATUS, notifyEvent, dataBlock,
		listType,  MANUFACTURER_ID_GEOWORKS);
}

/*--------------------- FatbitsCreateLineAttrNotifyBlock ---------------------
 *  Purpose:	As the name says
 *  Startegy
 *	- Allocate a memory block with HAF_ZERO_INIT
 *	- Only set really needed members of the big structure
 *	- initializte reference count
 *  Return:	Handle of the initialized and unlocked data block
 ---------------------------------------------------------------------------*/
MemHandle FatbitsCreateLineAttrNotifyBlock(IconLineAttrs lineAttrs) {
GrObjNotifyLineAttrChange *nlacPtr;
MemHandle	dataBlock;

    dataBlock = MemAlloc(sizeof(GrObjNotifyLineAttrChange),
		    HF_DYNAMIC | HF_SHARABLE, HAF_STANDARD_NO_ERR | HAF_ZERO_INIT);
    nlacPtr = (GrObjNotifyLineAttrChange *)MemLock(dataBlock);

    nlacPtr->GNLAC_lineAttr.GOBLAE_style = lineAttrs.lineStyle;
    nlacPtr->GNLAC_lineAttr.GOBLAE_width = lineAttrs.lineWidth;
    nlacPtr->GNLAC_lineAttr.GOBLAE_mask = lineAttrs.lineDrawMask;
    nlacPtr->GNLAC_lineAttr.GOBLAE_drawMode = lineAttrs.lineMixMode;	/* changing lineMixMode not yet implemented */
    nlacPtr->GNLAC_lineAttr.GOBLAE_r = lineAttrs.lineColor.rt;
    nlacPtr->GNLAC_lineAttr.GOBLAE_g = lineAttrs.lineColor.gn;
    nlacPtr->GNLAC_lineAttr.GOBLAE_b = lineAttrs.lineColor.bl;

    /* In order to use the block as a data block for a notification,
     * it must be unlocked and its reference count must be 1.
     * For details on why, see the Clipsamp example.
     */
    MemUnlock(dataBlock);
    MemInitRefCount(dataBlock, 1);

    return dataBlock;
}

/*--------------------- FatbitsCreateAreaAttrNotifyBlock ---------------------
 *  Purpose:	As the name says
 *  Startegy
 *	- Allocate a memory block with HAF_ZERO_INIT
 *	- Only set really needed members of the big structure
 *	- initializte reference count
 *  Return:	Handle of the initialized and unlocked data block
 ---------------------------------------------------------------------------*/
MemHandle FatbitsCreateAreaAttrNotifyBlock(IconAreaAttrs areaAttrs) {
GrObjNotifyAreaAttrChange *naacPtr;
MemHandle	dataBlock;

    dataBlock = MemAlloc(sizeof(GrObjNotifyAreaAttrChange),
		    HF_DYNAMIC | HF_SHARABLE, HAF_STANDARD_NO_ERR | HAF_ZERO_INIT);
    naacPtr = (GrObjNotifyAreaAttrChange *)MemLock(dataBlock);

    naacPtr->GNAAC_areaAttr.GOBAAE_mask = areaAttrs.areaDrawMask;
    naacPtr->GNAAC_areaAttr.GOBAAE_drawMode = areaAttrs.areaMixMode;
    naacPtr->GNAAC_areaAttr.GOBAEE_pattern = areaAttrs.areaPattern;
    naacPtr->GNAAC_areaAttr.GOBAAE_r = areaAttrs.areaColor.rt;
    naacPtr->GNAAC_areaAttr.GOBAAE_g = areaAttrs.areaColor.gn;
    naacPtr->GNAAC_areaAttr.GOBAAE_b = areaAttrs.areaColor.bl;


    /* In order to use the block as a data block for a notification,
     * it must be unlocked and its reference count must be 1.
     * For details on why, see the Clipsamp example.
     */
    MemUnlock(dataBlock);
    MemInitRefCount(dataBlock, 1);

    return dataBlock;
}

/*--------------------- MSG_FATBITS_SEND_NOTIFICATIONS ---------------------
 *  Purpose:	Send out all controller notifications to hold them up to date
 *  Context:
 *  Strategy:
 *  Parameters:	word sendFlags	which notifiocatins to send
 *				required to handle CustomColorsDialog correctly
 *				and speed up things
 *  Return:
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_SEND_NOTIFICATIONS {
MemHandle	dataBlock;
int listType, notificationType;
int index;

    /*
     * Area Attributes
     */
    if ( sendFlags & SEND_AREA_NOTIFICATIONS ) {
	listType = GAGCNLT_APP_TARGET_NOTIFY_GROBJ_AREA_ATTR_CHANGE;
	notificationType = GWNT_GROBJ_AREA_ATTR_CHANGE;

	dataBlock = FatbitsCreateAreaAttrNotifyBlock(pself->FBI_areaAttrs);
	FatbitsSendNotificationLow(listType, notificationType, dataBlock);

	/*
	* AreaColor Index (dialog and tool) as well as the CustomColorDialog requires
	* extra handling because they are not part of the controller
	*/
	index = PaletteFindIndex(pself->FBI_areaAttrs.areaColor.rt,
				pself->FBI_areaAttrs.areaColor.gn,
				pself->FBI_areaAttrs.areaColor.bl,
				((pself->FBI_bmFormat & BMT_FORMAT) == BMF_8BIT ) ? 256 : 16 );
	@send AreaColorIndexGroup::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(index, FALSE);
	@send AreaColorToolIndexGroup::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(index, FALSE);

	UpdateCustomColorDialogColor(pself->FBI_areaAttrs.areaColor.rt,
				pself->FBI_areaAttrs.areaColor.gn,
				pself->FBI_areaAttrs.areaColor.bl, TRUE);
    }

    /*
     * Line Attributes
     */
    if ( sendFlags & SEND_LINE_NOTIFICATIONS ) {
	listType = GAGCNLT_APP_TARGET_NOTIFY_GROBJ_LINE_ATTR_CHANGE;
	notificationType = GWNT_GROBJ_LINE_ATTR_CHANGE;

	dataBlock = FatbitsCreateLineAttrNotifyBlock(pself->FBI_lineAttrs);
	FatbitsSendNotificationLow(listType, notificationType, dataBlock);

	/*
	* Line Color Index (dialog and tool) as well as the CustomColorDialog requires
	*  extra handling because they are not part of the controller
	*/
	index = PaletteFindIndex(pself->FBI_lineAttrs.lineColor.rt,
				pself->FBI_lineAttrs.lineColor.gn,
				pself->FBI_lineAttrs.lineColor.bl,
				((pself->FBI_bmFormat & BMT_FORMAT) == BMF_8BIT ) ? 256 : 16 );
	@send LineColorIndexGroup::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(index, FALSE);
	@send LineColorToolIndexGroup::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(index, FALSE);

	UpdateCustomColorDialogColor(pself->FBI_lineAttrs.lineColor.rt,
				pself->FBI_lineAttrs.lineColor.gn,
				pself->FBI_lineAttrs.lineColor.bl, FALSE);
    }

    /*
     * Update bitmap Tools (dialog box and too bar)
     */
    if ( sendFlags & SEND_BMPTOOLS_NOTIFICATIONS ) {
	@send IconBitmapToolControl::MSG_TOC_SELECT_BITMAP_TOOL(pself->FBI_currentTool, 0, 0);
    }
}

/*--------------------- MSG_GO_SET_LINE_WIDTH ---------------------
 *  Purpose:
