/*--------------------- MSG_FATBITS_VERIFY_COLORS ---------------------
 *  Purpose:	Verify that the currently selected line color and area color
 *		are compatible with the image we are currently editing.
 *  Strategy:
 *	- check line color and area color separately
 *	  * if not compatibele replace it by a comaptible color
 *	  * do not display any message to the user
 *  Parameters:	(none)
 *  Return:
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_VERIFY_COLORS {
Boolean ok;
PaletteEntry newColor;

    /*
     * We have to check line color as well as area color separately
     */
    ok = FatbitsVerifyColor(pself->FBI_bmFormat, pself->FBI_lineAttrs.lineColor, &newColor);
    if (!ok) {
    	pself->FBI_lineAttrs.lineColor = newColor;
    }
    ok = FatbitsVerifyColor(pself->FBI_bmFormat, pself->FBI_areaAttrs.areaColor, &newColor);
    if (!ok) {
    	pself->FBI_areaAttrs.areaColor = newColor;
    }

}

/*--------------------- FatbitsVerifyColor ---------------------
 *  Purpose:	Check if the passed color is compatible with the
 *		image we are currently editing.
 *  Strategy:
 *	- true color images accept any color
 *	- monochrome images only accept black and white
 *	- for 4 bit or 8 bit images, : check the palette (this may be the standard palette)
 *	  - if color was found in the palette: OK
 *	  - if not: find out the "nearest" color from the palette
 *  Parameters:	format: color depth. BMType value (with BMT_PALETTE set, e.g.) is ok.
 *		color   color to check
 *		newColor: the most similar color if not comaptible
 *  Return:	TRUE  	if color is comaptible
 *		FALSE 	if not
 ---------------------------------------------------------------------------*/
Boolean FatbitsVerifyColor(int format, PaletteEntry color, PaletteEntry *newColor) {
WWFixedAsDWord	gray;
int val, idx;
PaletteEntry	* palette;


    format &= BMT_FORMAT;	/* mask color depth */
    *newColor = color;		/* always return a valid color */

    switch (format) {

    case BMF_24BIT: return TRUE;	/* If we have a true color image, we are always ok */

    case BMF_MONO:
    	if ( (color.rt == 0) && (color.gn == 0) && (color.bl == 0) ) return TRUE;
    	if ( (color.rt == 0xFF) && (color.gn == 0xFF) && (color.bl == 0xFF) ) return TRUE;

    	/* calculate gray value */
     	gray = GrMulWWFixed( MakeWWFixed(0.299), MakeWWFixed(color.rt) )
		+ GrMulWWFixed( MakeWWFixed(0.587), MakeWWFixed(color.gn)  )
		+ GrMulWWFixed( MakeWWFixed(0.114), MakeWWFixed(color.bl)  );

	/* compare with middle gray and set newColor to black or white */
	if ( ((gray+0x8000) >> 16) > 128 ) { val = 0xFF; } else { val = 0; }
	memset(newColor, val, sizeof(PaletteEntry));
	return FALSE;


    case BMF_4BIT: val = 16; break;	/* number of colors */
    default: val = 256; break;
    }

    /*
     * Search for color in the current palette (this may be the standard palette).
     */
    idx = PaletteFindIndex(color.rt, color.gn, color.bl, val);
    if ( idx >= 0 ) return TRUE;


    /*
     * The color is not in the palette. Find a similar color.
     * IconLockGlobalPalette() locks the bitmaps individual palette, if
     * we have one, or the GEOSStandardPalette, if not
     */
    palette = IconLockGlobalPalette();
    idx = BTApproxRGBPaletteLinear(palette, color, val);
    IconUnlockGlobalPalette();

    *newColor = PaletteGetColorFromIndex(idx);

    return FALSE;
}




/*--------------------- MSG_FATBITS_LINE_EXTRA_APP_UI_STATUS_MSG ---------------------
 *  Purpose:	Update controller UI and CustomColorsDialog UI when a new
 *		colors has been selected in LineColorIndexGroup´
 *		LineColorIndexGroup is added to the IconLineColorSelector
 *		with ATTR_GEN_CONTROL_APP_UI
 *  Strategy:
 *	- read current line attrs from fatbits object and replace line color
 *	- create a GCN message to update the controller.
 *	  This holds tool UI and dialog UI of the controller consistent
 *	- The CustomColorsDialog is not part of the controller, so it
 *	  must be informed separately
 *  Parameters:	(GEN_ITEM_GROUP_STATUS_MSG)
    	    	    	    	    word selection = cx,
				    word numSelections = bp,
				    GenItemGroupStateFlags stateFlags = dl);

 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_LINE_EXTRA_APP_UI_STATUS_MSG {
IconLineAttrs lineAttrs;
PaletteEntry color;
MemHandle mh;

    @call oself::MSG_FATBITS_GET_ATTRS(&lineAttrs, NULL);
    color = PaletteGetColorFromIndex(selection);
    lineAttrs.lineColor = color;

    mh = FatbitsCreateLineAttrNotifyBlock(lineAttrs);
    @send IconLineColorSelector::MSG_META_NOTIFY_WITH_DATA_BLOCK(
		   MANUFACTURER_ID_GEOWORKS, GWNT_GROBJ_LINE_ATTR_CHANGE, mh);

    UpdateCustomColorDialogColor(color.rt, color.gn, color.bl, FALSE); // FALSE == line color changed)

}

/*--------------------- MSG_FATBITS_AREA_EXTRA_APP_UI_STATUS_MSG ---------------------
 *  Purpose:	Update controller UI and CustomColorsDialog UI when a new
 *		colors has been selected in AreaColorIndexGroup´
 *		AreaColorIndexGroup is added to the IconAreaColorSelector
 *		with ATTR_GEN_CONTROL_APP_UI
 *  Strategy:
 *	- read current area attrs from fatbits object and replace area color
 *	- create a GCN message to update the controller.
 *	  This holds tool UI and dialog UI of the controller consistent
 *	- The CustomColorsDialog is not part of the controller, so it
 *	  must be informed separately
 *  Parameters:	(GEN_ITEM_GROUP_STATUS_MSG)
    	    	    	    	    word selection = cx,
				    word numSelections = bp,
				    GenItemGroupStateFlags stateFlags = dl);

 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_AREA_EXTRA_APP_UI_STATUS_MSG {
IconAreaAttrs areaAttrs;
PaletteEntry color;
MemHandle mh;

    @call oself::MSG_FATBITS_GET_ATTRS(NULL, &areaAttrs);
    color = PaletteGetColorFromIndex(selection);
    areaAttrs.areaColor = color;

    mh = FatbitsCreateAreaAttrNotifyBlock(areaAttrs);
    @send IconAreaColorSelector::MSG_META_NOTIFY_WITH_DATA_BLOCK(
		   MANUFACTURER_ID_GEOWORKS, GWNT_GROBJ_AREA_ATTR_CHANGE, mh);

    UpdateCustomColorDialogColor(color.rt, color.gn, color.bl, TRUE); // TRUE == area color changed

}


/*--------------------- MSG_FATBITS_WRITE_DRAW_ATTRS_TO_ICON ---------------------
 *  Purpose:	Write line~ and area attributes to current icon
 *  Strategy:
 *	- get database object
 *	- fetch current iSet and icon
 *	- copy draw attrs to the icon
 *  Parameters:	-
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_WRITE_DRAW_ATTRS_TO_ICON {
optr dbViewerObj;
VMFileHandle vmFile;
int iSet, icon;

    dbViewerObj = ConstructOptr(OptrToHandle(oself), OptrToChunk(@DBViewerContent));
    vmFile = @call dbViewerObj::MSG_DB_VIEWER_GET_DATABASE();

    iSet = @call dbViewerObj::MSG_DB_VIEWER_GET_CURRENT_ISET();
    if (iSet == NO_CURRENT_ISET) return;

    icon = @call dbViewerObj::MSG_DB_VIEWER_GET_CURRENT_ICON();
    if (icon == NO_CURRENT_ICON) return;

    IdSetLineAttrs(vmFile, iSet, icon, &(pself->FBI_lineAttrs));
    IdSetAreaAttrs(vmFile, iSet, icon, &(pself->FBI_areaAttrs));
}




/*--------------------- MSG_FATBITS_TRANSFORM_ICON ---------------------
 *  Purpose:	Do some simple transformation operations with the edited bitmap
 *  Context:
 *  Strategy:
 *  Parameters:	void  (int operation);
 *  Return:
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_TRANSFORM_ICON {
VMBlockHandle bmpBlock, newBmp = 0;
VMFileHandle  vmFile;
optr dbViewerObj;


    bmpBlock = pself->FBI_bitmap;
    if (!bmpBlock) return;

    vmFile = global.tempFile;
    if (!vmFile) return;

    /*
     * Perform operation. Save current state first (for undo)
     */
    AppMarkBusy();

    switch (operation) {
    case ITT_FLIP_HORIZONTALLY:
    	@call oself::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_FLIP);
	newBmp = BTFlipBitmapH(vmFile, bmpBlock, vmFile, 0);
    	break;
    case ITT_FLIP_VERTICALLY:
    	@call oself::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_FLIP);
	newBmp = BTFlipBitmapV(vmFile, bmpBlock, vmFile, 0);
    	break;
    case ITT_ROTATE_90:
    	@call oself::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_ROTATE);
    	newBmp = BTRotateBitmap90(vmFile, bmpBlock, vmFile, 0);
    	break;
    case ITT_ROTATE_180:
    	@call oself::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_ROTATE);
    	newBmp = BTRotateBitmap180(vmFile, bmpBlock, vmFile, 0);
    	break;
    case ITT_ROTATE_270:
    	@call oself::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_ROTATE);
    	newBmp = BTRotateBitmap270(vmFile, bmpBlock, vmFile, 0);
        break;
    }

    if ( newBmp ) {
	/*
	 * Set new Bitmap. Mark icon as dirty
	 */
	pself->FBI_bitmap = newBmp;
        dbViewerObj = ConstructOptr(OptrToHandle(oself), OptrToChunk(@DBViewerContent) );
    	@call dbViewerObj::MSG_DB_VIEWER_MARK_ICON_DIRTY();

	/*
	 * Resize and redraw fatbits as well as live preview.
	 * Then free old bitmap
	 */
	@call oself::MSG_FATBITS_RESIZE_AND_REDRAW(TRUE);
	pself = ObjDerefVis(oself);
	@send pself->FBI_imageObj::MSG_OTHER_CONTENT_USE_IMAGE(pself->FBI_bitmap);
	HugeArrayDestroy(vmFile, bmpBlock);
    }

    AppMarkNotBusy();

}

/*--------------------- MSG_FATBITS_GET_PIXEL_COLOR ---------------------
 *  Purpose:
 *  Context:
 *  Strategy:
 *  Parameters:	x, y:	Coordinates
 *		index:	return: color index for index color bitmaps
 *			if no index available, return -1 here
 *  Return:	Color of the pixel as PaletteEntry
 *		In case of error : black
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_FATBITS_GET_PIXEL_COLOR {
VMBlockHandle bmpBlock;
VMFileHandle  vmFile;
int format, width, height, size, b, idx;
PaletteEntry color = { 0, 0, 0 };
PaletteEntry white = { 0xFF, 0xFF, 0xFF };
PaletteEntry *palette, *rgbPtr;
byte *linePtr, *dataPtr;

    /*
     * buffer data and do error checks
     */
    bmpBlock = pself->FBI_bitmap;
    if (!bmpBlock) return color;
    vmFile = global.tempFile;
    if (!vmFile) return color;

    /*
     * lock palette and correct pixel line
     * Skip mask bytes, itf we have it
     * to keep things simple, the palette is lockend even if the bitmap has no palette
     */
    format = BTGetMoreBitmapInfos(vmFile, bmpBlock, &width, &height, 0);
    if ( (x >= width) || (y>=height) ) return color;
    palette = IconLockGlobalPalette();
    HugeArrayLock(vmFile, bmpBlock, y, (void**)&linePtr, (word*)&size);
    if (format & BMT_MASK) { dataPtr = linePtr + (width+7)/8; }
    		      else { dataPtr = linePtr; }

    /*
     * Read pixel. return default index '-1' - no index available
     */
    if ( index ) *index = -1;

    switch (format & BMT_FORMAT) {
    case BMF_MONO:
	dataPtr += x/8;
	b = *dataPtr;
	if ( ( b & (0x80 >> (x & 0x07)) ) == 0 ) color = white;
	/* default is black */
    	break;
    case BMF_4BIT:
    	b = dataPtr[x/2];
    	if ( x & 1 ) { idx = b & 0x0F; }
    		else { idx = (b & 0xF0) >> 4; }
        color = palette[idx];
    	if ( index ) *index = idx;
    	break;
    case BMF_8BIT:
    	idx = dataPtr[x];
    	color = palette[idx];
    	if ( index ) *index = idx;
    	break;
    case BMF_24BIT:
    	rgbPtr = (PaletteEntry*)dataPtr;
    	color = rgbPtr[x];
    	break;
    }

    /*
     * unlock things and return
     */
    IconUnlockGlobalPalette();
    HugeArrayUnlock(linePtr);

    return color;
}


