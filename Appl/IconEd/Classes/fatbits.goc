/*-----------------------------------------------------------------------------
 *
 *  MousePtrViewClass
 *
 ---------------------------------------------------------------------------*/
@classdecl MousePtrViewClass;



/*--------------------- MSG_MOUSE_PTR_VIEW_ENTER ---------------------
 *  Purpose:	The mouse pointer enters the view area
 *  Context:
 *  Strategy:
 	- set proper pointer image
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method MousePtrViewClass, MSG_MOUSE_PTR_VIEW_ENTER {
int tool, size;
optr fatbitsObj;

    @callsuper();
    switch (pself->MPVI_contentType) {
    case MPV_CONTENT_FATBITS:
    	/*
    	 * The pointer image depends on the current tool
	 */
	fatbitsObj = ConstructOptr(OptrToHandle(oself), OptrToChunk(@MyFatbits));
	tool = @call fatbitsObj::MSG_FATBITS_GET_BITMAP_TOOL();

	switch (tool) {
	case BTF_SELECTION:
	    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@SelectionPointer, PIL_WINDOW);
	    break;
	case BTF_ERASER:
	    size = @call FatbitImageSizeGroup::MSG_GEN_ITEM_GROUP_GET_SELECTION();
	    if ( size < 5 ) {
	        @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@EraserSmallPointer, PIL_WINDOW);
	    } else {
	        @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@EraserPointer, PIL_WINDOW);
	    }
	    break;
	case BTF_FILL_MASK:
	    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@FillMaskPointer, PIL_WINDOW);
	break;
	case BTF_FLOOD_FILL:
	    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@FloodFillPointer, PIL_WINDOW);
	    break;
	case BTF_PICK_COLOR:
	    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@PipettePointer, PIL_WINDOW);
	    break;
	default:
@if @DEFAULT_EDIT_MOUSE_POINTER_IS_STANDARD_POINTER
	    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(0, PIL_WINDOW);
@elseif
	    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@StandardPointer, PIL_WINDOW);
@endif
	}
    break;

    case MPV_CONTENT_CROP_IMAGE:
    	@call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(@SelectionPointer, PIL_WINDOW);
    break;

    case MPV_CONTENT_POINTER_PREVIEW:
    	@call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(pself->MPVI_ptrOp, PIL_WINDOW);
    break;

    }
}

/*--------------------- MSG_MOUSE_PTR_VIEW_LEAVE ---------------------
 *  Purpose:	The mouse pointer is leaving the view area
 *  Context:
 *  Strategy:
 	- clear mouse pointer position text
 	- reset pointer image
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method MousePtrViewClass, MSG_MOUSE_PTR_VIEW_LEAVE {
optr obj;

    @callsuper();
    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(0, PIL_WINDOW);

    switch (pself->MPVI_contentType) {

    case MPV_CONTENT_FATBITS:
    	obj = ConstructOptr(OptrToHandle(oself), OptrToChunk(@FatBitsMouseText));
    	@call obj::MSG_VIS_TEXT_DELETE_ALL();
    	break;

    case MPV_CONTENT_CROP_IMAGE:
        @call CropImageMouseText::MSG_VIS_TEXT_DELETE_ALL();
    	break;

    case MPV_CONTENT_POINTER_PREVIEW:
    	break;
   }

}

/*--------------------- MSG_MPV_UPDATE_POINTER_IMAGE ---------------------
 *  Purpose:	Update pointer image for MPV_CONTENT_POINTER_PREVIEW mode
 *  Context:
 *  Strategy:	- free old pointer memory (if we have one)
 *		- assing new pointer
 *  Parameters:	ptrImg	new pointer image
 *			may be zero to clear pointer image
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method MousePtrViewClass,  MSG_MPV_UPDATE_POINTER_IMAGE {

    if (pself->MPVI_ptrOp) {
    	@call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(0, PIL_WINDOW);
    	MemFree(OptrToHandle(pself->MPVI_ptrOp));
    }
    pself->MPVI_ptrOp = ptrImg;
    @call oself::MSG_GEN_VIEW_SET_PTR_IMAGE(ptrImg, PIL_WINDOW);

}


