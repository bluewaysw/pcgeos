/*--------------------- MSG_GO_SET_LINE_COLOR ---------------------
 *  Purpose:
 *  Strategy:
 *	- store passed data
 *	- check, if new color is compatible. If not, replace it
 *	- send notifications to update all controllers
 *	- update working gstate
 *  Parameters:	void (byte red = cl, byte green = ch, byte blue = dl);
 *  Return:
 ---------------------------------------------------------------------------*/
@method FatbitsClass, MSG_GO_SET_LINE_COLOR {
Boolean ok;
PaletteEntry newColor;

    pself->FBI_lineAttrs.lineColor.rt = red;
    pself->FBI_lineAttrs.lineColor.gn = green;
    pself->FBI_lineAttrs.lineColor.bl = blue;

    ok = FatbitsVerifyColor(pself->FBI_bmFormat, pself->FBI_lineAttrs.lineColor, &newColor);
    if ( !ok ) {
    	@send ReplacedOldColorContent::MSG_OTHER_CONTENT_SET_COLOR(red, green, blue);
    	@send ReplacedNewColorContent::MSG_OTHER_CONTENT_SET_COLOR(newColor.rt, newColor.gn, newColor.bl);
	UserDoDialog(@ReplacedColorDialog);
	pself->FBI_lineAttrs.lineColor = newColor;
    }

    @send oself::MSG_FATBITS_SEND_NOTIFICATIONS(SEND_LINE_NOTIFICATIONS);
    @send oself::MSG_FATBITS_WRITE_DRAW_ATTRS_TO_ICON();
}

