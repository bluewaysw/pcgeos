#ifndef _LMACROS_GOH
#define _LMACROS_GOH

/*------------------------------------------------------------------------------
 *	Diverse hilfreiche Macros
 ---------------------------------------------------------------------------*/

#define HLine(gs, x0, y0, len)	GrDrawLine(gs, x0, y0, x0+len, y0)
#define VLine(gs, x0, y0, len)	GrDrawLine(gs, x0, y0, x0, y0+len)

#define RoundWWF(wwf)	( (int) ( (wwf+0x8000) >> 16 ))

#define min(a,b)	( ((a) < (b)) ?  (a) : (b) )
#define max(a,b)	( ((a) > (b)) ?  (a) : (b) )

#define diff(a, b) ( (a>b) ? (a-b) : (b-a) )
	/*
	 * diff2() ist DEUTLICH schneller als diff() (Byte: 2,5x, Integer 1,5x)
	 */
#define diff2(d, a, b ) \
	d = (a) - (b); \
	if ( d < 0 ) d = -d;

#define diff2Plus(d, a, b ) \
	if ( (a) > (b)) { d += (a) - (b); } else { d += (b) - (a); }


/*---------------------------------------------------------------------------
 MessageBoxen
 ---------------------------------------------------------------------------*/
#ifndef MessageBox
#define MessageBox(txt) { \
		UserStandardDialog ( (char *)0,(char *)0,(char *)0,(char *)0,txt, \
		(( CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) ); \
		 }
#endif

#ifndef MessageBoxOptr
#define MessageBoxOptr(txt)  \
		UserStandardDialogOptr( (char *)0,(void *)0, 0, 0,txt, \
		(( CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) );
#endif

#ifndef MessageBoxOptrString
#define MessageBoxOptrString(txt, param)  { \
		MemLock(OptrToHandle(txt)); \
		UserStandardDialog( (char *)0,(void *)0, 0, param, (char*)LMemDeref(txt), \
		(( CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) ); \
		MemUnlock(OptrToHandle(txt)); }

#endif

#ifndef ErrorBoxOptr
#define ErrorBoxOptr(txt)  \
		UserStandardDialogOptr( (char *)0,(void *)0, 0, 0,txt, \
		(( CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) );
#endif

#ifndef ErrorBoxOptrString
#define ErrorBoxOptrString(txt, param)  { \
		MemLock(OptrToHandle(txt)); \
		UserStandardDialog( (char *)0,(void *)0, 0, param, (char*)LMemDeref(txt), \
		(( CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) ); \
		MemUnlock(OptrToHandle(txt)); }

#endif

#ifndef WarningBoxOptr
#define WarningBoxOptr(txt)  \
		UserStandardDialogOptr( (char *)0,(void *)0, 0, 0,txt, \
		(( CDT_WARNING << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) );
#endif


#ifndef QuestionBox
#define QuestionBox(txt)  \
		UserStandardDialog ( (char *)0,(char *)0,(char *)0,(char *)0,txt, \
		(( CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET)) );
#endif

#ifndef QuestionBoxOptr
#define QuestionBoxOptr(txt)  \
		UserStandardDialogOptr( (char *)0,(void *)0, 0, 0,txt, \
		(( CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET)) );
#endif

#ifndef MessageNumberBox
#define  MessageNumberBox(number) { \
		char txt[20]; \
		LocalFixedToAscii(txt,MakeWWFixed(number),0); \
		UserStandardDialog ( (char *)0,(char *)0,(char *)0,(char *)0,txt, \
		(( CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) ); \
		 }
#endif

#ifndef MessageDWordBox
#define  MessageDWordBox(number) { \
		char txt[20]; \
		UtilHex32ToAscii(txt,number,UHTAF_NULL_TERMINATE); \
		UserStandardDialog ( (char *)0,(char *)0,(char *)0,(char *)0,txt, \
		(( CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) ); \
		 }
#endif


#ifndef InfoBox
/* Use InfoBox("Onkel \02 ist \01 Jahre alt.", 49, "Willi" ); */
#define  InfoBox(text, number, str) { \
		char zahl[20]; \
		UtilHex32ToAscii(zahl,number,UHTAF_NULL_TERMINATE); \
		UserStandardDialog ( (char *)0,(char *)0, str, zahl, text, \
		(( CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)) ); \
		 }
#endif

#ifndef ProgError			/* Serious programming error, not only a debug message */
#define ProgError(txt)	MessageBox(txt)
#endif


#endif	/* _LMACROS_GOH */

