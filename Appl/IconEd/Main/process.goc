/*********************************************************************************
 *
 *      Create or open a temporary file.
 *	This file holds the images edited by FatbitsClass.
 *
 *********************************************************************************/


/*--------------------- ToolCreateTempFile ---------------------
 * Task:	Create or open a temporary file.
 * Startegy:
 *	- Enter correct path
 	- If we are restoring from state, open the temporary file,
 	  otherwise truncate the file
 * Paramters:	attachFlags: AppAttachFlags from MSG_GEN_PROCESS_OPEN_APPLICATION
 * Return:	Handle of the file
 *		Nullhandle if error
 ---------------------------------------------------------------------------*/
VMFileHandle ToolCreateTempFile(AppAttachFlags attachFlags) {
VMFileHandle fh;
FileLongName fileName;

    /*
     * Do initializing stuff
     *	- enter path for temp. file
     *	- initialize file name
     */
    FilePushDir();
    MemLock( OptrToHandle(@IconEdTempFileName) );

    FileSetStandardPath(SP_PRIVATE_DATA);
    FileCreateDir(LMemDeref(@IconEdTempFolder));		// no problem, if already exist
    FileSetCurrentPath(0,LMemDeref(@IconEdTempFolder));
    strcpy(fileName, LMemDeref(@IconEdTempFileName));

    MemUnlock( OptrToHandle(@IconEdTempFileName) );

    /*
     * Open the or create file. If we are restoring from state, the file holds
     * the bitmaps which are edited by the fatbits objects. In this case we have
     * to open the file.
     * If we do not restoring from the state, we truncate the file to destroy
     * any remnants of old bitmaps.
     */
    if ( attachFlags & AAF_RESTORING_FROM_STATE ) {
    	fh = VMOpen(fileName, VMAF_FORCE_READ_WRITE | VMAF_FORCE_DENY_WRITE , VMO_CREATE, 0);
    } else {
        fh = VMOpen(fileName, VMAF_FORCE_READ_WRITE | VMAF_FORCE_DENY_WRITE , VMO_CREATE_TRUNCATE,0);
    }

    /*
     * If opening fails, try to delete and recreate the file.
     * Of course, this will also crash the app if we are restoring from state.
     */
    if ( !fh ) {
        FileSetAttributes(fileName, 0);
    	FileDelete(fileName);
	fh = VMOpen(fileName, VMAF_FORCE_READ_WRITE | VMAF_FORCE_DENY_WRITE , VMO_CREATE_TRUNCATE,0);
    }

    EC ( if (!fh) { ProgError("Unable to create the temp. file"); } )

    /*
     * Do the same job for the undo file.
     */
    UndoOpenUndoFile(attachFlags);

    FilePopDir();
    return fh;
}

/*--------------------- ToolCloseTempFile ---------------------
 * Task:	Close temporary file
 * Paramters:   *fh: 	pointer to file handle
 * Strategy:	Do no delete the file!
 * Return:	-
 ---------------------------------------------------------------------------*/
void ToolCloseTempFile(VMFileHandle *fh) {

    if (*fh) {
	VMClose(*fh,FALSE);
	*fh = 0;
	}

}



