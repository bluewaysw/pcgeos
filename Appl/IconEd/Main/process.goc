/*--------------------- MSG_PROCESS_CREATE_UI_THREAD ---------------------
 * Task: The standard stack is too small and leads to stack overflow
 *	 when working intensively with the UI.
 ---------------------------------------------------------------------------*/
@extern method IconProcessClass, MSG_PROCESS_CREATE_UI_THREAD {
Boolean retVal;

	stackSize = INTERFACE_THREAD_DEF_STACK_SIZE + 1000; // min. 400 bytes more;
		//  INTERFACE_THREAD_DEF_STACK_SIZE is 2000
	retVal = @callsuper();
	return retVal;
}

/*--------------------- IconToolFindMonikerInfo ---------------------
 * Task: Get TokenDBItem that is used by the system for passed screen
 * Strategy: call TokenLookupMoniker() for IconEditor App icon
 * return  : TokenDBItem if icon was found
 *	     Zero if icon was not found
 ---------------------------------------------------------------------------*/
TokenDBItem IconToolFindMonikerInfo(DisplaySize displaySize, DisplayClass displayClass, TokenMonikerInfo *infoPtr) {
TokenMonikerInfo tokenMonikerInfo;
GeodeToken 	tok = { "ICON", 0 };
Boolean		ok;
dword 		tokenChars;
int		aspect;
DisplayType 	displayType;
VisMonikerSearchFlags searchFlags;


/* typedef struct { TokenDBItem         TMI_moniker;
    		    word                TMI_fileFlag;
    		    			/ * 0 if token is in shared token DB file
						   Non-0 if it's in local file * /
} TokenMonikerInfo; */

	if ( displaySize== DS_TINY ) { aspect = DAR_VERY_SQUISHED; }
				else { aspect = DAR_NORMAL; }

	memcpy(&tokenChars, &tok.GT_chars[0], 4);
    	displayType = displaySize << DT_DISP_SIZE_OFFSET |
    		aspect	<< DT_DISP_ASPECT_RATIO_OFFSET |
    		displayClass	<< DT_DISP_CLASS_OFFSET;
   	searchFlags = VMS_ICON	<< VMSF_STYLE_OFFSET |
    		VMSF_GSTRING;

    	ok = TokenLookupMoniker(tokenChars, tok.GT_manufID,
		       displayType, searchFlags,
		       &tokenMonikerInfo);
	if ( !ok ) return 0;

	if (infoPtr) *infoPtr = tokenMonikerInfo;
	return tokenMonikerInfo.TMI_moniker;
}


/*--------------------- IconCheckAndHandleOlderMoniker ---------------------
 * Task: Check if the icon, stored in the tokenDB, is up to date
 *	 If not, call MSG_GEN_PROCESS_INSTALL_TOKEN
 * Strategy: see code
 *	As long as there is no special API for getting the icons for a
 *	given token, we have to use a work around
 ---------------------------------------------------------------------------*/
void IconCheckAndHandleOlderMoniker(void) {
TokenDBItem 	stdMoniker, largeMoniker, monoMoniker, cgaMoniker;
TokenMonikerInfo tokenMonikerInfo;

    /*
     * The old Icon editor has an imcomplete set of icons for the application
     * token and/or the document token. Depending of the history and the
     * version of the old icon editor, there may differnet token variants in
     * the token database file
     *	(1) - only a text token
     *	(2) - only a standard VGA icon
     *	(3) - a standard VGA icon and a monochrome icon (but no CGA icon)
     *  (4) - two (empty) large icons (16 colors and monochrome) and a
     *        more or less complete set of the other icons.
     *
     * We should replace the tokens only if this is required because we
     * have one of the listed cased - oh what a painful job!
     */

    do {
	/*
	 * Find out the TokenDBItem for every moniker of interest.
	 * IconToolFindMonikerInfo() retuns an "best fit" moniker if the
	 * requested moniker was not found.
	 * e.g. the VGA monon moniker is used, if there is no CGA moniker
	 */

    	stdMoniker = IconToolFindMonikerInfo(DS_STANDARD, DC_COLOR_4, &tokenMonikerInfo);
    	if ( stdMoniker == 0) break;	/* token not found */

    	largeMoniker = IconToolFindMonikerInfo(DS_LARGE, DC_COLOR_4, NULL);
    	monoMoniker = IconToolFindMonikerInfo(DS_STANDARD, DC_GRAY_1, NULL);
    	cgaMoniker = IconToolFindMonikerInfo(DS_TINY, DC_GRAY_1, NULL);

	/*
	 * For the cases (1), (2) and (3) we receive the same moniker for
	 * vga mono screens and cga screens -> Update required
	 */
    	if ( monoMoniker == cgaMoniker) break;

	/*
	 * Because we have no special icons for large screens, the received
	 * monikers should be equal for 16 color large screens and 16 color
	 * standard screens. For the case (4) we receive the different monikers
	 * -> Update required
	 *
	 */
    	if ( stdMoniker != largeMoniker) break;

    	/*
    	 * Tokens are up-to-date
    	 */
    	return;

    } while (FALSE);

    /*
     * --> update monikers
     */
    @call process::MSG_GEN_PROCESS_INSTALL_TOKEN();
}



/*--------------------- MSG_GEN_PROCESS_OPEN_APPLICATION ---------------------
 * Task:	Do initializing stuff at app startup
 * Paramters:	void (	AppAttachFlags		attachFlags,
 * 			MemHandle		launchBlock,
 * 			MemHandle 		extraState);
 * 	attachFlags:	bitflags. possible flags are
 *	 	  	  AAF_RESTORING_FROM_STATE | AAF_STATE_FILE_PASSED
 *	 		| AAF_DATA_FILE_PASSED	| AAF_RESTORING_FROM_QUIT
 * launchBlock:	AppLaunchBlock
 * extraState:	Handle of the extra state block, if one is returned by
 * 		MSG_GEN_PROCESS_CLOSE_APPLICATION
 * Strategy:
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_GEN_PROCESS_OPEN_APPLICATION {
word attrs, err, value;

    /*
     * - Initialize global Variables
     * - Create temporary files to hold some bitmaps
     * - Register process object for clipboard
     */
    memset(&global, 0, sizeof(GlobalStruct));

    global.tempFile = ToolCreateTempFile(attachFlags);
    ClipboardAddToNotificationList(HandleToOptr(GeodeGetProcessHandle()));

    /*
     * There is a hidden feature to allow icons that are (slightly) larger than 8 kB.
     * The safe size for icons is 8 kB, but GEOS usually can also handle 10 kB or more.
     * However, this should be done with great caution. The maximum moniker size
     * therefore can be set in GEOS.INI. This was actually intended as a test feature,
     * but it might be helpful in certain situations.
     */
    err = InitFileReadInteger (IE_INI_CATEGORY, "maxMonikerSize", &value);
    if ( err ) { global.maxSaveMonikerSize = MAX_SAFE_MONIKER_SIZE_DEFAULT; }	/* 8kB + sizeof(CBitmap) */
         else  { global.maxSaveMonikerSize = value; }

    /*
     * The 2nd hidden feature is to override the maximum allowed icons width and height
     */
    err = InitFileReadInteger (IE_INI_CATEGORY, "maxImageDimension", &value);
    if ( err ) { global.maxMonikerImageSize = MAX_DEFAULT_ICON_WIDTH; }	   /* 1024 pixels */
    else  {
	global.maxMonikerImageSize = value;

	/* update affected GenValue objects */
	@send CustomIconHeightValue::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));
	@send CustomIconWidthValue::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));

	@send CustomHeightValue::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));
	@send CustomWidthValue::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));

	@send CustomToolHeightValue::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));
	@send CustomToolWidthValue::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));

	@send ResizeNewYSize::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));
	@send ResizeNewXSize::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(value));

    }

    /*
     * handle updates for older versions of the Icon Editor
     */
    IconCheckAndHandleOlderMoniker();
    InitFileDeleteEntry("IconEd",  "BitmapTools");	/* Ensure that PickColor is visible */

    @callsuper();


    /*
     * Some dialog boxes would require complex re-initialization when GEOS
     * is restored from state. This affects all dialogs that have
     * VisListContentClass objects as well as ResizeDialog.
     * To keep things easy we close these dialogs here. Even if it's not
     * GEOS-like, it's not worth the effort to re-initialze the dialog.
     * There is no problem if the dialog box is not open here.
     */
    if ( attachFlags & AAF_RESTORING_FROM_STATE ) {
	@send SortISetsDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	//send SortIconsDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
        // SortIconsDialog can be restored easily
	@send TokenDeleterDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	@send ImportTokenDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);


	/*
	 * Closing ResizeDialog is more complex
	 */
	attrs = @call ResizeDialog::MSG_VIS_GET_ATTRS();
	if (attrs & VA_VISIBLE) {
	    @send ResizeDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	    @call ResizeTargetContent::MSG_OC_DESTROY_LIST();
	    @call ResizeResizeTrigger::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	    @call ResizeSourceContent::MSG_OC_REPLACE_BITMAP(0);
	}

    }

    /*
     * Create initial color bars for HSV sliders in CustomColorDialog
     */
    @send HsvHContent::MSG_OC_CREATE_COLOR_BAR(0, 0, 0, CREATE_H_BAR, FALSE);
    @send HsvSContent::MSG_OC_CREATE_COLOR_BAR(0, 0, 0, CREATE_H_BAR, FALSE);
    @send HsvVContent::MSG_OC_CREATE_COLOR_BAR(0, 0, 0, CREATE_H_BAR, FALSE);

@if @DEBUG_FLAG
    BTSetDebugText(@IconDebugText);
@endif

EC ( { int size; size = sizeof(ISetExtraData); \
	if ( size != 152 ) { ProgError("Unexpected change of ISetExtraData size to .."); \
		MessageNumberBox(sizeof(ISetExtraData)); } } )

}

/*--------------------- MSG_GEN_PROCESS_CLOSE_APPLICATION ---------------------
 * Task:	App is beeing cosed. Do required stuff
 * Paramters:	MemHandle ( void );
 *
 * Strategy: 	- close temp file
 *		- free memory
 *		- unregister process from clipbpoard
 * Return:	Handle of extra state block (zero for none)
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_GEN_PROCESS_CLOSE_APPLICATION {
MemHandle mh;

    mh = @callsuper();	/* do this first to keep tempfile open until all timers are stoped */

    ToolCloseTempFile(&global.tempFile);
    UndoCloseUndoFile();
    ClipboardRemoveFromNotificationList(HandleToOptr(GeodeGetProcessHandle()));

    if (global.iconListPtr) free(global.iconListPtr);
    global.iconListPtr = 0;
    if (global.tokenListMH) MemFree(global.tokenListMH);

    /*
     * Free memory of color bars for HSV sliders in CustomColorDialog
     */
    @send HsvHContent::MSG_OC_DESTROY_COLOR_BAR();
    @send HsvSContent::MSG_OC_DESTROY_COLOR_BAR();
    @send HsvVContent::MSG_OC_DESTROY_COLOR_BAR();


    InitFileCommit();


    return mh;
}

/*--------------------- MSG_GEN_PROCESS_INSTALL_TOKEN ---------------------
 *	Purpose:	Install the document token
 *	Context:	Called if the App token does not exists in the token DB
 *			- or explicitely if the token is outdated.
 *	Strategy:	Usually, the App token is instaled by the SuperClass
 			But in our case, we have to update an older apptoken too
 *	Parameters:	void ( void )
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_GEN_PROCESS_INSTALL_TOKEN {
GeodeToken docToken = { "IDOC", 0 };
GeodeToken appToken = { "ICON", 0 };
dword	tokenDW;

    @callsuper();

    /*
     * Install / update document token
     * The list is in the same resource as the monikes - no relocation required
     */
    memcpy(&tokenDW, &docToken.GT_chars[0], 4);
    TokenDefineToken( tokenDW, docToken.GT_manufID,  @IconDocMonikerList,0);

    /*
     * Install / update Application token
     */
    memcpy(&tokenDW, &appToken.GT_chars[0], 4);
    TokenDefineToken( tokenDW, appToken.GT_manufID,  @IconAppMonikerList,0);
}




