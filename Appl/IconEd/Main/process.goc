/*--------------------- ToolChangeTextSize ---------------------
 *	Purpose:	Set a new value for ATTR_GEN_TEXT_DEFAULT_CHAR_ATTR
 *	Strategy:
 *	- set up VisTextDefaultCharAttr
 *	- setobjext not usable and send attr
 *	- set the object usable only if it was usable bevore.
 *	Parameters:	optr textObj
 			int size	- pass a VTDS_-value
 ---------------------------------------------------------------------------*/
void ToolChangeTextSize(optr textObj, int size) {
VisTextDefaultCharAttr  attr;
Boolean isUsable;

     attr = ((size << VTDCA_SIZE_OFFSET) | VTDF_UNIVERSITY);
     isUsable = @call textObj::MSG_GEN_GET_USABLE();

     @send textObj::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
     @send textObj::MSG_META_ADD_VAR_DATA(ATTR_GEN_TEXT_DEFAULT_CHAR_ATTR, 2, &attr);
     if (isUsable )
     	@send textObj::MSG_GEN_SET_USABLE(VUM_NOW);

}

/*--------------------- MSG_ICON_QUICK_HELP_SIZE_CHANGED ---------------------
 *	Purpose:	Select a new help theme
 *	Parameters:	(GEN_ITEM_GROUP_APPLY_MSG)
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_QUICK_HELP_SIZE_CHANGED {

     ToolChangeTextSize(@TermsTextField, selection);
     ToolChangeTextSize(@StandardIconTextField, selection);
     ToolChangeTextSize(@ColorInfoTextField, selection);
}

/*--------------------- MSG_ICON_QUICK_HELP_THEME_CHANGED ---------------------
 *	Purpose:	Select a new help theme
 *	Parameters:	(GEN_ITEM_GROUP_APPLY_MSG)
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_QUICK_HELP_THEME_CHANGED {
optr obj = 0;

     @send TermsTextField::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
     @send StandardIconTextField::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
     @send ColorInfoTextField::MSG_GEN_SET_NOT_USABLE(VUM_NOW);

     switch (selection) {
     case HELP_THEME_TERMS: obj = @TermsTextField; break;
     case HELP_THEME_ICONS: obj = @StandardIconTextField; break;
     case HELP_THEME_COLOR: obj = @ColorInfoTextField; break;
     }

     if (obj) {
         @send obj::MSG_GEN_SET_USABLE(VUM_NOW);
     }

}

/*--------------------- MSG_ICON_REDRAW_FATBITS ---------------------
 *	Purpose:	Redraw Fatbits View
 *	Parameters:	-
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_REDRAW_FATBITS {
optr fatbitsObj;

    fatbitsObj = CombineGCurDisplayWith(@MyFatbits);
    if ( !fatbitsObj) return;

    @send ConstructOptr(OptrToHandle(fatbitsObj), OptrToChunk(@FatbitsView))::MSG_GEN_VIEW_REDRAW_CONTENT();

}

/*--------------------- MSG_ICON_OPEN_PICK_COLOR_DIALOG ---------------------
 *	Purpose:
 *	Parameters:	-
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_OPEN_PICK_COLOR_DIALOG {
optr fatbitsObj, viewObj;
PaletteEntry color;

    fatbitsObj = CombineGCurDisplayWith(@MyFatbits);
    if ( !fatbitsObj) return;

    /*
     * Enter Fatbits Pick Color mode
     */
    @send fatbitsObj::MSG_FATBITS_SET_FLAGS(FB_PICK_COLOR_IS_ACTIVE, 0);

    /*
     * Hide the UI of interfering tool control boxes
     */
    @send PointerImageOptionsGroup::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    @send PointerImagePickColorText::MSG_GEN_SET_USABLE(VUM_NOW);

    /*
     * Initialize Pick Color dialog box UI
     */
    @call oself::MSG_ICON_PICK_COLOR_DIALOG_UPDATE_COLOR(0, 0, fatbitsObj);
    color = @call fatbitsObj::MSG_FATBITS_GET_PIXEL_COLOR(0, 0, NULL);
    @call PickColorSelectedColorContent::MSG_OTHER_CONTENT_SET_COLOR(color.rt, color.gn, color.bl);

    /*
     * Set pipette pointer image
     */
    viewObj = CombineGCurDisplayWith(@FatbitsView);
    @call viewObj::MSG_GEN_VIEW_SET_PTR_IMAGE(@PipettePointer, PIL_WINDOW);

    @send IconPickColorControlBox::MSG_GEN_INTERACTION_INITIATE();
}


/*--------------------- MSG_ICON_PICK_COLOR_DIALOG_UPDATE_COLOR ---------------------
 *	Purpose:	Read color from image and update dialog UI
 *	Parameters:	x, y: image coordinates
 *			fatbitsObj:	our fatbits object
 *	return:		-
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_PICK_COLOR_DIALOG_UPDATE_COLOR {
int index;
PaletteEntry color;

    color = @call fatbitsObj::MSG_FATBITS_GET_PIXEL_COLOR(x, y, &index);
    @call PickColorCurrentColorContent::MSG_OTHER_CONTENT_SET_COLOR(color.rt, color.gn, color.bl);

    if ( index == (-1) ) {
    	@call PickColorCurrentIndex::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    	@call PickColorCurrentIndex::MSG_GEN_VALUE_SET_INTEGER_VALUE(0, FALSE);
    } else  {
    	@call PickColorCurrentIndex::MSG_GEN_SET_ENABLED(VUM_NOW);
    	@call PickColorCurrentIndex::MSG_GEN_VALUE_SET_INTEGER_VALUE(index, FALSE);
    }

    @call PickColorRValue::MSG_GEN_VALUE_SET_INTEGER_VALUE(color.rt, FALSE);
    @call PickColorGValue::MSG_GEN_VALUE_SET_INTEGER_VALUE(color.gn, FALSE);
    @call PickColorBValue::MSG_GEN_VALUE_SET_INTEGER_VALUE(color.bl, FALSE);
}

/*--------------------- MSG_ICON_CLOSE_PICK_COLOR_DIALOG ---------------------
 *	Purpose:
 *	Parameters:
 *	return:
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_CLOSE_PICK_COLOR_DIALOG {
optr fatbitsObj;

    fatbitsObj = CombineGCurDisplayWith(@MyFatbits);
    if ( !fatbitsObj) return;

    /*
     * re-show UI of interfering tool control boxes
     */
    @send PointerImagePickColorText::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    @send PointerImageOptionsGroup::MSG_GEN_SET_USABLE(VUM_NOW);

    /*
     * Leave Pick Color mode
     */
    @send fatbitsObj::MSG_FATBITS_SET_FLAGS(0, FB_PICK_COLOR_IS_ACTIVE);
    @send IconPickColorControlBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
}

/*--------------------- MSG_ICON_SET_PICKED_AREA_COLOR ---------------------
 *	Purpose:
 *	Parameters:	-
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_SET_PICKED_AREA_COLOR {
PaletteEntry color;

    color = @call PickColorSelectedColorContent::MSG_OTHER_CONTENT_GET_COLOR();
    @send CombineGCurDisplayWith(@MyFatbits)::MSG_GO_SET_AREA_COLOR(color.rt, color.gn, color.bl);
}


/*--------------------- MSG_ICON_SET_PICKED_LINE_COLOR ---------------------
 *	Purpose:
 *	Parameters:	-
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_SET_PICKED_LINE_COLOR {
PaletteEntry color;

    color = @call PickColorSelectedColorContent::MSG_OTHER_CONTENT_GET_COLOR();
    @send CombineGCurDisplayWith(@MyFatbits)::MSG_GO_SET_LINE_COLOR(color.rt, color.gn, color.bl);
}



@if @DEBUG_FLAG

Boolean IconTestBWT(VMFileHandle vmFile, VMBlockHandle bmp);

/* -------------------- MSG_ICON_TEST ---------------------------------------
 *
 * --------------------------------------------------------------------------- */
@method IconProcessClass, MSG_ICON_TEST {
//dword time = TimerGetCount();
optr dbViewer;
int icon, iSet;
VMFileHandle vmFile;
VMBlockHandle bmp;
int format, w, h;
Boolean found;

    dbViewer = CombineGCurDisplayWith(@DBViewerContent);
    vmFile = @call dbViewer::MSG_DB_VIEWER_GET_DATABASE();
    iSet = @call dbViewer::MSG_DB_VIEWER_GET_CURRENT_ISET();
    icon = @call dbViewer::MSG_DB_VIEWER_GET_CURRENT_ICON();

    bmp = IdGetEntryBitmap(vmFile, iSet, icon);
    format = BTGetMoreBitmapInfos(vmFile, bmp, &w, &h, 0);
    DebugInfo1("\r-->Format=%u", format & BMT_FORMAT);
    DebugInfo2(" %ux%u", w, h);

    found = IconTestBWT(vmFile, bmp);
    if ( found ) {
    	UserStandardSound(SST_NOTIFY);
    	DebugInfo("\r   WHITE PIXELS");
    } else {
    	DebugInfo("\r   ok");
    }

//DebugInfo1("\rTest-Time=%u", TimerGetCount() - time);
}

