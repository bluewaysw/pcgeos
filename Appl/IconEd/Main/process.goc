dword time = TimerGetCount();

//	TimeLoop();
//	TestRGB2HSV();


DebugInfo1("\rTest-2-Time=%u", TimerGetCount() - time);

}


@endif

/*+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

 	IconApplicationClass code

 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/*--------------------- MSG_META_KBD_CHAR ---------------------
 *  Purpose:	See if a special key is pressed
 *  Context:
 *  Strategy:
 *  Parameters: void ( word character, word flags, word state )
 *	character:	Low byte:  ASCII code (if high byte = 0)
 *				   Control code  (if high byte = 0xFF)
 *	flags:		High byte: ShiftState 	SS_xxxx
 *			Low byte: CharFlags	CF_xxxx
 *			   e.g. CF_FIST_PRESS , CF_RELEASE
 *	state:		High byte: Scancode
 *			Low byte: ToggleState
 *			   TS_CAPSLOCK | TS_NUMLOCK | TS_SCROLLLOCK
 *	Return:         -
 -----------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_META_KBD_CHAR {

    /*
     * see if ESC key is pressed for first time
     */
    do {
      if ( character != 0xFF1b ) break;
      if ( (flags & 0xFF) != CF_FIRST_PRESS ) break;
      if ( (flags & 0xFF00) != 0 ) break;

      @call oself::MSG_ICON_APP_CLOSE_DIALOGS();

    } while (FALSE);

    @callsuper();
}

/*--------------------- MSG_ICON_APP_CLOSE_DIALOGS ---------------------
 *  Purpose:	Kill ants and close dialogs
 *  Context:	Called when ESC key is pressed
 *  Strategy:
 *  Parameters:	-
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_CLOSE_DIALOGS {
word attrs;

    if ( global.curDisplay) @send CombineGCurDisplayWith(@MyFatbits)::MSG_FATBITS_KILL_ANTS();

    /*
     * Dialogboxes that are marked as GIT_COMMAND oder GIT_PROGRESS are usually
     * closed automatically when ESC key is pressed.
     * But some dialogs need an extra handling
     */

    @call ReplacedColorDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    @call ImportGraphicDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    @call GStringToBitmapDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);

    /*
     * In some cases, the cancel trigger does some important things.
     * So let it do the job.
     *
     */
    @send ImpTokenCancelImportTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send ExpTokenCancelExportTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send ChangeIconCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send MoveIconCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send TokenDeleterCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send ClosePreviewTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send TextMonikerCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send CropImageCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send AnimateCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    @send ResizeCloseTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);


    /*
     * In some cases we have to check the VA_VISIBLE bit of the dialog first
     * or the trigger handler messes up.
     *
     * The SortIconsDialog and SortISetsDialog modifies the database directly. Therefore
     * the close trigger handler must be called - but only if the dialog is open.
     */
    attrs = @call SortIconsDialog::MSG_VIS_GET_ATTRS();
    if (attrs & VA_VISIBLE) {
 	@send SortIconsCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    }

    attrs = @call SortISetsDialog::MSG_VIS_GET_ATTRS();
    if (attrs & VA_VISIBLE) {
 	@send SortISetsCancelTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    }

    attrs = @call EditMaskControlBox::MSG_VIS_GET_ATTRS();
    if (attrs & VA_VISIBLE) {
 	@send EditMaskCloseButton::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    }

    attrs = @call IconPickColorControlBox::MSG_VIS_GET_ATTRS();
    if (attrs & VA_VISIBLE) {
 	@send PickColorCloseTrigger::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
    }


}

/*--------------------- MSG_ICON_APP_CLOSE_AND_SELECT_PENCIL ---------------------
 *  Purpose:	Close exclusive tool dialogs and enter pencil mode
 *  Context:
 *  Strategy:
 *  Parameters:	-
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_CLOSE_AND_SELECT_PENCIL {

    if ( !global.curDisplay ) { EC(ProgError("close and selct pencil: bad display");) return; }

    @send EditMaskControlBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    @send SelectionToolControlBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    @send process::MSG_ICON_CLOSE_PICK_COLOR_DIALOG();

    @send CombineGCurDisplayWith(@MyFatbits)::MSG_FATBITS_SET_BITMAP_TOOL(BTF_PENCIL, 0, 0);

}

/*--------------------- MSG_ICON_APPLICATION_SET_OPTIONS ---------------------
 *  Purpose:	Sends options to all documents.
 *  Context:
 *  Strategy:
 	- some of the options mus be handled by the document object
 	  send it as calssed event to the DocumentGroup
 	- other options sets global variables for simplification
 *  Parameters:GEN_BOOLEAN_GROUP_APPLY_MSG
 		(word selectedBooleans = cx,
	          word indeterminateBooleans = dx,
	          word modifiedBooleans = bp);
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APPLICATION_SET_OPTIONS {
EventHandle ev;

    /*
     *  Store global options. This MUST be done first!
     */
    global.coloredIconListView = (selectedBooleans & IO_COLORED_ICON_LIST) ? TRUE : FALSE;

@if @ENABLE_BACKGROUND_PATTERN
    global.useBackgroundPattern = (selectedBooleans & IO_BACKGROUND_PATTERN) ? TRUE : FALSE;
@endif

    /*
    /*
     *  Record a classed event for the options.
     *  Send the options to each document
     */
    ev = @record IconDBDocumentClass::MSG_DB_DOC_SET_OPTIONS(selectedBooleans, indeterminateBooleans, modifiedBooleans);
    @send IconDocumentGroup::MSG_GEN_SEND_TO_CHILDREN(ev);

    /*
     * if IO_ALLOW_OVERSIZED_ICONS has been activated warn the user
     */
    if ( (modifiedBooleans & IO_ALLOW_OVERSIZED_ICONS) && (selectedBooleans & IO_ALLOW_OVERSIZED_ICONS) ) {
        UserStandardSound(SST_WARNING);
    	UserDoDialog(@AllowOversizeWarningBox);
    }

}

/*--------------------- MSG_META_SAVE_OPTIONS ---------------------
 *  Purpose:	save-options handler for IconApplicationClass
 *  Context:
 *  Strategy:
 	- get options from ui
 	- save it to init file
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_META_SAVE_OPTIONS {
word value;

     @callsuper();

     value = @call OptionsBooleanGroup::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();
     InitFileWriteInteger(IE_INI_CATEGORY, IE_INI_OPTIONS_KEY, value);

     value = @call FatbitImageSizeGroup::MSG_GEN_ITEM_GROUP_GET_SELECTION();
     InitFileWriteInteger(IE_INI_CATEGORY, IE_INI_FATBITS_KEY, value);

     value = @call ViewColorGroup::MSG_GEN_ITEM_GROUP_GET_SELECTION();
     InitFileWriteInteger(IE_INI_CATEGORY, IE_INI_VIEW_COLOR_KEY, value);

}

/*--------------------- MSG_META_LOAD_OPTIONS ---------------------
 *  Purpose:	save-options handler for IconApplicationClass
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_META_LOAD_OPTIONS {
word	options, viewColor, pixelSize;

    @callsuper();

    LoadOptionsFromINI(&options, &pixelSize, &viewColor);

    @call OptionsBooleanGroup::MSG_GEN_BOOLEAN_GROUP_SET_GROUP_STATE(options, FALSE);
    @call FatbitImageSizeGroup::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(pixelSize, FALSE);
    @call ViewColorGroup::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(viewColor, FALSE);


}

/*--------------------- LoadOptionsFromINI ---------------------
 *  Purpose:	Load Options.
 *  Context:
 *  Strategy:
 	- load options from init file
 	- set default value if no entry was found
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void LoadOptionsFromINI(word *options, word *pixelSize, word *viewColor) {
Boolean err;
word value;

    err = InitFileReadInteger (IE_INI_CATEGORY, IE_INI_OPTIONS_KEY, &value);
    if ( err ) value = DEFAULT_ISET_OPTIONS;
    *options = value;

    err = InitFileReadInteger (IE_INI_CATEGORY, IE_INI_FATBITS_KEY, &value);
    if ( err ) value = DEFAULT_FATBITS_SIZE;
    *pixelSize = value;

    err = InitFileReadInteger (IE_INI_CATEGORY, IE_INI_VIEW_COLOR_KEY, &value);
    if ( err ) value = DEFAULT_VIEW_COLOR;
    *viewColor = value;

}



/*--------------------- MSG_META_SEND_CLASSED_EVENT ---------------------
 *  Purpose:
 *  Context:
 *  Strategy:
 	We intercept this to handle our own travel option 'TO_BITMAP'
 	-  See if it's a TravelOption we handle.
 	-  If yes, send the event to appropriate object
 	   or destroy the event if no current bitmap exists.
 	-  If no let the superclass deal with it.
 *  Parameters: void (EventHandle event,
		  TravelOption whereTo);
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_META_SEND_CLASSED_EVENT {

    if ( whereTo == TO_BITMAP ) {
    	if ( global.curDisplay ) {
	    optr fatbits = CombineGCurDisplayWith(@MyFatbits);
    	    @send, forceQueue fatbits::MSG_META_SEND_CLASSED_EVENT(event, whereTo);
    	} else {
	    ObjFreeMessage(event);
    	}
    return;
    }

    if ( whereTo == TO_DB_VIEWER ) {
    	if ( global.curDisplay ) {
    	    optr obj = CombineGCurDisplayWith(@DBViewerContent);
    	    @send, forceQueue obj::MSG_META_SEND_CLASSED_EVENT(event, whereTo);
    	} else {
	    ObjFreeMessage(event);
    	}
    return;
    }

    @callsuper();
}

/*--------------------- MSG_ICON_APP_UPDATE_ADD_ISET_DIALOG_OPTIONS_UI ---------------------
 *  Purpose:	Displays the option UI we have for the
		selected icon type, in the add-icon-set dialog.
 *  Context:
 *  Strategy:	We set-not-usable all the specialized UI, then set-usable the ones we
		want to show up.
		If we have a colorChooser object, send out its apply message.
 *  Parameters: GEN_ITEM_GROUP_APPLY_MSG (
    	    	    	    	    word selection = cx,
			    	    word numSelections = bp,
				    GenItemGroupStateFlags stateFlags = dl);
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_UPDATE_ADD_ISET_DIALOG_OPTIONS_UI {
optr colorChooser = 0;

    /*
     *  First set everything unusable / not enabled.
     */
    @send FileIconOptionsGroup::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    @send ToolIconOptionsGroup::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    @send MouseCursorOptionsGroup::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    @send CustomIconOptionsGroup::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    @send PrefModuleOptionsGroup::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);

/* flickers ...
    @send AddISetDialog::MSG_GEN_RESET_TO_INITIAL_SIZE (VUM_DELAYED_VIA_UI_QUEUE);
*/

    /*
     *  Set desired objects usable / enabled
     */
    switch (selection) {
    case NEW_FILE_ISET:
    	@send, forceQueue AddISetHelpText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@NewISetIconHelpText,0);
	@send, forceQueue FileIconOptionsGroup::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
	break;
    case NEW_TOOL_ISET:
    	@send, forceQueue AddISetHelpText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@NewISetToolHelpText,0);
	@send, forceQueue ToolIconOptionsGroup::MSG_GEN_SET_USABLE(VUM_NOW);
	break;
    case NEW_PTR_ISET:
    	@send, forceQueue AddISetHelpText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@NewISetMouseHelpText,0);
	@send, forceQueue MouseCursorOptionsGroup::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
	break;
    case NEW_CUSTOM_ISET:
    	@send, forceQueue AddISetHelpText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@NewISetCustomHelpText,0);
	@send, forceQueue CustomIconOptionsGroup::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    	colorChooser = @CustomISetBitmapColorsChooser;
	break;
    case NEW_PREF_MODULE_ISET:
    	@send, forceQueue AddISetHelpText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@NewISetPrefModuleHelpText,0);
	@send, forceQueue PrefModuleOptionsGroup::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
	break;
    }

    /*
     * MousePointer Images have no DisplayClass - hide display class info text
     */
    if ( selection == NEW_PTR_ISET ) {
    	@send AddISetDlgInfoText1::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    } else {
    	@send AddISetDlgInfoText1::MSG_GEN_SET_USABLE(VUM_NOW);
    }


    /*
     *  If we have a colorChooser object, send out its apply message
     *  so that color-related UI will be updated,
     *	If not, hide true-color-is-big warning.
     *
     *  This code seems a bit clunky because there's a color chooser only
     *  for custom iSets. Actually, it's a holdover from a different concept.
     *  I'll leave it as is for now; maybe it'll get used again someday.
     */
    if (colorChooser) {
    	@send colorChooser::MSG_GEN_ITEM_GROUP_SET_MODIFIED_STATE(TRUE);
    	@send colorChooser::MSG_GEN_APPLY();
    } else {
    	@send AddISetDlgInfoText2::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }

/**/
}

/*--------------------- MSG_ICON_APP_ADD_ISET_DIALOG_COLOR_SCHEME_CHANGED ---------------------
 *  Purpose:	Sets up SOME ui in the add-icon-set dialog.
 *  Context:
 *  Strategy:
 	- If true color is choosen, display a warn message
 	- If any colored scheme is choosen, enable extra mono icon selector
 	  for custom icon formats
 *  Parameters: GEN_ITEM_GROUP_APPLY_MSG (
    	    	    	    	    word selection = cx,
			    	    word numSelections = bp,
				    GenItemGroupStateFlags stateFlags = dl);
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_ADD_ISET_DIALOG_COLOR_SCHEME_CHANGED {
int type;

    if (selection == BMF_24BIT ) {
    	@send AddISetDlgInfoText2::MSG_GEN_SET_USABLE(VUM_NOW);
    } else {
    	@send AddISetDlgInfoText2::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }

    /*
     *  Depending in the actual icon set type there are additional things to do
     */
    type = @call AddTypeGroup::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    switch (type) {
    case NEW_CUSTOM_ISET:
    	if (selection == BMF_MONO ) {
    	    @send CustomIconAddExtraMonoIcon::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    	    @send CustomIconAddExtraMonoIcon::MSG_GEN_BOOLEAN_GROUP_SET_GROUP_STATE(0, FALSE);
    	} else {
    	    @send CustomIconAddExtraMonoIcon::MSG_GEN_SET_ENABLED(VUM_NOW);
    	}
    	break;
    }
}

/*--------------------- MSG_ICON_APP_ADD_ISET_DIALOG_CUSTOM_TOOLS_CHANGED ---------------------
 *  Purpose:	Enable / Disable UI for custom tool setting in add-icon-set-dialog
 *  Context:
 *  Strategy:
 *  Parameters:GEN_BOOLEAN_GROUP_APPLY_MSG
 		(word selectedBooleans = cx,
	          word indeterminateBooleans = dx,
	          word modifiedBooleans = bp);
*  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_ADD_ISET_DIALOG_CUSTOM_TOOLS_CHANGED {

    /*
     * As we have two tool format chooser, we have to merge the bist first
     */
    selectedBooleans |= @call ToolIconFormatChooser1::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();
    selectedBooleans |= @call ToolIconFormatChooser2::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();

    /*
     * Enable / Disable ToolIconFeaturesGroup
     */
    if ( selectedBooleans & (IP_CUSTOM_COLOR_TOOL | IP_CUSTOM_MONO_TOOL) ) {
    	@send ToolIconFeaturesGroup::MSG_GEN_SET_ENABLED(VUM_NOW);
    } else {
    	@send ToolIconFeaturesGroup::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    }

    /*
     * Enable CustomToolColorChooser only if IP_CUSTOM_COLOR_TOOL is selected
     * If not, hide true-color-is-big warning too
     */
    if ( selectedBooleans & (IP_CUSTOM_COLOR_TOOL) ) {
    	@send CustomToolColorChooser::MSG_GEN_SET_ENABLED(VUM_NOW);
    	@send CustomToolColorChooser::MSG_GEN_ITEM_GROUP_SET_MODIFIED_STATE(TRUE);
    	@send CustomToolColorChooser::MSG_GEN_APPLY();
    } else {
    	@send CustomToolColorChooser::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    	@send AddISetDlgInfoText2::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }

}

/*--------------------- MSG_ICON_APP_ADD_ICON_DIALOG_COLOR_SCHEME_CHANGED ---------------------
 *  Purpose:	Sets up UI in the add-icon dialog.
 *  Context:
 *  Strategy:
 	- If true color is choosen, display a warn message
 	- If any colored scheme is choosen, enable extra mono icon selector
 	  for custom icon formats
 *  Parameters: GEN_ITEM_GROUP_APPLY_MSG (
    	    	    	word selection = cx,
			word numSelections = bp,
			GenItemGroupStateFlags stateFlags = dl);
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_ADD_ICON_DIALOG_COLOR_SCHEME_CHANGED {

    if (selection == BMF_24BIT ) {
    	@send AddIconDlgInfoText::MSG_GEN_SET_USABLE(VUM_NOW);
    } else {
    	@send AddIconDlgInfoText::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }

    if (selection == BMF_MONO ) {
	@send AddIconAddExtraMonoIcon::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	@send AddIconAddExtraMonoIcon::MSG_GEN_BOOLEAN_GROUP_SET_GROUP_STATE(0, FALSE);
    } else {
	@send AddIconAddExtraMonoIcon::MSG_GEN_SET_ENABLED(VUM_NOW);
    }
}



/*--------------------- MSG_ICON_APP_ADD_ICON_SET_INITIAL_VALUES ---------------------
 *  Purpose:	Update AddIconDialog UI to new default (standard) values
 *  Context:
 *  Strategy:
 	- find out the correct values for width, height, bitmap colors, style,
 	  aspect ratio, display size and icon style
 	  Bitmap colors may be only 16 colors or monochrome here
 	- update the UI in the AddIconDialog
 *  Parameters: GEN_ITEM_GROUP_APPLY_MSG (
    	    	    	word selection = cx,	 - one of the IP_xx values
			word numSelections = bp,
			GenItemGroupStateFlags stateFlags = dl);
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconApplicationClass, MSG_ICON_APP_ADD_ICON_SET_INITIAL_VALUES {
int width, height, aspect, style, displaySize;
BMFormat bmpColors;
optr defaultNameOp;

    /*
     * ToolFindBitmapAndScreenParameters() does the most part of the job
     * Only style value (icon or tool) must be set manually
     */
    ToolFindBitmapAndScreenParameters(selection, &width, &height, &bmpColors, &displaySize, &aspect);

    switch (selection) {
    case IP_STANDARD_CGA_TOOL:
    case IP_TINY_COLOR_TOOL_256:
    case IP_TINY_COLOR_TOOL:
    case IP_TINY_MONO_TOOL:
    	style = VMS_TOOL;
    	break;
    default:
    	style = VMS_ICON;
    }

    /*
     * Update dialog UI to new values
     */
     @call CustomIconWidthValue::MSG_GEN_VALUE_SET_INTEGER_VALUE(width, FALSE);
     @call CustomIconHeightValue::MSG_GEN_VALUE_SET_INTEGER_VALUE(height, FALSE);
     @call AddIconStyleChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(style, FALSE);
     @call AddIconDisplaySizeChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(displaySize, FALSE);
     @call AddIconAspectChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(aspect, FALSE);
     @call AddIconBitmapColorsChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(bmpColors, FALSE);

     MemLock(OptrToHandle(@DefaultCustomMonikerPrefix));
     @call AddIconNameTextField::MSG_VIS_TEXT_REPLACE_ALL_PTR(LMemDeref(@DefaultCustomMonikerPrefix), 0);
     MemUnlock(OptrToHandle(@DefaultCustomMonikerPrefix));
     defaultNameOp = GetEntryDefaultNameOptr(selection);
     @call AddIconNameTextField::MSG_VIS_TEXT_APPEND_OPTR(defaultNameOp, 0);


    /*
     * Finally we must enable / disable the "add extra monochrome icon" switch
     * and hide the "true color warning" text
     * Oh what a stupid job! Let someone else do the work.
     */
    @send AddIconBitmapColorsChooser::MSG_GEN_ITEM_GROUP_SET_MODIFIED_STATE(TRUE);
    @send AddIconBitmapColorsChooser::MSG_GEN_APPLY();
}

/*--------------------- AppMarkBusy ---------------------
 *	Pupose:	Enter Busy state
 ---------------------------------------------------------------------------*/
void AppMarkBusy(void) {
    	@call application::MSG_GEN_APPLICATION_MARK_BUSY();
    	@call application::MSG_GEN_APPLICATION_IGNORE_INPUT();
}

/*--------------------- AppMarkNotBusy ---------------------
 *	Pupose:	Leave Busy state
 ---------------------------------------------------------------------------*/
void AppMarkNotBusy(void) {
    	@call application::MSG_GEN_APPLICATION_MARK_NOT_BUSY();
    	@call application::MSG_GEN_APPLICATION_ACCEPT_INPUT();
}



/*--------------------- ConfirmOnDeleteBox ---------------------
 *  Purpose:	Ask user if he wants to delete something
 *  Context:
 *  Strategy:
 	- See if "confirm on delete" option is active
 		if set, ask user
 		if not set, return IC_YES
 *  Parameters:	txt: optr of text to display to the user
 *  Return:	-
 ---------------------------------------------------------------------------*/
int ConfirmOnDeleteBox(optr txt) {
word options;
int retVal;

    options = @call OptionsBooleanGroup::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();
    if ( options & IO_CONFIRM_DELETE ) {
    	retVal = QuestionBoxOptr(txt);
    } else {
    	retVal = IC_YES;
    }
    return retVal;
}


/***********************************************************************
 *  Progress box support
 ************************************************************************/

/*--------------------- ProgressOpenProgressBox ---------------------
 *  Task:       Show progress box
 *  Context:
 *  Strategy:
 *  Parameters: clearText: clear display text
 *  Return:
 ---------------------------------------------------------------------------*/
void ProgressOpenProgressBox(Boolean clearText) {
     if (clearText) @call IconProgressText::MSG_VIS_TEXT_DELETE_ALL();
     @call IconProgressBox::MSG_GEN_INTERACTION_INITIATE();
     }

/*--------------------- ProgressCloseProgressBox ---------------------
 *  Task:       Close progress box
 *  Context:
 *  Strategy:
 *  Parameters: delay: waiting time (ticks) before closing, to possibly
 *              give the user a chance to take another look.
 *  Return:
 ---------------------------------------------------------------------------*/
void ProgressCloseProgressBox(int delay) {

    if (delay) TimerSleep(delay);
    @send IconProgressBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
}

/*--------------------- ProgressDisplayText ---------------------
 *  Task:       Display text in progress box
 *  Context:
 *  Strategy:
 *  Parameters: append: TRUE: append text
 *              	FALSE: replace text
 *  Return:
 ---------------------------------------------------------------------------*/
void ProgressDisplayText(char * txt, Boolean replace) {

    if (replace) {
        @call IconProgressText::MSG_VIS_TEXT_REPLACE_ALL_PTR(txt, 0);
     } else {
        @call IconProgressText::MSG_VIS_TEXT_APPEND_PTR(txt, 0);
     }
}

/*--------------------- ProgressDisplayTextOptr ---------------------
 *  Task:       Display text in progress box
 *  Context:
 *  Strategy:
 *  Parameters: txt: 	optr to the text (may be unlocked)
 *              append: TRUE: append text
 *              	FALSE: replace text
 *  Return:
 ---------------------------------------------------------------------------*/
void ProgressDisplayTextOptr(optr txt, Boolean replace) {

    if (replace) {
        @call IconProgressText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(txt, 0);
     } else {
        @call IconProgressText::MSG_VIS_TEXT_APPEND_OPTR(txt, 0);
     }
}

/*--------------------- ProgressDisplaySpace ---------------------
 *  Task:       Append a space to progress box txt
 ---------------------------------------------------------------------------*/
void ProgressDisplaySpace() {
ProgressDisplayTextOptr(@ProgressSpace,FALSE);
}

/*--------------------- ProgressDisplayCR ---------------------
 *  Task:       Append a space to progress box txt
 ---------------------------------------------------------------------------*/
void ProgressDisplayCR() {
ProgressDisplayTextOptr(@ProgressCR,FALSE);
}


