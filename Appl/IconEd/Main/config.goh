/**************************************************************************
 *
 * PROJECT:	Icon Editor	(GOC Version)
 * FILE:	config.goh
 *
 *		Configuration settings for the Icon Editor
 *
 *		This project is inspired by the Icon Editor by Steve Yegge, 1992 - 1994
 *
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	RainerB 10/21/2025	Initial version
 *
 *
 *
 **************************************************************************/

#ifndef _ICONCFG_GOH
#define _ICONCFG_GOH

@include <stdapp.goh>


@define DEBUG_FLAG		0	/* Default: zero - no debugging functions available */

@define DEBUG_TOKEN_IMPORT	0	/* Add UI and functionality to debug tokens and icons
					 * during import from token DB file.
					 * Default: zero - no debugging */



/* ----------------------- End of Debug & Temp. Flags  --------------- */

@define HIDE_HUGE_SCREEN_UI	1	/* Default is 1, because DS_HUGE is not supported yet.
					 * If set to zero, some UI will be enabled to support
					 * huge display size */

@define USE_TWO_TOP_TOOL_BARS	1
				/* Use two toolbars above the document (left and right). Because
				 * this is very unusual, it can be toggled by this flag.
				 * Default value is 1.
				 */

@define ENABLE_MORE_SPEED_HSV_OPTION	0
#define COLOR_BAR_RECTANGLE_WIDTH	2
#define MORE_SPEED_W	6
				/* ENABLE_MORE_SPEED_HSV_OPTION should be set to zero because
				 * the problem  that caused the delayed update was found and solved.
				 * The code is preserved in case that someone still wants
				 * to use it.
				 *
				 * Information: On slower machines the response to the Hue slider
				 * was somewhat delayed. Therefore we draw the color bar as small
				 * rectangles rather than as one-pixel-wide lines.
				 * COLOR_BAR_RECTANGLE_WIDTH specifies the default width of the rectangles
				 * ENABLE_MORE_SPEED_HSV_OPTION enables a UI option that lets the
				 *		user select wider rectangles, which is faster
				 * MORE_SPEED_W	is the width of these rectangles.
				 * The higher MORE_SPEED_W is, the greater is the speed
				 * enhancement but the lower is the display quality.
				 * The default value is 0.
				 */

@define	ENABLE_BACKGROUND_PATTERN	0
				/* If this flag is set, GrSetAreaMaskSys() is used to draw a
				 * background pattern in FatbitsClass::MSG_VIS_DRAW and the
				 * related UI and code are enabled.
				 * This is a nice feature, but the background pattern cannot be
				 * drawn correctly in MSG_META_PTR of the dragging tools (line,
				 * filled rectangles etc.). Therefore, the visible pattern is lost in
				 * the area affected by the current drag operation until
				 * the area is completely redrawn.
				 * If you find a way to fix this, you may re-enable this flag.
				 * The default value is 0.
				 */

@define	SHIFT_IMAGE_IS_A_BITMAP_TOOL	0
				/* My first idea was to implement the “shift icon image” feature
				 * as part of the bitmap tools. But it proved to be unwieldy, so
				 * I moved it to the icon menu. With this flag, you can turn it
				 * back into a bitmap tool.
				 * The default value is 0.
				 */

@define	ENABLE_FILL_BITMAP_OPTION	0
				/* If set, an option to select/deselect the option USE_FILL_BITMAP_FOR_MONO
				 * (see iconConstants.h) is shown when writing as source code or exporting to
				 * token DB file. Currently I can't see any reason to enable this option,
				 * moreover, it may confuse the user.
				 * Note: If this option is enabled, additional code should be implemented
				 * that disables the corresponding Boolean objects when writing the
				 * transparency mask is turned off.
				 * The default value is 0.
				 */

@define DEFAULT_EDIT_MOUSE_POINTER_IS_STANDARD_POINTER 	0
				/* If set to one, the default mouse pointer for editing fatbits is simply
				 * the GEOS standard arrowhead mouse pointer.
				 * If not set (equal to zero) a special mouse pointer (an arrowhead pointing
				 * to a cross) is used.
				 * Specialized mouse pointers (eraser, selection tool ...) are not affected.
				 * The default value is 0.
				 */

@define	COPY_ISET_CREATES_A_GSTRING	0
				/* The old icon editor adds a GString (containing the first icon of the
				 * first iSet) to the clipboard when copying icon sets to the clipboard.
				 * So, I did a similar thing. But then the following happens: The user
				 * copies an iSet to the clipboard, and when he presses Ctrl-V
				 * afterwards, an image is pasted. I found that confusing, so I disabled
				 * the code for copying a GString to the clipboard using this compiler flag.
				 * The default value is 0.
				 */

@define ALLOW_POINTER_DEF_32_AND_64	0
				/* Standard mouse pointers are declared with PointerDef16 structure. There are
				 * also the structures PointerDef32 and PointerDef64, but the system does not
				 * support them (07/2026). Probably they will be supported later. The code
				 * is prepared to use them, but preview and writeing as source code could not
				 * be tested.
				 * If you enable this flag, don't forget to update the following text objects:
				 * AddPointerImageInfoText, MousePointerInfoText
				 * The default value is 0.
				 */

/*
 * Set up Icons width, height and data size
 */

#define MAX_SAFE_MONIKER_SIZE_DEFAULT      (8192 + sizeof(CBitmap))    /* 8k data blocks */
#define MAX_SAFE_MONIKER_SIZE      (global.maxSaveMonikerSize)	/* there is a hidden feature
					 * to allow icons that are (slightly) larger than 8 kB.
					 * See MSG_GEN_PROCESS_OPEN_APPLICATION for details */

#define MAX_DEFAULT_ICON_WIDTH	1024
#define MAX_DEFAULT_ICON_HEIGHT (MAX_DEFAULT_ICON_WIDTH)
#define MAX_ICON_WIDTH		(global.maxMonikerImageSize)
#define MAX_ICON_HEIGHT		(global.maxMonikerImageSize)	/* There is another hidden feature
					* that allows override the maximum width and height of an
					* icon.
					* See MSG_GEN_PROCESS_OPEN_APPLICATION for details, in particular
					* if you add a GenValue for entering icon's width or height. */


#define	MAX_ICONS		128	/* Each icon set can have max. 128 icons. In fact, there is
					 * a limit of about 175 icons or the ISetTransferTree block,
					 * used when copying icon sets to the clipboard, will extend
					 * the 8kb limit. On the other hand, 128 icons are a lot!
					 * They can never fit in the same resource!
					 * See also TooManyIconsText chunk if you change this value */
#define MAX_SEARCH_RESULT_ICONS	256	/* We can find (and import) max. 256 icons for each token
					 * in the token database. This is much more that
					 * our MAX_ICONS if anyone has broken this limit.
					 * If we really have 256 icons and export all them to the
					 * clipboard, ISetTransferTree block will be about 11kB.
					 * Usually the system can handle this whitout problems.
					 * You should not increase this value, but if you change
					 * this value, update TooManyIconsInToken text too.  */



@if @DEBUG_FLAG
	// --> debug.goc
void DebugInfo(char* text);
void DebugInfo1(char *text, word val);
void DebugInfo2(char *text, word val, word val2);
void DebugInfo1DW(char *text, dword val);
void DebugInfo2DW(char *text, dword val, dword val2);
void DebugBuffer(byte *bPtr, int count);
void DebugClearText(void);
void WWFToASCII(char *buffer, WWFixedAsDWord wwf, Boolean addHex);
void DebugWWF(char *txt, WWFixedAsDWord wwf);
void DebugDocMsg(optr docObj, char *txt);

void TestPrintIconData(VMFileHandle vmFile, int iSet);
void TestPrintMainArray(VMFileHandle vmFile, VMBlockHandle mainArray);
Boolean FullCheckDatabase(VMFileHandle vmFile);
Boolean CheckVMBlockValid(VMFileHandle vmFile, VMBlockHandle block);

void FullCheckIconsInTokenDB(void);

void DebugDisplayVMListEntry(VisMonikerListEntryType vmlet);
void DebugDumpMoniker(VisMonikerWithGString *monikerPtr, int idNr);
void DebugDisplayBitmapHeader(VMFileHandle vmFile, VMBlockHandle bmpHandle);
void DebugDisplayBitmapHeaderPtr(CBitmap* header);

int PrintFreeHandles(char *text);

@elseif

#define DebugInfo(t)
#define DebugInfo1(t,n)
#define DebugInfo2(t,n, k)
#define DebugInfo1DW(t,n)
#define DebugInfo2DW(t,n, k)
#define DebugBuffer(bPtr, count)
#define DebugClearText()
#define WWFToASCII(buffer, wwf, addHex)
#define DebugWWF(txt, wwf)
#define CheckVMBlockValid(vmFile, block) FALSE

#define DebugDocMsg(docObj, txt)

#define DebugDisplayVMListEntry(vmlet)
#define DebugDumpMoniker(monikerPtr, idNr)
#define DebugDisplayBitmapHeader(vmFile, bmpHandle)
#define DebugDisplayBitmapHeaderPtr(header)

#define PrintFreeHandles(text)

@endif



#endif	/* _ICONCFG_GOH */

/* *********** End of file config.goh ********************/


