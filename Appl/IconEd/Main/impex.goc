 ***********************************************************************/
/*--------------------- MSG_DB_VIEWER_IMPORT_GRAPHIC_FILE ---------------------
 *  Purpose:	Initiate Import via impex library
 *  Context:
 *  Strategy:
 *  Parameters:	void (void);
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass,MSG_DB_VIEWER_IMPORT_GRAPHIC_FILE {

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;
    @send IconImportControl::MSG_GEN_INTERACTION_INITIATE();
}

/*--------------------- MSG_DB_VIEWER_PREPARE_FOR_IMPORT ---------------------
 * Purpose:	Copy imported meta-data (standard GEOS format) for our own use.
 * Context:	Part of the GEOS import handling
 * Strategy:	- copy data for our own use.
 *		- call ImpexImportExportCompleted()
 *		  That's all.
 * Parameters:	void (ImpexTranslationParams impexParams);
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_PREPARE_FOR_IMPORT {
VMBlockHandle	graphic;
Boolean 	isGString;

  do {		// ensure ImpexImportExportCompleted(&impexParams);


/*
DBVI_importCreateNewISet entfernen
Triggerr auslichten

*/
    /*
     * Get gstring or bitmap from impexParams
     */
    isGString = TRUE;
    switch ( impexParams.ITP_clipboardFormat) {
      case CIF_BITMAP:
      	isGString = FALSE;
      case CIF_GRAPHICS_STRING:
	  {
	  VMChain	newChain;
	  newChain = VMCopyVMChain(impexParams.ITP_transferVMFile,
			impexParams.ITP_transferVMChain,
			global.tempFile);
	  graphic = newChain >> 16;
	  }
	  break;

      default:
	  ErrorBoxOptr(@InvalidClipboardFormat);
	  break;
	  }

      } while (0);

  /* Tell the system that we are done. */
  ImpexImportExportCompleted(&impexParams);

  @send process::MSG_ICON_IMPORT_GRAPHIC_WITH_DIALOGS(graphic, isGString);

}

/*--------------------- MSG_DB_VIEWER_EXPORT_ICON_TO_GRAPHIC_FILE ---------------------
 *  Purpose:	Initia export icon graphic to file via impex library
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_EXPORT_ICON_TO_GRAPHIC_FILE {

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;
    @send IconExportControl::MSG_GEN_INTERACTION_INITIATE();
}

/*--------------------- MSG_DB_VIEWER_PREPARE_FOR_EXPORT ---------------------
 * Purpose: 	Prepare data for the export library
 * Context:	Part of the Import handling of the GEOS system
 * Strategy:	- set up a gstring that hold the icon's image
 *		- draw image to the gstring
 *		- call ImpexImportExportCompleted()
 *		  That's all.
 * Parameters:	void (ImpexTranslationParams impexParams);
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_PREPARE_FOR_EXPORT {
GStateHandle 	gstate;
VMBlockHandle	gString;
VMBlockHandle iconBmp;

  AppMarkBusy();

  do {
     impexParams.ITP_transferVMChain = 0;	// worst case
     impexParams.ITP_manufacturerID = 0;	// GeoWorks
     impexParams.ITP_clipboardFormat = CIF_GRAPHICS_STRING;

     /*
      * Create GString
      * get image of the current icon and draw it
      * clean up
      */
     gstate =  GrCreateGString(impexParams.ITP_transferVMFile,GST_VMEM,&gString);
     if ( !gstate ) break;

     iconBmp = IdGetEntryBitmap(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);
     GrDrawHugeBitmap(gstate, 0, 0, pself->DBVI_vmFile, iconBmp);
     GrEndGString(gstate);

     GrDestroyGString(gstate,0,GSKT_LEAVE_DATA);

     impexParams.ITP_transferVMChain = gString;
     impexParams.ITP_transferVMChain <<= 16;

     } while (0);

  /* Tell the system that we are done. */
  ImpexImportExportCompleted(&impexParams);

  AppMarkNotBusy();

}

/*--------------------- ToolUpdateWTFPath ---------------------
 *  Purpose:	Update WTFPathText to reflect the actual path
 *  Context:
 *  Strategy:
 	- Read path from WriteToVMFileDialog object
 	- if not found, use SP_DOCUMENT
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void ToolUpdateWTFPath(void) {
GenFilePath *gfp = 0;
char *fpp, *fullPath = 0;
Boolean found;

    /*
     * Last used path is stored in ATTR_GEN_PATH_DATA of the dialog object
     */
    gfp = malloc(sizeof(GenFilePath));
    fullPath = malloc(IE_FULL_PATH_BUFFER_SIZE);

    found = @call WriteToVMFileDialog::MSG_META_GET_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);
    if (found == (-1)) {
        FilePushDir();
    	WriteSourceWTFEnterDefaultPath(@IniVMPathKey);
        gfp->GFP_disk = FileGetCurrentPath (gfp->GFP_path, sizeof(PathName));
        FilePopDir();
    }

    fpp = fullPath;
    FileConstructFullPath (&fpp, IE_FULL_PATH_BUFFER_SIZE, gfp->GFP_disk, gfp->GFP_path, TRUE);
    @call WTFPathText::MSG_VIS_TEXT_REPLACE_ALL_PTR(fullPath, 0);

    free(gfp);
    free(fullPath);
}



/*--------------------- MSG_DB_VIEWER_INITIALIZE_WRITE_TO_VM_FILE_DIALOG ---------------------
 *  Purpose:	Sii if token is dirty and set up WriteToVMFileDialog UI
 *  Return:	TRUE, if canceled by user or no icon set available
 *		FALSE if dialog box can opned (even if not ready for export)
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_INITIALIZE_WRITE_TO_VM_FILE_DIALOG {

    if ( pself->DBVI_currentISet == NO_CURRENT_ISET ) return TRUE;
    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return TRUE;

    ToolUpdateWTFPath();
    return FALSE;
}


/*--------------------- MSG_ICON_DO_WRITE_TO_VM_FILE_DIALOG ---------------------
 *  Purpose:	Execute WriteToVMFileDialog - let the user select options to
 *		write an icons image to a vm file.
 *  Context:
 *  Strategy:
 *	- open WriteToVMFileDialog and let the user do some choices
 *	- if IC_SELECT_PATH is returned, open a "select path" dialog box
 *	   + Last used path is stored in ATTR_GEN_PATH_DATA of WriteToVMFileDialog object
 *	   + Store the new path in ATTR_GEN_PATH_DATA of WriteToVMFileDialog object
 *	- let DBViewerContent do the save-to-file job
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconProcessClass, MSG_ICON_DO_WRITE_TO_VM_FILE_DIALOG {
int cmd, cmd2, err;
GenFilePath *gfp = 0;
Boolean found;


    AppMarkBusy();
    err = @call CombineGCurDisplayWith(@DBViewerContent)::MSG_DB_VIEWER_INITIALIZE_WRITE_TO_VM_FILE_DIALOG();
    AppMarkNotBusy();
    if (err) return;

    /*
     * exexute WriteToVMFileDialog and fetch setting from the dialog
     */
doDialog:
    cmd = UserDoDialog(@WriteToVMFileDialog);

    /*
     * if cmd == IC_SELECT_PATH: select path to vm file
     */
    if (cmd == IC_SELECT_PATH) {

	/*
	 * Set path. Last used path is stored in ATTR_GEN_PATH_DATA of
	 * the dialog object (see below)
	 */
        FilePushDir();
	if (!gfp) gfp = malloc(sizeof(GenFilePath));
	found = @call WriteToVMFileDialog::MSG_META_GET_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);

	if (found != (-1)) {
	    FileSetCurrentPath(gfp->GFP_disk, gfp->GFP_path);
	} else {
	    WriteSourceWTFEnterDefaultPath(@IniVMPathKey);
	}

        /*
         * Request Path.
         */
        MemLock(OptrToHandle(@WTFPathTitle));
	cmd2 = FileToolRequestChangeDir(@WTFPathInfoText, LMemDeref(@WTFPathTitle), NULL, TRUE);
        MemUnlock(OptrToHandle(@WTFPathTitle));

    	if ( cmd2 == IC_OK) {
	    /*
	     * Store current path in ATTR_GEN_PATH_DATA of the dialog object
	     * Update UI
	     */
	    gfp->GFP_disk = FileGetCurrentPath (gfp->GFP_path, sizeof(PathName));
	    @call WriteToVMFileDialog::MSG_META_ADD_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);
	    ToolUpdateWTFPath();
    	}

	/* Restart dialog */
	FilePopDir();
        goto doDialog;
    }		// end of select geode


    /*
     * free path buffer
     */
    if(gfp) free(gfp);

    if ( cmd != IC_WRITE_TO_VM_FILE ) return;

    /*
     * Write icon image to vmFile
     */
    err = @call CombineGCurDisplayWith(@DBViewerContent)::MSG_DB_VIEWER_EXPORT_ICON_TO_VM_FILE();
    if (err) goto doDialog;

}

/*--------------------- WTFEnterPath ---------------------
 *  Purpose:	Set path for write. Last used path is stored in ATTR_GEN_PATH_DATA of
	 	the WriteToVMFileDialog dialog object
 ---------------------------------------------------------------------------*/
void WTFEnterPath(void) {
GenFilePath *gfp;
Boolean found;

    gfp = malloc(sizeof(GenFilePath));
    found = @call WriteToVMFileDialog::MSG_META_GET_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);

    if (found != (-1)) {
	FileSetCurrentPath(gfp->GFP_disk, gfp->GFP_path);
    } else {
	WriteSourceWTFEnterDefaultPath(@IniVMPathKey);
    }

    free(gfp);
}

/*--------------------- MSG_DB_VIEWER_EXPORT_ICON_TO_VM_FILE ---------------------
 *  Purpose:	Write the current icon to a vm file
 *  Context:
 *  Strategy:	see code
 *  Parameters:	-
 *  Return:	TRUE in case of any error
 *		FALSE: ok
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_EXPORT_ICON_TO_VM_FILE {
int 		cmd;
FileLongName 	fileName;
VMFileHandle	dataFile, bmpFile;
VMBlockHandle	imgBmp, bmpToUse, mapBlock;
VMChain	nChain, oChain;
Boolean	err = TRUE;
Boolean	freeBmp = FALSE;
word	options;
int 	idx, redOrIndex, green, blue;
GenFilePath *gfp;
char *fpp, *fullPath = 0;

    @call WriteToFileNameText::MSG_VIS_TEXT_GET_ALL_PTR(fileName);

    /*
     * Enter folder, create file and set
     * the bitmap as Map block of the file
     */
    FilePushDir();
    WTFEnterPath();

    do {

    	/*
    	 * See if the file already exists. Ask the user for overwrite.
    	 */
    	if (FileToolExistFile(fileName) ) {
    	    MemLock(OptrToHandle(@WSQuestionOverwriteFile));
    	    cmd = UserStandardDialog ( (char *)0,(char *)0,(char *)0,
    			fileName,LMemDeref(@WSQuestionOverwriteFile), \
			(( CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) | \
			 ( GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET)) );
    	    MemUnlock(OptrToHandle(@WSQuestionOverwriteFile));

	    if (cmd != IC_YES) break;
    	}

    	/*
    	 * Open file and handle errors
    	 * break: leave the do-while-loop (do not write to file)
    	 */
    	dataFile = VMOpen(fileName, VMAF_FORCE_READ_WRITE | VMAF_FORCE_DENY_WRITE , VMO_CREATE_TRUNCATE, 0);
	if (!dataFile) {
	    err = ThreadGetError();
	    switch (err) {
		case VM_SHARING_DENIED:
		case VM_OPEN_INVALID_VM_FILE:
		case VM_TRUNCATE_FAILED:
		case VM_WRITE_PROTECTED:
		case VM_CANNOT_OPEN_SHARED_MULTIPLE:
		    ErrorBoxOptrString(@WSErrorAccessDenied, fileName);
		    break;
		case ERROR_INVALID_LONGNAME:
		    ErrorBoxOptrString(@WSErrorInvalidName, fileName);
		    break;
		default:
		    ErrorBoxOptrString(@WSErrorCommon, fileName);
	    }
	    break;
       	}

	/*
	 * store path in the geos.ini for later use
	 */
	gfp = malloc(sizeof(GenFilePath));
	fullPath = malloc(IE_FULL_PATH_BUFFER_SIZE);

	gfp->GFP_disk = FileGetCurrentPath (gfp->GFP_path, sizeof(PathName));
	fpp = fullPath;
	FileConstructFullPath (&fpp, IE_FULL_PATH_BUFFER_SIZE, gfp->GFP_disk, gfp->GFP_path, TRUE);
	MemLock(OptrToHandle(@IniVMPathKey));
	InitFileWriteString(IE_INI_CATEGORY, LMemDeref(@IniVMPathKey), fullPath);
	MemUnlock(OptrToHandle(@IniVMPathKey));

	free(fullPath);
	free(gfp);

    	/*
    	 * Get Bitmap from current icon
    	 * Get options and create a proper bitmap
    	 * Set up bmpFile and bmpToUse properly
     	 */
    	imgBmp = IdGetEntryBitmap(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);
	options = @call WTFOptionsGroup::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();

	bmpFile = pself->DBVI_vmFile;
	bmpToUse = imgBmp;

    	/*
    	 * if appropriate, remove mask
     	 */
	if ( (options & WTFO_WRITE_MASK) == 0 ) {
	    /* get RGB values for a white background */
	    idx = IconGetWhiteColor(pself->DBVI_vmFile, imgBmp, &redOrIndex, &green, &blue);
	    bmpFile = global.tempFile;
	    bmpToUse = BTCopyBitmapAndRemoveMask(pself->DBVI_vmFile, imgBmp,
			global.tempFile, redOrIndex, green, blue, 0);
	    freeBmp = TRUE;

	}

    	/*
    	 * if appropriate, compact bitmap
     	 */
	if ( options & WTFO_COMPACT_BITMAP ) {
	    VMBlockHandle newBlock;

	    newBlock = GrCompactBitmap(bmpFile, bmpToUse, global.tempFile);
	    if (freeBmp) {
	    	// We had already a copy: free it
	    	HugeArrayDestroy(bmpFile, bmpToUse);
	    }
	    bmpFile = global.tempFile;
	    bmpToUse = newBlock;
	    freeBmp = TRUE;
	}

	/*
	 * Now copy the bitmap to the data file
	 */
	oChain = bmpToUse;	// 16 to 32 Bit
	nChain = VMCopyVMChain(bmpFile,( oChain << 16 ), dataFile);
	mapBlock = (VMBlockHandle)(nChain >> 16);

	VMSetMapBlock(dataFile, mapBlock);
    	VMClose(dataFile, FALSE);

	if ( freeBmp ) HugeArrayDestroy(bmpFile, bmpToUse);
	err = FALSE;
    	MessageBoxOptr(@WriteToFileSuccessText);

    } while(FALSE);

    FilePopDir();
    return err;
}



