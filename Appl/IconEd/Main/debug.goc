/*--------------------- TestPrintIconList ---------------------
 *  Purpose:	Print whole Mapblock's mainArray
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void TestPrinMainArray(VMFileHandle vmFile, VMBlockHandle mainArray) {
int count, n;
    count = HugeArrayGetCount(vmFile, mainArray);
DebugInfo1("\rNumber of Icon sets = %u", count );

    if ( count ) for ( n = 0; n < count; n++ ) {
    TestPrintIconData(vmFile, n);
    }
}

