 ---------------------------------------------------------------------------*/
void TestPrintIconData(VMFileHandle vmFile, int iSet) {
/*
typedef struct {
	char 	ISH_name[MAX_ISET_NAME_LENGTH];
	PreviewSettingsType ISH_preview_unused;	/* current preview object * /
	IconFlags 	ISH_flags;		/* various (ptr image, etc) * /
