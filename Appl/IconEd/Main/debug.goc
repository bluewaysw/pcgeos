					   in the iconEntry list * /
	optr 	ISH_entryList;		/* block & chunk for chunkarray * /
} ISetHeader;


typedef struct {
	char 	IE_name[MAX_ICON_NAME_LENGTH];	/* name * /
	VisMonikerListEntryType IE_type;
	word 	IE_bitmap;			/* chunk array block & chunk * /
	word 	IE_extraBlock;			/* for later additions * /
} IconEntry;
*/

ISetHeader	*iHeader;
