char 	buf[MAX_ISET_NAME_LENGTH + 2];
VMBlockHandle	arrayBlock;
ChunkHandle 	arrayChunk;
//MemHandle	mh;

optr	iEntryList;
	/*
	 * Test Id.. routines
	 */

	DebugInfo1("\r---------- Print IconData iSet %u", iSet);

	DebugInfo("\rIcon-Name: ");
	IdGetISetName(vmFile, iSet, buf);
