int stopswat(void) { int x = 12; return x; }	// debug feature to stop swat in the middle of a routine


/*---------------------	CheckVMBlockValidOrZero -------------------------------*
 * 	Purpose:	Check if VMHandle is valid or zero
 	Return:		TRUE in case of error
 *----------------------------------------------------------------------*/
Boolean CheckVMBlockValidOrZero(VMFileHandle vmFile, VMBlockHandle block)
{
VMInfoStruct info;
Boolean err;

	if (block == 0 ) return FALSE;		// allowed here

	// VMInfo checks if the block is valid
	// returns TRUE, if valid (checked with swat)
	err = ! ( VMInfo (vmFile, block, &info) );
	return err;

}

/*---------------------	CheckVMBlockValid -------------------------------*
 * 	Purpose:	Check if VMHandle is valid
 	Return:		TRUE in case of error
 *----------------------------------------------------------------------*/
Boolean CheckVMBlockValid(VMFileHandle vmFile, VMBlockHandle block)
{
VMInfoStruct info;
Boolean err;

	// Zero is invalid here
	if (!block) return TRUE;

	// VMInfo checks if the block is valid
	// returns TRUE, if valid (checked with swat)
	err = ! ( VMInfo (vmFile, block, &info) );
	return err;

}

/*---------------------	DebugDisplayVMListEntry -------------------------------*
 * 	Purpose:	Show VisMonikerListEntryType briefly
 *----------------------------------------------------------------------*/
void DebugDisplayVMListEntry(VisMonikerListEntryType vmlet) {
@if 0
typedef WordFlags VisMonikerListEntryType;	!<---

#define VMLET_GS_SIZE 		0x3000	/* DisplaySize */
#define VMLET_STYLE		0x0f00  /* VMStyle */
#define VMLET_MONIKER_LIST	0x0080
#define VMLET_GSTRING		0x0040
#define VMLET_GS_ASPECT_RATIO	0x0030	/* DisplayAspectRatio */
#define VMLET_GS_COLOR		0x000f	/* DisplayClass */

#define VMLET_GS_SIZE_OFFSET 12
#define VMLET_STYLE_OFFSET 8
#define VMLET_GS_ASPECT_RATIO_OFFSET 4
#define VMLET_GS_COLOR_OFFSET 0
@endif
word	val;

     DebugInfo1("\rVMLE=%04X", vmlet);

     if (vmlet & VMLET_GSTRING) { DebugInfo(", gs"); }
     	else { DebugInfo(", GS NOT SET"); }

     if (vmlet & VMLET_MONIKER_LIST) { DebugInfo(", LIST IS SET"); }

     val = (vmlet & VMLET_GS_SIZE) >> VMLET_GS_SIZE_OFFSET;
     switch (val) {
     case     DS_TINY:  DebugInfo(", tiny"); break;
     case     DS_STANDARD:  DebugInfo(", std"); break;
     case     DS_LARGE:  DebugInfo(", large"); break;
     case     DS_HUGE:  DebugInfo(", huge"); break;
     default:  DebugInfo(", SIZE?"); break;
     }

     val = (vmlet & VMLET_STYLE) >> VMLET_STYLE_OFFSET;
     switch (val) {
     case     VMS_ICON:  DebugInfo(", icon"); break;
     case     VMS_TOOL:  DebugInfo(", tool"); break;
     default:  DebugInfo(", STYLE?"); break;
     }

     val = vmlet & VMLET_GS_COLOR;	// Shift offset is zero
     switch (val) {
     case     DC_GRAY_1:  DebugInfo(", mono"); break;
     case     DC_COLOR_4:  DebugInfo(", col4"); break;
     case     DC_COLOR_8:  DebugInfo(", col8"); break;
     case     DC_CF_RGB:  DebugInfo(", RGB"); break;
     default:  DebugInfo(", COLOR?"); break;
     }

     val = (vmlet & VMT_GS_ASPECT_RATIO) >> VMLET_GS_ASPECT_RATIO_OFFSET;
     switch (val) {
     case     DAR_NORMAL:  DebugInfo(", norm"); break;
     case     DAR_SQUISHED:  DebugInfo(", sqish"); break;
     case     DAR_VERY_SQUISHED:  DebugInfo(", vSquish"); break;
     default:  DebugInfo(", ASPECT?"); break;
     }

}

/*---------------------	DebugDumpMoniker -------------------------------*
 * 	Purpose:
 *----------------------------------------------------------------------*/
void DebugDumpMoniker(VisMonikerWithGString *monikerPtr, int idNr) {
int type;
int color, aspect, cmd, bmpSize;
byte *bPtr;

    DebugInfo1("\r+++ Debug Moniker %u ++++", idNr);

// -- VisMoniker Part
    type = monikerPtr->VMWGS_common.VM_type;
    if ( type & VMT_MONIKER_LIST ) DebugInfo("\r - is MONIKER_LIST -");
    if ( (type & VMT_GSTRING) == 0 ) {
    	DebugInfo1("\r - NO GSTRING - width=%u", monikerPtr->VMWGS_common.VM_width);
    	return;
    }
    color = type & VMT_GS_COLOR;
    aspect = (type & VMT_GS_ASPECT_RATIO) >> 4;
    DebugInfo2("\rColor=%u, aspect=%u", color, aspect);

    DebugInfo2("\rSize =%ux%u", monikerPtr->VMWGS_common.VM_width, monikerPtr->VMWGS_height);

// -- GString part
    bPtr = (void*)monikerPtr;
    bPtr += sizeof(VisMonikerWithGString);

    cmd = *bPtr;
    bPtr++;
    bmpSize = *((word*)bPtr);
    bPtr += 2;
    DebugInfo2("\rcmd = %u, %u bytes", cmd, bmpSize);

// Bitmap header
   DebugDisplayBitmapHeaderPtr((CBitmap*) bPtr);

// End GString - bPtr muss noch auf Bitmap header zeigen
   DebugInfo1("\rGS-End-Cmd = %02X", bPtr[bmpSize]);
   if (bPtr[bmpSize] != GR_END_GSTRING) DebugInfo("  BAD!");

}

/*---------------------	DebugDisplayBitmapHeader -------------------------------*
 * 	Purpose:
 *----------------------------------------------------------------------*/
void DebugDisplayBitmapHeader(VMFileHandle vmFile, VMBlockHandle bmpHandle) {
CBitmap* header;
MemHandle mh;
int  n;
word	size;
byte *data;


    header = BTBitmapToolLockHeader(vmFile, bmpHandle, &mh);
    DebugDisplayBitmapHeaderPtr(header);
    VMUnlock(mh);

    // Erste Zeile
    DebugInfo("\rFirst Line Content:");
    HugeArrayLock(vmFile, bmpHandle, 0, (void**)&data, &size);
    for (n = 0; n < 8; n++) DebugInfo1(" %02X",data[n]);
    HugeArrayUnlock(data);
}


/*---------------------	DebugDisplayBitmapHeaderPtr -------------------------------*
 * 	Purpose:
 *----------------------------------------------------------------------*/
void DebugDisplayBitmapHeaderPtr(CBitmap* header) {
word	width, height, compact, type;

@if 0
/* Simple Bitmap Structure */

typedef struct {
    word	B_width;
    word	B_height;
    byte	B_compact;
    byte	B_type;
} Bitmap;

/* Complex Bitmap Structure */

typedef struct {
    Bitmap	CB_simple;
    word	CB_startScan;
    word	CB_numScans;
    word	CB_devInfo;
    word	CB_data;
    word	CB_palette;
    word	CB_xres;
    word	CB_yres;
} CBitmap;
@endif

    // Simple Bitmap Data
    width = header->CB_simple.B_width;
    height = header->CB_simple.B_height;
    compact = header->CB_simple.B_compact;
    type = header->CB_simple.B_type;

    DebugInfo("\r**Bitmap Header **");
    DebugInfo2("\r  %ux%u", width, height);
    if (compact) DebugInfo1(", comp=%u", compact);

    switch (type & BMT_FORMAT) {
	case BMF_MONO: DebugInfo(", mono"); break;
	case BMF_4BIT: DebugInfo(", 4Bit"); break;
	case BMF_8BIT: DebugInfo(", 8Bit"); break;
	case BMF_24BIT: DebugInfo(", RGB"); break;
	default: DebugInfo(", COLOR?");
	}

    if (type & BMT_HUGE) DebugInfo(", HUGE");
    if ( (type & BMT_MASK) == 0) DebugInfo(", no Mask");
    if (type & BMT_PALETTE) DebugInfo(", Palette");
    if ( (type & BMT_COMPLEX) ==0 ) {
    	DebugInfo(", simple");
    	return;
    }

    // Complex data
    DebugInfo2("\rScan start=%u num=%u",header->CB_startScan, header->CB_numScans);
    DebugInfo1("\rCB_devInfo = %u", header->CB_devInfo);
    DebugInfo1("\rCB_data =%u", header->CB_data);
    DebugInfo1("\rCB_palette =%u", header->CB_palette);
    DebugInfo2("\rResolution %ux%u", header->CB_xres, header->CB_yres);

}

