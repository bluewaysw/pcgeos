/*---------------------------------------------------------------------------
	complete Full-Chek of a file (icon database)

	Boolean FullCheckDatabase(VMFileHandle vmFile)

 ---------------------------------------------------------------------------*/
Boolean FullCheckDatabaseInternal(VMFileHandle vmFile);

/* return TRUE  in case of error */
Boolean FullCheckDatabase(VMFileHandle vmFile) {
Boolean err;
	err = FullCheckDatabaseInternal(vmFile);
	if (err) MessageBox("FullCheckDatabase Failed");
	return err;
}

/* -- FullCheckDatabaseInternal --*/
Boolean FullCheckDatabaseInternal(VMFileHandle vmFile) {
VMBlockHandle iconArray;
int NumSets, iSet, count1, count2, len, entryCount, icon;
word size;
ISetHeader	*iHeader;
IconEntry *iconEntry;
char buffer[60];
MemHandle	mh;
ChunkHandle	arrayChunk;
VMBlockHandle	arrayBlock;
optr	iEntryList;


    DebugInfo("\r--- FullCheckDatabase ---");

    iconArray = IdGetHugeArray(vmFile);
    if (CheckVMBlockValid(vmFile, iconArray)) {
    	DebugInfo1("\rInvalid IconArray %X", iconArray);
    	return TRUE;
    	}

    NumSets = HugeArrayGetCount(vmFile, iconArray);
    DebugInfo1("\rNumSets = %u", NumSets);

    /* Alle icon sets full checken */
    iSet = 0;
checkNextIcon:
    DebugInfo1("\r+++ Icon-Set Nr. %u", iSet);

    iHeader = IdLockIconHeader(vmFile, iSet);
    if (!iHeader) {
    	DebugInfo("\rIcon-Set does not exist");
    	return TRUE;
    	}

    /*
     * Print ISetHeader
     */

    // Name (special case 32 characters not implemented!)
    len = strlen(iHeader->ISH_name);
    DebugInfo1("\rIconName len = %u \r>", len);
    DebugInfo(iHeader->ISH_name);
    DebugInfo("<\r>");
    IdGetISetName(vmFile, iSet, buffer);
    DebugInfo(buffer);
    DebugInfo("<");
    if (strcmp(buffer, iHeader->ISH_name)) {
    	DebugInfo("\rError in IdGetISetName");
    	IdUnlockIconHeader(iHeader, FALSE);
    	return TRUE;
    	}

    // Rest
    DebugInfo1("\rISH_entryCount = %u", iHeader->ISH_entryCount);
    DebugInfo1("\rISH_iEntryListArray = %u", (word)iHeader->ISH_iEntryListArray);
    DebugInfo1("\rISH_iEntryListBlock = %u", iHeader->ISH_iEntryListBlock);

    arrayBlock = iHeader->ISH_iEntryListBlock;
    arrayChunk = iHeader->ISH_iEntryListArray;
    entryCount = iHeader->ISH_entryCount;

    IdUnlockIconHeader(iHeader, FALSE);

    // Check EntryListBlock
    if (CheckVMBlockValid(vmFile, arrayBlock)) {
    	DebugInfo1("\rInvalid ISH_iEntryListBlock %X", iconArray);
    	return TRUE;
    	}

    DebugInfo("\r---Check entryListBlock");
    VMLock(vmFile,  arrayBlock, &mh);
    DebugInfo1("\rMan. Lock: mh=%u, ", mh);
    count1 = ChunkArrayGetCountHandles(mh, arrayChunk);
    DebugInfo1(" count =%u", count1);
    ECCheckChunkArrayHandles(mh, arrayChunk);
    VMUnlock(mh);

    iEntryList = IdLockEntryList(vmFile, iSet);
    count2 = ChunkArrayGetCount(iEntryList);
    DebugInfo2("\rId-Lock: mh=%u, count = %u", OptrToHandle(iEntryList), count2);
    ECCheckChunkArray(iEntryList);
    IdUnlockEntryList(iEntryList, FALSE);

    if (count1 != count2) {
    	DebugInfo2("\rChunkArray Count differs %u vs %u", count1, count2);
    	return TRUE;
    	}
    if (count1 != entryCount) {
    	DebugInfo2("\rentryCount %u differs vs ChunkArray Count %u", count1, entryCount);
    	return TRUE;
    	}

    /*
     * Print IconEntry
     */

    iEntryList = IdLockEntryList(vmFile, iSet);
    for (icon = 0; icon < entryCount; icon++ ) {
    	DebugInfo1("\r+++ Icon Nr. %u", icon);
    	iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);

	// Name (special case 32 characters not implemented!)
	// no check for IdGetEntryName double locked
    	len = strlen(iconEntry->IE_name);
    	DebugInfo1("\rIconName len = %u >", len);
    	DebugInfo(iconEntry->IE_name);
    	DebugInfo("<");

	DebugDisplayVMListEntry(iconEntry->IE_type);

        DebugInfo2("\rBitmap=%u, extrablock=%u", iconEntry->IE_bitmap, iconEntry->IE_extraBlock);
    	if (CheckVMBlockValid(vmFile, iconEntry->IE_bitmap)) {
    	    DebugInfo1("\rInvalid Bitmap Block %X", iconEntry->IE_bitmap);
    	    return TRUE;
    	    }

	DebugDisplayBitmapHeader(vmFile, iconEntry->IE_bitmap);

    	}
    IdUnlockEntryList(iEntryList, FALSE);

    // Icon-Set done
    iSet++;
    if (iSet < NumSets) goto  checkNextIcon;
    DebugInfo("\r------- DONE --------");
    return FALSE;

}


/*---------------------------------------------------------------------------
	Undo - Debugging
 ---------------------------------------------------------------------------*/
void DebugUndoHeader(char *info, UndoChainHeader *header) {
// info : nullpointer erlaubt
int start, end;

    if (info) if (strlen(info)) DebugInfo(info);

    DebugInfo1("\rNext-Index=%u", header->nextIndex);

    DebugInfo1("\r  %uxUndo", header->undoCount);
    if (header->undoCount) {

    	start = header->nextIndex - header->undoCount;
    	if (start < 0) start += UNDO_BUFFER_SIZE;

    	end = start + header->undoCount - 1;
    	if ( end >= UNDO_BUFFER_SIZE ) end -= UNDO_BUFFER_SIZE;
	DebugInfo2(": %u (%u)", start, header->undoArray[start].iconBitmap);
	DebugInfo2("-%u (%u)", end, header->undoArray[end].iconBitmap);
    }

    DebugInfo1("\r  %uxRedo", header->redoCount);
    if (header->redoCount) {

    	start = header->nextIndex + 1;
    	if (start >= UNDO_BUFFER_SIZE ) start -= UNDO_BUFFER_SIZE;

    	end = start + header->redoCount - 1;
    	if ( end >= UNDO_BUFFER_SIZE ) end -= UNDO_BUFFER_SIZE;
	DebugInfo2(": %u (%u)", start, header->undoArray[start].iconBitmap);
	DebugInfo2("-%u (%u)", end, header->undoArray[end].iconBitmap);
    }
}


/*---------------------------------------------------------------------------
	Routines - Debug~
 ---------------------------------------------------------------------------*/
void DebugInfo(char* text) {
    @call IconDebugText::MSG_VIS_TEXT_APPEND_PTR(text, 0);
}

void DebugInfo1(char *text, word val) {
char buffer[100];
    sprintf(buffer, text, val);
    @call IconDebugText::MSG_VIS_TEXT_APPEND_PTR(buffer, 0);
}

void DebugInfo2(char *text, word val, word val2) {
char buffer[100];
    sprintf(buffer, text, val, val2);
    @call IconDebugText::MSG_VIS_TEXT_APPEND_PTR(buffer, 0);
}


void DebugInfo1DW(char *text, dword val) {
char buffer[100];
    sprintf(buffer, text, val);
    @call IconDebugText::MSG_VIS_TEXT_APPEND_PTR(buffer, 0);
}

void DebugInfo2DW(char *text, dword val, dword val2) {
char buffer[100];
    sprintf(buffer, text, val, val2);
    @call IconDebugText::MSG_VIS_TEXT_APPEND_PTR(buffer, 0);
}

void DebugBuffer(byte *bPtr, int count) {
char buffer[20];
int n;
dword dw;

     dw = (dword)bPtr;
     DebugInfo2("\rbytes at %04X:%04X\r", (dw>>16) & 0xFFFF, dw & 0xFFFF);
     n = 0;
     while (n < count) {
     	sprintf(buffer, " %02X", bPtr[n]);
     	DebugInfo(buffer);
     	n++;
     	if ( (n & 0x07) == 0) DebugInfo("\r");
     }
}


void DebugClearText(void) {
    @call IconDebugText::MSG_VIS_TEXT_DELETE_ALL();
}


/*---------------------  ---------------------
 *  Purpose:
 ---------------------------------------------------------------------------*/
void WWFToASCII(char *buffer, WWFixedAsDWord wwf, Boolean addHex) {
char *p;
word	i, f;
WWFixedAsDWord  sik;

     p = buffer;
     *p =0;
     sik = wwf;
     i = (wwf>>16) & 0xFFFF;
     f = wwf & 0xFFFF;



     // Negative Zahl?
     if ( i & 0x8000 ) {
     	wwf = 0-wwf;
	i = (wwf>>16) & 0xFFFF;
	f = wwf & 0xFFFF;
     	*p = '-';
     	p++;
     	}


     // Ganzzahligen Teil
     UtilHex32ToAscii(p, i, UHTAF_NULL_TERMINATE);
     strcat(p, ".");
     p = strchr(p, 0);

     // Gebrochener Teil: Q'Dirty - 3 Nachkommastellen ohne Runden
     i = 0;
     if (f & 0x8000) i  = 5000;	/* 1/2	*/
     if (f & 0x4000) i += 2500;	/* 1/4	*/
     if (f & 0x2000) i += 1250;	/* 1/8	*/
     if (f & 0x1000) i +=  625;	/* 1/16	*/
     if (f & 0x0800) i +=  313;	/* 1/32	*/
     if (f & 0x0400) i +=  156;	/* 1/64	*/
     if (f & 0x0200) i +=   78;	/* 1/128	*/
     if (f & 0x0100) i +=   39;	/* 1/256	*/
     if (f & 0x0080) i +=   20;	/* 1/512	*/
     if (f & 0x0040) i +=   10;	/* 1/1024	*/
     if (f & 0x0020) i +=    5;	/* 1/2048	*/
     if (f & 0x0010) i +=    2;	/* 1/4096	*/
     if (f & 0x0008) i +=    1;

     i = i/10;
     sprintf(p, "%03u", i);

     if ( addHex) {
     	i = (sik>>16) & 0xFFFF;
     	f = sik & 0xFFFF;
     	p = strchr(p, 0);
     	sprintf(p, " (%04X:%04X)", i,f);
	}

}


/*---------------------  ---------------------
 *  Purpose:
 ---------------------------------------------------------------------------*/
void DebugWWF(char *txt, WWFixedAsDWord wwf) {
char buf[30];

    DebugInfo(txt);
    WWFToASCII(buf, wwf, TRUE);
    DebugInfo(buf);
}

/*---------------------  ---------------------
 *  Purpose:	Debug MSG_GEN_DOCUMENT_ ... messages
 ---------------------------------------------------------------------------*/
void DebugDocMsg(optr docObj, char *txt) {
	// important! pass IconDBDocument as docObj
int	op;
char 	opText[20];

    op = @call docObj::MSG_GEN_DOCUMENT_GET_OPERATION();

    switch (op) {
    case GDO_SAVE_AS:
    	strcpy(opText, "");
	break;
    case GDO_SAVE:		// = 8
    	strcpy(opText, " (save)");
	break;
    case GDO_CLOSE:		// = 9
    	strcpy(opText, " (close)");
	break;
    case GDO_REVERT: //  = 2  ,
    	strcpy(opText, " (revert)");
	break;
    case GDO_REVERT_QUICK: // = 3   ,
    	strcpy(opText, "(quick)");
	break;
    case GDO_ATTACH: //  = 4  ,
    	strcpy(opText, " (attach)");
	break;
    case GDO_DETACH: //  = 5  ,
    	strcpy(opText, " (detach)");
	break;
    case GDO_NORMAL: // = 0   ,
    	strcpy(opText, " (normal)");
	break;
    case GDO_NEW: // = 6   ,
    	strcpy(opText, " (new)");
	break;
    case GDO_OPEN: // = 7    ,
    	strcpy(opText, " (open)");
	break;
    default:
    	strcpy(opText, "");
    /* other possibe GenDocumentOperation values
	    GDO_AUTO_SAVE = 10   ,
	    GDO_REVERT_TO_AUTO_SAVE = 11   ,
    */
    }

    DebugInfo("\r");
    DebugInfo(txt);
    DebugInfo1(", op=%u", op);
    DebugInfo(opText);
}


/* +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 *
 * +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
void DumpTokenMonikers2(dword tokenChars, word manufID)
{
TokenEntry      *tokenEntryP;
MemHandle    tokenEntryMH;
word 	teMHSize;
Boolean         ok;
DBGroupAndItem  monList;


    DebugInfo("\r---DumpTokenMonikers2--");
    ok = TokenLoadTokenBlock(tokenChars, manufID, &teMHSize, &tokenEntryMH);
    DebugInfo2("\rsize tokenEntry=%u, locked =%u", sizeof(TokenEntry), teMHSize);

    if (!ok)
    {
    	DebugInfo("--NOT OK - return");
        return;
    }

    tokenEntryP = MemLock(tokenEntryMH);
    monList = tokenEntryP->TE_monikerList;
    MemUnlock(tokenEntryMH);

DebugInfo1DW("\MonikerList = %lu", monList);

{
Boolean err;
DisplayType displayType;
/*
typedef ByteFlags DisplayType;
#define DT_DISP_SIZE		0xc0	<-- DS_STANDARD
#define DT_DISP_ASPECT_RATIO	0x30	<-- DAR_NORMAL
#define DT_DISP_CLASS		0x0f	<-- DC_COLOR_4 ..,

#define DT_DISP_SIZE_OFFSET 6
#define DT_DISP_ASPECT_RATIO_OFFSET 4
#define DT_DISP_CLASS_OFFSET 0
*/


VisMonikerSearchFlags searchFlags;
/*
#define VMSF_STYLE 		0xf000		<<-- VMS_ICON/TOOL
#define VMSF_COPY_CHUNK 		0x0400
#define VMSF_REPLACE_LIST 	0x0200
#define VMSF_GSTRING 		0x0100

#define VMSF_STYLE_OFFSET 	12
*/

TokenMonikerInfo tokenMonikerInfo;
/*
typedef struct {
    TokenDBItem         TMI_moniker;
    word                TMI_fileFlag;           / * 0 if token is in shared
						   token DB file
						   Non-0 if it's in local file * /
} TokenMonikerInfo;
*/
    displayType = DS_STANDARD	<< DT_DISP_SIZE_OFFSET |
    		DAR_NORMAL	<< DT_DISP_ASPECT_RATIO_OFFSET |
    		DC_COLOR_4	<< DT_DISP_CLASS_OFFSET;

    searchFlags = VMS_ICON	<< VMSF_STYLE_OFFSET |
    		VMSF_GSTRING;

    err = TokenLookupMoniker(tokenChars, manufID,
		       displayType, searchFlags,
		       &tokenMonikerInfo);
DebugInfo1("\rNr 1: err = %d", err);
DebugInfo1DW("\r\t%lX,", (dword)tokenMonikerInfo.TMI_moniker);

    displayType = DS_STANDARD	<< DT_DISP_SIZE_OFFSET |
    		DAR_NORMAL	<< DT_DISP_ASPECT_RATIO_OFFSET |
    		DC_CF_RGB	<< DT_DISP_CLASS_OFFSET;

    searchFlags = VMS_TOOL	<< VMSF_STYLE_OFFSET |
    		VMSF_GSTRING;

    err = TokenLookupMoniker(tokenChars, manufID,
		       displayType, searchFlags,
		       &tokenMonikerInfo);
DebugInfo1("\rNr 2: err = %d", err);
DebugInfo1DW("\r\t%lX,", (dword)tokenMonikerInfo.TMI_moniker);
}

}

/* +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 *
 * +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

word ImpTokenListTokens(Boolean listTextOnlyTokens);
dword IconTokenListIcons(dword tokenChars, word manufID, MonikerFoundStruct *foundIcons);

void AnalyseIconMoniker(GeodeToken tok, int item, MonikerAnalyseResult *mars, char *textMonikerIfAny);

void PrintToken(GeodeToken tok) {
char buf[20];
sprintf(buf, "\r%c%c%c%c, %u",
	tok.GT_chars[0], tok.GT_chars[1], tok.GT_chars[2], tok.GT_chars[3],
	tok.GT_manufID);
DebugInfo(buf);
}

#define DrawToken if (!tokenDrawn ) { tokenDrawn = TRUE; PrintToken(tok); }

/* -------------------- FullCheckIconsInTokenDB ---------------------------------------
 * Komplettcheck der Icons in der TokenDB
 * --------------------------------------------------------------------------- */
void FullCheckIconsInTokenDB(void) {
int numTokens, numIcons;
TokenListStruct	*tokenList;
GeodeToken tok;
int n, i;
dword tokenChars, countVal;
MonikerAnalyseResult	mars;
Boolean tokenDrawn;



    // TokenList erzeugen
    numTokens = ImpTokenListTokens(TRUE);

    // Alle Tokens druchgehen
    for ( n = 0; n < numTokens; n++) {
	tokenList = MemLock(global.tokenListMH);
	tok = tokenList->token[n];
	MemUnlock(global.tokenListMH);


	if ( n & 0x0F) { DebugInfo("."); }
	        else   { DebugInfo("+"); }

	// Alle Icons im Token druchgehen
	memcpy(&tokenChars, &tok.GT_chars[0], 4);
	if (!global.iconListPtr) global.iconListPtr = malloc(MAX_SEARCH_RESULT_ICONS*sizeof(MonikerFoundStruct));
	countVal = IconTokenListIcons(tokenChars, tok.GT_manufID, global.iconListPtr);
	numIcons = (countVal & 0xFFFF);
	numIcons +=  countVal >> 16;

	tokenDrawn = FALSE;

	for ( i = 0; i < numIcons; i++ ) {


	    AnalyseIconMoniker(tok, i, &mars, NULL);

	    if (mars.isGString) {

/*
DisplayClass : OK*/
		//- Check DisplayClass invaild (DC_TEXT, DC_GRAY_2, DC_GRAY_4, DC_GRAY_8, DC_COLOR_2)
		switch (mars.displayClass) {
		case DC_TEXT:
		case DC_GRAY_2:
		case DC_GRAY_4:
		case DC_GRAY_8:
		case DC_COLOR_2:
			DrawToken
			DebugInfo(" displayClass");
			break;
		}


@if 1
		//- no bitmap
		if ( !mars.bitmapFound ) {
			DrawToken
			DebugInfo(" no-bitmap");
		}

		else {

			//- chekc ob palette oder Complex dabei ist
			if ( mars.bmFormat & BMT_PALETTE ) {
				DrawToken
				DebugInfo(" palette");
			}
			if ( mars.bmFormat & BMT_COMPLEX ) {
				DrawToken
				DebugInfo(" complex");
			}



		}
@endif
	    }	/* end of isGString */

	}
	if (tokenDrawn) DebugInfo("\r");

    }

    // do not free global.iconListPtr - depending on the calling routine,
    // the buffer may be used later --> it will be freed later automatiucally

    DebugInfo("\r * FULL CHECK DONE *");
}

/*--------------------- PrintFreeHandles ---------------------
 *  Purpose:	Track free handles
 *  Context:
 *  Strategy:	Initialize global.testVal as follows:
		 global.testVal = 0;
		 global.testVal = PrintFreeHandles("\rStart:");
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
int PrintFreeHandles(char *text) {
int numHan;
numHan = SysGetInfo(SGIT_NUMBER_OF_FREE_HANDLES);
DebugInfo(text);
DebugInfo2(" %u (%d)", numHan, numHan - global.testVal);
return numHan;
}

@endif

@if @DEBUG_TOKEN_IMPORT
/*--------------------- DebugAnalyseStruct ---------------------
 *  Purpose:	Display Important icon attributes
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void DebugAnalyseStruct(MonikerAnalyseResult *mars) {
char buf[25];

    @call ImpTokenDebugText::MSG_VIS_TEXT_DELETE_ALL();

//--
    switch (mars->displayClass) {
    case DC_TEXT: strcpy(buf, "DC_TEXT"); break;
    case DC_GRAY_1: strcpy(buf, "DC_GRAY_1"); break;
    case DC_GRAY_2: strcpy(buf, "! DC_GRAY_2"); break;
    case DC_GRAY_4: strcpy(buf, "! DC_GRAY_4"); break;
    case DC_GRAY_8: strcpy(buf, "! DC_GRAY_8"); break;
    case DC_COLOR_2: strcpy(buf, "! DC_COLOR_2"); break;
    case DC_COLOR_4: strcpy(buf, "DC_COLOR_4"); break;
    case DC_COLOR_8: strcpy(buf, "DC_COLOR_8"); break;
    case DC_CF_RGB: strcpy(buf, "DC_CF_RGB"); break;
    default:	 strcpy(buf, "! DC_unknown");
    }
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(buf, 0);

//--
    strcpy(buf, " - ");
    switch (mars->displaySize) {
    case DS_TINY: 	strcat(buf, "DS_TINY"); break;
    case DS_STANDARD: 	strcat(buf, "DS_STANDARD"); break;
    case DS_LARGE: 	strcat(buf, "DS_LARGE"); break;
    case DS_HUGE: 	strcat(buf, "DS_HUGE"); break;
    default: strcat(buf, "DS_unknown");
    }
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(buf, 0);

//--
    strcpy(buf, " - ");
    switch (mars->aspect) {
    case DAR_NORMAL: 	strcat(buf, ""); break;
    case DAR_SQUISHED: 	strcat(buf, "! DAR_SQUISHED"); break;
    case DAR_VERY_SQUISHED: strcat(buf, "DAR_VERY_SQUISHED"); break;
    default: strcat(buf, "DAR_unknown");
    }
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(buf, 0);

//--
    strcpy(buf, " - ");
    switch (mars->iconStyle) {
    case VMS_TEXT: 	strcat(buf, "VMS_TEXT"); break;
    case VMS_ABBREV_TEXT: 	strcat(buf, "VMS_ABBREV_TEXT"); break;
    case VMS_GRAPHIC_TEXT: 	strcat(buf, "VMS_GRAPHIC_TEXT"); break;
    case VMS_ICON: 	strcat(buf, "VMS_ICON"); break;
    case VMS_TOOL: 	strcat(buf, "VMS_TOOL"); break;
    default: strcat(buf, "VMS_unknown");
    }
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(buf, 0);

//--
    if ( !mars->isGString ) return;
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR("\r", 0);

    if (!mars->bitmapFound) {
    	@call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR("GString - bitmap not found" , 0);
    	return;
    }

//--
    sprintf(buf, "bitmap offset=%u ", mars->bitmapOffset);
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(buf, 0);
    sprintf(buf, "(%u bytes), ", mars->bitmapDataSize);
    switch (mars->bmFormat & BMT_FORMAT) {
    case BMF_MONO:	strcat(buf, "BMF_MONO"); break;
    case BMF_4BIT:	strcat(buf, "BMF_4BIT"); break;
    case BMF_8BIT:	strcat(buf, "BMF_8BIT"); break;
    case BMF_24BIT:	strcat(buf, "BMF_24BIT"); break;
    default: 	strcat(buf, "BMF_unknown");
    }
    @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(buf, 0);

    if ((mars->bmFormat & BMT_MASK) == 0) @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(" (NO MASK)", 0);
    if (mars->bmFormat & BMT_PALETTE) @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(", palette", 0);
    if (mars->compact != BMC_PACKBITS) @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(" [-UNCOMPACTED-]", 0);
    if ( mars->bmFormat & BMT_COMPLEX ) @call ImpTokenDebugText::MSG_VIS_TEXT_APPEND_PTR(", COMPLEX", 0);

}


@endif


