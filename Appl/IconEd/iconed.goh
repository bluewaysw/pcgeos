/*---------------------------------------------------------------------------
 	IconDBDocumentClass
 	This is the document class for the Icon Viewer App.
 	It handles the GEN_DOCUMENT methods.

 	I had some trouble with the geometry management when I used the document
 	object (with @uses VisContentClass, like the original Icon Viewer) as the
 	content of the IconDBView. Therefore I have decided to use a separate
 	class as content, which is directly subclassed from VisContenClass.
 	- Rainer 07/2025
 ---------------------------------------------------------------------------*/
@class IconDBDocumentClass, GenDocumentClass;
    /*
     * some messages goes to APP_MODEL and must be passed to the DBViewer
     */
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_DB_DOC_SET_FATBIT_SIZE;
    @message void MSG_DB_DOC_FATBIT_ZOOM(int inOrOut);
    @message (GEN_BOOLEAN_GROUP_APPLY_MSG) MSG_DB_DOC_SET_OPTIONS;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_DB_DOC_SET_VIEW_COLOR;


@endc;

/*---------------------------------------------------------------------------
 	Definition of VisListItemClass - displays an image in a GenView/VisListContent

 	This object is designed to have a fixed size and draw the image
 	(bitmap or visMoniker) centered  - or on top-left corner, if
 	the image is too large.

 	Objects of this class must be children of a VisListContentClass object.

 ---------------------------------------------------------------------------*/
@class VisListItemClass, VisClass;

    @message void MSG_VIS_LIST_ITEM_SET_BITMAP(VMFileHandle vmFile, VMBlockHandle bmp);
    @message VMBlockHandle  MSG_VIS_LIST_ITEM_GET_BITMAP(VMFileHandle *vmFilePtr);

    @message void MSG_VIS_LIST_ITEM_SET_TOKEN(GeodeToken tok);
    @message void MSG_VIS_LIST_ITEM_SET_VIS_MONIKER(VisMonikerWithGString *monikerPtr);
    @message void MSG_VIS_LIST_ITEM_SET_TEXT(char *text);
    	/* creates a gstring in a memory block that holds image to display */

    @message void MSG_VIS_LIST_ITEM_SET_GSTRING(optr gsOptr);


    @message void MSG_VIS_LIST_ITEM_SET_SELECTED_STATE(Boolean state);
    @message void MSG_VIS_LIST_ITEM_CLEAR_IMAGE(Boolean redraw);

    	@instance VMFileHandle	VLI_vmFile;
    	@instance VMBlockHandle	VLI_graphicBlock;
    	@instance optr		VLI_gstring;

    	@instance Boolean VLI_isSelected = FALSE;
    	@instance int	VLI_imageType = 0;
    		#define VLIT_NO_IMAGE		0
    		#define VLIT_BITMAP		1
    		#define VLIT_GSTRING		2

@endc

/*---------------------------------------------------------------------------
 	Definition of VisListContentClass - holds VisListItemClass objects

 	The combination VisListItemClass/VisListContentClass is designed to
 	replace a DynamicList for the special case, that the VisMonikers for
 	the children of the DynamicList may potentially large. Because a
 	DynamicList creates all its children in its own resource, all
 	VisMonikers for the children are also stored in this resource.

 	For the IconEditor it is possible (though not likely) that the total
 	size of all monikers in a list could reach 16 KB, or even much more.
 	In that case, the system could crash. That is why we use a View/Content
 	combination with VisObjects, in which the VisObjects draw their
 	graphics from an external source.

	In addition, we need a GenValue that acts as a scroll bar. This
	GenValue requires a special setup and additional support from the program.
	We have implemented this as part of the VisListContentClass.

 ---------------------------------------------------------------------------*/
@class VisListContentClass, VisContentClass;

    @message void MSG_VIS_LIST_CONTENT_SET_OUTPUT(optr outputObj);
    @message void MSG_VIS_LIST_CONTENT_SET_NUM_ITEMS(int number);
    @message void MSG_VIS_LIST_CONTENT_CLEAR_ITEMS(Boolean redraw);

    @message void MSG_VIS_LIST_CONTENT_SET_FIRST_ITEM_ID(int id);
    @message int  MSG_VIS_LIST_CONTENT_GET_FIRST_ITEM_ID();

    @message void MSG_VIS_LIST_CONTENT_DISPLAY_AND_SELECT_ITEM(int itemToSelect);
    @message void MSG_VIS_LIST_CONTENT_UPDATE_ITEM_IMAGES();
    @message void MSG_VIS_LIST_CONTENT_UPDATE_SINGLE_ITEM_IMAGE(int itemToUpdate);

    @message void MSG_VIS_LIST_CONTENT_SELECT_ITEM(int itemNr);
    @message int  MSG_VIS_LIST_CONTENT_GET_SELECTED_ITEM();
    @message void MSG_VIS_LIST_CONTENT_NOTIFY_CHILD_SELECTED(optr itemOp);

    @message int  MSG_VIS_LIST_CONTENT_SET_TOKEN_RANGE(int minID, int maxID);
    @message void MSG_VIS_LIST_CONTENT_UPDATE_SCROLLER();
     		/* This messages are useful only if the displays a token */



    @instance optr VLCI_numItems;	/* <- usually the list displays a part of a
    					 *    larger group of images. This is the
    					 *    number of images in the group */
    @instance int VLCI_firstItemID;	/* <- image of this item is displayed in the
    					 *    left upper corner of the list */
    @instance int VLCI_selectedItem;	/* <- selected item number. May be
    				         *    currently visible in the list or not. */
		#define VLC_NONE_SELECTED	(-1)

    @instance optr VLCI_output;
    @instance Message VLCI_notifySelectionMsg;	/* notify output that a new list item has been selected */
    @instance Message VLCI_queryMsg;		/* query image for a list item */

    @instance optr VLCI_scrollerObj;	/* GenValue object that acts as a scrollbar */
    @instance word VLCI_numItemsX;	/* number of items (children) in a row */
    @instance word VLCI_numItemsY;	/* number of rows. if equal to one, the scroller
    					 * is assumed to be a _X_SCROLLER, otherwise it is
    					 * assumed to  be an Y_SCROLLER */

    @prototype void VIS_LIST_CONTENT_NOTIFY_SELECTION_MSG(int selectedItemNr);
    @prototype void VIS_LIST_CONTENT_QUERY_MSG(optr itemObj, int itemNr);
    					/* itemObj: optr of a child of the listContent
    /*
     * Support GenValues as scroller.
     *
     * When GenValue acts as a scroller (HINT_VALUE_X_SCROLLER, HINT_VALUE_Y_SCROLLER),
     * it sends 7 different messages depending on the action performed.
     * These messages must be defined immediately one after the other.
     * The first of these messages must be set as GVLI_applyMsg of the object.
     *
     * It is allowed, but not required, to handle these 7 messages in the same way
     * within the same handler.
     *
     * The second important point is that the scroll bar is not visually updated
     * automatically. Instead, the handler must send the value to be displayed back
     * to the GenValue object, e.g., using MSG_GEN_VALUE_SET_VALUE. In doing so,
     * it is possible to change the value, e.g., by rounding it, so that only
     * integer values are stored in the object. That is exactly what we do.
     */

    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY;		// BEG_ANCHOR
    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY_1;	// PAGE_UP
    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY_2;	// INC_UP
    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY_3;	// DRAG_AREA
    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY_4;	// INC_DOWN
    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY_5;	// PAGE_DOWN
    @message (GEN_VALUE_APPLY_MSG) MSG_VIS_LIST_CONTENT_SCROLLER_APPLY_6;	// END_ANCHOR

    /*
     * The scrollbar (GenValue object) must set up properly. This message does
     * this for us so that we have no special setup in the UI. Only
     * HINT_VALUE_X_SCROLLER or HINT_VALUE_Y_SCROLLER must be set.
     */
    @message void MSG_VIS_LIST_CONTENT_INITIALIZE_SCROLLER();

@endc


