    @message void MSG_FATBITS_UPDATE_UNDO_TRIGGERS();

    @message void MSG_FATBITS_SET_FLAGS(word flagsToSet, word flagsToClear);
    @message word MSG_FATBITS_GET_FLAGS();


    @instance	int		FBI_pixelSize;

    	/*
    	 * Since GrSetBitmapMode() fails when we try to edit the mask of a true color
    	 * image (at least in BBX 4.x), we have a separate monochrome bitmap that
    	 * contains a copy of the mask.
	 * After we have modified this mask bitmap, we copy it back into the original bitmap.
	 */
    @instance	VMBlockHandle	FBI_bitmap = 0;	/* Bitmap is stored in global.tempFile */
    @instance	VMBlockHandle	FBI_maskBmp = 0;

	/* Cache Information about the currently edited bitmap like BMT_PALETTE.
	 * color depth and bitmap's size.
	 */
    @instance	BMType		FBI_bmFormat;
    @instance	int		FBI_xSize;
    @instance	int		FBI_ySize;

	/* FBI_imageObj shares a bitmap with the Fatbits object and
	 * therefore it MUST be driven by the same thread. Usually,
	 * this object resides in the same resource as the Fatbits
	 * object and anything is fine.
	 */
    @instance	optr		FBI_imageObj = 0;

	/*
	 * Edit Bitmap related instances
	 */
    @instance	IconLineAttrs   FBI_lineAttrs;
    @instance	IconAreaAttrs   FBI_areaAttrs;

	/*
	 * Each tool (pencil, eraser, draw ellipse ..) has its own message
	 * for different mouse events. FBI_~Msg stored this message for
	 * the active tool.
	 */
    @instance 	word 	FBI_currentTool;	/* BFT_PENCIL, BTF_ERASER, ... */
    @instance	Message FBI_startSelectMsg;
    @instance	Message FBI_metaPtrMsg;
    @instance	Message FBI_endSelectMsg;

	/*
	 * All tools must write on the screen.
	 * Some tools, like eraser, work directly with the bitmap (and the maskBmp),
	 */
    @instance	GStateHandle	FBI_screenGState;
    @instance	GStateHandle	FBI_bitmapGState;
    @instance	GStateHandle	FBI_maskGState;

	/*
	 * Other tools, such as the line tool, create a rubber outline when dragged with the mouse.
	 * They need a 24-bit bitmap for buffering.
	 * Parts of this structure are also used by the selection tool
	 */
    typedef struct {
	int x0, y0, x1, y1;	/* Coordinates for drawing outline graph */
	VMBlockHandle	bmp;	/* buffer bitmap for drawing outlines */
	GStateHandle	gstate;	/* gstate for drawing to the buffer bitmap */
	Boolean nextClear;	/* Set, if next INVERSE drawing clears last drawing */

	int 	originX, originY; /* start for move/copy operation */
	int	selDX, selDY;	/* Offset target position for moving the selected
				 * area relative to the selected area. */
	int 	mcX0, mcY0;	/* last mouse position for move-copy operation */
	} FBDragStruct;

    @instance   FBDragStruct	FBI_drag;

	/*
	 * Selection tool needs some extra data for selection ants
	 */
    typedef struct {
    	TimerHandle	th;
    	word	tID;
    	word	antState;	/* must be zero or a valid (!) line style value */
    		#define ANT_STATE_NO_ANTS	0		/* <-- MUST be zero */
    		#define ANT_STATE_DRAGGING	(-1)		/* About to create a selection
    				 * frame, but no running ants. Should be LS_SOLID, but LS_SOLID
    				 * is equal to zero. We will map this to LS_SOLID  when drawing. */
    		#define ANT_STATE_1		LS_DASHED	/* running ants */
    		#define ANT_STATE_2		LS_DOTTED
    		#define ANT_STATE_3		LS_DASHDOT
    	} FBAntStruct;

    @instance 	FBAntStruct	FBI_ants;

	/*
	 * A field for common purpose flags
	 */
    @instance 	word	FBI_flags;
	 #define FB_MOVE_COPY_IS_ACTIVE		1
	 	/* The user has initiated a move or copy operation by pressing
	 	 * the right mouse button.
	 	 */
	 #define FB_SHIFT_KEY_IS_DOWN		2
	 	/* A pressed shift key forces the tools to draw squares
	 	 * instead of rectangles, circles instead of ellipses etc.
	 	 */
	 #define FB_PICK_COLOR_IS_ACTIVE	4
	 	/* We are about to pick a color from image. This tells the
	 	 * META_START_SELECT handler to rect properly
	 	 */


	/*
	 * The undo Chain
	 */
    @instance VMBlockHandle FBI_undoChain;


@endc
/*---------------------------------------------------------------------------
 	FatbitsClass related Macros and Routines
 ---------------------------------------------------------------------------*/
void FatbitsDrawGrid(GStateHandle gstate, int curTool, int grid, int width, int height);


/*---------------------------------------------------------------------------
 	Definition of MousePtrViewClass

	We want to detect when the mouse pointer leaves the view area
	This class is used for fatbits view and for crop image view
 ---------------------------------------------------------------------------*/
@class MousePtrViewClass, GenViewClass;

    @instance int MPVI_contentType;	/* must be set in the UI code */
    	#define	MPV_CONTENT_FATBITS	0
    	#define	MPV_CONTENT_CROP_IMAGE	1
    	#define	MPV_CONTENT_POINTER_PREVIEW	2

    @alias (MSG_META_RAW_UNIV_ENTER) void MSG_MOUSE_PTR_VIEW_ENTER
		 (optr inputObj = cx:dx, WindowHandle ptrWin = bp);
    @alias (MSG_META_RAW_UNIV_LEAVE) void MSG_MOUSE_PTR_VIEW_LEAVE
		 (optr inputObj = cx:dx, WindowHandle ptrWin = bp);

    @message void MSG_MPV_UPDATE_POINTER_IMAGE(optr ptrImg);
    @instance optr MPVI_ptrOp = 0;	/* Mouse pointer for MPV_CONTENT_POINTER_PREVIEW mode */

@endc

/*---------------------------------------------------------------------------
    Definition of CropContentClass - draws an image in fatbits look
    				     specialized to crop an image
 *---------------------------------------------------------------------------*/
@class CropContentClass, VisContentClass;

    /*
     * Crop selection frame is similar, but not equal to fatbits selection frame
     * Therefore we use another control structure
     */
    typedef struct {
	int x0, y0, x1, y1;	/* Coordinates for drawing outline graph (relative to image, not upscaled) */
	int dragState;
		#define CI_DRAG_STATE_INACTIVE	0
		#define CI_DRAG_STATE_DRAGGING	1
		#define CI_DRAG_STATE_DONE	2
	} CropDragStruct;


    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_CROP_CONTENT_SET_PIXEL_SIZE;
    @message void MSG_CROP_CONTENT_DUPLICATE_AND_USE_BITMAP(VMFileHandle vmFile, VMBlockHandle bitmap);
    @message void MSG_CROP_CONTENT_RESIZE_AND_REDRAW();
    @message void MSG_CROP_CONTENT_SET_DRAG_STATE(int state);
    @message void MSG_CROP_CONTENT_GET_DRAG_DATA(CropDragStruct *data);
    @message void MSG_CROP_CONTENT_SET_INITIAL_SELECTION_FRAME(int x0, int y0, int x1, int y1);
    @message void MSG_CROP_CONTENT_UPDATE_SELECTED_SIZE_TEXT();


    @instance VMBlockHandle	CCI_bitmap;	/* the bitmap is stored in global.tempFile */
    @instance int	CCI_pixelSize;
    @instance int	CCI_xSize;
    @instance int	CCI_ySize;

    @instance   CropDragStruct	CCI_drag;

@endc;


/*---------------------------------------------------------------------------
    Definition of OtherContentClass for different purposes
    In most cases, the object has no children, but displays a graphic itself.

    - OCI_type = OC_TYPE_BITMAP
      used to display a icon bitmap, centered, with a frame
      Note: The view cannot be scrollable, because the frame is drawn in the
      	    VIS_DRAW handler

	The bitmap to display is stored in a temporary file that can be accessed
	via the global variable global.tempFile. OK, this is not object-oriented,
	but it avoids many problems that could arise when closing a document or
	shutting down GEOS.

    - OCI_type = OC_TYPE_BITMAP_PREVIEW
      used for all content objects, that display an bitmap image, but do not manage
      (create, copy, free) the bitmap. Used for live preview and import preview.

    - OCI_type = OC_TYPE_TOKEN
      used to display a token from token database file, centered, with a frame
      Note: The view cannot be scrollable, because the frame is drawn in the
      	    VIS_DRAW handler

    - OCI_type = OC_TYPE_PALETTE
      used to display a color palette

    - OCI_type = OC_TYPE_SINGLE_COLOR
      used to display a colored rectangle

    - OCI_type = OC_TYPE_COLOR_BAR
      used to display a rectangle with different colors

    - OCI_type = OC_TYPE_POINTER_PREVIEW
      used for preview pointer images

    - OCI_type = OC_TYPE_RESIZE_PREVIEW
      used for preview color reduced and/or scaled images
      NOTE: In this case, the content has children of VisResizePreviewClass



  ---------------------------------------------------------------------------*/

@class OtherContentClass, VisContentClass;

    @instance int	OCI_type = 0;
    	#define OC_TYPE_BITMAP		0
    	#define OC_TYPE_BITMAP_PREVIEW	1
    	#define OC_TYPE_TOKEN		2
    	#define OC_TYPE_PALETTE		3
    	#define OC_TYPE_SINGLE_COLOR	4
    	#define OC_TYPE_COLOR_BAR	5
    	#define OC_TYPE_POINTER_PREVIEW	6
    	#define OC_TYPE_RESIZE_PREVIEW	7

    @message void MSG_OTHER_CONTENT_REDRAW_IMAGE();	/* works for all types */

	/* -------------------------------------------
	 * OC_TYPE_BITMAP related messages and instances
	 */
    @message void MSG_OC_REPLACE_BITMAP(VMBlockHandle bmp);
    @message VMBlockHandle MSG_OC_GET_BITMAP();
    @message void MSG_OC_BITMAP_UPDATED(VMBlockHandle bmp);
    @message void MSG_OC_DRAW_BITMAP(GStateHandle gstate);

    @instance VMBlockHandle	OCI_bitmap = 0;	/* Bitmap is stored in global.tempFile */

	/* -------------------------------------------
	 * OC_TYPE_BITMAP_PREVIEW related messages and instances
	 * uses OCI_bitmap
	 */
    @message void MSG_OTHER_CONTENT_USE_IMAGE(VMBlockHandle bmp);

    @instance int		OCI_margin;	/* Space around the bitmap */

	/* -------------------------------------------
	 * OC_TYPE_TOKEN related messages and instances
	 */
    @message void MSG_OC_SET_TOKEN(GeodeToken tok);
    @message void MSG_OC_DRAW_TOKEN(GStateHandle gstate);

    @instance GeodeToken OCI_token;


	/* -------------------------------------------
	 * OC_TYPE_SINGLE_COLOR related messages and instances
	 */
    @message void MSG_OTHER_CONTENT_SET_COLOR(int r, int g, int b);
    @message PaletteEntry MSG_OTHER_CONTENT_GET_COLOR();

    @instance PaletteEntry	OCI_color;

	/* -------------------------------------------
	 * OC_TYPE_COLOR_BAR related messages and instances
	 */
    @message void MSG_OC_CREATE_COLOR_BAR(int h, int s, int v, int type, Boolean redraw);
    	#define CREATE_H_BAR	1
    	#define CREATE_S_BAR	2
    	#define CREATE_V_BAR	3
    @message void MSG_OC_DESTROY_COLOR_BAR();	/* clean up */

    @instance MemHandle OCI_colorBarBlock; 	/* contains 256 rgb values */


	/* -------------------------------------------
	 * OC_TYPE_POINTER_PREVIEW related messages and instances
	 */
    @message void MSG_OC_SET_HOTSPOT(int x, int y);
    @instance int OCI_hotX;
    @instance int OCI_hotY;

	/* -------------------------------------------
	 * OC_TYPE_RESIZE_PREVIEW related messages and instances
	 * In this case, the content has children of VisResizePreviewClass
	 */
    @message optr MSG_OC_CREATE_CHILD(VMBlockHandle bmp, word flags);
    @message void MSG_OC_DESTROY_LIST();		/* destroy all our children */
    @message void MSG_OC_CHILD_SELECTED(int child);
    @message optr MSG_OC_GET_SELECTED_CHILD();


@endc

/*---------------------------------------------------------------------------
 	Definition of VisResizePreviewClass
 	- display a color reduced and/or scaled bitmap
 	- holds information (flags) how that bitmap has been created
  ---------------------------------------------------------------------------*/
@class VisResizePreviewClass, VisClass;


    @message void MSG_VRP_SET_BITMAP(VMBlockHandle bmp);
    @message VMBlockHandle MSG_VRP_GET_BITMAP();

    @message void MSG_VRP_SET_FLAGS(int flags);
    @message int  MSG_VRP_GET_FLAGS();

    @message void MSG_VRP_SET_CHILD_NUMBER(int nr);
    @message void MSG_VRP_SELECT_CHILD_NUMBER(int child);
    @message Boolean MSG_VRP_GET_SELECTED();

    @instance VMBlockHandle	VRPI_bitmap;
    @instance word		VRPI_flags;
    @instance Boolean 		VRPI_childNr;
    @instance Boolean 		VRPI_selected;

	/* Available values for VRPI_flags. They specify how the preview image was generated.
	 * We don't use enums to make programming simpler */

	#define	RPF_SCALE_UNSCALED		0x01	/* the preview image is not scaled */
		/* the following flags are only valid if RPF_SCALE_UNSCALED is not set */
		#define	RPF_SCALE_SYSTEM	0x02
		#define	RPF_SCALE_BILINEAR	0x04

	#define	RPF_NO_COLOR_REPLACEMENT	0x08	/* there is no color reduction required */
		/* the following flags are only valid if RPF_NO_COLOR_REPLACEMENT is not set */
		#define	RPF_COLOR_REPLACED	0x10
		#define	RPF_COLOR_DITERED	0x20

	#define	RPF_MASK_OPAQUE			0x40	/* all mask bits are set to opaque */

@endc

/*---------------------------------------------------------------------------
 	ToolOnlyControlClass

 	Unfortunately the ToolControl can only handle tool groups that are
 	associated with an controller. For special cases, such as spacers in
 	the tool bar or our EditControl replacement, we therefore need our own
 	controller, subclassed from GenControlClass.

 ---------------------------------------------------------------------------*/
@class ToolOnlyControlClass, GenControlClass;
    	/* The controller name appears in the tool group list of the 'customize
    	 * tools' dialog. TOCI_controllerName must point to a chunk in the same
    	 * resource as the controller is. */
    @instance ChunkHandle TOCI_controllerName = 0;

    @prototype void TOC_SETUP_TOOL_MSG(GenControlBuildInfo *info);

    @message (TOC_SETUP_TOOL_MSG) MSG_TOC_SETUP_EDIT_CONTROL_TOOLS;
    @message (TOC_SETUP_TOOL_MSG) MSG_TOC_SETUP_BITMAP_CONTROL_TOOLS;

    @instance Boolean	TOCI_SetupToolMsg = 0;

    @message void MSG_TOC_ENABLE_EDIT_TOOL_TRIGGERS(word enableTriggers, word disableTriggers);
		/* pass ETF_~ constants for enableTriggers and disableTriggers */

    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_TOC_SELECT_BITMAP_TOOL;
		/* pass BTF_~ constants as selection */

@endc;

/* Edit tool toolbox features */
	#define		ETF_TRIG_COPY	1
	#define		ETF_TRIG_PASTE	2
	#define		ETF_TRIG_UNDO	4
	#define		ETF_TRIG_REDO	8
	#define		ETF_DEFAULT_FEATURES (ETF_TRIG_COPY | ETF_TRIG_PASTE | ETF_TRIG_UNDO | ETF_TRIG_REDO)
/*
 * Bitmap tool toolbox features  - also used as the identifiers for the tool items and for
 * fatbits instance variable FBI_currentTool -> ALL available edit tools must be listed here
 * ! Also update TestIfToolWorksWithTheMask() if you add a tool!
 * !! Ensure that there is never a gap in the defined bits. Example 0x080 is defined, 0x100 not but 0x200
 *    is defiend again. This causes the controller not to work!
 *    Take a look on SHIFT_IMAGE_IS_A_BITMAP_TOOL in this context!
 */
	#define		BTF_SELECTION	1
	#define		BTF_PENCIL	2
	#define		BTF_ERASER	4
	#define		BTF_LINE	8
	#define		BTF_FILL_RECT	0x10
	#define		BTF_RECTANGLE	0x20
	#define		BTF_FILL_ELLIPSE 0x40
	#define		BTF_ELLIPSE	0x80
	#define		BTF_FLOOD_FILL	0x100
	#define		BTF_FILL_MASK	0x200
	#define		BTF_EDIT_MASK	0x400
	#define		BTF_PICK_COLOR	0x800
	#define		BTF_SHIFT_IMG	0x1000

@if @SHIFT_IMAGE_IS_A_BITMAP_TOOL
	#define		BTF_ALL_FEATURES ( 0x1FFF /* BTF_SELECTION ... BTF_PICK_COLOR + BTF_SHIFT_IMG*/ )
@elseif
	#define		BTF_ALL_FEATURES ( 0x0FFF /* BTF_SELECTION ... BTF_PICK_COLOR */ )
@endif

	#define		BTF_DEFAULT_FEATURES 	BTF_ALL_FEATURES

	/* Initial tool and corresponding mouse messages */
	#define 	BTF_INITIAL_TOOL		BTF_PENCIL
	#define	    	INITIAL_START_SELECT_MSG	MSG_FATBITS_PENCIL_START_SELECT
	#define	    	INITIAL_META_PTR_MSG		MSG_FATBITS_PENCIL_META_PTR
	#define	    	INITIAL_END_SELECT_MSG		0



/*---------------------------------------------------------------------------
	Global definitions
 * ---------------------------------------------------------------------------*/


/* Protocol number for work with VM files */
#define DOCUMENT_PROTOCOL_MAJOR       2
#define DOCUMENT_PROTOCOL_MINOR       0



/* ------ All global variables are stored in a single structure ------ */

typedef struct {

	/* Temp file to hold some bitmaps */
	VMFileHandle 	tempFile;		/* all purpose temp file */
	VMFileHandle 	undoFile;		/* holds undo data */

	/* global options and more*/
	Boolean	coloredIconListView; 	/* If set, the IconList will be drawn colored,
					 * if not, it will use the same color as parent view.
					 * Some people might find this more beautiful.
					 */
@if @ENABLE_BACKGROUND_PATTERN
	Boolean useBackgroundPattern;	/* If set, the Fatbits draws a background pattern so that
					 * transparent areas are made more noticeable.
					 */
@endif

	MemHandle curDisplay;		/* Memhandle of the current display object. This
					 * is used by MSG_META_SEND_CLASSED_EVENT to
					 * redirect events with the travel option TO_BITMAP or
					 * TO_DB_VIEWER to the correct object.
					 * The handle is also used to construct the real optr
					 * of a particular document UI object
					 * (see CombineGCurDisplayWith() macro).
					 */

	VMBlockHandle paletteVMBlock;	/* A vm block in the global.tempFile that holds
					 * a color palette with up to 256 colors.
					 * This is the palette of the currently edited bitmap
					 * If the bitmap has no palette, this is a NULL handle.
					 */
	MemHandle	paletteMH;	/* MemHandle required to unlock paletteVMBlock */

	int	currentPaletteIndex;	/* Currently selected color index in the custom colors
					 * dialog of the line attrs and area attrs controllers.
					 */

	/* Variables used for import from or export to tokenDB file */
	MemHandle	tokenListMH;	 /* list of all tokens in the token database file */
	MonikerFoundStruct *iconListPtr; /* Unique DisplayType/SearchFlags for every icon for a token.
			  * Since there is no API to retrieve the DisplayClass and IconStyle values for
			  * a specific icon from the TokenDB, they must be estimated.
			  * However, the results are quite good.
			  */
	word 		numIconsInList;  /* number of valid entries in *iconListPtr list
					  */

	word		flags;		/* Flagbits for different purposes */
		#define	GF_WRITE_CODE_DOUBLE_NAMES	1	/* There are two or more icons with the
								 * same name. This requires extra effort
								 * to make the names unique. */

		#define GF_WRITE_CODE_CURRENT_ICON_ONLY	2	/* This flag tells the WriteSourceMonikerList
								 * that only the current icon should be
								 * displayed */

		#define GF_ICON_SIZE_HAS_BEEN_CHANGED	4	/* This flag tells the "Save Icon" routine that
								 * the icon list must be redrawn to remove
								 * artifacts because the size of the current icon
								 * has been changed */

	/* hidden features */
	word	maxSaveMonikerSize;		/* Usualy this is MAX_SAFE_MONIKER_SIZE_DEFAULT ~8kByte */
	word	maxMonikerImageSize;		/* The default value is 1024 */


@if @DEBUG_FLAG
	sdword testVal;			/* global working cell for debugging */
@endif
	} GlobalStruct;



