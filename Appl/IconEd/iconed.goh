/*---------------------------------------------------------------------------

 	Definition of FatbitsClass - the content for the FatbitsView

	Concept:
 	We don't use a classic combination of a VisContent and a VisFatbits
 	object as the original code by Steve it does. Instead, we create our own
 	Fatbits object class which handles all necessary operations.

	The FatbitsClass manages the bitmap that is currently being edited and
	also handles all edits. It also contains a pointer (optr) of an object
	that is informed as soon as the bitmap has been changed. This object
	can then display the bitmap in its original size in its current state
	(live preview).

	The bitmap to be edited is stored in a temporary file that can be accessed
	via the global variable global.tempFile. Even if this is not object-oriented,
	it avoids many problems that could arise when closing a document or
	shutting down GEOS.
 ---------------------------------------------------------------------------*/
@class FatbitsClass, VisContentClass;

@uses GrObjClass;	/* let's handle GrObj messages from graphics controller */


    @message void 	MSG_FATBITS_SET_PIXEL_SIZE(int size);
    @message int 	MSG_FATBITS_GET_PIXEL_SIZE();


    @message void	MSG_FATBITS_DUPLICATE_AND_USE_BITMAP(VMFileHandle vmFile, VMBlockHandle bmpHandle);
    @message VMBlockHandle	MSG_FATBITS_GET_BITMAP();
    @message void	MSG_FATBITS_UPDATE_MASK_BMP();
    @message void	MSG_FATBITS_FREE_BITMAP();
    @message void  	MSG_FATBITS_RESIZE_AND_REDRAW(Boolean forceRebuild);

    @message void	MSG_FATBITS_USE_ICON(VMFileHandle vmFile, int iSet, int icon);
    @message void	MSG_FATBITS_SAVE_ICON(VMFileHandle vmFile, int iSet, int icon);



    @message void	MSG_FATBITS_SEND_NOTIFICATIONS(word sendFlags);
    			#define SEND_AREA_NOTIFICATIONS		0x01
    			#define SEND_LINE_NOTIFICATIONS		0x02
    			#define SEND_BMPTOOLS_NOTIFICATIONS	0x04
    			#define SEND_ALL_NOTIFICATIONS		0xFF


    /*
     * Handling line and area attributes
     */
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_FATBITS_SET_LINE_COLOR_FROM_INDEX;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_FATBITS_SET_AREA_COLOR_FROM_INDEX;
    @message void	MSG_FATBITS_GET_COLORS(PaletteEntry *lineColor, PaletteEntry *areaColor);
    @message void	MSG_FATBITS_VERIFY_COLORS();

    @message void	MSG_FATBITS_SET_ATTRS(IconLineAttrs lineAttrs, IconAreaAttrs areaAttrs);
    @message void	MSG_FATBITS_GET_ATTRS(IconLineAttrs *lineAttrs, IconAreaAttrs *areaAttrs);

