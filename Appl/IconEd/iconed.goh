/***********************************************************************
 *
 *	Undo-related structures,  types and flags
 *
 ***********************************************************************/

/*
#define	UNDO_DONT_STORE_IMAGE	0x100
	 * I have tried to set a flag if the undo operation does not affect
	 * the image and therefore the image does not need to be saved or redrawn.
	 * This is true for, e.g, UNDO_RENAME_ICON and UNDO_CHANGE_ATTRIBUTES
	 *
	 * But this works not properly with UNDO_CANNOT_BE_DISCARDED if we do a sequence like
	 * "rename icon" - "edit image" - "rename icon" - UNDO (name) - UNDO(edit) -
	 * REDO(edit) <-- fails, image will not be updated.
	 * I cannot find the reason for that. Sorry. Feel free to fix this, if you find the reason.
	 * But for me, the overhead to store (a small) image on rare rename/change attributes
	 * operation is smaller than the confusion of the user, if redo does not work.
	 *
	 * In some parts of the code, the comments indicate when this flag should be taken into account.
	 */


#define	UNDO_CANNOT_BE_DISCARDED	0x200
	/* This flag is set if the operation is directly written to the
	 * database and therefore "Discard Changes" will not work.
	 * Thus, the icon should not be marked dirty, even not on undo or redo.
	 *
	 * I don't really like this behavior, but it would require a significant
         * amount of programming effort to avoid it. We would have to mirror
         * the entire icon structure and run a lot of tests to make sure everything
         * still works as intended.
         * I've decided that the effort isn't worth it at this point.
	 */


typedef enum {

/* Simple transformations, renaming etc. */
    UNDO_NONE		= 0,
    UNDO_JUST_FOR_REDO	= 1,	/* see MSG_FATBITS_UNDO */
    UNDO_ROTATE		= 2,
    UNDO_FLIP		= 3,
    UNDO_RENAME_ICON	= 4 + /*UNDO_DONT_STORE_IMAGE +*/ UNDO_CANNOT_BE_DISCARDED,
    UNDO_DRAW_BITMAP	= 5,	/* draw imported bitmap into existing icon */
    UNDO_CHANGE_ATTRIBUTES = 6 + /*UNDO_DONT_STORE_IMAGE +*/ UNDO_CANNOT_BE_DISCARDED,
    UNDO_CHANGE_HOTSPOT = 7 + /*UNDO_DONT_STORE_IMAGE +*/ UNDO_CANNOT_BE_DISCARDED,


/* Bitmap operations */
    UNDO_PENCIL		= 0x10,	/* Free hand painting */
    UNDO_ERASER		= 0x11,
    UNDO_DRAW_LINE	= 0x12,
    UNDO_FILL_RECTANGLE	= 0x13,
    UNDO_DRAW_RECTANGLE	= 0x14,	/* not filled */
    UNDO_FILL_ELLIPSE	= 0x15,
    UNDO_DRAW_ELLIPSE	= 0x16,
    UNDO_FILL_AREA	= 0x17,
    UNDO_SHIFT_IMAGE	= 0x18,	/* move whole image */
    UNDO_MOVE_SELECTION	= 0x19,	/* move selected area */
    UNDO_FILL_MASK	= 0x1A,
    UNDO_EDIT_MASK	= 0x1B,

/* Other operations */
    UNDO_CROP_IMAGE	= 0x20


} UndoType;


typedef struct {
    UndoType 	  undoType;		/* enum .. */
    VMBlockHandle iconBitmap;
    char 	  iconName[MAX_ICON_NAME_LENGTH + 2];
    VisMonikerListEntryType	iconType;	/* word flags */


EC(    int index;	)

} UndoEntry;

#define	UNDO_BUFFER_SIZE	32
#define	MAX_UNDO_COUNT		(UNDO_BUFFER_SIZE - 1)

typedef struct {
    int nextIndex;	/* 'pointer' to next usable index in the undo array */
    int undoCount;	/* available undo steps */
    int redoCount;	/* available redo steps */
			/* if you add members: update FLUSH_CHAIN too */
    UndoEntry undoArray[UNDO_BUFFER_SIZE];
} UndoChainHeader;



