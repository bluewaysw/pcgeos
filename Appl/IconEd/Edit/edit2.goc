}



/*######################################################################
  #
  #	Edit Mask Tool
  #
  ######################################################################*/

/*--------------------- EditMaskDrawPixel ---------------------
 *  Purpose:	Draw a single pixel in edit-mask-mode
 *  Context:
 *  Strategy:
 *	- Get color (black or white) from EditMaskModeChooser
 *	- Set pixel (black is opaque, white is transparent)
 *	  Do not touch the color layer.
 *	- Set a one-pixel cliprect to avoid flickering
 *	- redraw the image
 *	- update live preview object
 *  Parameters: oself:	The fatbits object
 *		x, y:	Pixel coordinates
 *		redrawPreview:  redraw the live preview object (don't calling
 *				the view object to avoid flickering)
 *  Return:
 ---------------------------------------------------------------------------*/
void EditMaskDrawPixel(optr fatbitsObj, int x, int y) {
FatbitsInstance *pself;
int grid, color;

    pself = ObjDerefVis(fatbitsObj);

    /*
     */
    color = @call EditMaskModeChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    GrSetAreaColor(pself->FBI_maskGState, CF_INDEX, color, 0, 0);
    GrDrawPoint(pself->FBI_maskGState, x,y);

    /*
     * Redraw fatbits and live preview.
     * 	- Copy mask back to the image
     *	- Set a one-pixel cliprect to avoid flickering
     *	- redraw the image
     *  - force the LivePreviewView to redraw itself. This ensures that
     *	  the background is drawn when a pixel has become transparent.
     */
    ToolTransferMask(pself->FBI_maskBmp,  pself->FBI_bitmap,  pself->FBI_xSize,  pself->FBI_ySize);

    grid = pself->FBI_pixelSize;

    GrSaveState(pself->FBI_screenGState);
    GrSetClipRect(pself->FBI_screenGState, PCT_REPLACE, grid*x, grid*y, grid*(x+1), grid*(y+1));
    @call fatbitsObj::MSG_VIS_DRAW(0, pself->FBI_screenGState);
    GrRestoreState(pself->FBI_screenGState);

    @call ConstructOptr(OptrToHandle(fatbitsObj), OptrToChunk (@LivePreviewView))::MSG_GEN_VIEW_REDRAW_CONTENT();

}

/*--------------------- MSG_FATBITS_EDIT_MASK_START_SELECT ---------------------
 *  Purpose:	Start select handler for edit-mask tool
 *  Context:
 *  Strategy:
 *	- Save current icon state for undo
 *	- draw the first pixel
 *  Parameters:	xPos, yPos: Mouse coordinates
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method FatbitsClass, MSG_FATBITS_EDIT_MASK_START_SELECT{ /* int xPos, int yPos */

    EC( if ( pself->FBI_drag.x0 == (-1) ) { ProgError("FBI_drag not initialized in MASK_START_SELECT"); } )

    @call oself::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_EDIT_MASK);
    EditMaskDrawPixel(oself, pself->FBI_drag.x0, pself->FBI_drag.y0);
}

/*--------------------- MSG_FATBITS_EDIT_MASK_META_PTR ---------------------
 *  Purpose:	Mouse move handler for edit-mask tool
 *  Context:
 *  Strategy:
 *	- return if the pixel under the mouse already has been edited
 *	- store new position
 *	- draw the pixel
 *  Parameters:	xPos, yPos: Mouse coordinates
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method FatbitsClass, MSG_FATBITS_EDIT_MASK_META_PTR{

   do {
   	if (xPos != pself->FBI_drag.x0) break;
   	if (yPos != pself->FBI_drag.y0) break;
   	return;
   } while (FALSE);

   pself->FBI_drag.x0 = xPos;
   pself->FBI_drag.y0 = yPos;
   EditMaskDrawPixel(oself, pself->FBI_drag.x0, pself->FBI_drag.y0);
}

/*######################################################################
  #
  #	Shift Image Tool
  #
  ######################################################################*/

/*--------------------- MSG_ICON_SHIFT_IMAGE_TO ---------------------
 *  Purpose:	Execute shift image operation
 *  Context:
 *  Strategy:
 *	- Save current icon state for undo
 *	- fetch shift amount
 *	- loop: depending on shiftDirection: shift image
 *	        one pixel in each loop turn
 *	- update local copy of the mask data
 *	- mark icon dirty
 *	- redraw fatbits and live preview
 *  Parameters: void (ShiftDirection shiftDirection)
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconProcessClass, MSG_ICON_SHIFT_IMAGE_TO {
optr fatbitsObj;
int count;
VMBlockHandle	bmp;

    fatbitsObj = CombineGCurDisplayWith(@MyFatbits);
    if (!fatbitsObj) return;

    AppMarkBusy();
    @call fatbitsObj::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_SHIFT_IMAGE);


    count = @call ShiftImageAmountValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();
    bmp = @call fatbitsObj::MSG_FATBITS_GET_BITMAP();

    switch (shiftDirection) {
        case SHIFT_TO_TOP_LEFT:
            BTShiftImage(global.tempFile, bmp, -count, -count, 0);
	    break;
        case SHIFT_TO_TOP:
            BTShiftImage(global.tempFile, bmp, 0, -count, 0);
	    break;
        case SHIFT_TO_TOP_RIGHT:
            BTShiftImage(global.tempFile, bmp, count, -count, 0);
	    break;
        case SHIFT_TO_LEFT:
            BTShiftImage(global.tempFile, bmp, -count, 0, 0);
	    break;
        case SHIFT_TO_RIGHT:
            BTShiftImage(global.tempFile, bmp, count, 0, 0);
	    break;
        case SHIFT_TO_BOTTOM_LEFT:
            BTShiftImage(global.tempFile, bmp, -count, count, 0);
	    break;
        case SHIFT_TO_BOTTOM:
            BTShiftImage(global.tempFile, bmp, 0, count, 0);
	    break;
        case SHIFT_TO_BOTTOM_RIGHT:
            BTShiftImage(global.tempFile, bmp, count, count, 0);
	    break;
	}


    /*
     * We have a new (shifted) mask now. Replace it.
     * Mark Icon as dirty.
     */
    @call fatbitsObj::MSG_FATBITS_UPDATE_MASK_BMP();
    @call ConstructOptr(OptrToHandle(fatbitsObj), OptrToChunk(@DBViewerContent))::MSG_DB_VIEWER_MARK_ICON_DIRTY();

    /*
     * Redraw Fatbits and Preview
     */
    @call ConstructOptr(OptrToHandle(fatbitsObj), OptrToChunk (@FatbitsView))::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call ConstructOptr(OptrToHandle(fatbitsObj), OptrToChunk (@LivePreviewView))::MSG_GEN_VIEW_REDRAW_CONTENT();

    AppMarkNotBusy();

}



