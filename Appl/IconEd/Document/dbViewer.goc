/*#########################################################################
 *
 * 	Geometry Management
 *
 *#########################################################################*/

/*--------------------- MSG_VIS_COMP_GET_CHILD_SPACING ---------------------
 *  Purpose:	Returns the spacing for the children.
 *  	This message returns the child spacing used by the composite. The high word
 *  	of the return value is the spacing between lines of wrapped children; the low
 *  	word is the horizontal spacing between children.
 *  Parameters:
 *  Return:	SpacingAsDWord
 *		high-word->y-direction, low-word->x-direction
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_VIS_COMP_GET_CHILD_SPACING {
dword spacing;
	spacing = VIEWER_VERTICAL_CHILD_SPACING;
	spacing <<= 16; 				// Line Space
	spacing += VIEWER_HORIZONTAL_CHILD_SPACING;	// horizontal
	return spacing;
}

/*--------------------- MSG_VIS_COMP_GET_MARGINS ---------------------
 * Purpose:	Returns the distance of the children from the edges.
 *		This message returns the margins the composite should use when
 *		recalculating its child spacing. If you want a special left, top, right, or bottom
 *		margin around the composite's children, intercept this message and return
 *		the margin(s) in the appropriate field(s) of the Rectangle structure.
 * Parameters:	void (Rectangle *retValue);
 * Return:		-
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_VIS_COMP_GET_MARGINS {
	retValue->R_left = VIEWER_MARGIN;
	retValue->R_right = VIEWER_MARGIN;
	retValue->R_top = VIEWER_MARGIN;
	retValue->R_bottom = VIEWER_MARGIN;
	}



/*###########################################################################
 #
 #	Mouse message handlers
 #
 #	The IconDBViewerClass has a simple MSG_META_START_SELECT
 #	handler. MSG_META_START_SELECT is handled by the VisISetClass object.
 #	They calls the IconDBViewerClass back to select/edit the appropriate
 #	icon or icon set(s).
 #
 #	Only the rubberband's start coordinates are stored, the rubberband
 #	itself is initiated in the MSG_META_DRAG_SELECT handler and
 #	finished in MSG_META_END_SELECT.
 #
 ###########################################################################



/*--------------------- MSG_META_START_SELECT ---------------------
 *  Purpose:	Handle left click into the view.

 *  Strategy:
	- let the VisISet objects do the main job ( using @callsuper() )
	- store the top-left coordinates for the rubberband so that the
	  rubberband starts at the point where the user clicked the mouse

 *  Parameters:void (MouseReturnParams *retVal,
 *		sword xPosition, sword yPosition,
 *		word inputState)
 *      	inputState: lowByte: ButtonInfo
 *			    highByte: UIFunctionsActive
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_META_START_SELECT {

    @callsuper();

    pself->DBVI_rubberBand.R_left = xPosition;
    pself->DBVI_rubberBand.R_top = yPosition;

    retVal->flags = MRF_PROCESSED;

}

/*--------------------- MSG_META_DRAG_SELECT ---------------------
 *  Purpose:	initialize rubberband

 *  Strategy:
	- draw the rubberband for the first time
 *  Parameters:void (MouseReturnParams *retVal,
 *		sword xPosition, sword yPosition,
 *		word inputState)
 *      	inputState: lowByte: ButtonInfo
 *			    highByte: UIFunctionsActive
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_META_DRAG_SELECT {


    /*
     *  Initalize the rubberband points and draw it for the first time.
     *  Top-left coordinates are already set in META_START_SELECT
     *
     */
    pself->DBVI_buttonDown = TRUE;
    pself->DBVI_rubberBand.R_right = xPosition;
    pself->DBVI_rubberBand.R_bottom = yPosition;

    ViewerDrawRubberBand(oself);

    retVal->flags = MRF_PROCESSED;
}

/*--------------------- ViewerDrawRubberBand ---------------------
 *  Purpose:	Draws an inverted rectangle
 *  Context:
 *  Strategy:
	- create a gstate for drawing
	- draw an inverted rectangle using the stored
	  coordinates
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void ViewerDrawRubberBand(optr oself) {
IconDBViewerInstance *pself;
GStateHandle gstate;

    pself = ObjDerefVis(oself);
    gstate = @call oself::MSG_VIS_VUP_CREATE_GSTATE();
    GrSetMixMode(gstate, MM_INVERT);
    GrSetLineStyle(gstate, LS_DOTTED, 0, 0, 0);
    GrDrawRect(gstate, pself->DBVI_rubberBand.R_left,
    		pself->DBVI_rubberBand.R_top,
    		pself->DBVI_rubberBand.R_right,
    		pself->DBVI_rubberBand.R_bottom);
    GrDestroyState(gstate);

}



/*--------------------- MSG_META_END_SELECT ---------------------
 *  Purpose:	Stops drawing rubberband, and selects icon sets.

 *  Strategy:
	- if we're rubberbanding, draw the final rubberband.
	- clear the "buttonDown" flag
	- record a MSG_VIS_ISET_CHECK_IN_RECTANGLE classed event
	  and sent it to the children to select/deselect them
 *  Parameters:void (MouseReturnParams *retVal,
 *		sword xPosition, sword yPosition,
 *		word inputState)
 *      	inputState: lowByte: ButtonInfo
 *			    highByte: UIFunctionsActive
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_META_END_SELECT {

    /*
     *  If the buttonDown flag isn't set, skip the rubberbanding,
     *  else clear the rubberband.
     */
    if ( ! (pself->DBVI_buttonDown) ) goto done;
    ViewerDrawRubberBand(oself);

     /*
     *  Send a check-in-rectangle message to the children.
     */
    @send @visChildren::MSG_VIS_ISET_CHECK_IN_RECTANGLE(pself->DBVI_rubberBand);

done:
    pself->DBVI_buttonDown = FALSE;
    retVal->flags = MRF_PROCESSED;

}


/*--------------------- MSG_META_PTR ---------------------
 *  Purpose:	 Draws a rubberband if buttonDown.
 *  Context:
 *  Strategy:
	- handle quick-copy stuff
	- if mouse button's not down, bail
	- clear the old rubberband
	- store the new coordinates
	- draw the new rubberband
 *  Parameters:void (MouseReturnParams *retVal,
 *		sword xPosition, sword yPosition,
 *		word inputState)
 *      	inputState: lowByte: ButtonInfo
 *			    highByte: UIFunctionsActive
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_META_PTR {

    /*
     *  Do the rubberbanding stuff. DBVI_buttonDown is false if quick transfer
     */
    if( pself->DBVI_buttonDown ) {
    	ViewerDrawRubberBand(oself);
	pself->DBVI_rubberBand.R_right = xPosition;
	pself->DBVI_rubberBand.R_bottom = yPosition;

    	ViewerDrawRubberBand(oself);
    }

    retVal->flags = MRF_PROCESSED;
    }



