/*-----------------------------------------------------------------------------
			Customize Tools Dialog & Control
-----------------------------------------------------------------------------*/

@object GenInteractionClass CustomizeToolsDialog = {
    GI_visMoniker = 'C', "Customize Tool Bars";
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_COMMAND;
    GI_comp = @IconToolControl;
    HINT_ORIENT_CHILDREN_VERTICALLY;
}


@object GenToolControlClass IconToolControl = {
    GTCI_toolboxList = @IconToolboxList;
    GTCI_toolGroupList = @IconToolGroupList;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    ATTR_GEN_CONTROL_APP_UI = @ToolMoreInfoBox;
    	/* Note: Index colors for lines and areas are not managed by the
    	 * ToolControl object because they are proibited and some UI
    	 * that supports custom palettes has been added using
    	 * ATTR_GEN_CONTROL_APP_TOOLBOX_UI instead.
    	 */
}

@chunk optr IconToolboxList[] = {	/*ToolboxInfo = struct { optr, optr } */

@if @USE_TWO_TOP_TOOL_BARS
	@TopLeftToolbar,	@TopLeftToolbarName,
	@TopRightToolbar,	@TopRightToolbarName,
@else
	@TopToolbar,		@TopToolbarName,
@endif
	@LeftToolbar,		@LeftToolbarName,
	@RightToolbar,		@RightToolbarName,
	@BottomToolbar,		@BottomToolbarName,
	@FloatingToolbox,	@FloatingToolboxName
};

@if @USE_TWO_TOP_TOOL_BARS
@chunk char TopLeftToolbarName[] = "Above the Document, on the left";
@chunk char TopRightToolbarName[] = "Above the Document, on the right";
@elseif
@chunk char TopToolbarName[] = "Above the Document";
@endif

@chunk char LeftToolbarName[] = "Left of Document";
@chunk char RightToolbarName[] = "Right of Document";
@chunk char BottomToolbarName[] = "Below the Document";
@chunk char FloatingToolboxName[] = "Floating Toolbox";

@chunk optr IconToolGroupList[] = {	/*ToolGroupInfo = struct {optr } */
	@IconFileTools,
	@IconEditTools,
	@IconLineColorTools,
	@IconLineAttrTools,
	@IconAreaColorTools,
	@IconBitmapEditTools,

	@Spacer1ToolGroup,
	@Spacer2ToolGroup,
	@Spacer3ToolGroup,
	@Spacer4ToolGroup,
	@Spacer5ToolGroup,
	@Spacer6ToolGroup
};

    /*
     * To make the toolbars look a little nicer, we have 6 spacers.
     * Each spacer consists of a ToolGroup object and a glyph. The
     * glyph is directly a child, because there is no special
     * tool ui for the spacer controller. We also need a
     * controller object so that the tool management can work.
     */
@define ToolSpacerCommonStuff(glyph, controller) \
	GI_states = @default |  GS_USABLE | GS_ENABLED; \
    	GI_comp = glyph;	\
    	GTGI_controller = controller; \
	HINT_SAME_ORIENTATION_AS_PARENT; \
	HINT_MINIMIZE_CHILD_SPACING



@define ToolControllerCommonStuff(name) \
 	GI_states = @default |  GS_USABLE | GS_ENABLED;	\
 	TOCI_controllerName =  name; \
	ATTR_GEN_CONTROL_PROHIBIT_UI = 0xFFff;	/* hide ALL UI - if any */ \
	ATTR_GEN_CONTROL_PROHIBIT_TOOLBOX_UI = 0xffFF


/* ToolGroups to place in tool bar and ToolGroupList */
@object GenToolGroupClass Spacer1ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer1Glyph, @Spacer1Control);
    }
@object GenToolGroupClass Spacer2ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer2Glyph, @Spacer2Control);
    }
@object GenToolGroupClass Spacer3ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer3Glyph, @Spacer3Control);
    }
@object GenToolGroupClass Spacer4ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer4Glyph, @Spacer4Control);
    }
@object GenToolGroupClass Spacer5ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer5Glyph, @Spacer5Control);
    }
@object GenToolGroupClass Spacer6ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer6Glyph, @Spacer6Control);
    }

@object GenGlyphClass Spacer1Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer2Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer3Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer4Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer5Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer6Glyph = { GI_visMoniker = " "; }

@object ToolOnlyControlClass Spacer1Control = {
    @ToolControllerCommonStuff(@ToolSpacer1Name);
    }
@object ToolOnlyControlClass Spacer2Control = {
    @ToolControllerCommonStuff(@ToolSpacer2Name);
    }
@object ToolOnlyControlClass Spacer3Control = {
    @ToolControllerCommonStuff(@ToolSpacer3Name);
    }
@object ToolOnlyControlClass Spacer4Control = {
    @ToolControllerCommonStuff(@ToolSpacer4Name);
    }
@object ToolOnlyControlClass Spacer5Control = {
    @ToolControllerCommonStuff(@ToolSpacer5Name);
    }
@object ToolOnlyControlClass Spacer6Control = {
    @ToolControllerCommonStuff(@ToolSpacer6Name);
    }


/* Names for our own ToolOnlyControlClass controllers */
@chunk char ToolSpacer1Name[] = "Spacer 1";
@chunk char ToolSpacer2Name[] = "Spacer 2";
@chunk char ToolSpacer3Name[] = "Spacer 3";
@chunk char ToolSpacer4Name[] = "Spacer 4";
@chunk char ToolSpacer5Name[] = "Spacer 5";
@chunk char ToolSpacer6Name[] = "Spacer 6";


