}




/* end of preview display class group > */

/*-----------------------------------------------------------------------------
	Preview Dialog Reply Bar
-----------------------------------------------------------------------------*/

@object GenInteractionClass PreviewDialogReplyBar = {
    GI_comp = @UpdatePreviewTrigger, @ClosePreviewTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    HINT_MAKE_REPLY_BAR;
}

@object GenTriggerClass UpdatePreviewTrigger = {
    GI_visMoniker = 'd', "Update - F4";
    	/* The shortcut is not displayed for a trigger placed here */
    GTI_actionMsg = MSG_DB_VIEWER_PREVIEW_ICON_UPDATE_DIALOG;
    @SetTriggerDestination_TO_DB_VIEWER;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = @specificUI F4;
}

@object GenTriggerClass ClosePreviewTrigger = {
    GI_visMoniker = 'l', "Close";
    GTI_actionMsg = MSG_DB_VIEWER_PREVIEW_ICON_CLOSE_DIALOG;
    @SetTriggerDestination_TO_DB_VIEWER;
}

/* end of preview dialog > */

@end PreviewResource;

