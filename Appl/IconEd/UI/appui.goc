/*-----------------------------------------------------------------------------
	Icon Menu - deals with the currently edited Icon
-----------------------------------------------------------------------------*/

@object GenInteractionClass IconMenu = {
    GII_visibility =     GIV_POPUP;
    GI_visMoniker = 'I', "Icon";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_comp = @IconMenuSubGroup;
    	/*
    	 * The menu is placed in the document control's enableDisabale list.
    	 * Therefore, when we open a documuent with no icon sets, the document control
    	 * enables the menu **after** the DisableEditing() routine has disabled it.
    	 * So DisableEditing() disables the sub group and anything is fine.
    	 */
}

@object GenInteractionClass IconMenuSubGroup = {
    GI_comp = @AddIconTrigger,
	  @DuplicateIconTrigger,
	  @RenameIconTrigger,
	  @DeleteIconTrigger,
	  @IconMenuInnerGroup;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

@object GenInteractionClass IconMenuInnerGroup = {
    GI_comp =
	  @TransformIconSubmenu,
	  @CropIconTrigger,
	  @InitiateShiftImageTrigger,
	  @ResizeLaunchTrigger,
	  @ModifyIconSubGroup,
	  @SaveIconGroup;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

@object GenInteractionClass ModifyIconSubGroup = {
    GI_comp =  @ModifyIconAttributesTrigger, @PreviewLaunchTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

