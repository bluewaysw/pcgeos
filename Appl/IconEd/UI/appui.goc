@object GenItemClass PDCUseIconItem = {
    GI_visMoniker = 'i', "Use value from icon";
    GII_identifier = PIDC_USE_ICON_VALUE;
}

@object GenItemClass PDCMonoItem = {
    GI_visMoniker = 'M', "Monochrome";
    GII_identifier = PIDC_MONO;
}

@object GenItemClass PDCColor16Item = {
    GI_visMoniker = '6', "16 colors";
    GII_identifier = PIDC_COLOR16;
}

@object GenItemClass PDCColor256Item = {
