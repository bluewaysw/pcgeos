/*-----------------------------------------------------------------------------
		RenameISetDialog
-----------------------------------------------------------------------------*/

@object GenInteractionClass RenameISetDialog = {
    GI_attrs = GA_NOTIFY_VISIBILITY;

    GII_visibility = GIV_DIALOG;
    GII_attrs = @default |  GIA_NOT_USER_INITIATABLE | GIA_MODAL;
    GII_type = GIT_COMMAND;
    GI_visMoniker = 'R', "Rename Icon Set";
    GI_comp = @RenameISetTextField, @RenameISetInfoText,
	          @DoRenameISetTrigger;

    ATTR_GEN_VISIBILITY_DESTINATION = @RenameISetTextField;
    ATTR_GEN_VISIBILITY_MESSAGE = MSG_VIS_TEXT_SELECT_ALL;

}

@object SmartTextClass RenameISetTextField = {
    GI_visMoniker = 'N', "New Name:";
    GTXI_attrs = @default | GTA_SINGLE_LINE_TEXT;
    GTXI_maxLength = MAX_ISET_NAME_LENGTH;
    HINT_PLACE_MONIKER_ABOVE;
    HINT_TEXT_FRAME;
    HINT_TEXT_WHITE_WASH_COLOR;
    HINT_DEFAULT_FOCUS;
    STI_enableObj = @DoRenameISetTrigger;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}
@object GenTextClass RenameISetInfoText = {
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
    GTXI_text = "The name should describe the purpose of this set of icons.";
    HINT_MINIMUM_SIZE = { SST_AVG_CHAR_WIDTHS | 35, SST_LINES_OF_TEXT | 2, 0};	\
}

@object GenTriggerClass DoRenameISetTrigger = {
    GI_visMoniker = 'R', "Rename Set";
    GI_attrs = @default | GA_SIGNAL_INTERACTION_COMPLETE;
    GTI_actionMsg = MSG_DB_VIEWER_RENAME_ISET;
    ATTR_GEN_TRIGGER_ACTION_DATA = FALSE;
    @SetTriggerDestination_TO_DB_VIEWER;
