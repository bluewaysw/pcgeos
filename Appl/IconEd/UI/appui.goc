    GI_comp = @TextMonikerEnableOption;
    GBGI_selectedBooleans = DEFAULT_TEXT_MONIKER_OPTIONS;
    GBGI_applyMsg = MSG_DB_VIEWER_TEXT_MONIKER_OPTION_CHANGED;
    @SetBooleanGroupDestination_TO_DB_VIEWER;
}

@object GenBooleanClass TextMonikerEnableOption = {
    GI_visMoniker = 'x', "Export Text Monikers to TokenDB File";
    GBI_identifier = OPT_ENABLE_TEXT_MONIKER_EXPORT;
}

@object SmartTextClass TextMonikerTextInput = {
    GI_visMoniker = 'T', "Text Moniker:";
    GI_states = @default & ~GS_ENABLED;
    GTXI_attrs = @default | GTA_SINGLE_LINE_TEXT;
    GTXI_maxLength = MAX_TEXT_MONIKER_LENGTH;

    HINT_PLACE_MONIKER_ABOVE;
