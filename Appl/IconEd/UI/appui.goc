    GIGI_selection = 30;
    GI_comp = @RR48x30Item, @RR48x14Item,
    		@RR15x15Item, @RR15x10Item, @RR32x20Item, @RR64x40Item, @RR64x18Item;
    @SetItemGroupDestination_TO_DB_VIEWER;
    GIGI_applyMsg = MSG_DB_VIEWER_RESIZE_IMAGE_NEW_INITIAL_SIZE;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_ITEM_GROUP_MINIMIZE_SIZE;
    ATTR_GEN_ITEM_GROUP_SET_MODIFIED_ON_REDUNDANT_SELECTION;
}

