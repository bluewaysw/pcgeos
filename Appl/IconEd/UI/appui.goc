/*---------------------------------------------------------------------------
 Resource definition Controllers
 ---------------------------------------------------------------------------*/
@start Controllers;

/*---------------------------------------------------------------------------
	The DocumentControl manages the document of our application
	This is the database file
 ---------------------------------------------------------------------------*/
@object GenInteractionClass IconDocumentControlGroup = {
    GI_comp = @IconDocumentControl;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

@object GenDocumentControlClass IconDocumentControl = {

    GDCI_noNameText = "No Database";
    GDCI_documentGroup = IconDocumentGroup;

    GDCI_enableDisableList = IconEnableDisableList;

    GDCI_templateDir ="Icon Templates";
    GDCI_documentToken = { "IDOC", 0 };

    GDCI_attrs = (@default | GDCA_MULTIPLE_OPEN_FILES);
    GDCI_features = (@default) & ~(GDCF_NAME_ON_PRIMARY);
    GI_attrs = @default | GA_KBD_SEARCH_PATH;

}

/* All object in this list must be defined as ~GS_ENABLED */
@chunk optr IconEnableDisableList[] = { @IconEditMenu, @ISetMenu, @IconMenu,
	@IconOptionsMenu, @IconGraphicsMenu, @IconExtrasMenu,
	@IconTopImpexGroup };

@object GenToolGroupClass IconFileTools = {	/* in ToolGroupList */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    GTGI_controller = @IconDocumentControl;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_TOOLBOX;
}

/*---------------------------------------------------------------------------
	The DisplayControl managed the windows in the DisplayGroup
 ---------------------------------------------------------------------------*/
@object GenDisplayControlClass IconDisplayControl = {
}


/*---------------------------------------------------------------------------
 *	Edit-"Controller".
 *	Instead of using an EditControl object, we use a set of individual
 * 	triggers, since we can have both icons (graphics) and icon sets in
 *	the clipboard.
 *	Additionally, besides an Undo trigger, we also need a Redo trigger
 *	as well as an special tool setup for the tool bar.
 ---------------------------------------------------------------------------*/

/*--- Undo/Redo group ---*/

@object GenInteractionClass UndoRedoGroup = {
    GI_comp = @IconUndoTrigger, @IconRedoTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenTriggerClass IconUndoTrigger = {
    GI_visMoniker = "Undo:";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'Z';
    @SetTriggerDestination_TO_BITMAP;
    GTI_actionMsg = MSG_FATBITS_UNDO;
}
@object GenTriggerClass IconRedoTrigger = {
    GI_visMoniker = "Redo:";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'R';
    @SetTriggerDestination_TO_BITMAP;
    GTI_actionMsg = MSG_FATBITS_REDO;
}

/*--- Copy/Paste icon graphics group ---*/

@object GenInteractionClass EditGraphicsGroup = {
    GI_comp = @IconCopyIconTigger, @IconPasteIconTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenTriggerClass IconCopyIconTigger = {
    GI_visMoniker = 'o', "Copy Graphic";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'C';
    @SetTriggerDestination_TO_BITMAP;
    GTI_actionMsg = MSG_META_CLIPBOARD_COPY;
}
@object GenTriggerClass IconPasteIconTrigger = {
    GI_visMoniker = 'a', "Paste Graphic";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'V';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_META_CLIPBOARD_PASTE;
}

/*--- Copy/Paste whole sets of icons ---*/

@object GenInteractionClass EditIconSetGroup = {
    GI_comp = @IconCopyISetTrigger, @IconPasteISetTrigger, @IconSelectAllISetTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenTriggerClass IconCopyISetTrigger = {
    GI_states = @default & ~GS_ENABLED;
    GI_visMoniker = 'n', "Copy Icon Set";
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'T';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_DB_VIEWER_COPY_ISETS;
}
@object GenTriggerClass IconPasteISetTrigger = {
    GI_visMoniker = 12, "Paste Icon Set";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'K';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_DB_VIEWER_PASTE_ISETS;
}
@object GenTriggerClass IconSelectAllISetTrigger = {
    GI_visMoniker = 'l', "Select all";
    GI_states = @default & ~GS_ENABLED;
/*
ctrl-A is used for "Add Icon". I think, we don't need a
keyboard accelerator for this menu entry.
*/
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_DB_VIEWER_SELECT_ALL;
}

/*--- Toolbar tools deal with the icon graphics ---*/
/*
 * For this purpose we need an special setup.
 *	- a GenToolGroup object to be placed in one of the toolbars
 *	- a Controller to make the GenToolControl object work
 *	- our self-defined tools UI
 */

@object GenToolGroupClass IconEditTools = {	/* place this in tool bar and ToolGroupList */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    /*
     * Any GenToolGroupClass object must by connected to a
     * controller to make the GenToolControl work
     */
    GTGI_controller = @ToolOnlyEditControl;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_MINIMIZE_CHILD_SPACING;
}

    /*
     * Set up a controller for our tools.
     * We hide any default UI, only our special UI is shown
     * as children of the IconEditTools object.
     * There are only tools, no "normal" UI.
     */
@object ToolOnlyControlClass ToolOnlyEditControl = {
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    ATTR_GEN_CONTROL_PROHIBIT_UI = 0xFFFF;
    TOCI_controllerName = @ToolOnylEditControlName;
    TOCI_SetupToolMsg = MSG_TOC_SETUP_EDIT_CONTROL_TOOLS;
}
@chunk char ToolOnylEditControlName[] = "Clipboard / Undo";





/*---------------------------------------------------------------------------
 *	Import- and Export-Controller.
 *	For a detailed description see Objects Manual, 16: Impex-Library
 ---------------------------------------------------------------------------*/

@object ExportControlClass IconExportControl = {
    GI_visMoniker = "Export Graphic to File";
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE;
    ECI_dataClasses = IDC_GRAPHICS;

    ECI_message = MSG_DB_VIEWER_PREPARE_FOR_EXPORT;
    ECI_destination = (TO_DB_VIEWER);
    ATTR_GEN_OUTPUT_TRAVEL_START = @IconApp;
    ATTR_GEN_DESTINATION_CLASS = (ClassStruct*)&IconDBViewerClass;
}


@object ImportControlClass IconImportControl = {
    GI_visMoniker = "Import Graphic from File";
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE;
