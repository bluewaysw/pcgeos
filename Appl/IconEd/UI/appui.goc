@object GenInteractionClass TextMonikerDialog = {
    GI_visMoniker = "Text Monikers";
    GII_visibility = GIV_DIALOG;
    GII_attrs = @default |  GIA_NOT_USER_INITIATABLE;
    GI_comp = @TextMonikerInfoText, @TextMonikerBottomGroup, @TextMonikerReplyBar;
    HINT_ORIENT_CHILDREN_VERTICALLY;
}

@object GenTextClass TextMonikerInfoText = {
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_MINIMUM_SIZE = { SST_AVG_CHAR_WIDTHS | 55, SST_LINES_OF_TEXT | 3, 1 };
    GTXI_text = "Text monikers aren't actually needed in the token database. However, \
many programs still export text monikers. The Icon Editor retains these monikers when \
importing tokens from the token database file and can re-export them.\r\
However, text monikers are not written as source code.";
}

@object GenInteractionClass TextMonikerBottomGroup = {
    GI_comp = @TextMonikerEnableGroup,
    		@TextMonikerTextInput, @TextMonikerAbbrevTextInput, @TextMonikerInfoText2;
    HINT_MINIMIZE_CHILD_SPACING;
    GII_type = GIT_NOTIFICATION;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}


