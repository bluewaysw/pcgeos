/* ---------- < Top right objetcts */

	/* --------- New color -----------*/

@object GenInteractionClass ResizeRightNewColorGroup = {
    GI_visMoniker = "New Color:";
    GI_comp = @ResizeNewColorChooser;
}
@object GenItemGroupClass ResizeNewColorChooser = {
    GI_comp =   @ResizeNewColorMono, @ResizeNewColor4Bit, @ResizeNewColor8Bit,
    		@ResizeNewColor4BitPal, @ResizeNewColor8BitPal, @ResizeNewColorRGB;
    GIGI_selection = BMF_4BIT | BMT_PALETTE;
    @SetItemGroupDestination_TO_DB_VIEWER;
    GIGI_applyMsg = MSG_DB_VIEWER_RESIZE_IMAGE_NEW_SCALE_OR_COLOR;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_WRAP_AFTER_CHILD_COUNT = 3;
}

@object GenItemClass ResizeNewColorMono = { GI_visMoniker = 'M', "Monochrome"; GII_identifier = BMF_MONO; }
@object GenItemClass ResizeNewColor4Bit = { GI_visMoniker = '6', "16 colors"; GII_identifier = BMF_4BIT; }
@object GenItemClass ResizeNewColor8Bit = { GI_visMoniker = '2', "256 colors"; GII_identifier = BMF_8BIT; }
@object GenItemClass ResizeNewColorRGB = { GI_visMoniker = 'u', "True color"; GII_identifier = BMF_24BIT; }
@object GenItemClass ResizeNewColor4BitPal = { GI_visMoniker = '1', "16 colors, palette"; GII_identifier = BMF_4BIT | BMT_PALETTE; }
@object GenItemClass ResizeNewColor8BitPal = { GI_visMoniker = '5', "256 colors, palette"; GII_identifier = BMF_8BIT | BMT_PALETTE; }

	/* --------- New Size -----------*/

