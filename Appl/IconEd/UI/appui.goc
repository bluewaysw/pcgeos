    GTI_actionMsg = MSG_DB_VIEWER_TEXT_MONIKER_CLOSE_DIALOG;
    ATTR_GEN_TRIGGER_ACTION_DATA = FALSE;
    @SetTriggerDestination_TO_DB_VIEWER;
}

/* TextMonikerDialog ends > */

