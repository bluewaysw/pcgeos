/* -------- The IconDBView displays the icon sets ---------- */

@object GenViewClass IconDBView = {

    GVI_content = @DBViewerContent;
    GVI_horizAttrs = @default | GVDA_SCROLLABLE;
    GVI_vertAttrs  = @default | GVDA_SCROLLABLE;
    HINT_VIEW_REMOVE_SCROLLERS_WHEN_NOT_SCROLLABLE;

    HINT_DEFAULT_FOCUS;
    HINT_DEFAULT_TARGET;

    /*
     * The geometry (sizeing) is very limited. This prevents the
     * object from covering a large part of the display.
     */
    HINT_MINIMUM_SIZE = { SST_PIXELS | VIEWER_VIEW_FIXED_WIDTH,
			SST_PIXELS | VIEWER_VIEW_MIN_HEIGHT, 1};
    HINT_MAXIMUM_SIZE = { SST_PIXELS | VIEWER_VIEW_FIXED_WIDTH,
			SST_LINES_OF_TEXT | VIEWER_VIEW_MAX_HEIGHT, 1};


    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;

}

@object IconDBViewerClass DBViewerContent = {
    VCNI_attrs = @default | VCNA_SAME_WIDTH_AS_VIEW;
    VCI_geoAttrs = VCGA_ALLOW_CHILDREN_TO_WRAP; /* | VCGA_WRAP_AFTER_CHILD_COUNT /*| VCGA_ONLY_DRAWS_IN_MARGINS*/
}


