@object GenInteractionClass TextMonikerReplyBar = {
    GI_comp = @TextMonikerSaveTrigger, @TextMonikerCancelTrigger;
    HINT_MAKE_REPLY_BAR;
}

@object GenTriggerClass TextMonikerSaveTrigger = {
    GI_visMoniker =  'a', "Save Settings";
    ATTR_GEN_TRIGGER_ACTION_DATA = TRUE;
