 *	RainerB 7/18/2025	Initial revision
 *
 *
 * DESCRIPTION:	The UI of the Icon Editor Application
 *
 *	NOTE:	You may find some "meaningles" < or > characters in the comments.
 *		You can jump back and forth between these brackets if your text
 *		editor supports that.
 *
 **************************************************************************/


/*  Standard include files */
@include <stdapp.goh>
@include <objects/gViewCC.goh>
@include <bmptools.goh>

@include "iconed.goh"
@include "Main/iconConstants.h"
@include "Document/iconFile.goh"



/*---------------------------------------------------------------------------
 	useful UI mocros
 ---------------------------------------------------------------------------*/

/* All Shift-image-to-triggers have the same properties.
 * Private note: The comment in front of @object GenTriggerClass
 * prevents my make-extern tool from creating an @extern statement
 * (@extern object objName) which may cause the compiler to fail,
 * if the string 'objName' is used twice or more - R.B. */
@define ShiftImageTrigger(objName, visMon, direction) \
/* do not remove this comment, please */    @object GenTriggerClass objName = { GI_visMoniker = list { visMon }; \
    ATTR_GEN_TRIGGER_ACTION_DATA = direction; \
    GTI_destination = process; GTI_actionMsg = MSG_ICON_SHIFT_IMAGE_TO; \
    }

@define PreviewColorItem(objName, itemColor)	\
/* do not remove this comment, please */ @object GenItemClass objName = { \
	GII_identifier = itemColor;	\
	GI_visMoniker =	{		\
	    size = tiny;		color = color4;		\
	    aspectRatio = normal;	cachedSize = 15, 15;	\
	gstring {						\
	    GSSetAreaColorIndex(itemColor),			\
	    GSFillRect(0,0,15,15),				\
	    GSEndString()	\
	    }			\
	}			\
}



/*---------------------------------------------------------------------------
 Resource AppResource
 ---------------------------------------------------------------------------*/
@start AppResource;

@object IconApplicationClass IconApp = {
    GI_visMoniker = list { @AppVGAMoniker, @AppVGAMonoMoniker, @AppCGAMoniker,
			   @AppToolCMoniker, @AppToolMonoMoniker, @AppToolCGAMoniker,
			   @IconTextMoniker };

    GI_comp = @IconPrimary;

	gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) =
		@IconPrimary;
	gcnList(MANUFACTURER_ID_GEOWORKS,MGCNLT_APP_STARTUP) =
		@IconDocumentControl;
	gcnList(MANUFACTURER_ID_GEOWORKS,MGCNLT_ACTIVE_LIST) =
		@IconDocumentControl,
		@IconDisplayControl,
		@IconToolControl;
	gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_STARTUP_LOAD_OPTIONS) =
		@IconToolControl;
	gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_SELF_LOAD_OPTIONS) =
		@IconDocumentControl,
		@IconDisplayControl,
		@IconToolControl,
		@IconBitmapToolControl,
		@IconImportControl,
		@IconExportControl,
		@IconAreaColorSelector,
		@IconLineColorSelector,
		@IconLineAttrControl,

		@ToolOnlyEditControl,
		@Spacer1Control,
		@Spacer2Control,
		@Spacer3Control,
		@Spacer4Control,
		@Spacer5Control,
		@Spacer6Control;

	gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_APP_TARGET_NOTIFY_GROBJ_LINE_ATTR_CHANGE) = @IconLineAttrControl;


	ATTR_GEN_INIT_FILE_CATEGORY = IE_INI_CATEGORY;
	ATTR_GEN_HELP_FILE = "IconEd Help";
        }        /* end of IconApp */


@end AppResource;


/*---------------------------------------------------------------------------
 Resource definition MonikerResource
 ---------------------------------------------------------------------------*/
@start MonikerResource, data;

@include "Art/AppIcons.goh"
@include "Art/DocIcons.goh"
@include "Art/SortMoveIconMonikers.goh"
@include "Art/cropmon.goh"
@include "Art/shiftdirection.goh"

/* This list only contains the document monikers */
@visMoniker IconDocMonikerList = list { @DocVGAMoniker, @DocVGAMonoMoniker, @DocCGAMoniker,
					@DocVGAToolMoniker, @DocVGAToolMonoMoniker, @DocCGAToolMoniker};

/* A second list contains the application monikers - used to update older AppTokens*/
@visMoniker IconAppMonikerList = list { @AppVGAMoniker, @AppVGAMonoMoniker, @AppCGAMoniker,
					@AppToolCMoniker, @AppToolMonoMoniker, @AppToolCGAMoniker,
					@IconTextMoniker };
@visMoniker IconTextMoniker = "Icon Editor";

@end MonikerResource;

