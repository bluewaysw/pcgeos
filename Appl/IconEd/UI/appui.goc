@visMoniker RTScalingNotRequired = "Unscaled";	/* VisMonikers must be placed in front of the Glyph object */
@visMoniker RTScalingSystem = "System";
@visMoniker RTScalingBilinear = "Bilinear";
@visMoniker RTCommonEmptyMoniker = "";

@object GenGlyphClass ResizeTargetScalingGlyph = {
    GI_visMoniker = @RTCommonEmptyMoniker;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object GenInteractionClass ResizeTargetColorReductionGroup = {
    GI_visMoniker = "Color Reduction:";
    GI_comp = @ResizeTargetColorReductionGlyph;
    HINT_BOTTOM_JUSTIFY_CHILDREN;
}
@visMoniker RTColorReductionNotRequired = "Not Required";
@visMoniker RTColorReductionNearestColor = "Nearest Color";
@visMoniker RTColorReductionDithering = "Dithering";

@object GenGlyphClass ResizeTargetColorReductionGlyph = {
    GI_visMoniker = @RTCommonEmptyMoniker;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object GenInteractionClass ResizeTargetMaskGroup = {
    GI_visMoniker = "Mask:";
    GI_comp = @ResizeTargetMaskGlyph;
    HINT_BOTTOM_JUSTIFY_CHILDREN;
}
@visMoniker RTMaskScalingNotRequired = "Unscaled";
@visMoniker RTMaskSystemScaled = "Scaled by System";
@visMoniker RTMaskBilinearScaled = "Bilinear Scaled";
@visMoniker RTMaskOpaque = "Available, but Opaque";

@object GenGlyphClass ResizeTargetMaskGlyph = {
    GI_visMoniker = @RTCommonEmptyMoniker;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object GenTextClass ResizeTargetSizeText = {
    GI_visMoniker = "Uncompresssed Size:";
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
    HINT_INITIAL_SIZE = { SST_PIXELS | RESIZE_TARGET_VIEW_WIDTH/2, SST_LINES_OF_TEXT, 1};
}

/* Target View and Info ends > */

/*  < Icon Properties objects   */

@object GenInteractionClass ResizeTargetTopRightGroup = {
    GI_visMoniker = " ";
    HINT_PLACE_MONIKER_ABOVE;
    GI_comp = @ResizeNewNameText, @ResizePropertiesGroup,
    		@ResizeAspectChooser, @ResizeDisplayClassGroup;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object SmartTextClass ResizeNewNameText = {
    GI_visMoniker = 'w', "New Name and Icon Attributes:";
    GTXI_attrs = @default | GTA_SINGLE_LINE_TEXT;
    ATTR_GEN_TEXT_NO_SPACES;
    GTXI_maxLength = MAX_ICON_NAME_LENGTH;
    HINT_PLACE_MONIKER_ABOVE;
    HINT_TEXT_FRAME;
    HINT_TEXT_WHITE_WASH_COLOR;
    HINT_DEFAULT_FOCUS;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}


@object GenInteractionClass ResizePropertiesGroup = {
    GI_comp = 	@ResizeDisplaySizeChooser,
    		@ResizeStyleChooser;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_DIVIDE_WIDTH_EQUALLY;
}

	/* --- Display Size --- */

@object GenItemGroupClass ResizeDisplaySizeChooser = {
    GIGI_selection = DS_STANDARD;
    GI_comp = @ResizeHugeSizeItem, @ResizeLargeSizeItem, @ResizeStandardSizeItem, @ResizeTinySizeItem;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_DIVIDE_WIDTH_EQUALLY;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_ITEM_GROUP_MINIMIZE_SIZE;
    HINT_ITEM_GROUP_DISPLAY_CURRENT_SELECTION;
}
@object GenItemClass ResizeHugeSizeItem = {
    GI_visMoniker = 'H', "Huge";
@if @HIDE_HUGE_SCREEN_UI
    GI_states = @default & ~GS_USABLE;
@endif
    GII_identifier = DS_HUGE;
}
@object GenItemClass ResizeLargeSizeItem = { GI_visMoniker = 'L', "Large"; GII_identifier = DS_LARGE; }
@object GenItemClass ResizeStandardSizeItem = { GI_visMoniker = 'S', "Standard"; GII_identifier = DS_STANDARD;}
@object GenItemClass ResizeTinySizeItem = { GI_visMoniker = 'T', "Tiny"; GII_identifier = DS_TINY; }

	/* --- Style --- */

@object GenItemGroupClass ResizeStyleChooser = {
    GIGI_selection = VMS_ICON;
    GI_comp = @ResizeStyleIconItem, @ResizeStyleToolItem;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_DIVIDE_WIDTH_EQUALLY;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_ITEM_GROUP_MINIMIZE_SIZE;
    HINT_ITEM_GROUP_DISPLAY_CURRENT_SELECTION;
}

@object GenItemClass ResizeStyleIconItem = { GI_visMoniker = 'c', "File Icon"; GII_identifier = VMS_ICON; }
@object GenItemClass ResizeStyleToolItem = { GI_visMoniker = 'o', "Tool Icon"; GII_identifier = VMS_TOOL; }

	/* --- Aspect Ratio --- */

@object GenItemGroupClass ResizeAspectChooser = {
    GIGI_selection = DAR_NORMAL;
    GI_comp = @ResizeAspectNormalItem, @ResizeVerySquishedItem;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
}

@object GenItemClass ResizeAspectNormalItem = { GI_visMoniker = 'r', "Normal"; GII_identifier = DAR_NORMAL; }
@object GenItemClass ResizeVerySquishedItem = { GI_visMoniker = 'V', "Very squished (CGA)"; GII_identifier = DAR_VERY_SQUISHED; }

	/* --- DisplayClass --- */

@object GenInteractionClass ResizeDisplayClassGroup = {
    GI_visMoniker = "Display Class:";
    GI_comp = 	@ResizeDisplayClassChooser;
}
@object GenItemGroupClass ResizeDisplayClassChooser = {
    GIGI_selection = DC_COLOR_4;
    GI_comp = @ResizeColorBWItem, @ResizeColor16Item, @ResizeColor256Item, @ResizeColorTCItem;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_ITEM_GROUP_MINIMIZE_SIZE;
    HINT_ITEM_GROUP_DISPLAY_CURRENT_SELECTION;
}

@object GenItemClass ResizeColorTCItem = {
    GI_visMoniker = 'u', "True color";
    GII_identifier = DC_CF_RGB;
}
@object GenItemClass ResizeColor256Item = {
    GI_visMoniker = '2', "256 colors";
    GII_identifier = DC_COLOR_8;
}
@object GenItemClass ResizeColor16Item = {
    GI_visMoniker = '6', "16 colors";
    GII_identifier = DC_COLOR_4;
}
@object GenItemClass ResizeColorBWItem = {
    GI_visMoniker = 'M', "Monochrome";
    GII_identifier = DC_GRAY_1;
}

/*  Properties objetcts ends >  */



/* ---------- < Reply bar */

@object GenInteractionClass ResizeReplyBar = {
    GI_comp =  @ResizeResizeTrigger, @ResizeCreatePreviewTrigger, @ResizeCloseTrigger;
    HINT_MAKE_REPLY_BAR;
}
@object GenTriggerClass ResizeResizeTrigger = {
    GI_visMoniker = 'N', "Create New Icon";
    GTI_actionMsg = MSG_DB_VIEWER_RESIZE_IMAGE_APPLY_OR_CLOSE_DIALOG;
    ATTR_GEN_TRIGGER_ACTION_DATA = TRUE;
    @SetTriggerDestination_TO_DB_VIEWER;
    GI_states = @default & ~GS_ENABLED;
}

@object GenTriggerClass ResizeCreatePreviewTrigger = {
    GI_visMoniker = 'P', "Create Preview Images";
    GTI_actionMsg = MSG_ICON_RESIZE_IMAGE_CREATE_PREVIEWS;
    ATTR_GEN_TRIGGER_ACTION_DATA = TRUE;
    GTI_destination = process;
}

@object GenTriggerClass ResizeCloseTrigger = {
    GI_visMoniker = 'l', "Close";
    GTI_actionMsg = MSG_DB_VIEWER_RESIZE_IMAGE_APPLY_OR_CLOSE_DIALOG;
    ATTR_GEN_TRIGGER_ACTION_DATA = FALSE;
    @SetTriggerDestination_TO_DB_VIEWER;
}

/* Reply bar ends > */


/* ResizeDialog ends > */

/*---------------------------------------------------------------------------
	Progress box
 ---------------------------------------------------------------------------*/
@object GenInteractionClass IconProgressBox = {
    GI_visMoniker = "Progress";
    GI_comp = @IconProgressText;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    GII_attrs = GIA_NOT_USER_INITIATABLE;
    GII_visibility = GIV_DIALOG;
    HINT_INTERACTION_MAKE_RESIZABLE;
    ATTR_GEN_WINDOW_CUSTOM_LAYER_PRIORITY = LAYER_PRIO_ON_TOP;
    ATTR_GEN_WINDOW_CUSTOM_LAYER_ID = 0;
    }

@object GenTextClass IconProgressText = {
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_CHAR_ATTR = OptrToChunk(@ProgressCharAttr);
    HINT_TEXT_WASH_COLOR = { C_BLACK, CF_INDEX, 0, 0 };
    HINT_INITIAL_SIZE = { 40 | SST_AVG_CHAR_WIDTHS, 10 | SST_LINES_OF_TEXT, 10};
    GTXI_text = "No message yet";
    GTXI_attrs = @default | GTA_INIT_SCROLLING;
}

@chunk VisTextCharAttr ProgressCharAttr = CHAR_ATTR_STYLE_FONT_SIZE_STYLE_COLOR(
			 2, CA_NULL_ELEMENT, FID_UNIVERSITY, 12, 0, C_LIGHT_GREEN);


@end ResizeDialogResource;


