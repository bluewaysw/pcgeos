    GI_visMoniker = 'x', "Extra Information";
    GI_comp = @ToolMoreInfoText;
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_COMMAND;
    GI_states = @default & ~GS_USABLE;
}
@object GenTextClass ToolMoreInfoText = {
    GI_visMoniker = " ";
    GTXI_text = "\rIt is intended that some tool groups do not have tools in \
the dialog box for showing or hiding tools, and that some of the available tools are \
not displayed for other tool groups.\r";
    HINT_MINIMUM_SIZE = { SST_AVG_CHAR_WIDTHS | 35, SST_LINES_OF_TEXT | 1, 1 };
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
}


