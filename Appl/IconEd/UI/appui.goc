@object GenBooleanGroupClass OptionsBooleanGroup = {
    GI_comp = @ShowDatabase,  @ShowFatbits, @ShowIconArea,
    	  @BigDatabase, @BigIconList, @UseColoredIconList,
@if @ENABLE_BACKGROUND_PATTERN
	  @UseBackgroundPattern,
@endif
	  @ConfirmOnDelete,
	  @AllowOversizedIcons;
    GBGI_selectedBooleans = DEFAULT_ISET_OPTIONS;
    GBGI_destination = @IconApp;
    GBGI_applyMsg = MSG_ICON_APPLICATION_SET_OPTIONS;
}

@object GenBooleanClass ShowIconArea = {
    GI_visMoniker = 'L', "Show Icon List";
    GBI_identifier = IO_SHOW_ICON;
}

@object GenBooleanClass ShowDatabase = {
    GI_visMoniker = 'V', "Show Database Viewer";
    GBI_identifier = IO_SHOW_DATABASE;
}

@object GenBooleanClass ShowFatbits = {
    GI_visMoniker = 'P', "Show Pixel View";
    GBI_identifier = IO_SHOW_FATBITS;
