    GI_comp = @HelpTextSizeSmall, @HelpTextSizelarge;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    GIGI_selection  = VTDS_12;
    GIGI_destination = process;
    GIGI_applyMsg = MSG_ICON_QUICK_HELP_SIZE_CHANGED;
}
