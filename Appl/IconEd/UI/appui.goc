@object GenTextClass MousePointerInfoText = {
    GTXI_text = "\rAn icon set can contain either only pointer images or only icon images, but never both.\r\r\
Mouse pointers have a fixed size of 16x16 pixels.\rThey are always monochrome.\r\
You may add more pointer images to the set later.\r";

   /*
    * Update the text above if ALLOW_POINTER_DEF_32_AND_64 is set to 1 :
    *    ... have a fixed size of 16x16, 32x32 or 64x64  pixels.
    *    You also should add the information that bigger mouse pointers are supported only for
    *    GEOS version 6.1 or later (or whatever the first version is, that supports bigger pointers).
    */

    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
}

@object GenItemGroupClass MousePointerSizeChooser = {
    GI_visMoniker = 'I', "Initial Pointer Image Size:";
    HINT_PLACE_MONIKER_TO_LEFT;
@if @ALLOW_POINTER_DEF_32_AND_64
@elseif
    GI_states = @default & ~GS_USABLE;
@endif
    GI_comp = @PoinerSize16, @PoinerSize32, @PoinerSize64;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_WRAP_AFTER_CHILD_COUNT = 2;
    GIGI_selection = PIS_16;	/* this is the only downward compatible value! */
}
@object GenItemClass PoinerSize16 = {
   GI_visMoniker = '1', "16x16 (normal)";
   GII_identifier = PIS_16;
}
@object GenItemClass PoinerSize32 = {
   GI_visMoniker = '3', "32x32 (big)";
   GII_identifier = PIS_32;
}
@object GenItemClass PoinerSize64 = {
   GI_visMoniker = '6', "64x64 (huge)";
   GII_identifier = PIS_64;
}

