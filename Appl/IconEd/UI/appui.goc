/*-----------------------------------------------------------------------------
		RenameIconDialog
-----------------------------------------------------------------------------*/

@object GenInteractionClass RenameIconDialog = {
    GI_attrs = GA_NOTIFY_VISIBILITY;

    GII_visibility = GIV_DIALOG;
    GII_attrs = @default |  GIA_NOT_USER_INITIATABLE | GIA_MODAL;
    GII_type = GIT_COMMAND;
    GI_visMoniker = 'R', "Rename Icon";
    GI_comp = @RenameIconTextField,@RenameIconInfoText,
	          @DoRenameIconTrigger;

    ATTR_GEN_VISIBILITY_DESTINATION = @RenameIconTextField;
    ATTR_GEN_VISIBILITY_MESSAGE = MSG_VIS_TEXT_SELECT_ALL;

}

@object SmartTextClass RenameIconTextField = {
    GI_visMoniker = 'N', "New Name:";
    GTXI_attrs = @default | GTA_SINGLE_LINE_TEXT;
    ATTR_GEN_TEXT_CUSTOM_FILTER = OptrToChunk(@IconNameFilter);
    		/* only allow valid characters for C-idenifiers */
    GTXI_maxLength = MAX_ICON_NAME_LENGTH;
    HINT_PLACE_MONIKER_ABOVE;
    HINT_TEXT_FRAME;
    HINT_TEXT_WHITE_WASH_COLOR;
    HINT_DEFAULT_FOCUS;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    STI_enableObj = @DoRenameIconTrigger;
}

/* Exclude-List for valid characters for C-idenifiers */
@chunk VisTextCustomFilterData IconNameFilter[] = {
	{ 0x20, 0x2F }, // Space ... '/'
	{ 0x3A, 0x40 }, // ':' ... '@'
	{ 0x5B, 0x5E }, // '[' ... '^'
	{ 0x60, 0x60 }, // ' character
	{ 0x7B, 0xFF }, // '{' ... all the rest
	};

@if 0
VisTextCustomFilterData         struct
    VTCFD_startOfRange              word
    VTCFD_endOfRange                word
VisTextCustomFilterData         ends
@endif

@object GenTextClass RenameIconInfoText = {
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
    GTXI_text = "Icon names are used when writing the icon set as source code.";
}

@object GenTriggerClass DoRenameIconTrigger = {
    GI_visMoniker = 'R', "Rename Icon";
    GI_attrs = @default | GA_SIGNAL_INTERACTION_COMPLETE;
    GTI_actionMsg = MSG_DB_VIEWER_RENAME_ICON;
    ATTR_GEN_TRIGGER_ACTION_DATA = FALSE;
