/*-----------------------------------------------------------------------------
	ISetMenu - deals with the currently edited set of icns
-----------------------------------------------------------------------------*/

@object GenInteractionClass ISetMenu = {
    GII_visibility = GIV_POPUP;
    GI_visMoniker = 'S', "Icon Set";
    GI_states = @default & ~GS_ENABLED;
    GI_comp = @AddISetTrigger, @AddPointerImageSetTrigger, @ISetMenuSubGroup;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    	/*
    	 * If there is no icon set in the icon database, all parts of the
    	 * ISetMenu must be disabled, except for the AddISet triggers.
    	 * Therefore, we use a subgroup that can be disabled in this case.
    	 */
}

@object GenInteractionClass ISetMenuSubGroup = {
    GI_comp = 	  @DuplicateISetTrigger, @RenameISetTrigger,
	  @DeleteISetTrigger,
	  @ISetMenuInnerGroup,
	  @WriteSourceTrigger;
    HINT_SAME_CATEGORY_AS_PARENT;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenInteractionClass ISetMenuInnerGroup = {
    GI_comp = @TextMonikerDialogTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

@object GenTriggerClass AddISetTrigger = {
    GI_visMoniker = 'A', "Add Icon Set";
    GTI_actionMsg = MSG_DB_VIEWER_ADD_ISET_OPEN_DIALOG;
    ATTR_GEN_TRIGGER_ACTION_DATA = FALSE;	/* open last / default tab */
    @SetTriggerDestination_TO_DB_VIEWER;
    HINT_TRIGGER_BRINGS_UP_WINDOW;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'I';
}

