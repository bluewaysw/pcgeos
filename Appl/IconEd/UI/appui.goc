    GVLI_maximum = MakeWWFixed(MAX_DEFAULT_ICON_WIDTH);
    @SetGenValueDestination_TO_DB_VIEWER;
    GVLI_applyMsg = MSG_DB_VIEWER_RESIZE_IMAGE_NEW_SIZE;
}
