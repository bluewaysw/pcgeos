@include <stdapp.goh>
#include <input.h>
#include <Ansi/stdio.h>
#include <Ansi/string.h>
@include "WWW2/Conv/html.goh"


#define HTMemHandle MemHandle

/* Data structure define	*/
#define	ISB_LIST_LENGTH		4

/* For displaying items */
#define ITEM_TEXT_LENGTH	60
#define NUM_TEXT_GUESS		12
#define ITEM_LENGTH		165

#define MONIKER_SIZE		20
#define TEXT_START		(MONIKER_SIZE + 10)


#define DIALOG_X_POS_LEFT	50
#define DIALOG_X_POS_RIGHT	240
#define DIALOG_Y_POS		20

#define DB_FILE_NAME		"Bookmarks"
#define	MAX_HISTORY		20


typedef ByteFlags ISPreferenceStateType;
#define	ISPST_AUTO_LOAD_IMAGE	0x80
#define ISPST_CONFIRM_CANCEL	0x20

typedef enum {
    LP_FIRST_VIEW	= 0,
    LP_SECOND_VIEW	= 1,
    LP_THIRD_VIEW	= 2
} ISLPViewType;


typedef enum {
    IS_BOOKMARK_VIEW = 1,
    IS_DOCUMENT_VIEW = 2
} ISViewType;

typedef enum 	{
    ISBVT_BUILDIN	= 1,
    ISBVT_USER		= 2,
} ISBookmarkViewType;

typedef struct {
    word		ISBFS_size;
    DBGroup		ISBFS_group;
    DBItem		ISBFS_head;
} ISBFolderStruct;

typedef struct {
    DBItem		ISBS_next;
    word		ISBS_name;	/* offset of the name */
    word		ISBS_url;	/* offset of the url */
} ISBookmarkStruct;

/* Used for the DB map block */
typedef struct {
    ISBFolderStruct 	MAP_buildin;
    ISBFolderStruct 	MAP_user;
} MapStruct;


typedef enum {
	ISOPEN_ALLOWED		= 0x1,
	ISSTOP_ALLOWED		= 0x2,
	ISRELOAD_ALLOWED	= 0x4,
	ISBACK_ALLOWED		= 0x8,
	ISFORWARD_ALLOWED 	= 0x10,
	ISADD_ALLOWED		= 0x20,
	ISBOOKMARKS_ALLOWED	= 0x40,
	ISHISTORY_ALLOWED	= 0x80
} ISToolbarButtonType;

