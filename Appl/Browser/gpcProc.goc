/***********************************************************************
 *		MSG_GEN_PROCESS_OPEN_APPLICATION for GPCProcessClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/13/98   	Initial Revision
 *	
 ***********************************************************************/
@method GPCProcessClass, MSG_GEN_PROCESS_OPEN_APPLICATION
{
    @callsuper();
    /*
     *  Create the HTML Viewer
     */
    _processViewer = ObjInstantiate(/* HandleOf(GeodeGetOptrNS(@GPCGenView))*/
			    OptrToHandle(@GPCGenView), &BrowserHTMLViewerClass);
    if (_processViewer) {
	SizeAsDWord size = @call GPCGenView::MSG_VIS_GET_SIZE();
	@call _processViewer::HTMLViewer(0,
				 0,
				 DWORD_WIDTH(size),
				 DWORD_HEIGHT(size));
	@send _processViewer::ViewerInitialize(oself, @GPCGenView);
    }
    return;
}	/* End of MSG_GEN_PROCESS_OPEN_APPLICATION.	*/


/***********************************************************************
 *		MSG_GEN_PROCESS_CLOSE_APPLICATION for GPCProcessClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
