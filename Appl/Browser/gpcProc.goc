 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/13/98   	Initial Revision
 *	
 ***********************************************************************/
@method GPCProcessClass, MSG_GEN_PROCESS_CLOSE_APPLICATION
{
    @call _processViewer::MSG_META_OBJ_FREE();
    return @callsuper();
}


