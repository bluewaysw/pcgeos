/***********************************************************************
 *	MSG_PRINT_CONTROL_CHECK_IF_DO_WILL_FIT for ISPrintCtrClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Don't call super to prompt a confirmation dialog.
 * PARAMETERS:	    Boolean (Boolean warning)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	edwin	12/ 9/96   	Initial Revision
 *
 ***********************************************************************/
@method ISPrintCtrClass, MSG_PRINT_CONTROL_CHECK_IF_DOC_WILL_FIT
{
@if 0
  TempPrintCtrlInstance *print;
  JobParameters *job;
  print = (TempPrintCtrlInstance *)
    ObjVarFindData(oself, TEMP_PRINT_CONTROL_INSTANCE);
  job = MemLock(print->TPCI_jobParHandle);
  job->JP_spoolOpts = job->JP_spoolOpts & ~SO_SCALE;
  MemUnlock(print->TPCI_jobParHandle);
@endif
  return TRUE;
}	/* End of MSG_PRINT_CONTROL_CHECK_IF_DO_WILL_FIT.	*/



