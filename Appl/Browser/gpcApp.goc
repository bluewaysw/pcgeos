/***********************************************************************
 *		MSG_GPC_OPEN_URL_FROM_URLBAR for GPCProcessClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    We need to be able to open a location from the
 *		on-screen "Location:" field
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	edwin   	8/17/98   	Initial Revision
 *	
 ***********************************************************************/
@extern method GPCProcessClass, MSG_GPC_OPEN_URL_FROM_URLBAR
{
    char buffer[125];
    word size = 0;
    HTMLViewerResultCode result;

    size = @call LocationFieldInToolbar::MSG_VIS_TEXT_GET_ALL_PTR(buffer);
    EC_ERROR_IF(size > 125, 1);
    result = @call _processViewer::GetURL(buffer, LOAD_ANY_VERSION);

    return;
}	/* End of MSG_GPC_OPEN_URL_FROM_URLBAR.	*/



