    HINT_DRAW_IN_BOX;
    HINT_DRAW_STYLE_3D_LOWERED;
    HINT_CENTER_CHILDREN_HORIZONTALLY;
    HINT_CENTER_CHILDREN_VERTICALLY;

    HINT_FIXED_SIZE = {SST_PIXELS|236, SST_PIXELS|86};
    HINT_CUSTOM_CHILD_SPACING = { SST_PIXELS | 0 };
}
	
@object GenInteractionClass LPItemGroup = {
    GI_comp = @LPAutoLoadGroup, @LPConfirmGroup, @LPHistoryLength;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_CENTER_CHILDREN_ON_MONIKERS;
    HINT_CENTER_CHILDREN_VERTICALLY;
}
	


@object GenItemGroupClass LPAutoLoadGroup = {
    GI_comp = @LPAutoLoadItem;
    GIGI_behaviorType = GIGBT_NON_EXCLUSIVE;

}

@object GenValueClass LPHistoryLength = {
    GI_visMoniker = "History Length" ;
    GVLI_value = MakeWWFixed(20);
    GVLI_maximum = MakeWWFixed(50);
    GVLI_minimum = 0;
    GVLI_increment = MakeWWFixed(1);
    GVLI_displayFormat = GVDF_INTEGER;
	
    HINT_PLACE_MONIKER_TO_RIGHT ;
}

@object GenItemClass LPAutoLoadItem = {
    GI_visMoniker = "Auto load images";
    GII_identifier = ISPST_AUTO_LOAD_IMAGE;
}

@chunk word Item[1] = {ISPST_CONFIRM_CANCEL};

@object GenItemGroupClass LPConfirmGroup = {
    GI_comp = @LPConfirmCancelItem;
    GIGI_behaviorType = GIGBT_NON_EXCLUSIVE;

    GIGI_numSelections = 1;
    GIGI_selection = @Item;
}

@object GenItemClass LPConfirmCancelItem = {
    GI_visMoniker = "Confirm cancel downloads";
    GII_identifier = ISPST_CONFIRM_CANCEL;
}    

@object GenInteractionClass LPTimeGroup = {
    GI_visMoniker = "After a download,"; 
    GI_comp = @LPTimeGroupLow;
    GI_states = @default & ~GS_USABLE;
    GII_visibility = GIV_SUB_GROUP;
    GII_type = GIT_ORGANIZATIONAL;
    HINT_PLACE_MONIKER_ABOVE;
}

@object GenInteractionClass LPTimeGroupLow = {
    GI_visMoniker = "hold connection for:";
    GI_comp = @LPTimeValue;
    GII_visibility = GIV_SUB_GROUP;
    GII_type = GIT_ORGANIZATIONAL;
    HINT_PLACE_MONIKER_ABOVE;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
}

@object GenValueClass LPTimeValue = {
    GVLI_value = MakeWWFixed(30);
    GVLI_maximum = MakeWWFixed(99);
    GVLI_minimum = 0;
    GVLI_increment = MakeWWFixed(1);
    GVLI_displayFormat = GVDF_INTEGER;
    HINT_FIXED_SIZE = { SST_PIXELS | 25, 0, 1};
}



@object ISValueClass LPSpaceValue = {
    GI_visMoniker = "Space reserved for cache:";
    GI_states = @default & ~GS_USABLE; 
    GVLI_value = MakeWWFixed(100);
    GVLI_maximum = MakeWWFixed(1000);
    GVLI_increment = MakeWWFixed(50);
    GVLI_destination = process;
    HINT_PLACE_MONIKER_ABOVE;
}

@object GenTriggerClass LPClearButton = {
    GI_visMoniker = "Clear";
    GI_states = @default & ~GS_USABLE; 
    GTI_destination = process;
    GTI_actionMsg = MSG_GPC_CLEAR_CACHE;
}

@object GenTriggerClass LPPrevButton = {
    GI_visMoniker = "<<";
    GI_states = @default & ~GS_ENABLED; 
    GTI_destination = process;
    GTI_actionMsg = MSG_GPC_LP_PREV;
    HINT_SEEK_REPLY_BAR;
    ATTR_GEN_TRIGGER_INTERACTION_COMMAND = {IC_PREVIOUS};
}

@object GenTriggerClass LPNextButton = {
    GI_visMoniker = ">>" ;
    GTI_destination = process;
    GTI_actionMsg = MSG_GPC_LP_NEXT;
    HINT_SEEK_REPLY_BAR;
    ATTR_GEN_TRIGGER_INTERACTION_COMMAND = {IC_NEXT};
}

@object GenTriggerClass ISLPDOKButton = {
    GI_attrs =  @default | GA_SIGNAL_INTERACTION_COMPLETE;
    GTI_destination = process;
    GTI_actionMsg = MSG_GPC_LOCAL_PREFERENCE_CLOSE;
    ATTR_GEN_TRIGGER_INTERACTION_COMMAND = {IC_OK};
    HINT_SEEK_REPLY_BAR;
}

/**************************************************************************
 * Confirm Clear
 **************************************************************************/
@object GenInteractionClass ISConfirmClearDialog = {
    GI_visMoniker = "Confirm Clear";
    GI_comp = @ISCClearText, @ISCClearOKButton;
    GII_visibility = GIV_DIALOG;
    GII_attrs = @default | GIA_INITIATED_VIA_USER_DO_DIALOG | GIA_MODAL;
}

@object GenTextClass ISCClearText = {
    GTXI_text = "\rClear cache?\r";
    GI_attrs = @default | GA_READ_ONLY;
    HINT_DRAW_IN_BOX;
    HINT_DRAW_STYLE_3D_LOWERED; 
    ATTR_GEN_TEXT_DEFAULT_PARA_ATTR = {DEF_PARA_ATTR_CENTER};
    HINT_FIXED_SIZE = {SST_PIXELS|130, 0};
}

@object GenTriggerClass ISCClearOKButton = {
    GI_states = @default;
    GI_attrs =  @default | GA_SIGNAL_INTERACTION_COMPLETE;
    ATTR_GEN_TRIGGER_INTERACTION_COMMAND = {IC_OK};
    HINT_SEEK_REPLY_BAR;
    HINT_DEFAULT_DEFAULT_ACTION;
}

/****************************************************************
	find function
*****************************************************************/

@object SearchReplaceControlClass ISLIFindControl = {
    GI_visMoniker = "Find";
    GI_states = @default | GS_USABLE | GS_ENABLED;
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE | GIA_MODAL;
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_MULTIPLE_RESPONSE;
    GCI_output = process;
    HINT_GADGET_BACKGROUND_COLORS = { 
	C_WHITE, C_WHITE, C_LIGHT_GRAY, C_LIGHT_GRAY };
    ATTR_GEN_CONTROL_REQUIRE_UI = {
	SRCF_FIND_FROM_TOP
      | SRCF_FIND_NEXT | SRCF_FIND_PREV | SRCF_CLOSE | SRCF_PARTIAL_WORDS
      };
    ATTR_GEN_CONTROL_PROHIBIT_UI = {
      SRCF_REPLACE_CURRENT | SRCF_REPLACE_ALL_IN_SELECTION | 
      SRCF_REPLACE_ALL | SRCF_IGNORE_CASE |
      SRCF_WILDCARDS | SRCF_SPECIAL_CHARS | SRCF_REPLACE_ALL_IN_SELECTION
      };
}

