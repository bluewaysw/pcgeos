@start	AppResource;

/* help contexts for NIKE */
#define GPC_OPEN_LOCATION              "Open Location"
#define GPC_OPEN_FILE                  "Open File"
#define GPC_SAVE_FILE                  "Save File"
#define GPC_SAVE_IMAGE                 "Save Image"
#define GPC_PAGE_SETUP                 "Change Page Setup"
#define GPC_SHOW_BOOKMARKS             "Show Bookmarks"
#define GPC_SHOW_HISTORY_LIST          "Show History"
#define GPC_SET_HOME_PAGE              "Set Home Page"
#define GPC_SET_PROXY_SERVER           "Set Proxy Server"
#define GPC_SET_CACHE_SIZE             "Set Cache Size"
#define GPC_CONFIG_TOOLBAR             "Configure Toolbar"


@object GPCAppClass GPCApp = {
    GI_visMoniker = list {
	@ISTextMoniker
    }
    GI_comp = 
	@ISDocumentPrimary,
	@ISReplaceBookmarkDialog,
	@ISUsernameDialog,
	@ISHistoryDialog,
	@ISLocalPreferenceDialog,
	@ISOpenLocationDialog;


    gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_WINDOWS) = 
		@ISDocumentPrimary;

    gcnList(MANUFACTURER_ID_GEOWORKS,MGCNLT_ACTIVE_LIST) =
		@ISLIPrintButton,@ISPageSizeControl;
    gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_SELF_LOAD_OPTIONS) =
	@ISLIPrintButton,
	@ISLIFindControl,
	@ISPageSizeControl,
	@ISEditController;
    ATTR_GEN_APPLICATION_PRINT_CONTROL = @ISLIPrintButton;
}

@visMoniker ISTextMoniker = "Global Internet";

@end	AppResource;

@start GenericUI ;


@object GenPrimaryClass ISDocumentPrimary = {
    GI_comp = 
	@ISFileMenu,
	@ISEditMenu,
	@ISViewMenu,
	@ISNavigateMenu,
	@ISBookmarkMenu,
	@ISOptionsMenu,
	@ISButtonBar,
	@ISUrlBarGroup,
	@ISLIFindControl,
	@ISDocuInfoDialog, 
	@GPCGenView,
	@ISDialogBoxes;

    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_PRIMARY_NO_FILE_MENU; 
    HINT_CUSTOM_CHILD_SPACING = { SST_PIXELS | 0 };
    HINT_DRAW_IN_BOX;
    HINT_DEFAULT_TARGET ;
    ATTR_GEN_HELP_CONTEXT = "TOC";
}


