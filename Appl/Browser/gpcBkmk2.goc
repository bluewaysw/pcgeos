extern MemHandle ISHistoryHandle;
extern ISViewType isView;

extern word		ISCurrentSelection;
extern ISBookmarkViewType	ISBookmarkView;
extern word		ISLeftFirst;
extern word		ISRightFirst;
extern VMFileHandle	ISBookmarkFileHandle;

extern ISBFolderStruct ISBuildInFolder;
extern ISBFolderStruct ISUserFolder;

