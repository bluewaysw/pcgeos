/***********************************************************************
 *		MSG_VIS_DRAW for ISItemClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Draw the bookmark item
 * PARAMETERS:	    void(DrawFlags drawFlags, GState gstate)
 * SIDE EFFECTS:    none
 *
 * STRATEGY:	    
 *		Call superclass
 *		if(focus item)
 *		  Draw focus rectangle
 *		else
 *		  Clear focus rectangle
 *		if(selected)
 *		  invert entire item rectangle
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	sean		11/21/97   	Initial Revision
 *	
 ***********************************************************************/
@method ISItemClass, MSG_VIS_DRAW
{
    Rectangle rect;
    const unsigned char mask[8] = {0xcc, 0xcc, 0x33, 0x33, 0xcc, 0xcc, 0x33, 0x33};

    @callsuper();

    GrSaveState(gstate);

    /* Draw the focus rectangle for the item */
    if(@self->ISI_focus)
        GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
    else
        GrSetLineColor(gstate, CF_INDEX, C_WHITE, 0, 0);

    @call self::MSG_VIS_GET_BOUNDS(&rect);
    GrSetLineMaskCustom(gstate, &mask);
    GrDrawRect(gstate, rect.R_left + 1, rect.R_top + 1,
	               rect.R_right - 2, rect.R_bottom - 2);

    /* Draw the selection for the bookmark item */
    if(@self->ISI_selection)
    {
        GrSetMixMode(gstate, MM_XOR);
	GrSetAreaColor(gstate, CF_INDEX, C_WHITE, 0, 0);
	GrFillRect(gstate, rect.R_left + 1, rect.R_top + 1,
	               rect.R_right - 2, rect.R_bottom - 2);
    }
    GrRestoreState(gstate);

}	/* End of MSG_VIS_DRAW.	*/


