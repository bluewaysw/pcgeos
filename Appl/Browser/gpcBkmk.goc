optr ISCurrentFocusItem;


/***********************************************************************
 *		MSG_GEN_INTERACTION_INITIATE for ISDialogClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Select current bookmark item
 * PARAMETERS:	    void(void)
 * SIDE EFFECTS:    none
 *
 * STRATEGY:	    REMEMBER--This is PENELOPE only code.	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	sean		11/21/97   	Initial Revision
 *	
 ***********************************************************************/
@method ISDialogClass, MSG_GEN_INTERACTION_INITIATE
{
    if(ISCurrentFocusItem) 
    {
	@send ISCurrentFocusItem::MSG_ISI_SET_SELECTION(TRUE);
	@send ISCurrentFocusItem::MSG_VIS_REDRAW_ENTIRE_OBJECT();
    }

    @callsuper();

}	/* End of MSG_GEN_INTERACTION_INITIATE.	*/



/***********************************************************************
 *		MSG_GEN_GUP_INTERACTION_COMMAND for ISDialogClass
 ***********************************************************************
 *
 * SYNOPSIS:	    	De-selects the selected bookmark item
 *			if we are dismissing the dialog.
 * PARAMETERS:		Boolean(InteractionCommand command)	    
 * SIDE EFFECTS:    	none
 *
 * STRATEGY:	if(dismissing dialog)
 *		  de-select current bookmark selection    
 *		Default functionality
 *
 *		REMEMBER--This is PENELOPE only code.	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	sean		11/21/97   	Initial Revision
 *	
 ***********************************************************************/
@method ISDialogClass, MSG_GEN_GUP_INTERACTION_COMMAND
{
@ifdef PRODUCT_PENELOPE
    if((ISCurrentFocusItem) && (command == IC_DISMISS))
    {
	@send ISCurrentFocusItem::MSG_ISI_SET_SELECTION(FALSE);
	@send ISCurrentFocusItem::MSG_VIS_REDRAW_ENTIRE_OBJECT();
    }
@endif        

    return(@callsuper());

}	/* End of MSG_GEN_GUP_INTERACTION_COMMAND.	*/


/***********************************************************************
 *		MSG_META_GAINED_FOCUS_EXCL for ISItemClass
 ***********************************************************************
 *
 * SYNOPSIS:	    	Take care of drawing the focus for 
 *			bookmark items.
 *
 * PARAMETERS:	    	void(void)
 * SIDE EFFECTS:    	none
 *
 * STRATEGY:		if(not already focus)
 *			  self->focus = TRUE
 *			  if(previous focus)
 *			    tell previous no no longer focus
 *			    redraw previous focus item 
 *			  current focus = self
 *			  redraw self (to redraw focus rectangle)
 *			Default functionality	    
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mzhu    	6/ 3/97   	Initial Revision
 *	sean		11/20/97	Re-organization
 *	
 ***********************************************************************/
@method ISItemClass, MSG_META_GAINED_FOCUS_EXCL
{
    if(ISCurrentFocusItem != oself)
    {
        @self->ISI_focus = TRUE;

	if(ISCurrentFocusItem)
	{
            @call ISCurrentFocusItem::MSG_ISI_CLEAR_FOCUS();
            @send ISCurrentFocusItem::MSG_VIS_REDRAW_ENTIRE_OBJECT();
	}

        ISCurrentFocusItem = oself;
        @call self::MSG_VIS_REDRAW_ENTIRE_OBJECT();
    }

    @callsuper();

}	/* End of MSG_META_GAINED_FOCUS_EXCL.	*/


