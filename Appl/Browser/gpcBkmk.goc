/* data for bookmark and folder */
word		ISCurrentSelection = GIGS_NONE;

ISBFolderStruct ISBuildInFolder;
ISBFolderStruct ISUserFolder;

ISBookmarkViewType	ISBookmarkView = ISBVT_USER;

word		ISLeftFirst = 0;
word		ISRightFirst = ISB_LIST_LENGTH;

