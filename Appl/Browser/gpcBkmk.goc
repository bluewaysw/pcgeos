/***********************************************************************
 *		MSG_GPC_BRING_UP_BOOKMARKS for GPCProcessClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	jeremyb 	10/06/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method GPCProcessClass, MSG_GPC_BRING_UP_BOOKMARKS
{
    word size ;
/* you can only open the VM file once dude 
 *    @send process::MSG_GPC_BOOKMARK_INITIALIZE();
 */
	size = ISUserFolder.ISBFS_size;
	@send ISBookmarkList::MSG_GEN_DYNAMIC_LIST_INITIALIZE(size);
    
    /* Need to make sure the delete trigger is disabled every time we 
     * open the box.
	 */
	@send ISBookmarkList::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(GIGS_NONE,
								  TRUE);

	// bring up the dialog
	@send ISBookmarkBox::MSG_GEN_INTERACTION_INITIATE();
	@send HistoryList :: MSG_META_GRAB_FOCUS_EXCL();
	@send HistoryList :: MSG_META_GRAB_TARGET_EXCL();

}	/* End of MSG_GPC_BRING_UP_BOOKMARKS.	*/



/***********************************************************************
 *		MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION for ISDynamicListClass
 ***********************************************************************
 *
 * SYNOPSIS:	    intercept message to set global variable
 * PARAMETERS:	    identifier
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    Grab it and set global.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	jeremyb 	10/07/97   	Initial Revision
 *	
 ***********************************************************************/
@method ISDynamicListClass, MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION
{

    ISCurrentSelection = identifier ;
	if (identifier == GIGS_NONE) {
		@send ISLIDeleteButton::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
		@send ISGotoBookmarkButton::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	} else {
		@send ISLIDeleteButton::MSG_GEN_SET_ENABLED(VUM_NOW);
		@send ISGotoBookmarkButton::MSG_GEN_SET_ENABLED(VUM_NOW);
    }
    @callsuper();

}	/* End of MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION.	*/

/***********************************************************************
 *		MSG_GPC_GOTO_BOOKMARK for GPCProcessClass
 ***********************************************************************
 *
 * SYNOPSIS:	    User hits the goto button under bookmarks
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:	    Grab the selection, ISCurrentSelection
 *                  get that numbered selection url out of the db
 *                  load the url
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	jeremyb 	10/07/97   	Initial Revision
 *	
 ***********************************************************************/
@extern method GPCProcessClass, MSG_GPC_GOTO_BOOKMARK
{
    ISBookmarkStruct 	*bookmark;
    char 		*cptr;
    HTMemHandle		urlHtmh, titleHtmh;
    HTMemHandle sreqHtmh, sreqHeadHtmh;
    word		size;

    bookmark = GetBookmark(ISCurrentSelection, ISBVT_USER);

    /* Also if the item is an empty item, do nothing more. */
    if(bookmark == NULL) return;    

    size = strlen((char *)((char *)bookmark + bookmark->ISBS_url))+1;

    cptr = HTMemAllocAndLock(&urlHtmh, size);
    strcpy(cptr, (char *)((char *)bookmark + bookmark->ISBS_url));
    HTMemUnlock(urlHtmh);

    size = strlen((char *)((char *)bookmark + bookmark->ISBS_name))+1;
    cptr = HTMemAllocAndLock(&titleHtmh, size);
    strcpy(cptr, (char *)((char *)bookmark + bookmark->ISBS_name));
    HTMemUnlock(titleHtmh);

    DBUnlock(bookmark);

    /* Tell the process to open a url. */
    urlHtmh = ParseURL(urlHtmh);

    sreqHtmh = SReqCreateMainRequest(urlHtmh, 0, 0, HTM_GET,0);
    @send process::MSG_GPC_OPEN_URL(sreqHtmh, UST_BOOKMARK);

}	/* End of MSG_GPC_GOTO_BOOKMARK.	*/

@endif
