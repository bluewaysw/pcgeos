(/***********************************************************************) 81 485 T
( * HelloDrawText) 81 474 T
( ***********************************************************************) 81 463 T
( * SYNOPSIS:) 81 452 T
(Draw a single line of text onto the document. Note) 168.98 452 T
( *) 81 441 T
(that it has no concept of the screen or the view --) 168.98 441 T
( *) 81 430 T
(it is given a graphics state and draws through it.) 168.98 430 T
( * CALLED BY:) 81 419 T
(\050INTERNAL\051 HelloProcess::MSG_META_EXPOSED) 168.98 419 T
( * RETURN:) 81 408 T
(nothing) 168.98 408 T
( * SIDE EFFECTS:) 81 397 T
(attributes in the gstate are altered) 168.98 397 T
( *) 81 386 T
( * STRATEGY:) 81 375 T
(We separate the drawing from the exposure handler) 168.98 375 T
( *) 81 364 T
(so the same routine can be used for both window) 168.98 364 T
( *) 81 353 T
(refresh and for printing.) 168.98 353 T
( *) 81 342 T
( *) 81 331 T
(Set the font, point size and color, then draw the text.) 168.98 331 T
( *) 81 320 T
(***********************************************************************/) 86.4 309 T
(/* Functions are declared as they would be in C. Parameters are defined using) 81 291 T
( * the ANSI calling convention: The type of the parameter is given, followed) 81 280 T
( * by the parameter name. Multiple parameters are separated by commas. This) 81 269 T
( * function has a single parameter. */) 81 258 T
(void HelloDrawText\050GStateHandle gstate\051 {) 81 240 T
(/* First change some of the default GState values such as the font) 102.6 222 T
(* and point size. This is done with the routine GrSetFont\050\051. */) 108 211 T
(GrSetFont\050gstate, FID_DTC_URW_ROMAN, MakeWWFixed\050TEXT_POINT_SIZE\051\051;) 102.6 200 T
(/* Set the text color to the value in helloTextColor by calling the) 102.6 182 T
(* graphics routine GrSetTextColor\050\051. */) 108 171 T
(GrSetTextColor\050gstate, CF_INDEX, helloTextColor, 0, 0\051;) 102.6 160 T
