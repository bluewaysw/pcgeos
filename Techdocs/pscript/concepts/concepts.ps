(@object GenPrimaryClass HelloPrimary = {) 81 578.98 T
(GI_visMoniker = \322Hello World Sample Application\323;) 102.6 567.98 T
(/* This title will appear at the top of the primary) 212.5 556.98 T
( * window as the name of the application. */) 212.5 545.98 T
(GI_comp = @HelloView, @HelloMenu;) 102.6 527.98 T
(/* This window has two children, the GenView object) 212.5 516.98 T
( * and the GenInteraction menu object. */) 212.5 505.98 T
(/* For simplicity, this application is not given an icon. Therefore, we must) 102.6 487.98 T
( * prevent the user from being able to minimize the application. This is) 102.6 476.98 T
( * done by applying the following attribute to the GenPrimary object. Note that) 102.6 465.98 T
( * GenPrimaryClass is a subclass of GenDisplayClass, in which this attribute) 102.6 454.98 T
( * is actually defined. */) 102.6 443.98 T
(ATTR_GEN_DISPLAY_NOT_MINIMIZABLE;) 102.6 425.98 T
(/* The following hint allows the primary window object to size itself) 102.6 407.98 T
( * according to its children \050the view object\051. */) 102.6 396.98 T
(HINT_SIZE_WINDOW_AS_DESIRED;) 102.6 385.98 T
( /*) 91.8 367.98 T
( * When the specific UI permits, let\325s not show the menu bar on) 97.2 356.98 T
( * startup. Some applications would find the extra space this leaves) 97.2 345.98 T
( * helpful, in particular on the small screens of pen-based devices,) 97.2 334.98 T
( * though for this simple application it doesn\325t really matter.) 97.2 323.98 T
( */) 97.2 312.98 T
(ATTR_GEN_DISPLAY_MENU_BAR_POPPED_OUT;) 102.6 301.98 T
(HINT_DISPLAY_MENU_BAR_HIDDEN_ON_STARTUP;) 102.6 290.98 T
(}) 81 279.98 T
