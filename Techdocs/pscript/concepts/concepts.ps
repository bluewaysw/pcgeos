(/* Message definitions for this class */) 102.6 642 T
(@message void MSG_TICTAC_NEW_GAME\050\051;) 102.6 631 T
(/* This message is sent by the New Game trigger in the Game menu) 125 620 T
( * when the user wants to reset the game. It is sent directly to) 125 609 T
( * the game board object and causes the board object first to) 125 598 T
( * send the \322new game\323 message to each of its children and then) 125 587 T
( * to redraw the game board.) 125 576 T
(*/) 431.5 576 T
(@message Boolean MSG_TICTAC_VALIDATE_BOUNDS\050word bottom, word right,) 102.6 558 T
(word top, word left\051;) 322.6 547 T
(/* This message is sent by a game piece that is being moved by the) 125 536 T
( * user and is about to be set down. The four parameters are the) 125 525 T
( * proposed new bounds of the moved piece; if they are within the) 125 514 T
( * game board\325s limit, this message returns TRUE. If they are at) 125 503 T
( * all outside the game board, this message returns FALSE.) 125 492 T
(*/) 438.2 492 T
(@endc) 81 474 T
