(/* Get a new, default graphics state that we can use while drawing.) 102.6 642 T
(* We must allocate a new graphics state for the View window using) 108 631 T
(* the kernel routine GrCreateState\050\051. We pass the window handle of) 108 620 T
(* the View window, which we received in a parameter called \322win\323. */) 108 609 T
(gstate = GrCreateState\050win\051;) 102.6 591 T
(/* Next, start a window update. This tells the windowing system that) 102.6 573 T
(* we are in the process of drawing to this window. This is very) 108 562 T
(* important\321it ensures the window will be in a consistent state while) 108 551 T
(* we\325re drawing. Specifically, it locks in the invalidated region to) 108 540 T
(* which we\325ll be drawing; this makes sure that other threads drawing) 108 529 T
(* to this window will not have any effect on our GState. A window) 108 518 T
(* update is started by calling the kernel routine GrBeginUpdate\050\051) 108 507 T
(* with the GState handle. */) 108 496 T
(GrBeginUpdate\050gstate\051;) 102.6 478 T
(/* If we had background graphics to draw, we could call the appropriate) 102.6 460 T
(* graphics routines now. But we don\325t. */) 108 449 T
(/* Draw our text into the window \050pass the GState\051. This is done here) 102.6 431 T
(* by calling the function HelloDrawText\050\051, which knows how to draw) 108 420 T
(* the appropriate document. \050See below.\051 */) 108 409 T
(HelloDrawText\050gstate\051;) 102.6 391 T
(/* Special Hello World routine \050below\051. */) 256.5 391 T
(/* Now end the window update \050unlock the GState and its window\051) 102.6 373 T
(* with the routine GrEndUpdate\050\051, and free the GState handle by calling) 108 362 T
(* the kernel routine GrDestroyState\050\051. */) 108 351 T
(GrEndUpdate\050gstate\051;) 102.6 333 T
(/* Signal that we are done with) 256.5 333 T
( * the window update. */) 256.5 322 T
(GrDestroyState\050gstate\051;) 102.6 311 T
(/* Destroy the temporary GState. */) 256.5 311 T
(}) 81 300 T
