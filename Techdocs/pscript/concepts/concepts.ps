(/* Next, get the window handle of the view window.) 125 602 T
( * Then, create a new, temporary gstate to draw into) 125 591 T
( * for that window.) 125 580 T
(*/) 388 580 T
(win = @call TicTacView::MSG_GEN_VIEW_GET_WINDOW\050\051;) 102.6 562 T
(gstate = GrCreateState\050win\051;) 102.6 551 T
(/* Now, set the current position of the game piece) 125 533 T
( * to be centered on the pointer.) 125 522 T
(*/) 388 522 T
(pself->TTP_vertPos = yPosition - \050PIECE_HEIGHT/2\051;) 102.6 504 T
(pself->TTP_horizPos = xPosition - \050PIECE_WIDTH/2\051;) 102.6 493 T
(/* Now, set the drawing mode of the game piece) 125 475 T
( * to MM_INVERT to draw a new game piece outline.) 125 464 T
( * MM_INVERT is chosen so the outline can be redrawn) 125 453 T
( * in invert mode later to erase it and not destroy) 125 442 T
( * anything under it.) 125 431 T
(*/) 344 431 T
(GrSetMixMode\050gstate, MM_INVERT\051;) 102.6 413 T
(/* Now draw the outline. If the game piece is of type) 125 395 T
