(* MSG_META_CONTENT_VIEW_WIN_OPENED for HelloProcessClass) 86.4 336.98 T
(***********************************************************************) 86.4 325.98 T
(* SYNOPSIS:) 86.4 314.98 T
(Record the handle of the view window when the view) 168.98 314.98 T
(*) 86.4 303.98 T
(creates it. This allows us to more-easily update the) 168.98 303.98 T
(*) 86.4 292.98 T
(document when the user changes the text color.) 168.98 292.98 T
(* PARAMETERS:) 86.4 281.98 T
(void \050) 168.98 281.98 T
(word viewWidth,) 212.5 281.98 T
(*) 86.4 270.98 T
(word viewHeight,) 212.5 270.98 T
(*) 86.4 259.98 T
(WindowHandle viewWin\051) 212.5 259.98 T
(* SIDE EFFECTS: winHan is set to viewWindow) 86.4 248.98 T
(***********************************************************************/) 86.4 237.98 T
(@method HelloProcessClass, MSG_META_CONTENT_VIEW_WIN_OPENED {) 81 219.98 T
(/* Get the window handle of the View. We need this handle in order to) 125 208.98 T
( * force a window invalidation, causing the View to send a MSG_META_EXPOSED) 125 197.98 T
( * to the Process object and thereby forcing a redraw of the window. */) 125 186.98 T
(winHan = viewWindow;) 102.6 175.98 T
(}) 81 164.98 T
