(/* This display is part of hello3.goc and follows the previous display directly. */) 81 614.98 T
(/*) 81 596.98 T
(HelloColorBox Dialog Box) 212.5 596.98 T
( * Dialog boxes are of GenInteractionClass. The moniker of the dialog box will) 81 585.98 T
( * appear at the top as the box\325s title. Additionally, if the GenInteraction) 81 574.98 T
( * is a child of a menu interaction, the moniker will also serve as the text that) 81 563.98 T
( * appears in the menu item that brings up the dialog box. The dialog will) 81 552.98 T
( * automatically size itself to be large enough to hold all its children. Thus,) 81 541.98 T
( * this dialog will be small \050with just two children, each a trigger with a short) 81 530.98 T
( * moniker\051. */) 81 519.98 T
(@object GenInteractionClass HelloColorBox = {) 81 501.98 T
(GI_visMoniker = \325C\325, \322Color\323;) 102.6 490.98 T
(/* The moniker will be displayed both as the) 259.2 490.98 T
( * dialog\325s title and as the menu item that) 256.5 479.98 T
( * brings the dialog up. */) 256.5 468.98 T
(GI_comp = @HelloBlueTrigger, @HelloGoldTrigger;) 102.6 450.98 T
(/* The two triggers are the only gadgets) 256.5 439.98 T
( * in the dialog box. */) 256.5 428.98 T
(GII_visibility = GIV_DIALOG;) 102.6 410.98 T
(/* In order for this interaction to be) 256.5 410.98 T
( * a dialog box, this attribute must be set. */) 256.5 399.98 T
(}) 81 388.98 T
(/*) 81 370.98 T
(GenTriggers) 212.5 370.98 T
( * Buttons are implemented by GenTriggerClass. When a trigger is pushed by the user) 81 359.98 T
( * \050clicked on with the mouse\051, it will send the specified message to the specified) 81 348.98 T
( * output object. In both cases below, the trigger will send an application-defined) 81 337.98 T
( * message to the application\325s Process object. A trigger\325s moniker is displayed) 81 326.98 T
( * within the trigger. In this case, both are text, but any graphics could be used) 81 315.98 T
( * instead to create graphical triggers easily. \050E.g. a blue flag and a gold flag) 81 304.98 T
( * rather than the words \322Blue\323 and \322Gold.\323\051 */) 81 293.98 T
(@object GenTriggerClass HelloBlueTrigger = {) 81 275.98 T
(GI_visMoniker = \325B\325, \322Blue\323;) 102.6 264.98 T
(/* The \325B\325 indicates the keyboard navigation) 256.5 264.98 T
( * character for this trigger. */) 256.5 253.98 T
(GTI_destination = process;) 102.6 242.98 T
(/* Send the message to the Process object. */) 256.5 242.98 T
(GTI_actionMsg = MSG_HELLO_CHANGE_TO_BLUE;) 102.6 231.98 T
(/* Send this message. */) 324 231.98 T
(}) 81 220.98 T
