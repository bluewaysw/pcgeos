(@method TicTacBoardClass, MSG_VIS_DRAW {) 81 405 T
(/* Set up the graphic state properly. The board) 125 394 T
( * lines are to be white and three points thick.) 125 383 T
(*/) 388 383 T
(GrSetLineColor\050gstate, CF_INDEX, C_WHITE, 0, 0\051;) 102.6 365 T
(GrSetLineWidth\050gstate, 3\051;) 102.6 354 T
(/* Now draw the border of the game board. It is a) 125 336 T
( * rectangle that outlines the entire board.) 125 325 T
(*/) 388 325 T
(GrDrawRect\050gstate, 0, 0, BOARD_WIDTH, BOARD_HEIGHT\051;) 102.6 307 T
(/* Set and draw the Tic Tac Toe playing field. The) 125 289 T
( * lines are now set to 4 points thickness, and the) 125 278 T
( * lines are drawn with HLine and VLine graphics) 125 267 T
( * commands. Ideally, preset constants would be used.*/) 125 256 T
(GrSetLineWidth\050gstate, 4\051;) 102.6 238 T
(GrDrawHLine\050gstate, 5, 60, 175\051;) 102.6 227 T
(GrDrawHLine\050gstate, 5, 120, 175\051;) 102.6 216 T
(GrDrawVLine\050gstate, 60, 5, 175\051;) 102.6 205 T
(GrDrawVLine\050gstate, 120, 5, 175\051;) 102.6 194 T
