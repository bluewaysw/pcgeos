( *) 81 642 T
(passed on to each of the game pieces. Then each piece) 168.98 642 T
( *) 81 631 T
(\050in this handler\051 will draw itself at its own bounds.) 168.98 631 T
( *) 81 620 T
( * PARAMETERS:) 81 609 T
( *) 81 598 T
(void \050word drawFlags GStateHandle gstate\051) 125 598 T
( *) 81 587 T
( ***********************************************************************/) 81 576 T
(@method TicTacPieceClass, MSG_VIS_DRAW {) 81 558 T
(/* Set the mode to MM_COPY; this means that the image) 125 547 T
( * drawn now will be drawn over whatever is there now.*/) 125 536 T
(GrSetMixMode\050gstate, MM_COPY\051;) 102.6 518 T
(/* If the type is TTPT_BOX, set the color to gray and) 125 500 T
( * draw a rectangle the size of the object\325s bounds.) 125 489 T
( * Otherwise \050since there are just two types\051, set the) 125 478 T
( * color to gray and draw an ellipse of that size.) 125 467 T
(*/) 395 467 T
(if \050pself->TTP_pieceType == TTPT_BOX\051 {) 102.6 449 T
(GrSetAreaColor\050gstate, CF_INDEX, C_DARK_GRAY, 0, 0\051;) 125 438 T
(GrFillRect\050gstate, pself->VI_bounds.R_left, pself->VI_bounds.R_top,) 125 427 T
(pself->VI_bounds.R_right, pself->VI_bounds.R_bottom\051;) 212.5 416 T
(} else {) 102.6 398 T
(GrSetAreaColor\050gstate, CF_INDEX, C_LIGHT_GRAY, 0, 0\051;) 125 387 T
(GrFillEllipse\050gstate, pself->VI_bounds.R_left, pself->VI_bounds.R_top,) 125 376 T
(pself->VI_bounds.R_right, pself->VI_bounds.R_bottom\051;) 212.5 365 T
(}) 102.6 354 T
(/* After handling the message, call the superclass to) 125 336 T
( * ensure that no default behavior has been mucked up.) 125 325 T
( * This is actually not necessary in this particular case. */) 125 314 T
(@callsuper\050\051;) 102.6 303 T
(}) 81 292 T
