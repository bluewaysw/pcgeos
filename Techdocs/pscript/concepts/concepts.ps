(if \050pself->TTP_pieceType == TTPT_BOX\051 {) 102.6 355 T
(GrDrawRect\050gstate, pself->TTP_horizPos, pself->TTP_vertPos,) 125 344 T
(\050pself->TTP_horizPos + PIECE_WIDTH\051,) 256.5 333 T
(\050pself->TTP_vertPos + PIECE_HEIGHT\051\051;) 256.5 322 T
(} else {) 102.6 304 T
(GrDrawEllipse\050gstate, pself->TTP_horizPos, pself->TTP_vertPos,) 125 293 T
(\050pself->TTP_horizPos + PIECE_WIDTH\051,) 256.5 282 T
(\050pself->TTP_vertPos + PIECE_HEIGHT\051\051;) 256.5 271 T
(}) 102.6 260 T
