(*/) 400.4 402 T
(pself->VI_bounds.R_left = pself->TTP_origHorizPos;) 102.6 384 T
(pself->VI_bounds.R_top = pself->TTP_origVertPos;) 102.6 373 T
(pself->VI_bounds.R_right = \050pself->TTP_origHorizPos + PIECE_WIDTH\051;) 102.6 362 T
(pself->VI_bounds.R_bottom = \050pself->TTP_origVertPos + PIECE_HEIGHT\051;) 102.6 351 T
