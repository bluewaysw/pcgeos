(/*) 81 433.98 T
( *) 81 422.98 T
(Application Object) 212.5 422.98 T
( * The very top-level generic object of an application MUST be a GenApplication) 81 411.98 T
( * object. The hello3.gp file contains an \322appobj\323 statement which indicates) 81 400.98 T
( * that this \322HelloApp\323 object is in fact the top-level UI object.) 81 389.98 T
( * This object should be in its own resource so it takes up very little memory) 81 378.98 T
( * when minimized. Note that the name of the resource may be whatever you choose;) 81 367.98 T
( * it does not have to be AppResource.) 81 356.98 T
( */) 81 345.98 T
(@start) 81 327.98 T
(AppResource;) 125 327.98 T
(/* Begin definition of objects in AppResource. */) 256.5 327.98 T
(@object GenApplicationClass HelloApp = {) 81 309.98 T
(GI_comp = HelloPrimary;) 102.6 298.98 T
(/* The GI_comp attribute lists the generic children) 212.5 287.98 T
( * of the object. The HelloApp object has just one) 212.5 276.98 T
( * child, the primary window of the application. */) 212.5 265.98 T
(gcnList\050MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS\051 = HelloPrimary;) 102.6 247.98 T
(/* This GCN list determines which of the application\325s) 212.5 236.98 T
( * window objects must be made visible when the) 212.5 225.98 T
( * application first starts up. */) 212.5 214.98 T
(}) 81 203.98 T
(@end) 81 185.98 T
(AppResource) 125 185.98 T
(/* End definition of objects in AppResource. */) 256.5 185.98 T
