(@method HelloProcessClass, MSG_HELLO_REDRAW_DOCUMENT) 81 642 T
({) 81 631 T
(/* Now create a temporary GState to use for window invalidation) 102.6 613 T
( * if the window handle is valid, then redraw the window. */) 102.6 602 T
(if \050winHan != 0\051 {) 102.6 591 T
(GStateHandle gstate = GrCreateState\050winHan\051;) 125 580 T
(/* Call GrInvalRect using the GState. Invalidate the entire) 125 569 T
( * document. This will cause the View to redraw itself and send) 125 558 T
( * a MSG_META_EXPOSED to the Process object. */) 125 547 T
(GrInvalRect\050gstate, 0, 0, HORIZ_DOC_SIZE, VERT_DOC_SIZE\051;) 125 536 T
(GrDestroyState\050gstate\051;) 125 525 T
(/* Free the GState. */) 301 525 T
(}) 102.6 514 T
