# REVISION HISTORY:
#       Name      Date            Description
#       ----      ----            -----------
#       todd      7/22/98         Initial Revision
#       les       12/03/01        BBX Ensemble version
#       bluewaysw 03/2026         enabled GFS for FreeGEOS builds
#
# DESCRIPTION:
#	Build variables for bbxensem product
#
#       $Id:$
#
###############################################################################

################################ SOURCE
# You may specify multiple locations for snatching files.  The first
# location containing the geode will be used.

sourceDirs=/staff/pcgeos/Installed

################################ MEDIA
# If there is no directive after a file in the filetree file, the build
# tool sends the file to the first media type specified in mediaHierarchy
# that exists in the current build.
mediaHierarchy=SERVER LOCALPC
localpc=true

################################# FreeGEOS related
# Use lowercase for these plain DOS names, also in environment overrides.
# Use a DOS 8.3 name for versionTag.
#
# The build converts install to the DOS directory INSTALL without a label.
# If you specify INSTALL, the build stores that spelling as a GEOS name
# in @DIRNAME.000. Setup copies files from SETUP/INSTALL to ENSEMBLE.
# A label in the staging directory would give ENSEMBLE the GEOS name INSTALL.
versionTag=600beta
layoutCoreRoot=fg
layoutInstallRoot=ensemble/freegeos/600beta/setup/install
layoutWorld=system/distappl
layoutWorldDeskAcc=system/distappl
layoutWorldGames=system/distappl
layoutWorldExtras=system/distappl
layoutWorldTools=system/distappl

################################ MISC
# miscellaneous conditionals used by the build tool.
fileTree=bbxensem.filetree
ec=false
desttree=/tmp/bbxensem/build

productShortName=bbxensem
productLongName=Ensemble

nt=true
fg=true
prototype=false

    # Do we even have XIP?
xip=false
    # Do we have a GFS image?
gfs=true
    # Do we have a ROM disk?
romdisk=false
    # Do you want to merge a bios image into the final image??
bios=false
    # Merge a romdos image into the final image??
romdos=false

tools=false
