;
;			INITIALIZATION VARIABLES
;

idata	segment

SBCS<driveName	char	2 dup(0)	; buffer for specifying drive name >
DBCS<driveName	wchar	2 dup(0)	; buffer for specifying drive name >
					;  in call to FSDInitDrive.
driveKeyStr	char	'drive x', 0
DRIVE_KEY_LETTER_OFFSET equ (($-2)-driveKeyStr)

idata	ends

udata	segment

maxSector	word	0	; largest sector size for any managed drive

if HOST_FS_FASTPATH
hostFsAvail	BooleanByte	BB_FALSE ; TRUE if the BASEBOX FS fast path
					;  is enabled
hostFsGeneration word	0		; host drive table generation at init
hostFsFuncMap	byte	HOSTFS_FUNC_MAP_SIZE dup(0)
					; bit set for each DOS function (AH)
					;  the host executes; filled in by
					;  HIF_FS_ENABLE
endif

udata	ends
