COMMENT @%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	Copyright (c) blueway.Softworks 2026 -- All Rights Reserved

PROJECT:	PC GEOS
MODULE:		File System Drivers
FILE:		hostfsVariable.def

DESCRIPTION:
	Variables of the host file system driver.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%@

udata	segment

hostfsFSD	word			; offset of our FSDriver record
hostfsDrives	HostFsDrive HOSTFS_MAX_DRIVES dup(<>)
					; the drives we manage

udata	ends

DriverExtendedInfo	segment	lmem LMEM_TYPE_GENERAL
DriverExtendedInfoTable	<
		{},			; lmem header added by Esp
		length fsNameTable,	; Number of supported "devices"
		offset fsNameTable,	; Names of supported "devices"
		offset fsInfoTable	; FSDFlags
>

fsNameTable	lptr.char	fsname
		lptr.char 	0	; terminate table

fsname		chunk.char	"Host File System", 0

fsInfoTable	word	FSD_FLAGS

DriverExtendedInfo	ends
